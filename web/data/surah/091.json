[{"n":1,"w":[["وَٱلشَّمْسِ","demi matahari","wal-shamsi",343],["وَضُحَىٰهَا","dan cahayanya pagi hari","waḍuḥāhā",1141]],"t":"Demi matahari dan sinarnya pada pagi hari,"},{"n":2,"w":[["وَٱلْقَمَرِ","dan bulan","wal-qamari",404],["إِذَا","apabila","idhā",23],["تَلَىٰهَا","mengiringinya","talāhā",197]],"t":"demi bulan apabila mengiringinya,"},{"n":3,"w":[["وَٱلنَّهَارِ","dan siang","wal-nahāri",209],["إِذَا","apabila","idhā",23],["جَلَّىٰهَا","menampakkannya","jallāhā",2401]],"t":"demi siang apabila menampakkannya,"},{"n":4,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",136],["إِذَا","apabila","idhā",23],["يَغْشَىٰهَا","menutupinya","yaghshāhā",683]],"t":"demi malam apabila menutupinya (gelap gulita),"},{"n":5,"w":[["وَٱلسَّمَآءِ","dan langit","wal-samāi",38],["وَمَا","dan apa","wamā",2],["بَنَىٰهَا","pembinaannya","banāhā",776]],"t":"demi langit serta perancangannya (yang menakjubkan),"},{"n":6,"w":[["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["طَحَىٰهَا","penghamparannya","ṭaḥāhā",3287]],"t":"demi bumi serta penghamparannya,"},{"n":7,"w":[["وَنَفْسٍۢ","dan manusia/jiwa","wanafsin",39],["وَمَا","dan apa","wamā",2],["سَوَّىٰهَا","penyempurnaanya","sawwāhā",668]],"t":"demi jiwa serta penyempurnaan (ciptaan)nya,"},{"n":8,"w":[["فَأَلْهَمَهَا","maka Dia mengilhamkan padanya","fa-alhamahā",2977],["فُجُورَهَا","kedurhakaanya","fujūrahā",3462],["وَتَقْوَىٰهَا","dan ketaqwaannya","wataqwāhā",578]],"t":"maka Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,"},{"n":9,"w":[["قَدْ","sesungguhnya","qad",24],["أَفْلَحَ","beruntung","aflaḥa",395],["مَن","siapa/orang","man",12],["زَكَّىٰهَا","mensucikannya","zakkāhā",750]],"t":"sungguh beruntung orang yang menyucikannya (jiwa itu),"},{"n":10,"w":[["وَقَدْ","dan sesungguhnya","waqad",24],["خَابَ","celaka/rugi","khāba",1672],["مَن","orang","man",12],["دَسَّىٰهَا","mengotorinya","dassāhā",3389]],"t":"dan sungguh rugi orang yang mengotorinya."},{"n":11,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["ثَمُودُ","Samud","thamūdu",415],["بِطَغْوَىٰهَآ","dan melampui batas","biṭaghwāhā",3289]],"t":"(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas (zalim),"},{"n":12,"w":[["إِذِ","ketika","idhi",53],["ٱنۢبَعَثَ","bangkit","inbaʿatha",4633],["أَشْقَىٰهَا","orang yang lebih celaka diantaranya","ashqāhā",1710]],"t":"ketika bangkit orang yang paling celaka di antara mereka,"},{"n":13,"w":[["فَقَالَ","dan berkata","faqāla",6],["لَهُمْ","kepada mereka","lahum",11],["رَسُولُ","rasul","rasūlu",35],["ٱللَّهِ","Allah","l-lahi",1],["نَاقَةَ","unta betina","nāqata",1088],["ٱللَّهِ","Allah","l-lahi",1],["وَسُقْيَـٰهَا","dan minumannya","wasuq'yāhā",4290]],"t":"lalu Rasul Allah (Saleh) berkata kepada mereka, \"(Biarkanlah) unta betina dari Allah ini dengan minumannya.\""},{"n":14,"w":[["فَكَذَّبُوهُ","dan mendustakan","fakadhabūhu",63],["فَعَقَرُوهَا","maka mereka melukai/menyembelih","faʿaqarūhā",1290],["فَدَمْدَمَ","maka menurunkan azab/membinasakan","fadamdama",3386],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["رَبُّهُم","Tuhan mereka","rabbuhum",10],["بِذَنۢبِهِمْ","dengan dosa-dosa mereka","bidhanbihim",314],["فَسَوَّىٰهَا","dan Dia meratakannya","fasawwāhā",668]],"t":"Namun mereka mendustakannya dan menyembelihnya, karena itu Tuhan membinasakan mereka karena dosanya, lalu diratakan-Nya (dengan tanah)."},{"n":15,"w":[["وَلَا","dan tidak","walā",4],["يَخَافُ","takut","yakhāfu",140],["عُقْبَـٰهَا","akibatnya","ʿuq'bāhā",1149]],"t":"Dan Dia tidak takut terhadap akibatnya."}]