[{"n":1,"w":[["وَٱلشَّمْسِ","demi matahari","wal-shamsi",358],["وَضُحَىٰهَا","dan cahayanya pagi hari","waḍuḥāhā",1159]],"t":"Demi matahari dan sinarnya pada pagi hari,"},{"n":2,"w":[["وَٱلْقَمَرِ","dan bulan","wal-qamari",419],["إِذَا","apabila","idhā",29],["تَلَىٰهَا","mengiringinya","talāhā",209]],"t":"demi bulan apabila mengiringinya,"},{"n":3,"w":[["وَٱلنَّهَارِ","dan siang","wal-nahāri",221],["إِذَا","apabila","idhā",29],["جَلَّىٰهَا","menampakkannya","jallāhā",2415]],"t":"demi siang apabila menampakkannya,"},{"n":4,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",146],["إِذَا","apabila","idhā",29],["يَغْشَىٰهَا","menutupinya","yaghshāhā",699]],"t":"demi malam apabila menutupinya (gelap gulita),"},{"n":5,"w":[["وَٱلسَّمَآءِ","dan langit","wal-samāi",44],["وَمَا","dan apa","wamā",6],["بَنَىٰهَا","pembinaannya","banāhā",792]],"t":"demi langit serta perancangannya (yang menakjubkan),"},{"n":6,"w":[["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["وَمَا","dan apa","wamā",6],["طَحَىٰهَا","penghamparannya","ṭaḥāhā",3298]],"t":"demi bumi serta penghamparannya,"},{"n":7,"w":[["وَنَفْسٍۢ","dan manusia/jiwa","wanafsin",47],["وَمَا","dan apa","wamā",6],["سَوَّىٰهَا","penyempurnaanya","sawwāhā",684]],"t":"demi jiwa serta penyempurnaan (ciptaan)nya,"},{"n":8,"w":[["فَأَلْهَمَهَا","maka Dia mengilhamkan padanya","fa-alhamahā",2989],["فُجُورَهَا","kedurhakaanya","fujūrahā",3472],["وَتَقْوَىٰهَا","dan ketaqwaannya","wataqwāhā",592]],"t":"maka Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,"},{"n":9,"w":[["قَدْ","sesungguhnya","qad",30],["أَفْلَحَ","beruntung","aflaḥa",410],["مَن","siapa/orang","man",17],["زَكَّىٰهَا","mensucikannya","zakkāhā",766]],"t":"sungguh beruntung orang yang menyucikannya (jiwa itu),"},{"n":10,"w":[["وَقَدْ","dan sesungguhnya","waqad",30],["خَابَ","celaka/rugi","khāba",1696],["مَن","orang","man",17],["دَسَّىٰهَا","mengotorinya","dassāhā",3400]],"t":"dan sungguh rugi orang yang mengotorinya."},{"n":11,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["ثَمُودُ","Samud","thamūdu",430],["بِطَغْوَىٰهَآ","dan melampui batas","biṭaghwāhā",3300]],"t":"(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas (zalim),"},{"n":12,"w":[["إِذِ","ketika","idhi",61],["ٱنۢبَعَثَ","bangkit","inbaʿatha",4639],["أَشْقَىٰهَا","orang yang lebih celaka diantaranya","ashqāhā",1734]],"t":"ketika bangkit orang yang paling celaka di antara mereka,"},{"n":13,"w":[["فَقَالَ","dan berkata","faqāla",10],["لَهُمْ","kepada mereka","lahum",16],["رَسُولُ","rasul","rasūlu",42],["ٱللَّهِ","Allah","l-lahi",4],["نَاقَةَ","unta betina","nāqata",1106],["ٱللَّهِ","Allah","l-lahi",4],["وَسُقْيَـٰهَا","dan minumannya","wasuq'yāhā",4296]],"t":"lalu Rasul Allah (Saleh) berkata kepada mereka, \"(Biarkanlah) unta betina dari Allah ini dengan minumannya.\""},{"n":14,"w":[["فَكَذَّبُوهُ","dan mendustakan","fakadhabūhu",72],["فَعَقَرُوهَا","maka mereka melukai/menyembelih","faʿaqarūhā",1308],["فَدَمْدَمَ","maka menurunkan azab/membinasakan","fadamdama",3397],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["رَبُّهُم","Tuhan mereka","rabbuhum",15],["بِذَنۢبِهِمْ","dengan dosa-dosa mereka","bidhanbihim",329],["فَسَوَّىٰهَا","dan Dia meratakannya","fasawwāhā",684]],"t":"Namun mereka mendustakannya dan menyembelihnya, karena itu Tuhan membinasakan mereka karena dosanya, lalu diratakan-Nya (dengan tanah)."},{"n":15,"w":[["وَلَا","dan tidak","walā",8],["يَخَافُ","takut","yakhāfu",150],["عُقْبَـٰهَا","akibatnya","ʿuq'bāhā",1167]],"t":"Dan Dia tidak takut terhadap akibatnya."}]