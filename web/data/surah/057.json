[{"n":1,"w":[["سَبَّحَ","bertasbih","sabbaḥa",283],["لِلَّهِ","kepada Allah","lillahi",1],["مَا","apa","mā",2],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Apa yang di langit dan di bumi bertasbih kepada Allah. Dialah Yang Mahaperkasa, Mahabijaksana."},{"n":2,"w":[["لَهُۥ","bagi-Nya","lahu",16],["مُلْكُ","kerajaan","mul'ku",252],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["يُحْىِۦ","Dia yang menghidupkan","yuḥ'yī",232],["وَيُمِيتُ ۖ","Dia yang mematikan","wayumītu",487],["وَهُوَ","dan Dia","wahuwa",19],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala/semuanya","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌ","berkuasa","qadīrun",265]],"t":"Milik-Nyalah kerajaan langit dan bumi, Dia menghidupkan dan mematikan, dan Dia Mahakuasa atas segala sesuatu."},{"n":3,"w":[["هُوَ","Dia","huwa",19],["ٱلْأَوَّلُ","Yang Pertama","l-awalu",142],["وَٱلْـَٔاخِرُ","dan Yang Akhir","wal-ākhiru",74],["وَٱلظَّـٰهِرُ","dan Yang Zahir","wal-ẓāhiru",832],["وَٱلْبَاطِنُ ۖ","dan Yang Batin","wal-bāṭinu",1543],["وَهُوَ","dan Dia","wahuwa",19],["بِكُلِّ","dengan segala/semua","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",69]],"t":"Dialah Yang Awal, Yang Akhir, Yang Zahir dan Yang Batin; dan Dia Maha Mengetahui segala sesuatu."},{"n":4,"w":[["هُوَ","dan Dia","huwa",19],["ٱلَّذِى","yang","alladhī",38],["خَلَقَ","menciptakan","khalaqa",62],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["فِى","pada","fī",3],["سِتَّةِ","enam","sittati",1108],["أَيَّامٍۢ","hari","ayyāmin",25],["ثُمَّ","kemudian","thumma",34],["ٱسْتَوَىٰ","Dia menuju","is'tawā",341],["عَلَى","atas","ʿalā",7],["ٱلْعَرْشِ ۚ","'Arasy","l-ʿarshi",382],["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["مَا","apa","mā",2],["يَلِجُ","masuk","yaliju",2044],["فِى","pada","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَمَا","dan apa","wamā",2],["يَخْرُجُ","yang keluar","yakhruju",227],["مِنْهَا","dari padanya","min'hā",0],["وَمَا","dan apa","wamā",2],["يَنزِلُ","yang turun","yanzilu",1216],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["وَمَا","dan apa","wamā",2],["يَعْرُجُ","yang keluar","yaʿruju",1297],["فِيهَا ۖ","dari padanya","fīhā",3],["وَهُوَ","dan Dia","wahuwa",19],["مَعَكُمْ","bersamamu","maʿakum",70],["أَيْنَ","dimana","ayna",526],["مَا","apa","mā",2],["كُنتُمْ ۚ","kalian adalah","kuntum",8],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","dengan apa-apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["بَصِيرٌۭ","Maha Melihat","baṣīrun",234]],"t":"Dialah yang menciptakan langit dan bumi dalam enam masa; kemudian Dia bersemayam di atas Arasy. Dia mengetahui apa yang masuk ke dalam bumi dan apa yang keluar dari dalamnya, apa yang turun dari langit dan apa yang naik ke sana . Dan Dia bersama kamu di mana saja kamu berada. Dan Allah Maha Melihat apa yang kamu kerjakan."},{"n":5,"w":[["لَّهُۥ","bagiNya","lahu",16],["مُلْكُ","kerjaan","mul'ku",252],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَإِلَى","dan kepada","wa-ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["تُرْجَعُ","dikembalikan","tur'jaʿu",147],["ٱلْأُمُورُ","urusan","l-umūru",67]],"t":"Milik-Nyalah kerajaan langit dan bumi. Dan hanya kepada Allah segala urusan dikembali­kan."},{"n":6,"w":[["يُولِجُ","Dia memasukkan","yūliju",820],["ٱلَّيْلَ","malam","al-layla",137],["فِى","pada","fī",3],["ٱلنَّهَارِ","siang","l-nahāri",211],["وَيُولِجُ","dan Dia memasukkan","wayūliju",820],["ٱلنَّهَارَ","siang","l-nahāra",211],["فِى","pada","fī",3],["ٱلَّيْلِ ۚ","malam","al-layli",137],["وَهُوَ","dan Dia","wahuwa",19],["عَلِيمٌۢ","mengetahui","ʿalīmun",69],["بِذَاتِ","dengan yang ada","bidhāti",117],["ٱلصُّدُورِ","dada","l-ṣudūri",271]],"t":"Dia memasukkan malam ke dalam siang dan memasukkan siang ke dalam malam. Dan Dia Maha Mengetahui segala isi hati."},{"n":7,"w":[["ءَامِنُوا۟","berimanlah kamu","āminū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ","dan rasul-Nya","warasūlihi",35],["وَأَنفِقُوا۟","dan belanjakanlah/nafkahkan","wa-anfiqū",183],["مِمَّا","dari apa-apa","mimmā",0],["جَعَلَكُم","Dia jadikan kamu","jaʿalakum",33],["مُّسْتَخْلَفِينَ","orang-orang yang menguasai","mus'takhlafīna",3990],["فِيهِ ۖ","padanya","fīhi",3],["فَٱلَّذِينَ","maka orang-orang yang","fa-alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["مِنكُمْ","diantara kamu","minkum",0],["وَأَنفَقُوا۟","dan mereka membelanjakan/menafkahkan","wa-anfaqū",183],["لَهُمْ","bagi mereka","lahum",11],["أَجْرٌۭ","pahala","ajrun",111],["كَبِيرٌۭ","besar","kabīrun",292]],"t":"Berimanlah kamu kepada Allah dan Rasul-Nya dan infakkanlah (di jalan Allah) sebagian dari harta yang Dia telah menjadikan kamu sebagai penguasanya (amanah). Maka orang-orang yang beriman di antara kamu dan menginfakkan (hartanya di jalan Allah) memperoleh pahala yang besar."},{"n":8,"w":[["وَمَا","dan apa-apa","wamā",2],["لَكُمْ","bagi kalian","lakum",26],["لَا","tidak","lā",4],["تُؤْمِنُونَ","kamu beriman","tu'minūna",18],["بِٱللَّهِ ۙ","kepada Allah","bil-lahi",1],["وَٱلرَّسُولُ","dan rasul","wal-rasūlu",35],["يَدْعُوكُمْ","menyeru kamu","yadʿūkum",66],["لِتُؤْمِنُوا۟","agar kamu beriman","litu'minū",18],["بِرَبِّكُمْ","kepada Tuhan kamu","birabbikum",10],["وَقَدْ","dan sesungguhnya","waqad",24],["أَخَذَ","Dia telah mengambil","akhadha",95],["مِيثَـٰقَكُمْ","perjanjian","mīthāqakum",433],["إِن","jika","in",14],["كُنتُم","kalian adalah","kuntum",8],["مُّؤْمِنِينَ","orang-orang yang beriman","mu'minīna",55]],"t":"Dan mengapa kamu tidak beriman kepada Allah, padahal Rasul mengajak kamu beriman kepada Tuhanmu? Dan Dia telah mengambil janji (setia)mu, jika kamu orang-orang mukmin."},{"n":9,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِى","orang-orang yang","alladhī",38],["يُنَزِّلُ","menurunkan","yunazzilu",197],["عَلَىٰ","atas","ʿalā",7],["عَبْدِهِۦٓ","hamba-Nya","ʿabdihi",91],["ءَايَـٰتٍۭ","ayat-ayat","āyātin",28],["بَيِّنَـٰتٍۢ","dengan jelas/terang","bayyinātin",175],["لِّيُخْرِجَكُم","Dia hendak mengeluarkan kamu","liyukh'rijakum",115],["مِّنَ","dari","mina",0],["ٱلظُّلُمَـٰتِ","kegelapan","l-ẓulumāti",453],["إِلَى","atas/kepada","ilā",13],["ٱلنُّورِ ۚ","cahaya","l-nūri",278],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["بِكُمْ","dengan/untuk kalian","bikum",26],["لَرَءُوفٌۭ","benar-benar Maha Penyantun","laraūfun",803],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",104]],"t":"Dialah yang menurunkan ayat-ayat yang terang (Alquran) kepada hamba-Nya (Muhammad) untuk mengeluarkan kamu dari kegelapan kepada cahaya. Dan sungguh, terhadap kamu Allah Maha Penyantun, Maha Penyayang."},{"n":10,"w":[["وَمَا","dan apa-apa","wamā",2],["لَكُمْ","bagi kalian","lakum",26],["أَلَّا","kecuali","allā",17],["تُنفِقُوا۟","kamu membelanjakan/menafkahkan","tunfiqū",183],["فِى","pada","fī",3],["سَبِيلِ","jalan","sabīli",65],["ٱللَّهِ","Allah","l-lahi",1],["وَلِلَّهِ","dan Allah","walillahi",1],["مِيرَٰثُ","mewarisi","mīrāthu",2489],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["لَا","tidak","lā",4],["يَسْتَوِى","sama","yastawī",341],["مِنكُم","dari kamu","minkum",0],["مَّنْ","siapa","man",12],["أَنفَقَ","membelanjakan/menafkahkan","anfaqa",183],["مِن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["ٱلْفَتْحِ","kemenangan/penaklukan","l-fatḥi",736],["وَقَـٰتَلَ ۚ","dan ia berperang","waqātala",224],["أُو۟لَـٰٓئِكَ","seperti itulah","ulāika",57],["أَعْظَمُ","lebih tinggi","aʿẓamu",1726],["دَرَجَةًۭ","derajat","darajatan",550],["مِّنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["أَنفَقُوا۟","menafkahkan","anfaqū",183],["مِنۢ","dari","min",0],["بَعْدُ","setelah","baʿdu",59],["وَقَـٰتَلُوا۟ ۚ","dan mereka berperang","waqātalū",224],["وَكُلًّۭا","dan makanlah","wakullan",31],["وَعَدَ","telah menjajikan","waʿada",180],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْحُسْنَىٰ ۚ","lebih baik","l-ḥus'nā",570],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",267]],"t":"Dan mengapa kamu tidak menginfakkan hartamu di jalan Allah, padahal milik Allah semua pusaka langit dan bumi? Tidak sama orang yang menginfakkan (hartanya di jalan Allah) di antara kamu dan berperang sebelum penaklukan (Mekkah). Mereka lebih tinggi derajatnya daripada orang-orang yang menginfakkan (hartanya) dan berperang setelah itu. Dan Allah menjanjikan kepada masing-masing mereka (balasan) yang lebih baik. Dan Allah Mahateliti atas apa yang kamu kerjakan."},{"n":11,"w":[["مَّن","siapa","man",12],["ذَا","mempunyai","dhā",448],["ٱلَّذِى","orang-orang yang","alladhī",38],["يُقْرِضُ","memberi pinjaman","yuq'riḍu",1136],["ٱللَّهَ","Allah","l-laha",1],["قَرْضًا","pinjaman","qarḍan",1225],["حَسَنًۭا","kebaikan","ḥasanan",488],["فَيُضَـٰعِفَهُۥ","maka Dia akan melipat-gandakannya","fayuḍāʿifahu",886],["لَهُۥ","baginya","lahu",16],["وَلَهُۥٓ","dan baginya","walahu",16],["أَجْرٌۭ","pahala","ajrun",111],["كَرِيمٌۭ","yang besar","karīmun",373]],"t":"Barangsiapa meminjamkan kepada Allah dengan pinjaman yang baik, maka Allah akan mengembalikannya berlipat ganda untuknya, dan baginya pahala yang mulia,"},{"n":12,"w":[["يَوْمَ","hari","yawma",25],["تَرَى","kamu melihat","tarā",46],["ٱلْمُؤْمِنِينَ","orang-orang beriman","l-mu'minīna",55],["وَٱلْمُؤْمِنَـٰتِ","dan orang-orang perempuan beriman","wal-mu'mināti",55],["يَسْعَىٰ","berjalan/bersinar","yasʿā",520],["نُورُهُم","cahaya mereka","nūruhum",278],["بَيْنَ","diantara","bayna",47],["أَيْدِيهِمْ","hadapan mereka","aydīhim",102],["وَبِأَيْمَـٰنِهِم","dan disebelah kanan mereka","wabi-aymānihim",188],["بُشْرَىٰكُمُ","berita gembira untuk mu","bush'rākumu",629],["ٱلْيَوْمَ","hari ini","l-yawma",25],["جَنَّـٰتٌۭ","surga","jannātun",78],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",236],["ٱلْأَنْهَـٰرُ","sungai","l-anhāru",223],["خَـٰلِدِينَ","kekal","khālidīna",163],["فِيهَا ۚ","padanya","fīhā",3],["ذَٰلِكَ","itulah","dhālika",20],["هُوَ","dia","huwa",19],["ٱلْفَوْزُ","kemenangan/keuntungan","l-fawzu",531],["ٱلْعَظِيمُ","yang besar","l-ʿaẓīmu",101]],"t":"pada hari engkau akan melihat orang-orang yang beriman laki-laki dan perempuan, betapa cahaya mereka bersinar di depan dan di samping kanan mereka, (dikatakan kepada mereka), \"Pada hari ini ada berita gembira untukmu, (yaitu) surga-surga yang mengalir di bawahnya sungai-sungai, mereka kekal di dalamnya. Demikianlah kemenangan yang agung.\""},{"n":13,"w":[["يَوْمَ","hari","yawma",25],["يَقُولُ","berkata","yaqūlu",6],["ٱلْمُنَـٰفِقُونَ","orang-orang munafik laki-laki","l-munāfiqūna",361],["وَٱلْمُنَـٰفِقَـٰتُ","dan orang-orang munafik perempuan","wal-munāfiqātu",361],["لِلَّذِينَ","kepada orang-orang","lilladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["ٱنظُرُونَا","tungguhlah kami","unẓurūnā",130],["نَقْتَبِسْ","kami mengambil","naqtabis",4641],["مِن","dari","min",0],["نُّورِكُمْ","cahaya kamu","nūrikum",278],["قِيلَ","dikatakan","qīla",6],["ٱرْجِعُوا۟","kembalilah","ir'jiʿū",147],["وَرَآءَكُمْ","belakangmu","warāakum",447],["فَٱلْتَمِسُوا۟","maka carilah","fal-tamisū",4622],["نُورًۭا","cahaya","nūran",278],["فَضُرِبَ","lalu dijadikan/diadakan","faḍuriba",220],["بَيْنَهُم","diantara mereka","baynahum",47],["بِسُورٍۢ","dengan dinding","bisūrin",4290],["لَّهُۥ","baginya","lahu",16],["بَابٌۢ","pintu","bābun",404],["بَاطِنُهُۥ","didalamnya/dibatin","bāṭinuhu",1543],["فِيهِ","didalamnya","fīhi",3],["ٱلرَّحْمَةُ","rahmat","l-raḥmatu",106],["وَظَـٰهِرُهُۥ","dan luarnya","waẓāhiruhu",832],["مِن","dari","min",0],["قِبَلِهِ","pihaknya/sisinya","qibalihi",1640],["ٱلْعَذَابُ","azab","l-ʿadhābu",36]],"t":"Pada hari orang-orang munafik laki-laki dan perempuan berkata kepada orang-orang yang beriman, \"Tunggulah kami! Kami ingin mengambil cahayamu.\" (Kepada mereka) dikatakan, \"Kembalilah kamu ke belakang dan carilah sendiri cahaya (untukmu).\" Lalu di antara mereka dipasang dinding (pemisah) yang berpintu. Di bagian dalam ada rahmat dan di luarnya hanya ada azab."},{"n":14,"w":[["يُنَادُونَهُمْ","(orang-orang munafik) memanggil mereka","yunādūnahum",273],["أَلَمْ","tidaklah","alam",32],["نَكُن","adalah kami","nakun",8],["مَّعَكُمْ ۖ","bersamamu","maʿakum",70],["قَالُوا۟","dan berkata","qālū",6],["بَلَىٰ","ya benar","balā",466],["وَلَـٰكِنَّكُمْ","tetapi kamu","walākinnakum",210],["فَتَنتُمْ","kamu telah membinasakan","fatantum",455],["أَنفُسَكُمْ","diri kalian sendiri","anfusakum",39],["وَتَرَبَّصْتُمْ","dan kamu menunggu-nunggu","watarabbaṣtum",702],["وَٱرْتَبْتُمْ","dan kamu ragu-ragu","wa-ir'tabtum",950],["وَغَرَّتْكُمُ","dan menipu kamu","wagharratkumu",631],["ٱلْأَمَانِىُّ","angan-angan kosong","l-amāniyu",1144],["حَتَّىٰ","sehingga","ḥattā",83],["جَآءَ","datang","jāa",43],["أَمْرُ","ketetapan","amru",67],["ٱللَّهِ","Allah","l-lahi",1],["وَغَرَّكُم","menipu kamu","wagharrakum",631],["بِٱللَّهِ","terhadap Allah","bil-lahi",1],["ٱلْغَرُورُ","para penipu","l-gharūru",1858]],"t":"Orang-orang munafik memanggil orang-orang mukmin, \"Bukankah kami dahulu bersama kamu?\" Mereka menjawab, \"Benar, tetapi kamu mencelakakan dirimu sendiri, dan kamu hanya menunggu, meragukan (janji Allah) dan ditipu oleh angan-angan kosong sampai datang ketetapan Allah; dan penipu (setan) datang memperdaya kamu tentang Allah."},{"n":15,"w":[["فَٱلْيَوْمَ","maka pada hari","fal-yawma",25],["لَا","tidak","lā",4],["يُؤْخَذُ","diambil/diterima","yu'khadhu",95],["مِنكُمْ","dari kamu","minkum",0],["فِدْيَةٌۭ","tebusan","fid'yatun",1847],["وَلَا","dan tidak","walā",4],["مِنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟ ۚ","kafir/ingkar","kafarū",40],["مَأْوَىٰكُمُ","tempat tinggal kamu","mawākumu",472],["ٱلنَّارُ ۖ","api/neraka","l-nāru",79],["هِىَ","ia/itu","hiya",193],["مَوْلَىٰكُمْ ۖ","perlindungan kamu","mawlākum",493],["وَبِئْسَ","dan seburuk-buruk","wabi'sa",297],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",394]],"t":"Maka pada hari ini tidak akan diterima tebusan dari kamu maupun dari orang-orang kafir. Tempat kamu di neraka. Itulah tempat berlindungmu, dan itulah seburuk-buruk tempat kembali.\""},{"n":16,"w":[["۞ أَلَمْ","apakah tidak","alam",32],["يَأْنِ","datang","yani",2988],["لِلَّذِينَ","orang-orang yang","lilladhīna",9],["ءَامَنُوٓا۟","beriman","āmanū",18],["أَن","bahwa","an",17],["تَخْشَعَ","tunduk","takhshaʿa",2735],["قُلُوبُهُمْ","hati mereka","qulūbuhum",90],["لِذِكْرِ","untuk mengingat","lidhik'ri",153],["ٱللَّهِ","Allah","l-lahi",1],["وَمَا","dan apa","wamā",2],["نَزَلَ","menurunkan","nazala",1216],["مِنَ","dari","mina",0],["ٱلْحَقِّ","kebenaran","l-ḥaqi",50],["وَلَا","dan tidak","walā",4],["يَكُونُوا۟","adalah mereka","yakūnū",8],["كَٱلَّذِينَ","seperti orang-orang yang","ka-alladhīna",9],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْكِتَـٰبَ","Al Kitab","l-kitāba",49],["مِن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["فَطَالَ","lalu panjang","faṭāla",1815],["عَلَيْهِمُ","atas mereka","ʿalayhimu",7],["ٱلْأَمَدُ","masa","l-amadu",1483],["فَقَسَتْ","maka keras","faqasat",1975],["قُلُوبُهُمْ ۖ","hati mereka","qulūbuhum",90],["وَكَثِيرٌۭ","dan kebanyakan","wakathīrun",162],["مِّنْهُمْ","diantara mereka","min'hum",0],["فَـٰسِقُونَ","orang-orang fasik","fāsiqūna",324]],"t":"Belum tibakah waktunya bagi orang-orang yang beriman, untuk secara khusyuk mengingat Allah dan mematuhi kebenaran yang telah diwahyukan (kepada mereka), dan janganlah mereka (berlaku) seperti orang-orang yang telah menerima kitab sebelum itu, kemudian mereka melalui masa yang panjang sehingga hati mereka menjadi keras. Dan banyak di antara mereka menjadi orang-orang fasik."},{"n":17,"w":[["ٱعْلَمُوٓا۟","ketahuilah","iʿ'lamū",29],["أَنَّ","sesungguhnya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["يُحْىِ","menghidupkan","yuḥ'yī",232],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",59],["مَوْتِهَا ۚ","matinya","mawtihā",239],["قَدْ","sesungguhnya","qad",24],["بَيَّنَّا","Kami telah menjelaskan","bayyannā",336],["لَكُمُ","bagi kalian","lakumu",26],["ٱلْـَٔايَـٰتِ","keterangan-keterangan","l-āyāti",28],["لَعَلَّكُمْ","agar kalian","laʿallakum",93],["تَعْقِلُونَ","kalian menggunakan akal","taʿqilūna",243]],"t":"Ketahuilah bahwa Allah yang menghidupkan bumi setelah matinya (kering). Sungguh, telah Kami jelaskan kepadamu tanda-tanda (kebesaran Kami) agar kamu mengerti."},{"n":18,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُصَّدِّقِينَ","orang-orang laki-laki yang benar","l-muṣadiqīna",2497],["وَٱلْمُصَّدِّقَـٰتِ","dan orang-orang perempuan yang benar","wal-muṣadiqāti",2497],["وَأَقْرَضُوا۟","dan mereka memberi pinjaman","wa-aqraḍū",1136],["ٱللَّهَ","Allah","l-laha",1],["قَرْضًا","pinjaman","qarḍan",1225],["حَسَنًۭا","kebaikan/yang baik","ḥasanan",488],["يُضَـٰعَفُ","akan dilipat gandakan","yuḍāʿafu",886],["لَهُمْ","untuk mereka","lahum",11],["وَلَهُمْ","dan untuk mereka","walahum",11],["أَجْرٌۭ","pahala","ajrun",111],["كَرِيمٌۭ","mulia","karīmun",373]],"t":"Sesungguhnya orang-orang yang bersedekah baik laki-laki maupun perempuan dan meminjamkan kepada Allah dengan pinjaman yang baik, akan dilipatgandakan (balasannya) bagi mereka; dan mereka akan mendapat pahala yang mulia."},{"n":19,"w":[["وَٱلَّذِينَ","dan orang-orang","wa-alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرُسُلِهِۦٓ","dan rasul Nya","warusulihi",35],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["هُمُ","mereka","humu",11],["ٱلصِّدِّيقُونَ ۖ","orang-orang yang benar","l-ṣidīqūna",1316],["وَٱلشُّهَدَآءُ","dan orang-orang yang menjadi saksi","wal-shuhadāu",216],["عِندَ","disisi","ʿinda",60],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["لَهُمْ","bagi mereka","lahum",11],["أَجْرُهُمْ","pahala mereka","ajruhum",111],["وَنُورُهُمْ ۖ","dan cahaya mereka","wanūruhum",278],["وَٱلَّذِينَ","dan orang-orang","wa-alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَكَذَّبُوا۟","dan mendustakan","wakadhabū",64],["بِـَٔايَـٰتِنَآ","dengan ayat-ayat Kami","biāyātinā",28],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["أَصْحَـٰبُ","penghuni","aṣḥābu",123],["ٱلْجَحِيمِ","neraka","l-jaḥīmi",416]],"t":"Dan orang-orang yang beriman kepada Allah dan rasul-rasul-Nya, mereka itu orang-orang yang tulus hati (pecinta kebenaran) dan saksi-saksi di sisi Tuhan mereka. Mereka berhak mendapat pahala dan cahaya. Tetapi orang-orang yang kafir dan mendustakan ayat-ayat Kami, mereka itu penghuni-penghuni neraka."},{"n":20,"w":[["ٱعْلَمُوٓا۟","ketahuilah","iʿ'lamū",29],["أَنَّمَا","sesungguhnya hanyalah","annamā",30],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",154],["ٱلدُّنْيَا","dunia","l-dun'yā",105],["لَعِبٌۭ","permainan","laʿibun",986],["وَلَهْوٌۭ","dan senda gurau","walahwun",843],["وَزِينَةٌۭ","dan perhiasan","wazīnatun",537],["وَتَفَاخُرٌۢ","dan bermegah-megahan","watafākhurun",4341],["بَيْنَكُمْ","diantara kamu","baynakum",47],["وَتَكَاثُرٌۭ","dan berbangga-banggaan","watakāthurun",2709],["فِى","pada/tentang","fī",3],["ٱلْأَمْوَٰلِ","harta","l-amwāli",132],["وَٱلْأَوْلَـٰدِ ۖ","dan anak-anak","wal-awlādi",218],["كَمَثَلِ","seperti perumpamaan","kamathali",129],["غَيْثٍ","hujan","ghaythin",1860],["أَعْجَبَ","mengagumkan","aʿjaba",765],["ٱلْكُفَّارَ","orang-orang kafir/petani","l-kufāra",71],["نَبَاتُهُۥ","tanaman-tanamannya","nabātuhu",924],["ثُمَّ","kemudian","thumma",34],["يَهِيجُ","ia menjadi kering","yahīju",2388],["فَتَرَىٰهُ","maka kamu melihatnya","fatarāhu",46],["مُصْفَرًّۭا","kuning","muṣ'farran",1922],["ثُمَّ","kemudian","thumma",34],["يَكُونُ","adalah ia","yakūnu",8],["حُطَـٰمًۭا ۖ","hancur","ḥuṭāman",1807],["وَفِى","dan pada","wafī",3],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",74],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌۭ","pedih","shadīdun",215],["وَمَغْفِرَةٌۭ","dan ampunan","wamaghfiratun",396],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["وَرِضْوَٰنٌۭ ۚ","dan keridaan","wariḍ'wānun",701],["وَمَا","dan tidaklah","wamā",2],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",154],["ٱلدُّنْيَآ","dunia","l-dun'yā",105],["إِلَّا","kecuali","illā",15],["مَتَـٰعُ","kesenangan","matāʿu",337],["ٱلْغُرُورِ","tipuan","l-ghurūri",910]],"t":"Ketahuilah, sesungguhnya kehidupan dunia itu hanyalah permainan dan senda gurauan, perhiasan dan saling berbangga di antara kamu serta berlomba dalam kekayaan dan anak keturunan, seperti hujan yang tanam-tanamannya mengagumkan para petani; kemudian (tanaman) itu menjadi kering dan kamu lihat warnanya kuning kemudian menjadi hancur. Dan di akhirat (nanti) ada azab yang keras dan ampunan dari Allah serta keridaan-Nya. Dan kehidupan dunia tidak lain hanyalah kesenangan yang palsu."},{"n":21,"w":[["سَابِقُوٓا۟","berlomba-lombalah kamu","sābiqū",4224],["إِلَىٰ","kepada","ilā",13],["مَغْفِرَةٍۢ","ampunan","maghfiratin",396],["مِّن","dari","min",0],["رَّبِّكُمْ","Tuhan kalian","rabbikum",10],["وَجَنَّةٍ","dan surga","wajannatin",78],["عَرْضُهَا","luasnya","ʿarḍuhā",1507],["كَعَرْضِ","seperti luas","kaʿarḍi",1507],["ٱلسَّمَآءِ","langit","l-samāi",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["أُعِدَّتْ","dijanjikan/disediakan","uʿiddat",502],["لِلَّذِينَ","bagi orang-orang","lilladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرُسُلِهِۦ ۚ","dan rasul Nya","warusulihi",35],["ذَٰلِكَ","itulah","dhālika",20],["فَضْلُ","karunia","faḍlu",136],["ٱللَّهِ","Allah","l-lahi",1],["يُؤْتِيهِ","diberikannya","yu'tīhi",45],["مَن","siapa","man",12],["يَشَآءُ ۚ","yang dikehendaki","yashāu",54],["وَٱللَّهُ","dan Allah","wal-lahu",1],["ذُو","mempunyai","dhū",117],["ٱلْفَضْلِ","karunia","l-faḍli",136],["ٱلْعَظِيمِ","yang besar","l-ʿaẓīmi",101]],"t":"Berlomba-lombalah kamu untuk mendapatkan ampunan dari Tuhanmu dan surga yang luasnya seluas langit dan bumi, yang disediakan bagi orang-orang yang beriman kepada Allah dan rasul-rasul-Nya. Itulah karunia Allah, yang diberikan kepada siapa yang Dia kehendaki. Dan Allah mempunyai karunia yang besar."},{"n":22,"w":[["مَآ","tidak","mā",2],["أَصَابَ","menimpa","aṣāba",191],["مِن","dari","min",0],["مُّصِيبَةٍۢ","bencana","muṣībatin",853],["فِى","pada","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَا","dan tidak","walā",4],["فِىٓ","pada","fī",3],["أَنفُسِكُمْ","diri kalian sendiri","anfusikum",39],["إِلَّا","kecuali","illā",15],["فِى","pada","fī",3],["كِتَـٰبٍۢ","kitab","kitābin",49],["مِّن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",17],["نَّبْرَأَهَآ ۚ","Kami menciptakannya","nabra-ahā",3350],["إِنَّ","sesungguhnya","inna",5],["ذَٰلِكَ","demikian/itu","dhālika",20],["عَلَى","atas","ʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["يَسِيرٌۭ","mudah","yasīrun",643]],"t":"Setiap bencana yang menimpa di bumi dan yang menimpa dirimu sendiri, semuanya telah tertulis dalam Kitab (Lauḥ Maḥfūẓ) sebelum Kami mewujudkannya. Sungguh, yang demikian itu mudah bagi Allah."},{"n":23,"w":[["لِّكَيْلَا","supaya jangan","likaylā",841],["تَأْسَوْا۟","kamu berduka-cita","tasaw",1491],["عَلَىٰ","atas","ʿalā",7],["مَا","apa-apa","mā",2],["فَاتَكُمْ","luput dari kamu","fātakum",1839],["وَلَا","dan janganlah","walā",4],["تَفْرَحُوا۟","kamu gembira","tafraḥū",596],["بِمَآ","terhadap apa","bimā",2],["ءَاتَىٰكُمْ ۗ","Dia berikan kepadamu","ātākum",45],["وَٱللَّهُ","dan Allah","wal-lahu",1],["لَا","tidak","lā",4],["يُحِبُّ","mencintai/menyukai","yuḥibbu",190],["كُلَّ","setiap/segala","kulla",31],["مُخْتَالٍۢ","sombong","mukh'tālin",1939],["فَخُورٍ","membanggakan diri","fakhūrin",1559]],"t":"Agar kamu tidak bersedih hati terhadap apa yang luput dari kamu, dan tidak pula terlalu gembira terhadap apa yang diberikan-Nya kepadamu. Dan Allah tidak menyukai setiap orang yang sombong dan membanggakan diri,"},{"n":24,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["يَبْخَلُونَ","(mereka) kikir","yabkhalūna",834],["وَيَأْمُرُونَ","dan mereka menyuruh","wayamurūna",151],["ٱلنَّاسَ","manusia","l-nāsa",52],["بِٱلْبُخْلِ ۗ","dengan berbuat kikir","bil-bukh'li",2344],["وَمَن","dan barang siapa","waman",12],["يَتَوَلَّ","berpaling","yatawalla",150],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["هُوَ","Dia","huwa",19],["ٱلْغَنِىُّ","Maha Kaya","l-ghaniyu",443],["ٱلْحَمِيدُ","Maha Terpuji","l-ḥamīdu",568]],"t":"yaitu orang-orang yang kikir dan menyuruh orang lain berbuat kikir. Barangsiapa berpaling (dari perintah-perintah Allah), maka sesungguhnya Allah, Dia Mahakaya, Maha Terpuji."},{"n":25,"w":[["لَقَدْ","sesungguhnya","laqad",24],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",92],["رُسُلَنَا","rasul-rasul Kami","rusulanā",35],["بِٱلْبَيِّنَـٰتِ","dengan keterangan-keterangan nyata","bil-bayināti",175],["وَأَنزَلْنَا","dan Kami menurunkan","wa-anzalnā",63],["مَعَهُمُ","bersama mereka","maʿahumu",70],["ٱلْكِتَـٰبَ","Al Kitab","l-kitāba",49],["وَٱلْمِيزَانَ","dan timbangan","wal-mīzāna",603],["لِيَقُومَ","supaya menegakkan","liyaqūma",354],["ٱلنَّاسُ","manusia","l-nāsu",52],["بِٱلْقِسْطِ ۖ","dengan adil","bil-qis'ṭi",638],["وَأَنزَلْنَا","dan Kami turunkan/jadikan","wa-anzalnā",63],["ٱلْحَدِيدَ","besi","l-ḥadīda",1157],["فِيهِ","padanya","fīhi",3],["بَأْسٌۭ","kekuatan","basun",427],["شَدِيدٌۭ","yang sangat","shadīdun",215],["وَمَنَـٰفِعُ","dan manfaat","wamanāfiʿu",988],["لِلنَّاسِ","bagi manusia","lilnnāsi",52],["وَلِيَعْلَمَ","dan hendak mengetahui","waliyaʿlama",29],["ٱللَّهُ","Allah","l-lahu",1],["مَن","siapa","man",12],["يَنصُرُهُۥ","menolong-Nya","yanṣuruhu",202],["وَرُسُلَهُۥ","dan rasul-rasul-Nya","warusulahu",35],["بِٱلْغَيْبِ ۚ","dengan gaib/tidak kelihatan","bil-ghaybi",244],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["قَوِىٌّ","Maha Kuat","qawiyyun",802],["عَزِيزٌۭ","Maha Perkasa","ʿazīzun",114]],"t":"Sungguh, Kami telah mengutus rasul-rasul Kami dengan bukti-bukti yang nyata dan Kami turunkan bersama mereka Kitab dan neraca (keadilan) agar manusia dapat berlaku adil. Dan Kami menciptakan besi yang mempunyai kekuatan hebat dan banyak manfaat bagi manusia, dan agar Allah mengetahui siapa yang menolong (agama)-Nya dan rasul-rasul-Nya walaupun (Allah) tidak dilihatnya. Sesungguhnya Allah Mahakuat, Mahaperkasa."},{"n":26,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَرْسَلْنَا","Kami mengutus","arsalnā",92],["نُوحًۭا","Nuh","nūḥan",277],["وَإِبْرَٰهِيمَ","dan Ibrahim","wa-ib'rāhīma",182],["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["فِى","pada","fī",3],["ذُرِّيَّتِهِمَا","anak cucu/keturunan mereka","dhurriyyatihimā",355],["ٱلنُّبُوَّةَ","kenabian","l-nubuwata",1399],["وَٱلْكِتَـٰبَ ۖ","dan Al Kitab","wal-kitāba",49],["فَمِنْهُم","dan diantara mereka","famin'hum",0],["مُّهْتَدٍۢ ۖ","mendapat petunjuk","muh'tadin",518],["وَكَثِيرٌۭ","dan kebanyakan","wakathīrun",162],["مِّنْهُمْ","dari mereka","min'hum",0],["فَـٰسِقُونَ","orang-orang fasik","fāsiqūna",324]],"t":"Dan sungguh, Kami telah mengutus Nuh dan Ibrahim dan Kami berikan kenabian dan kitab (wahyu) kepada keturunan keduanya, di antara mereka ada yang menerima petunjuk dan banyak di antara mereka yang fasik."},{"n":27,"w":[["ثُمَّ","kemudian","thumma",34],["قَفَّيْنَا","Kami ikutkan/iringi","qaffaynā",1635],["عَلَىٰٓ","atas","ʿalā",7],["ءَاثَـٰرِهِم","jejak/belakang mereka","āthārihim",651],["بِرُسُلِنَا","dengan rasul-rasul Kami","birusulinā",35],["وَقَفَّيْنَا","dan Kami ikutkan/iringkan","waqaffaynā",1635],["بِعِيسَى","dengan Isa","biʿīsā",426],["ٱبْنِ","anak","ib'ni",82],["مَرْيَمَ","Maryam","maryama",346],["وَءَاتَيْنَـٰهُ","dan Kami berikannya","waātaynāhu",45],["ٱلْإِنجِيلَ","Injil","l-injīla",712],["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["فِى","dalam","fī",3],["قُلُوبِ","hati","qulūbi",90],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ٱتَّبَعُوهُ","mengikutinya","ittabaʿūhu",87],["رَأْفَةًۭ","rasa satun","rafatan",2601],["وَرَحْمَةًۭ","dan kasih sayang","waraḥmatan",106],["وَرَهْبَانِيَّةً","dan rahbaniyah/kependetaan","warahbāniyyatan",4165],["ٱبْتَدَعُوهَا","mereka adakan","ib'tadaʿūhā",4609],["مَا","apa-apa","mā",2],["كَتَبْنَـٰهَا","Kami mewajibkannya","katabnāhā",245],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["إِلَّا","kecuali","illā",15],["ٱبْتِغَآءَ","mencari","ib'tighāa",676],["رِضْوَٰنِ","keridaan","riḍ'wāni",701],["ٱللَّهِ","Allah","l-lahi",1],["فَمَا","maka tidak","famā",2],["رَعَوْهَا","memeliharanya","raʿawhā",2606],["حَقَّ","sebenar-benarnya","ḥaqqa",50],["رِعَايَتِهَا ۖ","pemeliharaan","riʿāyatihā",4186],["فَـَٔاتَيْنَا","maka Kami berikan","faātaynā",45],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["مِنْهُمْ","diantara mereka","min'hum",0],["أَجْرَهُمْ ۖ","pahala mereka","ajrahum",111],["وَكَثِيرٌۭ","dan kebanyakan","wakathīrun",162],["مِّنْهُمْ","dari mereka","min'hum",0],["فَـٰسِقُونَ","orang-orang fasik","fāsiqūna",324]],"t":"Kemudian Kami susulkan rasul-rasul Kami mengikuti jejak mereka dan Kami susulkan (pula) Isa putra Maryam; Dan Kami berikan Injil kepadanya dan Kami jadikan rasa santun dan kasih sayang dalam hati orang-orang yang mengikutinya. Mereka mengada-adakan raḥbāniyyah, padahal Kami tidak mewajibkannya kepada mereka (yang Kami wajibkan hanyalah) mencari keridaan Allah, tetapi tidak mereka pelihara dengan semestinya. Maka kepada orang-orang yang beriman di antara mereka Kami berikan pahalanya, dan banyak di antara mereka yang fasik."},{"n":28,"w":[["يَـٰٓأَيُّهَا","hai","yāayyuhā",75],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["ٱتَّقُوا۟","bertakwalah","ittaqū",68],["ٱللَّهَ","Allah","l-laha",1],["وَءَامِنُوا۟","dan berimanlah","waāminū",18],["بِرَسُولِهِۦ","kepada rasul-rasulnya","birasūlihi",35],["يُؤْتِكُمْ","Dia akan memberikan kepada kamu","yu'tikum",45],["كِفْلَيْنِ","dua bagian","kif'layni",1583],["مِن","dari","min",0],["رَّحْمَتِهِۦ","rahmat-Nya","raḥmatihi",106],["وَيَجْعَل","dan Dia menjadikan","wayajʿal",33],["لَّكُمْ","bagi kalian","lakum",26],["نُورًۭا","cahaya","nūran",278],["تَمْشُونَ","kamu berjalan","tamshūna",492],["بِهِۦ","padanya","bihi",16],["وَيَغْفِرْ","dan mengampuni","wayaghfir",187],["لَكُمْ ۚ","bagi kalian","lakum",26],["وَٱللَّهُ","dan Allah","wal-lahu",1],["غَفُورٌۭ","Maha Pengampun","ghafūrun",122],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",104]],"t":"Wahai orang-orang yang beriman! Bertakwalah kepada Allah dan berimanlah kepada Rasul-Nya (Muhammad), niscaya Allah memberikan rahmat-Nya kepada dua bagian, dan menjadikan cahaya untukmu yang dengan cahaya itu kamu dapat berjalan serta Dia mengampuni kamu. Dan Allah Maha Pengampun, Maha Penyayang,"},{"n":29,"w":[["لِّئَلَّا","agar supaya","li-allā",4],["يَعْلَمَ","mengetahui","yaʿlama",29],["أَهْلُ","ahli","ahlu",94],["ٱلْكِتَـٰبِ","kitab","l-kitābi",49],["أَلَّا","bahwa tidak","allā",17],["يَقْدِرُونَ","mereka berkuasa","yaqdirūna",434],["عَلَىٰ","atas","ʿalā",7],["شَىْءٍۢ","segala sesuatu","shayin",41],["مِّن","dari","min",0],["فَضْلِ","karunia","faḍli",136],["ٱللَّهِ ۙ","Allah","l-lahi",1],["وَأَنَّ","dan sesungguhnya","wa-anna",30],["ٱلْفَضْلَ","karunia","l-faḍla",136],["بِيَدِ","ditangan","biyadi",102],["ٱللَّهِ","Allah","l-lahi",1],["يُؤْتِيهِ","Dia berikan","yu'tīhi",45],["مَن","siapa","man",12],["يَشَآءُ ۚ","yang dikehendaki","yashāu",54],["وَٱللَّهُ","dan Allah","wal-lahu",1],["ذُو","memiliki","dhū",117],["ٱلْفَضْلِ","karunia","l-faḍli",136],["ٱلْعَظِيمِ","yang besar","l-ʿaẓīmi",101]],"t":"agar Ahli Kitab mengetahui bahwa sedikit pun mereka tidak akan mendapat karunia Allah (jika mereka tidak beriman kepada Muhammad), dan bahwa karunia itu ada di tangan Allah, Dia memberikannya kepada siapa yang Dia kehendaki. Dan Allah mempunyai karunia yang besar."}]