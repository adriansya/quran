[{"n":1,"w":[["ٱلْحَمْدُ","segala puji","al-ḥamdu",276],["لِلَّهِ","bagi Allah","lillahi",1],["فَاطِرِ","pencipta","fāṭiri",1177],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["جَاعِلِ","yang menjadikan","jāʿili",1190],["ٱلْمَلَـٰٓئِكَةِ","malaikat","l-malāikati",128],["رُسُلًا","utusan","rusulan",35],["أُو۟لِىٓ","mempunyai","ulī",262],["أَجْنِحَةٍۢ","sayap","ajniḥatin",1079],["مَّثْنَىٰ","dua","mathnā",1372],["وَثُلَـٰثَ","dan tiga","wathulātha",2716],["وَرُبَـٰعَ ۚ","dan empat","warubāʿa",2621],["يَزِيدُ","Dia menambahkan","yazīdu",249],["فِى","dalam","fī",3],["ٱلْخَلْقِ","ciptaan","l-khalqi",231],["مَا","apa","mā",2],["يَشَآءُ ۚ","yang Dia kehendaki","yashāu",54],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha Kuasa","qadīrun",265]],"t":"Segala puji bagi Allah Pencipta langit dan bumi, yang menjadikan malaikat sebagai utusan-utusan (untuk mengurus berbagai macam urusan) yang mempunyai sayap, masing-masing (ada yang) dua, tiga dan empat. Allah menambahkan pada ciptaan-Nya apa yang Dia kehendaki. Sungguh, Allah Mahakuasa atas segala sesuatu."},{"n":2,"w":[["مَّا","apa","mā",2],["يَفْتَحِ","yang bukakan/anugerahkan","yaftaḥi",597],["ٱللَّهُ","Allah","l-lahu",1],["لِلنَّاسِ","bagi manusia","lilnnāsi",52],["مِن","dari","min",0],["رَّحْمَةٍۢ","suatu rahmat","raḥmatin",106],["فَلَا","maka tidak ada","falā",4],["مُمْسِكَ","yang menahan","mum'sika",2507],["لَهَا ۖ","baginya","lahā",98],["وَمَا","dan apa","wamā",2],["يُمْسِكْ","Dia menahan","yum'sik",543],["فَلَا","maka tidak ada","falā",4],["مُرْسِلَ","menyampaikan/melepaskan","mur'sila",1383],["لَهُۥ","baginya","lahu",16],["مِنۢ","dari","min",0],["بَعْدِهِۦ ۚ","sesudah itu","baʿdihi",59],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Apa saja di antara rahmat Allah yang dianugerahkan kepada manusia, maka tidak ada yang dapat menahannya; dan apa saja yang ditahan-Nya maka tidak ada yang sanggup untuk melepaskannya setelah itu. Dan Dia lah Yang Mahaperkasa, Mahabijaksana."},{"n":3,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",75],["ٱلنَّاسُ","manusia","l-nāsu",52],["ٱذْكُرُوا۟","ingatlah","udh'kurū",135],["نِعْمَتَ","nikmat","niʿ'mata",240],["ٱللَّهِ","Allah","l-lahi",1],["عَلَيْكُمْ ۚ","atas kalian","ʿalaykum",7],["هَلْ","adakah","hal",119],["مِنْ","dari","min",0],["خَـٰلِقٍ","pencipta","khāliqin",754],["غَيْرُ","selain","ghayru",77],["ٱللَّهِ","Allah","l-lahi",1],["يَرْزُقُكُم","memberi rezki kepadamu","yarzuqukum",198],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["لَآ","tidak","lā",4],["إِلَـٰهَ","Tuhan","ilāha",76],["إِلَّا","kecuali","illā",15],["هُوَ ۖ","Dia","huwa",19],["فَأَنَّىٰ","maka bagaimana/mengapa","fa-annā",391],["تُؤْفَكُونَ","kamu berpaling","tu'fakūna",590]],"t":"Wahai manusia! Ingatlah akan nikmat Allah kepadamu. Adakah pencipta selain Allah yang dapat memberikan rezeki kepadamu dari langit dan bumi? Tidak ada tuhan selain Dia; maka mengapa kamu berpaling (dari ketauhidan)?"},{"n":4,"w":[["وَإِن","dan jika","wa-in",14],["يُكَذِّبُوكَ","mereka mendustakan kamu","yukadhibūka",64],["فَقَدْ","maka sesungguhnya","faqad",24],["كُذِّبَتْ","telah didustakan","kudhibat",64],["رُسُلٌۭ","rasul-rasul","rusulun",35],["مِّن","dari","min",0],["قَبْلِكَ ۚ","sebelum kamu","qablika",51],["وَإِلَى","dan kepada","wa-ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["تُرْجَعُ","dikembalikan","tur'jaʿu",147],["ٱلْأُمُورُ","segala urusan","l-umūru",67]],"t":"Dan jika mereka mendustakan engkau (setelah engkau beri peringatan), maka sungguh, rasul-rasul sebelum engkau telah didustakan pula. Dan hanya kepada Allah segala urusan dikembalikan."},{"n":5,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",75],["ٱلنَّاسُ","manusia","l-nāsu",52],["إِنَّ","sesungguhnya","inna",5],["وَعْدَ","janji","waʿda",248],["ٱللَّهِ","Allah","l-lahi",1],["حَقٌّۭ ۖ","benar","ḥaqqun",50],["فَلَا","maka janganlah","falā",4],["تَغُرَّنَّكُمُ","sekali-kali kamu tertipu","taghurrannakumu",631],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",154],["ٱلدُّنْيَا ۖ","dunia","l-dun'yā",105],["وَلَا","dan tidak/janganlah","walā",4],["يَغُرَّنَّكُم","sekali-kali menipu/memperdayakan kamu","yaghurrannakum",631],["بِٱللَّهِ","dengan/tentang Allah","bil-lahi",1],["ٱلْغَرُورُ","seorang penipu","l-gharūru",1858]],"t":"Wahai manusia! Sungguh, janji Allah itu benar, maka janganlah kehidupan dunia memperdayakan kamu dan janganlah (setan) yang pandai menipu, memperdayakan kamu tentang Allah."},{"n":6,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلشَّيْطَـٰنَ","syaitan","l-shayṭāna",125],["لَكُمْ","bagi kalian","lakum",26],["عَدُوٌّۭ","musuh","ʿaduwwun",238],["فَٱتَّخِذُوهُ","maka jadikanlah ia","fa-ittakhidhūhu",99],["عَدُوًّا ۚ","musuh","ʿaduwwan",238],["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["يَدْعُوا۟","mereka mengajak","yadʿū",66],["حِزْبَهُۥ","golongannya","ḥiz'bahu",512],["لِيَكُونُوا۟","supaya mereka menjadi","liyakūnū",8],["مِنْ","dari","min",0],["أَصْحَـٰبِ","penghuni","aṣḥābi",123],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",608]],"t":"Sungguh, setan itu musuh bagimu, maka perlakukanlah ia sebagai musuh, karena sesungguhnya setan itu hanya mengajak golongannya agar mereka menjadi penghuni neraka yang menyala-nyala."},{"n":7,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌۭ ۖ","sangat/keras","shadīdun",215],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mengerjakan/beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",96],["لَهُم","bagi mereka","lahum",11],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",396],["وَأَجْرٌۭ","dan pahala","wa-ajrun",111],["كَبِيرٌ","besar","kabīrun",292]],"t":"Orang-orang yang kafir, mereka akan mendapat azab yang sangat keras. Dan orang-orang yang beriman dan mengerjakan kebajikan, mereka memperoleh ampunan dan pahala yang besar."},{"n":8,"w":[["أَفَمَن","maka apakah orang","afaman",12],["زُيِّنَ","dijadikan memandang baik","zuyyina",422],["لَهُۥ","baginya","lahu",16],["سُوٓءُ","seburuk-buruk","sūu",241],["عَمَلِهِۦ","pekerjaannya","ʿamalihi",174],["فَرَءَاهُ","lalu dia melihat/menganggapnya","faraāhu",46],["حَسَنًۭا ۖ","baik","ḥasanan",488],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["يُضِلُّ","menyelesaikan","yuḍillu",189],["مَن","dari","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَهْدِى","dan Dia memberi petunjuk","wayahdī",81],["مَن","dari","man",12],["يَشَآءُ ۖ","dia kehendaki","yashāu",54],["فَلَا","maka tidak/janganlah","falā",4],["تَذْهَبْ","kamu menghilangkan/membinasakan","tadhhab",333],["نَفْسُكَ","dirimu","nafsuka",39],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["حَسَرَٰتٍ ۚ","kesedihan","ḥasarātin",965],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",69],["بِمَا","dengan/tentang apa","bimā",2],["يَصْنَعُونَ","mereka perbuat","yaṣnaʿūna",626]],"t":"Maka apakah pantas orang yang dijadikan terasa indah perbuatan buruknya, lalu menganggap baik perbuatannya itu? Sesungguhnya Allah menyesatkan siapa yang Dia kehendaki dan memberi petunjuk kepada siapa yang Dia kehendaki. Maka janganlah engkau (Muhammad) biarkan dirimu binasa karena kesedihan terhadap mereka. Sesungguhnya Allah Maha Mengetahui apa yang mereka perbuat."},{"n":9,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",1],["ٱلَّذِىٓ","yang","alladhī",38],["أَرْسَلَ","mengirimkan","arsala",92],["ٱلرِّيَـٰحَ","angin","l-riyāḥa",387],["فَتُثِيرُ","lalu ia menggerakkan","fatuthīru",1284],["سَحَابًۭا","awan","saḥāban",933],["فَسُقْنَـٰهُ","maka Kami menggiringnya","fasuq'nāhu",1104],["إِلَىٰ","kepada","ilā",13],["بَلَدٍۢ","negeri","baladin",662],["مَّيِّتٍۢ","yang mati","mayyitin",317],["فَأَحْيَيْنَا","lalu Kami menghidupkan","fa-aḥyaynā",232],["بِهِ","dengannya","bihi",16],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",59],["مَوْتِهَا ۚ","matinya","mawtihā",239],["كَذَٰلِكَ","seperti demikian","kadhālika",20],["ٱلنُّشُورُ","kebangkitan itu","l-nushūru",1397]],"t":"Dan Allah lah yang mengirimkan angin; lalu (angin itu) menggerakkan awan, maka Kami arahkan awan itu ke suatu negeri yang mati (tandus) lalu dengan hujan itu Kami hidupkan bumi setelah mati (kering). Seperti itulah kebangkitan."},{"n":10,"w":[["مَن","barang siapa","man",12],["كَانَ","adalah","kāna",8],["يُرِيدُ","menghendaki","yurīdu",84],["ٱلْعِزَّةَ","kemuliaan","l-ʿizata",777],["فَلِلَّهِ","maka bagi Allah","falillahi",1],["ٱلْعِزَّةُ","kemuliaan","l-ʿizatu",777],["جَمِيعًا ۚ","semuanya","jamīʿan",226],["إِلَيْهِ","kepada-Nya","ilayhi",13],["يَصْعَدُ","naik","yaṣʿadu",3228],["ٱلْكَلِمُ","perkataan","l-kalimu",1581],["ٱلطَّيِّبُ","yang baik","l-ṭayibu",258],["وَٱلْعَمَلُ","dan amalan","wal-ʿamalu",174],["ٱلصَّـٰلِحُ","kebajikan/saleh","l-ṣāliḥu",96],["يَرْفَعُهُۥ ۚ","naik kepada-Nya","yarfaʿuhu",476],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["يَمْكُرُونَ","(mereka) membuat tipu-daya","yamkurūna",473],["ٱلسَّيِّـَٔاتِ","kejahatan","l-sayiāti",207],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌۭ ۖ","sangat/keras","shadīdun",215],["وَمَكْرُ","dan tipu-daya","wamakru",532],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["هُوَ","ia","huwa",19],["يَبُورُ","akan hancur","yabūru",2318]],"t":"Barangsiapa menghendaki kemuliaan, maka (ketahuilah) kemuliaan itu semuanya milik Allah. Kepada-Nyalah akan naik perkataan-perkataan yang baik, dan amal kebajikan Dia akan mengangkatnya. Adapun orang-orang yang merencanakan kejahatan mereka akan mendapat azab yang sangat keras, dan rencana jahat mereka akan hancur."},{"n":11,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",1],["خَلَقَكُم","menciptakan kalian","khalaqakum",62],["مِّن","dari","min",0],["تُرَابٍۢ","tanah","turābin",584],["ثُمَّ","kemudian","thumma",34],["مِن","dari","min",0],["نُّطْفَةٍۢ","air mani","nuṭ'fatin",744],["ثُمَّ","kemudian","thumma",34],["جَعَلَكُمْ","Dia menjadikan kamu","jaʿalakum",33],["أَزْوَٰجًۭا ۚ","berpasangan","azwājan",156],["وَمَا","dan tidak","wamā",2],["تَحْمِلُ","mengandung","taḥmilu",289],["مِنْ","dari","min",0],["أُنثَىٰ","seorang perempuan","unthā",438],["وَلَا","dan tidak","walā",4],["تَضَعُ","melahirkan","taḍaʿu",499],["إِلَّا","kecuali","illā",15],["بِعِلْمِهِۦ ۚ","dengan pengetahuan-Nya","biʿil'mihi",112],["وَمَا","dan tidak","wamā",2],["يُعَمَّرُ","dipanjangkan","yuʿammaru",1295],["مِن","dari","min",0],["مُّعَمَّرٍۢ","orang-orang yang berumur panjang","muʿammarin",3955],["وَلَا","dan tidak","walā",4],["يُنقَصُ","dikurangi","yunqaṣu",1095],["مِنْ","dari","min",0],["عُمُرِهِۦٓ","umurnya","ʿumurihi",1051],["إِلَّا","melainkan/kecuali","illā",15],["فِى","dalam","fī",3],["كِتَـٰبٍ ۚ","Kitab","kitābin",49],["إِنَّ","sesungguhnya","inna",5],["ذَٰلِكَ","yang demikian itu","dhālika",20],["عَلَى","atas","ʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["يَسِيرٌۭ","mudah","yasīrun",643]],"t":"Dan Allah menciptakan kamu dari tanah kemudian dari air mani, kemudian Dia menjadikan kamu berpasangan (laki-laki dan perempuan). Tidak ada seorang wanita pun yang mengandung dan melahirkan, melainkan dengan sepengetahuan-Nya. Dan tidak dipanjangkan umur seseorang dan tidak pula dikurangi umurnya, melainkan (sudah ditetapkan) dalam Kitab (Lauḥ Maḥfūẓ). Sungguh, yang demikian itu mudah bagi Allah."},{"n":12,"w":[["وَمَا","dan tidak","wamā",2],["يَسْتَوِى","sama","yastawī",341],["ٱلْبَحْرَانِ","dua laut","l-baḥrāni",290],["هَـٰذَا","ini","hādhā",56],["عَذْبٌۭ","tawar","ʿadhbun",2208],["فُرَاتٌۭ","segar","furātun",1850],["سَآئِغٌۭ","lezat/sedap","sāighun",2631],["شَرَابُهُۥ","diminumnya","sharābuhu",759],["وَهَـٰذَا","dan ini","wahādhā",56],["مِلْحٌ","asin","mil'ḥun",2486],["أُجَاجٌۭ ۖ","sangat asin/pahit","ujājun",1764],["وَمِن","dan dari","wamin",0],["كُلٍّۢ","masing-masing","kullin",31],["تَأْكُلُونَ","kamu memakan","takulūna",118],["لَحْمًۭا","daging","laḥman",739],["طَرِيًّۭا","lembut/yang baru","ṭariyyan",2305],["وَتَسْتَخْرِجُونَ","dan kamu mengeluarkan","watastakhrijūna",1706],["حِلْيَةًۭ","perhiasan","ḥil'yatan",1307],["تَلْبَسُونَهَا ۖ","kamu memakainya","talbasūnahā",789],["وَتَرَى","dan kamu melihat","watarā",46],["ٱلْفُلْكَ","perahu","l-ful'ka",456],["فِيهِ","di dalamnya","fīhi",3],["مَوَاخِرَ","membelah laut","mawākhira",2447],["لِتَبْتَغُوا۟","supaya kamu mencari","litabtaghū",347],["مِن","dari","min",0],["فَضْلِهِۦ","karunia-Nya","faḍlihi",136],["وَلَعَلَّكُمْ","dan supaya kamu","walaʿallakum",93],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",257]],"t":"Dan tidak sama (antara) dua lautan; yang ini tawar, segar, sedap diminum dan yang lain asin lagi pahit. Dan dari (masing-masing lautan) itu kamu dapat memakan daging yang segar dan kamu dapat mengeluarkan perhiasan yang kamu pakai, dan di sana kamu melihat kapal-kapal berlayar membelah laut agar kamu dapat mencari karunia-Nya dan agar kamu bersyukur."},{"n":13,"w":[["يُولِجُ","Dia memasukkan","yūliju",820],["ٱلَّيْلَ","malam","al-layla",137],["فِى","dalam","fī",3],["ٱلنَّهَارِ","siang","l-nahāri",211],["وَيُولِجُ","dan Dia memasukkan","wayūliju",820],["ٱلنَّهَارَ","siang","l-nahāra",211],["فِى","dalam","fī",3],["ٱلَّيْلِ","malam","al-layli",137],["وَسَخَّرَ","dan Dia menundukkan","wasakhara",480],["ٱلشَّمْسَ","matahari","l-shamsa",348],["وَٱلْقَمَرَ","dan bulan","wal-qamara",409],["كُلٌّۭ","masing-masing","kullun",31],["يَجْرِى","berjalan/beredar","yajrī",209],["لِأَجَلٍۢ","menurut waktu","li-ajalin",228],["مُّسَمًّۭى ۚ","ditentukan","musamman",496],["ذَٰلِكُمُ","demikian itu","dhālikumu",20],["ٱللَّهُ","Allah","l-lahu",1],["رَبُّكُمْ","Tuhan kalian","rabbukum",10],["لَهُ","bagi-Nya/kepunyaan-Nya","lahu",16],["ٱلْمُلْكُ ۚ","kerajaan","l-mul'ku",252],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["تَدْعُونَ","kamu seru","tadʿūna",66],["مِن","dari","min",0],["دُونِهِۦ","selain Dia","dūnihi",80],["مَا","tidak","mā",2],["يَمْلِكُونَ","mereka memiliki","yamlikūna",272],["مِن","dari","min",0],["قِطْمِيرٍ","kulit tipis/kulit ari","qiṭ'mīrin",4127]],"t":"Dia memasukkan malam ke dalam siang dan memasukkan siang ke dalam malam dan menundukkan matahari dan bulan, masing-masing beredar menurut waktu yang ditentukan. Yang (berbuat) demikian itulah Allah Tuhanmu, milik-Nyalah segala kerajaan. Dan orang-orang yang kamu seru (sembah) selain Allah tidak mempunyai apa-apa walaupun setipis kulit ari."},{"n":14,"w":[["إِن","jika","in",14],["تَدْعُوهُمْ","kamu menyeru mereka","tadʿūhum",66],["لَا","tidak","lā",4],["يَسْمَعُوا۟","mereka mendengar","yasmaʿū",149],["دُعَآءَكُمْ","seruanmu","duʿāakum",468],["وَلَوْ","dan kalau","walaw",58],["سَمِعُوا۟","mereka mendengar","samiʿū",149],["مَا","tidak","mā",2],["ٱسْتَجَابُوا۟","mereka dapat memperkenankan","is'tajābū",399],["لَكُمْ ۖ","bagi kalian","lakum",26],["وَيَوْمَ","dan pada hari","wayawma",25],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",178],["يَكْفُرُونَ","mereka mengingkari","yakfurūna",40],["بِشِرْكِكُمْ ۚ","dengan kemusyrikan","bishir'kikum",1267],["وَلَا","dan tidak","walā",4],["يُنَبِّئُكَ","yang menjelaskan kepadamu","yunabbi-uka",260],["مِثْلُ","seperti/sebagaimana","mith'lu",158],["خَبِيرٍۢ","Yang Maha Mengetahui","khabīrin",267]],"t":"Jika kamu menyeru mereka, mereka tidak mendengar seruanmu, dan sekiranya mereka mendengar, mereka juga tidak memperkenankan permintaanmu. Dan pada hari Kiamat mereka akan mengingkari kemusyrikanmu dan tidak ada yang dapat memberikan keterangan kepadamu seperti yang diberikan oleh (Allah) Yang Mahateliti."},{"n":15,"w":[["۞ يَـٰٓأَيُّهَا","wahai","yāayyuhā",75],["ٱلنَّاسُ","manusia","l-nāsu",52],["أَنتُمُ","kamu","antumu",88],["ٱلْفُقَرَآءُ","berkeperluan/berkehendak","l-fuqarāu",735],["إِلَى","kepada","ilā",13],["ٱللَّهِ ۖ","Allah","l-lahi",1],["وَٱللَّهُ","dan Allah","wal-lahu",1],["هُوَ","Dia","huwa",19],["ٱلْغَنِىُّ","Maha Kaya","l-ghaniyu",443],["ٱلْحَمِيدُ","Maha Terpuji","l-ḥamīdu",568]],"t":"Wahai manusia! Kamulah yang memerlukan Allah; dan Allah Dialah Yang Mahakaya (tidak memerlukan apa pun), Maha Terpuji."},{"n":16,"w":[["إِن","jika","in",14],["يَشَأْ","Dia menghendaki","yasha",54],["يُذْهِبْكُمْ","Dia melenyapkan kamu","yudh'hib'kum",764],["وَيَأْتِ","dan Dia mendatangkan","wayati",48],["بِخَلْقٍۢ","dengan makhluk","bikhalqin",231],["جَدِيدٍۢ","baru","jadīdin",982]],"t":"Jika Dia menghendaki, niscaya Dia membinasakan kamu dan mendatangkan makhluk yang baru (untuk menggantikan kamu)."},{"n":17,"w":[["وَمَا","dan tidaklah","wamā",2],["ذَٰلِكَ","yang demikian itu","dhālika",20],["عَلَى","atas/bagi","ʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["بِعَزِيزٍۢ","dengan payah/sulit","biʿazīzin",114]],"t":"Dan yang demikian itu tidak sulit bagi Allah."},{"n":18,"w":[["وَلَا","dan tidak","walā",4],["تَزِرُ","memikul beban","taziru",1116],["وَازِرَةٌۭ","orang yang memikul beban (berdosa)","wāziratun",1427],["وِزْرَ","beban (dosa)","wiz'ra",753],["أُخْرَىٰ ۚ","orang lain","ukh'rā",177],["وَإِن","dan jika","wa-in",14],["تَدْعُ","memanggil","tadʿu",66],["مُثْقَلَةٌ","orang yang berat","muth'qalatun",3891],["إِلَىٰ","untuk","ilā",13],["حِمْلِهَا","memikulnya","ḥim'lihā",1806],["لَا","tidak","lā",4],["يُحْمَلْ","dipikul","yuḥ'mal",289],["مِنْهُ","dari padanya","min'hu",0],["شَىْءٌۭ","sesuatu/sedikitpun","shayon",41],["وَلَوْ","walaupun","walaw",58],["كَانَ","ia adalah","kāna",8],["ذَا","memiliki","dhā",448],["قُرْبَىٰٓ ۗ","kerabat","qur'bā",606],["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["تُنذِرُ","kamu beri peringatan","tundhiru",269],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["يَخْشَوْنَ","(mereka) takut","yakhshawna",302],["رَبَّهُم","Tuhan","rabbahum",10],["بِٱلْغَيْبِ","dengan yang gaib/tidak kelihatan","bil-ghaybi",244],["وَأَقَامُوا۟","dan mereka mendirikan","wa-aqāmū",222],["ٱلصَّلَوٰةَ ۚ","sholat","l-ṣalata",138],["وَمَن","dan barang siapa","waman",12],["تَزَكَّىٰ","mensucikan","tazakkā",1008],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",5],["يَتَزَكَّىٰ","ia mensucikan","yatazakkā",1008],["لِنَفْسِهِۦ ۚ","untuk diri sendiri","linafsihi",39],["وَإِلَى","dan kepada","wa-ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",394]],"t":"Dan orang yang berdosa tidak akan memikul dosa orang lain. Dan jika seseorang yang dibebani berat dosanya memanggil (orang lain) untuk memikul bebannya itu tidak akan dipikulkan sedikit pun, meskipun (yang dipanggilnya itu) kaum kerabatnya. Sesunggunya yang dapat engkau beri peringatan hanya orang-orang yang takut kepada (azab) Tuhannya (sekalipun) mereka tidak melihat-Nya dan mereka yang melaksanakan salat. Barangsiapa yang menyucikan dirinya, sesungguhnya dia menyucikan diri untuk kebaikan dirinya sendiri. Dan kepada Allah lah tempat kembali."},{"n":19,"w":[["وَمَا","dan tidak","wamā",2],["يَسْتَوِى","sama","yastawī",341],["ٱلْأَعْمَىٰ","orang yang buta","l-aʿmā",485],["وَٱلْبَصِيرُ","dan orang yang melihat","wal-baṣīru",234]],"t":"Dan tidaklah sama orang yang buta dengan orang yang melihat,"},{"n":20,"w":[["وَلَا","dan tidak","walā",4],["ٱلظُّلُمَـٰتُ","yang gelap","l-ẓulumātu",453],["وَلَا","dan tidak","walā",4],["ٱلنُّورُ","yang terang","l-nūru",278]],"t":"dan tidak (pula) sama gelap gulita dengan cahaya,"},{"n":21,"w":[["وَلَا","dan tidak","walā",4],["ٱلظِّلُّ","yang teduh","l-ẓilu",661],["وَلَا","dan tidak","walā",4],["ٱلْحَرُورُ","yang panas","l-ḥarūru",3186]],"t":"dan tidak (pula) sama yang teduh dengan yang panas,"},{"n":22,"w":[["وَمَا","dan tidak","wamā",2],["يَسْتَوِى","sama","yastawī",341],["ٱلْأَحْيَآءُ","orang-orang yang hidup","l-aḥyāu",440],["وَلَا","dan tidak","walā",4],["ٱلْأَمْوَٰتُ ۚ","orang-orang yang mati","l-amwātu",317],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["يُسْمِعُ","menjadikan mendengar","yus'miʿu",680],["مَن","orang/siapa","man",12],["يَشَآءُ ۖ","Dia kehendaki","yashāu",54],["وَمَآ","dan tidaklah","wamā",2],["أَنتَ","kamu","anta",145],["بِمُسْمِعٍۢ","dengan menjadikan mendengar","bimus'miʿin",3860],["مَّن","orang/siapa","man",12],["فِى","dalam","fī",3],["ٱلْقُبُورِ","kubur","l-qubūri",1221]],"t":"dan tidak (pula) sama orang yang hidup dengan orang yang mati. Sungguh, Allah memberikan pendengaran kepada siapa yang Dia kehendaki dan engkau (Muhammad) tidak akan sanggup menjadikan orang yang di dalam kubur dapat mendengar."},{"n":23,"w":[["إِنْ","tidak lain","in",14],["أَنتَ","kamu","anta",145],["إِلَّا","kecuali/hanyalah","illā",15],["نَذِيرٌ","seorang pemberi peringatan","nadhīrun",206]],"t":"Engkau tidak lain hanyalah seorang pemberi peringatan."},{"n":24,"w":[["إِنَّآ","sesunguhnya Kami","innā",5],["أَرْسَلْنَـٰكَ","mengutus kamu","arsalnāka",92],["بِٱلْحَقِّ","dengan hak/kebenaran","bil-ḥaqi",50],["بَشِيرًۭا","pembawa berita gembira","bashīran",902],["وَنَذِيرًۭا ۚ","dan pemberi peringatan","wanadhīran",206],["وَإِن","dan tidak ada","wa-in",14],["مِّنْ","dari","min",0],["أُمَّةٍ","umat","ummatin",192],["إِلَّا","kecuali","illā",15],["خَلَا","telah lewat (ada)","khalā",435],["فِيهَا","di dalamnya/padanya","fīhā",3],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206]],"t":"Sungguh, Kami mengutus engkau dengan membawa kebenaran sebagai pembawa berita gembira dan sebagai pemberi peringatan. Dan tidak ada satu pun umat melainkan di sana telah datang seorang pemberi peringatan."},{"n":25,"w":[["وَإِن","dan jika","wa-in",14],["يُكَذِّبُوكَ","mereka mendustakan kamu","yukadhibūka",64],["فَقَدْ","maka sesungguhnya","faqad",24],["كَذَّبَ","telah mendustakan","kadhaba",64],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["جَآءَتْهُمْ","datang kepada mereka","jāathum",43],["رُسُلُهُم","Rasul-Rasul mereka","rusuluhum",35],["بِٱلْبَيِّنَـٰتِ","dengan penjelasan-penjelasan","bil-bayināti",175],["وَبِٱلزُّبُرِ","dan dengan zubur","wabil-zuburi",870],["وَبِٱلْكِتَـٰبِ","dan dengan kitab","wabil-kitābi",49],["ٱلْمُنِيرِ","bercahaya/terang","l-munīri",1213]],"t":"Dan jika mereka mendustakanmu, maka sungguh, orang-orang yang sebelum mereka pun telah mendustakan (rasul-rasul); ketika rasul-rasulnya datang dengan membawa keterangan yang nyata (mukjizat), zubur, dan kitab yang memberi penjelasan yang sempurna."},{"n":26,"w":[["ثُمَّ","kemudian","thumma",34],["أَخَذْتُ","Aku ambil/azab","akhadhtu",95],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟ ۖ","kafir/ingkar","kafarū",40],["فَكَيْفَ","maka bagaimana","fakayfa",139],["كَانَ","adalah","kāna",8],["نَكِيرِ","kemurkaan-Ku/hukuman-Ku","nakīri",1395]],"t":"Kemudian Aku azab orang-orang yang kafir; maka (lihatlah) bagaimana akibat kemurkaan-Ku."},{"n":27,"w":[["أَلَمْ","tidakkah","alam",32],["تَرَ","kamu melihat","tara",46],["أَنَّ","bahwasannya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["أَنزَلَ","menurunkan","anzala",63],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["مَآءًۭ","air (hujan)","māan",194],["فَأَخْرَجْنَا","lalu Kami keluarkan","fa-akhrajnā",115],["بِهِۦ","dengannya","bihi",16],["ثَمَرَٰتٍۢ","buah-buahan","thamarātin",585],["مُّخْتَلِفًا","bermacam-macam","mukh'talifan",855],["أَلْوَٰنُهَا ۚ","warnanya","alwānuhā",916],["وَمِنَ","dan dari","wamina",0],["ٱلْجِبَالِ","gunung-gunung","l-jibāli",310],["جُدَدٌۢ","garis-garis","judadun",3575],["بِيضٌۭ","putih","bīḍun",879],["وَحُمْرٌۭ","dan merah","waḥum'run",1159],["مُّخْتَلِفٌ","bermacam-macam","mukh'talifun",855],["أَلْوَٰنُهَا","warnanya","alwānuhā",916],["وَغَرَابِيبُ","dan pekat","wagharābību",3496],["سُودٌۭ","hitam","sūdun",2179]],"t":"Tidakkah engkau melihat bahwa Allah menurunkan air dari langit lalu dengan air itu Kami hasilkan buah-buahan yang beraneka macam jenisnya. Dan di antara gunung-gunung itu ada garis-garis putih dan merah yang beraneka macam warnanya dan ada (pula) yang hitam pekat."},{"n":28,"w":[["وَمِنَ","dan diantara","wamina",0],["ٱلنَّاسِ","manusia","l-nāsi",52],["وَٱلدَّوَآبِّ","dan binatang melata","wal-dawābi",549],["وَٱلْأَنْعَـٰمِ","dan binatang ternak","wal-anʿāmi",353],["مُخْتَلِفٌ","bermacam-macam","mukh'talifun",855],["أَلْوَٰنُهُۥ","warnanya","alwānuhu",916],["كَذَٰلِكَ ۗ","demikian itu","kadhālika",20],["إِنَّمَا","sesunguhnya hanyalah","innamā",5],["يَخْشَى","takut","yakhshā",302],["ٱللَّهَ","Allah","l-laha",1],["مِنْ","dari/diantara","min",0],["عِبَادِهِ","hamba-hamba-Nya","ʿibādihi",91],["ٱلْعُلَمَـٰٓؤُا۟ ۗ","para 'ulama","l-ʿulamāu",69],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["عَزِيزٌ","Maha Perkasa","ʿazīzun",114],["غَفُورٌ","Maha Pengampun","ghafūrun",122]],"t":"Dan demikian (pula) di antara manusia, makhluk bergerak yang bernyawa dan hewan-hewan ternak ada yang bermacam-macam warnanya (dan jenisnya). Di antara hamba-hamba Allah yang takut kepada-Nya, hanyalah para ulama. Sungguh, Allah Mahaperkasa, Maha Pengampun."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["يَتْلُونَ","(mereka) membaca","yatlūna",199],["كِتَـٰبَ","kitab","kitāba",49],["ٱللَّهِ","Allah","l-lahi",1],["وَأَقَامُوا۟","dan mereka mendirikan","wa-aqāmū",222],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",138],["وَأَنفَقُوا۟","dan mereka menafkahkan","wa-anfaqū",183],["مِمَّا","sebagian apa","mimmā",0],["رَزَقْنَـٰهُمْ","telah Kami beri rezeki mereka","razaqnāhum",198],["سِرًّۭا","sembunyi-sembunyi","sirran",805],["وَعَلَانِيَةًۭ","terang-terangan","waʿalāniyatan",1502],["يَرْجُونَ","mereka mengharapkan","yarjūna",477],["تِجَـٰرَةًۭ","perdagangan","tijāratan",941],["لَّن","tidak akan","lan",113],["تَبُورَ","merugi","tabūra",2318]],"t":"Sesungguhnya orang-orang yang selalu membaca Kitab Allah (Alquran) dan melak­sana­kan salat dan menginfakkan sebagian rezeki yang Kami anugerahkan kepadanya dengan diam-diam dan terang-terangan, mereka itu mengharapkan perdagangan yang tidak akan rugi,"},{"n":30,"w":[["لِيُوَفِّيَهُمْ","karena Dia akan mencukupkan mereka","liyuwaffiyahum",561],["أُجُورَهُمْ","pahala mereka","ujūrahum",111],["وَيَزِيدَهُم","dan Dia akan menambah mereka","wayazīdahum",249],["مِّن","dari","min",0],["فَضْلِهِۦٓ ۚ","karunia-Nya","faḍlihi",136],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["غَفُورٌۭ","Maha Pengampun","ghafūrun",122],["شَكُورٌۭ","Maha Mensyukuri","shakūrun",813]],"t":"agar Allah menyempurnakan pahalanya kepada mereka dan menambah karunia-Nya. Sungguh, Allah Maha Pengampun, Maha Mensyukuri."},{"n":31,"w":[["وَٱلَّذِىٓ","dan apa yang","wa-alladhī",38],["أَوْحَيْنَآ","Kami wahyukan","awḥaynā",169],["إِلَيْكَ","kepadamu","ilayka",13],["مِنَ","dari","mina",0],["ٱلْكِتَـٰبِ","Kitab","l-kitābi",49],["هُوَ","dia","huwa",19],["ٱلْحَقُّ","adalah benar","l-ḥaqu",50],["مُصَدِّقًۭا","membenarkan","muṣaddiqan",533],["لِّمَا","terhadap","limā",2],["بَيْنَ","antara","bayna",47],["يَدَيْهِ ۗ","yang dihadapannya/sebelumnya","yadayhi",102],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["بِعِبَادِهِۦ","kepada hamba-hamba-Nya","biʿibādihi",91],["لَخَبِيرٌۢ","benar-benar Maha Mengetahui","lakhabīrun",267],["بَصِيرٌۭ","Maha Melihat","baṣīrun",234]],"t":"Dan apa yang telah Kami wahyukan kepadamu (Muhammad) yaitu Kitab (Alquran) itulah yang benar, membenarkan kitab-kitab yang sebelumnya. Sungguh, Allah benar-benar Maha Mengetahui, Maha Melihat (keadaan) hamba-hamba-Nya."},{"n":32,"w":[["ثُمَّ","kemudian","thumma",34],["أَوْرَثْنَا","Kami wariskan","awrathnā",718],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",49],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ٱصْطَفَيْنَا","Kami pilih","iṣ'ṭafaynā",757],["مِنْ","dari","min",0],["عِبَادِنَا ۖ","hamba-hamba Kami","ʿibādinā",91],["فَمِنْهُمْ","maka diantara mereka","famin'hum",0],["ظَالِمٌۭ","zalim/aniaya","ẓālimun",89],["لِّنَفْسِهِۦ","pada dirinya sendiri","linafsihi",39],["وَمِنْهُم","dan diantara mereka","wamin'hum",0],["مُّقْتَصِدٌۭ","pertengahan","muq'taṣidun",1950],["وَمِنْهُمْ","dan diantara mereka","wamin'hum",0],["سَابِقٌۢ","mendahului","sābiqun",1005],["بِٱلْخَيْرَٰتِ","dengan berbuat kebaikan","bil-khayrāti",61],["بِإِذْنِ","dengan izin","bi-idh'ni",306],["ٱللَّهِ ۚ","Allah","l-lahi",1],["ذَٰلِكَ","demikian itu","dhālika",20],["هُوَ","dia/adalah","huwa",19],["ٱلْفَضْلُ","karunia","l-faḍlu",136],["ٱلْكَبِيرُ","yang besar","l-kabīru",292]],"t":"Kemudian Kitab itu Kami wariskan kepada orang-orang yang Kami pilih di antara hamba-hamba Kami, lalu di antara mereka ada yang menzalimi diri sendiri, ada yang pertengahan dan ada (pula) yang berlomba dalam berbuat kebaikan dengan izin Allah. Yang demikian itu adalah karunia yang besar."},{"n":33,"w":[["جَنَّـٰتُ","sorga","jannātu",78],["عَدْنٍۢ","'Adn","ʿadnin",771],["يَدْخُلُونَهَا","mereka masuk ke dalamnya","yadkhulūnahā",155],["يُحَلَّوْنَ","mereka diberi perhiasan","yuḥallawna",1519],["فِيهَا","di dalamnya","fīhā",3],["مِنْ","dari","min",0],["أَسَاوِرَ","gelang-gelang","asāwira",1415],["مِن","dari","min",0],["ذَهَبٍۢ","emas","dhahabin",952],["وَلُؤْلُؤًۭا ۖ","dan mutiara","walu'lu-an",1198],["وَلِبَاسُهُمْ","dan pakaian mereka","walibāsuhum",844],["فِيهَا","di dalamnya","fīhā",3],["حَرِيرٌۭ","sutera","ḥarīrun",1798]],"t":"(Mereka akan mendapat) surga 'Adn, mereka masuk ke dalamnya, di dalamnya mereka diberi perhiasan gelang-gelang dari emas dan mutiara, dan pakaian mereka di dalamnya adalah sutera."},{"n":34,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["ٱلْحَمْدُ","segala puji","l-ḥamdu",276],["لِلَّهِ","bagi Allah","lillahi",1],["ٱلَّذِىٓ","yang","alladhī",38],["أَذْهَبَ","telah menghilangkan","adhhaba",764],["عَنَّا","dari kami","ʿannā",21],["ٱلْحَزَنَ ۖ","duka-cita","l-ḥazana",1803],["إِنَّ","sesungguhnya","inna",5],["رَبَّنَا","Tuhan kami","rabbanā",10],["لَغَفُورٌۭ","benar-benar Maha Pengampun","laghafūrun",122],["شَكُورٌ","Maha Mensyukuri","shakūrun",813]],"t":"Dan mereka berkata, \"Segala puji bagi Allah yang telah menghilangkan kesedihan dari kami. Sungguh, Tuhan kami benar-benar Maha Pengampun, Maha Mensyukuri,"},{"n":35,"w":[["ٱلَّذِىٓ","yang","alladhī",38],["أَحَلَّنَا","menempatkan kami","aḥallanā",503],["دَارَ","rumah/tempat","dāra",251],["ٱلْمُقَامَةِ","yang kekal","l-muqāmati",1607],["مِن","dari","min",0],["فَضْلِهِۦ","karunia-Nya","faḍlihi",136],["لَا","tidak","lā",4],["يَمَسُّنَا","kami tersentuh/merasa","yamassunā",217],["فِيهَا","di dalamnya","fīhā",3],["نَصَبٌۭ","penat/lelah","naṣabun",1628],["وَلَا","dan tidak","walā",4],["يَمَسُّنَا","kami tersentuh/merasa","yamassunā",217],["فِيهَا","di dalamnya","fīhā",3],["لُغُوبٌۭ","letih/lesu","lughūbun",2443]],"t":"yang dengan karunia-Nya menempatkan kami dalam tempat yang kekal (surga); di dalamnya kami tidak merasa lelah dan tidak pula merasa lesu.\""},{"n":36,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَهُمْ","bagi mereka","lahum",11],["نَارُ","api/neraka","nāru",79],["جَهَنَّمَ","Jahannam","jahannama",152],["لَا","tidak","lā",4],["يُقْضَىٰ","diputuskan","yuq'ḍā",204],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["فَيَمُوتُوا۟","lalu mereka mati","fayamūtū",312],["وَلَا","dan tidak","walā",4],["يُخَفَّفُ","diringankan","yukhaffafu",1013],["عَنْهُم","dari mereka","ʿanhum",21],["مِّنْ","dari","min",0],["عَذَابِهَا ۚ","azabnya","ʿadhābihā",36],["كَذَٰلِكَ","demikianlah","kadhālika",20],["نَجْزِى","Kami memberi balasan","najzī",165],["كُلَّ","setiap","kulla",31],["كَفُورٍۢ","orang yang sangat kafir","kafūrin",738]],"t":"Dan orang-orang yang kafir, bagi mereka neraka Jahanam. Mereka tidak dibinasakan hingga mereka mati, dan tidak diringankan dari mereka azabnya. Demikianlah Kami membalas setiap orang yang sangat kafir."},{"n":37,"w":[["وَهُمْ","dan mereka","wahum",11],["يَصْطَرِخُونَ","mereka berteriak","yaṣṭarikhūna",4609],["فِيهَا","di dalamnya","fīhā",3],["رَبَّنَآ","ya Tuhan kami","rabbanā",10],["أَخْرِجْنَا","keluarkanlah kami","akhrij'nā",115],["نَعْمَلْ","Kami akan mengerjakan","naʿmal",44],["صَـٰلِحًا","kebajikan/amal saleh","ṣāliḥan",96],["غَيْرَ","bukan","ghayra",77],["ٱلَّذِى","yang","alladhī",38],["كُنَّا","adalah kami","kunnā",8],["نَعْمَلُ ۚ","kami kerjakan","naʿmalu",44],["أَوَلَمْ","ataukah tidak","awalam",32],["نُعَمِّرْكُم","Kami beri umur panjang padamu","nuʿammir'kum",1295],["مَّا","apa","mā",2],["يَتَذَكَّرُ","untuk mengingat/berfikir","yatadhakkaru",235],["فِيهِ","di dalamnya","fīhi",3],["مَن","orang/siapa","man",12],["تَذَكَّرَ","mengingat/berfikir","tadhakkara",235],["وَجَآءَكُمُ","dan datang kepadamu","wajāakumu",43],["ٱلنَّذِيرُ ۖ","seorang pemberi peringatan","l-nadhīru",206],["فَذُوقُوا۟","maka rasakanlah","fadhūqū",329],["فَمَا","maka tidaklah","famā",2],["لِلظَّـٰلِمِينَ","bagi orang-orang zalim","lilẓẓālimīna",89],["مِن","dari","min",0],["نَّصِيرٍ","seorang penolong","naṣīrin",338]],"t":"Dan mereka berteriak di dalam neraka, \"Ya Tuhan kami, keluarkanlah kami (dari neraka), niscaya kami akan mengerjakan kebajikan, yang berlainan dengan yang telah kami kerjakan dahulu.\" (Dikatakan kepada mereka), \"Bukankah Kami telah memanjangkan umurmu untuk dapat berpikir bagi orang yang mau berpikir, padahal telah datang kepadamu seorang pemberi peringatan? Maka rasakanlah (azab Kami), dan bagi orang-orang zalim tidak ada seorang penolong pun.\""},{"n":38,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["عَـٰلِمُ","mengetahui","ʿālimu",548],["غَيْبِ","kegaiban","ghaybi",244],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",69],["بِذَاتِ","dengan yang ada","bidhāti",117],["ٱلصُّدُورِ","dalam dada/hati","l-ṣudūri",271]],"t":"Sungguh, Allah mengetahui yang gaib (tersembunyi) di langit dan di bumi. Sungguh, Dia Maha Mengetahui segala isi hati."},{"n":39,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِى","yang","alladhī",38],["جَعَلَكُمْ","menjadikan kamu","jaʿalakum",33],["خَلَـٰٓئِفَ","khalifah","khalāifa",945],["فِى","pada","fī",3],["ٱلْأَرْضِ ۚ","bumi","l-arḍi",22],["فَمَن","maka barangsiapa","faman",12],["كَفَرَ","kafir","kafara",40],["فَعَلَيْهِ","maka atasnya/menimpa","faʿalayhi",7],["كُفْرُهُۥ ۖ","kekafirannya","kuf'ruhu",325],["وَلَا","dan tidak","walā",4],["يَزِيدُ","menambah","yazīdu",249],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",71],["كُفْرُهُمْ","kekafiran mereka","kuf'ruhum",325],["عِندَ","disisi","ʿinda",60],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["إِلَّا","kecuali","illā",15],["مَقْتًۭا ۖ","kemurkaan","maqtan",1201],["وَلَا","dan tidak","walā",4],["يَزِيدُ","menambah","yazīdu",249],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",71],["كُفْرُهُمْ","kekafiran mereka","kuf'ruhum",325],["إِلَّا","kecuali","illā",15],["خَسَارًۭا","kerugian","khasāran",2064]],"t":"Dialah yang menjadikan kamu sebagai khalifah-khalifah di bumi. Barangsiapa kafir, maka (akibat) kekafirannya akan menimpa dirinya sendiri. Dan kekafiran orang-orang kafir itu hanya akan menambah kemurkaan di sisi Tuhan mereka. Dan kekafiran orang-orang kafir itu hanya akan menambah kerugian mereka belaka."},{"n":40,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","apakah kamu memperhatikan","ara-aytum",46],["شُرَكَآءَكُمُ","sekutu-sekutumu","shurakāakumu",294],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["تَدْعُونَ","kamu seru","tadʿūna",66],["مِن","dari","min",0],["دُونِ","selain","dūni",80],["ٱللَّهِ","Allah","l-lahi",1],["أَرُونِى","perlihatkanlah kepadaku","arūnī",295],["مَاذَا","apa yang","mādhā",418],["خَلَقُوا۟","mereka ciptakan","khalaqū",62],["مِنَ","dari","mina",0],["ٱلْأَرْضِ","bumi","l-arḍi",22],["أَمْ","atau","am",85],["لَهُمْ","bagi mereka","lahum",11],["شِرْكٌۭ","sekutu/saham","shir'kun",1267],["فِى","di/pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["أَمْ","atau","am",85],["ءَاتَيْنَـٰهُمْ","Kami berikan kepada mereka","ātaynāhum",45],["كِتَـٰبًۭا","kitab","kitāban",49],["فَهُمْ","lalu mereka","fahum",11],["عَلَىٰ","atas","ʿalā",7],["بَيِّنَتٍۢ","keterangan-keterangan","bayyinatin",175],["مِّنْهُ ۚ","dari padanya","min'hu",0],["بَلْ","bahkan/tetapi","bal",97],["إِن","tidak","in",14],["يَعِدُ","menjanjikan","yaʿidu",180],["ٱلظَّـٰلِمُونَ","orang-orang yang zalim","l-ẓālimūna",89],["بَعْضُهُم","sebagian mereka","baʿḍuhum",72],["بَعْضًا","sebagian","baʿḍan",72],["إِلَّا","kecuali","illā",15],["غُرُورًا","tipuan","ghurūran",910]],"t":"Katakanlah, \"Terangkanlah olehmu tentang sekutu-sekutumu yang kamu seru selain Allah.\" Perlihatkanlah kepada-Ku (bagian) manakah dari bumi ini yang telah mereka ciptakan; ataukah mereka mempunyai peran serta dalam (penciptaan) langit; atau adakah Kami memberikan kitab kepada mereka sehingga mereka mendapat keterangan-keterangan yang jelas darinya? Sebenarnya orang-orang zalim itu, sebagian mereka hanya menjanjikan tipuan belaka kepada sebagian yang lain."},{"n":41,"w":[["۞ إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["يُمْسِكُ","(Dia) menahan","yum'siku",543],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["أَن","bahwa","an",17],["تَزُولَا ۚ","tidak lenyap","tazūlā",811],["وَلَئِن","dan jika","wala-in",14],["زَالَتَآ","keduanya lenyap","zālatā",811],["إِنْ","jika","in",14],["أَمْسَكَهُمَا","menahan keduanya","amsakahumā",543],["مِنْ","dari","min",0],["أَحَدٍۢ","seseorang","aḥadin",160],["مِّنۢ","dari","min",0],["بَعْدِهِۦٓ ۚ","sesudah-Nya/selain Dia","baʿdihi",59],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["كَانَ","adalah","kāna",8],["حَلِيمًا","Maha Penyantun","ḥalīman",622],["غَفُورًۭا","Maha Pengampun","ghafūran",122]],"t":"Sungguh, Allah yang menahan langit dan bumi agar tidak lenyap; dan jika keduanya akan lenyap tidak ada seorang pun yang mampu menahannya selain Allah. Sungguh, Dia Maha Penyantun, Maha Pengampun."},{"n":42,"w":[["وَأَقْسَمُوا۟","dan mereka bersumpah","wa-aqsamū",506],["بِٱللَّهِ","dengan Allah","bil-lahi",1],["جَهْدَ","sungguh-sungguh","jahda",1355],["أَيْمَـٰنِهِمْ","sumpah mereka","aymānihim",188],["لَئِن","bahwa jika","la-in",14],["جَآءَهُمْ","datang kepada mereka","jāahum",43],["نَذِيرٌۭ","pemberi peringatan","nadhīrun",206],["لَّيَكُونُنَّ","niscaya mereka adalah","layakūnunna",8],["أَهْدَىٰ","lebih mendapat petunjuk","ahdā",1037],["مِنْ","dari","min",0],["إِحْدَى","salah satu","iḥ'dā",762],["ٱلْأُمَمِ ۖ","ummat-ummat","l-umami",192],["فَلَمَّا","maka tatkala","falammā",73],["جَآءَهُمْ","datang kepada mereka","jāahum",43],["نَذِيرٌۭ","pemberi peringatan","nadhīrun",206],["مَّا","tidak","mā",2],["زَادَهُمْ","menambah mereka","zādahum",249],["إِلَّا","kecuali","illā",15],["نُفُورًا","lari","nufūran",1398]],"t":"Dan mereka bersumpah atas nama Allah dengan sungguh-sungguh bahwa jika datang kepada mereka seorang pemberi peringatan, niscaya mereka akan lebih mendapat petunjuk daripada umat-umat (yang lain). Tetapi ketika pemberi peringatan datang kepada mereka, tidak menambah (apa-apa) kepada mereka, bahkan semakin jauh mereka dari (kebenaran),"},{"n":43,"w":[["ٱسْتِكْبَارًۭا","karena kesombongan","is'tik'bāran",2809],["فِى","pada/di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَمَكْرَ","dan rencana","wamakra",532],["ٱلسَّيِّئِ ۚ","jelek/jahat","l-sayi-i",1659],["وَلَا","dan tidak","walā",4],["يَحِيقُ","menimpa","yaḥīqu",825],["ٱلْمَكْرُ","rencana","l-makru",532],["ٱلسَّيِّئُ","jelek/jahat","l-sayi-u",1659],["إِلَّا","kecuali","illā",15],["بِأَهْلِهِۦ ۚ","kepada ahlinya/yang empunya","bi-ahlihi",94],["فَهَلْ","maka tidakkah","fahal",119],["يَنظُرُونَ","mereka menanti-nanti","yanẓurūna",130],["إِلَّا","kecuali","illā",15],["سُنَّتَ","sunnah","sunnata",609],["ٱلْأَوَّلِينَ ۚ","orang-orang terdahulu","l-awalīna",142],["فَلَن","maka tidaklah","falan",113],["تَجِدَ","kamu dapati","tajida",110],["لِسُنَّتِ","bagi sunnah","lisunnati",609],["ٱللَّهِ","Allah","l-lahi",1],["تَبْدِيلًۭا ۖ","berubah","tabdīlan",1109],["وَلَن","dan tidaklah","walan",113],["تَجِدَ","kamu dapati","tajida",110],["لِسُنَّتِ","bagi sunnah","lisunnati",609],["ٱللَّهِ","Allah","l-lahi",1],["تَحْوِيلًا","menyimpang","taḥwīlan",2028]],"t":"karena kesombongan (mereka) di bumi dan karena rencana (mereka) yang jahat. Rencana yang jahat itu hanya akan menimpa pencetus rencananya sendiri. Mereka hanyalah menunggu (berlakunya) ketentuan pada orang-orang yang terdahulu. Maka kamu tidak akan mendapatkan perubahan bagi Allah, dan tidak (pula) akan menemui penyimpangan bagi ketentuan Allah."},{"n":44,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَسِيرُوا۟","mereka berjalan","yasīrū",607],["فِى","pada/di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["فَيَنظُرُوا۟","lalu mereka memperhatikan","fayanẓurū",130],["كَيْفَ","bagaimana","kayfa",139],["كَانَ","adalah","kāna",8],["عَـٰقِبَةُ","akibat","ʿāqibatu",357],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["وَكَانُوٓا۟","dan adalah orang-orang itu","wakānū",8],["أَشَدَّ","sangat/lebih besar","ashadda",366],["مِنْهُمْ","daripada mereka","min'hum",0],["قُوَّةًۭ ۚ","kekuatan","quwwatan",376],["وَمَا","dan tidak","wamā",2],["كَانَ","adalah","kāna",8],["ٱللَّهُ","Allah","l-lahu",1],["لِيُعْجِزَهُۥ","untuk melemahkan-Nya","liyuʿ'jizahu",1467],["مِن","dari","min",0],["شَىْءٍۢ","sesuatu","shayin",41],["فِى","pada/di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَلَا","dan tidak","walā",4],["فِى","di","fī",3],["ٱلْأَرْضِ ۚ","bumi","l-arḍi",22],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["كَانَ","adalah","kāna",8],["عَلِيمًۭا","Maha Mengetahui","ʿalīman",69],["قَدِيرًۭا","Maha Kuasa","qadīran",265]],"t":"Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul), padahal orang-orang itu lebih besar kekuatannya dari mereka? Dan tidak ada sesuatu pun yang dapat melemahkan Allah baik di langit maupun di bumi. Sungguh, Dia Maha Mengetahui, Mahakuasa."},{"n":45,"w":[["وَلَوْ","dan jika sekiranya","walaw",58],["يُؤَاخِذُ","mengambil/menyiksa","yuākhidhu",877],["ٱللَّهُ","Allah","l-lahu",1],["ٱلنَّاسَ","manusia","l-nāsa",52],["بِمَا","dengan apa/sebab","bimā",2],["كَسَبُوا۟","mereka perbuatan","kasabū",196],["مَا","tidak","mā",2],["تَرَكَ","Dia meninggalkan","taraka",298],["عَلَىٰ","atas","ʿalā",7],["ظَهْرِهَا","permukaannya/bumi","ẓahrihā",627],["مِن","dari","min",0],["دَآبَّةٍۢ","makhluk/binatang melata","dābbatin",549],["وَلَـٰكِن","akan tetapi","walākin",166],["يُؤَخِّرُهُمْ","Dia menangguhkan mereka","yu-akhiruhum",620],["إِلَىٰٓ","sampai","ilā",13],["أَجَلٍۢ","waktu","ajalin",228],["مُّسَمًّۭى ۖ","tertentu","musamman",496],["فَإِذَا","maka apabila","fa-idhā",23],["جَآءَ","datang","jāa",43],["أَجَلُهُمْ","ajal/waktu mereka","ajaluhum",228],["فَإِنَّ","maka sesungguh-Nya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["كَانَ","adalah","kāna",8],["بِعِبَادِهِۦ","dengan hamba-hamba-Nya","biʿibādihi",91],["بَصِيرًۢا","Maha Melihat","baṣīran",234]],"t":"Dan sekiranya Allah menghukum manusia disebabkan apa yang telah mereka perbuat, niscaya Dia tidak akan menyisakan satu pun makhluk bergerak yang bernyawa di bumi ini, tetapi Dia menangguhkan (hukuman)-nya, sampai waktu yang sudah ditentukan. Nanti apabila ajal mereka tiba, maka Allah Maha Melihat (keadaan) hamba-hamba-Nya."}]