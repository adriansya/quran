[{"n":1,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["فَتَحْنَا","Kami bukakan/beri kemenangan","fataḥnā",597],["لَكَ","bagi kamu","laka",144],["فَتْحًۭا","pembukaan/kemenangan","fatḥan",736],["مُّبِينًۭا","nyata","mubīnan",103]],"t":"Sungguh, Kami telah memberikan kepadamu kemenangan yang nyata."},{"n":2,"w":[["لِّيَغْفِرَ","untuk memberi ampunan","liyaghfira",187],["لَكَ","bagimu","laka",144],["ٱللَّهُ","Allah","l-lahu",1],["مَا","apa yang","mā",2],["تَقَدَّمَ","telah lalu","taqaddama",2688],["مِن","dari","min",0],["ذَنۢبِكَ","dosa-dosamu","dhanbika",319],["وَمَا","dan apa yang","wamā",2],["تَأَخَّرَ","akan datang","ta-akhara",2023],["وَيُتِمَّ","dan Dia menyempurnakan","wayutimma",592],["نِعْمَتَهُۥ","nikmat-Nya","niʿ'matahu",240],["عَلَيْكَ","atas kamu","ʿalayka",7],["وَيَهْدِيَكَ","dan Dia memberi petunjuk kepadamu","wayahdiyaka",81],["صِرَٰطًۭا","jalan","ṣirāṭan",264],["مُّسْتَقِيمًۭا","lurus","mus'taqīman",326]],"t":"Agar Allah memberikan ampunan kepadamu (Muhammad) atas dosamu yang lalu dan yang akan datang, serta menyempurnakan nikmat-Nya atasmu dan menunjukimu ke jalan yang lurus,"},{"n":3,"w":[["وَيَنصُرَكَ","dan akan menolong kamu","wayanṣuraka",202],["ٱللَّهُ","Allah","l-lahu",1],["نَصْرًا","pertolongan","naṣran",474],["عَزِيزًا","kuat","ʿazīzan",114]],"t":"dan agar Allah menolongmu dengan pertolongan yang kuat (banyak)."},{"n":4,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِىٓ","yang","alladhī",38],["أَنزَلَ","menurunkan","anzala",63],["ٱلسَّكِينَةَ","ketenteraman","l-sakīnata",1231],["فِى","dalam","fī",3],["قُلُوبِ","hati","qulūbi",90],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55],["لِيَزْدَادُوٓا۟","supaya mereka bertambah","liyazdādū",1026],["إِيمَـٰنًۭا","keimanan","īmānan",261],["مَّعَ","beserta","maʿa",70],["إِيمَـٰنِهِمْ ۗ","keimanan mereka","īmānihim",261],["وَلِلَّهِ","dan kepunyaan Allah","walillahi",1],["جُنُودُ","bala tentara","junūdu",384],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["عَلِيمًا","Maha Mengetahui","ʿalīman",69],["حَكِيمًۭا","Maha Bijaksana","ḥakīman",116]],"t":"Dialah yang telah menurunkan ketenangan ke dalam hati orang-orang mukmin untuk menambah keimanan atas keimanan mereka (yang telah ada). Dan milik Allah lah bala tentara langit dan bumi, dan Allah Maha Mengetahui, Mahabijaksana,"},{"n":5,"w":[["لِّيُدْخِلَ","Karena Dia hendak memasukkan","liyud'khila",279],["ٱلْمُؤْمِنِينَ","orang-orang mukmin laki-laki","l-mu'minīna",55],["وَٱلْمُؤْمِنَـٰتِ","dan orang-orang mukmin perempuan","wal-mu'mināti",55],["جَنَّـٰتٍۢ","surga","jannātin",78],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",236],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",223],["خَـٰلِدِينَ","mereka kekal","khālidīna",163],["فِيهَا","didalamnya","fīhā",3],["وَيُكَفِّرَ","dan Dia hendak menghapus","wayukaffira",666],["عَنْهُمْ","dari mereka","ʿanhum",21],["سَيِّـَٔاتِهِمْ ۚ","kesalahan mereka","sayyiātihim",207],["وَكَانَ","dan adalah","wakāna",8],["ذَٰلِكَ","demikian itu","dhālika",20],["عِندَ","di sisi","ʿinda",60],["ٱللَّهِ","Allah","l-lahi",1],["فَوْزًا","keuntungan","fawzan",531],["عَظِيمًۭا","besar","ʿaẓīman",101]],"t":"Agar Dia masukkan orang-orang mukmin laki-laki dan perempuan ke dalam surga yang mengalir di bawahnya sungai-sungai. Mereka kekal di dalamnya dan Dia akan menghapus kesalahan-kesalahan mereka. Dan yang demikian itu menurut Allah suatu keuntungan yang besar,"},{"n":6,"w":[["وَيُعَذِّبَ","dan Dia hendak mengazab","wayuʿadhiba",287],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik laki-laki","l-munāfiqīna",361],["وَٱلْمُنَـٰفِقَـٰتِ","dan orang-orang munafik perempuan","wal-munāfiqāti",361],["وَٱلْمُشْرِكِينَ","dan orang-orang musyrik laki-laki","wal-mush'rikīna",246],["وَٱلْمُشْرِكَـٰتِ","dan orang-orang musyrik perempuan","wal-mush'rikāti",246],["ٱلظَّآنِّينَ","mereka berperasangka","l-ẓānīna",3313],["بِٱللَّهِ","terhadap Allah","bil-lahi",1],["ظَنَّ","sangkaan","ẓanna",489],["ٱلسَّوْءِ ۚ","buruk","l-sawi",935],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["دَآئِرَةُ","giliran","dāiratu",1551],["ٱلسَّوْءِ ۖ","buruk","l-sawi",935],["وَغَضِبَ","dan murka","waghaḍiba",1185],["ٱللَّهُ","Allah","l-lahu",1],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["وَلَعَنَهُمْ","dan Dia mengutuk mereka","walaʿanahum",457],["وَأَعَدَّ","dan Dia menyediakan","wa-aʿadda",502],["لَهُمْ","bagi mereka","lahum",11],["جَهَنَّمَ ۖ","neraka jahanam","jahannama",152],["وَسَآءَتْ","dan amat buruk","wasāat",377],["مَصِيرًۭا","tempat kembali","maṣīran",394]],"t":"dan Dia mengazab orang-orang munafik laki-laki dan perempuan, dan (juga) orang-orang musyrik laki-laki dan perempuan yang berprasangka buruk terhadap Allah. Mereka akan mendapat giliran (azab) yang buruk, dan Allah murka kepada mereka dan mengutuk mereka, serta menyediakan neraka Jahanam bagi mereka. Dan (neraka Jahanam) itu seburuk-buruk tempat kembali."},{"n":7,"w":[["وَلِلَّهِ","dan kepunyaan Allah","walillahi",1],["جُنُودُ","bala tentara","junūdu",384],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["عَزِيزًا","Maha Perkasa","ʿazīzan",114],["حَكِيمًا","Maha Bijaksana","ḥakīman",116]],"t":"Dan milik Allah bala tentara langit dan bumi. Dan Allah Mahaperkasa, Mahabijaksana."},{"n":8,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَرْسَلْنَـٰكَ","Kami mengutus kamu","arsalnāka",92],["شَـٰهِدًۭا","sebagai saksi","shāhidan",483],["وَمُبَشِّرًۭا","dan pembawa kabar gembira","wamubashiran",849],["وَنَذِيرًۭا","dan pemberi peringatan","wanadhīran",206]],"t":"Sungguh, Kami mengutus engkau (Muhammad) sebagai saksi, pembawa berita gembira dan pemberi peringatan,"},{"n":9,"w":[["لِّتُؤْمِنُوا۟","supaya kamu beriman","litu'minū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ","dan kepada rasul-Nya","warasūlihi",35],["وَتُعَزِّرُوهُ","dan kamu meneguhkan-Nya","watuʿazzirūhu",1784],["وَتُوَقِّرُوهُ","dan kamu memuliakan-Nya","watuwaqqirūhu",4483],["وَتُسَبِّحُوهُ","dan kamu bertasbih kepada-Nya","watusabbiḥūhu",283],["بُكْرَةًۭ","di waktu pagi","buk'ratan",1066],["وَأَصِيلًا","dan petang","wa-aṣīlan",1033]],"t":"agar kamu semua beriman kepada Allah dan Rasul-Nya, menguatkan (agama)-Nya, membesarkan-Nya, dan bertasbih kepada-Nya pagi dan petang."},{"n":10,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["يُبَايِعُونَكَ","mereka berjanji setia kepadamu","yubāyiʿūnaka",1169],["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["يُبَايِعُونَ","mereka berjanji setia","yubāyiʿūna",1169],["ٱللَّهَ","Allah","l-laha",1],["يَدُ","tangan","yadu",102],["ٱللَّهِ","Allah","l-lahi",1],["فَوْقَ","di atas","fawqa",291],["أَيْدِيهِمْ ۚ","tangan mereka","aydīhim",102],["فَمَن","maka barang siapa","faman",12],["نَّكَثَ","melanggar janji","nakatha",1218],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",5],["يَنكُثُ","dia melanggar","yankuthu",1218],["عَلَىٰ","atas","ʿalā",7],["نَفْسِهِۦ ۖ","dirinya","nafsihi",39],["وَمَنْ","dan barang siapa","waman",12],["أَوْفَىٰ","menepati","awfā",545],["بِمَا","dengan apa","bimā",2],["عَـٰهَدَ","berjanji","ʿāhada",770],["عَلَيْهُ","atasnya","ʿalayhu",7],["ٱللَّهَ","Allah","l-laha",1],["فَسَيُؤْتِيهِ","maka Dia akan memberinya","fasayu'tīhi",45],["أَجْرًا","pahala","ajran",111],["عَظِيمًۭا","besar","ʿaẓīman",101]],"t":"Bahwa orang-orang yang berjanji setia kepadamu (Muhammad), sesungguhnya mereka hanya berjanji setia kepada Allah. Tangan Allah di atas tangan-tangan mereka, maka barangsiapa melanggar janji, maka sesungguhnya dia melanggar atas (janji) sendiri; dan barangsiapa menepati janjinya kepada Allah, maka Dia akan memberinya pahala yang besar."},{"n":11,"w":[["سَيَقُولُ","akan mengatakan","sayaqūlu",6],["لَكَ","kepadamu","laka",144],["ٱلْمُخَلَّفُونَ","mereka tertinggal","l-mukhalafūna",1610],["مِنَ","dari","mina",0],["ٱلْأَعْرَابِ","orang-orang arab dusun","l-aʿrābi",816],["شَغَلَتْنَآ","telah menyibukkan kami","shaghalatnā",2831],["أَمْوَٰلُنَا","harta kami","amwālunā",132],["وَأَهْلُونَا","dan keluarga kami","wa-ahlūnā",94],["فَٱسْتَغْفِرْ","maka mohon ampunan","fa-is'taghfir",304],["لَنَا ۚ","bagi kami","lanā",126],["يَقُولُونَ","mereka berkata","yaqūlūna",6],["بِأَلْسِنَتِهِم","dengan lisan mereka","bi-alsinatihim",432],["مَّا","apa yang","mā",2],["لَيْسَ","tidak ada","laysa",124],["فِى","dalam","fī",3],["قُلُوبِهِمْ ۚ","hati mereka","qulūbihim",90],["قُلْ","katakanlah","qul",6],["فَمَن","maka siapakah","faman",12],["يَمْلِكُ","memiliki/kuasa","yamliku",272],["لَكُم","bagi kalian","lakum",26],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["شَيْـًٔا","sedikitpun","shayan",41],["إِنْ","jika","in",14],["أَرَادَ","Dia menghendaki","arāda",84],["بِكُمْ","dengan/untuk kalian","bikum",26],["ضَرًّا","mudharat/bahaya","ḍarran",821],["أَوْ","atau","aw",42],["أَرَادَ","Dia menghendaki","arāda",84],["بِكُمْ","dengan/untuk kalian","bikum",26],["نَفْعًۢا ۚ","manfaat","nafʿan",797],["بَلْ","bahkan","bal",97],["كَانَ","adalah","kāna",8],["ٱللَّهُ","Allah","l-lahu",1],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["خَبِيرًۢا","Maha Mengetahui","khabīran",267]],"t":"Orang-orang Badui yang tertinggal (tidak turut ke Hudaibiyah) akan berkata kepadamu, \"Kami telah disibukkan oleh harta dan keluarga kami, maka mohonkanlah ampunan untuk kami.\" Mereka mengucapkan sesuatu dengan mulutnya apa yang tidak ada dalam hatinya. Katakanlah, \"Maka siapakah yang dapat menghalang-halangi kehendak Allah jika Dia menghendaki bencana terhadap kamu atau jika Dia menghendaki keuntungan bagimu? Sungguh, Allah Mahateliti dengan apa yang kamu kerjakan.\""},{"n":12,"w":[["بَلْ","bahkan/tetapi","bal",97],["ظَنَنتُمْ","kamu telah menyangka","ẓanantum",254],["أَن","bahwa","an",17],["لَّن","tidak akan","lan",113],["يَنقَلِبَ","berbalik/kembali","yanqaliba",588],["ٱلرَّسُولُ","rasul","l-rasūlu",35],["وَٱلْمُؤْمِنُونَ","dan orang-orang mukmin","wal-mu'minūna",55],["إِلَىٰٓ","kepada","ilā",13],["أَهْلِيهِمْ","keluarga mereka","ahlīhim",94],["أَبَدًۭا","selama-lamanya","abadan",390],["وَزُيِّنَ","dan menjadikan memandang baik","wazuyyina",422],["ذَٰلِكَ","demikian itu","dhālika",20],["فِى","dalam","fī",3],["قُلُوبِكُمْ","hatimu","qulūbikum",90],["وَظَنَنتُمْ","dan kamu telah menyangka","waẓanantum",254],["ظَنَّ","sangkaan","ẓanna",489],["ٱلسَّوْءِ","buruk","l-sawi",935],["وَكُنتُمْ","dan kalian","wakuntum",8],["قَوْمًۢا","kaum","qawman",27],["بُورًۭا","binasa","būran",2321]],"t":"Bahkan (semula) kamu menyangka bahwa Rasul dan orang-orang mukmin sekali-kali tidak akan kembali lagi kepada keluarga mereka selama-lamanya, dan dijadikan terasa indah yang demikian itu di dalam hatimu, dan kamu telah berprasangka dengan prasangka yang buruk, karena itu kamu menjadi kaum yang binasa."},{"n":13,"w":[["وَمَن","dan barang siapa","waman",12],["لَّمْ","tidak","lam",32],["يُؤْمِنۢ","beriman","yu'min",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ","dan rasul-Nya","warasūlihi",35],["فَإِنَّآ","maka sesungguhnya Kami","fa-innā",5],["أَعْتَدْنَا","Kami menyediakan","aʿtadnā",648],["لِلْكَـٰفِرِينَ","bagi orang-orang kafir","lil'kāfirīna",71],["سَعِيرًۭا","neraka yang menyala-nyala","saʿīran",608]],"t":"Dan barangsiapa tidak beriman kepada Allah dan Rasul-Nya, maka sesungguhnya Kami telah menyediakan untuk orang-orang kafir itu neraka yang menyala-nyala."},{"n":14,"w":[["وَلِلَّهِ","dan kepunyaan Allah","walillahi",1],["مُلْكُ","kerajaan","mul'ku",252],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["يَغْفِرُ","Dia memberi ampunan","yaghfiru",187],["لِمَن","kepada siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيُعَذِّبُ","dan Dia mengazab","wayuʿadhibu",287],["مَن","siapa","man",12],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["غَفُورًۭا","Maha Pengampun","ghafūran",122],["رَّحِيمًۭا","Maha Penyayang","raḥīman",104]],"t":"Dan hanya milik Allah kerajaan langit dan bumi. Dia mengampuni siapa yang Dia kehendaki, dan akan mengazab siapa yang Dia kehendaki. Dan Allah Maha Pengampun, Maha Penyayang."},{"n":15,"w":[["سَيَقُولُ","akan berkata","sayaqūlu",6],["ٱلْمُخَلَّفُونَ","orang-orang yang tertinggal","l-mukhalafūna",1610],["إِذَا","apabila","idhā",23],["ٱنطَلَقْتُمْ","kamu berangkat","inṭalaqtum",949],["إِلَىٰ","kepada","ilā",13],["مَغَانِمَ","rampasan perang","maghānima",1590],["لِتَأْخُذُوهَا","untuk kamu mengambilnya","litakhudhūhā",95],["ذَرُونَا","biarkanlah kami","dharūnā",266],["نَتَّبِعْكُمْ ۖ","kami mengikuti kamu","nattabiʿ'kum",87],["يُرِيدُونَ","mareka hendak","yurīdūna",84],["أَن","bahwa","an",17],["يُبَدِّلُوا۟","mereka akan mengganti","yubaddilū",454],["كَلَـٰمَ","firman","kalāma",1580],["ٱللَّهِ ۚ","Allah","l-lahi",1],["قُل","katakanlah","qul",6],["لَّن","tidak","lan",113],["تَتَّبِعُونَا","kamu mengikuti kami","tattabiʿūnā",87],["كَذَٰلِكُمْ","demikianlah","kadhālikum",20],["قَالَ","berfirman","qāla",6],["ٱللَّهُ","Allah","l-lahu",1],["مِن","dari","min",0],["قَبْلُ ۖ","sebelum","qablu",51],["فَسَيَقُولُونَ","maka akan berkata mereka","fasayaqūlūna",6],["بَلْ","tetapi","bal",97],["تَحْسُدُونَنَا ۚ","kamu dengki pada kami","taḥsudūnanā",1801],["بَلْ","tetapi","bal",97],["كَانُوا۟","adalah mereka","kānū",8],["لَا","tidak","lā",4],["يَفْقَهُونَ","mereka mengerti","yafqahūna",530],["إِلَّا","kecuali","illā",15],["قَلِيلًۭا","sedikit","qalīlan",176]],"t":"Apabila kamu berangkat untuk mengambil barang rampasan, orang-orang Badui yang tertinggal itu akan berkata, \"Biarkanlah kami mengikuti kamu.\" Mereka hendak mengubah janji Allah. Katakanlah, \"Kamu sekali-kali tidak (boleh) mengikuti kami. Demikianlah yang telah ditetapkan Allah sejak semula.\" Maka mereka akan berkata, \"Sebenarnya kamu dengki kepada kami.\" Padahal mereka tidak mengerti melainkan sedikit sekali."},{"n":16,"w":[["قُل","katakanlah","qul",6],["لِّلْمُخَلَّفِينَ","kepada orang-orang yang tertinggal","lil'mukhallafīna",1610],["مِنَ","dari","mina",0],["ٱلْأَعْرَابِ","orang-orang arab dusun","l-aʿrābi",816],["سَتُدْعَوْنَ","kamu akan di ajak","satud'ʿawna",66],["إِلَىٰ","kepada","ilā",13],["قَوْمٍ","kaum","qawmin",27],["أُو۟لِى","mempunyai","ulī",262],["بَأْسٍۢ","kekuatan","basin",427],["شَدِيدٍۢ","yang sangat","shadīdin",215],["تُقَـٰتِلُونَهُمْ","kamu memerangi mereka","tuqātilūnahum",224],["أَوْ","atau","aw",42],["يُسْلِمُونَ ۖ","mereka menyerah","yus'limūna",464],["فَإِن","maka jika","fa-in",14],["تُطِيعُوا۟","kamu mentaati","tuṭīʿū",167],["يُؤْتِكُمُ","memberikan kepadamu","yu'tikumu",45],["ٱللَّهُ","Allah","l-lahu",1],["أَجْرًا","pahala","ajran",111],["حَسَنًۭا ۖ","baik","ḥasanan",488],["وَإِن","dan jika","wa-in",14],["تَتَوَلَّوْا۟","kamu berpaling","tatawallaw",150],["كَمَا","sebagaimana","kamā",2],["تَوَلَّيْتُم","kamu telah berpaling","tawallaytum",150],["مِّن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["يُعَذِّبْكُمْ","Dia akan mengazab kamu","yuʿadhib'kum",287],["عَذَابًا","azab","ʿadhāban",36],["أَلِيمًۭا","pedih","alīman",168]],"t":"Katakanlah kepada orang-orang Badui yang tertinggal, \"Kamu akan diajak untuk (memerangi) kaum yang mempunyai kekuatan yang besar, kamu harus memerangi mereka kecuali mereka menyerah. Jika kamu patuhi (ajakan itu), Allah akan memberimu pahala yang baik; tetapi jika kamu berpaling seperti yang kamu perbuat sebelumnya, Dia akan mengazab kamu dengan azab yang pedih.\""},{"n":17,"w":[["لَّيْسَ","tidak","laysa",124],["عَلَى","atas","ʿalā",7],["ٱلْأَعْمَىٰ","orang buta","l-aʿmā",485],["حَرَجٌۭ","berdosa","ḥarajun",623],["وَلَا","dan tidak","walā",4],["عَلَى","atas","ʿalā",7],["ٱلْأَعْرَجِ","orang yang pincang","l-aʿraji",2138],["حَرَجٌۭ","berdosa","ḥarajun",623],["وَلَا","dan tidak","walā",4],["عَلَى","atas","ʿalā",7],["ٱلْمَرِيضِ","orang yang sakit","l-marīḍi",851],["حَرَجٌۭ ۗ","berdosa","ḥarajun",623],["وَمَن","dan barang siapa","waman",12],["يُطِعِ","mentaati","yuṭiʿi",167],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ","dan rasul-Nya","warasūlahu",35],["يُدْخِلْهُ","Dia memasukkannya","yud'khil'hu",279],["جَنَّـٰتٍۢ","surga","jannātin",78],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",236],["ٱلْأَنْهَـٰرُ ۖ","sungai-sungai","l-anhāru",223],["وَمَن","dan barang siapa","waman",12],["يَتَوَلَّ","berpaling","yatawalla",150],["يُعَذِّبْهُ","Dia mengazabnya","yuʿadhib'hu",287],["عَذَابًا","azab","ʿadhāban",36],["أَلِيمًۭا","pedih","alīman",168]],"t":"Tidak ada dosa atas orang-orang yang buta, atas orang-orang yang pincang, dan atas orang-orang yang sakit (apabila tidak ikut berperang). Barangsiapa taat kepada Allah dan Rasul-Nya, Dia akan memasukkannya ke dalam surga yang mengalir di bawahnya sungai-sungai; tetapi barangsiapa berpaling, Dia akan mengazabnya dengan azab yang pedih."},{"n":18,"w":[["۞ لَّقَدْ","sesungguhnya","laqad",24],["رَضِىَ","meridhai","raḍiya",318],["ٱللَّهُ","Allah","l-lahu",1],["عَنِ","dari","ʿani",21],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55],["إِذْ","ketika","idh",53],["يُبَايِعُونَكَ","mereka berjanji setia kepadamu","yubāyiʿūnaka",1169],["تَحْتَ","di bawah","taḥta",236],["ٱلشَّجَرَةِ","pohon","l-shajarati",523],["فَعَلِمَ","maka Dia mengetahui","faʿalima",29],["مَا","apa yang","mā",2],["فِى","di dalam","fī",3],["قُلُوبِهِمْ","hati mereka","qulūbihim",90],["فَأَنزَلَ","lalu Dia menurunkan","fa-anzala",63],["ٱلسَّكِينَةَ","ketenteraman","l-sakīnata",1231],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["وَأَثَـٰبَهُمْ","dan Dia memberi balasan kepada mereka","wa-athābahum",1758],["فَتْحًۭا","kemenangan","fatḥan",736],["قَرِيبًۭا","dekat","qarīban",419]],"t":"Sungguh, Allah telah meridai orang-orang mukmin ketika mereka berjanji setia kepadamu (Muhammad) di bawah pohon, Dia mengetahui apa yang ada dalam hati mereka, lalu Dia memberikan ketenangan atas mereka dan memberi balasan dengan kemenangan yang dekat,"},{"n":19,"w":[["وَمَغَانِمَ","dan rampasan perang","wamaghānima",1590],["كَثِيرَةًۭ","banyak","kathīratan",162],["يَأْخُذُونَهَا ۗ","mereka mengambilnya","yakhudhūnahā",95],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["عَزِيزًا","Maha Perkasa","ʿazīzan",114],["حَكِيمًۭا","Maha Bijaksana","ḥakīman",116]],"t":"dan harta rampasan perang yang banyak yang akan mereka peroleh. Dan Allah Mahaperkasa, Mahabijaksana."},{"n":20,"w":[["وَعَدَكُمُ","dan menjanjikan kepadamu","waʿadakumu",180],["ٱللَّهُ","Allah","l-lahu",1],["مَغَانِمَ","rampasan perang","maghānima",1590],["كَثِيرَةًۭ","banyak","kathīratan",162],["تَأْخُذُونَهَا","kamu mengambilnya","takhudhūnahā",95],["فَعَجَّلَ","maka Dia segerakan","faʿajjala",1293],["لَكُمْ","bagi kalian","lakum",26],["هَـٰذِهِۦ","ini","hādhihi",255],["وَكَفَّ","dan Dia menahan","wakaffa",985],["أَيْدِىَ","tangan-tangan","aydiya",102],["ٱلنَّاسِ","manusia","l-nāsi",52],["عَنكُمْ","dari kalian","ʿankum",21],["وَلِتَكُونَ","dan agar menjadi","walitakūna",8],["ءَايَةًۭ","ayat/bukti","āyatan",28],["لِّلْمُؤْمِنِينَ","bagi orang-orang yang beriman","lil'mu'minīna",55],["وَيَهْدِيَكُمْ","dan Dia memberi petunjuk kepadamu","wayahdiyakum",81],["صِرَٰطًۭا","jalan","ṣirāṭan",264],["مُّسْتَقِيمًۭا","lurus","mus'taqīman",326]],"t":"Allah menjanjikan kepadamu harta rampasan perang yang banyak yang dapat kamu ambil, maka Dia segerakan (harta rampasan perang) ini untukmu, dan Dia menahan tangan manusia dari (membinasakan)mu (agar kamu mensyukuri-Nya), dan agar menjadi bukti bagi orang-orang mukmin, dan agar Dia menunjukkan kamu ke jalan yang lurus,"},{"n":21,"w":[["وَأُخْرَىٰ","dan yang lain","wa-ukh'rā",177],["لَمْ","tidak","lam",32],["تَقْدِرُوا۟","kamu dapat menguasai","taqdirū",434],["عَلَيْهَا","atasnya","ʿalayhā",7],["قَدْ","sesungguhnya","qad",24],["أَحَاطَ","meliputi","aḥāṭa",564],["ٱللَّهُ","Allah","l-lahu",1],["بِهَا ۚ","padanya","bihā",98],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرًۭا","Maha Kuasa","qadīran",265]],"t":"dan (kemenangan-kemenangan) atas negeri-negeri lain yang tidak dapat kamu perkirakan, tetapi sesungguhnya Allah telah menentukannya. Dan Allah Mahakuasa atas segala sesuatu."},{"n":22,"w":[["وَلَوْ","dan sekiranya","walaw",58],["قَـٰتَلَكُمُ","memerangi kamu","qātalakumu",224],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَوَلَّوُا۟","pasti mereka berpaling","lawallawū",379],["ٱلْأَدْبَـٰرَ","belakang","l-adbāra",551],["ثُمَّ","kemudian","thumma",34],["لَا","tidak","lā",4],["يَجِدُونَ","mereka memperoleh","yajidūna",110],["وَلِيًّۭا","pelindung","waliyyan",133],["وَلَا","dan tidak","walā",4],["نَصِيرًۭا","penolong","naṣīran",338]],"t":"Dan sekiranya orang-orang yang kafir itu memerangi kamu, pastilah mereka akan berbalik melarikan diri (kalah), dan mereka tidak akan mendapatkan pelindung dan penolong."},{"n":23,"w":[["سُنَّةَ","ketetapan","sunnata",609],["ٱللَّهِ","Allah","l-lahi",1],["ٱلَّتِى","yang","allatī",185],["قَدْ","sungguh","qad",24],["خَلَتْ","telah berlalu","khalat",435],["مِن","dari","min",0],["قَبْلُ ۖ","sebelum","qablu",51],["وَلَن","dan tidak","walan",113],["تَجِدَ","kamu mendapatkan","tajida",110],["لِسُنَّةِ","bagi ketetapan","lisunnati",609],["ٱللَّهِ","Allah","l-lahi",1],["تَبْدِيلًۭا","perobahan/pergantian","tabdīlan",1109]],"t":"(Demikianlah) hukum Allah yang telah berlaku sejak dahulu, kamu sekali-kali tidak akan menemukan perubahan pada hukum Allah."},{"n":24,"w":[["وَهُوَ","dan Dia","wahuwa",19],["ٱلَّذِى","yang","alladhī",38],["كَفَّ","menahan","kaffa",985],["أَيْدِيَهُمْ","tangan-tangan mereka","aydiyahum",102],["عَنكُمْ","dari kalian","ʿankum",21],["وَأَيْدِيَكُمْ","dan tangan-tanganmu","wa-aydiyakum",102],["عَنْهُم","dari mereka","ʿanhum",21],["بِبَطْنِ","di tengah","bibaṭni",571],["مَكَّةَ","Mekkah","makkata",3712],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",59],["أَنْ","bahwa","an",17],["أَظْفَرَكُمْ","Dia memenangkan kamu","aẓfarakum",2941],["عَلَيْهِمْ ۚ","atas mereka","ʿalayhim",7],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["بِمَا","dengan","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["بَصِيرًا","Maha Melihat","baṣīran",234]],"t":"Dan Dialah yang mencegah tangan mereka dari (membinasakan) kamu dan (mencegah) tangan kamu dari (membinasakan) mereka di tengah (kota) Mekkah, setelah Allah memenangkan kamu atas mereka. Dan Allah Maha Melihat apa yang kamu kerjakan."},{"n":25,"w":[["هُمُ","mereka","humu",11],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَصَدُّوكُمْ","dan mereka menghalangi kamu","waṣaddūkum",322],["عَنِ","dari","ʿani",21],["ٱلْمَسْجِدِ","Masjid","l-masjidi",395],["ٱلْحَرَامِ","Haram","l-ḥarāmi",349],["وَٱلْهَدْىَ","dan hewan kurban","wal-hadya",1074],["مَعْكُوفًا","disembelih","maʿkūfan",3667],["أَن","bahwa","an",17],["يَبْلُغَ","ia sampai","yablugha",296],["مَحِلَّهُۥ ۚ","tempatnya","maḥillahu",1903],["وَلَوْلَا","dan kalau tidak","walawlā",157],["رِجَالٌۭ","orang-orang laki-laki","rijālun",213],["مُّؤْمِنُونَ","mereka beriman","mu'minūna",55],["وَنِسَآءٌۭ","dan orang-orang perempuan","wanisāon",203],["مُّؤْمِنَـٰتٌۭ","mereka beriman","mu'minātun",55],["لَّمْ","tidak","lam",32],["تَعْلَمُوهُمْ","kamu mengetahui mereka","taʿlamūhum",29],["أَن","bahwa","an",17],["تَطَـُٔوهُمْ","kamu akan membunuh mereka","taṭaūhum",2041],["فَتُصِيبَكُم","maka akan menimpa kamu","fatuṣībakum",191],["مِّنْهُم","dari mereka","min'hum",0],["مَّعَرَّةٌۢ","kesusahan","maʿarratun",3915],["بِغَيْرِ","dengan tanpa","bighayri",77],["عِلْمٍۢ ۖ","pengetahuan","ʿil'min",112],["لِّيُدْخِلَ","karena hendak memasukkan","liyud'khila",279],["ٱللَّهُ","Allah","l-lahu",1],["فِى","ke dalam","fī",3],["رَحْمَتِهِۦ","rahmat-Nya","raḥmatihi",106],["مَن","siapa yang","man",12],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["لَوْ","sekiranya","law",58],["تَزَيَّلُوا۟","mereka terpisah","tazayyalū",4420],["لَعَذَّبْنَا","pasti Kami mengazab","laʿadhabnā",287],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِنْهُمْ","dari mereka","min'hum",0],["عَذَابًا","azab","ʿadhāban",36],["أَلِيمًا","pedih","alīman",168]],"t":"Merekalah orang-orang kafir yang menghalang-halangi kamu (masuk) Masjidilharam dan menghambat hewan-hewan kurban sampai ke tempat (penyembelihan)nya. Dan kalau bukanlah karena ada beberapa orang beriman laki-laki dan perempuan yang tidak kamu ketahui, tentulah kamu akan membunuh mereka yang menyebabkan kamu ditimpa kesulitan tanpa kamu sadari; karena Allah hendak memasukkan siapa yang Dia kehendaki ke dalam rahmat-Nya. Sekiranya mereka terpisah, tentu Kami akan mengazab orang-orang yang kafir di antara mereka dengan azab yang pedih."},{"n":26,"w":[["إِذْ","tatkala","idh",53],["جَعَلَ","menjadikan/membuat","jaʿala",33],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["فِى","dalam","fī",3],["قُلُوبِهِمُ","hati mereka","qulūbihimu",90],["ٱلْحَمِيَّةَ","kesombongan","l-ḥamiyata",2269],["حَمِيَّةَ","kesombongan","ḥamiyyata",2269],["ٱلْجَـٰهِلِيَّةِ","jahiliyah","l-jāhiliyati",1868],["فَأَنزَلَ","maka menurunkan","fa-anzala",63],["ٱللَّهُ","Allah","l-lahu",1],["سَكِينَتَهُۥ","ketenteraman","sakīnatahu",1231],["عَلَىٰ","atas","ʿalā",7],["رَسُولِهِۦ","rasul-Nya","rasūlihi",35],["وَعَلَى","dan atas","waʿalā",7],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55],["وَأَلْزَمَهُمْ","dan Dia menetapkan mereka","wa-alzamahum",1743],["كَلِمَةَ","kalimat","kalimata",281],["ٱلتَّقْوَىٰ","takwa","l-taqwā",583],["وَكَانُوٓا۟","dan adalah mereka","wakānū",8],["أَحَقَّ","lebih berhak","aḥaqqa",817],["بِهَا","dengannya","bihā",98],["وَأَهْلَهَا ۚ","dan ahlinya","wa-ahlahā",94],["وَكَانَ","dan adalah","wakāna",8],["ٱللَّهُ","Allah","l-lahu",1],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمًۭا","Maha Mengetahui","ʿalīman",69]],"t":"Ketika orang-orang yang kafir menanamkan kesombongan dalam hati mereka (yaitu) kesombongan jahiliah, maka Allah menurunkan ketenangan kepada Rasul-Nya, dan kepada orang-orang mukmin dan (Allah) mewajibkan kepada mereka tetap taat menjalankan kalimat takwa, dan mereka lebih berhak dengan itu dan patut memilikinya. Dan Allah Maha Mengetahui segala sesuatu."},{"n":27,"w":[["لَّقَدْ","sesungguhnya","laqad",24],["صَدَقَ","membenarkan","ṣadaqa",625],["ٱللَّهُ","Allah","l-lahu",1],["رَسُولَهُ","rasul-Nya","rasūlahu",35],["ٱلرُّءْيَا","mimpi","l-ru'yā",1102],["بِٱلْحَقِّ ۖ","dengan benar","bil-ḥaqi",50],["لَتَدْخُلُنَّ","sungguh kamu akan memasuki","latadkhulunna",155],["ٱلْمَسْجِدَ","Masjid","l-masjida",395],["ٱلْحَرَامَ","Haram","l-ḥarāma",349],["إِن","jika","in",14],["شَآءَ","menghendaki","shāa",54],["ٱللَّهُ","Allah","l-lahu",1],["ءَامِنِينَ","dengan aman","āminīna",562],["مُحَلِّقِينَ","mencukur rambut","muḥalliqīna",3793],["رُءُوسَكُمْ","kepala kamu","ruūsakum",557],["وَمُقَصِّرِينَ","dan memendekkan guntingan rambut","wamuqaṣṣirīna",3844],["لَا","tidak","lā",4],["تَخَافُونَ ۖ","kamu merasa takut","takhāfūna",141],["فَعَلِمَ","maka Dia mengetahui","faʿalima",29],["مَا","apa yang","mā",2],["لَمْ","tidak","lam",32],["تَعْلَمُوا۟","kamu ketahui","taʿlamū",29],["فَجَعَلَ","maka Dia menjadikan","fajaʿala",33],["مِن","dari","min",0],["دُونِ","selain","dūni",80],["ذَٰلِكَ","demikian itu","dhālika",20],["فَتْحًۭا","kemenangan","fatḥan",736],["قَرِيبًا","dekat","qarīban",419]],"t":"Sungguh, Allah akan membuktikan kepada Rasul-Nya tentang kebenaran mimpinya bahwa kamu pasti akan memasuki Masjidilharam, jika Allah menghendaki dalam keadaan aman, dengan menggundul rambut kepala dan memendekkannya, sedang kamu tidak merasa takut. Maka Allah mengetahui apa yang tidak kamu ketahui, dan selain itu Dia telah memberikan kemenangan yang dekat."},{"n":28,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِىٓ","yang","alladhī",38],["أَرْسَلَ","mengutus","arsala",92],["رَسُولَهُۥ","rasul-Nya","rasūlahu",35],["بِٱلْهُدَىٰ","dengan petunjuk","bil-hudā",134],["وَدِينِ","dan agama","wadīni",121],["ٱلْحَقِّ","benar","l-ḥaqi",50],["لِيُظْهِرَهُۥ","karena Dia hendak memenangkannya","liyuẓ'hirahu",957],["عَلَى","atas","ʿalā",7],["ٱلدِّينِ","agama","l-dīni",121],["كُلِّهِۦ ۚ","semuanya","kullihi",31],["وَكَفَىٰ","dan cukup","wakafā",360],["بِٱللَّهِ","dengan Allah","bil-lahi",1],["شَهِيدًۭا","saksi","shahīdan",216]],"t":"Dialah yang mengutus Rasul-Nya dengan membawa petunjuk dan agama yang benar, agar dimenangkan-Nya terhadap semua agama. Dan cukuplah Allah sebagai saksi."},{"n":29,"w":[["مُّحَمَّدٌۭ","Muhammad","muḥammadun",1602],["رَّسُولُ","rasul","rasūlu",35],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["مَعَهُۥٓ","bersama dia","maʿahu",70],["أَشِدَّآءُ","sangat keras","ashiddāu",215],["عَلَى","terhadap","ʿalā",7],["ٱلْكُفَّارِ","orang-orang kafir","l-kufāri",71],["رُحَمَآءُ","kasih sayang","ruḥamāu",104],["بَيْنَهُمْ ۖ","diantara mereka","baynahum",47],["تَرَىٰهُمْ","kamu melihat mereka","tarāhum",46],["رُكَّعًۭا","ruku'","rukkaʿan",1003],["سُجَّدًۭا","sujud","sujjadan",460],["يَبْتَغُونَ","mereka mencari","yabtaghūna",347],["فَضْلًۭا","karunia","faḍlan",136],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["وَرِضْوَٰنًۭا ۖ","dan keridhaan","wariḍ'wānan",701],["سِيمَاهُمْ","tanda-tanda mereka","sīmāhum",1234],["فِى","dalam","fī",3],["وُجُوهِهِم","muka-muka mereka","wujūhihim",170],["مِّنْ","dari","min",0],["أَثَرِ","bekas","athari",651],["ٱلسُّجُودِ ۚ","sujud","l-sujūdi",1237],["ذَٰلِكَ","demikian itu","dhālika",20],["مَثَلُهُمْ","perumpamaan mereka","mathaluhum",129],["فِى","dalam","fī",3],["ٱلتَّوْرَىٰةِ ۚ","Taurat","l-tawrāti",560],["وَمَثَلُهُمْ","dan perumpamaan mereka","wamathaluhum",129],["فِى","dalam","fī",3],["ٱلْإِنجِيلِ","injil","l-injīli",712],["كَزَرْعٍ","seperti tanaman","kazarʿin",871],["أَخْرَجَ","ia mengeluarkan","akhraja",115],["شَطْـَٔهُۥ","tumbuhnya/tunasnya","shaṭahu",2824],["فَـَٔازَرَهُۥ","maka ia menguatkan","faāzarahu",3316],["فَٱسْتَغْلَظَ","lalu ia menjadi besar","fa-is'taghlaẓa",4654],["فَٱسْتَوَىٰ","maka ia tegak","fa-is'tawā",341],["عَلَىٰ","atas","ʿalā",7],["سُوقِهِۦ","batangnya","sūqihi",1664],["يُعْجِبُ","menakjubkan/menyenangkan","yuʿ'jibu",765],["ٱلزُّرَّاعَ","penanam-penanam","l-zurāʿa",2770],["لِيَغِيظَ","karena Dia hendak menjengkelkan","liyaghīẓa",1852],["بِهِمُ","dengan mereka","bihimu",11],["ٱلْكُفَّارَ ۗ","orang-orang kafir","l-kufāra",71],["وَعَدَ","telah menjanjikan","waʿada",180],["ٱللَّهُ","Allah","l-lahu",1],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebaikan","l-ṣāliḥāti",96],["مِنْهُم","dari mereka","min'hum",0],["مَّغْفِرَةًۭ","ampunan","maghfiratan",396],["وَأَجْرًا","dan pahala","wa-ajran",111],["عَظِيمًۢا","besar","ʿaẓīman",101]],"t":"Muhammad adalah utusan Allah, dan orang-orang yang bersama dengan dia bersikap keras terhadap orang-orang kafir, tetapi berkasih sayang dengan sesama mereka. Kamu melihat mereka rukuk dan sujud mencari karunia Allah dan keridaan-Nya. Pada wajah mereka tampak tanda-tanda bekas sujud. Demikianlah sifat-sifat mereka (yang diungkapkan) dalam Taurat dan sifat-sifat mereka (yang diungkapkan) dalam Injil, yaitu seperti benih yang mengeluarkan tunasnya, kemudian tunas itu semakin kuat, lalu menjadi besar dan tegak lurus di atas batangnya; tanaman itu menyenangkan hati penanam-penanamnya karena Allah hendak menjengkelkan hati orang-orang kafir (dengan kekuatan orang-orang mukmin). Allah menjanjikan kepada orang-orang yang beriman dan mengerjakan kebajikan di antara mereka, ampunan dan pahala yang besar."}]