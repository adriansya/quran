[{"n":1,"w":[["ٱقْرَأْ","bacalah","iq'ra",614],["بِٱسْمِ","dengan nama","bi-is'mi",324],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","menciptakan","khalaqa",70]],"t":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,"},{"n":2,"w":[["خَلَقَ","menciptakan","khalaqa",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["مِنْ","dari","min",1],["عَلَقٍ","segumpal darah","ʿalaqin",3109]],"t":"Dia telah menciptakan manusia dari segumpal darah."},{"n":3,"w":[["ٱقْرَأْ","bacalah","iq'ra",614],["وَرَبُّكَ","dan Tuhanmu","warabbuka",15],["ٱلْأَكْرَمُ","amat mulia","l-akramu",2173]],"t":"Bacalah, dan Tuhanmulah Yang Mahamulia."},{"n":4,"w":[["ٱلَّذِى","yang","alladhī",45],["عَلَّمَ","Dia mengajar","ʿallama",298],["بِٱلْقَلَمِ","dengan kalam","bil-qalami",1648]],"t":"Yang mengajar (manusia) dengan pena."},{"n":5,"w":[["عَلَّمَ","Dia mengajarkan","ʿallama",298],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["مَا","apa","mā",6],["لَمْ","tidak","lam",39],["يَعْلَمْ","dia ketahui","yaʿlam",35]],"t":"Dia mengajarkan manusia apa yang tidak diketahuinya."},{"n":6,"w":[["كَلَّآ","sekali-kali tidak","kallā",362],["إِنَّ","sesungguhnya","inna",9],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["لَيَطْغَىٰٓ","benar-benar melampui batas","layaṭghā",740]],"t":"Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,"},{"n":7,"w":[["أَن","bahwa","an",22],["رَّءَاهُ","ia melihatnya","raāhu",54],["ٱسْتَغْنَىٰٓ","dia serba cukup","is'taghnā",1716]],"t":"apabila melihat dirinya serba cukup."},{"n":8,"w":[["إِنَّ","sesungguhnya","inna",9],["إِلَىٰ","kepada","ilā",18],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلرُّجْعَىٰٓ","tempat kembali","l-ruj'ʿā",4229]],"t":"Sungguh, hanya kepada Tuhanmulah tempat kembali(mu)."},{"n":9,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",54],["ٱلَّذِى","yang/orang-orang","alladhī",45],["يَنْهَىٰ","ia melarang","yanhā",372]],"t":"Bagaimana pendapatmu tentang orang yang melarang?"},{"n":10,"w":[["عَبْدًا","hamba","ʿabdan",99],["إِذَا","apabila","idhā",29],["صَلَّىٰٓ","sholat","ṣallā",739]],"t":"seorang hamba ketika dia melaksanakan salat,"},{"n":11,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",54],["إِن","jika","in",19],["كَانَ","adalah","kāna",12],["عَلَى","atas","ʿalā",11],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",143]],"t":"bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),"},{"n":12,"w":[["أَوْ","atau","aw",50],["أَمَرَ","dia menyuruh","amara",161],["بِٱلتَّقْوَىٰٓ","dengan taqwa","bil-taqwā",592]],"t":"atau dia menyuruh bertakwa (kepada Allah)?"},{"n":13,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",54],["إِن","jika","in",19],["كَذَّبَ","mendustakan","kadhaba",72],["وَتَوَلَّىٰٓ","dan dia berpaling","watawallā",160]],"t":"Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?"},{"n":14,"w":[["أَلَمْ","apakah tidak/tidaklah","alam",39],["يَعْلَم","dia mengetahui","yaʿlam",35],["بِأَنَّ","bahwa sesungguhnya","bi-anna",36],["ٱللَّهَ","Allah","l-laha",4],["يَرَىٰ","Dia melihat","yarā",54]],"t":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?"},{"n":15,"w":[["كَلَّا","sekali-kali tidak","kallā",362],["لَئِن","sungguh jika","la-in",19],["لَّمْ","tidak","lam",39],["يَنتَهِ","dia berhenti","yantahi",622],["لَنَسْفَعًۢا","niscaya kami pegang/tarik","lanasfaʿan",4258],["بِٱلنَّاصِيَةِ","dengan umbun-umbun","bil-nāṣiyati",1636]],"t":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),"},{"n":16,"w":[["نَاصِيَةٍۢ","umbun-umbun","nāṣiyatin",1636],["كَـٰذِبَةٍ","pendusta","kādhibatin",369],["خَاطِئَةٍۢ","salah/durhaka","khāṭi-atin",2748]],"t":"(yaitu) ubun-ubun orang yang mendustakan dan durhaka."},{"n":17,"w":[["فَلْيَدْعُ","maka hendaklah dia memanggil","falyadʿu",74],["نَادِيَهُۥ","kaum/golongannya","nādiyahu",2566]],"t":"Maka biarlah dia memanggil golongannya (untuk menolongnya),"},{"n":18,"w":[["سَنَدْعُ","kelak Kami memanggil","sanadʿu",74],["ٱلزَّبَانِيَةَ","Zabaniyah","l-zabāniyata",4606]],"t":"kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa)"},{"n":19,"w":[["كَلَّا","sekali-kali","kallā",362],["لَا","jangan","lā",8],["تُطِعْهُ","kamu patuh kepadanya","tuṭiʿ'hu",177],["وَٱسْجُدْ","dan sujudlah","wa-us'jud",350],["وَٱقْتَرِب ۩","dan dekatkanlah","wa-iq'tarib",1465]],"t":"sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah)."}]