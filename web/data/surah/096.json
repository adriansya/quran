[{"n":1,"w":[["ٱقْرَأْ","bacalah","iq'ra",600],["بِٱسْمِ","dengan nama","bi-is'mi",309],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",61]],"t":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,"},{"n":2,"w":[["خَلَقَ","menciptakan","khalaqa",61],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["مِنْ","dari","min",0],["عَلَقٍ","segumpal darah","ʿalaqin",3091]],"t":"Dia telah menciptakan manusia dari segumpal darah."},{"n":3,"w":[["ٱقْرَأْ","bacalah","iq'ra",600],["وَرَبُّكَ","dan Tuhanmu","warabbuka",10],["ٱلْأَكْرَمُ","amat mulia","l-akramu",2155]],"t":"Bacalah, dan Tuhanmulah Yang Mahamulia."},{"n":4,"w":[["ٱلَّذِى","yang","alladhī",7],["عَلَّمَ","Dia mengajar","ʿallama",284],["بِٱلْقَلَمِ","dengan kalam","bil-qalami",1630]],"t":"Yang mengajar (manusia) dengan pena."},{"n":5,"w":[["عَلَّمَ","Dia mengajarkan","ʿallama",284],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["مَا","apa","mā",2],["لَمْ","tidak","lam",32],["يَعْلَمْ","dia ketahui","yaʿlam",29]],"t":"Dia mengajarkan manusia apa yang tidak diketahuinya."},{"n":6,"w":[["كَلَّآ","sekali-kali tidak","kallā",347],["إِنَّ","sesungguhnya","inna",5],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["لَيَطْغَىٰٓ","benar-benar melampui batas","layaṭghā",725]],"t":"Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,"},{"n":7,"w":[["أَن","bahwa","an",17],["رَّءَاهُ","ia melihatnya","raāhu",46],["ٱسْتَغْنَىٰٓ","dia serba cukup","is'taghnā",1698]],"t":"apabila melihat dirinya serba cukup."},{"n":8,"w":[["إِنَّ","sesungguhnya","inna",5],["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلرُّجْعَىٰٓ","tempat kembali","l-ruj'ʿā",4211]],"t":"Sungguh, hanya kepada Tuhanmulah tempat kembali(mu)."},{"n":9,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",46],["ٱلَّذِى","yang/orang-orang","alladhī",7],["يَنْهَىٰ","ia melarang","yanhā",357]],"t":"Bagaimana pendapatmu tentang orang yang melarang?"},{"n":10,"w":[["عَبْدًا","hamba","ʿabdan",90],["إِذَا","apabila","idhā",23],["صَلَّىٰٓ","sholat","ṣallā",724]],"t":"seorang hamba ketika dia melaksanakan salat,"},{"n":11,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",46],["إِن","jika","in",14],["كَانَ","adalah","kāna",9],["عَلَى","atas","ʿalā",8],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",133]],"t":"bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),"},{"n":12,"w":[["أَوْ","atau","aw",42],["أَمَرَ","dia menyuruh","amara",150],["بِٱلتَّقْوَىٰٓ","dengan taqwa","bil-taqwā",578]],"t":"atau dia menyuruh bertakwa (kepada Allah)?"},{"n":13,"w":[["أَرَءَيْتَ","apakah kamu lihat/pendapatmu","ara-ayta",46],["إِن","jika","in",14],["كَذَّبَ","mendustakan","kadhaba",63],["وَتَوَلَّىٰٓ","dan dia berpaling","watawallā",149]],"t":"Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?"},{"n":14,"w":[["أَلَمْ","apakah tidak/tidaklah","alam",32],["يَعْلَم","dia mengetahui","yaʿlam",29],["بِأَنَّ","bahwa sesungguhnya","bi-anna",30],["ٱللَّهَ","Allah","l-laha",1],["يَرَىٰ","Dia melihat","yarā",46]],"t":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?"},{"n":15,"w":[["كَلَّا","sekali-kali tidak","kallā",347],["لَئِن","sungguh jika","la-in",14],["لَّمْ","tidak","lam",32],["يَنتَهِ","dia berhenti","yantahi",608],["لَنَسْفَعًۢا","niscaya kami pegang/tarik","lanasfaʿan",4240],["بِٱلنَّاصِيَةِ","dengan umbun-umbun","bil-nāṣiyati",1618]],"t":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),"},{"n":16,"w":[["نَاصِيَةٍۢ","umbun-umbun","nāṣiyatin",1618],["كَـٰذِبَةٍ","pendusta","kādhibatin",354],["خَاطِئَةٍۢ","salah/durhaka","khāṭi-atin",2730]],"t":"(yaitu) ubun-ubun orang yang mendustakan dan durhaka."},{"n":17,"w":[["فَلْيَدْعُ","maka hendaklah dia memanggil","falyadʿu",65],["نَادِيَهُۥ","kaum/golongannya","nādiyahu",2548]],"t":"Maka biarlah dia memanggil golongannya (untuk menolongnya),"},{"n":18,"w":[["سَنَدْعُ","kelak Kami memanggil","sanadʿu",65],["ٱلزَّبَانِيَةَ","Zabaniyah","l-zabāniyata",4588]],"t":"kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa)"},{"n":19,"w":[["كَلَّا","sekali-kali","kallā",347],["لَا","jangan","lā",4],["تُطِعْهُ","kamu patuh kepadanya","tuṭiʿ'hu",166],["وَٱسْجُدْ","dan sujudlah","wa-us'jud",335],["وَٱقْتَرِب ۩","dan dekatkanlah","wa-iq'tarib",1447]],"t":"sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah)."}]