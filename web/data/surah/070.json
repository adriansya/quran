اعَةًۭ","mencabut/mengelupas","nazzāʿatan",4060],["لِّلشَّوَىٰ","bagi kulit kepala","lilshawā",2872]],"t":"yang mengelupaskan kulit kepala."},{"n":17,"w":[["تَدْعُوا۟","ia memanggil","tadʿū",74],["مَنْ","orang","man",17],["أَدْبَرَ","dia membelakang","adbara",1485],["وَتَوَلَّىٰ","dan dia berpaling","watawallā",160]],"t":"Yang memanggil orang yang membelakangi dan yang berpaling (dari agama),"},{"n":18,"w":[["وَجَمَعَ","dan dia mengumpulkan","wajamaʿa",478],["فَأَوْعَىٰٓ","lalu dia menyimpannya","fa-awʿā",2196]],"t":"dan orang yang mengumpulkan (harta benda) lalu menyimpannya."},{"n":19,"w":[["۞ إِنَّ","sesungguhnya","inna",9],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["خُلِقَ","diciptakan","khuliqa",70],["هَلُوعًا","keluh-kesah/loba-kikir","halūʿan",3527]],"t":"Sungguh, manusia diciptakan bersifat suka mengeluh."},{"n":20,"w":[["إِذَا","apabila","idhā",29],["مَسَّهُ","menimpanya","massahu",227],["ٱلشَّرُّ","kejahatan/kesusahan","l-sharu",380],["جَزُوعًۭا","berkeluh-kesah","jazūʿan",3578]],"t":"Apabila dia ditimpa kesusahan dia berkeluh kesah,"},{"n":21,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["مَسَّهُ","menimpanya/mendapatkan","massahu",227],["ٱلْخَيْرُ","kebaikan","l-khayru",69],["مَنُوعًا","menahan/amat kikir","manūʿan",3734]],"t":"dan apabila mendapat kebaikan (harta) dia jadi kikir,"},{"n":22,"w":[["إِلَّا","kecuali","illā",20],["ٱلْمُصَلِّينَ","orang-orang yang menegakkan sholat","l-muṣalīna",1932]],"t":"kecuali orang-orang yang melaksanakan salat,"},{"n":23,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["هُمْ","mereka","hum",16],["عَلَىٰ","atas","ʿalā",11],["صَلَاتِهِمْ","sholat mereka","ṣalātihim",147],["دَآئِمُونَ","orang-orang yang menetapi","dāimūna",2356]],"t":"mereka yang tetap setia melaksanakan salatnya,"},{"n":24,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["فِىٓ","pada","fī",7],["أَمْوَٰلِهِمْ","harta mereka","amwālihim",141],["حَقٌّۭ","hak/bagian","ḥaqqun",58],["مَّعْلُومٌۭ","tertentu","maʿlūmun",706]],"t":"dan orang-orang yang dalam hartanya disiapkan bagian tertentu,"},{"n":25,"w":[["لِّلسَّآئِلِ","untuk orang yang meminta","lilssāili",1114],["وَٱلْمَحْرُومِ","dan orang yang kekurangan","wal-maḥrūmi",1600]],"t":"bagi orang (miskin) yang meminta dan yang tidak meminta,"},{"n":26,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["يُصَدِّقُونَ","membenarkan/mempercayai","yuṣaddiqūna",837],["بِيَوْمِ","dengan hari","biyawmi",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"dan orang-orang yang mempercayai hari pembalasan,"},{"n":27,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["هُم","mereka","hum",16],["مِّنْ","dari/terhadap","min",1],["عَذَابِ","azab","ʿadhābi",43],["رَبِّهِم","Tuhan mereka","rabbihim",15],["مُّشْفِقُونَ","orang-orang yang takut","mush'fiqūna",1002]],"t":"dan orang-orang yang takut terhadap azab Tuhannya,"},{"n":28,"w":[["إِنَّ","sesungguhnya","inna",9],["عَذَابَ","siksaan/azab","ʿadhāba",43],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["غَيْرُ","lain/tidak","ghayru",85],["مَأْمُونٍۢ","orang yang merasa aman","mamūnin",3669]],"t":"sesungguhnya terhadap azab Tuhan mereka, tidak ada seseorang yang merasa aman (dari kedatangannya),"},{"n":29,"w":[["وَٱلَّذِينَ","dan orang yang pergi","wa-alladhīna",13],["هُمْ","mereka","hum",16],["لِفُرُوجِهِمْ","bagi kemaluan mereka","lifurūjihim",989],["حَـٰفِظُونَ","orang-orang yang memelihara/menjaga","ḥāfiẓūna",630]],"t":"dan orang-orang yang memelihara kemaluannya,"},{"n":30,"w":[["إِلَّا","kecuali","illā",20],["عَلَىٰٓ","atas/terhadap","ʿalā",11],["أَزْوَٰجِهِمْ","isteri-isteri mereka","azwājihim",166],["أَوْ","atau","aw",50],["مَا","apa","mā",6],["مَلَكَتْ","yang dimiliki","malakat",282],["أَيْمَـٰنُهُمْ","tangan kanan mereka","aymānuhum",198],["فَإِنَّهُمْ","maka sesungguhnya mereka","fa-innahum",9],["غَيْرُ","bukan/tidak","ghayru",85],["مَلُومِينَ","tercela","malūmīna",1380]],"t":"kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki maka sesungguhnya mereka tidak tercela."},{"n":31,"w":[["فَمَنِ","maka barang siapa","famani",17],["ٱبْتَغَىٰ","mencari","ib'taghā",357],["وَرَآءَ","belakang/selain","warāa",457],["ذَٰلِكَ","demikian/itu","dhālika",26],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",65],["هُمُ","mereka","humu",16],["ٱلْعَادُونَ","orang-orang yang melampaui batas","l-ʿādūna",1057]],"t":"Maka barangsiapa mencari di luar itu (seperti zina, homoseks, dan lesbian), mereka itulah orang-orang yang melampaui batas."},{"n":32,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["هُمْ","mereka","hum",16],["لِأَمَـٰنَـٰتِهِمْ","bagi amanat mereka","li-amānātihim",1146],["وَعَهْدِهِمْ","dan janji mereka","waʿahdihim",391],["رَٰعُونَ","orang-orang yang memelihara","rāʿūna",2621]],"t":"Dan orang-orang yang memelihara amanat dan janjinya,"},{"n":33,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["هُم","mereka","hum",16],["بِشَهَـٰدَٰتِهِمْ","dengan kesaksian mereka","bishahādātihim",422],["قَآئِمُونَ","orang-orang yang menegakkan","qāimūna",484]],"t":"dan orang-orang yang berpegang teguh pada kesaksiannya,"},{"n":34,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["هُمْ","mereka","hum",16],["عَلَىٰ","atas","ʿalā",11],["صَلَاتِهِمْ","sholat mereka","ṣalātihim",147],["يُحَافِظُونَ","mereka memelihara/menjaga","yuḥāfiẓūna",1528]],"t":"dan orang-orang yang memelihara salatnya."},{"n":35,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["فِى","dalam","fī",7],["جَنَّـٰتٍۢ","sorga","jannātin",86],["مُّكْرَمُونَ","orang-orang yang dimuliakan","muk'ramūna",1400]],"t":"Mereka itu dimuliakan di dalam surga."},{"n":36,"w":[["فَمَالِ","maka mengapa","famāli",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["قِبَلَكَ","datang ke arahmu","qibalaka",1651],["مُهْطِعِينَ","bersegera","muh'ṭiʿīna",1936]],"t":"Maka mengapa orang-orang kafir itu datang bergegas ke hadapanmu (Muhammad),"},{"n":37,"w":[["عَنِ","dari","ʿani",27],["ٱلْيَمِينِ","kanan","l-yamīni",198],["وَعَنِ","dan dari","waʿani",27],["ٱلشِّمَالِ","kiri","l-shimāli",823],["عِزِينَ","berkelompok-kelompok","ʿizīna",3142]],"t":"dari kanan dan dari kiri dengan berkelompok-kelompok?"},{"n":38,"w":[["أَيَطْمَعُ","apakah ingin","ayaṭmaʿu",982],["كُلُّ","setiap","kullu",38],["ٱمْرِئٍۢ","seseorang","im'ri-in",1461],["مِّنْهُمْ","dari mereka","min'hum",1],["أَن","akan","an",22],["يُدْخَلَ","ia masuk","yud'khala",289],["جَنَّةَ","sorga","jannata",86],["نَعِيمٍۢ","penuh kenikmatan","naʿīmin",588]],"t":"Apakah setiap orang dari orang-orang kafir itu ingin masuk surga yang penuh kenikmatan?"},{"n":39,"w":[["كَلَّآ ۖ","sekali-kali tidak","kallā",362],["إِنَّا","sesungguhnya Kami","innā",9],["خَلَقْنَـٰهُم","Kami ciptakan mereka","khalaqnāhum",70],["مِّمَّا","dari apa","mimmā",1],["يَعْلَمُونَ","mereka ketahui","yaʿlamūna",35]],"t":"tidak mungkin! Sesungguhnya Kami menciptakan mereka dari apa yang mereka ketahui."},{"n":40,"w":[["فَلَآ","maka","falā",8],["أُقْسِمُ","Aku bersumpah","uq'simu",515],["بِرَبِّ","dengan Tuhan/pemelihara","birabbi",15],["ٱلْمَشَـٰرِقِ","timur","l-mashāriqi",799],["وَٱلْمَغَـٰرِبِ","dan barat","wal-maghāribi",856],["إِنَّا","sesungguhnya Kami","innā",9],["لَقَـٰدِرُونَ","sungguh Maha Kuasa","laqādirūna",682]],"t":"Maka Aku bersumpah demi Tuhan yang mengatur tempat-tempat terbit dan terbenamnya (matahari, bulan dan bintang), sungguh, Kami pasti mampu,"},{"n":41,"w":[["عَلَىٰٓ","atas","ʿalā",11],["أَن","untuk","an",22],["نُّبَدِّلَ","Kami mengganti","nubaddila",463],["خَيْرًۭا","lebih baik","khayran",69],["مِّنْهُمْ","dari mereka","min'hum",1],["وَمَا","dan tidaklah","wamā",6],["نَحْنُ","Kami","naḥnu",140],["بِمَسْبُوقِينَ","dengan dikalahkan","bimasbūqīna",2487]],"t":"untuk mengganti (mereka) dengan kaum yang lebih baik dari mereka, dan Kami tidak dapat dikalahkan."},{"n":42,"w":[["فَذَرْهُمْ","maka  biarkan mereka","fadharhum",276],["يَخُوضُوا۟","mereka tenggelam","yakhūḍū",954],["وَيَلْعَبُوا۟","dan mereka main-main","wayalʿabū",925],["حَتَّىٰ","sehingga","ḥattā",91],["يُلَـٰقُوا۟","mereka menemui","yulāqū",1897],["يَوْمَهُمُ","hari mereka","yawmahumu",31],["ٱلَّذِى","yang","alladhī",45],["يُوعَدُونَ","mereka dijanjikan","yūʿadūna",190]],"t":"Maka biarkanlah mereka tenggelam dan bermain-main (dalam kesesatan) sampai mereka menjumpai hari yang diancamkan kepada mereka,"},{"n":43,"w":[["يَوْمَ","pada hari","yawma",31],["يَخْرُجُونَ","mereka keluar","yakhrujūna",237],["مِنَ","dari","mina",1],["ٱلْأَجْدَاثِ","kubur","l-ajdāthi",1880],["سِرَاعًۭا","dengan cepat","sirāʿan",2669],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["إِلَىٰ","kepada","ilā",18],["نُصُبٍۢ","berhala-berhala","nuṣubin",1976],["يُوفِضُونَ","mereka pergi dengan segera","yūfiḍūna",3034]],"t":"(yaitu) pada hari ketika mereka keluar dari kubur dengan cepat seakan-akan mereka pergi dengan segera kepada berhala-berhala (sewaktu di dunia),"},{"n":44,"w":[["خَـٰشِعَةً","menundukkan","khāshiʿatan",684],["أَبْصَـٰرُهُمْ","pandangan mereka","abṣāruhum",260],["تَرْهَقُهُمْ","meliputi/menimpa mereka","tarhaquhum",1416],["ذِلَّةٌۭ ۚ","kerendahan/kehinaan","dhillatun",1041],["ذَٰلِكَ","demikian/itu","dhālika",26],["ٱلْيَوْمُ","hari","l-yawmu",31],["ٱلَّذِى","yang","alladhī",45],["كَانُوا۟","adalah mereka","kānū",12],["يُوعَدُونَ","mereka diancam/dijanjikan","yūʿadūna",190]],"t":"pandangan mereka tertunduk ke bawah diliputi kehinaan. Itulah hari yang diancamkan kepada mereka."}]