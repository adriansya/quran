[{"n":1,"w":[["سَأَلَ","bertanya","sa-ala",119],["سَآئِلٌۢ","seorang penanya","sāilun",1114],["بِعَذَابٍۢ","dengan/tentang azab","biʿadhābin",43],["وَاقِعٍۢ","jatuh/terjadi","wāqiʿin",1254]],"t":"Seseorang bertanya tentang azab yang pasti terjadi,"},{"n":2,"w":[["لِّلْكَـٰفِرِينَ","untuk orang-orang kafir","lil'kāfirīna",79],["لَيْسَ","tidak","laysa",133],["لَهُۥ","baginya","lahu",21],["دَافِعٌۭ","menolak","dāfiʿun",2357]],"t":"Bagi orang-orang kafir, yang tidak seorang pun dapat menolaknya,"},{"n":3,"w":[["مِّنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["ذِى","mempunyai","dhī",113],["ٱلْمَعَارِجِ","tempat-tempat naik","l-maʿāriji",2462]],"t":"(Azab) dari Allah, yang memiliki tempat-tempat naik."},{"n":4,"w":[["تَعْرُجُ","naik","taʿruju",1308],["ٱلْمَلَـٰٓئِكَةُ","Malaikat","l-malāikatu",137],["وَٱلرُّوحُ","dan Roh/Jibril","wal-rūḥu",507],["إِلَيْهِ","kepada-Nya","ilayhi",18],["فِى","dalam","fī",7],["يَوْمٍۢ","sehari","yawmin",31],["كَانَ","adalah","kāna",12],["مِقْدَارُهُۥ","ukurannya/kadarnya","miq'dāruhu",1927],["خَمْسِينَ","lima puluh","khamsīna",2764],["أَلْفَ","ribu","alfa",658],["سَنَةٍۢ","tahun","sanatin",545]],"t":"Para malaikat dan Jibril naik (menghadap) kepada Tuhan, dalam sehari setara dengan lima puluh ribu tahun."},{"n":5,"w":[["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",215],["صَبْرًۭا","kesabaran","ṣabran",633],["جَمِيلًا","bagus/baik","jamīlan",1089]],"t":"Maka bersabarlah engkau (Muhammad) dengan kesabaran yang baik."},{"n":6,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["يَرَوْنَهُۥ","mereka mamandangnya (azab)","yarawnahu",54],["بَعِيدًۭا","jauh","baʿīdan",438]],"t":"Mereka memandang (azab) itu jauh (mustahil)."},{"n":7,"w":[["وَنَرَىٰهُ","dan Kami memandangnya (azab)","wanarāhu",54],["قَرِيبًۭا","dekat","qarīban",429]],"t":"Sedang Kami memandangnya dekat (pasti terjadi)."},{"n":8,"w":[["يَوْمَ","pada hari","yawma",31],["تَكُونُ","adalah","takūnu",12],["ٱلسَّمَآءُ","langit","l-samāu",44],["كَٱلْمُهْلِ","seperti leburan perak","ka