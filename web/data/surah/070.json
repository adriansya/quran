[{"n":1,"w":[["سَأَلَ","bertanya","sa-ala",108],["سَآئِلٌۢ","seorang penanya","sāilun",1097],["بِعَذَابٍۢ","dengan/tentang azab","biʿadhābin",36],["وَاقِعٍۢ","jatuh/terjadi","wāqiʿin",1237]],"t":"Seseorang bertanya tentang azab yang pasti terjadi,"},{"n":2,"w":[["لِّلْكَـٰفِرِينَ","untuk orang-orang kafir","lil'kāfirīna",70],["لَيْسَ","tidak","laysa",123],["لَهُۥ","baginya","lahu",16],["دَافِعٌۭ","menolak","dāfiʿun",2340]],"t":"Bagi orang-orang kafir, yang tidak seorang pun dapat menolaknya,"},{"n":3,"w":[["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["ذِى","mempunyai","dhī",116],["ٱلْمَعَارِجِ","tempat-tempat naik","l-maʿāriji",2446]],"t":"(Azab) dari Allah, yang memiliki tempat-tempat naik."},{"n":4,"w":[["تَعْرُجُ","naik","taʿruju",1291],["ٱلْمَلَـٰٓئِكَةُ","Malaikat","l-malāikatu",127],["وَٱلرُّوحُ","dan Roh/Jibril","wal-rūḥu",492],["إِلَيْهِ","kepada-Nya","ilayhi",13],["فِى","dalam","fī",3],["يَوْمٍۢ","sehari","yawmin",25],["كَانَ","adalah","kāna",9],["مِقْدَارُهُۥ","ukurannya/kadarnya","miq'dāruhu",1910],["خَمْسِينَ","lima puluh","khamsīna",2748],["أَلْفَ","ribu","alfa",644],["سَنَةٍۢ","tahun","sanatin",531]],"t":"Para malaikat dan Jibril naik (menghadap) kepada Tuhan, dalam sehari setara dengan lima puluh ribu tahun."},{"n":5,"w":[["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",203],["صَبْرًۭا","kesabaran","ṣabran",619],["جَمِيلًا","bagus/baik","jamīlan",1072]],"t":"Maka bersabarlah engkau (Muhammad) dengan kesabaran yang baik."},{"n":6,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["يَرَوْنَهُۥ","mereka mamandangnya (azab)","yarawnahu",46],["بَعِيدًۭا","jauh","baʿīdan",423]],"t":"Mereka memandang (azab) itu jauh (mustahil)."},{"n":7,"w":[["وَنَرَىٰهُ","dan Kami memandangnya (azab)","wanarāhu",46],["قَرِيبًۭا","dekat","qarīban",414]],"t":"Sedang Kami memandangnya dekat (pasti terjadi)."},{"n":8,"w":[["يَوْمَ","pada hari","yawma",25],["تَكُونُ","adalah","takūnu",9],["ٱلسَّمَآءُ","langit","l-samāu",38],["كَٱلْمُهْلِ","seperti leburan perak","kal-muh'li",1920]],"t":"(Ingatlah) pada hari ketika langit menjadi bagaikan cairan tembaga,"},{"n":9,"w":[["وَتَكُونُ","dan adalah","watakūnu",9],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",305],["كَٱلْعِهْنِ","seperti bulu","kal-ʿih'ni",2234]],"t":"dan gunung-gunung bagaikan bulu (yang beterbangan),"},{"n":10,"w":[["وَلَا","dan tidak","walā",4],["يَسْـَٔلُ","menanyakan","yasalu",108],["حَمِيمٌ","teman akrab","ḥamīmun",503],["حَمِيمًۭا","teman akrab","ḥamīman",503]],"t":"dan tidak ada seorang teman karib pun menanyakan temannya,"},{"n":11,"w":[["يُبَصَّرُونَهُمْ ۚ","mereka saling melihat mereka","yubaṣṣarūnahum",3327],["يَوَدُّ","ingin","yawaddu",582],["ٱلْمُجْرِمُ","orang yang berdosa","l-muj'rimu",228],["لَوْ","sekiranya","law",57],["يَفْتَدِى","ia menebus","yaftadī",1116],["مِنْ","dari","min",0],["عَذَابِ","azab","ʿadhābi",36],["يَوْمِئِذٍۭ","pada hari itu","yawmi-idhin",180],["بِبَنِيهِ","dengan anak-anaknya","bibanīhi",81]],"t":"sedang mereka saling melihat. Pada hari itu, orang yang berdosa ingin sekiranya dia dapat menebus (dirinya) dari azab dengan anak-anaknya,"},{"n":12,"w":[["وَصَـٰحِبَتِهِۦ","dan isterinya","waṣāḥibatihi",1521],["وَأَخِيهِ","dan saudaranya","wa-akhīhi",142]],"t":"dan istrinya juga saudaranya,"},{"n":13,"w":[["وَفَصِيلَتِهِ","dan keluarganya","wafaṣīlatihi",3407],["ٱلَّتِى","yang","allatī",7],["تُـْٔوِيهِ","melindunginya","tu'wīhi",895]],"t":"dan keluarga yang melindunginya (di dunia),"},{"n":14,"w":[["وَمَن","dan orang","waman",12],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["جَمِيعًۭا","seluruhnya","jamīʿan",224],["ثُمَّ","kemudian","thumma",34],["يُنجِيهِ","ia menyelamatkannya","yunjīhi",447]],"t":"dan orang-orang di bumi seluruhnya, kemudian mengharapkan (tebusan) itu dapat menyelamatkannya."},{"n":15,"w":[["كَلَّآ ۖ","sekali-kali tidak","kallā",347],["إِنَّهَا","sesungguhnya ia","innahā",5],["لَظَىٰ","api yang menyala-nyala","laẓā",3617]],"t":"Sama sekali tidak! Sungguh, neraka itu api yang bergejolak,"},{"n":16,"w":[["نَزَّاعَةًۭ","mencabut/mengelupas","nazzāʿatan",4044],["لِّلشَّوَىٰ","bagi kulit kepala","lilshawā",2855]],"t":"yang mengelupaskan kulit kepala."},{"n":17,"w":[["تَدْعُوا۟","ia memanggil","tadʿū",65],["مَنْ","orang","man",12],["أَدْبَرَ","dia membelakang","adbara",1468],["وَتَوَلَّىٰ","dan dia berpaling","watawallā",149]],"t":"Yang memanggil orang yang membelakangi dan yang berpaling (dari agama),"},{"n":18,"w":[["وَجَمَعَ","dan dia mengumpulkan","wajamaʿa",464],["فَأَوْعَىٰٓ","lalu dia menyimpannya","fa-awʿā",2179]],"t":"dan orang yang mengumpulkan (harta benda) lalu menyimpannya."},{"n":19,"w":[["۞ إِنَّ","sesungguhnya","inna",5],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["خُلِقَ","diciptakan","khuliqa",61],["هَلُوعًا","keluh-kesah/loba-kikir","halūʿan",3511]],"t":"Sungguh, manusia diciptakan bersifat suka mengeluh."},{"n":20,"w":[["إِذَا","apabila","idhā",23],["مَسَّهُ","menimpanya","massahu",215],["ٱلشَّرُّ","kejahatan/kesusahan","l-sharu",365],["جَزُوعًۭا","berkeluh-kesah","jazūʿan",3562]],"t":"Apabila dia ditimpa kesusahan dia berkeluh kesah,"},{"n":21,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["مَسَّهُ","menimpanya/mendapatkan","massahu",215],["ٱلْخَيْرُ","kebaikan","l-khayru",60],["مَنُوعًا","menahan/amat kikir","manūʿan",3718]],"t":"dan apabila mendapat kebaikan (harta) dia jadi kikir,"},{"n":22,"w":[["إِلَّا","kecuali","illā",15],["ٱلْمُصَلِّينَ","orang-orang yang menegakkan sholat","l-muṣalīna",1915]],"t":"kecuali orang-orang yang melaksanakan salat,"},{"n":23,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["هُمْ","mereka","hum",11],["عَلَىٰ","atas","ʿalā",8],["صَلَاتِهِمْ","sholat mereka","ṣalātihim",137],["دَآئِمُونَ","orang-orang yang menetapi","dāimūna",2339]],"t":"mereka yang tetap setia melaksanakan salatnya,"},{"n":24,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["فِىٓ","pada","fī",3],["أَمْوَٰلِهِمْ","harta mereka","amwālihim",131],["حَقٌّۭ","hak/bagian","ḥaqqun",50],["مَّعْلُومٌۭ","tertentu","maʿlūmun",692]],"t":"dan orang-orang yang dalam hartanya disiapkan bagian tertentu,"},{"n":25,"w":[["لِّلسَّآئِلِ","untuk orang yang meminta","lilssāili",1097],["وَٱلْمَحْرُومِ","dan orang yang kekurangan","wal-maḥrūmi",1583]],"t":"bagi orang (miskin) yang meminta dan yang tidak meminta,"},{"n":26,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["يُصَدِّقُونَ","membenarkan/mempercayai","yuṣaddiqūna",822],["بِيَوْمِ","dengan hari","biyawmi",25],["ٱلدِّينِ","pembalasan","l-dīni",120]],"t":"dan orang-orang yang mempercayai hari pembalasan,"},{"n":27,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["هُم","mereka","hum",11],["مِّنْ","dari/terhadap","min",0],["عَذَابِ","azab","ʿadhābi",36],["رَبِّهِم","Tuhan mereka","rabbihim",10],["مُّشْفِقُونَ","orang-orang yang takut","mush'fiqūna",985]],"t":"dan orang-orang yang takut terhadap azab Tuhannya,"},{"n":28,"w":[["إِنَّ","sesungguhnya","inna",5],["عَذَابَ","siksaan/azab","ʿadhāba",36],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["غَيْرُ","lain/tidak","ghayru",76],["مَأْمُونٍۢ","orang yang merasa aman","mamūnin",3653]],"t":"sesungguhnya terhadap azab Tuhan mereka, tidak ada seseorang yang merasa aman (dari kedatangannya),"},{"n":29,"w":[["وَٱلَّذِينَ","dan orang yang pergi","wa-alladhīna",7],["هُمْ","mereka","hum",11],["لِفُرُوجِهِمْ","bagi kemaluan mereka","lifurūjihim",972],["حَـٰفِظُونَ","orang-orang yang memelihara/menjaga","ḥāfiẓūna",616]],"t":"dan orang-orang yang memelihara kemaluannya,"},{"n":30,"w":[["إِلَّا","kecuali","illā",15],["عَلَىٰٓ","atas/terhadap","ʿalā",8],["أَزْوَٰجِهِمْ","isteri-isteri mereka","azwājihim",155],["أَوْ","atau","aw",42],["مَا","apa","mā",2],["مَلَكَتْ","yang dimiliki","malakat",268],["أَيْمَـٰنُهُمْ","tangan kanan mereka","aymānuhum",186],["فَإِنَّهُمْ","maka sesungguhnya mereka","fa-innahum",5],["غَيْرُ","bukan/tidak","ghayru",76],["مَلُومِينَ","tercela","malūmīna",1363]],"t":"kecuali terhadap istri-istri mereka atau hamba sahaya yang mereka miliki maka sesungguhnya mereka tidak tercela."},{"n":31,"w":[["فَمَنِ","maka barang siapa","famani",12],["ٱبْتَغَىٰ","mencari","ib'taghā",342],["وَرَآءَ","belakang/selain","warāa",442],["ذَٰلِكَ","demikian/itu","dhālika",19],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",56],["هُمُ","mereka","humu",11],["ٱلْعَادُونَ","orang-orang yang melampaui batas","l-ʿādūna",1040]],"t":"Maka barangsiapa mencari di luar itu (seperti zina, homoseks, dan lesbian), mereka itulah orang-orang yang melampaui batas."},{"n":32,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["هُمْ","mereka","hum",11],["لِأَمَـٰنَـٰتِهِمْ","bagi amanat mereka","li-amānātihim",1129],["وَعَهْدِهِمْ","dan janji mereka","waʿahdihim",376],["رَٰعُونَ","orang-orang yang memelihara","rāʿūna",2605]],"t":"Dan orang-orang yang memelihara amanat dan janjinya,"},{"n":33,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["هُم","mereka","hum",11],["بِشَهَـٰدَٰتِهِمْ","dengan kesaksian mereka","bishahādātihim",407],["قَآئِمُونَ","orang-orang yang menegakkan","qāimūna",469]],"t":"dan orang-orang yang berpegang teguh pada kesaksiannya,"},{"n":34,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["هُمْ","mereka","hum",11],["عَلَىٰ","atas","ʿalā",8],["صَلَاتِهِمْ","sholat mereka","ṣalātihim",137],["يُحَافِظُونَ","mereka memelihara/menjaga","yuḥāfiẓūna",1511]],"t":"dan orang-orang yang memelihara salatnya."},{"n":35,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","sorga","jannātin",77],["مُّكْرَمُونَ","orang-orang yang dimuliakan","muk'ramūna",1383]],"t":"Mereka itu dimuliakan di dalam surga."},{"n":36,"w":[["فَمَالِ","maka mengapa","famāli",2],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["قِبَلَكَ","datang ke arahmu","qibalaka",1634],["مُهْطِعِينَ","bersegera","muh'ṭiʿīna",1919]],"t":"Maka mengapa orang-orang kafir itu datang bergegas ke hadapanmu (Muhammad),"},{"n":37,"w":[["عَنِ","dari","ʿani",21],["ٱلْيَمِينِ","kanan","l-yamīni",186],["وَعَنِ","dan dari","waʿani",21],["ٱلشِّمَالِ","kiri","l-shimāli",809],["عِزِينَ","berkelompok-kelompok","ʿizīna",3126]],"t":"dari kanan dan dari kiri dengan berkelompok-kelompok?"},{"n":38,"w":[["أَيَطْمَعُ","apakah ingin","ayaṭmaʿu",965],["كُلُّ","setiap","kullu",31],["ٱمْرِئٍۢ","seseorang","im'ri-in",1444],["مِّنْهُمْ","dari mereka","min'hum",0],["أَن","akan","an",17],["يُدْخَلَ","ia masuk","yud'khala",275],["جَنَّةَ","sorga","jannata",77],["نَعِيمٍۢ","penuh kenikmatan","naʿīmin",574]],"t":"Apakah setiap orang dari orang-orang kafir itu ingin masuk surga yang penuh kenikmatan?"},{"n":39,"w":[["كَلَّآ ۖ","sekali-kali tidak","kallā",347],["إِنَّا","sesungguhnya Kami","innā",5],["خَلَقْنَـٰهُم","Kami ciptakan mereka","khalaqnāhum",61],["مِّمَّا","dari apa","mimmā",0],["يَعْلَمُونَ","mereka ketahui","yaʿlamūna",29]],"t":"tidak mungkin! Sesungguhnya Kami menciptakan mereka dari apa yang mereka ketahui."},{"n":40,"w":[["فَلَآ","maka","falā",4],["أُقْسِمُ","Aku bersumpah","uq'simu",500],["بِرَبِّ","dengan Tuhan/pemelihara","birabbi",10],["ٱلْمَشَـٰرِقِ","timur","l-mashāriqi",785],["وَٱلْمَغَـٰرِبِ","dan barat","wal-maghāribi",841],["إِنَّا","sesungguhnya Kami","innā",5],["لَقَـٰدِرُونَ","sungguh Maha Kuasa","laqādirūna",668]],"t":"Maka Aku bersumpah demi Tuhan yang mengatur tempat-tempat terbit dan terbenamnya (matahari, bulan dan bintang), sungguh, Kami pasti mampu,"},{"n":41,"w":[["عَلَىٰٓ","atas","ʿalā",8],["أَن","untuk","an",17],["نُّبَدِّلَ","Kami mengganti","nubaddila",449],["خَيْرًۭا","lebih baik","khayran",60],["مِّنْهُمْ","dari mereka","min'hum",0],["وَمَا","dan tidaklah","wamā",2],["نَحْنُ","Kami","naḥnu",130],["بِمَسْبُوقِينَ","dengan dikalahkan","bimasbūqīna",2471]],"t":"untuk mengganti (mereka) dengan kaum yang lebih baik dari mereka, dan Kami tidak dapat dikalahkan."},{"n":42,"w":[["فَذَرْهُمْ","maka  biarkan mereka","fadharhum",262],["يَخُوضُوا۟","mereka tenggelam","yakhūḍū",937],["وَيَلْعَبُوا۟","dan mereka main-main","wayalʿabū",908],["حَتَّىٰ","sehingga","ḥattā",82],["يُلَـٰقُوا۟","mereka menemui","yulāqū",1880],["يَوْمَهُمُ","hari mereka","yawmahumu",25],["ٱلَّذِى","yang","alladhī",7],["يُوعَدُونَ","mereka dijanjikan","yūʿadūna",179]],"t":"Maka biarkanlah mereka tenggelam dan bermain-main (dalam kesesatan) sampai mereka menjumpai hari yang diancamkan kepada mereka,"},{"n":43,"w":[["يَوْمَ","pada hari","yawma",25],["يَخْرُجُونَ","mereka keluar","yakhrujūna",225],["مِنَ","dari","mina",0],["ٱلْأَجْدَاثِ","kubur","l-ajdāthi",1863],["سِرَاعًۭا","dengan cepat","sirāʿan",2653],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",380],["إِلَىٰ","kepada","ilā",13],["نُصُبٍۢ","berhala-berhala","nuṣubin",1959],["يُوفِضُونَ","mereka pergi dengan segera","yūfiḍūna",3018]],"t":"(yaitu) pada hari ketika mereka keluar dari kubur dengan cepat seakan-akan mereka pergi dengan segera kepada berhala-berhala (sewaktu di dunia),"},{"n":44,"w":[["خَـٰشِعَةً","menundukkan","khāshiʿatan",670],["أَبْصَـٰرُهُمْ","pandangan mereka","abṣāruhum",248],["تَرْهَقُهُمْ","meliputi/menimpa mereka","tarhaquhum",1399],["ذِلَّةٌۭ ۚ","kerendahan/kehinaan","dhillatun",1024],["ذَٰلِكَ","demikian/itu","dhālika",19],["ٱلْيَوْمُ","hari","l-yawmu",25],["ٱلَّذِى","yang","alladhī",7],["كَانُوا۟","adalah mereka","kānū",9],["يُوعَدُونَ","mereka diancam/dijanjikan","yūʿadūna",179]],"t":"pandangan mereka tertunduk ke bawah diliputi kehinaan. Itulah hari yang diancamkan kepada mereka."}]