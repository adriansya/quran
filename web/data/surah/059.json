[{"n":1,"w":[["سَبَّحَ","bertasbih/mensucikan","sabbaḥa",283],["لِلَّهِ","kepada Allah","lillahi",1],["مَا","apa","mā",2],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَمَا","dan apa","wamā",2],["فِى","pada","fī",3],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",22],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Apa yang ada di langit dan apa yang ada di bumi bertasbih kepada Allah; dan Dialah Yang Mahaperkasa, Mahabijaksana."},{"n":2,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِىٓ","yang","alladhī",38],["أَخْرَجَ","mengeluarkan","akhraja",115],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِنْ","dari","min",0],["أَهْلِ","ahli","ahli",94],["ٱلْكِتَـٰبِ","kitab","l-kitābi",49],["مِن","dari","min",0],["دِيَـٰرِهِمْ","rumah/kampung mereka","diyārihim",251],["لِأَوَّلِ","pada yang pertama","li-awwali",142],["ٱلْحَشْرِ ۚ","pengusiran","l-ḥashri",2251],["مَا","tidak","mā",2],["ظَنَنتُمْ","menyangka","ẓanantum",254],["أَن","bahwa","an",17],["يَخْرُجُوا۟ ۖ","mereka akan keluar","yakhrujū",227],["وَظَنُّوٓا۟","dan menyangka","waẓannū",254],["أَنَّهُم","sesungguhnya mereka","annahum",30],["مَّانِعَتُهُمْ","mencegah/mempertahankan mereka","māniʿatuhum",3911],["حُصُونُهُم","benteng-benteng mereka","ḥuṣūnuhum",3203],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["فَأَتَىٰهُمُ","maka mendatangkan pada mereka","fa-atāhumu",48],["ٱللَّهُ","Allah","l-lahu",1],["مِنْ","dari","min",0],["حَيْثُ","arah","ḥaythu",383],["لَمْ","tidak","lam",32],["يَحْتَسِبُوا۟ ۖ","mengira","yaḥtasibū",2079],["وَقَذَفَ","dan (Allah) mencampakkan","waqadhafa",925],["فِى","pada","fī",3],["قُلُوبِهِمُ","hati mereka","qulūbihimu",90],["ٱلرُّعْبَ ۚ","ketakutan","l-ruʿ'ba",1409],["يُخْرِبُونَ","mereka meruntuhkan/memusnahkan","yukh'ribūna",3033],["بُيُوتَهُم","rumah-rumah mereka","buyūtahum",186],["بِأَيْدِيهِمْ","dengan tangan mereka","bi-aydīhim",102],["وَأَيْدِى","dengan tangan","wa-aydī",102],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55],["فَٱعْتَبِرُوا۟","maka ambillah pelajaran","fa-iʿ'tabirū",4600],["يَـٰٓأُو۟لِى","wahai orang-orang","yāulī",262],["ٱلْأَبْصَـٰرِ","yang mempunyai pandangan!","l-abṣāri",250]],"t":"Dialah yang mengeluarkan orang-orang kafir di antara Ahli Kitab dari kampung halamannya pada saat pengusiran yang pertama. Kamu tidak menyangka, bahwa mereka akan keluar dan mereka pun yakin, benteng-benteng mereka akan dapat mempertahankan mereka dari (siksaan) Allah; maka Allah mendatangkan (siksaan) kepada mereka dari arah yang tidak mereka sangka-sangka. Dan Allah menanamkan rasa takut ke dalam hati mereka; sehingga mereka memusnahkan rumah-rumah mereka dengan tangannya sendiri dan tangan orang-orang mukmin. Maka ambillah (kejadian itu) untuk menjadi pelajaran, wahai orang-orang yang mempunyai pandangan!"},{"n":3,"w":[["وَلَوْلَآ","dan jika tidak","walawlā",157],["أَن","bahwa","an",17],["كَتَبَ","telah menetapkan","kataba",245],["ٱللَّهُ","Allah","l-lahu",1],["عَلَيْهِمُ","atas mereka","ʿalayhimu",7],["ٱلْجَلَآءَ","pengusiran","l-jalāa",3549],["لَعَذَّبَهُمْ","pasti (Allah) mengazab mereka","laʿadhabahum",287],["فِى","pada","fī",3],["ٱلدُّنْيَا ۖ","dunia","l-dun'yā",105],["وَلَهُمْ","dan mereka","walahum",11],["فِى","pada","fī",3],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",74],["عَذَابُ","azab","ʿadhābu",36],["ٱلنَّارِ","neraka","l-nāri",79]],"t":"Dan sekiranya tidak karena Allah telah menetapkan pengusiran terhadap mereka, pasti Allah mengazab mereka di dunia. Dan di akhirat mereka akan mendapat azab neraka."},{"n":4,"w":[["ذَٰلِكَ","demikian itu","dhālika",20],["بِأَنَّهُمْ","karena sesungguhnya mereka","bi-annahum",30],["شَآقُّوا۟","mereka menentang","shāqqū",1027],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ ۖ","dan rasul-Nya","warasūlahu",35],["وَمَن","dan siapa","waman",12],["يُشَآقِّ","menentang","yushāqqi",1027],["ٱللَّهَ","Allah","l-laha",1],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["شَدِيدُ","sangat/keras","shadīdu",215],["ٱلْعِقَابِ","siksaan/hukuman","l-ʿiqābi",508]],"t":"Yang demikian itu karena sesungguhnya mereka menentang Allah dan Rasul-Nya. Barangsiapa menentang Allah, maka sesungguhnya Allah sangat keras hukuman-Nya."},{"n":5,"w":[["مَا","apa-apa","mā",2],["قَطَعْتُم","kamu potong/tebang","qaṭaʿtum",746],["مِّن","dari","min",0],["لِّينَةٍ","pohon kurma","līnatin",3648],["أَوْ","atau","aw",42],["تَرَكْتُمُوهَا","kamu tinggalkannya","taraktumūhā",298],["قَآئِمَةً","berdiri","qāimatan",475],["عَلَىٰٓ","atas","ʿalā",7],["أُصُولِهَا","pokoknya/batangnya","uṣūlihā",1732],["فَبِإِذْنِ","maka dengan izin","fabi-idh'ni",306],["ٱللَّهِ","Allah","l-lahi",1],["وَلِيُخْزِىَ","dan Dia hendak menghinakan","waliyukh'ziya",719],["ٱلْفَـٰسِقِينَ","orang-orang fasik","l-fāsiqīna",324]],"t":"Apa yang kamu tebang di antara pohon kurma (milik orang-orang kafir) atau yang kamu biarkan (tumbuh) berdiri di atas pokoknya, maka (itu terjadi) dengan izin Allah; dan karena Dia hendak memberikan kehinaan kepada orang-orang fasik."},{"n":6,"w":[["وَمَآ","dan apa-apa","wamā",2],["أَفَآءَ","memberikan","afāa",1736],["ٱللَّهُ","Allah","l-lahu",1],["عَلَىٰ","atas","ʿalā",7],["رَسُولِهِۦ","rasul-Nya","rasūlihi",35],["مِنْهُمْ","dari mereka","min'hum",0],["فَمَآ","maka tidak","famā",2],["أَوْجَفْتُمْ","kamu mengerahkan","awjaftum",3025],["عَلَيْهِ","atasnya","ʿalayhi",7],["مِنْ","dari","min",0],["خَيْلٍۢ","seekor kuda","khaylin",1438],["وَلَا","dan tidak","walā",4],["رِكَابٍۢ","tunggangan","rikābin",4190],["وَلَـٰكِنَّ","akan tetapi","walākinna",210],["ٱللَّهَ","Allah","l-laha",1],["يُسَلِّطُ","memberikan kekuasaan","yusalliṭu",2644],["رُسُلَهُۥ","rasul-Nya","rusulahu",35],["عَلَىٰ","atas","ʿalā",7],["مَن","siapa","man",12],["يَشَآءُ ۚ","sesuatu","yashāu",54],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha Kuasa","qadīrun",265]],"t":"Dan harta rampasan fai` dari mereka yang diberikan Allah kepada Rasul-Nya, kamu tidak memerlukan kuda atau unta untuk mendapatkannya, tetapi Allah memberikan kekuasaan kepada rasul-rasul-Nya terhadap siapa yang Dia kehendaki. Dan Allah Mahakuasa atas segala sesuatu."},{"n":7,"w":[["مَّآ","apa","mā",2],["أَفَآءَ","yang memberikan","afāa",1736],["ٱللَّهُ","Allah","l-lahu",1],["عَلَىٰ","atas","ʿalā",7],["رَسُولِهِۦ","rasul-Nya","rasūlihi",35],["مِنْ","dari","min",0],["أَهْلِ","ahli/penduduk","ahli",94],["ٱلْقُرَىٰ","negri/kota","l-qurā",212],["فَلِلَّهِ","maka untuk Allah","falillahi",1],["وَلِلرَّسُولِ","dan untuk rasul-Nya","walilrrasūli",35],["وَلِذِى","dan yang memiliki","walidhī",117],["ٱلْقُرْبَىٰ","hubungan kerabat","l-qur'bā",606],["وَٱلْيَتَـٰمَىٰ","dan untuk anak yatim","wal-yatāmā",462],["وَٱلْمَسَـٰكِينِ","dan orang-orang miskin","wal-masākīni",458],["وَٱبْنِ","dan orang-orang","wa-ib'ni",82],["ٱلسَّبِيلِ","dalam perjalanan","l-sabīli",65],["كَىْ","supaya","kay",841],["لَا","jangan","lā",4],["يَكُونَ","adalah ia (harta)","yakūna",8],["دُولَةًۢ","beredar","dūlatan",3400],["بَيْنَ","diantara","bayna",47],["ٱلْأَغْنِيَآءِ","orang-orang kaya","l-aghniyāi",443],["مِنكُمْ ۚ","diantara kamu","minkum",0],["وَمَآ","dan tidak","wamā",2],["ءَاتَىٰكُمُ","yang diberikan kepadamu","ātākumu",45],["ٱلرَّسُولُ","rasul","l-rasūlu",35],["فَخُذُوهُ","maka ambilah ia","fakhudhūhu",95],["وَمَا","dan apa","wamā",2],["نَهَىٰكُمْ","yang melarang kamu","nahākum",362],["عَنْهُ","dari padanya","ʿanhu",21],["فَٱنتَهُوا۟ ۚ","maka hentikan/tinggalkan","fa-intahū",613],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",68],["ٱللَّهَ ۖ","Allah","l-laha",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["شَدِيدُ","sangat/keras","shadīdu",215],["ٱلْعِقَابِ","siksaan/hukuman","l-ʿiqābi",508]],"t":"Harta rampasan fai` yang diberikan Allah kepada Rasul-Nya (yang berasal) dari penduduk beberapa negeri, adalah untuk Allah, Rasul, kerabat (Rasul), anak-anak yatim, orang-orang miskin dan untuk orang-orang yang dalam perjalanan, agar harta itu jangan hanya beredar di antara orang-orang kaya saja di antara kamu. Apa yang diberikan Rasul kepadamu maka terimalah. Dan apa yang dilarangnya bagimu maka tinggalkanlah. Dan bertakwalah kepada Allah. Sungguh, Allah sangat keras hukuman-Nya."},{"n":8,"w":[["لِلْفُقَرَآءِ","bagi orang-orang fakir","lil'fuqarāi",735],["ٱلْمُهَـٰجِرِينَ","orang-orang yang berhijrah","l-muhājirīna",995],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["أُخْرِجُوا۟","(mereka) diusir","ukh'rijū",115],["مِن","dari","min",0],["دِيَـٰرِهِمْ","rumah-rumah/kampung mereka","diyārihim",251],["وَأَمْوَٰلِهِمْ","dan harta mereka","wa-amwālihim",132],["يَبْتَغُونَ","mereka mencari","yabtaghūna",347],["فَضْلًۭا","karunia","faḍlan",136],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["وَرِضْوَٰنًۭا","dan keridaan","wariḍ'wānan",701],["وَيَنصُرُونَ","dan mereka menolong","wayanṣurūna",202],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥٓ ۚ","dan rasul-Nya","warasūlahu",35],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["هُمُ","mereka","humu",11],["ٱلصَّـٰدِقُونَ","orang-orang yang benar","l-ṣādiqūna",201]],"t":"(Harta rampasan itu juga) untuk orang-orang fakir yang berhijrah yang terusir dari kampung halamannya dan meninggalkan harta bendanya demi mencari karunia dari Allah dan keridaan(-Nya) dan (demi) menolong (agama) Allah dan Rasul-Nya. Mereka itulah orang-orang yang benar."},{"n":9,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["تَبَوَّءُو","(mereka)menempati","tabawwaū",1667],["ٱلدَّارَ","rumah/kampung (kota)","l-dāra",251],["وَٱلْإِيمَـٰنَ","dan keimanan","wal-īmāna",261],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["يُحِبُّونَ","dan mereka mencintai","yuḥibbūna",190],["مَنْ","orang-orang","man",12],["هَاجَرَ","hijrah/pindah","hājara",599],["إِلَيْهِمْ","kepada mereka","ilayhim",13],["وَلَا","dan tidak","walā",4],["يَجِدُونَ","mendapati/menaruh","yajidūna",110],["فِى","pada","fī",3],["صُدُورِهِمْ","dada mereka","ṣudūrihim",271],["حَاجَةًۭ","hajat/keinginan","ḥājatan",1789],["مِّمَّآ","terhadap apa","mimmā",0],["أُوتُوا۟","mereka diberi","ūtū",45],["وَيُؤْثِرُونَ","dan mereka mengutamakan","wayu'thirūna",1271],["عَلَىٰٓ","atas","ʿalā",7],["أَنفُسِهِمْ","diri mereka sendiri","anfusihim",39],["وَلَوْ","walaupun","walaw",58],["كَانَ","adalah","kāna",8],["بِهِمْ","mereka","bihim",11],["خَصَاصَةٌۭ ۚ","kepapaan/kesusahan","khaṣāṣatun",4519],["وَمَن","dan barang siapa","waman",12],["يُوقَ","dipelihara","yūqa",610],["شُحَّ","kekikiran","shuḥḥa",1268],["نَفْسِهِۦ","dirinya","nafsihi",39],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",57],["هُمُ","mereka","humu",11],["ٱلْمُفْلِحُونَ","orang-orang yang beruntung","l-muf'liḥūna",696]],"t":"Dan orang-orang (Ansar) yang telah menempati kota Madinah dan telah beriman sebelum (kedatangan) mereka (Muhajirin), mereka mencintai orang yang berhijrah ke tempat mereka. Dan mereka tidak menaruh keinginan dalam hati mereka terhadap apa yang diberikan kepada mereka (Muhajirin); dan mereka mengutamakan (Muhajirin), atas dirinya sendiri, meskipun mereka juga memerlukan. Dan siapa yang dijaga dirinya dari kekikiran, maka mereka itulah orang-orang yang beruntung."},{"n":10,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["جَآءُو","(mereka) datang","jāū",43],["مِنۢ","dari","min",0],["بَعْدِهِمْ","sesudah mereka","baʿdihim",59],["يَقُولُونَ","mereka berkata","yaqūlūna",6],["رَبَّنَا","ya Tuhan kami","rabbanā",10],["ٱغْفِرْ","ampunilah","igh'fir",187],["لَنَا","bagi kami","lanā",126],["وَلِإِخْوَٰنِنَا","dan bagi saudara-saudara kami","wali-ikh'wāninā",143],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["سَبَقُونَا","(mereka) mendahului kami","sabaqūnā",521],["بِٱلْإِيمَـٰنِ","dengan beriman","bil-īmāni",261],["وَلَا","dan tidak","walā",4],["تَجْعَلْ","Engkau jadikan","tajʿal",33],["فِى","dalam","fī",3],["قُلُوبِنَا","hati kami","qulūbinā",90],["غِلًّۭا","kedengkian","ghillan",909],["لِّلَّذِينَ","kepada orang-orang","lilladhīna",9],["ءَامَنُوا۟","yang beriman","āmanū",18],["رَبَّنَآ","ya Tuhan kami","rabbanā",10],["إِنَّكَ","sesungguhnya Engkau","innaka",5],["رَءُوفٌۭ","Maha Penyantun","raūfun",803],["رَّحِيمٌ","Maha Penyayang","raḥīmun",104]],"t":"Dan orang-orang yang datang sesudah mereka (Muhajirin dan Ansar), mereka berdoa, \"Ya Tuhan kami, ampunilah kami dan saudara-saudara kami yang telah beriman lebih dahulu dari kami, dan janganlah Engkau tanamkan kedengkian dalam hati kami terhadap orang-orang yang beriman. Ya Tuhan kami, sungguh, Engkau Maha Penyantun, Maha Penyayang.\""},{"n":11,"w":[["۞ أَلَمْ","tidaklah","alam",32],["تَرَ","kamu memperhatikan","tara",46],["إِلَى","kepada","ilā",13],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["نَافَقُوا۟","(mereka) munafik","nāfaqū",2555],["يَقُولُونَ","mereka berkata","yaqūlūna",6],["لِإِخْوَٰنِهِمُ","kepada saudara-saudara mereka","li-ikh'wānihimu",143],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِنْ","dari","min",0],["أَهْلِ","ahli","ahli",94],["ٱلْكِتَـٰبِ","kitab","l-kitābi",49],["لَئِنْ","sungguh jika","la-in",14],["أُخْرِجْتُمْ","kamu diusir","ukh'rij'tum",115],["لَنَخْرُجَنَّ","niscaya kami akan keluar","lanakhrujanna",227],["مَعَكُمْ","bersamamu","maʿakum",70],["وَلَا","dan tidak","walā",4],["نُطِيعُ","kami taat/patuh","nuṭīʿu",167],["فِيكُمْ","pada/untuk kamu","fīkum",3],["أَحَدًا","seseorang/siapapun","aḥadan",160],["أَبَدًۭا","selama-lamanya","abadan",390],["وَإِن","dan jika","wa-in",14],["قُوتِلْتُمْ","kamu di perangi","qūtil'tum",224],["لَنَنصُرَنَّكُمْ","niscaya kami akan membantu kamu","lananṣurannakum",202],["وَٱللَّهُ","dan Allah","wal-lahu",1],["يَشْهَدُ","menyaksikan","yashhadu",268],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["لَكَـٰذِبُونَ","benar-benar pendusta","lakādhibūna",359]],"t":"Tidakkah engkau memperhatikan orang-orang munafik yang berkata kepada saudara-saudaranya yang kafir di antara Ahli Kitab, \"Sungguh, jika kamu diusir niscaya kami pun akan keluar bersama kamu; dan kami selama-lamanya tidak akan patuh kepada siapa pun demi kamu, dan jika kamu diperangi pasti kami akan membantumu.\" Dan Allah menyaksikan, bahwa mereka benar-benar pendusta."},{"n":12,"w":[["لَئِنْ","sungguh jika","la-in",14],["أُخْرِجُوا۟","mereka diusir","ukh'rijū",115],["لَا","tidak","lā",4],["يَخْرُجُونَ","keluar","yakhrujūna",227],["مَعَهُمْ","bersama mereka","maʿahum",70],["وَلَئِن","dan sungguh jika","wala-in",14],["قُوتِلُوا۟","mereka diperangi","qūtilū",224],["لَا","tidak","lā",4],["يَنصُرُونَهُمْ","menolong mereka","yanṣurūnahum",202],["وَلَئِن","dan sungguh jika","wala-in",14],["نَّصَرُوهُمْ","mereka menolongnya","naṣarūhum",202],["لَيُوَلُّنَّ","niscaya mereka berpaling","layuwallunna",379],["ٱلْأَدْبَـٰرَ","belakang","l-adbāra",551],["ثُمَّ","kemudian","thumma",34],["لَا","tidak","lā",4],["يُنصَرُونَ","ditolong","yunṣarūna",202]],"t":"Sungguh, jika mereka diusir, orang-orang munafik itu tidak akan keluar bersama mereka, dan jika mereka diperangi; mereka (juga) tidak akan menolongnya; dan kalau pun mereka menolongnya pastilah mereka akan berpaling lari ke belakang, kemudian mereka tidak akan mendapat pertolongan."},{"n":13,"w":[["لَأَنتُمْ","sungguh kamu","la-antum",88],["أَشَدُّ","sangat/lebih","ashaddu",366],["رَهْبَةًۭ","ketakutan/ditakuti","rahbatan",4166],["فِى","dalam","fī",3],["صُدُورِهِم","dada mereka","ṣudūrihim",271],["مِّنَ","dari","mina",0],["ٱللَّهِ ۚ","Allah","l-lahi",1],["ذَٰلِكَ","demikian itu","dhālika",20],["بِأَنَّهُمْ","sesungguhnya mereka","bi-annahum",30],["قَوْمٌۭ","kaum","qawmun",27],["لَّا","tidak","lā",4],["يَفْقَهُونَ","mengerti","yafqahūna",530]],"t":"Sesungguhnya dalam hati mereka, kamu (muslimin) lebih ditakuti daripada Allah. Yang demikian itu karena mereka orang-orang yang tidak mengerti."},{"n":14,"w":[["لَا","tidak","lā",4],["يُقَـٰتِلُونَكُمْ","mereka memerangi kamu","yuqātilūnakum",224],["جَمِيعًا","semuanya/bersatu","jamīʿan",226],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["قُرًۭى","kampung-kampung","quran",212],["مُّحَصَّنَةٍ","berbenteng","muḥaṣṣanatin",3955],["أَوْ","atau","aw",42],["مِن","dari","min",0],["وَرَآءِ","belakang","warāi",447],["جُدُرٍۭ ۚ","tembok","judurin",1875],["بَأْسُهُم","kekuatan/permungsuhan mereka","basuhum",427],["بَيْنَهُمْ","diantara mereka","baynahum",47],["شَدِيدٌۭ ۚ","sangat/keras","shadīdun",215],["تَحْسَبُهُمْ","kamu mengira","taḥsabuhum",270],["جَمِيعًۭا","semuanya/bersatu","jamīʿan",226],["وَقُلُوبُهُمْ","dan hati mereka","waqulūbuhum",90],["شَتَّىٰ ۚ","pecah-belah","shattā",1708],["ذَٰلِكَ","demikian itu","dhālika",20],["بِأَنَّهُمْ","sesungguhnya mereka","bi-annahum",30],["قَوْمٌۭ","kaum","qawmun",27],["لَّا","tidak","lā",4],["يَعْقِلُونَ","mereka menggunakan akal","yaʿqilūna",243]],"t":"Mereka tidak akan memerangi kamu (secara) bersama-sama, kecuali di negeri-negeri yang berbenteng atau di balik tembok. Permusuhan antara sesama mereka sangat hebat. Kamu kira mereka itu bersatu padahal hati mereka terpecah belah. Yang demikian itu karena mereka orang-orang yang tidak mengerti."},{"n":15,"w":[["كَمَثَلِ","seperti/perumpamaan","kamathali",129],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["قَرِيبًۭا ۖ","dekat/belum lama","qarīban",419],["ذَاقُوا۟","mereka merasakan","dhāqū",329],["وَبَالَ","kejahatan/akibat buruk","wabāla",1681],["أَمْرِهِمْ","urusan/perbuatan mereka","amrihim",67],["وَلَهُمْ","dan bagi mereka","walahum",11],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",168]],"t":"(Mereka) seperti orang-orang yang sebelum mereka (Yahudi) belum lama berselang, telah merasakan akibat buruk (terusir) disebabkan perbuatan mereka sendiri. Dan mereka akan mendapat azab yang pedih."},{"n":16,"w":[["كَمَثَلِ","seperti/perumpamaan","kamathali",129],["ٱلشَّيْطَـٰنِ","syaitan","l-shayṭāni",125],["إِذْ","ketika","idh",53],["قَالَ","dia berkata","qāla",6],["لِلْإِنسَـٰنِ","kepada manusia","lil'insāni",171],["ٱكْفُرْ","kafirlah kamu","uk'fur",40],["فَلَمَّا","maka tatkala","falammā",73],["كَفَرَ","(manusia) kafir","kafara",40],["قَالَ","dia berkata","qāla",6],["إِنِّى","sesungguhnya aku","innī",5],["بَرِىٓءٌۭ","berlepas diri","barīon",733],["مِّنكَ","dari kamu","minka",0],["إِنِّىٓ","sesungguhnya aku","innī",5],["أَخَافُ","takut","akhāfu",141],["ٱللَّهَ","Allah","l-laha",1],["رَبَّ","Tuhan/Pemlihara","rabba",10],["ٱلْعَـٰلَمِينَ","Alam semesta","l-ʿālamīna",164]],"t":"(Bujukan orang-orang munafik itu) seperti (bujukan) setan ketika ia berkata kepada manusia, \"Kafirlah kamu!\" Kemudian setelah manusia itu menjadi kafir ia berkata, \"Sesungguhnya aku berlepas diri dari kamu, karena sesungguhnya aku takut kepada Allah, Tuhan seluruh alam.\""},{"n":17,"w":[["فَكَانَ","maka adalah","fakāna",8],["عَـٰقِبَتَهُمَآ","akibat/kesudahan keduanya","ʿāqibatahumā",357],["أَنَّهُمَا","bahwasanya keduanya","annahumā",30],["فِى","pada/dalam","fī",3],["ٱلنَّارِ","neraka","l-nāri",79],["خَـٰلِدَيْنِ","mereka kekal","khālidayni",163],["فِيهَا ۚ","di dalamnya","fīhā",3],["وَذَٰلِكَ","dan demikian itu","wadhālika",20],["جَزَٰٓؤُا۟","balasan","jazāu",280],["ٱلظَّـٰلِمِينَ","orang-orang zalim","l-ẓālimīna",89]],"t":"Maka kesudahan bagi keduanya, bahwa keduanya masuk ke dalam neraka, kekal di dalamnya. Demikianlah balasan bagi orang-orang zalim."},{"n":18,"w":[["يَـٰٓأَيُّهَا","hai","yāayyuhā",75],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","yang beriman","āmanū",18],["ٱتَّقُوا۟","bertakwalah","ittaqū",68],["ٱللَّهَ","Allah","l-laha",1],["وَلْتَنظُرْ","dan hendaklah memperhatikan","waltanẓur",130],["نَفْسٌۭ","jiwa/diri/seseorang","nafsun",39],["مَّا","apa","mā",2],["قَدَّمَتْ","yang ia telah perbuat","qaddamat",408],["لِغَدٍۢ ۖ","untuk hari esok","lighadin",1343],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",68],["ٱللَّهَ ۚ","Allah","l-laha",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["خَبِيرٌۢ","Maha Mengetahui","khabīrun",267],["بِمَا","terhadap apa-apa","bimā",2],["تَعْمَلُونَ","kamu mengerjakan","taʿmalūna",44]],"t":"Wahai orang-orang yang beriman! Bertakwalah kepada Allah dan hendaklah setiap orang memperhatikan apa yang telah diperbuatnya untuk hari esok (akhirat), dan bertakwalah kepada Allah. Sungguh, Allah Mahateliti terhadap apa yang kamu kerjakan."},{"n":19,"w":[["وَلَا","dan janganlah","walā",4],["تَكُونُوا۟","kalian menjadi","takūnū",8],["كَٱلَّذِينَ","seperti orang-orang","ka-alladhīna",9],["نَسُوا۟","(mereka) lupa","nasū",339],["ٱللَّهَ","Allah","l-laha",1],["فَأَنسَىٰهُمْ","lalu (Allah) menjadikan mereka lupa","fa-ansāhum",1039],["أَنفُسَهُمْ ۚ","diri mereka","anfusahum",39],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["هُمُ","mereka","humu",11],["ٱلْفَـٰسِقُونَ","orang-orang yang fasik","l-fāsiqūna",324]],"t":"Dan janganlah kamu seperti orang-orang yang lupa kepada Allah, sehingga Allah menjadikan mereka lupa akan diri sendiri. Mereka itulah orang-orang fasik."},{"n":20,"w":[["لَا","tidak","lā",4],["يَسْتَوِىٓ","sama","yastawī",341],["أَصْحَـٰبُ","penghuni","aṣḥābu",123],["ٱلنَّارِ","api/neraka","l-nāri",79],["وَأَصْحَـٰبُ","dan penghuni","wa-aṣḥābu",123],["ٱلْجَنَّةِ ۚ","surga","l-janati",78],["أَصْحَـٰبُ","penghuni","aṣḥābu",123],["ٱلْجَنَّةِ","surga","l-janati",78],["هُمُ","mereka","humu",11],["ٱلْفَآئِزُونَ","orang-orang yang beruntung","l-fāizūna",1558]],"t":"Tidak sama para penghuni neraka dengan para penghuni surga; para penghuni surga itulah orang-orang yang memperoleh kemenangan."},{"n":21,"w":[["لَوْ","sekiranya","law",58],["أَنزَلْنَا","Kami turunkan","anzalnā",63],["هَـٰذَا","ini","hādhā",56],["ٱلْقُرْءَانَ","Al-Quran","l-qur'āna",179],["عَلَىٰ","atas","ʿalā",7],["جَبَلٍۢ","gunung","jabalin",310],["لَّرَأَيْتَهُۥ","melihatnya","lara-aytahu",46],["خَـٰشِعًۭا","tunduk","khāshiʿan",675],["مُّتَصَدِّعًۭا","terpecah/terbelah","mutaṣaddiʿan",3991],["مِّنْ","dari","min",0],["خَشْيَةِ","takut","khashyati",1012],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَتِلْكَ","dan itulah","watil'ka",300],["ٱلْأَمْثَـٰلُ","perumpamaan-perumpamaan","l-amthālu",129],["نَضْرِبُهَا","Kami buatnya","naḍribuhā",220],["لِلنَّاسِ","untuk manusia","lilnnāsi",52],["لَعَلَّهُمْ","supaya mereka","laʿallahum",93],["يَتَفَكَّرُونَ","berfikir","yatafakkarūna",582]],"t":"Sekiranya Kami turunkan Alquran ini kepada sebuah gunung, pasti kamu akan melihatnya tunduk terpecah belah disebabkan takut kepada Allah. Dan perumpamaan-perumpamaan itu Kami buat untuk manusia agar mereka berpikir."},{"n":22,"w":[["هُوَ","Dia","huwa",19],["ٱللَّهُ","Allah","l-lahu",1],["ٱلَّذِى","yang","alladhī",38],["لَآ","tidak","lā",4],["إِلَـٰهَ","tuhan","ilāha",76],["إِلَّا","kecuali","illā",15],["هُوَ ۖ","Dia","huwa",19],["عَـٰلِمُ","mengetahui","ʿālimu",548],["ٱلْغَيْبِ","yang ghaib/tersembunyi","l-ghaybi",244],["وَٱلشَّهَـٰدَةِ ۖ","dan yang terang/nampak","wal-shahādati",412],["هُوَ","Dia","huwa",19],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",214],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",104]],"t":"Dialah Allah, tidak ada tuhan selain Dia. Mengetahui yang gaib dan yang nyata, Dialah Yang Maha Pengasih, Maha Penyayang."},{"n":23,"w":[["هُوَ","Dia","huwa",19],["ٱللَّهُ","Allah","l-lahu",1],["ٱلَّذِى","yang","alladhī",38],["لَآ","tidak","lā",4],["إِلَـٰهَ","tuhan","ilāha",76],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",19],["ٱلْمَلِكُ","Raja","l-maliku",633],["ٱلْقُدُّوسُ","Maha Suci","l-qudūsu",2599],["ٱلسَّلَـٰمُ","Maha Sejahtera","l-salāmu",284],["ٱلْمُؤْمِنُ","Yang Mengaruniai Kemanan","l-mu'minu",55],["ٱلْمُهَيْمِنُ","Yang Mengawal/Maha Pemelihara","l-muhayminu",2502],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْجَبَّارُ","Maha Kuasa","l-jabāru",839],["ٱلْمُتَكَبِّرُ ۚ","yang Memiliki segala Kebesaran","l-mutakabiru",1090],["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",293],["ٱللَّهِ","Allah","l-lahi",1],["عَمَّا","dari apa","ʿammā",21],["يُشْرِكُونَ","mereka persekutukan","yush'rikūna",172]],"t":"Dialah Allah, tidak ada tuhan selain Dia. Maha Raja Yang Mahasuci, Yang Mahasejahtera, Yang Menjaga Keamanan, Pemelihara Keselamatan, Yang Mahaperkasa, Yang Mahakuasa, Yang Memiliki Segala Keagungan. Mahasuci Allah dari apa yang mereka persekutukan."},{"n":24,"w":[["هُوَ","Dia","huwa",19],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْخَـٰلِقُ","Yang Menciptakan","l-khāliqu",754],["ٱلْبَارِئُ","Yang Mengadakan","l-bāri-u",1820],["ٱلْمُصَوِّرُ ۖ","Yang Membentuk rupa","l-muṣawiru",3797],["لَهُ","bagi-Nya","lahu",16],["ٱلْأَسْمَآءُ","nama-nama","l-asmāu",314],["ٱلْحُسْنَىٰ ۚ","yang baik","l-ḥus'nā",570],["يُسَبِّحُ","bertasbih","yusabbiḥu",283],["لَهُۥ","kepada-Nya","lahu",16],["مَا","apa","mā",2],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Dialah Allah Yang Menciptakan, Yang Mengadakan, Yang Membentuk Rupa, Dia memiliki nama-nama yang indah. Apa yang di langit dan di bumi bertasbih kepada-Nya. Dan Dialah Yang Mahaperkasa, Mahabijaksana."}]