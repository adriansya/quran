[{"n":1,"w":[["ٱلْحَمْدُ","segala puji","al-ḥamdu",276],["لِلَّهِ","bagi Allah","lillahi",1],["ٱلَّذِى","yang","alladhī",38],["لَهُۥ","bagi-Nya-lah/memiliki","lahu",16],["مَا","apa","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَمَا","dan apa","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْحَمْدُ","segala puji","l-ḥamdu",276],["فِى","di","fī",3],["ٱلْـَٔاخِرَةِ ۚ","akhirat","l-ākhirati",74],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116],["ٱلْخَبِيرُ","Maha Mengetahui","l-khabīru",267]],"t":"Segala puji bagi Allah yang memiliki apa yang ada di langit dan apa yang ada di bumi dan segala puji di akhirat bagi Allah. Dan Dialah Yang Mahabijaksana, Mahateliti."},{"n":2,"w":[["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["مَا","apa","mā",2],["يَلِجُ","yang masuk","yaliju",2044],["فِى","dalam","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَمَا","dan apa","wamā",2],["يَخْرُجُ","yang keluar","yakhruju",227],["مِنْهَا","dari padanya","min'hā",0],["وَمَا","dan apa","wamā",2],["يَنزِلُ","yang turun","yanzilu",1216],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["وَمَا","dan apa","wamā",2],["يَعْرُجُ","yang naik","yaʿruju",1297],["فِيهَا ۚ","di dalamnya","fīhā",3],["وَهُوَ","dan Dia","wahuwa",19],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",104],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",122]],"t":"Dia mengetahui apa yang masuk ke dalam bumi, apa yang keluar darinya, apa yang turun dari langit dan apa yang naik kepadanya. Dan Dialah Yang Maha Penyayang, Maha Pengampun."},{"n":3,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَا","tidak","lā",4],["تَأْتِينَا","akan datang pada kami","tatīnā",48],["ٱلسَّاعَةُ ۖ","hari kiamat","l-sāʿatu",253],["قُلْ","katakanlah","qul",6],["بَلَىٰ","ya","balā",466],["وَرَبِّى","demi Tuhanku","warabbī",10],["لَتَأْتِيَنَّكُمْ","pasti ia akan datang kepadamu","latatiyannakum",48],["عَـٰلِمِ","Yang mengetahui","ʿālimi",548],["ٱلْغَيْبِ ۖ","yang ghaib","l-ghaybi",244],["لَا","tidak","lā",4],["يَعْزُبُ","tersembunyi","yaʿzubu",2238],["عَنْهُ","dari pada-Nya","ʿanhu",21],["مِثْقَالُ","seberat","mith'qālu",989],["ذَرَّةٍۢ","bagian terkecil/atom","dharratin",1130],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَلَا","dan tidak","walā",4],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَآ","dan tidak","walā",4],["أَصْغَرُ","yang lebih kecil","aṣgharu",2144],["مِن","dari","min",0],["ذَٰلِكَ","demikian itu","dhālika",20],["وَلَآ","dan tidak","walā",4],["أَكْبَرُ","yang lebih besar","akbaru",437],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["كِتَـٰبٍۢ","kitab","kitābin",49],["مُّبِينٍۢ","yang nyata","mubīnin",103]],"t":"Dan orang-orang yang kafir berkata, \"Hari Kiamat itu tidak akan datang kepada kami.\" Katakanlah, \"Pasti datang, demi Tuhanku Yang mengetahui yang gaib, Kiamat itu pasti akan datang kepadamu. Tidak ada yang tersembunyi bagi-Nya sekalipun seberat zarahbaik yang di langit maupun yang di bumi, yang lebih kecil dari itu atau yang lebih besar, semuanya (tertulis) dalam Kitab yang jelas (Lauḥ Maḥfūẓ),\""},{"n":4,"w":[["لِّيَجْزِىَ","karena Dia akan memberi balasan","liyajziya",165],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka mengerjakan/beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ ۚ","kebajikan/saleh","l-ṣāliḥāti",96],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["لَهُم","bagi mereka","lahum",11],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",396],["وَرِزْقٌۭ","dan rizki","wariz'qun",221],["كَرِيمٌۭ","yang mulia","karīmun",373]],"t":"agar Dia (Allah) memberi balasan kepada orang-orang yang beriman dan mengerjakan kebajikan. Mereka memperoleh ampunan dan rezeki yang mulia (surga)."},{"n":5,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["سَعَوْ","(mereka) berusaha","saʿaw",520],["فِىٓ","pada","fī",3],["ءَايَـٰتِنَا","ayat-ayat Kami","āyātinā",28],["مُعَـٰجِزِينَ","melemahkan/menentang","muʿājizīna",1920],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["مِّن","dari","min",0],["رِّجْزٍ","kotor/buruk","rij'zin",931],["أَلِيمٌۭ","sangat pedih","alīmun",168]],"t":"Dan orang-orang yang berusaha untuk (menentang) ayat-ayat Kami dengan anggapan mereka dapat melemahkan (menggagalkan azab Kami), mereka itu akan memperoleh azab, yaitu azab yang sangat pedih."},{"n":6,"w":[["وَيَرَى","dan melihat/berpendapat","wayarā",46],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْعِلْمَ","ilmu","l-ʿil'ma",112],["ٱلَّذِىٓ","yang","alladhī",38],["أُنزِلَ","diturunkan","unzila",63],["إِلَيْكَ","kepadamu","ilayka",13],["مِن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["هُوَ","ia/itulah","huwa",19],["ٱلْحَقَّ","benar","l-ḥaqa",50],["وَيَهْدِىٓ","dan ia memberi petunjuk","wayahdī",81],["إِلَىٰ","kepada","ilā",13],["صِرَٰطِ","jalan","ṣirāṭi",264],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",114],["ٱلْحَمِيدِ","Maha Terpuji","l-ḥamīdi",568]],"t":"Dan orang-orang yang diberi ilmu (Ahli Kitab) berpendapat bahwa (wahyu) yang diturunkan kepadamu (Muhammad) dari Tuhanmu itulah yang benar dan memberi petunjuk (bagi manusia) kepada jalan (Allah) Yang Mahaperkasa, Maha Terpuji."},{"n":7,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["هَلْ","apakah/maukah","hal",119],["نَدُلُّكُمْ","kami tunjukkan padamu","nadullukum",1069],["عَلَىٰ","atas","ʿalā",7],["رَجُلٍۢ","seorang laki-laki","rajulin",213],["يُنَبِّئُكُمْ","ia akan menjelaskan kepadamu","yunabbi-ukum",260],["إِذَا","apabila","idhā",23],["مُزِّقْتُمْ","kamu (badanmu) hancur","muzziq'tum",2484],["كُلَّ","setiap","kulla",31],["مُمَزَّقٍ","sehancur-hancurnya","mumazzaqin",2506],["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["لَفِى","sungguh dalam","lafī",3],["خَلْقٍۢ","ciptaan","khalqin",231],["جَدِيدٍ","baru","jadīdin",982]],"t":"Dan orang-orang kafir berkata (kepada teman-temannya), \"Maukah kami tunjukkan kepadamu seorang laki-laki yang memberitakan kepadamu bahwa apabila badanmu telah hancur sehancur-hancurnya, kamu pasti (akan dibangkitkan kembali) dalam ciptaan yang baru."},{"n":8,"w":[["أَفْتَرَىٰ","apakah dia mengada-adakan","aftarā",237],["عَلَى","atas","ʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["كَذِبًا","kebohongan","kadhiban",351],["أَم","ataukah","am",85],["بِهِۦ","dengannya/padanya","bihi",16],["جِنَّةٌۢ ۗ","penyakit gila","jinnatun",840],["بَلِ","bahkan/tetapi","bali",97],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["لَا","tidak","lā",4],["يُؤْمِنُونَ","beriman","yu'minūna",18],["بِٱلْـَٔاخِرَةِ","kepada akhirat","bil-ākhirati",74],["فِى","dalam","fī",3],["ٱلْعَذَابِ","siksaan","l-ʿadhābi",36],["وَٱلضَّلَـٰلِ","dan kesesatan","wal-ḍalāli",315],["ٱلْبَعِيدِ","jauh","l-baʿīdi",428]],"t":"Apakah dia mengada-adakan kebohongan terhadap Allah atau sakit gila?\" (Tidak), tetapi orang-orang yang tidak beriman kepada akhirat itu berada dalam siksaan dan kesesatan yang jauh."},{"n":9,"w":[["أَفَلَمْ","apakah maka tidak","afalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["إِلَىٰ","pada","ilā",13],["مَا","apa","mā",2],["بَيْنَ","diantara","bayna",47],["أَيْدِيهِمْ","hadapan mereka","aydīhim",102],["وَمَا","dan apa","wamā",2],["خَلْفَهُم","di belakang mereka","khalfahum",482],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["إِن","jika","in",14],["نَّشَأْ","Kami kehendaki","nasha",54],["نَخْسِفْ","Kami benamkan","nakhsif",1014],["بِهِمُ","dengan mereka","bihimu",11],["ٱلْأَرْضَ","bumi","l-arḍa",22],["أَوْ","atau","aw",42],["نُسْقِطْ","Kami jatuhkan","nus'qiṭ",1755],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["كِسَفًۭا","potong/gumpalan","kisafan",1584],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ ۚ","langit","l-samāi",37],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","demikian itu","dhālika",20],["لَـَٔايَةًۭ","benar-benar tanda-tanda","laāyatan",28],["لِّكُلِّ","bagi setiap","likulli",31],["عَبْدٍۢ","hamba","ʿabdin",91],["مُّنِيبٍۢ","kembali","munībin",1093]],"t":"Maka apakah mereka tidak memperhatikan langit dan bumi yang ada di hadapan dan di belakang mereka? Jika Kami menghendaki, niscaya Kami benamkan mereka di bumi atau Kami jatuhkan kepada mereka kepingan-kepingan dari langit. Sungguh, pada yang demikian itu benar-benar terdapat tanda (kekuasaan Allah) bagi setiap hamba yang kembali (kepada-Nya)."},{"n":10,"w":[["۞ وَلَقَدْ","dan sesungguhnya","walaqad",24],["ءَاتَيْنَا","Kami telah berikan","ātaynā",45],["دَاوُۥدَ","Daud","dāwūda",595],["مِنَّا","dari Kami","minnā",0],["فَضْلًۭا ۖ","karunia","faḍlan",136],["يَـٰجِبَالُ","wahai gunung-gunung","yājibālu",310],["أَوِّبِى","kembalilah/bertaubatlah kepada-Ku","awwibī",3032],["مَعَهُۥ","bersamanya (Daud)1","maʿahu",70],["وَٱلطَّيْرَ ۖ","dan burung-burung","wal-ṭayra",529],["وَأَلَنَّا","dan Kami telah melunakkan","wa-alannā",2975],["لَهُ","untuknya","lahu",16],["ٱلْحَدِيدَ","besi","l-ḥadīda",1157]],"t":"Dan sungguh, Telah Kami berikan kepada Dawud karunia dari Kami. (Kami berfirman), \"Wahai gunung-gunung dan burung-burung! Bertasbihlah berulang-ulang bersama Dawud,\" dan Kami telah melunakkan besi untuknya,"},{"n":11,"w":[["أَنِ","agar","ani",17],["ٱعْمَلْ","buatlah","iʿ'mal",44],["سَـٰبِغَـٰتٍۢ","baju besi","sābighātin",4241],["وَقَدِّرْ","besar","waqaddir",604],["فِى","dalam","fī",3],["ٱلسَّرْدِ ۖ","tenunan/anyaman","l-sardi",4298],["وَٱعْمَلُوا۟","dan kerjakanlah/beramallah","wa-iʿ'malū",44],["صَـٰلِحًا ۖ","kebajikan/saleh","ṣāliḥan",96],["إِنِّى","sesungguhnya Aku","innī",5],["بِمَا","dengan/tentang apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["بَصِيرٌۭ","melihat","baṣīrun",234]],"t":"(yaitu) buatlah baju besi yang besar-besar dan ukurlah anyamannya; dan kerjakanlah kebajikan. Sungguh, Aku Maha Melihat apa yang kamu kerjakan."},{"n":12,"w":[["وَلِسُلَيْمَـٰنَ","dan untuk Sulaiman","walisulaymāna",580],["ٱلرِّيحَ","angin","l-rīḥa",387],["غُدُوُّهَا","perjalanannya di waktu pagi","ghuduwwuhā",1347],["شَهْرٌۭ","sebulan","shahrun",484],["وَرَوَاحُهَا","dan perjalanan di waktu petangnya","warawāḥuhā",4185],["شَهْرٌۭ ۖ","sebulan","shahrun",484],["وَأَسَلْنَا","dan Kami alirkan","wa-asalnā",3005],["لَهُۥ","untuknya","lahu",16],["عَيْنَ","sumber/mata air","ʿayna",208],["ٱلْقِطْرِ ۖ","leburan/cairan tembaga","l-qiṭ'ri",2594],["وَمِنَ","dan dari sebagian","wamina",0],["ٱلْجِنِّ","jin","l-jini",470],["مَن","orang/jin","man",12],["يَعْمَلُ","ia bekerja","yaʿmalu",44],["بَيْنَ","diantara","bayna",47],["يَدَيْهِ","hadapannya","yadayhi",102],["بِإِذْنِ","dengan izin","bi-idh'ni",306],["رَبِّهِۦ ۖ","Tuhannya","rabbihi",10],["وَمَن","dan barang siapa","waman",12],["يَزِغْ","berpaling/menyimpang","yazigh",1256],["مِنْهُمْ","diantara mereka","min'hum",0],["عَنْ","dari","ʿan",21],["أَمْرِنَا","perintah Kami","amrinā",67],["نُذِقْهُ","Kami rasakannya","nudhiq'hu",463],["مِنْ","dari","min",0],["عَذَابِ","azab","ʿadhābi",36],["ٱلسَّعِيرِ","api yang menyala-nyala","l-saʿīri",608]],"t":"Dan Kami (tundukkan) angin bagi Sulaiman, yang perjalanannya pada waktu pagi sama dengan perjalanan sebulan dan perjalanannya pada waktu sore sama dengan perjalanan sebulan (pula) dan Kami alirkan cairan tembaga baginya. Dan sebagian dari jin ada yang bekerja di hadapannya (di bawah kekuasaannya) dengan izin Tuhannya. Dan siapa yang menyimpang di antara mereka dari perintah Kami, Kami rasakan kepadanya azab neraka yang apinya menyala-nyala."},{"n":13,"w":[["يَعْمَلُونَ","mereka bekerja","yaʿmalūna",44],["لَهُۥ","untuknya (Sulaiman)","lahu",16],["مَا","apa","mā",2],["يَشَآءُ","yang dikehendaki","yashāu",54],["مِن","dari","min",0],["مَّحَـٰرِيبَ","gedung-gedung yang tinggi","maḥārība",1373],["وَتَمَـٰثِيلَ","dan patung-patung","watamāthīla",2704],["وَجِفَانٍۢ","dan pinggan-pinggan","wajifānin",3548],["كَٱلْجَوَابِ","seperti kolam","kal-jawābi",3534],["وَقُدُورٍۢ","dan periuk-periuk","waqudūrin",4129],["رَّاسِيَـٰتٍ ۚ","tidak bergerak","rāsiyātin",859],["ٱعْمَلُوٓا۟","bekerjalah","iʿ'malū",44],["ءَالَ","(hai) keluarga","āla",413],["دَاوُۥدَ","Daud","dāwūda",595],["شُكْرًۭا ۚ","bersyukur","shuk'ran",2855],["وَقَلِيلٌۭ","dan sedikit","waqalīlun",176],["مِّنْ","dari","min",0],["عِبَادِىَ","hamba-hamba-Ku","ʿibādiya",91],["ٱلشَّكُورُ","bersyukur","l-shakūru",813]],"t":"Mereka (para jin itu) bekerja untuk Sulaiman sesuai dengan apa yang dikehendakinya di antaranya (membuat) gedung-gedung yang tinggi, patung-patung, piring-piring yang (besarnya) seperti kolam dan periuk-periuk yang tetap (berada di atas tungku). Bekerjalah wahai keluarga Dawud untuk bersyukur (kepada Allah). Dan sedikit sekali dari hamba-hamba-Ku yang bersyukur."},{"n":14,"w":[["فَلَمَّا","maka tatkala","falammā",73],["قَضَيْنَا","Kami telah menetapkan","qaḍaynā",204],["عَلَيْهِ","atasnya (Sulaiman)","ʿalayhi",7],["ٱلْمَوْتَ","kematian","l-mawta",239],["مَا","tidak ada","mā",2],["دَلَّهُمْ","menunjukkan kepada mereka","dallahum",1069],["عَلَىٰ","atas","ʿalā",7],["مَوْتِهِۦٓ","kematiannya","mawtihi",239],["إِلَّا","kecuali","illā",15],["دَآبَّةُ","binatang merayap","dābbatu",549],["ٱلْأَرْضِ","bumi","l-arḍi",22],["تَأْكُلُ","memakan","takulu",118],["مِنسَأَتَهُۥ ۖ","tongkatnya","minsa-atahu",3770],["فَلَمَّا","maka tatkala","falammā",73],["خَرَّ","dia tersungkur","kharra",755],["تَبَيَّنَتِ","menjadi jelas/nyata","tabayyanati",559],["ٱلْجِنُّ","jin","l-jinu",470],["أَن","bahwa","an",17],["لَّوْ","sekiranya","law",58],["كَانُوا۟","adalah mereka","kānū",8],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29],["ٱلْغَيْبَ","gaib","l-ghayba",244],["مَا","tidak","mā",2],["لَبِثُوا۟","mereka tetap","labithū",374],["فِى","dalam","fī",3],["ٱلْعَذَابِ","siksa","l-ʿadhābi",36],["ٱلْمُهِينِ","menghinakan","l-muhīni",671]],"t":"Maka ketika Kami telah menetapkan kematian atasnya (Sulaiman), tidak ada yang menunjukkan kepada mereka kematiannya itu kecuali rayap yang memakan tongkatnya. Maka ketika dia telah tersungkur, tahulah jin itu bahwa sekiranya mereka mengetahui hal yang gaib tentu mereka tidak menetap dalam siksa yang menghinakan."},{"n":15,"w":[["لَقَدْ","sesungguhnya","laqad",24],["كَانَ","adalah","kāna",8],["لِسَبَإٍۢ","bagi kaum Saba","lisaba-in",2635],["فِى","di","fī",3],["مَسْكَنِهِمْ","tempat kediaman mereka","maskanihim",741],["ءَايَةٌۭ ۖ","tanda-tanda","āyatun",28],["جَنَّتَانِ","dua kebun","jannatāni",78],["عَن","dari","ʿan",21],["يَمِينٍۢ","sebelah kanan","yamīnin",188],["وَشِمَالٍۢ ۖ","dan sebelah kiri","washimālin",814],["كُلُوا۟","makanlah","kulū",118],["مِن","dari","min",0],["رِّزْقِ","rizki","riz'qi",221],["رَبِّكُمْ","Tuhan kalian","rabbikum",10],["وَٱشْكُرُوا۟","dan bersyukurlah","wa-ush'kurū",257],["لَهُۥ ۚ","kepada-Nya","lahu",16],["بَلْدَةٌۭ","negeri","baldatun",1328],["طَيِّبَةٌۭ","yang baik","ṭayyibatun",258],["وَرَبٌّ","dan Tuhan","warabbun",10],["غَفُورٌۭ","Maha Pengampun","ghafūrun",122]],"t":"Sungguh, bagi kaum Saba` ada tanda (kebesaran Tuhan) di tempat kediaman mereka yaitu dua buah kebun di sebelah kanan dan di sebeleh kiri, (kepada mereka dikatakan), \"Makanlah olehmu dari rezeki yang (dianugerahkan) Tuhanmu dan bersyukurlah kepada-Nya. (Negerimu) adalah negeri yang baik (nyaman) sedang (Tuhanmu) adalah Tuhan Yang Maha Pengampun.\""},{"n":16,"w":[["فَأَعْرَضُوا۟","maka mereka berpaling","fa-aʿraḍū",356],["فَأَرْسَلْنَا","maka Kami kirimkan","fa-arsalnā",92],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["سَيْلَ","banjir","sayla",2651],["ٱلْعَرِمِ","besar","l-ʿarimi",3108],["وَبَدَّلْنَـٰهُم","dan Kami ganti mereka","wabaddalnāhum",454],["بِجَنَّتَيْهِمْ","dengan kedua kebun mereka","bijannatayhim",78],["جَنَّتَيْنِ","dua kebun","jannatayni",78],["ذَوَاتَىْ","keduanya mempunyai","dhawātay",117],["أُكُلٍ","makanan/buah","ukulin",1042],["خَمْطٍۢ","pahit","khamṭin",4537],["وَأَثْلٍۢ","dan cemara","wa-athlin",3018],["وَشَىْءٍۢ","dan sesuatu","washayin",41],["مِّن","dari","min",0],["سِدْرٍۢ","bidara","sid'rin",2653],["قَلِيلٍۢ","sedikit","qalīlin",176]],"t":"Tetapi mereka berpaling, maka Kami kirim kepada mereka banjir yang besar dan Kami ganti kedua kebun mereka dengan dua kebun yang ditumbuhi (pohon-pohon) yang berbuah pahit, pohon Aṡl dan sedikit pohon Sidr."},{"n":17,"w":[["ذَٰلِكَ","demikianlah","dhālika",20],["جَزَيْنَـٰهُم","Kami memberi balasan kepada mereka","jazaynāhum",165],["بِمَا","dengan apa/dengan sebab","bimā",2],["كَفَرُوا۟ ۖ","kafir/ingkar","kafarū",40],["وَهَلْ","dan apakah/dan tidaklah","wahal",119],["نُجَـٰزِىٓ","Kami memberi balasan","nujāzī",3541],["إِلَّا","melainkan/kecuali","illā",15],["ٱلْكَفُورَ","orang-orang yang sangat kafir","l-kafūra",738]],"t":"Demikianlah Kami memberi balasan kepada mereka karena kekafiran mereka. Dan Kami tidak menjatuhkan azab (yang demikian itu), melainkan hanya kepada orang-orang yang sangat kafir."},{"n":18,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["بَيْنَهُمْ","antara mereka","baynahum",47],["وَبَيْنَ","dan antara","wabayna",47],["ٱلْقُرَى","negeri","l-qurā",212],["ٱلَّتِى","yang","allatī",185],["بَـٰرَكْنَا","Kami limpahkan keberkahan","bāraknā",974],["فِيهَا","di dalamnya","fīhā",3],["قُرًۭى","beberapa negeri","quran",212],["ظَـٰهِرَةًۭ","nampak (berdekatan)","ẓāhiratan",832],["وَقَدَّرْنَا","dan Kami tetapkan","waqaddarnā",604],["فِيهَا","di dalamnya (negeri itu)","fīhā",3],["ٱلسَّيْرَ ۖ","perjalanan","l-sayra",2652],["سِيرُوا۟","berjalanlah kamu","sīrū",607],["فِيهَا","di dalamnya (negeri itu)","fīhā",3],["لَيَالِىَ","pada malam hari","layāliya",137],["وَأَيَّامًا","dan siang hari","wa-ayyāman",25],["ءَامِنِينَ","dengan aman","āminīna",562]],"t":"Dan Kami jadikan antara mereka (penduduk Saba`) dan negeri-negeri yang Kami berkahi (Syam), beberapa negeri yang berdekatan dan Kami tetapkan antara negeri-negeri itu (jarak-jarak) perjalanan. Berjalanlah kamu di negeri-negeri itu pada malam dan siang hari dengan aman."},{"n":19,"w":[["فَقَالُوا۟","maka mereka berkata","faqālū",6],["رَبَّنَا","ya Tuhan kami","rabbanā",10],["بَـٰعِدْ","jauhkanlah","bāʿid",3318],["بَيْنَ","antara","bayna",47],["أَسْفَارِنَا","perjalanan kami","asfārinā",2655],["وَظَلَمُوٓا۟","dan mereka menganiaya","waẓalamū",108],["أَنفُسَهُمْ","diri mereka sendiri","anfusahum",39],["فَجَعَلْنَـٰهُمْ","maka Kami jadikan mereka","fajaʿalnāhum",33],["أَحَادِيثَ","percakapan/buah mulut","aḥādītha",392],["وَمَزَّقْنَـٰهُمْ","dan Kami hancurkan mereka","wamazzaqnāhum",2484],["كُلَّ","setiap/segala","kulla",31],["مُمَزَّقٍ ۚ","sehancur-hancurnya","mumazzaqin",2506],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","demikian itu","dhālika",20],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّكُلِّ","bagi setiap","likulli",31],["صَبَّارٍۢ","orang-orang yang sabar","ṣabbārin",1529],["شَكُورٍۢ","orang-orang yang bersyukur","shakūrin",813]],"t":"Maka mereka berkata, \"Ya Tuhan kami, jauhkanlah jarak perjalanan kami,\" dan (berarti mereka) menzalimi diri mereka sendiri; maka Kami jadikan mereka bahan pembicaraan dan Kami hancurkan mereka sehancur-hancurnya. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kekuasaan Allah) bagi setiap orang yang sabar dan bersyukur."},{"n":20,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["صَدَّقَ","telah membenarkan","ṣaddaqa",827],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["إِبْلِيسُ","iblis","ib'līsu",763],["ظَنَّهُۥ","sangkaannya","ẓannahu",489],["فَٱتَّبَعُوهُ","lalu mereka mengikutinya","fa-ittabaʿūhu",87],["إِلَّا","kecuali","illā",15],["فَرِيقًۭا","segolongan/sebagian","farīqan",350],["مِّنَ","dari","mina",0],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55]],"t":"Dan sungguh, Iblis telah dapat meyakinkan terhadap mereka kebenaran sangkaannya, lalu mereka mengikutinya, kecuali sebagian dari orang-orang mukmin."},{"n":21,"w":[["وَمَا","dan tidak","wamā",2],["كَانَ","adalah","kāna",8],["لَهُۥ","baginya (iblis)","lahu",16],["عَلَيْهِم","atas mereka","ʿalayhim",7],["مِّن","dari","min",0],["سُلْطَـٰنٍ","kekuasaan","sul'ṭānin",328],["إِلَّا","kecuali","illā",15],["لِنَعْلَمَ","untuk Kami ketahui","linaʿlama",29],["مَن","siapa","man",12],["يُؤْمِنُ","beriman","yu'minu",18],["بِٱلْـَٔاخِرَةِ","kepada akhirat","bil-ākhirati",74],["مِمَّنْ","daripada orang","mimman",0],["هُوَ","dia","huwa",19],["مِنْهَا","daripadanya","min'hā",0],["فِى","dalam","fī",3],["شَكٍّۢ ۗ","keraguan","shakkin",615],["وَرَبُّكَ","dan Tuhanmu","warabbuka",10],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍ","sesuatu","shayin",41],["حَفِيظٌۭ","Penjaga/Pemelihara","ḥafīẓun",726]],"t":"Dan tidak ada kekuasaan (Iblis) terhadap mereka, melainkan hanya agar Kami dapat membedakan siapa yang beriman kepada adanya akhirat dan siapa yang ragu-ragu tentang (akhirat) itu. Dan Tuhanmu Maha Memelihara segala sesuatu."},{"n":22,"w":[["قُلِ","katakanlah","quli",6],["ٱدْعُوا۟","serulah","id'ʿū",66],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["زَعَمْتُم","kamu anggap","zaʿamtum",708],["مِّن","dari","min",0],["دُونِ","selain","dūni",80],["ٱللَّهِ ۖ","Allah","l-lahi",1],["لَا","tidak","lā",4],["يَمْلِكُونَ","mereka memiliki","yamlikūna",272],["مِثْقَالَ","seberat","mith'qāla",989],["ذَرَّةٍۢ","bagian yang terkecil/atom","dharratin",1130],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَلَا","dan tidak","walā",4],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَمَا","dan tidaklah","wamā",2],["لَهُمْ","bagi mereka","lahum",11],["فِيهِمَا","dalam keduanya (langit dan bumi)","fīhimā",3],["مِن","dari","min",0],["شِرْكٍۢ","sekutu (suatu saham)","shir'kin",1267],["وَمَا","dan tidak ada","wamā",2],["لَهُۥ","baginya","lahu",16],["مِنْهُم","diantara mereka","min'hum",0],["مِّن","dari","min",0],["ظَهِيرٍۢ","pembantu","ẓahīrin",1166]],"t":"Katakanlah (Muhammad), \"Serulah mereka yang kamu anggap (sebagai tuhan) selain Allah! Mereka tidak memiliki (kekuasaan) seberat zarah pun di langit dan di bumi, dan mereka sama sekali tidak mempunyai peran serta dalam (penciptaan) langit dan bumi dan tidak ada di antara mereka yang menjadi pembantu bagi-Nya.\""},{"n":23,"w":[["وَلَا","dan tidak","walā",4],["تَنفَعُ","berguna","tanfaʿu",368],["ٱلشَّفَـٰعَةُ","pertolongan","l-shafāʿatu",677],["عِندَهُۥٓ","di sisi-Nya","ʿindahu",60],["إِلَّا","kecuali","illā",15],["لِمَنْ","bagi orang","liman",12],["أَذِنَ","Dia izinkan","adhina",451],["لَهُۥ ۚ","baginya","lahu",16],["حَتَّىٰٓ","sehingga","ḥattā",83],["إِذَا","apabila","idhā",23],["فُزِّعَ","dihilangkan ketakutan","fuzziʿa",3454],["عَن","dari","ʿan",21],["قُلُوبِهِمْ","hati mereka","qulūbihim",90],["قَالُوا۟","mereka berkata","qālū",6],["مَاذَا","apakah","mādhā",418],["قَالَ","berkata/kata","qāla",6],["رَبُّكُمْ ۖ","Tuhan kalian","rabbukum",10],["قَالُوا۟","mereka berkata (menjawab)","qālū",6],["ٱلْحَقَّ ۖ","kebenaran","l-ḥaqa",50],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَلِىُّ","Maha Tinggi","l-ʿaliyu",772],["ٱلْكَبِيرُ","Maha Besar","l-kabīru",292]],"t":"Dan syafaat (pertolongan) di sisi-Nya hanya berguna bagi orang yang telah diizinkan-Nya (memperoleh syafaat itu). Sehingga apabila telah dihilangkan ketakutan dari hati mereka, mereka berkata, \"Apakah yang telah difirmankan oleh Tuhanmu?\" Mereka menjawab, \"(Perkataan) yang benar,\" dan Dialah Yang Mahatinggi, Mahabesar."},{"n":24,"w":[["۞ قُلْ","katakanlah","qul",6],["مَن","siapa","man",12],["يَرْزُقُكُم","memberi rizki kepadamu","yarzuqukum",198],["مِّنَ","dari","mina",0],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["قُلِ","katakanlah","quli",6],["ٱللَّهُ ۖ","Allah","l-lahu",1],["وَإِنَّآ","dan sesungguhnya kami","wa-innā",5],["أَوْ","atau","aw",42],["إِيَّاكُمْ","kamu","iyyākum",436],["لَعَلَىٰ","pasti","laʿalā",7],["هُدًى","petunjuk","hudan",134],["أَوْ","atau","aw",42],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",315],["مُّبِينٍۢ","yang nyata","mubīnin",103]],"t":"Katakanlah (Muhammad), \"Siapakah yang memberi rezeki kepadamu dari langit dan dari bumi?\" Katakanlah, \"Allah,\" dan sesungguhnya kami atau kamu (orang-orang musyrik), pasti berada dalam kebenaran atau dalam kesesatan yang nyata."},{"n":25,"w":[["قُل","katakanlah","qul",6],["لَّا","tidak","lā",4],["تُسْـَٔلُونَ","kamu akan ditanya","tus'alūna",109],["عَمَّآ","dari/tentang apa","ʿammā",21],["أَجْرَمْنَا","dosa kami","ajramnā",1277],["وَلَا","dan tidak","walā",4],["نُسْـَٔلُ","kami akan ditanya","nus'alu",109],["عَمَّا","dari/tentang apa","ʿammā",21],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Katakanlah, \"Kamu tidak akan dimintai tanggung jawab atas apa yang kami kerjakan dan kami juga tidak akan dimintai tanggung jawab atas apa yang kamu kerjakan.\""},{"n":26,"w":[["قُلْ","katakanlah","qul",6],["يَجْمَعُ","akan mengumpulkan","yajmaʿu",469],["بَيْنَنَا","diantara kita","baynanā",47],["رَبُّنَا","Tuhan kita","rabbunā",10],["ثُمَّ","kemudian","thumma",34],["يَفْتَحُ","Dia memberi keputusan","yaftaḥu",597],["بَيْنَنَا","diantara kita","baynanā",47],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْفَتَّاحُ","Maha Pemberi keputusan","l-fatāḥu",3446],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",69]],"t":"Katakanlah, \"Tuhan kita akan mengumpulkan kita semua, kemudian Dia memberi keputusan antara kita dengan benar. Dan Dia Yang Maha Pemberi keputusan, Maha Mengetahui.\""},{"n":27,"w":[["قُلْ","katakanlah","qul",6],["أَرُونِىَ","perlihatkanlah kepadaku","arūniya",295],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["أَلْحَقْتُم","kamu hubungkan","alḥaqtum",1481],["بِهِۦ","dengan-Nya/Dia","bihi",16],["شُرَكَآءَ ۖ","sekutu-sekutu","shurakāa",294],["كَلَّا ۚ","tidak sekali-kali","kallā",352],["بَلْ","bahkan","bal",97],["هُوَ","Dia","huwa",19],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Katakanlah, \"Perlihatkanlah kepadaku sembahan-sembahan yang kamu hubungkan dengan Dia sebagai sekutu-sekutu(-Nya), tidak mungkin! Sebenarnya Dialah Allah Yang Mahaperkasa, Mahabijaksana.\""},{"n":28,"w":[["وَمَآ","dan tidak","wamā",2],["أَرْسَلْنَـٰكَ","Kami mengutus kamu","arsalnāka",92],["إِلَّا","kecuali","illā",15],["كَآفَّةًۭ","seluruh","kāffatan",1359],["لِّلنَّاسِ","untuk manusia","lilnnāsi",52],["بَشِيرًۭا","pembawa kabar","bashīran",902],["وَنَذِيرًۭا","dan pemberi peringatan","wanadhīran",206],["وَلَـٰكِنَّ","tetapi","walākinna",210],["أَكْثَرَ","kebanyakan","akthara",146],["ٱلنَّاسِ","manusia","l-nāsi",52],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Dan Kami tidak mengutus engkau (Muhammad), melainkan kepada semua umat manusia sebagai pembawa berita gembira dan sebagai pemberi peringatan, tetapi kebanyakan manusia tidak mengetahui."},{"n":29,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["مَتَىٰ","kapankah","matā",918],["هَـٰذَا","ini","hādhā",56],["ٱلْوَعْدُ","janji","l-waʿdu",248],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",8],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Dan mereka berkata, \"Kapankah (datangnya) janji ini, jika kamu orang yang benar?\""},{"n":30,"w":[["قُل","katakanlah","qul",6],["لَّكُم","bagi kalian","lakum",26],["مِّيعَادُ","janji","mīʿādu",1210],["يَوْمٍۢ","hari","yawmin",25],["لَّا","tidak","lā",4],["تَسْتَـْٔخِرُونَ","kamu dapat minta diundurkan","tastakhirūna",1259],["عَنْهُ","daripadanya","ʿanhu",21],["سَاعَةًۭ","sesaat","sāʿatan",253],["وَلَا","dan tidak","walā",4],["تَسْتَقْدِمُونَ","kamu dapat minta diajukan","tastaqdimūna",1705]],"t":"Katakanlah, \"Bagimu ada hari yang telah dijanjikan (hari Kiamat), kamu tidak dapat meminta penundaan atau percepatannya sesaat pun.\""},{"n":31,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَن","tidak","lan",113],["نُّؤْمِنَ","kami beriman","nu'mina",18],["بِهَـٰذَا","dengan/kepada ini","bihādhā",56],["ٱلْقُرْءَانِ","Al Qur'an","l-qur'āni",179],["وَلَا","dan tidak","walā",4],["بِٱلَّذِى","dengan yang (Kitab)","bi-alladhī",38],["بَيْنَ","antara","bayna",47],["يَدَيْهِ ۗ","dihadapannya/sebelumnya","yadayhi",102],["وَلَوْ","dan kalau","walaw",58],["تَرَىٰٓ","kamu melihat","tarā",46],["إِذِ","ketika","idhi",53],["ٱلظَّـٰلِمُونَ","orang-orang yang zalim","l-ẓālimūna",89],["مَوْقُوفُونَ","mereka berhenti/dihadapkan","mawqūfūna",3757],["عِندَ","di sisi/kepada","ʿinda",60],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["يَرْجِعُ","mengembalikan","yarjiʿu",147],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",72],["إِلَىٰ","kepada","ilā",13],["بَعْضٍ","sebagian yang lain","baʿḍin",72],["ٱلْقَوْلَ","perkataan","l-qawla",120],["يَقُولُ","berkata","yaqūlu",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ٱسْتُضْعِفُوا۟","(mereka) lemah","us'tuḍ'ʿifū",1024],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",9],["ٱسْتَكْبَرُوا۟","(mereka) menyombongkan diri","is'takbarū",305],["لَوْلَآ","kalau tidak","lawlā",157],["أَنتُمْ","kamu","antum",88],["لَكُنَّا","tentu kamu menjadi","lakunnā",8],["مُؤْمِنِينَ","orang-orang yang beriman","mu'minīna",55]],"t":"Dan orang-orang kafir berkata, \"Kami tidak akan beriman kepada Alquran ini dan tidak (pula) kepada kitab yang sebelumnya.\" Dan (alangkah mengerikan) kalau kamu melihat ketika orang-orang yang zalim itu dihadapkan kepada Tuhannya, sebagian mereka mengembalikan perkataan kepada sebagian yang lain; orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \"Kalau tidaklah karena kamu tentulah kami menjadi orang-orang mukmin.\""},{"n":32,"w":[["قَالَ","berkata","qāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ٱسْتَكْبَرُوا۟","(mereka) menyombongkan diri","is'takbarū",305],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",9],["ٱسْتُضْعِفُوٓا۟","(mereka) lemah","us'tuḍ'ʿifū",1024],["أَنَحْنُ","apakah kami","anaḥnu",131],["صَدَدْنَـٰكُمْ","kami menghalangi kamu","ṣadadnākum",322],["عَنِ","dari","ʿani",21],["ٱلْهُدَىٰ","petunjuk","l-hudā",134],["بَعْدَ","setelah","baʿda",59],["إِذْ","ketika/tatkala","idh",53],["جَآءَكُم ۖ","ia datang kepadamu","jāakum",43],["بَلْ","bahkan","bal",97],["كُنتُم","kalian adalah","kuntum",8],["مُّجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",230]],"t":"Orang-orang yang menyombongkan diri berkata kepada orang-orang yang dianggap lemah, \"Kamikah yang telah menghalangimu untuk memperoleh petunjuk setelah petunjuk itu datang kepadamu? (Tidak!) Sebenarnya kamu sendirilah orang-orang yang berbuat dosa.\""},{"n":33,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ٱسْتُضْعِفُوا۟","(mereka) lemah","us'tuḍ'ʿifū",1024],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",9],["ٱسْتَكْبَرُوا۟","(mereka) menyombongkan diri","is'takbarū",305],["بَلْ","bahkan","bal",97],["مَكْرُ","tipu-daya","makru",532],["ٱلَّيْلِ","di waktu malam","al-layli",137],["وَٱلنَّهَارِ","dan siang hari","wal-nahāri",211],["إِذْ","ketika/tatkala","idh",53],["تَأْمُرُونَنَآ","kamu menyuruh kami","tamurūnanā",151],["أَن","bahwa","an",17],["نَّكْفُرَ","kami kafir","nakfura",40],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَنَجْعَلَ","dan kami menjadikan","wanajʿala",33],["لَهُۥٓ","bagi-Nya","lahu",16],["أَندَادًۭا ۚ","sekutu-sekutu","andādan",1217],["وَأَسَرُّوا۟","dan mereka menyatakan","wa-asarrū",544],["ٱلنَّدَامَةَ","penyesalan","l-nadāmata",2578],["لَمَّا","tatkala","lammā",73],["رَأَوُا۟","mereka melihat","ra-awū",46],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["وَجَعَلْنَا","dan Kami jadikan/pasang","wajaʿalnā",33],["ٱلْأَغْلَـٰلَ","belenggu-belenggu","l-aghlāla",909],["فِىٓ","di/pada","fī",3],["أَعْنَاقِ","leher","aʿnāqi",892],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟ ۚ","kafir/ingkar","kafarū",40],["هَلْ","tidaklah","hal",119],["يُجْزَوْنَ","mereka diberi balasan","yuj'zawna",165],["إِلَّا","melainkan/kecuali","illā",15],["مَا","apa","mā",2],["كَانُوا۟","mereka adalah","kānū",8],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Dan orang-orang yang dianggap lemah berkata kepada orang-orang yang menyombongkan diri, \"(Tidak!) Sebenarnya tipu daya(mu) pada waktu malam dan siang (yang menghalangi kami), ketika kamu menyeru kami agar kami kafir kepada Allah dan menjadikan sekutu-sekutu bagi-Nya.\" Mereka menyatakan penyesalan ketika mereka melihat azab. Dan Kami pasangkan belenggu di leher orang-orang yang kafir. Mereka tidak dibalas melainkan sesuai dengan apa yang telah mereka kerjakan."},{"n":34,"w":[["وَمَآ","dan tidak","wamā",2],["أَرْسَلْنَا","Kami mengutus","arsalnā",92],["فِى","pada","fī",3],["قَرْيَةٍۢ","suatu negeri","qaryatin",212],["مِّن","dari","min",0],["نَّذِيرٍ","seorang pemberi peringatan","nadhīrin",206],["إِلَّا","kecuali/melainkan","illā",15],["قَالَ","berkata","qāla",6],["مُتْرَفُوهَآ","orang-orang hidup mewah di negeri itu","mut'rafūhā",1384],["إِنَّا","sesungguhnya kami","innā",5],["بِمَآ","dengan/tentang apa","bimā",2],["أُرْسِلْتُم","kamu diutus","ur'sil'tum",92],["بِهِۦ","dengannya (menyampaikannya)","bihi",16],["كَـٰفِرُونَ","orang-orang yang mengingkari","kāfirūna",71]],"t":"Dan setiap Kami mengutus seorang pemberi peringatan kepada suatu negeri, orang-orang yang hidup mewah (di negeri itu) berkata, \"Kami benar-benar mengingkari apa yang kamu sampaikan sebagai utusan.\""},{"n":35,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["نَحْنُ","kami","naḥnu",131],["أَكْثَرُ","lebih banyak","aktharu",146],["أَمْوَٰلًۭا","harta","amwālan",132],["وَأَوْلَـٰدًۭا","dan anak-anak","wa-awlādan",218],["وَمَا","dan tidaklah","wamā",2],["نَحْنُ","kami","naḥnu",131],["بِمُعَذَّبِينَ","orang-orang yang disiksa","bimuʿadhabīna",1600]],"t":"Dan mereka berkata, \"Kami memiliki lebih banyak harta dan anak-anak (daripada kamu) dan kami tidak akan diazab.\""},{"n":36,"w":[["قُلْ","katakanlah","qul",6],["إِنَّ","sesungguhnya","inna",5],["رَبِّى","Tuhanku","rabbī",10],["يَبْسُطُ","Dia melapangkan","yabsuṭu",594],["ٱلرِّزْقَ","rizki","l-riz'qa",221],["لِمَن","bagi siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَقْدِرُ","dan Dia menyempitkan","wayaqdiru",434],["وَلَـٰكِنَّ","akan tetapi","walākinna",210],["أَكْثَرَ","kebanyakan","akthara",146],["ٱلنَّاسِ","manusia","l-nāsi",52],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Katakanlah, \"Sungguh, Tuhanku melapangkan rezeki bagi siapa yang Dia kehendaki dan membatasinya (bagi siapa yang Dia kehendaki), tetapi kebanyakan manusia tidak mengetahui.\""},{"n":37,"w":[["وَمَآ","dan tidak","wamā",2],["أَمْوَٰلُكُمْ","hartamu","amwālukum",132],["وَلَآ","dan tidak","walā",4],["أَوْلَـٰدُكُم","anak-anakmu","awlādukum",218],["بِٱلَّتِى","dengan yang","bi-allatī",185],["تُقَرِّبُكُمْ","mendekatkan kamu","tuqarribukum",1403],["عِندَنَا","pada sisi Kami","ʿindanā",60],["زُلْفَىٰٓ","dekat","zul'fā",1690],["إِلَّا","kecuali","illā",15],["مَنْ","orang","man",12],["ءَامَنَ","beriman","āmana",18],["وَعَمِلَ","dan mengerjakan/beramal","waʿamila",44],["صَـٰلِحًۭا","kebajikan/saleh","ṣāliḥan",96],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",57],["لَهُمْ","bagi mereka","lahum",11],["جَزَآءُ","pembalasan","jazāu",280],["ٱلضِّعْفِ","lipat ganda","l-ḍiʿ'fi",769],["بِمَا","dengan apa/sebab","bimā",2],["عَمِلُوا۟","mereka kerjakan","ʿamilū",44],["وَهُمْ","dan mereka","wahum",11],["فِى","di/pada","fī",3],["ٱلْغُرُفَـٰتِ","tempat yang tinggi","l-ghurufāti",3501],["ءَامِنُونَ","mereka aman sentosa","āminūna",562]],"t":"Dan bukanlah harta dan anak-anakmu yang mendekatkan kamu kepada Kami; melainkan orang-orang yang beriman dan mengerjakan kebajikan, mereka itulah yang memperoleh balasan yang berlipat ganda atas apa yang telah mereka kerjakan; dan mereka aman sentosa di tempat-tempat yang tinggi (dalam surga)."},{"n":38,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["يَسْعَوْنَ","(mereka) berusaha","yasʿawna",520],["فِىٓ","pada","fī",3],["ءَايَـٰتِنَا","ayat-ayat Kami","āyātinā",28],["مُعَـٰجِزِينَ","melemahkan","muʿājizīna",1920],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["فِى","di dalam","fī",3],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["مُحْضَرُونَ","mereka dihadapkan","muḥ'ḍarūna",852]],"t":"Dan orang-orang yang berusaha menentang ayat-ayat Kami melemahkan (menggagalkan azab Kami), mereka itu dimasukkan ke dalam azab."},{"n":39,"w":[["قُلْ","katakanlah","qul",6],["إِنَّ","sesungguhnya","inna",5],["رَبِّى","Tuhanku","rabbī",10],["يَبْسُطُ","Dia melapangkan","yabsuṭu",594],["ٱلرِّزْقَ","rizki","l-riz'qa",221],["لِمَن","bagi siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["مِنْ","dari","min",0],["عِبَادِهِۦ","hamba-hamba-Nya","ʿibādihi",91],["وَيَقْدِرُ","dan Dia menyempitkan","wayaqdiru",434],["لَهُۥ ۚ","baginya","lahu",16],["وَمَآ","dan apa","wamā",2],["أَنفَقْتُم","kamu belanjakan","anfaqtum",183],["مِّن","dari","min",0],["شَىْءٍۢ","sesuatu","shayin",41],["فَهُوَ","maka Dia","fahuwa",19],["يُخْلِفُهُۥ ۖ","Dia menggantinya","yukh'lifuhu",652],["وَهُوَ","dan Dia","wahuwa",19],["خَيْرُ","sebaik-baik","khayru",61],["ٱلرَّٰزِقِينَ","pemberi rizki","l-rāziqīna",1229]],"t":"Katakanlah, \"Sungguh, Tuhanku melapangkan rezeki dan membatasinya bagi siapa yang Dia kehendaki di antara hamba-hamba-Nya.\" Dan apa saja yang kamu infakkan, Allah akan menggantinya dan Dialah pemberi rezeki yang terbaik."},{"n":40,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["يَحْشُرُهُمْ","Dia mengumpulkan mereka","yaḥshuruhum",320],["جَمِيعًۭا","semua","jamīʿan",226],["ثُمَّ","kemudian","thumma",34],["يَقُولُ","Dia berfirman","yaqūlu",6],["لِلْمَلَـٰٓئِكَةِ","kepada para malaikat","lil'malāikati",128],["أَهَـٰٓؤُلَآءِ","apakah mereka ini","ahāulāi",259],["إِيَّاكُمْ","kepada kamu","iyyākum",436],["كَانُوا۟","adalah mereka","kānū",8],["يَعْبُدُونَ","mereka menyembah","yaʿbudūna",100]],"t":"Dan (ingatlah) pada hari (ketika) Allah mengumpulkan mereka semuanya kemudian Dia berfirman kepada para malaikat, \"Apakah kepadamu mereka ini dahulu menyembah?\""},{"n":41,"w":[["قَالُوا۟","mereka berkata","qālū",6],["سُبْحَـٰنَكَ","Maha Suci Engkau","sub'ḥānaka",293],["أَنتَ","Engkau","anta",145],["وَلِيُّنَا","pelindung kami","waliyyunā",133],["مِن","dari","min",0],["دُونِهِم ۖ","selain/bukan mereka","dūnihim",80],["بَلْ","bahkan","bal",97],["كَانُوا۟","adalah mereka","kānū",8],["يَعْبُدُونَ","mereka menyembah","yaʿbudūna",100],["ٱلْجِنَّ ۖ","jin","l-jina",470],["أَكْثَرُهُم","kebanyakan mereka","aktharuhum",146],["بِهِم","pada mereka (jin itu)","bihim",11],["مُّؤْمِنُونَ","orang-orang yang beriman","mu'minūna",55]],"t":"Para malaikat itu menjawab, \"Mahasuci Engkau. Engkaulah pelindung kami, bukan mereka; bahkan mereka telah menyembah jin; kebanyakan mereka beriman kepada jin.\""},{"n":42,"w":[["فَٱلْيَوْمَ","maka pada hari ini","fal-yawma",25],["لَا","tidak","lā",4],["يَمْلِكُ","berkuasa/memiliki","yamliku",272],["بَعْضُكُمْ","sebagian kamu","baʿḍukum",72],["لِبَعْضٍۢ","bagi sebagian yang lain","libaʿḍin",72],["نَّفْعًۭا","memberi manfaat","nafʿan",797],["وَلَا","dan tidak","walā",4],["ضَرًّۭا","memberi bahaya","ḍarran",821],["وَنَقُولُ","dan Kami katakan","wanaqūlu",6],["لِلَّذِينَ","orang-orang yang","lilladhīna",9],["ظَلَمُوا۟","(mereka) zalim","ẓalamū",108],["ذُوقُوا۟","rasakanlah","dhūqū",329],["عَذَابَ","azab","ʿadhāba",36],["ٱلنَّارِ","api neraka","l-nāri",79],["ٱلَّتِى","yang","allatī",185],["كُنتُم","kalian adalah","kuntum",8],["بِهَا","dengannya","bihā",98],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",64]],"t":"Maka pada hari ini sebagian kamu tidak kuasa (mendatangkan) manfaat maupun (menolak) mudarat kepada sebagian yang lain. Dan Kami katakan kepada orang-orang yang zalim, \"Rasakanlah olehmu azab neraka yang dahulu kamu dustakan.\""},{"n":43,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",199],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["بَيِّنَـٰتٍۢ","yang terang","bayyinātin",175],["قَالُوا۟","mereka berkata","qālū",6],["مَا","tidaklah","mā",2],["هَـٰذَآ","ini","hādhā",56],["إِلَّا","kecuali","illā",15],["رَجُلٌۭ","seorang laki-laki","rajulun",213],["يُرِيدُ","ia hendak","yurīdu",84],["أَن","untuk","an",17],["يَصُدَّكُمْ","menghalang-halangi kamu","yaṣuddakum",322],["عَمَّا","dari apa","ʿammā",21],["كَانَ","adalah","kāna",8],["يَعْبُدُ","menyembah","yaʿbudu",100],["ءَابَآؤُكُمْ","bapak-bapak kamu","ābāukum",107],["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مَا","apa","mā",2],["هَـٰذَآ","ini","hādhā",56],["إِلَّآ","kecuali","illā",15],["إِفْكٌۭ","kebohongan","if'kun",875],["مُّفْتَرًۭى ۚ","diada-adakan","muf'taran",2543],["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لِلْحَقِّ","kepada kebenaran","lil'ḥaqqi",50],["لَمَّا","tatkala","lammā",73],["جَآءَهُمْ","ia datang kepada mereka","jāahum",43],["إِنْ","tidaklah","in",14],["هَـٰذَآ","ini","hādhā",56],["إِلَّا","kecuali","illā",15],["سِحْرٌۭ","sihir","siḥ'run",398],["مُّبِينٌۭ","yang nyata","mubīnun",103]],"t":"Dan apabila dibacakan kepada mereka ayat-ayat Kami yang terang, mereka berkata, \"Orang ini tidak lain hanya ingin menghalang-halangi kamu dari apa yang disembah oleh nenek moyangmu,\" dan mereka berkata, \"(Alquran) ini tidak lain hanyalah kebohongan yang diada-adakan saja.\" Dan orang-orang kafir berkata terhadap kebenaran ketika kebenaran (Alquran) itu datang kepada mereka, \"Ini tidak lain hanyalah sihir yang nyata.\""},{"n":44,"w":[["وَمَآ","dan tidak","wamā",2],["ءَاتَيْنَـٰهُم","Kami berikan kepada mereka","ātaynāhum",45],["مِّن","dari","min",0],["كُتُبٍۢ","kitab-kitab","kutubin",49],["يَدْرُسُونَهَا ۖ","mereka membacanya","yadrusūnahā",1335],["وَمَآ","dan tidak","wamā",2],["أَرْسَلْنَآ","Kami utus","arsalnā",92],["إِلَيْهِمْ","kepada mereka","ilayhim",13],["قَبْلَكَ","sebelum kamu","qablaka",51],["مِن","dari","min",0],["نَّذِيرٍۢ","seorang pemberi peringatan","nadhīrin",206]],"t":"Dan Kami tidak pernah memberikan kepada mereka kitab-kitab yang mereka baca dan Kami tidak pernah mengutus seorang pemberi peringatan kepada mereka sebelum engkau (Muhammad)."},{"n":45,"w":[["وَكَذَّبَ","dan telah mendustakan","wakadhaba",64],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["وَمَا","dan tidak","wamā",2],["بَلَغُوا۟","mereka sampai (menerima)","balaghū",296],["مِعْشَارَ","sepersepuluh","miʿ'shāra",3766],["مَآ","apa","mā",2],["ءَاتَيْنَـٰهُمْ","Kami berikan kepada mereka","ātaynāhum",45],["فَكَذَّبُوا۟","lalu mereka mendustakan","fakadhabū",64],["رُسُلِى ۖ","rasul-rasul-Ku","rusulī",35],["فَكَيْفَ","maka bagaimana/alangkah","fakayfa",139],["كَانَ","adalah","kāna",8],["نَكِيرِ","kemurkaan-Ku","nakīri",1395]],"t":"Dan orang-orang yang sebelum mereka telah mendustakan (para rasul) sedang orang-orang (kafir Mekkah) itu belum sampai menerima sepersepuluh dari apa yang telah Kami berikan kepada orang-orang terdahulu, namun mereka mendustakan para rasul-Ku. Maka (lihatlah) bagaimana dahsyatnya akibat kemurkaan-Ku."},{"n":46,"w":[["۞ قُلْ","katakanlah","qul",6],["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَعِظُكُم","aku memberi nasihat kepadamu","aʿiẓukum",642],["بِوَٰحِدَةٍ ۖ","dengan satu (perkara)","biwāḥidatin",369],["أَن","bahwa","an",17],["تَقُومُوا۟","kamu berdiri/menghadap","taqūmū",354],["لِلَّهِ","kepada Allah","lillahi",1],["مَثْنَىٰ","berdua-dua","mathnā",1372],["وَفُرَٰدَىٰ","dan sendiri-sendiri","wafurādā",1340],["ثُمَّ","kemudian","thumma",34],["تَتَفَكَّرُوا۟ ۚ","kamu berfikir","tatafakkarū",582],["مَا","tidaklah","mā",2],["بِصَاحِبِكُم","kawanmu itu","biṣāḥibikum",123],["مِّن","dari","min",0],["جِنَّةٍ ۚ","penyakit gila","jinnatin",840],["إِنْ","tak lain","in",14],["هُوَ","dia","huwa",19],["إِلَّا","kecuali","illā",15],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206],["لَّكُم","bagi kalian","lakum",26],["بَيْنَ","diantara","bayna",47],["يَدَىْ","dihadapannya/sebelumnya","yaday",102],["عَذَابٍۢ","azab","ʿadhābin",36],["شَدِيدٍۢ","keras","shadīdin",215]],"t":"Katakanlah, \"Aku hendak memperingatkan kepadamu satu hal saja, yaitu agar kamu menghadap Allah (dengan ikhlas) berdua-dua atau sendiri-sendiri; kemudian agar kamu pikirkan (tentang Muhammad). Kawanmu itu tidak gila sedikit pun. Dia tidak lain hanyalah seorang pemberi peringatan bagi kamu sebelum (menghadapi) azab yang keras.\""},{"n":47,"w":[["قُلْ","katakanlah","qul",6],["مَا","tidak","mā",2],["سَأَلْتُكُم","aku meminta kepadamu","sa-altukum",109],["مِّنْ","dari","min",0],["أَجْرٍۢ","upah","ajrin",111],["فَهُوَ","maka itu (upah)","fahuwa",19],["لَكُمْ ۖ","bagi kalian","lakum",26],["إِنْ","tak lain","in",14],["أَجْرِىَ","upahku","ajriya",111],["إِلَّا","kecuali","illā",15],["عَلَى","atas/dari","ʿalā",7],["ٱللَّهِ ۖ","Allah","l-lahi",1],["وَهُوَ","dan Dia","wahuwa",19],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["شَهِيدٌۭ","Maha Menyaksikan","shahīdun",216]],"t":"Katakanlah (Muhammad), \"Imbalan apa pun yang aku minta kepadamu, maka itu untuk kamu. Imbalanku hanyalah dari Allah, dan Dia Maha Mengetahui segala sesuatu.\""},{"n":48,"w":[["قُلْ","katakanlah","qul",6],["إِنَّ","sesungguhnya","inna",5],["رَبِّى","Tuhanku","rabbī",10],["يَقْذِفُ","Dia memasukkan/mewahyukan","yaqdhifu",925],["بِٱلْحَقِّ","dengan kebenaran","bil-ḥaqi",50],["عَلَّـٰمُ","Maha Mengetahui","ʿallāmu",1503],["ٱلْغُيُوبِ","segala yang gaib","l-ghuyūbi",1566]],"t":"Katakanlah, \"Sesungguhnya Tuhanku mewahyukan kebenaran. Dia Maha Mengetahui segala yang gaib.\""},{"n":49,"w":[["قُلْ","katakanlah","qul",6],["جَآءَ","telah datang","jāa",43],["ٱلْحَقُّ","kebenaran","l-ḥaqu",50],["وَمَا","dan tidak","wamā",2],["يُبْدِئُ","memulai","yub'di-u",1734],["ٱلْبَـٰطِلُ","kebatilan","l-bāṭilu",415],["وَمَا","dan tidak","wamā",2],["يُعِيدُ","akan kembali","yuʿīdu",542]],"t":"Katakanlah, \"Kebenaran telah datang dan yang batil itu tidak akan memulai dan tidak (pula) akan mengulangi.\""},{"n":50,"w":[["قُلْ","katakanlah","qul",6],["إِن","sesungguhnya","in",14],["ضَلَلْتُ","aku sesat","ḍalaltu",225],["فَإِنَّمَآ","maka sesungguhnya","fa-innamā",5],["أَضِلُّ","untuk kesesatan diriku sendiri","aḍillu",225],["عَلَىٰ","atas","ʿalā",7],["نَفْسِى ۖ","diriku","nafsī",39],["وَإِنِ","dan jika","wa-ini",14],["ٱهْتَدَيْتُ","aku mendapat petunjuk","ih'tadaytu",303],["فَبِمَا","maka dengan sebab","fabimā",2],["يُوحِىٓ","mewahyukan","yūḥī",169],["إِلَىَّ","kepadaku","ilayya",13],["رَبِّىٓ ۚ","Tuhanku","rabbī",10],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["سَمِيعٌۭ","Maha Mendengar","samīʿun",256],["قَرِيبٌۭ","Maha Dekat","qarībun",419]],"t":"Katakanlah, \"Jika aku sesat maka sesungguhnya aku sesat untuk diriku sendiri; dan jika aku mendapat petunjuk maka itu disebabkan apa yang diwahyukan Tuhanku kepadaku. Sungguh, Dia Maha Mendengar, Mahadekat.\""},{"n":51,"w":[["وَلَوْ","dan jika","walaw",58],["تَرَىٰٓ","kamu melihat","tarā",46],["إِذْ","ketika","idh",53],["فَزِعُوا۟","mereka dikagetkan","faziʿū",1845],["فَلَا","maka tidak","falā",4],["فَوْتَ","dapat melepaskan diri","fawta",3451],["وَأُخِذُوا۟","dan mereka mengambil","wa-ukhidhū",95],["مِن","dari","min",0],["مَّكَانٍۢ","tempat","makānin",407],["قَرِيبٍۢ","yang dekat","qarībin",419]],"t":"Dan (alangkah mengerikan) sekiranya engkau melihat mereka (orang-orang kafir) ketika terperanjat ketakutan (pada hari Kiamat); lalu mereka tidak dapat melepaskan diri dan mereka ditangkap dari tempat yang dekat (untuk dibawa ke neraka),"},{"n":52,"w":[["وَقَالُوٓا۟","dan mereka berkata","waqālū",6],["ءَامَنَّا","kami beriman","āmannā",18],["بِهِۦ","kepada-Nya (Allah)","bihi",16],["وَأَنَّىٰ","dan bagaimana","wa-annā",391],["لَهُمُ","bagi mereka","lahumu",11],["ٱلتَّنَاوُشُ","mencapai","l-tanāwushu",4431],["مِن","dari","min",0],["مَّكَانٍۭ","tempat","makānin",407],["بَعِيدٍۢ","yang jauh","baʿīdin",428]],"t":"dan (ketika) mereka berkata, \"Kami beriman kepada-Nya.\" Namun bagaimana mereka dapat mencapai (keimanan) dari tempat yang jauh?"},{"n":53,"w":[["وَقَدْ","dan sesungguhnya","waqad",24],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِهِۦ","kepada-Nya","bihi",16],["مِن","dari","min",0],["قَبْلُ ۖ","sebelum/dahulu","qablu",51],["وَيَقْذِفُونَ","dan mereka memasukkan/menduga-duga","wayaqdhifūna",925],["بِٱلْغَيْبِ","dengan yang gaib","bil-ghaybi",244],["مِن","dari","min",0],["مَّكَانٍۭ","tempat","makānin",407],["بَعِيدٍۢ","yang jauh","baʿīdin",428]],"t":"Dan sungguh, mereka telah mengingkari Allah sebelum itu; dan mereka mendustakan tentang yang gaib dari tempat yang jauh."},{"n":54,"w":[["وَحِيلَ","dan dihalangi","waḥīla",1790],["بَيْنَهُمْ","diantara mereka","baynahum",47],["وَبَيْنَ","dan antara","wabayna",47],["مَا","apa","mā",2],["يَشْتَهُونَ","yang mereka inginkan","yashtahūna",1020],["كَمَا","sebagaimana","kamā",2],["فُعِلَ","dilakukan","fuʿila",127],["بِأَشْيَاعِهِم","dengan orang-orang yang serupa","bi-ashyāʿihim",760],["مِّن","dari","min",0],["قَبْلُ ۚ","sebelum/dahulu","qablu",51],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",8],["فِى","dalam","fī",3],["شَكٍّۢ","keragu-raguan","shakkin",615],["مُّرِيبٍۭ","kebimbangan","murībin",1089]],"t":"Dan diberi penghalang antara mereka dengan apa yang mereka inginkan sebagaimana yang dilakukan terhadap orang-orang yang sepaham dengan mereka yang terdahulu. Sesungguhnya mereka dahulu (di dunia) dalam keraguan yang mendalam."}]