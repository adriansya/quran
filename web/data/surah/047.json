[{"n":1,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["وَصَدُّوا۟","dan mereka menghalang-halangi","waṣaddū",332],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["أَضَلَّ","sesatkan","aḍalla",199],["أَعْمَـٰلَهُمْ","amal perbuatan mereka","aʿmālahum",184]],"t":"Orang-orang yang kafir dan menghalang-halangi (manusia) dari jalan Allah, maka Allah menghapus segala amal mereka."},{"n":2,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَعَمِلُوا۟","dan beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","shaleh/kebaikan","l-ṣāliḥāti",104],["وَءَامَنُوا۟","dan beriman","waāmanū",23],["بِمَا","dengan apa","bimā",6],["نُزِّلَ","diturunkan","nuzzila",207],["عَلَىٰ","atas","ʿalā",11],["مُحَمَّدٍۢ","Muhammad","muḥammadin",1614],["وَهُوَ","dan ia","wahuwa",25],["ٱلْحَقُّ","benar","l-ḥaqu",58],["مِن","dari","min",1],["رَّبِّهِمْ ۙ","Tuhan mereka","rabbihim",15],["كَفَّرَ","menghapus","kaffara",676],["عَنْهُمْ","dari mereka","ʿanhum",27],["سَيِّـَٔاتِهِمْ","kesalahan-kesalahan mereka","sayyiātihim",217],["وَأَصْلَحَ","dan memperbaiki","wa-aṣlaḥa",399],["بَالَهُمْ","keadaan mereka","bālahum",1556]],"t":"Dan orang-orang yang beriman (kepada Allah) dan mengerjakan kebajikan serta beriman kepada apa yang diturunkan kepada Muhammad, dan itulah kebenaran dari Tuhan mereka; Allah menghapus kesalahan-kesalahan mereka, dan memperbaiki keadaan mereka."},{"n":3,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّ","bahwa sesungguhnya","bi-anna",36],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["ٱتَّبَعُوا۟","mereka mengikuti","ittabaʿū",95],["ٱلْبَـٰطِلَ","yang bathil","l-bāṭila",425],["وَأَنَّ","dan sesungguhnya","wa-anna",36],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["ٱتَّبَعُوا۟","mereka mengikuti","ittabaʿū",95],["ٱلْحَقَّ","yang benar","l-ḥaqa",58],["مِن","dari","min",1],["رَّبِّهِمْ ۚ","Tuhan mereka","rabbihim",15],["كَذَٰلِكَ","demikian itu","kadhālika",26],["يَضْرِبُ","menjadikan","yaḍribu",230],["ٱللَّهُ","Allah","l-lahu",4],["لِلنَّاسِ","bagi manusia","lilnnāsi",60],["أَمْثَـٰلَهُمْ","peumpamaan mereka","amthālahum",138]],"t":"Yang demikian itu, karena sesungguhnya orang-orang kafir mengikuti yang batil (sesat), dan sesungguhnya orang-orang yang beriman mengikuti kebenaran dari Tuhan mereka. Demikianlah Allah membuat perumpamaan-perumpamaan bagi manusia."},{"n":4,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["لَقِيتُمُ","kamu bertemu","laqītumu",678],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["فَضَرْبَ","maka pancunglah","faḍarba",1781],["ٱلرِّقَابِ","batang leher","l-riqābi",942],["حَتَّىٰٓ","sehingga","ḥattā",91],["إِذَآ","apabila","idhā",29],["أَثْخَنتُمُوهُمْ","kamu mengalahkan mereka","athkhantumūhum",2196],["فَشُدُّوا۟","maka keraskan","fashuddū",1140],["ٱلْوَثَاقَ","ikatan","l-wathāqa",2742],["فَإِمَّا","maka adapun","fa-immā",459],["مَنًّۢا","kebebasan","mannan",1212],["بَعْدُ","sesudah itu","baʿdu",67],["وَإِمَّا","dan adapun","wa-immā",459],["فِدَآءً","tebusan","fidāan",3468],["حَتَّىٰ","sehingga","ḥattā",91],["تَضَعَ","meletakkan","taḍaʿa",507],["ٱلْحَرْبُ","perang","l-ḥarbu",1532],["أَوْزَارَهَا ۚ","menerima tebusan","awzārahā",763],["ذَٰلِكَ","demikianlah","dhālika",26],["وَلَوْ","dan jika","walaw",66],["يَشَآءُ","menghendaki","yashāu",62],["ٱللَّهُ","Allah","l-lahu",4],["لَٱنتَصَرَ","Dia tidak menolong","la-intaṣara",1136],["مِنْهُمْ","dari mereka","min'hum",1],["وَلَـٰكِن","tetapi","walākin",176],["لِّيَبْلُوَا۟","Dia hendak menguji","liyabluwā",522],["بَعْضَكُم","sebagian kamu","baʿḍakum",80],["بِبَعْضٍۢ ۗ","dengan sebagian","bibaʿḍin",80],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["قُتِلُوا۟","gugur","qutilū",149],["فِى","di","fī",7],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["فَلَن","maka tidak","falan",123],["يُضِلَّ","Dia menghilangkan","yuḍilla",199],["أَعْمَـٰلَهُمْ","amal perbuatan mereka","aʿmālahum",184]],"t":"Maka apabila kamu bertemu dengan orang-orang kafir (di medan perang), maka pukullah batang leher mereka. Selanjutnya apabila kamu telah mengalahkan mereka, tawanlah mereka, dan setelah itu kamu boleh membebaskan mereka atau menerima tebusan, sampai perang selesai. Demikianlah, dan sekiranya Allah menghendaki, niscaya Dia membinasakan mereka, tetapi Dia hendak menguji kamu satu sama lain. Dan orang-orang yang gugur di jalan Allah, maka Allah tidak akan menyia-nyiakan amal mereka."},{"n":5,"w":[["سَيَهْدِيهِمْ","Dia akan memberi petunjuk mereka","sayahdīhim",89],["وَيُصْلِحُ","dan Dia akan memperbaiki","wayuṣ'liḥu",399],["بَالَهُمْ","keadaan mereka","bālahum",1556]],"t":"Allah akan memberi petunjuk kepada mereka dan memperbaiki keadaan mereka,"},{"n":6,"w":[["وَيُدْخِلُهُمُ","dan Dia akan memasukkan mereka","wayud'khiluhumu",289],["ٱلْجَنَّةَ","surga","l-janata",86],["عَرَّفَهَا","telah Dia perkenalkannya","ʿarrafahā",2244],["لَهُمْ","bagi mereka","lahum",16]],"t":"dan memasukkan mereka ke dalam surga yang telah diperkenalkan-Nya kepada mereka."},{"n":7,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوٓا۟","beriman","āmanū",23],["إِن","jika","in",19],["تَنصُرُوا۟","menolong","tanṣurū",212],["ٱللَّهَ","Allah","l-laha",4],["يَنصُرْكُمْ","Dia akan menolongmu","yanṣur'kum",212],["وَيُثَبِّتْ","dan Dia akan meneguhkan","wayuthabbit",877],["أَقْدَامَكُمْ","kedudukanmu","aqdāmakum",1012]],"t":"Wahai orang-orang yang beriman! Jika kamu menolong (agama) Allah, niscaya Dia akan menolongmu dan meneguhkan kedudukanmu."},{"n":8,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["فَتَعْسًۭا","maka kesengsaraan","fataʿsan",4323],["لَّهُمْ","bagi mereka","lahum",16],["وَأَضَلَّ","dan Dia menyesatkan","wa-aḍalla",199],["أَعْمَـٰلَهُمْ","perbuatan mereka","aʿmālahum",184]],"t":"Dan orang-orang yang kafir, maka celakalah mereka, dan Allah menghapus segala amalnya."},{"n":9,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّهُمْ","karena sesungguhnya mereka","bi-annahum",36],["كَرِهُوا۟","mereka benci","karihū",586],["مَآ","apa yang","mā",6],["أَنزَلَ","menurunkan","anzala",71],["ٱللَّهُ","Allah","l-lahu",4],["فَأَحْبَطَ","maka Dia menghapus","fa-aḥbaṭa",1481],["أَعْمَـٰلَهُمْ","perbuatan mereka","aʿmālahum",184]],"t":"Yang demikian itu karena mereka membenci apa (Alquran) yang diturunkan Allah, maka Allah menghapus segala amal mereka."},{"n":10,"w":[["۞ أَفَلَمْ","apakah maka tidak","afalam",39],["يَسِيرُوا۟","mereka berjalan","yasīrū",616],["فِى","di muka","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["فَيَنظُرُوا۟","lalu mereka memperhatikan","fayanẓurū",139],["كَيْفَ","bagaimana","kayfa",148],["كَانَ","adalah","kāna",12],["عَـٰقِبَةُ","akibat","ʿāqibatu",367],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",59],["دَمَّرَ","membinasakan","dammara",988],["ٱللَّهُ","Allah","l-lahu",4],["عَلَيْهِمْ ۖ","atas mereka","ʿalayhim",11],["وَلِلْكَـٰفِرِينَ","dan bagi orang-orang yang kafir","walil'kāfirīna",79],["أَمْثَـٰلُهَا","seperti itu","amthāluhā",138]],"t":"Maka apakah mereka tidak pernah mengadakan perjalanan di bumi, sehingga dapat memperhatikan bagaimana kesudahan orang-orang yang sebelum mereka. Allah telah membinasakan mereka, dan bagi orang-orang kafir akan menerima (nasib) yang serupa."},{"n":11,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّ","karena sesungguhnya","bi-anna",36],["ٱللَّهَ","Allah","l-laha",4],["مَوْلَى","pelindung","mawlā",501],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَأَنَّ","dan sesungguhnya","wa-anna",36],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",79],["لَا","tidak ada","lā",8],["مَوْلَىٰ","pelindung","mawlā",501],["لَهُمْ","bagi mereka","lahum",16]],"t":"Yang demikian itu karena Allah pelindung bagi orang-orang yang beriman; sedang orang-orang kafir tidak ada pelindung bagi mereka."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["يُدْخِلُ","Dia memasukkan","yud'khilu",289],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","shaleh","l-ṣāliḥāti",104],["جَنَّـٰتٍۢ","surga","jannātin",86],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ ۖ","sungai-sungai","l-anhāru",233],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["يَتَمَتَّعُونَ","mereka bersenang-senang","yatamattaʿūna",816],["وَيَأْكُلُونَ","dan mereka makan","wayakulūna",127],["كَمَا","sebagaimana","kamā",6],["تَأْكُلُ","memakan","takulu",127],["ٱلْأَنْعَـٰمُ","binatang","l-anʿāmu",363],["وَٱلنَّارُ","dan api/neraka","wal-nāru",87],["مَثْوًۭى","tempat tinggal","mathwan",705],["لَّهُمْ","bagi mereka","lahum",16]],"t":"Sungguh, Allah akan memasukkan orang-orang yang beriman dan mengerjakan kebajikan ke dalam surga yang mengalir di bawahnya sungai-sungai. Dan orang-orang yang kafir menikmati kesenangan (dunia), dan mereka makan seperti hewan makan; dan (kelak) nerakalah tempat tinggal bagi mereka."},{"n":13,"w":[["وَكَأَيِّن","dan berapa banyak","waka-ayyin",1092],["مِّن","dari","min",1],["قَرْيَةٍ","negeri-negeri","qaryatin",222],["هِىَ","ia/negeri itu","hiya",203],["أَشَدُّ","sangat","ashaddu",376],["قُوَّةًۭ","kekuatan","quwwatan",386],["مِّن","dari pada","min",1],["قَرْيَتِكَ","negerimu","qaryatika",222],["ٱلَّتِىٓ","yang","allatī",195],["أَخْرَجَتْكَ","mengusirmu","akhrajatka",125],["أَهْلَكْنَـٰهُمْ","Kami membinasakan mereka","ahlaknāhum",243],["فَلَا","maka tidak ada","falā",8],["نَاصِرَ","seorang penolong","nāṣira",805],["لَهُمْ","bagi mereka","lahum",16]],"t":"Dan betapa banyak negeri yang (penduduknya) lebih kuat dari (penduduk) negerimu (Muhammad) yang telah mengusirmu. Kami telah membinasakan mereka; maka tidak ada seorang pun yang menolong mereka."},{"n":14,"w":[["أَفَمَن","apakah maka orang","afaman",17],["كَانَ","adalah ia","kāna",12],["عَلَىٰ","atas","ʿalā",11],["بَيِّنَةٍۢ","keterangan yang nyata","bayyinatin",185],["مِّن","dari","min",1],["رَّبِّهِۦ","Tuhannya","rabbihi",15],["كَمَن","seperti","kaman",17],["زُيِّنَ","dijadikan memandang baik","zuyyina",432],["لَهُۥ","baginya","lahu",21],["سُوٓءُ","seburuk-buruk","sūu",251],["عَمَلِهِۦ","perbuatannya","ʿamalihi",184],["وَٱتَّبَعُوٓا۟","dan mereka mengikuti","wa-ittabaʿū",95],["أَهْوَآءَهُم","hawa nafsu mereka","ahwāahum",585]],"t":"Maka apakah orang yang berpegang pada keterangan yang datang dari Tuhannya sama dengan orang yang dijadikan terasa indah baginya perbuatan buruknya dan mengikuti keinginannya?"},{"n":15,"w":[["مَّثَلُ","perumpamaan","mathalu",138],["ٱلْجَنَّةِ","surga","l-janati",86],["ٱلَّتِى","yang","allatī",195],["وُعِدَ","dijanjikan","wuʿida",190],["ٱلْمُتَّقُونَ ۖ","orang-orang yang bertakwa","l-mutaqūna",257],["فِيهَآ","didalamnya","fīhā",7],["أَنْهَـٰرٌۭ","sungai-sungai","anhārun",233],["مِّن","dari","min",1],["مَّآءٍ","air","māin",204],["غَيْرِ","tidak","ghayri",85],["ءَاسِنٍۢ","berubah","āsinin",2882],["وَأَنْهَـٰرٌۭ","dan sungai-sungai","wa-anhārun",233],["مِّن","dari","min",1],["لَّبَنٍۢ","air susu","labanin",2454],["لَّمْ","tidak","lam",39],["يَتَغَيَّرْ","berubah","yataghayyar",4367],["طَعْمُهُۥ","rasanya","ṭaʿmuhu",3297],["وَأَنْهَـٰرٌۭ","dan sungai-sungai","wa-anhārun",233],["مِّنْ","dari","min",1],["خَمْرٍۢ","kahmar","khamrin",1264],["لَّذَّةٍۢ","lezat rasanya","ladhatin",2444],["لِّلشَّـٰرِبِينَ","bagi orang-orang yang meminum","lilshāribīna",1281],["وَأَنْهَـٰرٌۭ","dan sungai-sungai","wa-anhārun",233],["مِّنْ","dari","min",1],["عَسَلٍۢ","madu","ʿasalin",3124],["مُّصَفًّۭى ۖ","jernih/bening","muṣaffan",3969],["وَلَهُمْ","dan bagi mereka","walahum",16],["فِيهَا","didalamnya","fīhā",7],["مِن","dari","min",1],["كُلِّ","segala","kulli",38],["ٱلثَّمَرَٰتِ","buah-buahan","l-thamarāti",594],["وَمَغْفِرَةٌۭ","dan ampunan","wamaghfiratun",406],["مِّن","dari","min",1],["رَّبِّهِمْ ۖ","Tuhan mereka","rabbihim",15],["كَمَنْ","seperti orang","kaman",17],["هُوَ","ia","huwa",25],["خَـٰلِدٌۭ","kekal","khālidun",173],["فِى","di dalam","fī",7],["ٱلنَّارِ","neraka","l-nāri",87],["وَسُقُوا۟","dan mereka diberi minum","wasuqū",760],["مَآءً","air","māan",204],["حَمِيمًۭا","mendidih","ḥamīman",517],["فَقَطَّعَ","maka terpotong-potong","faqaṭṭaʿa",757],["أَمْعَآءَهُمْ","isi perut mereka","amʿāahum",3776]],"t":"Perumpamaan taman surga yang dijanjikan kepada orang-orang yang bertakwa; di sana ada sungai-sungai yang airnya tidak payau, dan sungai-sungai air susu yang tidak berubah rasanya, dan sungai-sungai khamar (anggur yang tidak memabukkan) yang lezat rasanya bagi peminumnya, dan sungai-sungai madu yang murni. Di dalamnya mereka memperoleh segala macam buah-buahan, dan ampunan dari Tuhan mereka. Samakah mereka dengan orang yang kekal dalam neraka, dan diberi minuman dengan air yang mendidih, sehingga ususnya terpotong-potong?"},{"n":16,"w":[["وَمِنْهُم","dan diantara mereka","wamin'hum",1],["مَّن","orang","man",17],["يَسْتَمِعُ","dia mendengarkan","yastamiʿu",623],["إِلَيْكَ","kepadamu","ilayka",18],["حَتَّىٰٓ","sehingga","ḥattā",91],["إِذَا","apabila","idhā",29],["خَرَجُوا۟","mereka keluar","kharajū",237],["مِنْ","dari","min",1],["عِندِكَ","sisimu","ʿindika",68],["قَالُوا۟","mereka berkata","qālū",10],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",13],["أُوتُوا۟","mereka di beri","ūtū",53],["ٱلْعِلْمَ","pengetahuan","l-ʿil'ma",122],["مَاذَا","apakah","mādhā",428],["قَالَ","berkata","qāla",10],["ءَانِفًا ۚ","kemarin/tadi","ānifan",2881],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["طَبَعَ","menutup mati","ṭabaʿa",789],["ٱللَّهُ","Allah","l-lahu",4],["عَلَىٰ","atas","ʿalā",11],["قُلُوبِهِمْ","hati mereka","qulūbihim",98],["وَٱتَّبَعُوٓا۟","dan mereka mengikuti","wa-ittabaʿū",95],["أَهْوَآءَهُمْ","hawa nafsu mereka","ahwāahum",585]],"t":"Dan di antara mereka ada orang yang mendengarkan perkataanmu (Muhammad), tetapi apabila mereka telah keluar dari sisimu, mereka berkata kepada orang yang telah diberi ilmu (sahabat-sahabat Nabi), \"Apakah yang dikatakannya tadi?\" Mereka itulah orang-orang yang dikunci hatinya oleh Allah, dan mengikuti keinginannya."},{"n":17,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["ٱهْتَدَوْا۟","mereka mendapat petunjuk","ih'tadaw",313],["زَادَهُمْ","Dia menambah mereka","zādahum",259],["هُدًۭى","petunjuk","hudan",143],["وَءَاتَىٰهُمْ","dan Dia memberi mereka","waātāhum",53],["تَقْوَىٰهُمْ","ketakwaan mereka","taqwāhum",592]],"t":"Dan orang-orang yang mendapat petunjuk, Allah akan menambah petunjuk kepada mereka dan menganugerahi ketakwaan pada mereka."},{"n":18,"w":[["فَهَلْ","maka tidaklah","fahal",128],["يَنظُرُونَ","mereka menunggu-nunggu","yanẓurūna",139],["إِلَّا","kecuali","illā",20],["ٱلسَّاعَةَ","hari kiamat","l-sāʿata",263],["أَن","bahwa","an",22],["تَأْتِيَهُم","ia datang kepada mereka","tatiyahum",56],["بَغْتَةًۭ ۖ","tiba-tiba","baghtatan",697],["فَقَدْ","maka sesungguhnya","faqad",30],["جَآءَ","telah datang","jāa",51],["أَشْرَاطُهَا ۚ","syarat-syarat","ashrāṭuhā",2848],["فَأَنَّىٰ","maka bagaimana","fa-annā",401],["لَهُمْ","bagi mereka","lahum",16],["إِذَا","apabila","idhā",29],["جَآءَتْهُمْ","ia datang kepada mereka","jāathum",51],["ذِكْرَىٰهُمْ","peringatan mereka","dhik'rāhum",458]],"t":"Maka apalagi yang mereka tunggu-tunggu selain hari Kiamat, yang akan datang kepada mereka secara tiba-tiba, karena tanda-tandanya sungguh telah datang. Maka apa gunanya bagi mereka kesadaran mereka itu, apabila (hari Kiamat) itu sudah datang?"},{"n":19,"w":[["فَٱعْلَمْ","maka ketahuilah","fa-iʿ'lam",35],["أَنَّهُۥ","bahwa sesungguhnya","annahu",36],["لَآ","tidak ada","lā",8],["إِلَـٰهَ","Tuhan","ilāha",84],["إِلَّا","kecuali","illā",20],["ٱللَّهُ","Allah","l-lahu",4],["وَٱسْتَغْفِرْ","dan mohonlah ampun","wa-is'taghfir",314],["لِذَنۢبِكَ","bagi dosamu","lidhanbika",329],["وَلِلْمُؤْمِنِينَ","dan bagi orang-orang mukmin","walil'mu'minīna",63],["وَٱلْمُؤْمِنَـٰتِ ۗ","dan orang-orang perempuan beriman","wal-mu'mināti",63],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَعْلَمُ","mengetahui","yaʿlamu",35],["مُتَقَلَّبَكُمْ","tempat berpindahmu","mutaqallabakum",3894],["وَمَثْوَىٰكُمْ","dan tempat tinggalmu","wamathwākum",705]],"t":"Maka ketahuilah, bahwa tidak ada tuhan (yang patut disembah) selain Allah, dan mohonlah ampunan atas dosamu dan atas (dosa) orang-orang mukmin, laki-laki dan perempuan. Dan Allah mengetahui tempat usaha dan tempat tinggalmu."},{"n":20,"w":[["وَيَقُولُ","dan berkata","wayaqūlu",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["لَوْلَا","mengapa tidak","lawlā",167],["نُزِّلَتْ","diturunkan","nuzzilat",207],["سُورَةٌۭ ۖ","suatu surat","sūratun",875],["فَإِذَآ","maka apabila","fa-idhā",29],["أُنزِلَتْ","diturunkan","unzilat",71],["سُورَةٌۭ","suatu surat","sūratun",875],["مُّحْكَمَةٌۭ","jelas maksudnya","muḥ'kamatun",2554],["وَذُكِرَ","dan disebutkan","wadhukira",144],["فِيهَا","didalamnya","fīhā",7],["ٱلْقِتَالُ ۙ","perang","l-qitālu",710],["رَأَيْتَ","kamu lihat","ra-ayta",54],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["فِى","didalam","fī",7],["قُلُوبِهِم","hati mereka","qulūbihim",98],["مَّرَضٌۭ","penyakit","maraḍun",708],["يَنظُرُونَ","mereka memandang","yanẓurūna",139],["إِلَيْكَ","kepadamu","ilayka",18],["نَظَرَ","pandangan","naẓara",4030],["ٱلْمَغْشِىِّ","pingsan","l-maghshiyi",3706],["عَلَيْهِ","atasnya","ʿalayhi",11],["مِنَ","dari","mina",1],["ٱلْمَوْتِ ۖ","kematian","l-mawti",249],["فَأَوْلَىٰ","maka lebih utama","fa-awlā",778],["لَهُمْ","bagi mereka","lahum",16]],"t":"Dan orang-orang yang beriman berkata, \"Mengapa tidak ada suatu surah (tentang perintah jihad) yang diturunkan?\" Maka apabila ada suatu surah diturunkan yang jelas maksudnya dan di dalamnya terdapat (perintah) perang, engkau melihat orang-orang yang di dalam hatinya ada penyakit akan memandang kepadamu seperti pandangan orang yang pingsan karena takut mati. Tetapi itu lebih pantas bagi mereka."},{"n":21,"w":[["طَاعَةٌۭ","ketaatan","ṭāʿatun",1825],["وَقَوْلٌۭ","dan perkataan","waqawlun",129],["مَّعْرُوفٌۭ ۚ","yang baik","maʿrūfun",323],["فَإِذَا","maka apabila","fa-idhā",29],["عَزَمَ","menjadi ketetapan","ʿazama",1521],["ٱلْأَمْرُ","perintah","l-amru",75],["فَلَوْ","maka jika","falaw",66],["صَدَقُوا۟","mereka benar","ṣadaqū",635],["ٱللَّهَ","Allah","l-laha",4],["لَكَانَ","tentu adalah","lakāna",12],["خَيْرًۭا","lebih baik","khayran",69],["لَّهُمْ","bagi mereka","lahum",16]],"t":"(Yang lebih baik bagi mereka adalah) taat (kepada Allah) dan bertutur kata yang baik. Sebab apabila perintah (perang) ditetapkan (mereka tidak menyukainya). Padahal jika mereka benar-benar (beriman) kepada Allah, niscaya yang demikian itu lebih baik bagi mereka."},{"n":22,"w":[["فَهَلْ","maka apakah","fahal",128],["عَسَيْتُمْ","sekiranya kamu","ʿasaytum",381],["إِن","jika","in",19],["تَوَلَّيْتُمْ","kamu berkuasa","tawallaytum",160],["أَن","bahwa","an",22],["تُفْسِدُوا۟","kalian membuat kerusakan","tuf'sidū",627],["فِى","di muka","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَتُقَطِّعُوٓا۟","dan kamu memutuskan","watuqaṭṭiʿū",757],["أَرْحَامَكُمْ","hubungan keluargamu","arḥāmakum",758]],"t":"Maka apakah sekiranya kamu berkuasa, lalu kamu akan berbuat kerusakan di bumi dan memutuskan hubungan kekeluargaan?"},{"n":23,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["لَعَنَهُمُ","mengutuk mereka","laʿanahumu",466],["ٱللَّهُ","Allah","l-lahu",4],["فَأَصَمَّهُمْ","lalu Dia tulikan mereka","fa-aṣammahum",2944],["وَأَعْمَىٰٓ","dan membutakan","wa-aʿmā",1061],["أَبْصَـٰرَهُمْ","mata mereka","abṣārahum",260]],"t":"Mereka itulah orang-orang yang dikutuk Allah; lalu dibuat tuli (pendengarannya) dan dibutakan penglihatannya."},{"n":24,"w":[["أَفَلَا","apakah maka tidak","afalā",8],["يَتَدَبَّرُونَ","mereka memperhatikan","yatadabbarūna",1680],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",189],["أَمْ","atau","am",93],["عَلَىٰ","atas","ʿalā",11],["قُلُوبٍ","hati","qulūbin",98],["أَقْفَالُهَآ","kuncinya","aqfāluhā",4148]],"t":"Maka tidakkah mereka menghayati Alquran, ataukah hati mereka sudah terkunci?"},{"n":25,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ٱرْتَدُّوا۟","mereka kembali","ir'taddū",1035],["عَلَىٰٓ","atas","ʿalā",11],["أَدْبَـٰرِهِم","belakang mereka","adbārihim",560],["مِّنۢ","dari","min",1],["بَعْدِ","sesudah","baʿdi",67],["مَا","apa","mā",6],["تَبَيَّنَ","menjadi jelas","tabayyana",568],["لَهُمُ","bagi mereka","lahumu",16],["ٱلْهُدَى ۙ","petunjuk","l-hudā",143],["ٱلشَّيْطَـٰنُ","syaitan","l-shayṭānu",134],["سَوَّلَ","menggoda","sawwala",1670],["لَهُمْ","bagi mereka","lahum",16],["وَأَمْلَىٰ","dan memanjangkan angan-angan","wa-amlā",891],["لَهُمْ","bagi mereka","lahum",16]],"t":"Sesungguhnya orang-orang yang berbalik (kepada kekafiran) setelah petunjuk itu jelas bagi mereka, setanlah yang merayu mereka dan memanjangkan angan-angan mereka."},{"n":26,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّهُمْ","karena sesungguhnya mereka","bi-annahum",36],["قَالُوا۟","mereka berkata","qālū",10],["لِلَّذِينَ","kepada orang-orang","lilladhīna",13],["كَرِهُوا۟","mereka benci","karihū",586],["مَا","apa-apa","mā",6],["نَزَّلَ","yang menurunkan","nazzala",207],["ٱللَّهُ","Allah","l-lahu",4],["سَنُطِيعُكُمْ","kami akan mematuhi kamu","sanuṭīʿukum",177],["فِى","pada","fī",7],["بَعْضِ","sebagian","baʿḍi",80],["ٱلْأَمْرِ ۖ","urusan/perkara","l-amri",75],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَعْلَمُ","mengetahui","yaʿlamu",35],["إِسْرَارَهُمْ","rahasia mereka","is'rārahum",2141]],"t":"Yang demikian itu, karena sesungguhnya mereka telah mengatakan kepada orang-orang (Yahudi) yang tidak senang kepada apa yang diturunkan Allah, \"Kami akan mematuhi kamu dalam beberapa urusan,\" tetapi Allah mengetahui rahasia mereka."},{"n":27,"w":[["فَكَيْفَ","maka bagaimana","fakayfa",148],["إِذَا","apabila","idhā",29],["تَوَفَّتْهُمُ","mewafatkan mereka","tawaffathumu",455],["ٱلْمَلَـٰٓئِكَةُ","malaikat","l-malāikatu",137],["يَضْرِبُونَ","mereka memukul","yaḍribūna",230],["وُجُوهَهُمْ","muka mereka","wujūhahum",180],["وَأَدْبَـٰرَهُمْ","dan punggung mereka","wa-adbārahum",560]],"t":"Maka bagaimana (nasib mereka) apabila malaikat (maut) mencabut nyawa mereka, memukul wajah dan punggung mereka?"},{"n":28,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّهُمُ","karena sesungguhnya mereka","bi-annahumu",36],["ٱتَّبَعُوا۟","mereka mengikuti","ittabaʿū",95],["مَآ","apa-apa","mā",6],["أَسْخَطَ","yang menjadikan kemurkaan","askhaṭa",3024],["ٱللَّهَ","Allah","l-laha",4],["وَكَرِهُوا۟","dan mereka benci","wakarihū",586],["رِضْوَٰنَهُۥ","keridaan-Nya","riḍ'wānahu",711],["فَأَحْبَطَ","maka (Allah) menghapus","fa-aḥbaṭa",1481],["أَعْمَـٰلَهُمْ","amal perbuatan mereka","aʿmālahum",184]],"t":"Yang demikian itu, karena sesungguhnya mereka mengikuti apa yang menimbulkan kemurkaan Allah dan membenci (apa yang menimbulkan) keridaan-Nya; sebab itu Allah menghapus segala amal mereka."},{"n":29,"w":[["أَمْ","atau","am",93],["حَسِبَ","mengira","ḥasiba",280],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["فِى","dalam","fī",7],["قُلُوبِهِم","hati mereka","qulūbihim",98],["مَّرَضٌ","penyakit","maraḍun",708],["أَن","bahwa","an",22],["لَّن","tidak","lan",123],["يُخْرِجَ","mengeluarkan","yukh'rija",125],["ٱللَّهُ","Allah","l-lahu",4],["أَضْغَـٰنَهُمْ","kedengkian mereka","aḍghānahum",2217]],"t":"Atau apakah orang-orang yang dalam hatinya ada penyakit mengira bahwa Allah tidak akan menampakkan kedengkian mereka?"},{"n":30,"w":[["وَلَوْ","dan walaupun","walaw",66],["نَشَآءُ","Kami menghendaki","nashāu",62],["لَأَرَيْنَـٰكَهُمْ","sungguh Kami perlihatkan mereka kepadamu","la-araynākahum",305],["فَلَعَرَفْتَهُم","maka sungguh kamu mengenal mereka","falaʿaraftahum",515],["بِسِيمَـٰهُمْ ۚ","dengan tanda-tanda mereka","bisīmāhum",1246],["وَلَتَعْرِفَنَّهُمْ","dan sungguh kamu mengenal mereka","walataʿrifannahum",515],["فِى","dalam","fī",7],["لَحْنِ","lagu/tata bahasa","laḥni",3633],["ٱلْقَوْلِ ۚ","perkataan","l-qawli",129],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَعْلَمُ","mengetahui","yaʿlamu",35],["أَعْمَـٰلَكُمْ","perbuatan/amalan kamu","aʿmālakum",184]],"t":"Dan sekiranya Kami menghendaki, niscaya Kami perlihatkan mereka kepadamu (Muhammad) sehingga engkau benar-benar dapat mengenal mereka dengan tanda-tandanya. Dan engkau benar-benar akan mengenal mereka dari nada bicaranya, dan Allah mengetahui segala perbuatan kamu."},{"n":31,"w":[["وَلَنَبْلُوَنَّكُمْ","dan sungguh Kami akan menguji kamu","walanabluwannakum",522],["حَتَّىٰ","hingga","ḥattā",91],["نَعْلَمَ","Kami mengetahui","naʿlama",35],["ٱلْمُجَـٰهِدِينَ","orang-orang yang berjihad/berjuang","l-mujāhidīna",1617],["مِنكُمْ","diantara kamu","minkum",1],["وَٱلصَّـٰبِرِينَ","dan orang-orang yang sabar","wal-ṣābirīna",474],["وَنَبْلُوَا۟","dan Kami akan menguji","wanabluwā",522],["أَخْبَارَكُمْ","beritahu/hal ihwalmu","akhbārakum",1772]],"t":"Dan sungguh, Kami benar-benar akan menguji kamu sehingga Kami mengetahui orang-orang yang benar-benar berjihad dan bersabar di antara kamu; dan akan Kami uji perihal kamu."},{"n":32,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["وَصَدُّوا۟","dan mereka menghalangi","waṣaddū",332],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["وَشَآقُّوا۟","dan mereka menentang","washāqqū",1039],["ٱلرَّسُولَ","rasul","l-rasūla",42],["مِنۢ","dari","min",1],["بَعْدِ","sesudah","baʿdi",67],["مَا","apa-apa","mā",6],["تَبَيَّنَ","menjadi jelas","tabayyana",568],["لَهُمُ","bagi mereka","lahumu",16],["ٱلْهُدَىٰ","petunjuk","l-hudā",143],["لَن","tidak","lan",123],["يَضُرُّوا۟","mereka dapat memberi mudarat","yaḍurrū",536],["ٱللَّهَ","Allah","l-laha",4],["شَيْـًۭٔا","sesuatu","shayan",49],["وَسَيُحْبِطُ","dan (Allah) akan menghapuskan","wasayuḥ'biṭu",1481],["أَعْمَـٰلَهُمْ","amal perbuatan mereka","aʿmālahum",184]],"t":"Sesungguhnya orang-orang yang kafir dan menghalang-halangi (orang lain) dari jalan Allah serta memusuhi rasul setelah ada petunjuk yang jelas bagi mereka, mereka tidak akan dapat memberi mudarat (bahaya) kepada Allah sedikit pun. Dan kelak Allah akan menghapus segala amal mereka."},{"n":33,"w":[["۞ يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوٓا۟","beriman","āmanū",23],["أَطِيعُوا۟","taatlah kamu","aṭīʿū",177],["ٱللَّهَ","Allah","l-laha",4],["وَأَطِيعُوا۟","dan taatlah","wa-aṭīʿū",177],["ٱلرَّسُولَ","rasul","l-rasūla",42],["وَلَا","dan tidak","walā",8],["تُبْطِلُوٓا۟","kamu merusakkan","tub'ṭilū",1485],["أَعْمَـٰلَكُمْ","amal perbuatan kamu","aʿmālakum",184]],"t":"Wahai orang-orang yang beriman! Taatlah kepada Allah dan taatlah kepada Rasul, dan janganlah kamu merusakkan segala amalmu!"},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["وَصَدُّوا۟","dan mereka menghalangi","waṣaddū",332],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["ثُمَّ","kemudian","thumma",41],["مَاتُوا۟","mati","mātū",322],["وَهُمْ","dan mereka","wahum",16],["كُفَّارٌۭ","kafir/membangkang","kuffārun",79],["فَلَن","maka tidak","falan",123],["يَغْفِرَ","mengampuni","yaghfira",197],["ٱللَّهُ","Allah","l-lahu",4],["لَهُمْ","bagi mereka","lahum",16]],"t":"Sesungguhnya orang-orang yang kafir dan menghalang-halangi (orang lain) dari jalan Allah, kemudian mereka mati dalam keadaan kafir, maka Allah tidak akan mengampuni mereka."},{"n":35,"w":[["فَلَا","maka janganlah","falā",8],["تَهِنُوا۟","kamu lemah","tahinū",1440],["وَتَدْعُوٓا۟","dan kamu menyeru/minta","watadʿū",74],["إِلَى","kepada","ilā",18],["ٱلسَّلْمِ","damai","l-salmi",2677],["وَأَنتُمُ","dan kalian","wa-antumu",96],["ٱلْأَعْلَوْنَ","yang diatas","l-aʿlawna",776],["وَٱللَّهُ","dan Allah","wal-lahu",4],["مَعَكُمْ","beserta kamu","maʿakum",78],["وَلَن","dan tidak","walan",123],["يَتِرَكُمْ","akan mengurangi kamu","yatirakum",4505],["أَعْمَـٰلَكُمْ","amal perbuatanmu","aʿmālakum",184]],"t":"Maka janganlah kamu lemah dan mengajak damai, karena kamulah yang lebih unggul, dan Allah (pun) bersama kamu, dan Dia tidak akan mengurangi segala amalmu."},{"n":36,"w":[["إِنَّمَا","sesungguhnya","innamā",9],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["لَعِبٌۭ","permainan","laʿibun",997],["وَلَهْوٌۭ ۚ","dan senda gurau","walahwun",854],["وَإِن","dan jika","wa-in",19],["تُؤْمِنُوا۟","kamu beriman","tu'minū",23],["وَتَتَّقُوا۟","dan bertaqwa","watattaqū",76],["يُؤْتِكُمْ","Dia akan memberi padamu","yu'tikum",53],["أُجُورَكُمْ","pahalamu","ujūrakum",121],["وَلَا","dan tidak","walā",8],["يَسْـَٔلْكُمْ","meminta kepadamu","yasalkum",119],["أَمْوَٰلَكُمْ","harta-harta kamu","amwālakum",141]],"t":"Sesungguhnya kehidupan dunia itu hanyalah permainan dan senda gurau. Jika kamu beriman serta bertakwa, Allah akan memberikan pahala kepadamu, dan Dia tidak akan meminta hartamu."},{"n":37,"w":[["إِن","jika","in",19],["يَسْـَٔلْكُمُوهَا","Dia meminta kepadamu","yasalkumūhā",119],["فَيُحْفِكُمْ","lalu Dia mendesakmu","fayuḥ'fikum",2937],["تَبْخَلُوا۟","kamu akan kikir","tabkhalū",845],["وَيُخْرِجْ","dan Dia mengeluarkan/menampakkan","wayukh'rij",125],["أَضْغَـٰنَكُمْ","kedengkianmu/kebencianmu","aḍghānakum",2217]],"t":"Sekiranya Dia meminta harta kepadamu lalu mendesak kamu (agar memberikan semuanya) niscaya kamu akan kikir, dan Dia akan menampakkan kedengkianmu."},{"n":38,"w":[["هَـٰٓأَنتُمْ","ingatlah kamu","hāantum",96],["هَـٰٓؤُلَآءِ","mereka/orang-orang ini","hāulāi",269],["تُدْعَوْنَ","kamu diseru/diajak","tud'ʿawna",74],["لِتُنفِقُوا۟","untuk/agar kamu menafkahkan","litunfiqū",193],["فِى","pada","fī",7],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["فَمِنكُم","maka diantara kamu","faminkum",1],["مَّن","orang-orang","man",17],["يَبْخَلُ ۖ","ia kirik","yabkhalu",845],["وَمَن","dan orang-orang","waman",17],["يَبْخَلْ","ia kirik","yabkhal",845],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",9],["يَبْخَلُ","ia kikir","yabkhalu",845],["عَن","dari","ʿan",27],["نَّفْسِهِۦ ۚ","dirinya sendiri","nafsihi",47],["وَٱللَّهُ","dan Allah","wal-lahu",4],["ٱلْغَنِىُّ","Maha Kaya","l-ghaniyu",453],["وَأَنتُمُ","dan kalian","wa-antumu",96],["ٱلْفُقَرَآءُ ۚ","fakir/berkeperluan","l-fuqarāu",745],["وَإِن","dan jika","wa-in",19],["تَتَوَلَّوْا۟","kamu berpaling","tatawallaw",160],["يَسْتَبْدِلْ","Dia mengganti","yastabdil",2100],["قَوْمًا","kaum","qawman",33],["غَيْرَكُمْ","selain kamu","ghayrakum",85],["ثُمَّ","kemudian","thumma",41],["لَا","tidak","lā",8],["يَكُونُوٓا۟","adalah mereka","yakūnū",12],["أَمْثَـٰلَكُم","seperti kamu","amthālakum",138]],"t":"Ingatlah, kamu adalah orang-orang yang diajak untuk menginfakkan (hartamu) di jalan Allah. Lalu di antara kamu ada orang yang kikir, dan barangsiapa kikir maka sesungguhnya dia kikir terhadap dirinya sendiri. Dan Allah lah Yang Mahakaya, dan kamulah yang membutuhkan (karunia-Nya). Dan jika kamu berpaling (dari jalan yang benar) Dia akan menggantikan (kamu) dengan kaum yang lain, dan mereka tidak akan (durhaka) seperti kamu."}]