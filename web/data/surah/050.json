[{"n":1,"w":[["قٓ ۚ","Qâf","qaf",3233],["وَٱلْقُرْءَانِ","demi Al Qur'an","wal-qur'āni",189],["ٱلْمَجِيدِ","yang mulia","l-majīdi",1625]],"t":"Qāf. Demi Alquran yang mulia."},{"n":2,"w":[["بَلْ","bahkan","bal",105],["عَجِبُوٓا۟","mereka heran","ʿajibū",973],["أَن","bahwa","an",22],["جَآءَهُم","telah datang pada mereka","jāahum",51],["مُّنذِرٌۭ","seorang pemberi peringatan","mundhirun",645],["مِّنْهُمْ","dari mereka","min'hum",1],["فَقَالَ","maka berkata","faqāla",10],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",79],["هَـٰذَا","ini","hādhā",64],["شَىْءٌ","sesuatu","shayon",49],["عَجِيبٌ","sangat aneh","ʿajībun",2233]],"t":"(Mereka tidak menerimanya) bahkan mereka tercengang karena telah datang kepada mereka seorang pemberi peringatan dari (kalangan) mereka sendiri, maka berkatalah orang-orang kafir, \"Ini adalah sesuatu yang sangat ajaib.\""},{"n":3,"w":[["أَءِذَا","apakah apabila","a-idhā",29],["مِتْنَا","kami telah mati","mit'nā",322],["وَكُنَّا","dan kami adalah","wakunnā",12],["تُرَابًۭا ۖ","tanah/debu","turāban",593],["ذَٰلِكَ","demikian itu","dhālika",26],["رَجْعٌۢ","pengembalian","rajʿun",2006],["بَعِيدٌۭ","yang jauh","baʿīdun",438]],"t":"Apakah apabila kami telah mati dan sudah menjadi tanah (akan kembali lagi)? Itu adalah suatu pengembalian yang tidak mungkin."},{"n":4,"w":[["قَدْ","sesungguhnya","qad",30],["عَلِمْنَا","Kami mengetahui","ʿalim'nā",35],["مَا","apa yang","mā",6],["تَنقُصُ","merusak","tanquṣu",1107],["ٱلْأَرْضُ","bumi","l-arḍu",28],["مِنْهُمْ ۖ","dari mereka","min'hum",1],["وَعِندَنَا","dan di sisi Kami","waʿindanā",68],["كِتَـٰبٌ","kitab","kitābun",57],["حَفِيظٌۢ","penjaga","ḥafīẓun",736]],"t":"Sungguh, Kami telah mengetahui apa yang ditelan bumi dari (tubuh) mereka, sebab pada Kami ada kitab (catatan) yang terpelihara baik."},{"n":5,"w":[["بَلْ","bahkan/tetapi","bal",105],["كَذَّبُوا۟","mereka telah mendustakan","kadhabū",72],["بِٱلْحَقِّ","dengan kebenaran","bil-ḥaqi",58],["لَمَّا","tatkala","lammā",81],["جَآءَهُمْ","datang kepada mereka","jāahum",51],["فَهُمْ","maka mereka","fahum",16],["فِىٓ","dalam","fī",7],["أَمْرٍۢ","perkara","amrin",75],["مَّرِيجٍ","bingung","marījin",3940]],"t":"Bahkan mereka telah mendustakan kebenaran ketika (kebenaran itu) datang kepada mereka, maka mereka berada dalam keadaan kacau balau."},{"n":6,"w":[["أَفَلَمْ","maka apakah tidak","afalam",39],["يَنظُرُوٓا۟","kamu melihat","yanẓurū",139],["إِلَى","kepada","ilā",18],["ٱلسَّمَآءِ","langit","l-samāi",44],["فَوْقَهُمْ","di atas mereka","fawqahum",301],["كَيْفَ","bagaimana","kayfa",148],["بَنَيْنَـٰهَا","diantaranya","banaynāhā",792],["وَزَيَّنَّـٰهَا","dan Kami menghiasinya","wazayyannāhā",432],["وَمَا","dan tidaklah","wamā",6],["لَهَا","baginya","lahā",106],["مِن","dari","min",1],["فُرُوجٍۢ","retak-retak","furūjin",989]],"t":"Maka tidakkah mereka memperhatikan langit yang ada di atas mereka, bagaimana cara Kami membangunnya dan menghiasinya, dan tidak terdapat retak-retak sedikit pun?"},{"n":7,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["مَدَدْنَـٰهَا","Kami hamparkannya","madadnāhā",703],["وَأَلْقَيْنَا","dan Kami letakkan","wa-alqaynā",183],["فِيهَا","didalamnya","fīhā",7],["رَوَٰسِىَ","gunung-gunung","rawāsiya",870],["وَأَنۢبَتْنَا","dan Kami tumbuhkan","wa-anbatnā",600],["فِيهَا","didalamnya","fīhā",7],["مِن","dari","min",1],["كُلِّ","setiap","kulli",38],["زَوْجٍۭ","pasangan","zawjin",166],["بَهِيجٍۢ","indah/bagus","bahījin",2343]],"t":"Dan bumi yang Kami hamparkan dan Kami pancangkan di atasnya gunung-gunung yang kokoh, dan Kami tumbuhkan di atasnya tanam-tanaman yang indah,"},{"n":8,"w":[["تَبْصِرَةًۭ","pemandangan","tabṣiratan",4348],["وَذِكْرَىٰ","dan pengajaran","wadhik'rā",458],["لِكُلِّ","bagi setiap","likulli",38],["عَبْدٍۢ","hamba","ʿabdin",99],["مُّنِيبٍۢ","orang yang kembali","munībin",1105]],"t":"untuk menjadi pelajaran dan peringatan bagi setiap hamba yang kembali (tunduk kepada Allah)."},{"n":9,"w":[["وَنَزَّلْنَا","dan Kami turunkan","wanazzalnā",207],["مِنَ","dari","mina",1],["ٱلسَّمَآءِ","langit","l-samāi",44],["مَآءًۭ","air","māan",204],["مُّبَـٰرَكًۭا","penuh keberkatan","mubārakan",1004],["فَأَنۢبَتْنَا","lalu Kami tumbuhkan","fa-anbatnā",600],["بِهِۦ","dengannya","bihi",21],["جَنَّـٰتٍۢ","kebun-kebun","jannātin",86],["وَحَبَّ","dan biji-biji","waḥabba",1068],["ٱلْحَصِيدِ","diketam","l-ḥaṣīdi",1530]],"t":"Dan dari langit Kami turunkan air yang memberi berkah, lalu Kami tumbuhkan dengan (air) itu pepohonan yang rindang dan biji-bijian yang dapat dipanen,"},{"n":10,"w":[["وَٱلنَّخْلَ","dan pohon kurma","wal-nakhla",564],["بَاسِقَـٰتٍۢ","tinggi menjulang","bāsiqātin",3336],["لَّهَا","baginya","lahā",106],["طَلْعٌۭ","mayang","ṭalʿun",1549],["نَّضِيدٌۭ","bersusun-susun","naḍīdun",4077]],"t":"dan pohon kurma yang tinggi-tinggi yang mempunyai mayang yang bersusun-susun,"},{"n":11,"w":[["رِّزْقًۭا","rezeki","riz'qan",231],["لِّلْعِبَادِ ۖ","bagi hamba-hamba","lil'ʿibādi",99],["وَأَحْيَيْنَا","dan Kami hidupkan","wa-aḥyaynā",242],["بِهِۦ","dengannya","bihi",21],["بَلْدَةًۭ","negeri/tanah","baldatan",1340],["مَّيْتًۭا ۚ","mati","maytan",1399],["كَذَٰلِكَ","demikian itu","kadhālika",26],["ٱلْخُرُوجُ","kebangkitan","l-khurūju",1454]],"t":"(sebagai) rezeki bagi hamba-hamba (Kami), dan Kami hidupkan dengan (air) itu negeri yang mati (tandus). Seperti itulah terjadinya kebangkitan (dari kubur)."},{"n":12,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["قَبْلَهُمْ","sebelum mereka","qablahum",59],["قَوْمُ","kaum","qawmu",33],["نُوحٍۢ","Nuh","nūḥin",287],["وَأَصْحَـٰبُ","dan penduduk","wa-aṣḥābu",132],["ٱلرَّسِّ","Rass","l-rasi",2640],["وَثَمُودُ","dan Tsamud","wathamūdu",430]],"t":"Sebelum mereka, kaum Nuh, penduduk Rass dan Samud telah mendustakan (rasul-rasul),"},{"n":13,"w":[["وَعَادٌۭ","dan 'Ad","waʿādun",449],["وَفِرْعَوْنُ","dan Fir'aun","wafir'ʿawnu",171],["وَإِخْوَٰنُ","dan saudara","wa-ikh'wānu",152],["لُوطٍۢ","Luth","lūṭin",416]],"t":"dan (demikian juga) kaum 'Ād, kaum Fir'aun dan kaum Luṭ,"},{"n":14,"w":[["وَأَصْحَـٰبُ","dan penduduk","wa-aṣḥābu",132],["ٱلْأَيْكَةِ","Aikah","l-aykati",1506],["وَقَوْمُ","dan kaum","waqawmu",33],["تُبَّعٍۢ ۚ","Tubba'","tubbaʿin",2718],["كُلٌّۭ","semuanya","kullun",38],["كَذَّبَ","telah mendustakan","kadhaba",72],["ٱلرُّسُلَ","rasul-rasul","l-rusula",42],["فَحَقَّ","maka pasti/berhak","faḥaqqa",518],["وَعِيدِ","diancamkan","waʿīdi",1256]],"t":"dan (juga) penduduk Aikah serta kaum Tubba'. Semuanya telah mendustakan rasul-rasul, maka berlakulah ancaman-Ku (atas mereka)."},{"n":15,"w":[["أَفَعَيِينَا","maka apakah Kami lemah","afaʿayīnā",2248],["بِٱلْخَلْقِ","dengan penciptaan","bil-khalqi",241],["ٱلْأَوَّلِ ۚ","pertama","l-awali",151],["بَلْ","bahkan","bal",105],["هُمْ","mereka","hum",16],["فِى","dalam","fī",7],["لَبْسٍۢ","keragu-raguan","labsin",3637],["مِّنْ","tentang","min",1],["خَلْقٍۢ","penciptaan","khalqin",241],["جَدِيدٍۢ","yang baru","jadīdin",993]],"t":"Maka apakah Kami letih dengan penciptaan yang pertama? (Sama sekali tidak), bahkan mereka dalam keadaan ragu-ragu tentang penciptaan yang baru."},{"n":16,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["وَنَعْلَمُ","dan Kami mengetahui","wanaʿlamu",35],["مَا","apa yang","mā",6],["تُوَسْوِسُ","membisik-bisikkan","tuwaswisu",1695],["بِهِۦ","dengannya","bihi",21],["نَفْسُهُۥ ۖ","jiwanya/hatinya","nafsuhu",47],["وَنَحْنُ","dan Kami","wanaḥnu",140],["أَقْرَبُ","lebih dekat","aqrabu",533],["إِلَيْهِ","kepadanya","ilayhi",18],["مِنْ","dari","min",1],["حَبْلِ","tali/urat","ḥabli",1067],["ٱلْوَرِيدِ","urat leher","l-warīdi",4498]],"t":"Dan sungguh, Kami telah menciptakan manusia dan mengetahui apa yang dibisikkan oleh hatinya, dan Kami lebih dekat kepadanya daripada urat lehernya."},{"n":17,"w":[["إِذْ","ketika","idh",61],["يَتَلَقَّى","mendapatkan/mencatat","yatalaqqā",1682],["ٱلْمُتَلَقِّيَانِ","dua pencatat/dua malaikat","l-mutalaqiyāni",3892],["عَنِ","dari","ʿani",27],["ٱلْيَمِينِ","sebelah kanan","l-yamīni",198],["وَعَنِ","dan dari","waʿani",27],["ٱلشِّمَالِ","kiir","l-shimāli",824],["قَعِيدٌۭ","duduk","qaʿīdun",4107]],"t":"(Ingatlah) ketika dua malaikat mencatat (perbuatannya), yang satu duduk di sebelah kanan dan yang lain di sebelah kiri."},{"n":18,"w":[["مَّا","tidak","mā",6],["يَلْفِظُ","mengucap","yalfiẓu",3640],["مِن","dari","min",1],["قَوْلٍ","perkataan","qawlin",129],["إِلَّا","kecuali","illā",20],["لَدَيْهِ","di sisinya","ladayhi",479],["رَقِيبٌ","penjaga/pengawas","raqībun",1420],["عَتِيدٌۭ","yang sedia/hadir","ʿatīdun",2246]],"t":"Tidak ada suatu kata yang diucapkannya melainkan ada di sisinya malaikat pengawas yang selalu siap (mencatat)."},{"n":19,"w":[["وَجَآءَتْ","dan datang","wajāat",51],["سَكْرَةُ","kepayahan/sekarat","sakratu",2654],["ٱلْمَوْتِ","mati/maut","l-mawti",249],["بِٱلْحَقِّ ۖ","dengan sebenarnya","bil-ḥaqi",58],["ذَٰلِكَ","demikian itu","dhālika",26],["مَا","apa yang","mā",6],["كُنتَ","kamu adalah","kunta",12],["مِنْهُ","daripadanya","min'hu",1],["تَحِيدُ","kamu lari","taḥīdu",3156]],"t":"Dan datanglah sakaratulmaut dengan sebenar-benarnya. Itulah yang dahulu hendak kamu hindari."},{"n":20,"w":[["وَنُفِخَ","dan ditiup","wanufikha",544],["فِى","dalam","fī",7],["ٱلصُّورِ ۚ","sangkakala","l-ṣūri",840],["ذَٰلِكَ","demikian itu","dhālika",26],["يَوْمُ","pada hari","yawmu",31],["ٱلْوَعِيدِ","yang diancamkan","l-waʿīdi",1256]],"t":"Dan ditiuplah sangkakala. Itulah hari yang diancamkan."},{"n":21,"w":[["وَجَآءَتْ","dan datang","wajāat",51],["كُلُّ","setiap","kullu",38],["نَفْسٍۢ","jiwa/diri","nafsin",47],["مَّعَهَا","bersamanya","maʿahā",78],["سَآئِقٌۭ","seorang penggiring","sāiqun",4235],["وَشَهِيدٌۭ","dan seorang saksi","washahīdun",226]],"t":"Setiap orang akan datang bersama (malaikat) penggiring dan (malaikat) saksi."},{"n":22,"w":[["لَّقَدْ","sesungguhnya","laqad",30],["كُنتَ","adalah kamu","kunta",12],["فِى","dalam","fī",7],["غَفْلَةٍۢ","kelalaian","ghaflatin",1356],["مِّنْ","dari","min",1],["هَـٰذَا","ini","hādhā",64],["فَكَشَفْنَا","maka Kami singkapkan","fakashafnā",675],["عَنكَ","dari padamu","ʿanka",27],["غِطَآءَكَ","tabirmu","ghiṭāaka",2395],["فَبَصَرُكَ","maka pandanganmu","fabaṣaruka",260],["ٱلْيَوْمَ","hari ini","l-yawma",31],["حَدِيدٌۭ","amat tajam","ḥadīdun",1169]],"t":"Sungguh, kamu dahulu lalai tentang (peristiwa) ini, maka Kami singkapkan tutup (yang menutupi) matamu, sehingga penglihatanmu pada hari ini sangat tajam."},{"n":23,"w":[["وَقَالَ","dan berkata","waqāla",10],["قَرِينُهُۥ","temannya","qarīnuhu",1013],["هَـٰذَا","ini","hādhā",64],["مَا","apa yang","mā",6],["لَدَىَّ","di sisiku","ladayya",479],["عَتِيدٌ","tersedia","ʿatīdun",2246]],"t":"Dan (malaikat) yang menyertainya berkata, \"Inilah (catatan perbuatan) yang ada padaku.\""},{"n":24,"w":[["أَلْقِيَا","lemparkanlah olehmu","alqiyā",183],["فِى","ke dalam","fī",7],["جَهَنَّمَ","neraka jahanam","jahannama",162],["كُلَّ","setiap","kulla",38],["كَفَّارٍ","orang-orang yang sangat ingkar","kaffārin",1372],["عَنِيدٍۢ","keras kepala","ʿanīdin",1517]],"t":"(Allah berfirman), \"Lemparkanlah olehmu berdua ke dalam neraka Jahanam, semua orang yang sangat ingkar dan keras kepala,"},{"n":25,"w":[["مَّنَّاعٍۢ","yang sangat menghalangi","mannāʿin",2545],["لِّلْخَيْرِ","pada kebaikan","lil'khayri",69],["مُعْتَدٍۢ","melampaui batas","muʿ'tadin",931],["مُّرِيبٍ","ragu-ragu","murībin",1101]],"t":"yang sangat enggan melakukan kebajikan, melampaui batas, dan bersikap ragu-ragu,"},{"n":26,"w":[["ٱلَّذِى","yang","alladhī",45],["جَعَلَ","menjadikan","jaʿala",40],["مَعَ","beserta","maʿa",78],["ٱللَّهِ","Allah","l-lahi",4],["إِلَـٰهًا","tuhan/sesembahan","ilāhan",84],["ءَاخَرَ","yang lain","ākhara",187],["فَأَلْقِيَاهُ","maka lemparkanlah ia","fa-alqiyāhu",183],["فِى","ke dalam","fī",7],["ٱلْعَذَابِ","azab","l-ʿadhābi",43],["ٱلشَّدِيدِ","sangat/keras","l-shadīdi",225]],"t":"yang mempersekutukan Allah dengan tuhan lain, maka lemparkanlah dia ke dalam azab yang keras.\""},{"n":27,"w":[["۞ قَالَ","berkata","qāla",10],["قَرِينُهُۥ","temannya","qarīnuhu",1013],["رَبَّنَا","ya Tuhan kami","rabbanā",15],["مَآ","tidak","mā",6],["أَطْغَيْتُهُۥ","aku menyesatkan dia","aṭghaytuhu",2949],["وَلَـٰكِن","tetapi","walākin",176],["كَانَ","adalah dia","kāna",12],["فِى","dalam","fī",7],["ضَلَـٰلٍۭ","kesesatan","ḍalālin",325],["بَعِيدٍۢ","yang jauh","baʿīdin",438]],"t":"(Setan) yang menyertainya berkata (pula), \"Ya Tuhan kami, aku tidak menyesatkannya, tetapi dia sendiri yang berada dalam kesesatan yang jauh.\""},{"n":28,"w":[["قَالَ","berkata","qāla",10],["لَا","jangan","lā",8],["تَخْتَصِمُوا۟","kamu bertengkar","takhtaṣimū",1037],["لَدَىَّ","dihadapan-Ku","ladayya",479],["وَقَدْ","dan sesungguhnya","waqad",30],["قَدَّمْتُ","Aku telah memberikan","qaddamtu",418],["إِلَيْكُم","kepadamu","ilaykum",18],["بِٱلْوَعِيدِ","dengan janji/ancaman","bil-waʿīdi",1256]],"t":"(Allah) berfirman, \"Janganlah kamu bertengkar di hadapan-Ku, dan sungguh, dahulu Aku telah memberikan ancaman kepadamu.\""},{"n":29,"w":[["مَا","tidak akan","mā",6],["يُبَدَّلُ","diganti/dirubah","yubaddalu",463],["ٱلْقَوْلُ","perkataan/keputusan","l-qawlu",129],["لَدَىَّ","di sisi-Ku","ladayya",479],["وَمَآ","dan tidaklah","wamā",6],["أَنَا۠","Aku","anā",194],["بِظَلَّـٰمٍۢ","dengan berbuat aniaya","biẓallāmin",1335],["لِّلْعَبِيدِ","terhadap hamba-hamba-ku","lil'ʿabīdi",99]],"t":"Keputusan-Ku tidak dapat diubah, dan Aku tidak menzalimi hamba-hamba-Ku.\""},{"n":30,"w":[["يَوْمَ","pada hari","yawma",31],["نَقُولُ","Kami berkata","naqūlu",10],["لِجَهَنَّمَ","kepada jahanam","lijahannama",162],["هَلِ","apakah","hali",128],["ٱمْتَلَأْتِ","kamu telah penuh","im'talati",4639],["وَتَقُولُ","dan ia berkata (menjawab)","wataqūlu",10],["هَلْ","apakah","hal",128],["مِن","dari","min",1],["مَّزِيدٍۢ","tambahan","mazīdin",2549]],"t":"(Ingatlah) pada hari (ketika) Kami bertanya kepada Jahanam, \"Apakah kamu sudah penuh?\" Ia menjawab, \"Masih adakah tambahan?\""},{"n":31,"w":[["وَأُزْلِفَتِ","dan didekatkan","wa-uz'lifati",1509],["ٱلْجَنَّةُ","surga","l-janatu",86],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",257],["غَيْرَ","tidak","ghayra",85],["بَعِيدٍ","jauh","baʿīdin",438]],"t":"Sedangkan surga didekatkan kepada orang-orang yang bertakwa pada tempat yang tidak jauh (dari mereka)."},{"n":32,"w":[["هَـٰذَا","ini","hādhā",64],["مَا","apa yang","mā",6],["تُوعَدُونَ","dijanjikan kepadamu","tūʿadūna",190],["لِكُلِّ","bagi setiap","likulli",38],["أَوَّابٍ","kembali","awwābin",1153],["حَفِيظٍۢ","penjaga/pemelihara","ḥafīẓin",736]],"t":"(Kepada mereka dikatakan), \"Inilah nikmat yang dijanjikan kepadamu, (yaitu) kepada setiap hamba yang senantiasa bertobat (kepada Allah) dan memelihara (semua peraturan-peraturan-Nya)."},{"n":33,"w":[["مَّنْ","siapa","man",17],["خَشِىَ","dia takut","khashiya",312],["ٱلرَّحْمَـٰنَ","Yang Maha Pengasih","l-raḥmāna",224],["بِٱلْغَيْبِ","dengan yang gaib","bil-ghaybi",254],["وَجَآءَ","dan datang","wajāa",51],["بِقَلْبٍۢ","dengan hati","biqalbin",98],["مُّنِيبٍ","bertaubat","munībin",1105]],"t":"(Yaitu) orang yang takut kepada Allah Yang Maha Pengasih, sekalipun tidak kelihatan (olehnya) dan dia datang dengan hati yang bertobat,"},{"n":34,"w":[["ٱدْخُلُوهَا","masuklah kedalamnya","ud'khulūhā",165],["بِسَلَـٰمٍۢ ۖ","dengan aman","bisalāmin",294],["ذَٰلِكَ","demikian itu","dhālika",26],["يَوْمُ","hari","yawmu",31],["ٱلْخُلُودِ","kekekalan","l-khulūdi",4566]],"t":"masuklah ke (dalam surga) dengan aman dan damai, itulah hari yang abadi.\""},{"n":35,"w":[["لَهُم","bagi mereka","lahum",16],["مَّا","apa yang","mā",6],["يَشَآءُونَ","mereka kehendaki","yashāūna",62],["فِيهَا","di dalamnya","fīhā",7],["وَلَدَيْنَا","dan pada sisi Kami","waladaynā",479],["مَزِيدٌۭ","tambahan","mazīdun",2549]],"t":"Mereka di dalamnya memperoleh apa yang mereka kehendaki, dan pada Kami ada tambahannya."},{"n":36,"w":[["وَكَمْ","dan berapa banyak","wakam",498],["أَهْلَكْنَا","Kami telah binasakan","ahlaknā",243],["قَبْلَهُم","sebelum mereka","qablahum",59],["مِّن","dari","min",1],["قَرْنٍ","ummat-ummat","qarnin",468],["هُمْ","mereka","hum",16],["أَشَدُّ","lebih sangat","ashaddu",376],["مِنْهُم","dari mereka","min'hum",1],["بَطْشًۭا","kekuatan","baṭshan",1834],["فَنَقَّبُوا۟","maka mereka keliling","fanaqqabū",4055],["فِى","dalam beberapa","fī",7],["ٱلْبِلَـٰدِ","negeri","l-bilādi",672],["هَلْ","apakah","hal",128],["مِن","dari","min",1],["مَّحِيصٍ","tempat lari","maḥīṣin",1398]],"t":"Dan betapa banyak umat yang telah Kami binasakan sebelum mereka, (padahal) mereka lebih hebat kekuatannya daripada mereka (umat yang belakangan) ini. Mereka pernah menjelajah di beberapa negeri. Adakah tempat pelarian (dari kebinasaan bagi mereka)?"},{"n":37,"w":[["إِنَّ","sesungguhnya","inna",9],["فِى","pada yang","fī",7],["ذَٰلِكَ","demikian itu","dhālika",26],["لَذِكْرَىٰ","benar-benar peringatan","ladhik'rā",458],["لِمَن","bagi siapa","liman",17],["كَانَ","adalah dia","kāna",12],["لَهُۥ","baginya","lahu",21],["قَلْبٌ","hati","qalbun",98],["أَوْ","atau","aw",50],["أَلْقَى","dia menggunakan","alqā",183],["ٱلسَّمْعَ","pendengaran","l-samʿa",487],["وَهُوَ","dan dia","wahuwa",25],["شَهِيدٌۭ","menyaksikan","shahīdun",226]],"t":"Sungguh, pada yang demikian itu pasti terdapat peringatan bagi orang-orang yang mempunyai hati atau yang menggunakan pendengarannya, sedang dia menyaksikannya."},{"n":38,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["وَمَا","dan apa yang ada","wamā",6],["بَيْنَهُمَا","diantara keduanya","baynahumā",55],["فِى","dalam","fī",7],["سِتَّةِ","enam","sittati",1120],["أَيَّامٍۢ","hari/masa","ayyāmin",31],["وَمَا","dan tidak","wamā",6],["مَسَّنَا","menimpa Kami","massanā",227],["مِن","dari","min",1],["لُّغُوبٍۢ","kelelahan","lughūbin",2455]],"t":"Dan sungguh, Kami telah menciptakan langit dan bumi dan apa yang ada di antara keduanya dalam enam masa, dan Kami tidak merasa letih sedikit pun."},{"n":39,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",215],["عَلَىٰ","atas","ʿalā",11],["مَا","apa yang","mā",6],["يَقُولُونَ","mereka katakan","yaqūlūna",10],["وَسَبِّحْ","dan bertasbihlah kamu","wasabbiḥ",293],["بِحَمْدِ","dengan memuji","biḥamdi",286],["رَبِّكَ","Tuhanmu","rabbika",15],["قَبْلَ","sebelum","qabla",59],["طُلُوعِ","terbit","ṭulūʿi",2318],["ٱلشَّمْسِ","matahari","l-shamsi",358],["وَقَبْلَ","dan sebelum","waqabla",59],["ٱلْغُرُوبِ","terbenam","l-ghurūbi",2397]],"t":"Maka bersabarlah engkau (Muhammad) terhadap apa yang mereka katakan, dan bertasbihlah dengan memuji Tuhanmu sebelum matahari terbit dan sebelum terbenam."},{"n":40,"w":[["وَمِنَ","dan dari","wamina",1],["ٱلَّيْلِ","malam","al-layli",146],["فَسَبِّحْهُ","maka bertasbihlah kepada-Nya","fasabbiḥ'hu",293],["وَأَدْبَـٰرَ","dan di belakang(sesudah)","wa-adbāra",560],["ٱلسُّجُودِ","sujud","l-sujūdi",1249]],"t":"Dan bertasbihlah kepada-Nya pada malam hari dan setiap selesai salat."},{"n":41,"w":[["وَٱسْتَمِعْ","dan dengarkanlah","wa-is'tamiʿ",623],["يَوْمَ","hari","yawma",31],["يُنَادِ","menyeru","yunādi",283],["ٱلْمُنَادِ","penyeru","l-munādi",3847],["مِن","dari","min",1],["مَّكَانٍۢ","tempat","makānin",417],["قَرِيبٍۢ","dekat","qarībin",429]],"t":"Dan dengarkanlah (seruan) pada hari (ketika) penyeru (malaikat) menyeru dari tempat yang dekat."},{"n":42,"w":[["يَوْمَ","pada hari","yawma",31],["يَسْمَعُونَ","mereka mendengar","yasmaʿūna",159],["ٱلصَّيْحَةَ","suara teriakan","l-ṣayḥata",696],["بِٱلْحَقِّ ۚ","dengan sebenarnya","bil-ḥaqi",58],["ذَٰلِكَ","demikian itu","dhālika",26],["يَوْمُ","hari","yawmu",31],["ٱلْخُرُوجِ","keluar","l-khurūji",1454]],"t":"(Yaitu) pada hari (ketika) mereka mendengar suara dahsyat dengan sebenarnya. Itulah hari keluar (dari kubur)."},{"n":43,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["نَحْنُ","Kami","naḥnu",140],["نُحْىِۦ","Kami menghidupi","nuḥ'yī",242],["وَنُمِيتُ","dan Kami mematikan","wanumītu",495],["وَإِلَيْنَا","dan kepada Kami","wa-ilaynā",18],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",404]],"t":"Sungguh, Kami yang menghidupkan dan mematikan, dan kepada Kami tempat kembali (semua makhluk)."},{"n":44,"w":[["يَوْمَ","pada hari","yawma",31],["تَشَقَّقُ","terbelah-belah","tashaqqaqu",2034],["ٱلْأَرْضُ","bumi","l-arḍu",28],["عَنْهُمْ","dari mereka","ʿanhum",27],["سِرَاعًۭا ۚ","dengan cepat","sirāʿan",2670],["ذَٰلِكَ","demikian itu","dhālika",26],["حَشْرٌ","pengumpulan","ḥashrun",2262],["عَلَيْنَا","atas Kami","ʿalaynā",11],["يَسِيرٌۭ","mudah","yasīrun",653]],"t":"(Yaitu) pada hari (ketika) bumi terbelah, mereka keluar dengan cepat. Yang demikian itu adalah pengumpulan yang mudah bagi Kami."},{"n":45,"w":[["نَّحْنُ","Kami","naḥnu",140],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَا","dengan apa","bimā",6],["يَقُولُونَ ۖ","mereka berkata-kata","yaqūlūna",10],["وَمَآ","dan tidaklah","wamā",6],["أَنتَ","kamu","anta",154],["عَلَيْهِم","atas  mereka","ʿalayhim",11],["بِجَبَّارٍۢ ۖ","dengan memaksa","bijabbārin",850],["فَذَكِّرْ","maka berilah peringatan","fadhakkir",549],["بِٱلْقُرْءَانِ","dengan Al Qur'an","bil-qur'āni",189],["مَن","orang yang","man",17],["يَخَافُ","ia takut","yakhāfu",150],["وَعِيدِ","ancaman-Ku","waʿīdi",1256]],"t":"Kami lebih mengetahui tentang apa yang mereka katakan, dan engkau (Muhammad) bukanlah seorang pemaksa terhadap mereka. Maka berilah peringatan dengan Alquran kepada siapa pun yang takut kepada ancaman-Ku."}]