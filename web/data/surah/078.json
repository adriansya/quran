[{"n":1,"w":[["عَمَّ","dari/tentang","ʿamma",27],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",951]],"t":"Tentang apakah mereka saling bertanya-tanya?"},{"n":2,"w":[["عَنِ","dari/tentang","ʿani",27],["ٱلنَّبَإِ","berita","l-naba-i",396],["ٱلْعَظِيمِ","besar","l-ʿaẓīmi",109]],"t":"Tentang berita yang besar (hari berbangkit),"},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",45],["هُمْ","mereka","hum",16],["فِيهِ","di dalamnya/tentang itu","fīhi",7],["مُخْتَلِفُونَ","orang yang berselisih","mukh'talifūna",865]],"t":"yang dalam hal itu mereka berselisih."},{"n":4,"w":[["كَلَّا","jangan begitu/sekali-kali tidak","kallā",362],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",35]],"t":"Tidak! Kelak mereka akan mengetahui,"},{"n":5,"w":[["ثُمَّ","kemudian","thumma",41],["كَلَّا","jangan begitu/sekali-kali tidak","kallā",362],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",35]],"t":"sekali lagi tidak! Kelak mereka akan mengetahui."},{"n":6,"w":[["أَلَمْ","tidaklah/bukanlah","alam",39],["نَجْعَلِ","Kami telah menjadikan","najʿali",40],["ٱلْأَرْضَ","bumi","l-arḍa",28],["مِهَـٰدًۭا","hamparan","mihādan",1098]],"t":"Bukankah Kami telah menjadikan bumi sebagai hamparan,"},{"n":7,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",320],["أَوْتَادًۭا","pancang/pasak","awtādan",2058]],"t":"dan gunung-gunung sebagai pasak?"},{"n":8,"w":[["وَخَلَقْنَـٰكُمْ","dan Kami menciptakan kamu","wakhalaqnākum",70],["أَزْوَٰجًۭا","berpasang-pasangan/jodoh","azwājan",166]],"t":"Dan Kami menciptakan kamu berpasang-pasangan,"},{"n":9,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["نَوْمَكُمْ","tidurmu","nawmakum",1974],["سُبَاتًۭا","istirahat","subātan",2672]],"t":"dan Kami menjadikan tidurmu untuk istirahat,"},{"n":10,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["ٱلَّيْلَ","malam","al-layla",146],["لِبَاسًۭا","pakaian","libāsan",854]],"t":"dan Kami menjadikan malam sebagai pakaian,"},{"n":11,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["ٱلنَّهَارَ","siang","l-nahāra",221],["مَعَاشًۭا","penghidupan","maʿāshan",3675]],"t":"dan Kami menjadikan siang untuk mencari penghidupan,"},{"n":12,"w":[["وَبَنَيْنَا","dan Kami bina","wabanaynā",791],["فَوْقَكُمْ","di atas kamu","fawqakum",301],["سَبْعًۭا","tujuh","sabʿan",470],["شِدَادًۭا","kuat/kokoh","shidādan",225]],"t":"dan Kami membangun di atas kamu tujuh (lapis langit) yang kokoh,"},{"n":13,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["سِرَاجًۭا","pelita","sirājan",1672],["وَهَّاجًۭا","sangat terang","wahhājan",4482]],"t":"dan Kami menjadikan pelita yang terang-benderang (matahari),"},{"n":14,"w":[["وَأَنزَلْنَا","dan Kami turunkan","wa-anzalnā",71],["مِنَ","dari","mina",1],["ٱلْمُعْصِرَٰتِ","awan","l-muʿ'ṣirāti",3800],["مَآءًۭ","air","māan",204],["ثَجَّاجًۭا","tercurah","thajjājan",4449]],"t":"dan Kami turunkan dari awan, air hujan yang tercurah dengan lebatnya,"},{"n":15,"w":[["لِّنُخْرِجَ","karena Kami hendak mengeluarkan","linukh'rija",125],["بِهِۦ","dengannya/dengan air","bihi",21],["حَبًّۭا","biji-bijian","ḥabban",1067],["وَنَبَاتًۭا","dan tumbuh-tumbuhan","wanabātan",935]],"t":"untuk Kami tumbuhkan dengan air itu biji-bijian dan tanam-tanaman,"},{"n":16,"w":[["وَجَنَّـٰتٍ","dan kebun-kebun/surga","wajannātin",86],["أَلْفَافًا","lebat","alfāfan",2988]],"t":"dan kebun-kebun yang rindang."},{"n":17,"w":[["إِنَّ","sesungguhnya","inna",9],["يَوْمَ","hari","yawma",31],["ٱلْفَصْلِ","keputusan","l-faṣli",916],["كَانَ","adalah ia","kāna",12],["مِيقَـٰتًۭا","waktu yang ditentukan","mīqātan",1001]],"t":"Sungguh, hari keputusan adalah suatu waktu yang telah ditetapkan,"},{"n":18,"w":[["يَوْمَ","hari","yawma",31],["يُنفَخُ","ditiup","yunfakhu",544],["فِى","dalam/pada","fī",7],["ٱلصُّورِ","sangkakala","l-ṣūri",839],["فَتَأْتُونَ","maka kamu datang","fatatūna",56],["أَفْوَاجًۭا","berduyun-duyun","afwājan",1353]],"t":"(yaitu) pada hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong,"},{"n":19,"w":[["وَفُتِحَتِ","dan dibukakan","wafutiḥati",606],["ٱلسَّمَآءُ","langit","l-samāu",44],["فَكَانَتْ","maka jadilah ia","fakānat",12],["أَبْوَٰبًۭا","pintu-pintu","abwāban",414]],"t":"dan langit pun dibukalah, maka terdapatlah beberapa pintu,"},{"n":20,"w":[["وَسُيِّرَتِ","dan dijalankan/dihapuskan","wasuyyirati",1424],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",320],["فَكَانَتْ","maka jadilah ia","fakānat",12],["سَرَابًا","fatamorgana","sarāban",2659]],"t":"dan gunung-gunungpun dijalankan sehingga menjadi fatamorgana."},{"n":21,"w":[["إِنَّ","sesungguhnya","inna",9],["جَهَنَّمَ","Jahanam","jahannama",162],["كَانَتْ","adalah ia","kānat",12],["مِرْصَادًۭا","tempat penantian/disediakan","mir'ṣādan",2499]],"t":"Sungguh, (neraka) Jahanam itu (sebagai) tempat mengintai (bagi penjaga yang mengawasi isi neraka),"},{"n":22,"w":[["لِّلطَّـٰغِينَ","bagi orang-orang yang melampui batas","lilṭṭāghīna",1174],["مَـَٔابًۭا","tempat kembali","maāban",928]],"t":"menjadi tempat kembali bagi orang-orang yang melampaui batas."},{"n":23,"w":[["لَّـٰبِثِينَ","mereka tinggal","lābithīna",3654],["فِيهَآ","didalamnya","fīhā",7],["أَحْقَابًۭا","beberapa lama","aḥqāban",2939]],"t":"Mereka tinggal di sana dalam masa yang lama,"},{"n":24,"w":[["لَّا","tidak","lā",8],["يَذُوقُونَ","merasakan","yadhūqūna",339],["فِيهَا","di dalamnya","fīhā",7],["بَرْدًۭا","kesejukan","bardan",2347],["وَلَا","dan tidak","walā",8],["شَرَابًا","minuman","sharāban",768]],"t":"mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,"},{"n":25,"w":[["إِلَّا","kecuali","illā",20],["حَمِيمًۭا","air yang mendidih","ḥamīman",518],["وَغَسَّاقًۭا","dan air luka dan nanah","waghassāqan",2390]],"t":"selain air yang mendidih dan nanah,"},{"n":26,"w":[["جَزَآءًۭ","pembalasan","jazāan",290],["وِفَاقًا","setimpal","wifāqan",4508]],"t":"sebagai pembalasan yang setimpal."},{"n":27,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["لَا","tidak","lā",8],["يَرْجُونَ","mengharapkan","yarjūna",486],["حِسَابًۭا","perhitungan","ḥisāban",319]],"t":"Sesungguhnya dahulu mereka tidak pernah mengharapkan perhitungan,"},{"n":28,"w":[["وَكَذَّبُوا۟","dan mereka mendustakan","wakadhabū",72],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",34],["كِذَّابًۭا","sangat dusta","kidhāban",2437]],"t":"dan mereka benar-benar mendustakan ayat-ayat Kami."},{"n":29,"w":[["وَكُلَّ","dan tiap-tiap/segala","wakulla",38],["شَىْءٍ","sesuatu","shayin",49],["أَحْصَيْنَـٰهُ","Kami telah mengumpulkannya","aḥṣaynāhu",827],["كِتَـٰبًۭا","suatu kitab","kitāban",57]],"t":"Dan segala sesuatu telah Kami catat dalam suatu Kitab (buku catatan amalan manusia)."},{"n":30,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",339],["فَلَن","maka tidak","falan",123],["نَّزِيدَكُمْ","Kami menambah kamu","nazīdakum",259],["إِلَّا","kecuali/selain","illā",20],["عَذَابًا","azab","ʿadhāban",43]],"t":"Maka karena itu rasakanlah! Maka tidak ada yang akan Kami tambahkan kepadamu selain azab."},{"n":31,"w":[["إِنَّ","sesungguhnya","inna",9],["لِلْمُتَّقِينَ","bagi orang-orang yang bertaqwa","lil'muttaqīna",257],["مَفَازًا","keuntungan","mafāzan",3701]],"t":"Sungguh, orang-orang yang bertakwa mendapat kemenangan,"},{"n":32,"w":[["حَدَآئِقَ","kebun-kebun","ḥadāiqa",1804],["وَأَعْنَـٰبًۭا","dan buah anggur","wa-aʿnāban",785]],"t":"(yaitu) kebun-kebun dan buah anggur,"},{"n":33,"w":[["وَكَوَاعِبَ","dan gadis-gadis","wakawāʿiba",3594],["أَتْرَابًۭا","sebaya","atrāban",2046]],"t":"dan gadis-gadis belia yang sebaya,"},{"n":34,"w":[["وَكَأْسًۭا","dan piala/gelas-gelas","wakasan",1202],["دِهَاقًۭا","yang penuh","dihāqan",3403]],"t":"dan gelas-gelas yang penuh (berisi minuman)."},{"n":35,"w":[["لَّا","tidak","lā",8],["يَسْمَعُونَ","mereka mendengar","yasmaʿūna",159],["فِيهَا","di dalamnya","fīhā",7],["لَغْوًۭا","sia-sia","laghwan",926],["وَلَا","dan tidak","walā",8],["كِذَّٰبًۭا","dusta","kidhāban",2437]],"t":"Di sana mereka tidak mendengar percakapan yang sia-sia maupun (perkataan dusta)."},{"n":36,"w":[["جَزَآءًۭ","balasan","jazāan",290],["مِّن","dari","min",1],["رَّبِّكَ","Tuhanmu","rabbika",15],["عَطَآءً","pemberian","ʿaṭāan",1300],["حِسَابًۭا","perhitungan/cukup","ḥisāban",319]],"t":"Sebagai balasan dan pemberian yang cukup banyak dari Tuhanmu,"},{"n":37,"w":[["رَّبِّ","Tuhan/Pemelihara","rabbi",15],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["وَمَا","dan apa","wamā",6],["بَيْنَهُمَا","diantara keduanya","baynahumā",55],["ٱلرَّحْمَـٰنِ ۖ","Yang Maha Pengasih","l-raḥmāni",224],["لَا","tidak","lā",8],["يَمْلِكُونَ","mereka kuasa","yamlikūna",282],["مِنْهُ","daripadaNya/dengan Dia","min'hu",1],["خِطَابًۭا","bicara","khiṭāban",2077]],"t":"Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; Yang Maha Pengasih, mereka tidak mampu berbicara dengan Dia."},{"n":38,"w":[["يَوْمَ","hari","yawma",31],["يَقُومُ","berdiri","yaqūmu",364],["ٱلرُّوحُ","ruh","l-rūḥu",507],["وَٱلْمَلَـٰٓئِكَةُ","dan malaikat","wal-malāikatu",137],["صَفًّۭا ۖ","berbaris","ṣaffan",1073],["لَّا","tidak","lā",8],["يَتَكَلَّمُونَ","merekaberkata-kata","yatakallamūna",1680],["إِلَّا","kecuali","illā",20],["مَنْ","siapa/orang","man",17],["أَذِنَ","memberi izin","adhina",460],["لَهُ","kepadanya","lahu",21],["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","l-raḥmānu",224],["وَقَالَ","dan berkata","waqāla",10],["صَوَابًۭا","yang benar","ṣawāban",3270]],"t":"Pada hari, ketika rūḥ dan para malaikat berdiri bersaf-saf, mereka tidak berkata-kata, kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pengasih dan dia hanya mengatakan yang benar."},{"n":39,"w":[["ذَٰلِكَ","demikian/itu","dhālika",26],["ٱلْيَوْمُ","hari","l-yawmu",31],["ٱلْحَقُّ ۖ","hak/benar","l-ḥaqu",58],["فَمَن","maka barang siapa","faman",17],["شَآءَ","ia menghendaki","shāa",62],["ٱتَّخَذَ","ia mengambil","ittakhadha",107],["إِلَىٰ","kepada","ilā",18],["رَبِّهِۦ","Tuhannya","rabbihi",15],["مَـَٔابًا","tempat kembali","maāban",928]],"t":"Itulah hari yang pasti terjadi. Maka barangsiapa menghendaki, niscaya dia menempuh jalan kembali kepada Tuhannya."},{"n":40,"w":[["إِنَّآ","sesungguhnya Kami","innā",9],["أَنذَرْنَـٰكُمْ","Kami memberi peringatan kepadamu","andharnākum",279],["عَذَابًۭا","azab","ʿadhāban",43],["قَرِيبًۭا","dekat","qarīban",429],["يَوْمَ","hari","yawma",31],["يَنظُرُ","melihat","yanẓuru",139],["ٱلْمَرْءُ","seseorang","l-maru",1608],["مَا","apa","mā",6],["قَدَّمَتْ","mendahului/diperbuat","qaddamat",418],["يَدَاهُ","kedua tangannya","yadāhu",110],["وَيَقُولُ","dan berkata","wayaqūlu",10],["ٱلْكَافِرُ","orang kafir","l-kāfiru",79],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",678],["كُنتُ","adalah aku","kuntu",12],["تُرَٰبًۢا","debu/tanah","turāban",593]],"t":"Sesungguhnya Kami telah memperingatkan kepadamu (orang kafir) azab yang dekat, pada hari manusia melihat apa yang telah diperbuat oleh kedua tangannya; dan orang kafir berkata, \"Alangkah baiknya seandainya dahulu aku jadi tanah.\""}]