[{"n":1,"w":[["عَمَّ","dari/tentang","ʿamma",21],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",940]],"t":"Tentang apakah mereka saling bertanya-tanya?"},{"n":2,"w":[["عَنِ","dari/tentang","ʿani",21],["ٱلنَّبَإِ","berita","l-naba-i",386],["ٱلْعَظِيمِ","besar","l-ʿaẓīmi",101]],"t":"Tentang berita yang besar (hari berbangkit),"},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",38],["هُمْ","mereka","hum",11],["فِيهِ","di dalamnya/tentang itu","fīhi",3],["مُخْتَلِفُونَ","orang yang berselisih","mukh'talifūna",855]],"t":"yang dalam hal itu mereka berselisih."},{"n":4,"w":[["كَلَّا","jangan begitu/sekali-kali tidak","kallā",352],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",29]],"t":"Tidak! Kelak mereka akan mengetahui,"},{"n":5,"w":[["ثُمَّ","kemudian","thumma",34],["كَلَّا","jangan begitu/sekali-kali tidak","kallā",352],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",29]],"t":"sekali lagi tidak! Kelak mereka akan mengetahui."},{"n":6,"w":[["أَلَمْ","tidaklah/bukanlah","alam",32],["نَجْعَلِ","Kami telah menjadikan","najʿali",33],["ٱلْأَرْضَ","bumi","l-arḍa",22],["مِهَـٰدًۭا","hamparan","mihādan",1087]],"t":"Bukankah Kami telah menjadikan bumi sebagai hamparan,"},{"n":7,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",310],["أَوْتَادًۭا","pancang/pasak","awtādan",2047]],"t":"dan gunung-gunung sebagai pasak?"},{"n":8,"w":[["وَخَلَقْنَـٰكُمْ","dan Kami menciptakan kamu","wakhalaqnākum",62],["أَزْوَٰجًۭا","berpasang-pasangan/jodoh","azwājan",156]],"t":"Dan Kami menciptakan kamu berpasang-pasangan,"},{"n":9,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["نَوْمَكُمْ","tidurmu","nawmakum",1963],["سُبَاتًۭا","istirahat","subātan",2661]],"t":"dan Kami menjadikan tidurmu untuk istirahat,"},{"n":10,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["ٱلَّيْلَ","malam","al-layla",137],["لِبَاسًۭا","pakaian","libāsan",844]],"t":"dan Kami menjadikan malam sebagai pakaian,"},{"n":11,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["ٱلنَّهَارَ","siang","l-nahāra",211],["مَعَاشًۭا","penghidupan","maʿāshan",3664]],"t":"dan Kami menjadikan siang untuk mencari penghidupan,"},{"n":12,"w":[["وَبَنَيْنَا","dan Kami bina","wabanaynā",782],["فَوْقَكُمْ","di atas kamu","fawqakum",291],["سَبْعًۭا","tujuh","sabʿan",461],["شِدَادًۭا","kuat/kokoh","shidādan",215]],"t":"dan Kami membangun di atas kamu tujuh (lapis langit) yang kokoh,"},{"n":13,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["سِرَاجًۭا","pelita","sirājan",1661],["وَهَّاجًۭا","sangat terang","wahhājan",4471]],"t":"dan Kami menjadikan pelita yang terang-benderang (matahari),"},{"n":14,"w":[["وَأَنزَلْنَا","dan Kami turunkan","wa-anzalnā",63],["مِنَ","dari","mina",0],["ٱلْمُعْصِرَٰتِ","awan","l-muʿ'ṣirāti",3789],["مَآءًۭ","air","māan",194],["ثَجَّاجًۭا","tercurah","thajjājan",4438]],"t":"dan Kami turunkan dari awan, air hujan yang tercurah dengan lebatnya,"},{"n":15,"w":[["لِّنُخْرِجَ","karena Kami hendak mengeluarkan","linukh'rija",115],["بِهِۦ","dengannya/dengan air","bihi",16],["حَبًّۭا","biji-bijian","ḥabban",1056],["وَنَبَاتًۭا","dan tumbuh-tumbuhan","wanabātan",924]],"t":"untuk Kami tumbuhkan dengan air itu biji-bijian dan tanam-tanaman,"},{"n":16,"w":[["وَجَنَّـٰتٍ","dan kebun-kebun/surga","wajannātin",78],["أَلْفَافًا","lebat","alfāfan",2977]],"t":"dan kebun-kebun yang rindang."},{"n":17,"w":[["إِنَّ","sesungguhnya","inna",5],["يَوْمَ","hari","yawma",25],["ٱلْفَصْلِ","keputusan","l-faṣli",905],["كَانَ","adalah ia","kāna",8],["مِيقَـٰتًۭا","waktu yang ditentukan","mīqātan",990]],"t":"Sungguh, hari keputusan adalah suatu waktu yang telah ditetapkan,"},{"n":18,"w":[["يَوْمَ","hari","yawma",25],["يُنفَخُ","ditiup","yunfakhu",535],["فِى","dalam/pada","fī",3],["ٱلصُّورِ","sangkakala","l-ṣūri",829],["فَتَأْتُونَ","maka kamu datang","fatatūna",48],["أَفْوَاجًۭا","berduyun-duyun","afwājan",1342]],"t":"(yaitu) pada hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong,"},{"n":19,"w":[["وَفُتِحَتِ","dan dibukakan","wafutiḥati",597],["ٱلسَّمَآءُ","langit","l-samāu",37],["فَكَانَتْ","maka jadilah ia","fakānat",8],["أَبْوَٰبًۭا","pintu-pintu","abwāban",404]],"t":"dan langit pun dibukalah, maka terdapatlah beberapa pintu,"},{"n":20,"w":[["وَسُيِّرَتِ","dan dijalankan/dihapuskan","wasuyyirati",1413],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",310],["فَكَانَتْ","maka jadilah ia","fakānat",8],["سَرَابًا","fatamorgana","sarāban",2648]],"t":"dan gunung-gunungpun dijalankan sehingga menjadi fatamorgana."},{"n":21,"w":[["إِنَّ","sesungguhnya","inna",5],["جَهَنَّمَ","Jahanam","jahannama",152],["كَانَتْ","adalah ia","kānat",8],["مِرْصَادًۭا","tempat penantian/disediakan","mir'ṣādan",2488]],"t":"Sungguh, (neraka) Jahanam itu (sebagai) tempat mengintai (bagi penjaga yang mengawasi isi neraka),"},{"n":22,"w":[["لِّلطَّـٰغِينَ","bagi orang-orang yang melampui batas","lilṭṭāghīna",1163],["مَـَٔابًۭا","tempat kembali","maāban",917]],"t":"menjadi tempat kembali bagi orang-orang yang melampaui batas."},{"n":23,"w":[["لَّـٰبِثِينَ","mereka tinggal","lābithīna",3643],["فِيهَآ","didalamnya","fīhā",3],["أَحْقَابًۭا","beberapa lama","aḥqāban",2928]],"t":"Mereka tinggal di sana dalam masa yang lama,"},{"n":24,"w":[["لَّا","tidak","lā",4],["يَذُوقُونَ","merasakan","yadhūqūna",329],["فِيهَا","di dalamnya","fīhā",3],["بَرْدًۭا","kesejukan","bardan",2336],["وَلَا","dan tidak","walā",4],["شَرَابًا","minuman","sharāban",759]],"t":"mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,"},{"n":25,"w":[["إِلَّا","kecuali","illā",15],["حَمِيمًۭا","air yang mendidih","ḥamīman",509],["وَغَسَّاقًۭا","dan air luka dan nanah","waghassāqan",2379]],"t":"selain air yang mendidih dan nanah,"},{"n":26,"w":[["جَزَآءًۭ","pembalasan","jazāan",280],["وِفَاقًا","setimpal","wifāqan",4497]],"t":"sebagai pembalasan yang setimpal."},{"n":27,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",8],["لَا","tidak","lā",4],["يَرْجُونَ","mengharapkan","yarjūna",477],["حِسَابًۭا","perhitungan","ḥisāban",309]],"t":"Sesungguhnya dahulu mereka tidak pernah mengharapkan perhitungan,"},{"n":28,"w":[["وَكَذَّبُوا۟","dan mereka mendustakan","wakadhabū",64],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["كِذَّابًۭا","sangat dusta","kidhāban",2426]],"t":"dan mereka benar-benar mendustakan ayat-ayat Kami."},{"n":29,"w":[["وَكُلَّ","dan tiap-tiap/segala","wakulla",31],["شَىْءٍ","sesuatu","shayin",41],["أَحْصَيْنَـٰهُ","Kami telah mengumpulkannya","aḥṣaynāhu",818],["كِتَـٰبًۭا","suatu kitab","kitāban",49]],"t":"Dan segala sesuatu telah Kami catat dalam suatu Kitab (buku catatan amalan manusia)."},{"n":30,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",329],["فَلَن","maka tidak","falan",113],["نَّزِيدَكُمْ","Kami menambah kamu","nazīdakum",249],["إِلَّا","kecuali/selain","illā",15],["عَذَابًا","azab","ʿadhāban",36]],"t":"Maka karena itu rasakanlah! Maka tidak ada yang akan Kami tambahkan kepadamu selain azab."},{"n":31,"w":[["إِنَّ","sesungguhnya","inna",5],["لِلْمُتَّقِينَ","bagi orang-orang yang bertaqwa","lil'muttaqīna",247],["مَفَازًا","keuntungan","mafāzan",3690]],"t":"Sungguh, orang-orang yang bertakwa mendapat kemenangan,"},{"n":32,"w":[["حَدَآئِقَ","kebun-kebun","ḥadāiqa",1793],["وَأَعْنَـٰبًۭا","dan buah anggur","wa-aʿnāban",776]],"t":"(yaitu) kebun-kebun dan buah anggur,"},{"n":33,"w":[["وَكَوَاعِبَ","dan gadis-gadis","wakawāʿiba",3583],["أَتْرَابًۭا","sebaya","atrāban",2035]],"t":"dan gadis-gadis belia yang sebaya,"},{"n":34,"w":[["وَكَأْسًۭا","dan piala/gelas-gelas","wakasan",1191],["دِهَاقًۭا","yang penuh","dihāqan",3392]],"t":"dan gelas-gelas yang penuh (berisi minuman)."},{"n":35,"w":[["لَّا","tidak","lā",4],["يَسْمَعُونَ","mereka mendengar","yasmaʿūna",149],["فِيهَا","di dalamnya","fīhā",3],["لَغْوًۭا","sia-sia","laghwan",915],["وَلَا","dan tidak","walā",4],["كِذَّٰبًۭا","dusta","kidhāban",2426]],"t":"Di sana mereka tidak mendengar percakapan yang sia-sia maupun (perkataan dusta)."},{"n":36,"w":[["جَزَآءًۭ","balasan","jazāan",280],["مِّن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["عَطَآءً","pemberian","ʿaṭāan",1289],["حِسَابًۭا","perhitungan/cukup","ḥisāban",309]],"t":"Sebagai balasan dan pemberian yang cukup banyak dari Tuhanmu,"},{"n":37,"w":[["رَّبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["ٱلرَّحْمَـٰنِ ۖ","Yang Maha Pengasih","l-raḥmāni",214],["لَا","tidak","lā",4],["يَمْلِكُونَ","mereka kuasa","yamlikūna",272],["مِنْهُ","daripadaNya/dengan Dia","min'hu",0],["خِطَابًۭا","bicara","khiṭāban",2066]],"t":"Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; Yang Maha Pengasih, mereka tidak mampu berbicara dengan Dia."},{"n":38,"w":[["يَوْمَ","hari","yawma",25],["يَقُومُ","berdiri","yaqūmu",354],["ٱلرُّوحُ","ruh","l-rūḥu",498],["وَٱلْمَلَـٰٓئِكَةُ","dan malaikat","wal-malāikatu",128],["صَفًّۭا ۖ","berbaris","ṣaffan",1062],["لَّا","tidak","lā",4],["يَتَكَلَّمُونَ","merekaberkata-kata","yatakallamūna",1669],["إِلَّا","kecuali","illā",15],["مَنْ","siapa/orang","man",12],["أَذِنَ","memberi izin","adhina",451],["لَهُ","kepadanya","lahu",16],["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","l-raḥmānu",214],["وَقَالَ","dan berkata","waqāla",6],["صَوَابًۭا","yang benar","ṣawāban",3259]],"t":"Pada hari, ketika rūḥ dan para malaikat berdiri bersaf-saf, mereka tidak berkata-kata, kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pengasih dan dia hanya mengatakan yang benar."},{"n":39,"w":[["ذَٰلِكَ","demikian/itu","dhālika",20],["ٱلْيَوْمُ","hari","l-yawmu",25],["ٱلْحَقُّ ۖ","hak/benar","l-ḥaqu",50],["فَمَن","maka barang siapa","faman",12],["شَآءَ","ia menghendaki","shāa",54],["ٱتَّخَذَ","ia mengambil","ittakhadha",99],["إِلَىٰ","kepada","ilā",13],["رَبِّهِۦ","Tuhannya","rabbihi",10],["مَـَٔابًا","tempat kembali","maāban",917]],"t":"Itulah hari yang pasti terjadi. Maka barangsiapa menghendaki, niscaya dia menempuh jalan kembali kepada Tuhannya."},{"n":40,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَنذَرْنَـٰكُمْ","Kami memberi peringatan kepadamu","andharnākum",269],["عَذَابًۭا","azab","ʿadhāban",36],["قَرِيبًۭا","dekat","qarīban",419],["يَوْمَ","hari","yawma",25],["يَنظُرُ","melihat","yanẓuru",130],["ٱلْمَرْءُ","seseorang","l-maru",1597],["مَا","apa","mā",2],["قَدَّمَتْ","mendahului/diperbuat","qaddamat",408],["يَدَاهُ","kedua tangannya","yadāhu",102],["وَيَقُولُ","dan berkata","wayaqūlu",6],["ٱلْكَافِرُ","orang kafir","l-kāfiru",71],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",669],["كُنتُ","adalah aku","kuntu",8],["تُرَٰبًۢا","debu/tanah","turāban",584]],"t":"Sesungguhnya Kami telah memperingatkan kepadamu (orang kafir) azab yang dekat, pada hari manusia melihat apa yang telah diperbuat oleh kedua tangannya; dan orang kafir berkata, \"Alangkah baiknya seandainya dahulu aku jadi tanah.\""}]