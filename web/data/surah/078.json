[{"n":1,"w":[["عَمَّ","dari/tentang","ʿamma",21],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",939]],"t":"Tentang apakah mereka saling bertanya-tanya?"},{"n":2,"w":[["عَنِ","dari/tentang","ʿani",21],["ٱلنَّبَإِ","berita","l-naba-i",376],["ٱلْعَظِيمِ","besar","l-ʿaẓīmi",98]],"t":"Tentang berita yang besar (hari berbangkit),"},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",7],["هُمْ","mereka","hum",11],["فِيهِ","di dalamnya/tentang itu","fīhi",3],["مُخْتَلِفُونَ","orang yang berselisih","mukh'talifūna",852]],"t":"yang dalam hal itu mereka berselisih."},{"n":4,"w":[["كَلَّا","jangan begitu/sekali-kali tidak","kallā",346],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",29]],"t":"Tidak! Kelak mereka akan mengetahui,"},{"n":5,"w":[["ثُمَّ","kemudian","thumma",34],["كَلَّا","jangan begitu/sekali-kali tidak","kallā",346],["سَيَعْلَمُونَ","kelak mereka akan mengetahui","sayaʿlamūna",29]],"t":"sekali lagi tidak! Kelak mereka akan mengetahui."},{"n":6,"w":[["أَلَمْ","tidaklah/bukanlah","alam",32],["نَجْعَلِ","Kami telah menjadikan","najʿali",33],["ٱلْأَرْضَ","bumi","l-arḍa",22],["مِهَـٰدًۭا","hamparan","mihādan",1087]],"t":"Bukankah Kami telah menjadikan bumi sebagai hamparan,"},{"n":7,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",302],["أَوْتَادًۭا","pancang/pasak","awtādan",1745]],"t":"dan gunung-gunung sebagai pasak?"},{"n":8,"w":[["وَخَلَقْنَـٰكُمْ","dan Kami menciptakan kamu","wakhalaqnākum",60],["أَزْوَٰجًۭا","berpasang-pasangan/jodoh","azwājan",152]],"t":"Dan Kami menciptakan kamu berpasang-pasangan,"},{"n":9,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["نَوْمَكُمْ","tidurmu","nawmakum",1945],["سُبَاتًۭا","istirahat","subātan",2643]],"t":"dan Kami menjadikan tidurmu untuk istirahat,"},{"n":10,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["ٱلَّيْلَ","malam","al-layla",132],["لِبَاسًۭا","pakaian","libāsan",842]],"t":"dan Kami menjadikan malam sebagai pakaian,"},{"n":11,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["ٱلنَّهَارَ","siang","l-nahāra",210],["مَعَاشًۭا","penghidupan","maʿāshan",3640]],"t":"dan Kami menjadikan siang untuk mencari penghidupan,"},{"n":12,"w":[["وَبَنَيْنَا","dan Kami bina","wabanaynā",779],["فَوْقَكُمْ","di atas kamu","fawqakum",284],["سَبْعًۭا","tujuh","sabʿan",460],["شِدَادًۭا","kuat/kokoh","shidādan",213]],"t":"dan Kami membangun di atas kamu tujuh (lapis langit) yang kokoh,"},{"n":13,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["سِرَاجًۭا","pelita","sirājan",1643],["وَهَّاجًۭا","sangat terang","wahhājan",4536]],"t":"dan Kami menjadikan pelita yang terang-benderang (matahari),"},{"n":14,"w":[["وَأَنزَلْنَا","dan Kami turunkan","wa-anzalnā",61],["مِنَ","dari","mina",0],["ٱلْمُعْصِرَٰتِ","awan","l-muʿ'ṣirāti",3775],["مَآءًۭ","air","māan",192],["ثَجَّاجًۭا","tercurah","thajjājan",4507]],"t":"dan Kami turunkan dari awan, air hujan yang tercurah dengan lebatnya,"},{"n":15,"w":[["لِّنُخْرِجَ","karena Kami hendak mengeluarkan","linukh'rija",111],["بِهِۦ","dengannya/dengan air","bihi",16],["حَبًّۭا","biji-bijian","ḥabban",1054],["وَنَبَاتًۭا","dan tumbuh-tumbuhan","wanabātan",915]],"t":"untuk Kami tumbuhkan dengan air itu biji-bijian dan tanam-tanaman,"},{"n":16,"w":[["وَجَنَّـٰتٍ","dan kebun-kebun/surga","wajannātin",76],["أَلْفَافًا","lebat","alfāfan",3006]],"t":"dan kebun-kebun yang rindang."},{"n":17,"w":[["إِنَّ","sesungguhnya","inna",5],["يَوْمَ","hari","yawma",25],["ٱلْفَصْلِ","keputusan","l-faṣli",897],["كَانَ","adalah ia","kāna",9],["مِيقَـٰتًۭا","waktu yang ditentukan","mīqātan",985]],"t":"Sungguh, hari keputusan adalah suatu waktu yang telah ditetapkan,"},{"n":18,"w":[["يَوْمَ","hari","yawma",25],["يُنفَخُ","ditiup","yunfakhu",531],["فِى","dalam/pada","fī",3],["ٱلصُّورِ","sangkakala","l-ṣūri",827],["فَتَأْتُونَ","maka kamu datang","fatatūna",48],["أَفْوَاجًۭا","berduyun-duyun","afwājan",1334]],"t":"(yaitu) pada hari (ketika) sangkakala ditiup, lalu kamu datang berbondong-bondong,"},{"n":19,"w":[["وَفُتِحَتِ","dan dibukakan","wafutiḥati",595],["ٱلسَّمَآءُ","langit","l-samāu",38],["فَكَانَتْ","maka jadilah ia","fakānat",9],["أَبْوَٰبًۭا","pintu-pintu","abwāban",399]],"t":"dan langit pun dibukalah, maka terdapatlah beberapa pintu,"},{"n":20,"w":[["وَسُيِّرَتِ","dan dijalankan/dihapuskan","wasuyyirati",1397],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",302],["فَكَانَتْ","maka jadilah ia","fakānat",9],["سَرَابًا","fatamorgana","sarāban",2630]],"t":"dan gunung-gunungpun dijalankan sehingga menjadi fatamorgana."},{"n":21,"w":[["إِنَّ","sesungguhnya","inna",5],["جَهَنَّمَ","Jahanam","jahannama",148],["كَانَتْ","adalah ia","kānat",9],["مِرْصَادًۭا","tempat penantian/disediakan","mir'ṣādan",2477]],"t":"Sungguh, (neraka) Jahanam itu (sebagai) tempat mengintai (bagi penjaga yang mengawasi isi neraka),"},{"n":22,"w":[["لِّلطَّـٰغِينَ","bagi orang-orang yang melampui batas","lilṭṭāghīna",1161],["مَـَٔابًۭا","tempat kembali","maāban",908]],"t":"menjadi tempat kembali bagi orang-orang yang melampaui batas."},{"n":23,"w":[["لَّـٰبِثِينَ","mereka tinggal","lābithīna",3623],["فِيهَآ","didalamnya","fīhā",3],["أَحْقَابًۭا","beberapa lama","aḥqāban",2960]],"t":"Mereka tinggal di sana dalam masa yang lama,"},{"n":24,"w":[["لَّا","tidak","lā",4],["يَذُوقُونَ","merasakan","yadhūqūna",322],["فِيهَا","di dalamnya","fīhā",3],["بَرْدًۭا","kesejukan","bardan",2339],["وَلَا","dan tidak","walā",4],["شَرَابًا","minuman","sharāban",756]],"t":"mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,"},{"n":25,"w":[["إِلَّا","kecuali","illā",15],["حَمِيمًۭا","air yang mendidih","ḥamīman",507],["وَغَسَّاقًۭا","dan air luka dan nanah","waghassāqan",2376]],"t":"selain air yang mendidih dan nanah,"},{"n":26,"w":[["جَزَآءًۭ","pembalasan","jazāan",275],["وِفَاقًا","setimpal","wifāqan",4556]],"t":"sebagai pembalasan yang setimpal."},{"n":27,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["لَا","tidak","lā",4],["يَرْجُونَ","mengharapkan","yarjūna",480],["حِسَابًۭا","perhitungan","ḥisāban",301]],"t":"Sesungguhnya dahulu mereka tidak pernah mengharapkan perhitungan,"},{"n":28,"w":[["وَكَذَّبُوا۟","dan mereka mendustakan","wakadhabū",63],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["كِذَّابًۭا","sangat dusta","kidhāban",2423]],"t":"dan mereka benar-benar mendustakan ayat-ayat Kami."},{"n":29,"w":[["وَكُلَّ","dan tiap-tiap/segala","wakulla",31],["شَىْءٍ","sesuatu","shayin",41],["أَحْصَيْنَـٰهُ","Kami telah mengumpulkannya","aḥṣaynāhu",815],["كِتَـٰبًۭا","suatu kitab","kitāban",49]],"t":"Dan segala sesuatu telah Kami catat dalam suatu Kitab (buku catatan amalan manusia)."},{"n":30,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",322],["فَلَن","maka tidak","falan",109],["نَّزِيدَكُمْ","Kami menambah kamu","nazīdakum",246],["إِلَّا","kecuali/selain","illā",15],["عَذَابًا","azab","ʿadhāban",36]],"t":"Maka karena itu rasakanlah! Maka tidak ada yang akan Kami tambahkan kepadamu selain azab."},{"n":31,"w":[["إِنَّ","sesungguhnya","inna",5],["لِلْمُتَّقِينَ","bagi orang-orang yang bertaqwa","lil'muttaqīna",244],["مَفَازًا","keuntungan","mafāzan",3670]],"t":"Sungguh, orang-orang yang bertakwa mendapat kemenangan,"},{"n":32,"w":[["حَدَآئِقَ","kebun-kebun","ḥadāiqa",1776],["وَأَعْنَـٰبًۭا","dan buah anggur","wa-aʿnāban",773]],"t":"(yaitu) kebun-kebun dan buah anggur,"},{"n":33,"w":[["وَكَوَاعِبَ","dan gadis-gadis","wakawāʿiba",3585],["أَتْرَابًۭا","sebaya","atrāban",1742]],"t":"dan gadis-gadis belia yang sebaya,"},{"n":34,"w":[["وَكَأْسًۭا","dan piala/gelas-gelas","wakasan",1188],["دِهَاقًۭا","yang penuh","dihāqan",3393]],"t":"dan gelas-gelas yang penuh (berisi minuman)."},{"n":35,"w":[["لَّا","tidak","lā",4],["يَسْمَعُونَ","mereka mendengar","yasmaʿūna",145],["فِيهَا","di dalamnya","fīhā",3],["لَغْوًۭا","sia-sia","laghwan",906],["وَلَا","dan tidak","walā",4],["كِذَّٰبًۭا","dusta","kidhāban",2423]],"t":"Di sana mereka tidak mendengar percakapan yang sia-sia maupun (perkataan dusta)."},{"n":36,"w":[["جَزَآءًۭ","balasan","jazāan",275],["مِّن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["عَطَآءً","pemberian","ʿaṭāan",1289],["حِسَابًۭا","perhitungan/cukup","ḥisāban",301]],"t":"Sebagai balasan dan pemberian yang cukup banyak dari Tuhanmu,"},{"n":37,"w":[["رَّبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["ٱلرَّحْمَـٰنِ ۖ","Yang Maha Pengasih","l-raḥmāni",212],["لَا","tidak","lā",4],["يَمْلِكُونَ","mereka kuasa","yamlikūna",267],["مِنْهُ","daripadaNya/dengan Dia","min'hu",0],["خِطَابًۭا","bicara","khiṭāban",2044]],"t":"Tuhan (yang memelihara) langit dan bumi serta apa yang ada di antara keduanya; Yang Maha Pengasih, mereka tidak mampu berbicara dengan Dia."},{"n":38,"w":[["يَوْمَ","hari","yawma",25],["يَقُومُ","berdiri","yaqūmu",348],["ٱلرُّوحُ","ruh","l-rūḥu",496],["وَٱلْمَلَـٰٓئِكَةُ","dan malaikat","wal-malāikatu",123],["صَفًّۭا ۖ","berbaris","ṣaffan",1062],["لَّا","tidak","lā",4],["يَتَكَلَّمُونَ","merekaberkata-kata","yatakallamūna",1676],["إِلَّا","kecuali","illā",15],["مَنْ","siapa/orang","man",12],["أَذِنَ","memberi izin","adhina",450],["لَهُ","kepadanya","lahu",16],["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","l-raḥmānu",212],["وَقَالَ","dan berkata","waqāla",6],["صَوَابًۭا","yang benar","ṣawāban",3267]],"t":"Pada hari, ketika rūḥ dan para malaikat berdiri bersaf-saf, mereka tidak berkata-kata, kecuali siapa yang telah diberi izin kepadanya oleh Tuhan Yang Maha Pengasih dan dia hanya mengatakan yang benar."},{"n":39,"w":[["ذَٰلِكَ","demikian/itu","dhālika",19],["ٱلْيَوْمُ","hari","l-yawmu",25],["ٱلْحَقُّ ۖ","hak/benar","l-ḥaqu",50],["فَمَن","maka barang siapa","faman",12],["شَآءَ","ia menghendaki","shāa",54],["ٱتَّخَذَ","ia mengambil","ittakhadha",95],["إِلَىٰ","kepada","ilā",13],["رَبِّهِۦ","Tuhannya","rabbihi",10],["مَـَٔابًا","tempat kembali","maāban",908]],"t":"Itulah hari yang pasti terjadi. Maka barangsiapa menghendaki, niscaya dia menempuh jalan kembali kepada Tuhannya."},{"n":40,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَنذَرْنَـٰكُمْ","Kami memberi peringatan kepadamu","andharnākum",264],["عَذَابًۭا","azab","ʿadhāban",36],["قَرِيبًۭا","dekat","qarīban",416],["يَوْمَ","hari","yawma",25],["يَنظُرُ","melihat","yanẓuru",125],["ٱلْمَرْءُ","seseorang","l-maru",1582],["مَا","apa","mā",2],["قَدَّمَتْ","mendahului/diperbuat","qaddamat",406],["يَدَاهُ","kedua tangannya","yadāhu",99],["وَيَقُولُ","dan berkata","wayaqūlu",6],["ٱلْكَافِرُ","orang kafir","l-kāfiru",402],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",667],["كُنتُ","adalah aku","kuntu",9],["تُرَٰبًۢا","debu/tanah","turāban",581]],"t":"Sesungguhnya Kami telah memperingatkan kepadamu (orang kafir) azab yang dekat, pada hari manusia melihat apa yang telah diperbuat oleh kedua tangannya; dan orang kafir berkata, \"Alangkah baiknya seandainya dahulu aku jadi tanah.\""}]