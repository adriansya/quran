[{"n":1,"w":[["حمٓ","Haa Miim","hha-meem",1054]],"t":"Ḥā Mīm."},{"n":2,"w":[["تَنزِيلُ","turunnya","tanzīlu",636],["ٱلْكِتَـٰبِ","kitab","l-kitābi",49],["مِنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",113],["ٱلْحَكِيمِ","Maha Bijaksana","l-ḥakīmi",115]],"t":"Kitab ini diturunkan dari Allah Yang Mahaperkasa, Mahabijaksana."},{"n":3,"w":[["مَا","tidak","mā",2],["خَلَقْنَا","Kami menciptakan","khalaqnā",61],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa yang ada","wamā",2],["بَيْنَهُمَآ","diantara keduanya","baynahumā",47],["إِلَّا","kecuali","illā",15],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَأَجَلٍۢ","dan waktu","wa-ajalin",226],["مُّسَمًّۭى ۚ","ditentukan","musamman",490],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["عَمَّآ","dari apa","ʿammā",21],["أُنذِرُوا۟","mereka diperingatkan","undhirū",265],["مُعْرِضُونَ","oran-orang yang berpaling","muʿ'riḍūna",529]],"t":"Kami tidak menciptakan langit dan bumi dan apa yang ada di antara keduanya melainkan dengan (tujuan) yang benar dan dalam waktu yang ditentukan. Namun orang-orang yang kafir berpaling dari peringatan yang diberikan kepada mereka."},{"n":4,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُم","adakah kamu perhatikan","ara-aytum",46],["مَّا","apa yang","mā",2],["تَدْعُونَ","kamu sembah","tadʿūna",65],["مِن","dari","min",0],["دُونِ","selain","dūni",79],["ٱللَّهِ","Allah","l-lahi",1],["أَرُونِى","perlihatkan kepadaku","arūnī",291],["مَاذَا","apa yang","mādhā",413],["خَلَقُوا۟","mereka ciptakan","khalaqū",61],["مِنَ","dari","mina",0],["ٱلْأَرْضِ","bumi","l-arḍi",22],["أَمْ","atau","am",84],["لَهُمْ","bagi mereka","lahum",11],["شِرْكٌۭ","berserikat","shir'kun",1261],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ ۖ","langit(jamak)","l-samāwāti",38],["ٱئْتُونِى","datangkan kepadaku","i'tūnī",48],["بِكِتَـٰبٍۢ","dengan sebuah kitab","bikitābin",49],["مِّن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["هَـٰذَآ","ini","hādhā",37],["أَوْ","atau","aw",42],["أَثَـٰرَةٍۢ","bekas-bekas/peninggalan","athāratin",3015],["مِّنْ","dari","min",0],["عِلْمٍ","ilmu pengetahuan","ʿil'min",111],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",199]],"t":"Katakanlah (Muhammad), \"Terangkanlah (kepadaku) tentang apa yang kamu sembah selain Allah; perlihatkan kepadaku apa yang telah mereka ciptakan dari bumi, atau adakah peran serta mereka dalam (penciptaan) langit? Bawalah kepadaku kitab sebelum (Alquran) ini atau peninggalan dari pengetahuan (orang-orang dahulu), jika kamu orang yang benar.\""},{"n":5,"w":[["وَمَنْ","dan siapa","waman",12],["أَضَلُّ","lebih sesat","aḍallu",871],["مِمَّن","dari pada orang","mimman",0],["يَدْعُوا۟","mereka menyembah","yadʿū",65],["مِن","dari","min",0],["دُونِ","selain","dūni",79],["ٱللَّهِ","Allah","l-lahi",1],["مَن","orang/sesembahan","man",12],["لَّا","tidak","lā",4],["يَسْتَجِيبُ","ia dapat memperkenankan","yastajību",394],["لَهُۥٓ","padanya","lahu",16],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",177],["وَهُمْ","dan mereka","wahum",11],["عَن","dari","ʿan",21],["دُعَآئِهِمْ","do'a mereka","duʿāihim",463],["غَـٰفِلُونَ","mereka lalai","ghāfilūna",388]],"t":"Dan siapakah yang lebih sesat daripada orang-orang yang menyembah selain Allah, (sembahan) yang tidak dapat memperkenankan (doa)nya sampai hari Kiamat dan mereka lalai dari (memperhatikan) doa mereka?"},{"n":6,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["حُشِرَ","dikumpulkan","ḥushira",315],["ٱلنَّاسُ","manusia","l-nāsu",52],["كَانُوا۟","adalah mereka/sesembahan","kānū",9],["لَهُمْ","bagi mereka","lahum",11],["أَعْدَآءًۭ","musuh-musuh","aʿdāan",236],["وَكَانُوا۟","dan adalah mereka(sesembahan)","wakānū",9],["بِعِبَادَتِهِمْ","pada pemujaan mereka","biʿibādatihim",883],["كَـٰفِرِينَ","mereka mengingkari","kāfirīna",70]],"t":"Dan apabila manusia dikumpulkan (pada hari Kiamat), sesembahan itu menjadi musuh mereka, dan mengingkari pemujaan-pemujaan yang mereka lakukan kepadanya."},{"n":7,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",197],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["بَيِّنَـٰتٍۢ","menjelaskan","bayyinātin",174],["قَالَ","berkata","qāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لِلْحَقِّ","pada kebenaran","lil'ḥaqqi",50],["لَمَّا","ketika","lammā",72],["جَآءَهُمْ","ia datang kepada mereka","jāahum",43],["هَـٰذَا","ini","hādhā",37],["سِحْرٌۭ","sihir","siḥ'run",393],["مُّبِينٌ","nyata","mubīnun",102]],"t":"Dan apabila dibacakan ayat-ayat Kami yang jelas kepada mereka, orang-orang yang kafir berkata, ketika kebenaran itu datang kepada mereka, \"Ini adalah sihir yang nyata.\""},{"n":8,"w":[["أَمْ","atau/bahkan","am",84],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["ٱفْتَرَىٰهُ ۖ","dia mengada-adakannya","if'tarāhu",235],["قُلْ","katakanlah","qul",6],["إِنِ","jika","ini",14],["ٱفْتَرَيْتُهُۥ","aku mengada-adakannya","if'taraytuhu",235],["فَلَا","maka tidaklah","falā",4],["تَمْلِكُونَ","kamu memiliki/kuasa","tamlikūna",268],["لِى","bagi aku","lī",147],["مِنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["شَيْـًٔا ۖ","sesuatupun","shayan",41],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِمَا","dengan apa-apa","bimā",2],["تُفِيضُونَ","kamu percakapkan","tufīḍūna",1030],["فِيهِ ۖ","padanya","fīhi",3],["كَفَىٰ","cukuplah","kafā",355],["بِهِۦ","dengan dia","bihi",16],["شَهِيدًۢا","menjadi saksi","shahīdan",214],["بَيْنِى","antaraku","baynī",47],["وَبَيْنَكُمْ ۖ","dan antara kamu","wabaynakum",47],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",121],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",103]],"t":"Bahkan mereka berkata, \"Dia (Muhammad) telah mengada-adakannya (Alquran).\" Katakanlah, \"Jika aku mengada-adakannya, maka kamu tidak kuasa sedikit pun menghindarkan aku dari (azab) Allah. Dia lebih tahu apa yang kamu percakapkan tentang Alquran ini. Cukuplah Dia menjadi saksi antara aku dengan kamu. Dia Maha Pengampun, Maha Penyayang.\""},{"n":9,"w":[["قُلْ","katakanlah","qul",6],["مَا","tidaklah","mā",2],["كُنتُ","aku adalah","kuntu",9],["بِدْعًۭا","yang pertama","bid'ʿan",3363],["مِّنَ","dari","mina",0],["ٱلرُّسُلِ","rasul-rasul","l-rusuli",35],["وَمَآ","dan tidak","wamā",2],["أَدْرِى","aku mnegetahui","adrī",728],["مَا","apa yang","mā",2],["يُفْعَلُ","akan diperbuat","yuf'ʿalu",126],["بِى","terhadapku","bī",147],["وَلَا","dan tidak","walā",4],["بِكُمْ ۖ","dengan/untuk kalian","bikum",26],["إِنْ","tidak","in",14],["أَتَّبِعُ","aku mengikuti","attabiʿu",86],["إِلَّا","kecuali","illā",15],["مَا","apa yang","mā",2],["يُوحَىٰٓ","diwahyukan","yūḥā",168],["إِلَىَّ","kepadaku","ilayya",13],["وَمَآ","dan tidaklah","wamā",2],["أَنَا۠","aku","anā",183],["إِلَّا","kecuali","illā",15],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",204],["مُّبِينٌۭ","nyata","mubīnun",102]],"t":"Katakanlah (Muhammad), \"Aku bukanlah Rasul yang pertama di antara rasul-rasul, dan aku tidak tahu apa yang akan diperbuat terhadapku dan terhadapmu. Aku hanyalah mengikuti apa yang diwahyukan kepadaku, dan aku hanyalah pemberi peringatan yang menjelaskan.\""},{"n":10,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","apakah kamu lihat","ara-aytum",46],["إِن","jika","in",14],["كَانَ","adalah ia","kāna",9],["مِنْ","dari","min",0],["عِندِ","sisi","ʿindi",59],["ٱللَّهِ","Allah","l-lahi",1],["وَكَفَرْتُم","dan kamu mengingkari","wakafartum",40],["بِهِۦ","padanya","bihi",16],["وَشَهِدَ","dan menyaksikan","washahida",264],["شَاهِدٌۭ","seorang saksi","shāhidun",477],["مِّنۢ","dari","min",0],["بَنِىٓ","Bani","banī",81],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",270],["عَلَىٰ","atas","ʿalā",8],["مِثْلِهِۦ","perumpamaannya","mith'lihi",157],["فَـَٔامَنَ","lalu dia beriman","faāmana",18],["وَٱسْتَكْبَرْتُمْ ۖ","dan kamu menyombongkan diri","wa-is'takbartum",300],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["لَا","tidak","lā",4],["يَهْدِى","memberi petunjuk","yahdī",80],["ٱلْقَوْمَ","kaum","l-qawma",27],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",88]],"t":"Katakanlah, \"Terangkan kepadaku, bagaimana pendapatmu jika sebenarnya (Alquran) ini datang dari Allah, dan kamu mengingkarinya, padahal ada seorang saksi dari Bani Israil yang mengakui (kebenaran) yang serupa dengan (yang disebut dalam) Alquran lalu dia beriman; kamu menyombongkan diri. Sungguh, Allah tidak memberi petunjuk kepada orang-orang yang zalim.\""},{"n":11,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["لَوْ","jika ia","law",57],["كَانَ","adalah","kāna",9],["خَيْرًۭا","baik","khayran",60],["مَّا","tidak","mā",2],["سَبَقُونَآ","mereka mendahului kami","sabaqūnā",516],["إِلَيْهِ ۚ","kepadanya","ilayhi",13],["وَإِذْ","dan karena","wa-idh",53],["لَمْ","tidak","lam",32],["يَهْتَدُوا۟","mereka mendapat petunjuk","yahtadū",298],["بِهِۦ","dengannya","bihi",16],["فَسَيَقُولُونَ","maka mereka akan mengatakan","fasayaqūlūna",6],["هَـٰذَآ","ini","hādhā",37],["إِفْكٌۭ","kedustaan","if'kun",868],["قَدِيمٌۭ","lama","qadīmun",1968]],"t":"Dan orang-orang yang kafir berkata kepada orang-orang yang beriman, \"Sekiranya Alquran itu sesuatu yang baik, tentu mereka tidak pantas mendahului kami (beriman) kepadanya. Tetapi karena mereka tidak mendapat petunjuk dengannya, maka mereka akan berkata, \"Ini adalah dusta yang lama.\""},{"n":12,"w":[["وَمِن","dan dari","wamin",0],["قَبْلِهِۦ","sebelumnya","qablihi",51],["كِتَـٰبُ","kitab","kitābu",49],["مُوسَىٰٓ","Musa","mūsā",85],["إِمَامًۭا","petunjuk","imāman",705],["وَرَحْمَةًۭ ۚ","dan rahmat","waraḥmatan",105],["وَهَـٰذَا","dan ini","wahādhā",37],["كِتَـٰبٌۭ","kitab","kitābun",49],["مُّصَدِّقٌۭ","membenarkan","muṣaddiqun",528],["لِّسَانًا","lisan/bahasa","lisānan",427],["عَرَبِيًّۭا","Arab","ʿarabiyyan",768],["لِّيُنذِرَ","untuk memberi peringatan","liyundhira",265],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ظَلَمُوا۟","zalim","ẓalamū",107],["وَبُشْرَىٰ","dan memberi kabar gembira","wabush'rā",624],["لِلْمُحْسِنِينَ","kepada orang-orang yang berbuat baik","lil'muḥ'sinīna",306]],"t":"Dan sebelum (Alquran) itu telah ada Kitab Musa sebagai petunjuk dan rahmat. Dan (Alquran) ini adalah Kitab yang membenarkannya dalam bahasa Arab untuk memberi peringatan kepada orang-orang yang zalim dan memberi kabar gembira kepada orang-orang yang berbuat baik."},{"n":13,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["قَالُوا۟","mengatakan","qālū",6],["رَبُّنَا","Tuhan kami","rabbunā",10],["ٱللَّهُ","Allah","l-lahu",1],["ثُمَّ","kemudian","thumma",34],["ٱسْتَقَـٰمُوا۟","mereka meneguhkan","is'taqāmū",867],["فَلَا","maka tidak ada","falā",4],["خَوْفٌ","rasa takut","khawfun",416],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["وَلَا","dan tidak","walā",4],["هُمْ","mereka","hum",11],["يَحْزَنُونَ","mereka bersedih hati","yaḥzanūna",316]],"t":"Sesungguhnya orang-orang yang berkata, \"Tuhan kami adalah Allah,\" kemudian mereka tetap istikamah, tidak ada rasa khawatir pada mereka, dan mereka tidak (pula) bersedih hati."},{"n":14,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["أَصْحَـٰبُ","penghuni","aṣḥābu",122],["ٱلْجَنَّةِ","surga","l-janati",77],["خَـٰلِدِينَ","mereka kekal","khālidīna",162],["فِيهَا","didalamnya","fīhā",3],["جَزَآءًۢ","balasan","jazāan",276],["بِمَا","terhadap apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Mereka itulah para penghuni surga, kekal di dalamnya; sebagai balasan atas apa yang telah mereka kerjakan."},{"n":15,"w":[["وَوَصَّيْنَا","dan Kami wasiatkan","wawaṣṣaynā",803],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["بِوَٰلِدَيْهِ","terhadap kedua orang tuanya","biwālidayhi",862],["إِحْسَـٰنًا ۖ","berbuat baik","iḥ'sānan",704],["حَمَلَتْهُ","mengandungnya","ḥamalathu",285],["أُمُّهُۥ","ibunya","ummuhu",339],["كُرْهًۭا","susah payah","kur'han",1875],["وَوَضَعَتْهُ","dan melahirkannya","wawaḍaʿathu",493],["كُرْهًۭا ۖ","susah payah","kur'han",1875],["وَحَمْلُهُۥ","dan mengandungnya","waḥamluhu",1052],["وَفِصَـٰلُهُۥ","dan menyapihnya","wafiṣāluhu",1837],["ثَلَـٰثُونَ","tiga puluh","thalāthūna",1003],["شَهْرًا ۚ","bulan","shahran",478],["حَتَّىٰٓ","sehingga","ḥattā",82],["إِذَا","apabila","idhā",23],["بَلَغَ","dia sampai","balagha",292],["أَشُدَّهُۥ","dewasanya","ashuddahu",948],["وَبَلَغَ","dan sampai","wabalagha",292],["أَرْبَعِينَ","empat puluh","arbaʿīna",1034],["سَنَةًۭ","tahun","sanatan",531],["قَالَ","dia berkata","qāla",6],["رَبِّ","ya Tuhan","rabbi",10],["أَوْزِعْنِىٓ","Tunjukilah aku","awziʿ'nī",2184],["أَنْ","untuk","an",17],["أَشْكُرَ","aku bersyukur","ashkura",254],["نِعْمَتَكَ","nikmat Engkau","niʿ'mataka",238],["ٱلَّتِىٓ","yang","allatī",7],["أَنْعَمْتَ","Engkau beri nikmat","anʿamta",562],["عَلَىَّ","kepadaku","ʿalayya",8],["وَعَلَىٰ","dan kepada","waʿalā",8],["وَٰلِدَىَّ","kedua orang tuaku","wālidayya",862],["وَأَنْ","dan agar","wa-an",17],["أَعْمَلَ","aku beramal","aʿmala",44],["صَـٰلِحًۭا","shaleh","ṣāliḥan",95],["تَرْضَىٰهُ","Engkau meridhainya","tarḍāhu",313],["وَأَصْلِحْ","dan berilah kebaikan","wa-aṣliḥ",384],["لِى","kepadaku","lī",147],["فِى","pada","fī",3],["ذُرِّيَّتِىٓ ۖ","keturunanku","dhurriyyatī",350],["إِنِّى","sesungguhnya aku","innī",5],["تُبْتُ","aku bertaubat","tub'tu",193],["إِلَيْكَ","kepada-Mu","ilayka",13],["وَإِنِّى","dan sesungguhnya aku","wa-innī",5],["مِنَ","termasuk/dari","mina",0],["ٱلْمُسْلِمِينَ","orang-orang yang berserah diri","l-mus'limīna",278]],"t":"Dan Kami perintahkan kepada manusia agar berbuat baik kepada kedua orang tuanya. Ibunya telah mengandungnya dengan susah payah, dan melahirkannya dengan susah payah (pula). Masa mengandung sampai menyapihnya selama tiga puluh bulan, sehingga apabila dia (anak itu) telah dewasa dan umurnya mencapai empat puluh tahun dia berdoa, \"Ya Tuhanku, berilah aku petunjuk agar aku dapat mensyukuri nikmat-Mu yang telah Engkau limpahkan kepadaku dan kepada kedua orang tuaku, dan agar aku dapat berbuat kebajikan yang Engkau ridai; dan berilah aku kebaikan yang akan mengalir sampai kepada anak cucuku. Sungguh, aku bertobat kepada Engkau, dan sungguh aku termasuk orang muslim.\""},{"n":16,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["نَتَقَبَّلُ","Kami terima","nataqabbalu",859],["عَنْهُمْ","dari mereka","ʿanhum",21],["أَحْسَنَ","lebih baik","aḥsana",325],["مَا","apa yang","mā",2],["عَمِلُوا۟","mereka kerjakan","ʿamilū",44],["وَنَتَجَاوَزُ","dan Kami hapus","wanatajāwazu",4364],["عَن","dari","ʿan",21],["سَيِّـَٔاتِهِمْ","kesalahan mereka","sayyiātihim",205],["فِىٓ","dalam","fī",3],["أَصْحَـٰبِ","penghuni","aṣḥābi",122],["ٱلْجَنَّةِ ۖ","surga","l-janati",77],["وَعْدَ","janji","waʿda",246],["ٱلصِّدْقِ","benar","l-ṣid'qi",655],["ٱلَّذِى","yang","alladhī",7],["كَانُوا۟","adalah mereka","kānū",9],["يُوعَدُونَ","mereka dijanjikan","yūʿadūna",179]],"t":"Mereka itulah orang-orang yang Kami terima amal baiknya yang telah mereka kerjakan, dan (orang-orang) yang Kami maafkan kesalahan-kesalahannya, (mereka akan menjadi) penghuni-penghuni surga. Itu adalah janji benar yang telah dijanjikan kepada mereka."},{"n":17,"w":[["وَٱلَّذِى","dan orang yang","wa-alladhī",7],["قَالَ","berkata","qāla",6],["لِوَٰلِدَيْهِ","pada kedua orang tuanya","liwālidayhi",862],["أُفٍّۢ","hus/cis","uffin",1751],["لَّكُمَآ","bagi kamu berdua","lakumā",1055],["أَتَعِدَانِنِىٓ","apakah kamu berdua mengancamku","ataʿidāninī",179],["أَنْ","bahwa","an",17],["أُخْرَجَ","aku akan dibangkitkan","ukh'raja",114],["وَقَدْ","dan sesungguhnya","waqad",24],["خَلَتِ","telah berlalu","khalati",430],["ٱلْقُرُونُ","ummat-ummat","l-qurūnu",454],["مِن","dari","min",0],["قَبْلِى","sebelumku","qablī",51],["وَهُمَا","dan keduanya","wahumā",588],["يَسْتَغِيثَانِ","keduanya memohon pertolongan","yastaghīthāni",1691],["ٱللَّهَ","Allah","l-laha",1],["وَيْلَكَ","celaka kamu","waylaka",296],["ءَامِنْ","berimanlah","āmin",18],["إِنَّ","sesungguhnya","inna",5],["وَعْدَ","janji","waʿda",246],["ٱللَّهِ","Allah","l-lahi",1],["حَقٌّۭ","benar","ḥaqqun",50],["فَيَقُولُ","maka dia berkata","fayaqūlu",6],["مَا","tidaklah","mā",2],["هَـٰذَآ","ini","hādhā",37],["إِلَّآ","kecuali","illā",15],["أَسَـٰطِيرُ","dongengan","asāṭīru",877],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",141]],"t":"Dan orang yang berkata kepada kedua orang tuanya, \"Ah.\" Apakah kamu berdua memperingatkan kepadaku bahwa aku akan dibangkitkan (dari kubur), padahal beberapa umat sebelumku telah berlalu? Lalu kedua orang tuanya itu memohon pertolongan kepada Allah (seraya berkata), \"Celaka kamu, berimanlah! Sungguh, janji Allah itu benar.\" Lalu dia (anak itu) berkata, \"Ini hanyalah dongeng orang-orang dahulu.\""},{"n":18,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["حَقَّ","telah pasti","ḥaqqa",504],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلْقَوْلُ","perkataan","l-qawlu",120],["فِىٓ","pada","fī",3],["أُمَمٍۢ","ummat-ummat","umamin",190],["قَدْ","sungguh","qad",24],["خَلَتْ","telah berlalu","khalat",430],["مِن","dari","min",0],["قَبْلِهِم","sebelum mereka","qablihim",51],["مِّنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",465],["وَٱلْإِنسِ ۖ","dan manusia","wal-insi",536],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["خَـٰسِرِينَ","orang-orang yang merugi","khāsirīna",358]],"t":"Mereka itu orang-orang yang telah pasti terkena ketetapan (azab) bersama umat-umat dahulu sebelum mereka, dari (golongan) jin dan manusia. Mereka adalah orang-orang yang rugi."},{"n":19,"w":[["وَلِكُلٍّۢ","dan bagi tiap-tiap","walikullin",31],["دَرَجَـٰتٌۭ","derajat","darajātun",545],["مِّمَّا","dari apa","mimmā",0],["عَمِلُوا۟ ۖ","mereka kerjakan","ʿamilū",44],["وَلِيُوَفِّيَهُمْ","dan karena Allah akan mencukupi mereka","waliyuwaffiyahum",556],["أَعْمَـٰلَهُمْ","amal pekerjaan mereka","aʿmālahum",173],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يُظْلَمُونَ","mereka dirugikan/aniaya","yuẓ'lamūna",107]],"t":"Dan setiap orang memperoleh tingkatan sesuai dengan apa yang telah mereka kerjakan, dan agar Allah mencukupkan balasan perbuatan mereka, dan mereka tidak dirugikan."},{"n":20,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["يُعْرَضُ","dihadapkan","yuʿ'raḍu",767],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["عَلَى","atas/pada","ʿalā",8],["ٱلنَّارِ","neraka","l-nāri",78],["أَذْهَبْتُمْ","kamu telah hilangkan","adhhabtum",758],["طَيِّبَـٰتِكُمْ","rezekimu yang baik-baik","ṭayyibātikum",255],["فِى","dalam","fī",3],["حَيَاتِكُمُ","kehidupanmu","ḥayātikumu",153],["ٱلدُّنْيَا","dunia","l-dun'yā",104],["وَٱسْتَمْتَعْتُم","dan kamu telah bersenang-senang","wa-is'tamtaʿtum",1255],["بِهَا","dengannya","bihā",97],["فَٱلْيَوْمَ","maka pada hari ini","fal-yawma",25],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",164],["عَذَابَ","azab","ʿadhāba",36],["ٱلْهُونِ","hina","l-hūni",1560],["بِمَا","dengan sebab","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَسْتَكْبِرُونَ","kamu menyombongkan diri","tastakbirūna",300],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["بِغَيْرِ","dengan tanpa","bighayri",76],["ٱلْحَقِّ","kebenaran","l-ḥaqi",50],["وَبِمَا","dan dengan sebab","wabimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَفْسُقُونَ","kamu berbuat fasik","tafsuqūna",831]],"t":"Dan (ingatlah) pada hari (ketika) orang-orang kafir dihadapkan ke neraka (seraya dikatakan kepada mereka), \"Kamu telah menghabiskan (rezeki) yang baik untuk kehidupan duniamu, dan kamu telah bersenang-senang (menikmati)nya; maka pada hari ini kamu dibalas dengan azab yang menghinakan, karena kamu sombong di bumi tanpa mengindahkan kebenaran, dan karena kamu berbuat durhaka (tidak taat kepada Allah).\""},{"n":21,"w":[["۞ وَٱذْكُرْ","dan ingatlah","wa-udh'kur",134],["أَخَا","saudara","akhā",142],["عَادٍ","kaum 'Ad","ʿādin",434],["إِذْ","ketika","idh",53],["أَنذَرَ","dia memberi peringatan","andhara",265],["قَوْمَهُۥ","kaumnya","qawmahu",27],["بِٱلْأَحْقَافِ","di bukit pasir","bil-aḥqāfi",2928],["وَقَدْ","dan sesungguhnya","waqad",24],["خَلَتِ","telah berlalu","khalati",430],["ٱلنُّذُرُ","pemberi peringatan","l-nudhuru",204],["مِنۢ","dari","min",0],["بَيْنِ","antara","bayni",47],["يَدَيْهِ","hadapannya","yadayhi",101],["وَمِنْ","dan dari","wamin",0],["خَلْفِهِۦٓ","belakangnya","khalfihi",476],["أَلَّا","bahwa janganlah","allā",17],["تَعْبُدُوٓا۟","kamu menyembah","taʿbudū",99],["إِلَّا","kecuali","illā",15],["ٱللَّهَ","Allah","l-laha",1],["إِنِّىٓ","sesungguhnya aku","innī",5],["أَخَافُ","aku takut","akhāfu",140],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["عَذَابَ","azab","ʿadhāba",36],["يَوْمٍ","pada hari","yawmin",25],["عَظِيمٍۢ","besar","ʿaẓīmin",100]],"t":"Dan ingatlah (Hud) saudara kaum 'Ād, yaitu ketika dia mengingatkan kaumnya tentang bukit-bukit pasir, dan sesungguhnya telah berlalu beberapa orang pemberi peringatan sebelumnya dan setelahnya (dengan berkata), \"Janganlah kamu menyembah selain Allah, aku sungguh khawatir nanti kamu ditimpa azab pada hari yang besar.\""},{"n":22,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["أَجِئْتَنَا","apakah kamu datang kepada kami","aji'tanā",43],["لِتَأْفِكَنَا","untuk memalingkan kami","litafikanā",585],["عَنْ","dari","ʿan",21],["ءَالِهَتِنَا","Tuhan-tuhan kami","ālihatinā",75],["فَأْتِنَا","maka datangkanlah kepada kami","fatinā",48],["بِمَا","dengan apa","bimā",2],["تَعِدُنَآ","kamu ancamkan kepada kami","taʿidunā",179],["إِن","jika","in",14],["كُنتَ","kamu adalah","kunta",9],["مِنَ","dari","mina",0],["ٱلصَّـٰدِقِينَ","orang-orang yang benar","l-ṣādiqīna",199]],"t":"Mereka menjawab, \"Apakah engkau datang kepada kami untuk memalingkan kami dari (menyembah) tuhan-tuhan kami? Maka datangkanlah kepada kami azab yang telah engkau ancamkan kepada kami, jika engkau termasuk orang yang benar.\""},{"n":23,"w":[["قَالَ","dia berkata","qāla",6],["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["ٱلْعِلْمُ","pengetahuan","l-ʿil'mu",111],["عِندَ","di sisi","ʿinda",59],["ٱللَّهِ","Allah","l-lahi",1],["وَأُبَلِّغُكُم","dan aku menyampaikan kepadamu","wa-uballighukum",1166],["مَّآ","apa yang","mā",2],["أُرْسِلْتُ","aku di utus","ur'sil'tu",91],["بِهِۦ","dengannya","bihi",16],["وَلَـٰكِنِّىٓ","akan tetapi aku","walākinnī",165],["أَرَىٰكُمْ","aku melihatmu","arākum",46],["قَوْمًۭا","kaum","qawman",27],["تَجْهَلُونَ","orang-orang yang bodoh","tajhalūna",1347]],"t":"Dia (Hud) berkata, \"Sesungguhnya ilmu (tentang itu) hanya pada Allah, dan aku (hanya) menyampaikan kepadamu apa yang diwahyukan kepadaku, tetapi aku melihat kamu adalah kaum yang berlaku bodoh.\""},{"n":24,"w":[["فَلَمَّا","maka tatkala","falammā",72],["رَأَوْهُ","mereka melihatnya","ra-awhu",46],["عَارِضًۭا","awan","ʿāriḍan",2205],["مُّسْتَقْبِلَ","menuju","mus'taqbila",3993],["أَوْدِيَتِهِمْ","lembah-lembah mereka","awdiyatihim",2033],["قَالُوا۟","mereka berkata","qālū",6],["هَـٰذَا","ini","hādhā",37],["عَارِضٌۭ","awan","ʿāriḍun",2205],["مُّمْطِرُنَا ۚ","menghujani kami","mum'ṭirunā",3972],["بَلْ","tetapi","bal",96],["هُوَ","itu(azab)","huwa",20],["مَا","apa yang","mā",2],["ٱسْتَعْجَلْتُم","kamu minta disegerakan","is'taʿjaltum",533],["بِهِۦ ۖ","dengannya","bihi",16],["رِيحٌۭ","angin","rīḥun",382],["فِيهَا","didalamnya","fīhā",3],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",167]],"t":"Maka ketika mereka melihat azab itu berupa awan yang menuju ke lembah-lembah mereka, mereka berkata, \"Inilah awan yang akan menurunkan hujan kepada kita.\" (Bukan!) Tetapi itulah azab yang kamu minta agar disegerakan datangnya, (yaitu) angin yang mengandung azab yang pedih,"},{"n":25,"w":[["تُدَمِّرُ","menghancurkan","tudammiru",971],["كُلَّ","segala","kulla",31],["شَىْءٍۭ","sesuatu","shayin",41],["بِأَمْرِ","dengan perintah","bi-amri",66],["رَبِّهَا","Tuhannya","rabbihā",10],["فَأَصْبَحُوا۟","maka jadikanlah mereka","fa-aṣbaḥū",383],["لَا","tidak","lā",4],["يُرَىٰٓ","mereka terlihat","yurā",46],["إِلَّا","kecuali","illā",15],["مَسَـٰكِنُهُمْ ۚ","tempat tinggal mereka","masākinuhum",735],["كَذَٰلِكَ","demikianlah","kadhālika",19],["نَجْزِى","Kami memberi balasan","najzī",164],["ٱلْقَوْمَ","kaum","l-qawma",27],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",228]],"t":"yang menghancurkan segala sesuatu dengan perintah Tuhannya, sehingga mereka (kaum 'Ād) menjadi tidak tampak lagi (di bumi) kecuali hanya (bekas-bekas) tempat tinggal mereka. Demikianlah Kami memberi balasan kepada kaum yang berdosa."},{"n":26,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["مَكَّنَّـٰهُمْ","Kami meneguhkan kedudukan mereka","makkannāhum",688],["فِيمَآ","di dalam hal","fīmā",3],["إِن","tidak","in",14],["مَّكَّنَّـٰكُمْ","Kami meneguhkan kedudukanmu","makkannākum",688],["فِيهِ","dalam hal itu","fīhi",3],["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["لَهُمْ","bagi mereka","lahum",11],["سَمْعًۭا","pendengaran","samʿan",473],["وَأَبْصَـٰرًۭا","dan penglihatan","wa-abṣāran",248],["وَأَفْـِٔدَةًۭ","dan hati","wa-afidatan",593],["فَمَآ","tetapi tidak","famā",2],["أَغْنَىٰ","berguna","aghnā",271],["عَنْهُمْ","bagi mereka","ʿanhum",21],["سَمْعُهُمْ","pendengaran mereka","samʿuhum",473],["وَلَآ","dan tidak","walā",4],["أَبْصَـٰرُهُمْ","penglihatan mereka","abṣāruhum",248],["وَلَآ","dan tidak","walā",4],["أَفْـِٔدَتُهُم","hati mereka","afidatuhum",593],["مِّن","dari","min",0],["شَىْءٍ","sesuatu/sedikitpun","shayin",41],["إِذْ","ketika","idh",53],["كَانُوا۟","adalah mereka","kānū",9],["يَجْحَدُونَ","mereka mengingkari","yajḥadūna",731],["بِـَٔايَـٰتِ","terhadap ayat-ayat","biāyāti",28],["ٱللَّهِ","Allah","l-lahi",1],["وَحَاقَ","dan meliputi","waḥāqa",819],["بِهِم","pada mereka","bihim",11],["مَّا","apa yang","mā",2],["كَانُوا۟","mereka adalah","kānū",9],["بِهِۦ","dengannya","bihi",16],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",495]],"t":"Dan sungguh, Kami telah meneguhkan kedudukan mereka (dengan kemakmuran dan kekuatan) yang belum pernah Kami berikan kepada kamu dan Kami telah memberikan kepada mereka pendengaran, penglihatan, dan hati; tetapi pendengaran, penglihatan, dan hati mereka itu tidak berguna sedikit pun bagi mereka, karena mereka (selalu) mengingkari ayat-ayat Allah, dan (ancaman) azab yang dahulu mereka perolok-olokkan telah mengepung mereka."},{"n":27,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَهْلَكْنَا","Kami telah membinasakan","ahlaknā",231],["مَا","apa yang","mā",2],["حَوْلَكُم","di sekitarmu","ḥawlakum",564],["مِّنَ","dari","mina",0],["ٱلْقُرَىٰ","negeri-negeri","l-qurā",210],["وَصَرَّفْنَا","dan Kami mengulang-ulang","waṣarrafnā",822],["ٱلْـَٔايَـٰتِ","ayat-ayat","l-āyāti",28],["لَعَلَّهُمْ","supaya mereka","laʿallahum",92],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",146]],"t":"Dan sungguh, telah Kami binasakan negeri-negeri di sekitarmu, dan juga telah Kami jelaskan berulang-ulang tanda-tanda (kebesaran Kami), agar mereka kembali (bertobat)."},{"n":28,"w":[["فَلَوْلَا","maka mengapa tidak","falawlā",156],["نَصَرَهُمُ","menolong mereka","naṣarahumu",200],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ٱتَّخَذُوا۟","mereka jadikan","ittakhadhū",98],["مِن","dari","min",0],["دُونِ","selain","dūni",79],["ٱللَّهِ","Allah","l-lahi",1],["قُرْبَانًا","pendekatan diri","qur'bānan",1977],["ءَالِهَةًۢ ۖ","Tuhan","ālihatan",75],["بَلْ","tetapi","bal",96],["ضَلُّوا۟","lenyap","ḍallū",223],["عَنْهُمْ ۚ","dari mereka","ʿanhum",21],["وَذَٰلِكَ","dan itulah","wadhālika",19],["إِفْكُهُمْ","kebohongan mereka","if'kuhum",868],["وَمَا","dan apa yang","wamā",2],["كَانُوا۟","mereka adalah","kānū",9],["يَفْتَرُونَ","mereka ada-adakan","yaftarūna",235]],"t":"Maka mengapa (berhala-berhala dan tuhan-tuhan) yang mereka sembah selain Allah untuk mendekatkan diri (kepada-Nya) tidak dapat menolong mereka? Bahkan tuhan-tuhan itu telah lenyap dari mereka; dan itulah akibat kebohongan mereka dan apa yang dahulu mereka ada-adakan."},{"n":29,"w":[["وَإِذْ","dan ketika","wa-idh",53],["صَرَفْنَآ","Kami hadapkan","ṣarafnā",654],["إِلَيْكَ","kepadamu","ilayka",13],["نَفَرًۭا","golongan/rombongan","nafaran",1954],["مِّنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",465],["يَسْتَمِعُونَ","mereka mendengarkan","yastamiʿūna",609],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",178],["فَلَمَّا","maka tatkala","falammā",72],["حَضَرُوهُ","mereka menghadirinya","ḥaḍarūhu",1046],["قَالُوٓا۟","mareka berkata","qālū",6],["أَنصِتُوا۟ ۖ","diamlah kamu","anṣitū",2164],["فَلَمَّا","maka tatkala","falammā",72],["قُضِىَ","telah selesai","quḍiya",202],["وَلَّوْا۟","dan mereka kembali","wallaw",374],["إِلَىٰ","kepada","ilā",13],["قَوْمِهِم","kaumnya","qawmihim",27],["مُّنذِرِينَ","orang-orang yanng memberi peringatan","mundhirīna",630]],"t":"Dan (ingatlah) ketika Kami hadapkan kepadamu (Muhammad) serombongan jin yang mendengarkan (bacaan) Alquran, maka ketika mereka menghadiri (pembacaan)nya mereka berkata, \"Diamlah kamu! (untuk mendengarkannya)\" Maka ketika telah selesai, mereka kembali kepada kaumnya (untuk) memberi peringatan."},{"n":30,"w":[["قَالُوا۟","mereka berkata","qālū",6],["يَـٰقَوْمَنَآ","hai kaum kami","yāqawmanā",27],["إِنَّا","sesungguhnya kami","innā",5],["سَمِعْنَا","kami telah mendengarkan","samiʿ'nā",148],["كِتَـٰبًا","kitab","kitāban",49],["أُنزِلَ","diturunkan","unzila",62],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["مُوسَىٰ","Musa","mūsā",85],["مُصَدِّقًۭا","membenarkan","muṣaddiqan",528],["لِّمَا","terhadap apa","limā",2],["بَيْنَ","antara","bayna",47],["يَدَيْهِ","sebelumnya","yadayhi",101],["يَهْدِىٓ","memberi petunjuk","yahdī",80],["إِلَى","kepada","ilā",13],["ٱلْحَقِّ","kebenaran","l-ḥaqi",50],["وَإِلَىٰ","dan kepada","wa-ilā",13],["طَرِيقٍۢ","jalan","ṭarīqin",1530],["مُّسْتَقِيمٍۢ","lurus","mus'taqīmin",321]],"t":"Mereka berkata, \"Wahai kaum kami! Sungguh, kami telah mendengarkan Kitab (Alquran) yang diturunkan setelah Musa, membenarkan (kitab-kitab) yang datang sebelumnya, membimbing kepada kebenaran, dan kepada jalan yang lurus."},{"n":31,"w":[["يَـٰقَوْمَنَآ","hai kaum kami","yāqawmanā",27],["أَجِيبُوا۟","penuhilah","ajībū",953],["دَاعِىَ","orang yang menyeru","dāʿiya",1541],["ٱللَّهِ","Allah","l-lahi",1],["وَءَامِنُوا۟","dan berimanlah","waāminū",18],["بِهِۦ","kepada-Nya","bihi",16],["يَغْفِرْ","Dia akan mengampuni","yaghfir",185],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["ذُنُوبِكُمْ","dosa-dosa kamu","dhunūbikum",314],["وَيُجِرْكُم","dan Dia akan melepaskan kamu","wayujir'kum",1128],["مِّنْ","dari","min",0],["عَذَابٍ","azab","ʿadhābin",36],["أَلِيمٍۢ","pedih","alīmin",167]],"t":"Wahai kaum kami! Terimalah (seruan) orang (Muhammad) yang menyeru kepada Allah. Dan berimanlah kepada-Nya, niscaya Dia akan mengampuni dosa-dosamu, dan melepaskan kamu dari azab yang pedih."},{"n":32,"w":[["وَمَن","dan barang siapa","waman",12],["لَّا","tidak","lā",4],["يُجِبْ","memenuhi","yujib",953],["دَاعِىَ","orang yang menyeru","dāʿiya",1541],["ٱللَّهِ","Allah","l-lahi",1],["فَلَيْسَ","maka tidaklah ia","falaysa",123],["بِمُعْجِزٍۢ","menyelamatkan","bimuʿ'jizin",736],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَيْسَ","dan tidak ia","walaysa",123],["لَهُۥ","baginya","lahu",16],["مِن","dari","min",0],["دُونِهِۦٓ","selain Dia","dūnihi",79],["أَوْلِيَآءُ ۚ","pelindung","awliyāu",132],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",310],["مُّبِينٍ","nyata","mubīnin",102]],"t":"Dan barangsiapa tidak menerima (seruan) orang yang menyeru kepada Allah (Muhammad) maka dia tidak akan dapat melepaskan diri dari siksaan Allah di bumi, padahal tidak ada pelindung baginya selain Allah. Mereka berada dalam kesesatan yang nyata.\""},{"n":33,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["أَنَّ","bahwasanya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",61],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَلَمْ","dan tidak","walam",32],["يَعْىَ","Dia merasa payah","yaʿya",2233],["بِخَلْقِهِنَّ","dengan menciptakannya","bikhalqihinna",229],["بِقَـٰدِرٍ","berkuasa","biqādirin",667],["عَلَىٰٓ","atas","ʿalā",8],["أَن","bahwa","an",17],["يُحْـِۧىَ","menghidupkan","yuḥ'yiya",230],["ٱلْمَوْتَىٰ ۚ","orang mati","l-mawtā",312],["بَلَىٰٓ","ya/benar","balā",461],["إِنَّهُۥ","sesungguhnya","innahu",5],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha Kuasa","qadīrun",261]],"t":"Dan tidakkah mereka memperhatikan bahwa sesungguhnya Allah yang menciptakan langit dan bumi, dan Dia tidak merasa payah karena menciptakannya, dan Dia kuasa menghidupkan yang mati? Begitulah, sungguh, Dia Mahakuasa atas segala sesuatu."},{"n":34,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["يُعْرَضُ","dihadapkan","yuʿ'raḍu",767],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["عَلَى","ke","ʿalā",8],["ٱلنَّارِ","neraka","l-nāri",78],["أَلَيْسَ","bukankah","alaysa",123],["هَـٰذَا","ini","hādhā",37],["بِٱلْحَقِّ ۖ","dengan benar","bil-ḥaqi",50],["قَالُوا۟","mereka berkata","qālū",6],["بَلَىٰ","ya/benar","balā",461],["وَرَبِّنَا ۚ","dan demi Tuhan kami","warabbinā",10],["قَالَ","Dia berkata","qāla",6],["فَذُوقُوا۟","maka rasakan","fadhūqū",324],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["بِمَا","sebab","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَكْفُرُونَ","kalian kafir","takfurūna",40]],"t":"Dan (ingatlah) pada hari (ketika) orang-orang yang kafir dihadapkan kepada neraka, (mereka akan ditanya), \"Bukankah (azab) ini benar?\" Mereka menjawab, \"Ya benar, demi Tuhan kami.\" Allah berfirman, \"Maka rasakanlah azab ini, karena dahulu kamu mengingkarinya.\""},{"n":35,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",203],["كَمَا","sebagaimana","kamā",2],["صَبَرَ","bersabar","ṣabara",203],["أُو۟لُوا۟","orang-orang yang mempunyai","ulū",258],["ٱلْعَزْمِ","keteguhan hati","l-ʿazmi",1294],["مِنَ","dari","mina",0],["ٱلرُّسُلِ","rasul-rasul","l-rusuli",35],["وَلَا","dan jangan","walā",4],["تَسْتَعْجِل","kamu minta disegerakan","tastaʿjil",533],["لَّهُمْ ۚ","bagi mereka","lahum",11],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",380],["يَوْمَ","pada hari","yawma",25],["يَرَوْنَ","mereka melihat","yarawna",46],["مَا","apa yang","mā",2],["يُوعَدُونَ","mereka diancam","yūʿadūna",179],["لَمْ","tidak","lam",32],["يَلْبَثُوٓا۟","mereka tinggal","yalbathū",369],["إِلَّا","kecuali","illā",15],["سَاعَةًۭ","sesaat","sāʿatan",251],["مِّن","dari","min",0],["نَّهَارٍۭ ۚ","siang hari","nahārin",209],["بَلَـٰغٌۭ ۚ","penjelasan","balāghun",623],["فَهَلْ","maka tidaklah","fahal",118],["يُهْلَكُ","dibinasakan","yuh'laku",231],["إِلَّا","kecuali","illā",15],["ٱلْقَوْمُ","kaum","l-qawmu",27],["ٱلْفَـٰسِقُونَ","orang-orang yang fasik","l-fāsiqūna",319]],"t":"Maka bersabarlah engkau (Muhammad) sebagaimana kesabaran rasul-rasul yang memiliki keteguhan hati, dan janganlah engkau meminta agar azab disegerakan untuk mereka. Pada hari mereka melihat azab yang dijanjikan, mereka merasa seolah-olah tinggal (di dunia) hanya sesaat saja dari siang hari. Tugasmu hanya menyampaikan. Maka tidak ada yang dibinasakan, kecuali kaum yang fasik (tidak taat kepada Allah)."}]