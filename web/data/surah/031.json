[{"n":1,"w":[["الٓمٓ","Alif laam miim","alif-lam-meem",1173]],"t":"Alif Lām Mīm."},{"n":2,"w":[["تِلْكَ","inilah","til'ka",310],["ءَايَـٰتُ","ayat-ayat","āyātu",34],["ٱلْكِتَـٰبِ","Al kitab","l-kitābi",57],["ٱلْحَكِيمِ","mengandung hikmah","l-ḥakīmi",126]],"t":"Inilah ayat-ayat Alquran yang mengandung hikmah,"},{"n":3,"w":[["هُدًۭى","petunjuk","hudan",143],["وَرَحْمَةًۭ","dan rahmat","waraḥmatan",115],["لِّلْمُحْسِنِينَ","bagi orang-orang yang berbuat kebaikan","lil'muḥ'sinīna",321]],"t":"sebagai petunjuk dan rahmat bagi orang-orang yang berbuat kebaikan,"},{"n":4,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يُقِيمُونَ","mereka mendirikan","yuqīmūna",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["وَيُؤْتُونَ","dan mereka menunaikan","wayu'tūna",53],["ٱلزَّكَوٰةَ","zakat","l-zakata",374],["وَهُم","dan mereka","wahum",16],["بِٱلْـَٔاخِرَةِ","pada akhirat","bil-ākhirati",82],["هُمْ","mereka","hum",16],["يُوقِنُونَ","mereka meyakini","yūqinūna",730]],"t":"(yaitu) orang-orang yang melaksanakan salat, menunaikan zakat dan mereka meyakini adanya akhirat."},{"n":5,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["عَلَىٰ","mendapat/atas","ʿalā",11],["هُدًۭى","petunjuk","hudan",143],["مِّن","dari","min",1],["رَّبِّهِمْ ۖ","Tuhan mereka","rabbihim",15],["وَأُو۟لَـٰٓئِكَ","dan mereka itu","wa-ulāika",65],["هُمُ","mereka","humu",16],["ٱلْمُفْلِحُونَ","orang-orang yang beruntung","l-muf'liḥūna",706]],"t":"Merekalah orang-orang yang tetap mendapat petunjuk dari Tuhannya dan mereka itulah orang-orang yang beruntung."},{"n":6,"w":[["وَمِنَ","dan diantara","wamina",1],["ٱلنَّاسِ","manusia","l-nāsi",60],["مَن","orang yang","man",17],["يَشْتَرِى","membeli","yashtarī",508],["لَهْوَ","sia-sia","lahwa",854],["ٱلْحَدِيثِ","cerita/pembicaraan","l-ḥadīthi",402],["لِيُضِلَّ","untuk menyesatkan","liyuḍilla",199],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["بِغَيْرِ","dengan tanpa","bighayri",85],["عِلْمٍۢ","ilmu pengetahuan","ʿil'min",122],["وَيَتَّخِذَهَا","dan dia menjadikannya","wayattakhidhahā",107],["هُزُوًا ۚ","olok-olok","huzuwan",797],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["لَهُمْ","bagi mereka","lahum",16],["عَذَابٌۭ","azab","ʿadhābun",43],["مُّهِينٌۭ","yang hina","muhīnun",681]],"t":"Dan di antara manusia (ada) orang yang mempergunakan percakapan kosong untuk menyesatkan (manusia) dari jalan Allah tanpa ilmu dan menjadikannya olok-olokan. Mereka itu akan memperoleh azab yang menghinakan."},{"n":7,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["تُتْلَىٰ","dibacakan","tut'lā",209],["عَلَيْهِ","kepadanya","ʿalayhi",11],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",34],["وَلَّىٰ","dia berpaling","wallā",389],["مُسْتَكْبِرًۭا","menyombongkan diri","mus'takbiran",1220],["كَأَن","seakan-akan","ka-an",22],["لَّمْ","tidak","lam",39],["يَسْمَعْهَا","dia mendengarnya","yasmaʿhā",159],["كَأَنَّ","seakan-akan","ka-anna",395],["فِىٓ","di","fī",7],["أُذُنَيْهِ","kedua telinganya","udhunayhi",555],["وَقْرًۭا ۖ","sumbat","waqran",1259],["فَبَشِّرْهُ","maka beri kabar gembira dia","fabashir'hu",326],["بِعَذَابٍ","dengan azab","biʿadhābin",43],["أَلِيمٍ","pedih","alīmin",178]],"t":"Dan apabila dibacakan kepadanya ayat-ayat Kami, dia berpaling dengan menyombongkan diri seolah-olah dia belum mendengarnya, seakan-akan ada sumbatan di kedua telinganya, maka gembirakanlah dia dengan azab yang pedih."},{"n":8,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَعَمِلُوا۟","dan beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","shaleh","l-ṣāliḥāti",104],["لَهُمْ","bagi mereka","lahum",16],["جَنَّـٰتُ","surga","jannātu",86],["ٱلنَّعِيمِ","penuh dengan kenikmatan","l-naʿīmi",588]],"t":"Sesungguhnya orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat surga-surga yang penuh kenikmatan,"},{"n":9,"w":[["خَـٰلِدِينَ","mereka kekal","khālidīna",173],["فِيهَا ۖ","didalamnya","fīhā",7],["وَعْدَ","janji","waʿda",258],["ٱللَّهِ","Allah","l-lahi",4],["حَقًّۭا ۚ","benar","ḥaqqan",58],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",124],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",126]],"t":"mereka kekal di dalamnya, sebagai janji Allah yang benar. Dan Dia Mahaperkasa, Mahabijaksana."},{"n":10,"w":[["خَلَقَ","Dia menciptakan","khalaqa",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["بِغَيْرِ","dengan tanpa","bighayri",85],["عَمَدٍۢ","tiang","ʿamadin",1793],["تَرَوْنَهَا ۖ","kamu melihatnya","tarawnahā",54],["وَأَلْقَىٰ","dan Dia meletakkan","wa-alqā",183],["فِى","di atas","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["رَوَٰسِىَ","gunung-gunung","rawāsiya",870],["أَن","bahwa","an",22],["تَمِيدَ","menggoyangkan","tamīda",1909],["بِكُمْ","dengan/untuk kalian","bikum",32],["وَبَثَّ","dan Dia mengembang biakan","wabatha",1343],["فِيهَا","didalamnya","fīhā",7],["مِن","dari","min",1],["كُلِّ","macam-macam","kulli",38],["دَآبَّةٍۢ ۚ","binatang","dābbatin",558],["وَأَنزَلْنَا","dan Kami turunkan","wa-anzalnā",71],["مِنَ","dari","mina",1],["ٱلسَّمَآءِ","langit","l-samāi",44],["مَآءًۭ","air","māan",204],["فَأَنۢبَتْنَا","lalu Kami tumbuhkan","fa-anbatnā",600],["فِيهَا","padanya","fīhā",7],["مِن","dari","min",1],["كُلِّ","macam-macam","kulli",38],["زَوْجٍۢ","jenis","zawjin",166],["كَرِيمٍ","baik","karīmin",383]],"t":"Dia menciptakan langit tanpa tiang sebagaimana kamu melihatnya, dan Dia meletakkan gunung-gunung (di permukaan) bumi agar ia (bumi) tidak menggoyangkan kamu; dan memperkembangbiakkan segala macam jenis makhluk bergerak yang bernyawa di bumi. Dan Kami turunkan air hujan dari langit, lalu Kami tumbuhkan padanya segala macam tumbuh-tumbuhan yang baik."},{"n":11,"w":[["هَـٰذَا","ini","hādhā",64],["خَلْقُ","ciptaan","khalqu",241],["ٱللَّهِ","Allah","l-lahi",4],["فَأَرُونِى","maka perlihatkan kepadaku","fa-arūnī",305],["مَاذَا","apa yang","mādhā",428],["خَلَقَ","menciptakan","khalaqa",70],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["دُونِهِۦ ۚ","selain Dia","dūnihi",88],["بَلِ","bahkan","bali",105],["ٱلظَّـٰلِمُونَ","orang-orang yang zalim","l-ẓālimūna",97],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["مُّبِينٍۢ","yang nyata","mubīnin",111]],"t":"Inilah ciptaan Allah, maka perlihatkanlah olehmu kepadaku apa yang telah diciptakan oleh (sesembahanmu) selain Allah. Sebenarnya orang-orang yang zalim itu berada di dalam kesesatan yang nyata."},{"n":12,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["ءَاتَيْنَا","Kami telah memberikan","ātaynā",53],["لُقْمَـٰنَ","Luqmân","luq'māna",2453],["ٱلْحِكْمَةَ","hikmah","l-ḥik'mata",519],["أَنِ","agar","ani",22],["ٱشْكُرْ","bersyukur","ush'kur",267],["لِلَّهِ ۚ","kepada Allah","lillahi",4],["وَمَن","dan barang siapa","waman",17],["يَشْكُرْ","bersyukur","yashkur",267],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",9],["يَشْكُرُ","ia bersyukur","yashkuru",267],["لِنَفْسِهِۦ ۖ","untuk dirinya sendiri","linafsihi",47],["وَمَن","dan barang siapa yang","waman",17],["كَفَرَ","ingkar","kafara",48],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱللَّهَ","Allah","l-laha",4],["غَنِىٌّ","Maha Kaya","ghaniyyun",453],["حَمِيدٌۭ","Maha Terpuji","ḥamīdun",577]],"t":"Dan sungguh, telah Kami berikan hikmah kepada Lukman, yaitu, \"Bersyukurlah kepada Allah! Dan barangsiapa bersyukur (kepada Allah), maka sesungguhnya dia bersyukur untuk dirinya sendiri; dan barangsiapa tidak bersyukur (kufur), maka sesungguhnya Allah Mahakaya, Maha Terpuji.\""},{"n":13,"w":[["وَإِذْ","dan ketika","wa-idh",61],["قَالَ","berkata","qāla",10],["لُقْمَـٰنُ","Luqmân","luq'mānu",2453],["لِٱبْنِهِۦ","kepada anaknya","li-ib'nihi",90],["وَهُوَ","dan dia","wahuwa",25],["يَعِظُهُۥ","memberi pelajaran kepadanya","yaʿiẓuhu",652],["يَـٰبُنَىَّ","Wahai keturunan","yābunayya",90],["لَا","janganlah","lā",8],["تُشْرِكْ","kamu mempersekutukan","tush'rik",182],["بِٱللَّهِ ۖ","dengan Allah","bil-lahi",4],["إِنَّ","sesungguhnya","inna",9],["ٱلشِّرْكَ","mempersekutukan","l-shir'ka",1279],["لَظُلْمٌ","benar-benar kezaliman","laẓul'mun",521],["عَظِيمٌۭ","yang besar","ʿaẓīmun",118]],"t":"Dan (ingatlah) ketika Lukman berkata kepada anaknya, ketika dia memberi pelajaran kepadanya, \"Wahai anakku! Janganlah engkau mempersekutukan Allah, sesungguhnya mempersekutukan (Allah) adalah benar-benar kezaliman yang besar.\""},{"n":14,"w":[["وَوَصَّيْنَا","dan Kami wasiatkan","wawaṣṣaynā",818],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["بِوَٰلِدَيْهِ","terhadap kedua orang tuanya","biwālidayhi",879],["حَمَلَتْهُ","mengandungnya","ḥamalathu",299],["أُمُّهُۥ","ibunya","ummuhu",354],["وَهْنًا","kelelahan","wahnan",2734],["عَلَىٰ","atas","ʿalā",11],["وَهْنٍۢ","kelelahan","wahnin",2734],["وَفِصَـٰلُهُۥ","dan ia menyapihnya","wafiṣāluhu",1858],["فِى","dalam","fī",7],["عَامَيْنِ","dua tahun","ʿāmayni",900],["أَنِ","agar","ani",22],["ٱشْكُرْ","bersyukurlah","ush'kur",267],["لِى","kepada-Ku","lī",158],["وَلِوَٰلِدَيْكَ","dan kepada kedua orang tuamu","waliwālidayka",879],["إِلَىَّ","kepada-Ku","ilayya",18],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",404]],"t":"Dan Kami perintahkan kepada manusia (agar berbuat baik) kepada kedua orang tuanya. Ibunya telah mengandungnya dalam keadaan lemah yang bertambah-tambah, dan menyapihnya dalam usia dua tahun. Bersyukurlah kepada-Ku dan kepada kedua orang tuamu. Hanya kepada Aku kembalimu."},{"n":15,"w":[["وَإِن","dan jika","wa-in",19],["جَـٰهَدَاكَ","keduanya memaksamu","jāhadāka",415],["عَلَىٰٓ","untuk","ʿalā",11],["أَن","bahwa","an",22],["تُشْرِكَ","mempersekutukan","tush'rika",182],["بِى","dengan Aku","bī",158],["مَا","apa-apa","mā",6],["لَيْسَ","tidak","laysa",133],["لَكَ","bagimu","laka",153],["بِهِۦ","dengannya tentang itu","bihi",21],["عِلْمٌۭ","pengetahuan","ʿil'mun",122],["فَلَا","maka jangan","falā",8],["تُطِعْهُمَا ۖ","kamu mentaati keduanya","tuṭiʿ'humā",177],["وَصَاحِبْهُمَا","dan pergaulilah keduanya","waṣāḥib'humā",2290],["فِى","di","fī",7],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["مَعْرُوفًۭا ۖ","dengan baik","maʿrūfan",323],["وَٱتَّبِعْ","dan ikutilah","wa-ittabiʿ",95],["سَبِيلَ","jalan","sabīla",73],["مَنْ","orang yang","man",17],["أَنَابَ","kembali","anāba",777],["إِلَىَّ ۚ","kepada-Ku","ilayya",18],["ثُمَّ","kemudian","thumma",41],["إِلَىَّ","kepada-Ku","ilayya",18],["مَرْجِعُكُمْ","tempat kembalimu","marjiʿukum",611],["فَأُنَبِّئُكُم","lalu akan Ku-beritahukan kamu","fa-unabbi-ukum",270],["بِمَا","tentang apa","bimā",6],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52]],"t":"Dan jika keduanya memaksamu untuk mempersekutukan Aku dengan sesuatu yang engkau tidak mempunyai ilmu tentang itu, maka janganlah engkau menaati keduanya, dan pergaulilah keduanya di dunia dengan baik, dan ikutilah jalan orang yang kembali kepada-Ku. Kemudian hanya kepada-Ku tempat kembalimu, maka akan Aku beritahukan kepadamu apa yang telah kamu kerjakan."},{"n":16,"w":[["يَـٰبُنَىَّ","Wahai keturunan","yābunayya",90],["إِنَّهَآ","sesungguhnya","innahā",9],["إِن","jika","in",19],["تَكُ","adalah kamu","taku",12],["مِثْقَالَ","seberat","mith'qāla",1000],["حَبَّةٍۢ","biji","ḥabbatin",1314],["مِّنْ","dari","min",1],["خَرْدَلٍۢ","sawi","khardalin",2766],["فَتَكُن","maka adalah","fatakun",12],["فِى","dalam","fī",7],["صَخْرَةٍ","batu","ṣakhratin",2303],["أَوْ","atau","aw",50],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["أَوْ","atau","aw",50],["فِى","didalam","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["يَأْتِ","mendatangkan","yati",56],["بِهَا","dengannya","bihā",106],["ٱللَّهُ ۚ","Allah","l-lahu",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَطِيفٌ","Maha Halus","laṭīfun",1097],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",277]],"t":"(Lukman berkata), \"Wahai anakku! Sungguh, jika ada (suatu perbuatan) seberat biji sawi, dan berada dalam batu atau di langit atau di bumi, niscaya Allah akan memberinya (balasan). Sesungguhnya Allah Mahahalus, Mahateliti."},{"n":17,"w":[["يَـٰبُنَىَّ","Wahai keturunan","yābunayya",90],["أَقِمِ","dirikanlah","aqimi",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["وَأْمُرْ","dan suruhlah","wamur",161],["بِٱلْمَعْرُوفِ","dengan yang baik","bil-maʿrūfi",323],["وَٱنْهَ","dan cegahlah","wa-in'ha",372],["عَنِ","dari","ʿani",27],["ٱلْمُنكَرِ","perbuatan yang mungkar","l-munkari",563],["وَٱصْبِرْ","dan bersabarlah","wa-iṣ'bir",215],["عَلَىٰ","atas","ʿalā",11],["مَآ","apa","mā",6],["أَصَابَكَ ۖ","menimpa kamu","aṣābaka",201],["إِنَّ","sesungguhnya","inna",9],["ذَٰلِكَ","demikian itu","dhālika",26],["مِنْ","dari","min",1],["عَزْمِ","ketetapan/kesungguhan","ʿazmi",1312],["ٱلْأُمُورِ","perkara/perintah","l-umūri",75]],"t":"Wahai anakku! Laksanakanlah salat dan suruhlah (manusia) berbuat yang makruf dan cegahlah (mereka) dari yang mungkar dan bersabarlah terhadap apa yang menimpamu, sesungguhnya yang demikian itu termasuk perkara yang penting."},{"n":18,"w":[["وَلَا","dan jangan","walā",8],["تُصَعِّرْ","kamu memalingkan","tuṣaʿʿir",3242],["خَدَّكَ","mukamu","khaddaka",4541],["لِلنَّاسِ","kepada manusia","lilnnāsi",60],["وَلَا","dan jangan","walā",8],["تَمْشِ","kamu berjalan","tamshi",500],["فِى","di muka","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["مَرَحًا ۖ","angkuh","maraḥan",2481],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَا","tidak","lā",8],["يُحِبُّ","menyukai","yuḥibbu",200],["كُلَّ","setiap","kulla",38],["مُخْتَالٍۢ","orang yang sombong","mukh'tālin",1951],["فَخُورٍۢ","kebanggaan diri","fakhūrin",1571]],"t":"Dan janganlah kamu memalingkan wajah dari manusia (karena sombong) dan janganlah berjalan di bumi dengan angkuh. Sungguh, Allah tidak menyukai orang-orang yang sombong dan membanggakan diri."},{"n":19,"w":[["وَٱقْصِدْ","dan sederhanakanlah","wa-iq'ṣid",4108],["فِى","didalam","fī",7],["مَشْيِكَ","berjalanmu","mashyika",3667],["وَٱغْضُضْ","dan lunakkan","wa-ugh'ḍuḍ",1574],["مِن","dari","min",1],["صَوْتِكَ ۚ","suara","ṣawtika",980],["إِنَّ","sesungguhnya","inna",9],["أَنكَرَ","seburuk-buruk","ankara",3001],["ٱلْأَصْوَٰتِ","suara-suara","l-aṣwāti",980],["لَصَوْتُ","sungguh suara","laṣawtu",980],["ٱلْحَمِيرِ","keledai","l-ḥamīri",1171]],"t":"Dan sederhanakanlah dalam berjalan dan lunakkanlah suaramu, Sesungguhnya seburuk-buruk suara ialah suara keledai.\""},{"n":20,"w":[["أَلَمْ","tidakkah","alam",39],["تَرَوْا۟","kamu perhatikan","taraw",54],["أَنَّ","bahwasanya","anna",36],["ٱللَّهَ","Allah","l-laha",4],["سَخَّرَ","Dia telah menundukkan","sakhara",488],["لَكُم","bagi kalian","lakum",32],["مَّا","apa yang","mā",6],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَمَا","dan apa yang","wamā",6],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَأَسْبَغَ","dan Dia telah menyempurnakan","wa-asbagha",3020],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["نِعَمَهُۥ","nikmat-Nya","niʿamahu",250],["ظَـٰهِرَةًۭ","lahir","ẓāhiratan",843],["وَبَاطِنَةًۭ ۗ","dan batin","wabāṭinatan",1555],["وَمِنَ","dan diantara","wamina",1],["ٱلنَّاسِ","manusia","l-nāsi",60],["مَن","orang","man",17],["يُجَـٰدِلُ","ia membantah","yujādilu",440],["فِى","tentang","fī",7],["ٱللَّهِ","Allah","l-lahi",4],["بِغَيْرِ","dengan tanpa","bighayri",85],["عِلْمٍۢ","ilmu pengetahuan","ʿil'min",122],["وَلَا","dan tanpa","walā",8],["هُدًۭى","petunjuk","hudan",143],["وَلَا","dan tidak","walā",8],["كِتَـٰبٍۢ","kitab","kitābin",57],["مُّنِيرٍۢ","memberi penerangan","munīrin",1225]],"t":"Tidakkah kamu memperhatikan bahwa Allah telah menundukkan apa yang ada di langit dan apa yang ada di bumi untuk (kepentingan)mu dan menyempurnakan nikmat-Nya untukmu lahir dan batin. Tetapi di antara manusia ada yang membantah tentang (keesaan) Allah tanpa ilmu atau petunjuk dan tanpa Kitab yang memberi penerangan."},{"n":21,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["قِيلَ","dikatakan","qīla",10],["لَهُمُ","kepada mereka","lahumu",16],["ٱتَّبِعُوا۟","ikutilah","ittabiʿū",95],["مَآ","apa yang","mā",6],["أَنزَلَ","menurunkan","anzala",71],["ٱللَّهُ","Allah","l-lahu",4],["قَالُوا۟","mereka berkata","qālū",10],["بَلْ","bahkan","bal",105],["نَتَّبِعُ","kami mengikuti","nattabiʿu",95],["مَا","apa yang","mā",6],["وَجَدْنَا","kami dapati","wajadnā",120],["عَلَيْهِ","atasnya","ʿalayhi",11],["ءَابَآءَنَآ ۚ","bapak-bapak kami","ābāanā",116],["أَوَلَوْ","apakah walaupun","awalaw",66],["كَانَ","adalah","kāna",12],["ٱلشَّيْطَـٰنُ","syaitan","l-shayṭānu",134],["يَدْعُوهُمْ","menyeru mereka","yadʿūhum",74],["إِلَىٰ","kepada","ilā",18],["عَذَابِ","azab","ʿadhābi",43],["ٱلسَّعِيرِ","menyala-nyala","l-saʿīri",617]],"t":"Dan apabila dikatakan kepada mereka, \"Ikutilah apa yang diturunkan Allah!\" Mereka menjawab, \"(Tidak), tetapi kami (hanya) mengikuti kebiasaan yang kami dapati dari nenek moyang kami.\" Apakah mereka (akan mengikuti nenek moyang mereka) walaupun sebenarnya setan menyeru mereka ke dalam azab api yang menyala-nyala (neraka)?"},{"n":22,"w":[["۞ وَمَن","dan barang siapa","waman",17],["يُسْلِمْ","menyerahkan","yus'lim",473],["وَجْهَهُۥٓ","wajahnya/dirinya","wajhahu",180],["إِلَى","kepada","ilā",18],["ٱللَّهِ","Allah","l-lahi",4],["وَهُوَ","dan dia","wahuwa",25],["مُحْسِنٌۭ","orang yang berbuat kebaikan","muḥ'sinun",321],["فَقَدِ","maka sesungguhnya","faqadi",30],["ٱسْتَمْسَكَ","dia telah berpegang","is'tamsaka",2104],["بِٱلْعُرْوَةِ","pada tali","bil-ʿur'wati",2259],["ٱلْوُثْقَىٰ ۗ","teguh/kokoh","l-wuth'qā",2746],["وَإِلَى","dan kepada","wa-ilā",18],["ٱللَّهِ","Allah","l-lahi",4],["عَـٰقِبَةُ","kesudahan","ʿāqibatu",367],["ٱلْأُمُورِ","segala perkara","l-umūri",75]],"t":"Dan barang siapa berserah diri kepada Allah, sedang dia orang yang berbuat kebaikan, maka sesungguhnya dia telah berpegang kepada buhul (tali) yang kokoh. Hanya kepada Allah kesudahan segala urusan."},{"n":23,"w":[["وَمَن","dan barang siapa yang","waman",17],["كَفَرَ","kafir","kafara",48],["فَلَا","maka jangan","falā",8],["يَحْزُنكَ","menyusahkan kamu","yaḥzunka",331],["كُفْرُهُۥٓ ۚ","kekafirannya","kuf'ruhu",335],["إِلَيْنَا","kepada Kami","ilaynā",18],["مَرْجِعُهُمْ","tempat kembali mereka","marjiʿuhum",611],["فَنُنَبِّئُهُم","lalu Kami jelaskan kepada mereka","fanunabbi-uhum",270],["بِمَا","tentang apa","bimā",6],["عَمِلُوٓا۟ ۚ","mereka kerjakan","ʿamilū",52],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",77],["بِذَاتِ","dengan yang ada","bidhāti",112],["ٱلصُّدُورِ","dada","l-ṣudūri",281]],"t":"Dan barang siapa kafir maka kekafirannya itu janganlah menyedihkanmu (Muhammad). Hanya kepada Kami tempat kembali mereka, lalu Kami beritakan kepada mereka apa yang telah mereka kerjakan. Sesungguhnya Allah Maha Mengetahui segala isi hati."},{"n":24,"w":[["نُمَتِّعُهُمْ","Kami beri kesenangan mereka","numattiʿuhum",562],["قَلِيلًۭا","sebentar","qalīlan",186],["ثُمَّ","kemudian","thumma",41],["نَضْطَرُّهُمْ","Kami paksakan mereka","naḍṭarruhum",1132],["إِلَىٰ","kepada","ilā",18],["عَذَابٍ","azab","ʿadhābin",43],["غَلِيظٍۢ","yang keras","ghalīẓin",920]],"t":"Kami biarkan mereka bersenang-senang sebentar, kemudian Kami paksa mereka (masuk) ke dalam azab yang keras."},{"n":25,"w":[["وَلَئِن","dan sungguh jika","wala-in",19],["سَأَلْتَهُم","kamu tanyakan kepada mereka","sa-altahum",119],["مَّنْ","siapakah","man",17],["خَلَقَ","menciptakan","khalaqa",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["لَيَقُولُنَّ","tentu mereka mengatakan","layaqūlunna",10],["ٱللَّهُ ۚ","Allah","l-lahu",4],["قُلِ","katakanlah","quli",10],["ٱلْحَمْدُ","segala puji","l-ḥamdu",286],["لِلَّهِ ۚ","bagi Allah","lillahi",4],["بَلْ","tetapi","bal",105],["أَكْثَرُهُمْ","kebanyakan mereka","aktharuhum",155],["لَا","tidak","lā",8],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Dan sungguh, jika engkau (Muhammad) tanyakan kepada mereka, \"Siapakah yang menciptakan langit dan bumi?\" Tentu mereka akan menjawab, \"Allah.\" Katakanlah, \"Segala puji bagi Allah,\" tetapi kebanyakan mereka tidak mengetahui."},{"n":26,"w":[["لِلَّهِ","kepunyaan Allah","lillahi",4],["مَا","apa yang","mā",6],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ ۚ","dan dibumi","wal-arḍi",28],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["ٱلْغَنِىُّ","Maha Kaya","l-ghaniyu",453],["ٱلْحَمِيدُ","Maha Terpuji","l-ḥamīdu",577]],"t":"Milik Allah lah apa yang di langit dan di bumi. Sesungguhnya Allah, Dialah Yang Mahakaya, Maha Terpuji."},{"n":27,"w":[["وَلَوْ","dan seandainya","walaw",66],["أَنَّمَا","apa saja","annamā",36],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["مِن","dari","min",1],["شَجَرَةٍ","pohon-pohon","shajaratin",532],["أَقْلَـٰمٌۭ","kalam/pena","aqlāmun",1648],["وَٱلْبَحْرُ","dan laut","wal-baḥru",300],["يَمُدُّهُۥ","ditambahnya","yamudduhu",703],["مِنۢ","dari","min",1],["بَعْدِهِۦ","sesudahnya","baʿdihi",67],["سَبْعَةُ","tujuh","sabʿatu",1663],["أَبْحُرٍۢ","laut","abḥurin",300],["مَّا","tidak","mā",6],["نَفِدَتْ","habis","nafidat",1641],["كَلِمَـٰتُ","beberapa kalimat","kalimātu",291],["ٱللَّهِ ۗ","Allah","l-lahi",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["عَزِيزٌ","Maha Perkasa","ʿazīzun",124],["حَكِيمٌۭ","Maha Bijaksana","ḥakīmun",126]],"t":"Dan seandainya pohon-pohon di bumi menjadi pena dan lautan (menjadi tinta), ditambahkan kepadanya tujuh lautan (lagi) setelah (kering)nya, niscaya tidak akan habis-habisnya (dituliskan) kalimat-kalimat Allah. Sesungguhnya Allah Mahaperkasa, Mahabijaksana."},{"n":28,"w":[["مَّا","tidak","mā",6],["خَلْقُكُمْ","menciptakan kalian","khalqukum",241],["وَلَا","dan tidak","walā",8],["بَعْثُكُمْ","kebangkitanmu","baʿthukum",1557],["إِلَّا","kecuali","illā",20],["كَنَفْسٍۢ","seperti jiwa","kanafsin",47],["وَٰحِدَةٍ ۗ","satu","wāḥidatin",379],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["سَمِيعٌۢ","Maha Mendengar","samīʿun",266],["بَصِيرٌ","Maha Melihat","baṣīrun",244]],"t":"Menciptakan dan membangkitkan kamu (bagi Allah) hanyalah seperti (menciptakan dan membangkitkan) satu jiwa saja (mudah). Sesungguhnya Allah Maha Mendengar, Maha Melihat."},{"n":29,"w":[["أَلَمْ","tidaklah","alam",39],["تَرَ","kamu memperhatikan","tara",54],["أَنَّ","bahwasanya","anna",36],["ٱللَّهَ","Allah","l-laha",4],["يُولِجُ","Dia memasukkan","yūliju",830],["ٱلَّيْلَ","malam","al-layla",146],["فِى","ke dalam","fī",7],["ٱلنَّهَارِ","siang","l-nahāri",221],["وَيُولِجُ","dan memasukkan","wayūliju",830],["ٱلنَّهَارَ","siang","l-nahāra",221],["فِى","ke dalam","fī",7],["ٱلَّيْلِ","malam","al-layli",146],["وَسَخَّرَ","dan Dia menundukkan","wasakhara",488],["ٱلشَّمْسَ","matahari","l-shamsa",358],["وَٱلْقَمَرَ","dan bulan","wal-qamara",419],["كُلٌّۭ","masing-masing","kullun",38],["يَجْرِىٓ","berjalan/beredar","yajrī",219],["إِلَىٰٓ","sampai","ilā",18],["أَجَلٍۢ","waktu","ajalin",238],["مُّسَمًّۭى","ditentukan","musamman",504],["وَأَنَّ","dan bahwasanya","wa-anna",36],["ٱللَّهَ","Allah","l-laha",4],["بِمَا","terhadap apa yang","bimā",6],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",277]],"t":"Tidakkah engkau memperhatikan, bahwa Allah memasukkan malam ke dalam siang dan memasukkan siang ke dalam malam dan Dia menundukkan matahari dan bulan, masing-masing beredar sampai kepada waktu yang ditentukan. Sungguh, Allah Mahateliti atas apa yang kamu kerjakan."},{"n":30,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّ","bahwa sesungguhnya","bi-anna",36],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["ٱلْحَقُّ","hak","l-ḥaqu",58],["وَأَنَّ","dan bahwasanya","wa-anna",36],["مَا","apa yang","mā",6],["يَدْعُونَ","mereka seru","yadʿūna",74],["مِن","dari","min",1],["دُونِهِ","selain Dia","dūnihi",88],["ٱلْبَـٰطِلُ","batil","l-bāṭilu",425],["وَأَنَّ","dan sesungguhnya","wa-anna",36],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["ٱلْعَلِىُّ","Maha Tinggi","l-ʿaliyu",782],["ٱلْكَبِيرُ","Maha Besar","l-kabīru",302]],"t":"Demikianlah, karena sesungguhnya Allah, Dialah (Tuhan) yang sebenarnya dan apa saja yang mereka seru selain Allah adalah batil. Dan sesungguhnya Allah, Dialah Yang Mahatinggi, Mahabesar."},{"n":31,"w":[["أَلَمْ","tidaklah","alam",39],["تَرَ","kamu memperhatikan","tara",54],["أَنَّ","bahwasanya","anna",36],["ٱلْفُلْكَ","perahu","l-ful'ka",465],["تَجْرِى","berlayar","tajrī",219],["فِى","di","fī",7],["ٱلْبَحْرِ","laut","l-baḥri",300],["بِنِعْمَتِ","dengan nikmat","biniʿ'mati",250],["ٱللَّهِ","Allah","l-lahi",4],["لِيُرِيَكُم","untuk Dia perlihatkan kepadamu","liyuriyakum",305],["مِّنْ","dari","min",1],["ءَايَـٰتِهِۦٓ ۚ","tanda-tanda-Nya","āyātihi",34],["إِنَّ","sesungguhnya","inna",9],["فِى","pada yang","fī",7],["ذَٰلِكَ","demikian itu","dhālika",26],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",34],["لِّكُلِّ","bagi setiap","likulli",38],["صَبَّارٍۢ","orang yang sabar","ṣabbārin",1541],["شَكُورٍۢ","lagi bersyukur","shakūrin",823]],"t":"Tidakkah engkau memperhatikan bahwa sesungguhnya kapal itu berlayar di laut dengan nikmat Allah, agar diperlihatkan-Nya kepadamu sebagian dari tanda-tanda (kebesaran)-Nya. Sungguh, pada yang demikian itu terdapat tanda-tanda (kebesaran)-Nya bagi setiap orang yang sangat sabar dan banyak bersyukur."},{"n":32,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["غَشِيَهُم","menimpa mereka","ghashiyahum",699],["مَّوْجٌۭ","gelombang","mawjun",1215],["كَٱلظُّلَلِ","seperti naungan/gunung","kal-ẓulali",1179],["دَعَوُا۟","mereka menyeru","daʿawū",74],["ٱللَّهَ","Allah","l-laha",4],["مُخْلِصِينَ","dengan ikhlas","mukh'liṣīna",804],["لَهُ","kepada-Nya","lahu",21],["ٱلدِّينَ","agama/ketaatan","l-dīna",130],["فَلَمَّا","maka tatkala","falammā",81],["نَجَّىٰهُمْ","Dia meneyelamatkan mereka","najjāhum",337],["إِلَى","sampai","ilā",18],["ٱلْبَرِّ","di daratan","l-bari",476],["فَمِنْهُم","maka diantara mereka","famin'hum",1],["مُّقْتَصِدٌۭ ۚ","berlaku tengah-tengah","muq'taṣidun",1962],["وَمَا","dan tidak","wamā",6],["يَجْحَدُ","mengingkari","yajḥadu",747],["بِـَٔايَـٰتِنَآ","pada ayat-ayat Kami","biāyātinā",34],["إِلَّا","kecuali","illā",20],["كُلُّ","tiap-tiap","kullu",38],["خَتَّارٍۢ","orang yang tidak setia","khattārin",4554],["كَفُورٍۢ","orang yang ingkar","kafūrin",748]],"t":"Dan apabila mereka digulung ombak yang besar seperti gunung, mereka menyeru Allah dengan tulus ikhlas beragama kepada-Nya. Tetapi ketika Allah menyelamatkan mereka sampai di daratan, lalu sebagian mereka tetap menempuh jalan yang lurus. Adapun yang mengingkari ayat-ayat Kami hanyalah pengkhianat yang tidak berterima kasih."},{"n":33,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلنَّاسُ","manusia","l-nāsu",60],["ٱتَّقُوا۟","bertakwalah","ittaqū",76],["رَبَّكُمْ","Tuhan kalian","rabbakum",15],["وَٱخْشَوْا۟","dan takutlah","wa-ikh'shaw",312],["يَوْمًۭا","suatu hari","yawman",31],["لَّا","tidak","lā",8],["يَجْزِى","menolong","yajzī",175],["وَالِدٌ","seorang bapak","wālidun",595],["عَن","dari","ʿan",27],["وَلَدِهِۦ","anaknya","waladihi",228],["وَلَا","dan tidak","walā",8],["مَوْلُودٌ","yang dilahirkan/anak","mawlūdun",1923],["هُوَ","ia","huwa",25],["جَازٍ","penolong","jāzin",3551],["عَن","dari","ʿan",27],["وَالِدِهِۦ","bapaknya","wālidihi",595],["شَيْـًٔا ۚ","sedikit pun","shayan",49],["إِنَّ","sesungguhnya","inna",9],["وَعْدَ","janji","waʿda",258],["ٱللَّهِ","Allah","l-lahi",4],["حَقٌّۭ ۖ","benar","ḥaqqun",58],["فَلَا","maka jangan","falā",8],["تَغُرَّنَّكُمُ","menipu kamu","taghurrannakumu",641],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["وَلَا","dan jangan","walā",8],["يَغُرَّنَّكُم","sekali-kali menipu kamu","yaghurrannakum",641],["بِٱللَّهِ","terhadap Allah","bil-lahi",4],["ٱلْغَرُورُ","penipu","l-gharūru",1870]],"t":"Wahai manusia! Bertakwalah kepada Tuhanmu dan takutlah pada hari yang (ketika itu) seorang bapak tidak dapat menolong anaknya, dan seorang anak tidak dapat (pula) menolong bapaknya sedikit pun. Sungguh, janji Allah pasti benar, maka janganlah sekali-kali kamu terpedaya oleh kehidupan dunia, dan jangan sampai kamu terpedaya oleh penipu dalam (menaati) Allah."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["عِندَهُۥ","di sisi-Nya","ʿindahu",68],["عِلْمُ","pengetahuan","ʿil'mu",122],["ٱلسَّاعَةِ","hari kiamat","l-sāʿati",263],["وَيُنَزِّلُ","dan Dia menurunkan","wayunazzilu",207],["ٱلْغَيْثَ","hujan","l-ghaytha",1872],["وَيَعْلَمُ","dan Dia mengetahui","wayaʿlamu",35],["مَا","apa yang","mā",6],["فِى","dalam","fī",7],["ٱلْأَرْحَامِ ۖ","rahim/kandungan","l-arḥāmi",758],["وَمَا","dan tidak","wamā",6],["تَدْرِى","mengetahui","tadrī",744],["نَفْسٌۭ","jiwa/seorang","nafsun",47],["مَّاذَا","apa yang","mādhā",428],["تَكْسِبُ","ia kerjakan","taksibu",206],["غَدًۭا ۖ","besok","ghadan",1355],["وَمَا","dan tidak","wamā",6],["تَدْرِى","mengetahui","tadrī",744],["نَفْسٌۢ","jiwa/seorang","nafsun",47],["بِأَىِّ","di mana","bi-ayyi",210],["أَرْضٍۢ","bumi","arḍin",28],["تَمُوتُ ۚ","ia akan mati","tamūtu",322],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",77],["خَبِيرٌۢ","Maha dalam pengetahuan-Nya","khabīrun",277]],"t":"Sesungguhnya hanya di sisi Allah ilmu tentang hari Kiamat; dan Dia yang menurunkan hujan, dan mengetahui apa yang ada dalam rahim. Dan tidak ada seorang pun yang dapat mengetahui (dengan pasti) apa yang akan dikerjakannya besok. Dan tidak ada seorang pun yang dapat mengetahui di bumi mana dia akan mati. Sungguh, Allah Maha Mengetahui, Maha Mengenal."}]