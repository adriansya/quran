[{"n":1,"w":[["قُلْ","katakanlah","qul",6],["أُوحِىَ","diwahyukan","ūḥiya",163],["إِلَىَّ","kepadaku","ilayya",13],["أَنَّهُ","bahwasanya","annahu",30],["ٱسْتَمَعَ","mendengarkan","is'tamaʿa",613],["نَفَرٌۭ","sekumpulan","nafarun",1947],["مِّنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",469],["فَقَالُوٓا۟","lalu mereka berkata","faqālū",6],["إِنَّا","sesungguhnya kami","innā",5],["سَمِعْنَا","kami telah mendengar","samiʿ'nā",143],["قُرْءَانًا","Al Qur'an","qur'ānan",175],["عَجَبًۭا","menakjubkan/mengagungkan","ʿajaban",1295]],"t":"Katakanlah (Muhammad), \"Telah diwahyukan kepadaku bahwa sekumpulan jin telah mendengarkan (bacaan),\" lalu mereka berkata, \"Kami telah mendengarkan bacaan yang menakjubkan (Alquran),"},{"n":2,"w":[["يَهْدِىٓ","ia memberi petunjuk","yahdī",79],["إِلَى","kepada","ilā",13],["ٱلرُّشْدِ","jalan yang benar","l-rush'di",1229],["فَـَٔامَنَّا","maka kami beriman","faāmannā",18],["بِهِۦ ۖ","kepadanya","bihi",17],["وَلَن","dan tidak","walan",109],["نُّشْرِكَ","kami mempersekutukan","nush'rika",166],["بِرَبِّنَآ","dengan Tuhan kami","birabbinā",10],["أَحَدًۭا","seseorang","aḥadan",155]],"t":"(yang) memberi petunjuk kepada jalan yang benar, lalu kami beriman kepadanya. Dan kami sekali-kali tidak akan mempersekutukan sesuatu pun dengan Tuhan kami,"},{"n":3,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["تَعَـٰلَىٰ","Maha Tinggi","taʿālā",521],["جَدُّ","kebesaran","jaddu",3535],["رَبِّنَا","Tuhan kami","rabbinā",10],["مَا","tidak","mā",2],["ٱتَّخَذَ","Dia mengambil","ittakhadha",94],["صَـٰحِبَةًۭ","teman/isteri","ṣāḥibatan",1523],["وَلَا","dan tidak","walā",4],["وَلَدًۭا","beranak","waladan",217]],"t":"dan sesungguhnya Mahatinggi keagungan Tuhan kami, Dia tidak beristri dan tidak beranak.\""},{"n":4,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["كَانَ","adalah","kāna",9],["يَقُولُ","mengatakan","yaqūlu",6],["سَفِيهُنَا","orang bodoh diantara kami","safīhunā",1108],["عَلَى","atas/terhadap","ʿalā",8],["ٱللَّهِ","Allah","l-lahi",1],["شَطَطًۭا","melampaui batas","shaṭaṭan",2118]],"t":"Dan sesungguhnya orang yang bodoh di antara kami dahulu selalu mengucapkan (perkataan) yang melampaui batas terhadap Allah,"},{"n":5,"w":[["وَأَنَّا","dan sesungguhnya kami","wa-annā",30],["ظَنَنَّآ","kami mengira","ẓanannā",252],["أَن","bahwa","an",16],["لَّن","tidak akan","lan",109],["تَقُولَ","mengatakan","taqūla",6],["ٱلْإِنسُ","manusia","l-insu",539],["وَٱلْجِنُّ","dan jin","wal-jinu",469],["عَلَى","terhadap","ʿalā",8],["ٱللَّهِ","Allah","l-lahi",1],["كَذِبًۭا","dusta","kadhiban",346]],"t":"dan sesungguhnya kami mengira, bahwa manusia dan jin itu tidak akan mengatakan perkataan yang dusta terhadap Allah,"},{"n":6,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["كَانَ","adalah","kāna",9],["رِجَالٌۭ","beberapa orang laki-laki","rijālun",392],["مِّنَ","dari","mina",0],["ٱلْإِنسِ","manusia","l-insi",539],["يَعُوذُونَ","mereka minta perlindungan","yaʿūdhūna",824],["بِرِجَالٍۢ","kepada beberapa laki-laki","birijālin",392],["مِّنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",469],["فَزَادُوهُمْ","maka mereka menjadikan bertambah","fazādūhum",247],["رَهَقًۭا","durhaka/sombong","rahaqan",2611]],"t":"dan sesungguhnya ada beberapa orang laki-laki dari kalangan manusia yang meminta perlindungan kepada beberapa laki-laki dari jin, tetapi mereka (jin) menjadikan mereka (manusia) bertambah sesat."},{"n":7,"w":[["وَأَنَّهُمْ","dan bahwasannya mereka","wa-annahum",30],["ظَنُّوا۟","mereka menyangka","ẓannū",252],["كَمَا","sebagai mana","kamā",2],["ظَنَنتُمْ","persangkaanmu","ẓanantum",252],["أَن","bahwa","an",16],["لَّن","tidak akan","lan",109],["يَبْعَثَ","membangkitkan","yabʿatha",228],["ٱللَّهُ","Allah","l-lahu",1],["أَحَدًۭا","seorang","aḥadan",155]],"t":"Dan sesungguhnya mereka (jin) mengira seperti kamu (orang musyrik Mekkah) yang juga mengira bahwa Allah tidak akan membangkitkan kembali siapa pun (pada hari Kiamat)."},{"n":8,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["لَمَسْنَا","kami meraba-raba/intip","lamasnā",1577],["ٱلسَّمَآءَ","langit","l-samāa",38],["فَوَجَدْنَـٰهَا","maka kami mendapatnya","fawajadnāhā",106],["مُلِئَتْ","dipenuhi","muli-at",1207],["حَرَسًۭا","penjagaan","ḥarasan",3198],["شَدِيدًۭا","sangat/keras","shadīdan",214],["وَشُهُبًۭا","dan suluh api yang menyala","washuhuban",2897]],"t":"Dan sesungguhnya kami (jin) telah mencoba mengetahui (rahasia) langit, maka kami mendapatinya penuh dengan penjagaan yang kuat dan panah-panah api,"},{"n":9,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["كُنَّا","adalah kami","kunnā",9],["نَقْعُدُ","kami duduk","naqʿudu",741],["مِنْهَا","daripadanya (langit)","min'hā",0],["مَقَـٰعِدَ","tempat-tempat duduk","maqāʿida",1586],["لِلسَّمْعِ ۖ","untuk mendengarkan","lilssamʿi",476],["فَمَن","maka barangsiapa","faman",12],["يَسْتَمِعِ","ia mendengarkan","yastamiʿi",613],["ٱلْـَٔانَ","sekarang","l-āna",972],["يَجِدْ","ia mendapati","yajid",106],["لَهُۥ","baginya","lahu",17],["شِهَابًۭا","suluh api yang menyala","shihāban",1462],["رَّصَدًۭا","mengintai","raṣadan",2604]],"t":"dan sesungguhnya kami (jin) dahulu dapat menduduki beberapa tempat di langit itu untuk mencuri dengar (berita-beritanya). Tetapi sekarang siapa (mencoba) mencuri dengar (seperti itu) pasti akan menjumpai panah-panah api yang mengintai (untuk membakarnya)."},{"n":10,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["لَا","tidak","lā",4],["نَدْرِىٓ","kami mengetahui","nadrī",747],["أَشَرٌّ","apakah keburukan","asharrun",361],["أُرِيدَ","dikehendaki","urīda",81],["بِمَن","bagi orang","biman",12],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["أَمْ","atau","am",82],["أَرَادَ","menghendaki","arāda",81],["بِهِمْ","pada mereka","bihim",11],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["رَشَدًۭا","pimpinan/kebaikan","rashadan",1394]],"t":"Dan sesungguhnya kami (jin) tidak mengetahui (adanya penjagaan itu) apakah keburukan yang dikehendaki orang yang di bumi ataukah Tuhan mereka menghendaki kebaikan baginya."},{"n":11,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["مِنَّا","sebagian dari kami","minnā",0],["ٱلصَّـٰلِحُونَ","orang-orang yang saleh","l-ṣāliḥūna",181],["وَمِنَّا","dan sebagian dari kami","waminnā",0],["دُونَ","tidak","dūna",78],["ذَٰلِكَ ۖ","demikian","dhālika",19],["كُنَّا","adalah kami","kunnā",9],["طَرَآئِقَ","jalan-jalan","ṭarāiqa",1322],["قِدَدًۭا","berbeda-beda","qidadan",4156]],"t":"Dan sesungguhnya di antara kami (jin) ada yang saleh dan ada (pula) kebalikannya. Kami menempuh jalan yang berbeda-beda."},{"n":12,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["ظَنَنَّآ","kami menyangka/yakin","ẓanannā",252],["أَن","bahwa","an",16],["لَّن","tidak","lan",109],["نُّعْجِزَ","kami dapat melemahkan/melepaskan diri","nuʿ'jiza",1683],["ٱللَّهَ","Allah","l-laha",1],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَن","dan tidak","walan",109],["نُّعْجِزَهُۥ","kami melemahkan/melepaskan diri daripada-Nya","nuʿ'jizahu",1683],["هَرَبًۭا","lari","haraban",3516]],"t":"Dan sesungguhnya kami (jin) telah menduga, bahwa kami tidak akan mampu melepaskan diri (dari kekuasaan) Allah di bumi dan tidak (pula) dapat lari melepaskan diri (dari)-Nya."},{"n":13,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["لَمَّا","tatkala","lammā",71],["سَمِعْنَا","kami mendengar","samiʿ'nā",143],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",128],["ءَامَنَّا","kami beriman","āmannā",18],["بِهِۦ ۖ","dengannya/kepadanya","bihi",17],["فَمَن","maka barang siapa","faman",12],["يُؤْمِنۢ","ia beriman","yu'min",18],["بِرَبِّهِۦ","kepada Tuhannya","birabbihi",10],["فَلَا","maka tidak","falā",4],["يَخَافُ","ia takut","yakhāfu",135],["بَخْسًۭا","pengurangan","bakhsan",2347],["وَلَا","dan tidak","walā",4],["رَهَقًۭا","kedurhakaan/penganiayaan","rahaqan",2611]],"t":"Dan sesungguhnya ketika kami (jin) mendengar petunjuk (Alquran), kami beriman kepadanya. Maka barangsiapa beriman kepada Tuhan, maka tidak perlu ia takut rugi atau berdosa."},{"n":14,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",30],["مِنَّا","sebagian dari kami","minnā",0],["ٱلْمُسْلِمُونَ","orang-orang yang patuh","l-mus'limūna",304],["وَمِنَّا","dan sebagian dari kami","waminnā",0],["ٱلْقَـٰسِطُونَ ۖ","orang-orang yang sesat/menyimpang dari kebenaran","l-qāsiṭūna",2581],["فَمَنْ","maka barang siapa","faman",12],["أَسْلَمَ","ia patuh","aslama",464],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",55],["تَحَرَّوْا۟","mereka menuju/memilih","taḥarraw",4351],["رَشَدًۭا","pimpinan/jalan yang lurus","rashadan",1394]],"t":"Dan di antara kami ada yang Islam dan ada yang menyimpang dari kebenaran. Siapa yang Islam, maka mereka itu telah memilih jalan yang lurus."},{"n":15,"w":[["وَأَمَّا","dan adapun","wa-ammā",218],["ٱلْقَـٰسِطُونَ","orang-orang yang sesat/menyimpang dari kebebasan","l-qāsiṭūna",2581],["فَكَانُوا۟","maka mereka adalah/menjadi","fakānū",9],["لِجَهَنَّمَ","untuk neraka Jahannam","lijahannama",146],["حَطَبًۭا","kayu bakar","ḥaṭaban",2275]],"t":"Dan adapun yang menyimpang dari kebenaran, maka mereka menjadi bahan bakar bagi neraka Jahanam.\""},{"n":16,"w":[["وَأَلَّوِ","dan bahwa jika","wa-allawi",16],["ٱسْتَقَـٰمُوا۟","mereka tegak","is'taqāmū",872],["عَلَى","atas","ʿalā",8],["ٱلطَّرِيقَةِ","jalan itu","l-ṭarīqati",1322],["لَأَسْقَيْنَـٰهُم","pasti Kami beri minum mereka","la-asqaynāhum",959],["مَّآءً","air","māan",192],["غَدَقًۭا","melimpah","ghadaqan",3476]],"t":"Dan sekiranya mereka tetap berjalan lurus di atas jalan itu (agama Islam), niscaya Kami akan mencurahkan kepada mereka air yang cukup."},{"n":17,"w":[["لِّنَفْتِنَهُمْ","untuk Kami beri cobaan mereka","linaftinahum",455],["فِيهِ ۚ","padanya","fīhi",3],["وَمَن","dan barang siapa","waman",12],["يُعْرِضْ","ia berpaling","yuʿ'riḍ",350],["عَن","dari","ʿan",21],["ذِكْرِ","peringatan","dhik'ri",147],["رَبِّهِۦ","Tuhannya","rabbihi",10],["يَسْلُكْهُ","Dia akan memasukkannya","yasluk'hu",744],["عَذَابًۭا","azab","ʿadhāban",36],["صَعَدًۭا","sukar/berat","ṣaʿadan",3251]],"t":"Dengan (cara) itu Kami hendak menguji mereka. Dan barangsiapa berpaling dari peringatan Tuhannya, niscaya akan dimasukkan-Nya ke dalam azab yang sangat berat."},{"n":18,"w":[["وَأَنَّ","dan bahwasannya","wa-anna",30],["ٱلْمَسَـٰجِدَ","masjid-masjid itu","l-masājida",390],["لِلَّهِ","kepunyaan Allah","lillahi",1],["فَلَا","maka jangan","falā",4],["تَدْعُوا۟","kamu menyembah/berseru","tadʿū",65],["مَعَ","beserta","maʿa",69],["ٱللَّهِ","Allah","l-lahi",1],["أَحَدًۭا","seseorang/sesuatu","aḥadan",155]],"t":"Dan sesungguhnya masjid-masjid itu adalah untuk Allah. Maka janganlah kamu menyembah apa pun di dalamnya selain Allah."},{"n":19,"w":[["وَأَنَّهُۥ","dan bahwasannya","wa-annahu",30],["لَمَّا","tatkala","lammā",71],["قَامَ","berdiri","qāma",349],["عَبْدُ","hamba","ʿabdu",87],["ٱللَّهِ","Allah","l-lahi",1],["يَدْعُوهُ","ia menyeru-Nya/menyembah-Nya","yadʿūhu",65],["كَادُوا۟","hampir mereka","kādū",442],["يَكُونُونَ","adalah mereka","yakūnūna",9],["عَلَيْهِ","atasnya","ʿalayhi",8],["لِبَدًۭا","berkerumun","libadan",3625]],"t":"Dan sesungguhnya ketika hamba Allah (Muhammad) berdiri menyembah-Nya (melaksanakan salat), mereka (jin-jin) itu berdesakan mengerumuninya."},{"n":20,"w":[["قُلْ","katakanlah","qul",6],["إِنَّمَآ","sesungguhnya adalah","innamā",5],["أَدْعُوا۟","aku menyeru/menyembah","adʿū",65],["رَبِّى","Tuhanku","rabbī",10],["وَلَآ","dan tidak","walā",4],["أُشْرِكُ","aku persekutukan","ush'riku",166],["بِهِۦٓ","dengan-Nya","bihi",171],["أَحَدًۭا","seseorang/sesuatu","aḥadan",155]],"t":"Katakanlah (Muhammad), \"Sesungguhnya aku hanya menyembah Tuhanku dan aku tidak mempersekutukan sesuatu pun dengan-Nya.\""},{"n":21,"w":[["قُلْ","katakanlah","qul",6],["إِنِّى","sesungguhnya","innī",5],["لَآ","tidak","lā",4],["أَمْلِكُ","aku kuasa","amliku",268],["لَكُمْ","bagi kalian","lakum",26],["ضَرًّۭا","mudarat/bahaya","ḍarran",820],["وَلَا","dan tidak","walā",4],["رَشَدًۭا","pimpinan/kemanfaatan","rashadan",1394]],"t":"Katakanlah (Muhammad), \"Aku tidak kuasa menolak mudarat maupun mendatangkan kebaikan kepadamu.\""},{"n":22,"w":[["قُلْ","katakanlah","qul",6],["إِنِّى","sesungguhnya","innī",5],["لَن","tidak dapat","lan",109],["يُجِيرَنِى","melindungiku","yujīranī",1262],["مِنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["أَحَدٌۭ","seseorang/satu","aḥadun",155],["وَلَنْ","dan tidak","walan",109],["أَجِدَ","aku mendapatkan","ajida",106],["مِن","dari","min",0],["دُونِهِۦ","selain-Nya","dūnihi",78],["مُلْتَحَدًا","tempat lari/berlindung","mul'taḥadan",2501]],"t":"Katakanlah (Muhammad), \"Sesungguhnya tidak ada sesuatu pun yang dapat melindungiku dari (azab) Allah dan aku tidak akan memperoleh tempat berlindung selain dari-Nya."},{"n":23,"w":[["إِلَّا","kecuali","illā",15],["بَلَـٰغًۭا","penyampaian","balāghan",629],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["وَرِسَـٰلَـٰتِهِۦ ۚ","dan risholat-Nya/amanat-amanat-Nya","warisālātihi",1228],["وَمَن","dan barangsiapa","waman",12],["يَعْصِ","mendurhakai","yaʿṣi",397],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ","dan rasul-Nya","warasūlahu",35],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["لَهُۥ","baginya","lahu",17],["نَارَ","api/neraka","nāra",77],["جَهَنَّمَ","Jahannam","jahannama",146],["خَـٰلِدِينَ","mereka kekal","khālidīna",157],["فِيهَآ","di dalamnya","fīhā",3],["أَبَدًا","selama-lamanya","abadan",383]],"t":"(Aku hanya) menyampaikan (peringatan) dari Allah dan risalah-Nya. Dan barangsiapa mendurhakai Allah dan Rasul-Nya maka sesungguhnya dia akan mendapat (azab) neraka Jahanam, mereka kekal di dalamnya selama-lamanya.\""},{"n":24,"w":[["حَتَّىٰٓ","sehingga","ḥattā",80],["إِذَا","apabila/tatkala","idhā",23],["رَأَوْا۟","mereka melihat","ra-aw",46],["مَا","apa","mā",2],["يُوعَدُونَ","mereka dijanjikan/diancam","yūʿadūna",176],["فَسَيَعْلَمُونَ","maka mereka akan mengetahui","fasayaʿlamūna",29],["مَنْ","siapa","man",12],["أَضْعَفُ","lebih lemah","aḍʿafu",2156],["نَاصِرًۭا","penolong/pembantu","nāṣiran",796],["وَأَقَلُّ","dan lebih sedikit","wa-aqallu",2189],["عَدَدًۭا","bilangan","ʿadadan",1156]],"t":"Sehingga apabila mereka melihat (azab) yang diancamkan kepadanya, maka mereka akan mengetahui siapakah yang lebih lemah penolongnya dan lebih sedikit jumlahnya."},{"n":25,"w":[["قُلْ","katakanlah","qul",6],["إِنْ","tidak","in",14],["أَدْرِىٓ","aku mengetahui","adrī",747],["أَقَرِيبٌۭ","apakah dekat","aqarībun",417],["مَّا","apa (azab)","mā",2],["تُوعَدُونَ","kamu dijanjikan/diancam","tūʿadūna",176],["أَمْ","atau","am",82],["يَجْعَلُ","menjadikan","yajʿalu",33],["لَهُۥ","baginya","lahu",17],["رَبِّىٓ","Tuhanku","rabbī",10],["أَمَدًا","masa yang panjang","amadan",1479]],"t":"Katakanlah (Muhammad), \"Aku tidak mengetahui, apakah azab yang diancamkan kepadamu itu sudah dekat ataukah Tuhanku menetapkan waktunya masih lama.\""},{"n":26,"w":[["عَـٰلِمُ","Maha Mengetahui","ʿālimu",547],["ٱلْغَيْبِ","yang gaib","l-ghaybi",243],["فَلَا","maka tidak","falā",4],["يُظْهِرُ","Dia menerangkan/menyatakan","yuẓ'hiru",956],["عَلَىٰ","atas","ʿalā",8],["غَيْبِهِۦٓ","kegaiban-Nya","ghaybihi",243],["أَحَدًا","seseorang","aḥadan",155]],"t":"Dia Mengetahui yang gaib, tetapi Dia tidak memperlihatkan kepada siapa pun tentang yang gaib itu."},{"n":27,"w":[["إِلَّا","kecuali","illā",15],["مَنِ","siapa/orang","mani",12],["ٱرْتَضَىٰ","Dia meridhai","ir'taḍā",2110],["مِن","dari","min",0],["رَّسُولٍۢ","rasul","rasūlin",35],["فَإِنَّهُۥ","maka sesungguhnya Dia","fa-innahu",5],["يَسْلُكُ","menjalankan/mengadakan","yasluku",744],["مِنۢ","dari","min",0],["بَيْنِ","antara","bayni",47],["يَدَيْهِ","kedua tangannya/hadapannya","yadayhi",98],["وَمِنْ","dan dari","wamin",0],["خَلْفِهِۦ","belakangnya","khalfihi",480],["رَصَدًۭا","pengintai/penjaga","raṣadan",2604]],"t":"Kecuali kepada rasul yang diridai-Nya, maka sesungguhnya Dia mengadakan penjaga-penjaga (malaikat) di depan dan di belakangnya."},{"n":28,"w":[["لِّيَعْلَمَ","karena Dia hendak mengetahui","liyaʿlama",29],["أَن","bahwa","an",16],["قَدْ","sesungguhnya","qad",24],["أَبْلَغُوا۟","mereka telah menyampaikan","ablaghū",1276],["رِسَـٰلَـٰتِ","amanat/risalah","risālāti",1228],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["وَأَحَاطَ","dan Dia meliputi","wa-aḥāṭa",563],["بِمَا","terhadap apa","bimā",2],["لَدَيْهِمْ","di sisi/pada mereka","ladayhim",517],["وَأَحْصَىٰ","dan Dia menghitung","wa-aḥṣā",818],["كُلَّ","tiap-tiap/segala","kulla",31],["شَىْءٍ","sesuatu","shayin",41],["عَدَدًۢا","bilangan/satu persatu","ʿadadan",1156]],"t":"Agar Dia mengetahui, bahwa rasul-rasul itu sungguh, telah menyampaikan risalah Tuhannya, sedang (ilmu-Nya) meliputi apa yang ada pada mereka, dan Dia menghitung segala sesuatu satu persatu."}]