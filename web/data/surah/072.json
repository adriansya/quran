[{"n":1,"w":[["قُلْ","katakanlah","qul",10],["أُوحِىَ","diwahyukan","ūḥiya",179],["إِلَىَّ","kepadaku","ilayya",18],["أَنَّهُ","bahwasanya","annahu",36],["ٱسْتَمَعَ","mendengarkan","is'tamaʿa",624],["نَفَرٌۭ","sekumpulan","nafarun",1971],["مِّنَ","dari","mina",1],["ٱلْجِنِّ","jin","l-jini",480],["فَقَالُوٓا۟","lalu mereka berkata","faqālū",10],["إِنَّا","sesungguhnya kami","innā",9],["سَمِعْنَا","kami telah mendengar","samiʿ'nā",159],["قُرْءَانًا","Al Qur'an","qur'ānan",189],["عَجَبًۭا","menakjubkan/mengagungkan","ʿajaban",1303]],"t":"Katakanlah (Muhammad), \"Telah diwahyukan kepadaku bahwa sekumpulan jin telah mendengarkan (bacaan),\" lalu mereka berkata, \"Kami telah mendengarkan bacaan yang menakjubkan (Alquran),"},{"n":2,"w":[["يَهْدِىٓ","ia memberi petunjuk","yahdī",89],["إِلَى","kepada","ilā",18],["ٱلرُّشْدِ","jalan yang benar","l-rush'di",1239],["فَـَٔامَنَّا","maka kami beriman","faāmannā",23],["بِهِۦ ۖ","kepadanya","bihi",21],["وَلَن","dan tidak","walan",122],["نُّشْرِكَ","kami mempersekutukan","nush'rika",182],["بِرَبِّنَآ","dengan Tuhan kami","birabbinā",15],["أَحَدًۭا","seseorang","aḥadan",170]],"t":"(yang) memberi petunjuk kepada jalan yang benar, lalu kami beriman kepadanya. Dan kami sekali-kali tidak akan mempersekutukan sesuatu pun dengan Tuhan kami,"},{"n":3,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["تَعَـٰلَىٰ","Maha Tinggi","taʿālā",532],["جَدُّ","kebesaran","jaddu",3558],["رَبِّنَا","Tuhan kami","rabbinā",15],["مَا","tidak","mā",6],["ٱتَّخَذَ","Dia mengambil","ittakhadha",107],["صَـٰحِبَةًۭ","teman/isteri","ṣāḥibatan",1539],["وَلَا","dan tidak","walā",8],["وَلَدًۭا","beranak","waladan",228]],"t":"dan sesungguhnya Mahatinggi keagungan Tuhan kami, Dia tidak beristri dan tidak beranak.\""},{"n":4,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["كَانَ","adalah","kāna",12],["يَقُولُ","mengatakan","yaqūlu",10],["سَفِيهُنَا","orang bodoh diantara kami","safīhunā",1118],["عَلَى","atas/terhadap","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["شَطَطًۭا","melampaui batas","shaṭaṭan",2109]],"t":"Dan sesungguhnya orang yang bodoh di antara kami dahulu selalu mengucapkan (perkataan) yang melampaui batas terhadap Allah,"},{"n":5,"w":[["وَأَنَّا","dan sesungguhnya kami","wa-annā",36],["ظَنَنَّآ","kami mengira","ẓanannā",264],["أَن","bahwa","an",22],["لَّن","tidak akan","lan",122],["تَقُولَ","mengatakan","taqūla",10],["ٱلْإِنسُ","manusia","l-insu",551],["وَٱلْجِنُّ","dan jin","wal-jinu",480],["عَلَى","terhadap","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["كَذِبًۭا","dusta","kadhiban",361]],"t":"dan sesungguhnya kami mengira, bahwa manusia dan jin itu tidak akan mengatakan perkataan yang dusta terhadap Allah,"},{"n":6,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["كَانَ","adalah","kāna",12],["رِجَالٌۭ","beberapa orang laki-laki","rijālun",223],["مِّنَ","dari","mina",1],["ٱلْإِنسِ","manusia","l-insi",551],["يَعُوذُونَ","mereka minta perlindungan","yaʿūdhūna",833],["بِرِجَالٍۢ","kepada beberapa laki-laki","birijālin",223],["مِّنَ","dari","mina",1],["ٱلْجِنِّ","jin","l-jini",480],["فَزَادُوهُمْ","maka mereka menjadikan bertambah","fazādūhum",259],["رَهَقًۭا","durhaka/sombong","rahaqan",2627]],"t":"dan sesungguhnya ada beberapa orang laki-laki dari kalangan manusia yang meminta perlindungan kepada beberapa laki-laki dari jin, tetapi mereka (jin) menjadikan mereka (manusia) bertambah sesat."},{"n":7,"w":[["وَأَنَّهُمْ","dan bahwasannya mereka","wa-annahum",36],["ظَنُّوا۟","mereka menyangka","ẓannū",264],["كَمَا","sebagai mana","kamā",6],["ظَنَنتُمْ","persangkaanmu","ẓanantum",264],["أَن","bahwa","an",22],["لَّن","tidak akan","lan",122],["يَبْعَثَ","membangkitkan","yabʿatha",239],["ٱللَّهُ","Allah","l-lahu",4],["أَحَدًۭا","seorang","aḥadan",170]],"t":"Dan sesungguhnya mereka (jin) mengira seperti kamu (orang musyrik Mekkah) yang juga mengira bahwa Allah tidak akan membangkitkan kembali siapa pun (pada hari Kiamat)."},{"n":8,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["لَمَسْنَا","kami meraba-raba/intip","lamasnā",1598],["ٱلسَّمَآءَ","langit","l-samāa",44],["فَوَجَدْنَـٰهَا","maka kami mendapatnya","fawajadnāhā",119],["مُلِئَتْ","dipenuhi","muli-at",1211],["حَرَسًۭا","penjagaan","ḥarasan",3192],["شَدِيدًۭا","sangat/keras","shadīdan",225],["وَشُهُبًۭا","dan suluh api yang menyala","washuhuban",2866]],"t":"Dan sesungguhnya kami (jin) telah mencoba mengetahui (rahasia) langit, maka kami mendapatinya penuh dengan penjagaan yang kuat dan panah-panah api,"},{"n":9,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["كُنَّا","adalah kami","kunnā",12],["نَقْعُدُ","kami duduk","naqʿudu",755],["مِنْهَا","daripadanya (langit)","min'hā",1],["مَقَـٰعِدَ","tempat-tempat duduk","maqāʿida",1608],["لِلسَّمْعِ ۖ","untuk mendengarkan","lilssamʿi",489],["فَمَن","maka barangsiapa","faman",17],["يَسْتَمِعِ","ia mendengarkan","yastamiʿi",624],["ٱلْـَٔانَ","sekarang","l-āna",985],["يَجِدْ","ia mendapati","yajid",119],["لَهُۥ","baginya","lahu",21],["شِهَابًۭا","suluh api yang menyala","shihāban",1475],["رَّصَدًۭا","mengintai","raṣadan",2621]],"t":"dan sesungguhnya kami (jin) dahulu dapat menduduki beberapa tempat di langit itu untuk mencuri dengar (berita-beritanya). Tetapi sekarang siapa (mencoba) mencuri dengar (seperti itu) pasti akan menjumpai panah-panah api yang mengintai (untuk membakarnya)."},{"n":10,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["لَا","tidak","lā",8],["نَدْرِىٓ","kami mengetahui","nadrī",744],["أَشَرٌّ","apakah keburukan","asharrun",380],["أُرِيدَ","dikehendaki","urīda",92],["بِمَن","bagi orang","biman",17],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["أَمْ","atau","am",93],["أَرَادَ","menghendaki","arāda",92],["بِهِمْ","pada mereka","bihim",16],["رَبُّهُمْ","Tuhan mereka","rabbuhum",15],["رَشَدًۭا","pimpinan/kebaikan","rashadan",1416]],"t":"Dan sesungguhnya kami (jin) tidak mengetahui (adanya penjagaan itu) apakah keburukan yang dikehendaki orang yang di bumi ataukah Tuhan mereka menghendaki kebaikan baginya."},{"n":11,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["مِنَّا","sebagian dari kami","minnā",1],["ٱلصَّـٰلِحُونَ","orang-orang yang saleh","l-ṣāliḥūna",104],["وَمِنَّا","dan sebagian dari kami","waminnā",1],["دُونَ","tidak","dūna",88],["ذَٰلِكَ ۖ","demikian","dhālika",26],["كُنَّا","adalah kami","kunnā",12],["طَرَآئِقَ","jalan-jalan","ṭarāiqa",1334],["قِدَدًۭا","berbeda-beda","qidadan",4141]],"t":"Dan sesungguhnya di antara kami (jin) ada yang saleh dan ada (pula) kebalikannya. Kami menempuh jalan yang berbeda-beda."},{"n":12,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["ظَنَنَّآ","kami menyangka/yakin","ẓanannā",264],["أَن","bahwa","an",22],["لَّن","tidak","lan",122],["نُّعْجِزَ","kami dapat melemahkan/melepaskan diri","nuʿ'jiza",1479],["ٱللَّهَ","Allah","l-laha",4],["فِى","di muka","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَلَن","dan tidak","walan",122],["نُّعْجِزَهُۥ","kami melemahkan/melepaskan diri daripada-Nya","nuʿ'jizahu",1479],["هَرَبًۭا","lari","haraban",3532]],"t":"Dan sesungguhnya kami (jin) telah menduga, bahwa kami tidak akan mampu melepaskan diri (dari kekuasaan) Allah di bumi dan tidak (pula) dapat lari melepaskan diri (dari)-Nya."},{"n":13,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["لَمَّا","tatkala","lammā",81],["سَمِعْنَا","kami mendengar","samiʿ'nā",159],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",143],["ءَامَنَّا","kami beriman","āmannā",23],["بِهِۦ ۖ","dengannya/kepadanya","bihi",21],["فَمَن","maka barang siapa","faman",17],["يُؤْمِنۢ","ia beriman","yu'min",23],["بِرَبِّهِۦ","kepada Tuhannya","birabbihi",15],["فَلَا","maka tidak","falā",8],["يَخَافُ","ia takut","yakhāfu",150],["بَخْسًۭا","pengurangan","bakhsan",2352],["وَلَا","dan tidak","walā",8],["رَهَقًۭا","kedurhakaan/penganiayaan","rahaqan",2627]],"t":"Dan sesungguhnya ketika kami (jin) mendengar petunjuk (Alquran), kami beriman kepadanya. Maka barangsiapa beriman kepada Tuhan, maka tidak perlu ia takut rugi atau berdosa."},{"n":14,"w":[["وَأَنَّا","dan bahwasannya kami","wa-annā",36],["مِنَّا","sebagian dari kami","minnā",1],["ٱلْمُسْلِمُونَ","orang-orang yang patuh","l-mus'limūna",292],["وَمِنَّا","dan sebagian dari kami","waminnā",1],["ٱلْقَـٰسِطُونَ ۖ","orang-orang yang sesat/menyimpang dari kebenaran","l-qāsiṭūna",2594],["فَمَنْ","maka barang siapa","faman",17],["أَسْلَمَ","ia patuh","aslama",474],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",65],["تَحَرَّوْا۟","mereka menuju/memilih","taḥarraw",4329],["رَشَدًۭا","pimpinan/jalan yang lurus","rashadan",1416]],"t":"Dan di antara kami ada yang Islam dan ada yang menyimpang dari kebenaran. Siapa yang Islam, maka mereka itu telah memilih jalan yang lurus."},{"n":15,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["ٱلْقَـٰسِطُونَ","orang-orang yang sesat/menyimpang dari kebebasan","l-qāsiṭūna",2594],["فَكَانُوا۟","maka mereka adalah/menjadi","fakānū",12],["لِجَهَنَّمَ","untuk neraka Jahannam","lijahannama",162],["حَطَبًۭا","kayu bakar","ḥaṭaban",2272]],"t":"Dan adapun yang menyimpang dari kebenaran, maka mereka menjadi bahan bakar bagi neraka Jahanam.\""},{"n":16,"w":[["وَأَلَّوِ","dan bahwa jika","wa-allawi",22],["ٱسْتَقَـٰمُوا۟","mereka tegak","is'taqāmū",885],["عَلَى","atas","ʿalā",11],["ٱلطَّرِيقَةِ","jalan itu","l-ṭarīqati",1334],["لَأَسْقَيْنَـٰهُم","pasti Kami beri minum mereka","la-asqaynāhum",972],["مَّآءً","air","māan",204],["غَدَقًۭا","melimpah","ghadaqan",3488]],"t":"Dan sekiranya mereka tetap berjalan lurus di atas jalan itu (agama Islam), niscaya Kami akan mencurahkan kepada mereka air yang cukup."},{"n":17,"w":[["لِّنَفْتِنَهُمْ","untuk Kami beri cobaan mereka","linaftinahum",465],["فِيهِ ۚ","padanya","fīhi",7],["وَمَن","dan barang siapa","waman",17],["يُعْرِضْ","ia berpaling","yuʿ'riḍ",366],["عَن","dari","ʿan",27],["ذِكْرِ","peringatan","dhik'ri",163],["رَبِّهِۦ","Tuhannya","rabbihi",15],["يَسْلُكْهُ","Dia akan memasukkannya","yasluk'hu",759],["عَذَابًۭا","azab","ʿadhāban",43],["صَعَدًۭا","sukar/berat","ṣaʿadan",3238]],"t":"Dengan (cara) itu Kami hendak menguji mereka. Dan barangsiapa berpaling dari peringatan Tuhannya, niscaya akan dimasukkan-Nya ke dalam azab yang sangat berat."},{"n":18,"w":[["وَأَنَّ","dan bahwasannya","wa-anna",36],["ٱلْمَسَـٰجِدَ","masjid-masjid itu","l-masājida",405],["لِلَّهِ","kepunyaan Allah","lillahi",4],["فَلَا","maka jangan","falā",8],["تَدْعُوا۟","kamu menyembah/berseru","tadʿū",74],["مَعَ","beserta","maʿa",78],["ٱللَّهِ","Allah","l-lahi",4],["أَحَدًۭا","seseorang/sesuatu","aḥadan",170]],"t":"Dan sesungguhnya masjid-masjid itu adalah untuk Allah. Maka janganlah kamu menyembah apa pun di dalamnya selain Allah."},{"n":19,"w":[["وَأَنَّهُۥ","dan bahwasannya","wa-annahu",36],["لَمَّا","tatkala","lammā",81],["قَامَ","berdiri","qāma",364],["عَبْدُ","hamba","ʿabdu",99],["ٱللَّهِ","Allah","l-lahi",4],["يَدْعُوهُ","ia menyeru-Nya/menyembah-Nya","yadʿūhu",74],["كَادُوا۟","hampir mereka","kādū",368],["يَكُونُونَ","adalah mereka","yakūnūna",12],["عَلَيْهِ","atasnya","ʿalayhi",11],["لِبَدًۭا","berkerumun","libadan",3650]],"t":"Dan sesungguhnya ketika hamba Allah (Muhammad) berdiri menyembah-Nya (melaksanakan salat), mereka (jin-jin) itu berdesakan mengerumuninya."},{"n":20,"w":[["قُلْ","katakanlah","qul",10],["إِنَّمَآ","sesungguhnya adalah","innamā",9],["أَدْعُوا۟","aku menyeru/menyembah","adʿū",74],["رَبِّى","Tuhanku","rabbī",15],["وَلَآ","dan tidak","walā",8],["أُشْرِكُ","aku persekutukan","ush'riku",182],["بِهِۦٓ","dengan-Nya","bihi",21],["أَحَدًۭا","seseorang/sesuatu","aḥadan",170]],"t":"Katakanlah (Muhammad), \"Sesungguhnya aku hanya menyembah Tuhanku dan aku tidak mempersekutukan sesuatu pun dengan-Nya.\""},{"n":21,"w":[["قُلْ","katakanlah","qul",10],["إِنِّى","sesungguhnya","innī",9],["لَآ","tidak","lā",8],["أَمْلِكُ","aku kuasa","amliku",282],["لَكُمْ","bagi kalian","lakum",32],["ضَرًّۭا","mudarat/bahaya","ḍarran",831],["وَلَا","dan tidak","walā",8],["رَشَدًۭا","pimpinan/kemanfaatan","rashadan",1416]],"t":"Katakanlah (Muhammad), \"Aku tidak kuasa menolak mudarat maupun mendatangkan kebaikan kepadamu.\""},{"n":22,"w":[["قُلْ","katakanlah","qul",10],["إِنِّى","sesungguhnya","innī",9],["لَن","tidak dapat","lan",122],["يُجِيرَنِى","melindungiku","yujīranī",1146],["مِنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["أَحَدٌۭ","seseorang/satu","aḥadun",170],["وَلَنْ","dan tidak","walan",122],["أَجِدَ","aku mendapatkan","ajida",119],["مِن","dari","min",1],["دُونِهِۦ","selain-Nya","dūnihi",88],["مُلْتَحَدًا","tempat lari/berlindung","mul'taḥadan",2517]],"t":"Katakanlah (Muhammad), \"Sesungguhnya tidak ada sesuatu pun yang dapat melindungiku dari (azab) Allah dan aku tidak akan memperoleh tempat berlindung selain dari-Nya."},{"n":23,"w":[["إِلَّا","kecuali","illā",20],["بَلَـٰغًۭا","penyampaian","balāghan",638],["مِّنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["وَرِسَـٰلَـٰتِهِۦ ۚ","dan risholat-Nya/amanat-amanat-Nya","warisālātihi",872],["وَمَن","dan barangsiapa","waman",17],["يَعْصِ","mendurhakai","yaʿṣi",411],["ٱللَّهَ","Allah","l-laha",4],["وَرَسُولَهُۥ","dan rasul-Nya","warasūlahu",42],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["لَهُۥ","baginya","lahu",21],["نَارَ","api/neraka","nāra",87],["جَهَنَّمَ","Jahannam","jahannama",162],["خَـٰلِدِينَ","mereka kekal","khālidīna",173],["فِيهَآ","di dalamnya","fīhā",7],["أَبَدًا","selama-lamanya","abadan",400]],"t":"(Aku hanya) menyampaikan (peringatan) dari Allah dan risalah-Nya. Dan barangsiapa mendurhakai Allah dan Rasul-Nya maka sesungguhnya dia akan mendapat (azab) neraka Jahanam, mereka kekal di dalamnya selama-lamanya.\""},{"n":24,"w":[["حَتَّىٰٓ","sehingga","ḥattā",91],["إِذَا","apabila/tatkala","idhā",29],["رَأَوْا۟","mereka melihat","ra-aw",54],["مَا","apa","mā",6],["يُوعَدُونَ","mereka dijanjikan/diancam","yūʿadūna",190],["فَسَيَعْلَمُونَ","maka mereka akan mengetahui","fasayaʿlamūna",35],["مَنْ","siapa","man",17],["أَضْعَفُ","lebih lemah","aḍʿafu",2146],["نَاصِرًۭا","penolong/pembantu","nāṣiran",805],["وَأَقَلُّ","dan lebih sedikit","wa-aqallu",2182],["عَدَدًۭا","bilangan","ʿadadan",1163]],"t":"Sehingga apabila mereka melihat (azab) yang diancamkan kepadanya, maka mereka akan mengetahui siapakah yang lebih lemah penolongnya dan lebih sedikit jumlahnya."},{"n":25,"w":[["قُلْ","katakanlah","qul",10],["إِنْ","tidak","in",19],["أَدْرِىٓ","aku mengetahui","adrī",744],["أَقَرِيبٌۭ","apakah dekat","aqarībun",429],["مَّا","apa (azab)","mā",6],["تُوعَدُونَ","kamu dijanjikan/diancam","tūʿadūna",190],["أَمْ","atau","am",93],["يَجْعَلُ","menjadikan","yajʿalu",40],["لَهُۥ","baginya","lahu",21],["رَبِّىٓ","Tuhanku","rabbī",15],["أَمَدًا","masa yang panjang","amadan",1495]],"t":"Katakanlah (Muhammad), \"Aku tidak mengetahui, apakah azab yang diancamkan kepadamu itu sudah dekat ataukah Tuhanku menetapkan waktunya masih lama.\""},{"n":26,"w":[["عَـٰلِمُ","Maha Mengetahui","ʿālimu",558],["ٱلْغَيْبِ","yang gaib","l-ghaybi",254],["فَلَا","maka tidak","falā",8],["يُظْهِرُ","Dia menerangkan/menyatakan","yuẓ'hiru",969],["عَلَىٰ","atas","ʿalā",11],["غَيْبِهِۦٓ","kegaiban-Nya","ghaybihi",254],["أَحَدًا","seseorang","aḥadan",170]],"t":"Dia Mengetahui yang gaib, tetapi Dia tidak memperlihatkan kepada siapa pun tentang yang gaib itu."},{"n":27,"w":[["إِلَّا","kecuali","illā",20],["مَنِ","siapa/orang","mani",17],["ٱرْتَضَىٰ","Dia meridhai","ir'taḍā",2098],["مِن","dari","min",1],["رَّسُولٍۢ","rasul","rasūlin",42],["فَإِنَّهُۥ","maka sesungguhnya Dia","fa-innahu",9],["يَسْلُكُ","menjalankan/mengadakan","yasluku",759],["مِنۢ","dari","min",1],["بَيْنِ","antara","bayni",55],["يَدَيْهِ","kedua tangannya/hadapannya","yadayhi",110],["وَمِنْ","dan dari","wamin",1],["خَلْفِهِۦ","belakangnya","khalfihi",492],["رَصَدًۭا","pengintai/penjaga","raṣadan",2621]],"t":"Kecuali kepada rasul yang diridai-Nya, maka sesungguhnya Dia mengadakan penjaga-penjaga (malaikat) di depan dan di belakangnya."},{"n":28,"w":[["لِّيَعْلَمَ","karena Dia hendak mengetahui","liyaʿlama",35],["أَن","bahwa","an",22],["قَدْ","sesungguhnya","qad",30],["أَبْلَغُوا۟","mereka telah menyampaikan","ablaghū",1286],["رِسَـٰلَـٰتِ","amanat/risalah","risālāti",872],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["وَأَحَاطَ","dan Dia meliputi","wa-aḥāṭa",574],["بِمَا","terhadap apa","bimā",6],["لَدَيْهِمْ","di sisi/pada mereka","ladayhim",481],["وَأَحْصَىٰ","dan Dia menghitung","wa-aḥṣā",828],["كُلَّ","tiap-tiap/segala","kulla",38],["شَىْءٍ","sesuatu","shayin",49],["عَدَدًۢا","bilangan/satu persatu","ʿadadan",1163]],"t":"Agar Dia mengetahui, bahwa rasul-rasul itu sungguh, telah menyampaikan risalah Tuhannya, sedang (ilmu-Nya) meliputi apa yang ada pada mereka, dan Dia menghitung segala sesuatu satu persatu."}]