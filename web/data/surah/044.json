[{"n":1,"w":[["حمٓ","Haa Miim.","hha-meem",1071]],"t":"Ḥā Mīm."},{"n":2,"w":[["وَٱلْكِتَـٰبِ","demi kitab","wal-kitābi",57],["ٱلْمُبِينِ","yang jelas","l-mubīni",112]],"t":"Demi Kitab (Alquran) yang jelas,"},{"n":3,"w":[["إِنَّآ","sesungguhnya Kami","innā",9],["أَنزَلْنَـٰهُ","Kami menurunkannya","anzalnāhu",71],["فِى","pada","fī",7],["لَيْلَةٍۢ","malam hari","laylatin",998],["مُّبَـٰرَكَةٍ ۚ","yang diberkati","mubārakatin",1628],["إِنَّا","sesungguhnya Kami","innā",9],["كُنَّا","adalah Kami","kunnā",12],["مُنذِرِينَ","Pemberi peringatan","mundhirīna",644]],"t":"Sesungguhnya Kami menurunkannya pada malam yang diberkahi. Sungguh, Kamilah yang memberi peringatan."},{"n":4,"w":[["فِيهَا","didalamnya","fīhā",7],["يُفْرَقُ","dijelaskan","yuf'raqu",1350],["كُلُّ","segala","kullu",38],["أَمْرٍ","perkara/urusan","amrin",75],["حَكِيمٍ","hikmah/bijaksana","ḥakīmin",126]],"t":"Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,"},{"n":5,"w":[["أَمْرًۭا","perintah/urusan","amran",75],["مِّنْ","dari","min",1],["عِندِنَآ ۚ","sisi Kami","ʿindinā",68],["إِنَّا","sesungguhnya Kami","innā",9],["كُنَّا","adalah Kami","kunnā",12],["مُرْسِلِينَ","yang mengutus","mur'silīna",1394]],"t":"(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,"},{"n":6,"w":[["رَحْمَةًۭ","rahmat","raḥmatan",116],["مِّن","dari","min",1],["رَّبِّكَ ۚ","Tuhanmu","rabbika",15],["إِنَّهُۥ","sesungguhnya","innahu",9],["هُوَ","Dia","huwa",25],["ٱلسَّمِيعُ","Maha Mendengar","l-samīʿu",266],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",77]],"t":"sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui,"},{"n":7,"w":[["رَبِّ","Tuhan","rabbi",15],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["وَمَا","dan apa","wamā",6],["بَيْنَهُمَآ ۖ","yang ada di antara keduanya","baynahumā",55],["إِن","jika","in",19],["كُنتُم","kalian adalah","kuntum",12],["مُّوقِنِينَ","orang yang meyakini","mūqinīna",1402]],"t":"Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini."},{"n":8,"w":[["لَآ","tidak ada","lā",8],["إِلَـٰهَ","Tuhan","ilāha",84],["إِلَّا","kecuali","illā",20],["هُوَ","Dia","huwa",25],["يُحْىِۦ","Dia menghidupkan","yuḥ'yī",242],["وَيُمِيتُ ۖ","dan Dia mematikan","wayumītu",496],["رَبُّكُمْ","Tuhan kalian","rabbukum",15],["وَرَبُّ","dan Tuhan","warabbu",15],["ءَابَآئِكُمُ","bapak-bapak kamu","ābāikumu",117],["ٱلْأَوَّلِينَ","terdahulu","l-awalīna",151]],"t":"Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu."},{"n":9,"w":[["بَلْ","tetapi","bal",105],["هُمْ","mereka","hum",16],["فِى","dalam","fī",7],["شَكٍّۢ","keragu-raguan","shakkin",624],["يَلْعَبُونَ","mereka bermain-main","yalʿabūna",925]],"t":"Tetapi mereka dalam keraguan, mereka bermain-main."},{"n":10,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1709],["يَوْمَ","hari","yawma",31],["تَأْتِى","datang/membawa","tatī",56],["ٱلسَّمَآءُ","langit","l-samāu",44],["بِدُخَانٍۢ","dengan asap/kabut","bidukhānin",2365],["مُّبِينٍۢ","nyata","mubīnin",112]],"t":"Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,"},{"n":11,"w":[["يَغْشَى","menutupi","yaghshā",698],["ٱلنَّاسَ ۖ","manusia","l-nāsa",60],["هَـٰذَا","ini","hādhā",64],["عَذَابٌ","azab","ʿadhābun",43],["أَلِيمٌۭ","yang pedih","alīmun",178]],"t":"yang meliputi manusia. Inilah azab yang pedih."},{"n":12,"w":[["رَّبَّنَا","ya Tuhan kami","rabbanā",15],["ٱكْشِفْ","hilangkanlah","ik'shif",674],["عَنَّا","dari kami","ʿannā",27],["ٱلْعَذَابَ","azab","l-ʿadhāba",43],["إِنَّا","sesungguhnya kami","innā",9],["مُؤْمِنُونَ","orang-orang yang beriman","mu'minūna",63]],"t":"(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\""},{"n":13,"w":[["أَنَّىٰ","bagaimana","annā",401],["لَهُمُ","bagi mereka","lahumu",16],["ٱلذِّكْرَىٰ","peringatan","l-dhik'rā",458],["وَقَدْ","dan sungguh","waqad",30],["جَآءَهُمْ","telah datang kepada mereka","jāahum",51],["رَسُولٌۭ","seorang rasul","rasūlun",42],["مُّبِينٌۭ","nyata/jelas","mubīnun",112]],"t":"Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,"},{"n":14,"w":[["ثُمَّ","kemudian","thumma",41],["تَوَلَّوْا۟","mereka berpaling","tawallaw",160],["عَنْهُ","dari padanya","ʿanhu",27],["وَقَالُوا۟","dan mereka berkata","waqālū",10],["مُعَلَّمٌۭ","seorang yang diajar","muʿallamun",3797],["مَّجْنُونٌ","seorang gila","majnūnun",800]],"t":"kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\""},{"n":15,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["كَاشِفُوا۟","menghilangkan","kāshifū",1369],["ٱلْعَذَابِ","azab","l-ʿadhābi",43],["قَلِيلًا ۚ","sedikit","qalīlan",186],["إِنَّكُمْ","sesungguhnya kalian","innakum",9],["عَآئِدُونَ","orang-orang yang kembali","ʿāidūna",3082]],"t":"Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar)."},{"n":16,"w":[["يَوْمَ","pada hari","yawma",31],["نَبْطِشُ","Kami menghantam/menyerang","nabṭishu",1336],["ٱلْبَطْشَةَ","hantaman/serangan","l-baṭshata",2338],["ٱلْكُبْرَىٰٓ","yang keras","l-kub'rā",1095],["إِنَّا","sesungguhnya Kami","innā",9],["مُنتَقِمُونَ","pemberi siksaan","muntaqimūna",1941]],"t":"(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras. Kami pasti memberi balasan."},{"n":17,"w":[["۞ وَلَقَدْ","dan sesungguhnya","walaqad",30],["فَتَنَّا","Kami telah menguji","fatannā",464],["قَبْلَهُمْ","sebelum mereka","qablahum",59],["قَوْمَ","kaum","qawma",33],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["وَجَآءَهُمْ","dan telah datang kepada mereka","wajāahum",51],["رَسُولٌۭ","seorang rasul","rasūlun",42],["كَرِيمٌ","yang mulia","karīmun",383]],"t":"Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun dan telah datang kepada mereka seorang Rasul yang mulia,"},{"n":18,"w":[["أَنْ","hendaklah","an",22],["أَدُّوٓا۟","serahkan","addū",1286],["إِلَىَّ","kepadaku","ilayya",18],["عِبَادَ","hamba-hamba","ʿibāda",99],["ٱللَّهِ ۖ","Allah","l-lahi",4],["إِنِّى","sesungguhnya aku","innī",9],["لَكُمْ","bagi kalian","lakum",32],["رَسُولٌ","seorang rasul","rasūlun",42],["أَمِينٌۭ","terpercaya","amīnun",659]],"t":"(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya,"},{"n":19,"w":[["وَأَن","dan sesungguhnya","wa-an",22],["لَّا","janganlah","lā",8],["تَعْلُوا۟","kamu menyombongkan diri","taʿlū",531],["عَلَى","terhadap","ʿalā",11],["ٱللَّهِ ۖ","Allah","l-lahi",4],["إِنِّىٓ","sesungguhnya aku","innī",9],["ءَاتِيكُم","aku datang kepadamu","ātīkum",56],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/bukti","bisul'ṭānin",338],["مُّبِينٍۢ","nyata","mubīnin",112]],"t":"dan jangalah kamu menyombongkan diri terhadap Allah. Sungguh, aku datang kepadamu dengan membawa bukti yang nyata."},{"n":20,"w":[["وَإِنِّى","dan sesungguhnya aku","wa-innī",9],["عُذْتُ","aku berlindung","ʿudh'tu",832],["بِرَبِّى","kepada Tuhanku","birabbī",15],["وَرَبِّكُمْ","dan Tuhanmu","warabbikum",15],["أَن","bahwa","an",22],["تَرْجُمُونِ","kamu akan merajamku","tarjumūni",1417]],"t":"Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari ancamanmu untuk merajamku,"},{"n":21,"w":[["وَإِن","dan jika","wa-in",19],["لَّمْ","tidak","lam",39],["تُؤْمِنُوا۟","kamu beriman","tu'minū",23],["لِى","kepadaku","lī",158],["فَٱعْتَزِلُونِ","maka tinggalkanlah aku","fa-iʿ'tazilūni",1132]],"t":"dan jika kamu tidak beriman kepadaku, maka biarkanlah aku (memimpin Bani Israil).\""},{"n":22,"w":[["فَدَعَا","maka dia berdo'a","fadaʿā",74],["رَبَّهُۥٓ","Tuhannya","rabbahu",15],["أَنَّ","bahwasanya","anna",36],["هَـٰٓؤُلَآءِ","mereka ini","hāulāi",269],["قَوْمٌۭ","kaum","qawmun",33],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",240]],"t":"Kemudian dia (Musa) berdoa kepada Tuhannya, \"Sungguh, mereka ini adalah kaum yang berdosa (segerakanlah azab kepada mereka).\""},{"n":23,"w":[["فَأَسْرِ","maka berjalanlah kamu","fa-asri",1150],["بِعِبَادِى","dengan hamba-hamba-Ku","biʿibādī",99],["لَيْلًا","pada malam hari","laylan",146],["إِنَّكُم","sesungguhnya kalian","innakum",9],["مُّتَّبَعُونَ","orang-orang yang diikuti/di kejar","muttabaʿūna",2559]],"t":"(Allah berfirman), \"Karena itu berjalanlah dengan hamba-hamba-Ku pada malam hari, sesungguhnya kamu akan dikejar,"},{"n":24,"w":[["وَٱتْرُكِ","dan tinggalkan/biarkan","wa-ut'ruki",308],["ٱلْبَحْرَ","laut","l-baḥra",300],["رَهْوًا ۖ","tenang","rahwan",4179],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["جُندٌۭ","bala tentara","jundun",394],["مُّغْرَقُونَ","orang-orang yang ditenggelamkan","mugh'raqūna",1629]],"t":"dan biarkanlah laut itu terbelah. Sesungguhnya mereka bala tentara yang akan ditenggelamkan.\""},{"n":25,"w":[["كَمْ","berapa banyak","kam",499],["تَرَكُوا۟","mereka tinggalkan","tarakū",308],["مِن","dari","min",1],["جَنَّـٰتٍۢ","taman-taman","jannātin",86],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",218]],"t":"Betapa banyak taman-taman dan mata air-mata air yang mereka tinggalkan,"},{"n":26,"w":[["وَزُرُوعٍۢ","dan tanaman-tanaman","wazurūʿin",881],["وَمَقَامٍۢ","dan tempat-tempat","wamaqāmin",679],["كَرِيمٍۢ","mulia/indah","karīmin",383]],"t":"juga kebun-kebun serta tempat-tempat kediaman yang indah,"},{"n":27,"w":[["وَنَعْمَةٍۢ","dan kenikmatan","wanaʿmatin",2588],["كَانُوا۟","adalah mereka","kānū",12],["فِيهَا","di dalamnya","fīhā",7],["فَـٰكِهِينَ","bersenang-senang","fākihīna",1852]],"t":"dan kesenangan-kesenangan yang dapat mereka nikmati di sana,"},{"n":28,"w":[["كَذَٰلِكَ ۖ","seperti demikian","kadhālika",26],["وَأَوْرَثْنَـٰهَا","Kami wariskannya","wa-awrathnāhā",727],["قَوْمًا","kaum","qawman",33],["ءَاخَرِينَ","yang lain","ākharīna",187]],"t":"demikianlah, dan Kami wariskan (semua) itu kepada kaum yang lain."},{"n":29,"w":[["فَمَا","maka tidaklah","famā",6],["بَكَتْ","menangis","bakat",1338],["عَلَيْهِمُ","atas mereka","ʿalayhimu",11],["ٱلسَّمَآءُ","langit","l-samāu",44],["وَٱلْأَرْضُ","dan bumi","wal-arḍu",28],["وَمَا","dan tidak ada","wamā",6],["كَانُوا۟","mereka","kānū",12],["مُنظَرِينَ","orang-orang yang diberi tangguh","munẓarīna",1217]],"t":"Maka langit dan bumi tidak menangisi mereka dan mereka pun tidak diberi penangguhan waktu."},{"n":30,"w":[["وَلَقَدْ","dan sesungguhya","walaqad",30],["نَجَّيْنَا","Kami telah menyelamatkan","najjaynā",337],["بَنِىٓ","Bani","banī",90],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",284],["مِنَ","dari","mina",1],["ٱلْعَذَابِ","azab","l-ʿadhābi",43],["ٱلْمُهِينِ","yang hina","l-muhīni",680]],"t":"Dan sungguh, telah Kami selamatkan Bani Israil dari siksaan yang menghinakan,"},{"n":31,"w":[["مِن","dari","min",1],["فِرْعَوْنَ ۚ","Fir'aun","fir'ʿawna",171],["إِنَّهُۥ","sesungguhnya","innahu",9],["كَانَ","adalah","kāna",12],["عَالِيًۭا","tinggi/sombong","ʿāliyan",1159],["مِّنَ","dari/termasuk","mina",1],["ٱلْمُسْرِفِينَ","orang-orang yang melampaui batas","l-mus'rifīna",645]],"t":"dari (siksaan) Fir'aun, sungguh, dia itu orang yang sombong, termasuk orang-orang yang melampaui batas."},{"n":32,"w":[["وَلَقَدِ","dan sesungguhnya","walaqadi",30],["ٱخْتَرْنَـٰهُمْ","Kami telah memilih mereka","ikh'tarnāhum",1718],["عَلَىٰ","dengan","ʿalā",11],["عِلْمٍ","pengetahuan","ʿil'min",122],["عَلَى","di atas","ʿalā",11],["ٱلْعَـٰلَمِينَ","alam semesta","l-ʿālamīna",174]],"t":"Dan sungguh, Kami pilih mereka (Bani Israil) dengan ilmu (Kami) di atas semua bangsa (pada masa itu)."},{"n":33,"w":[["وَءَاتَيْنَـٰهُم","dan Kami telah berikan kepada mereka","waātaynāhum",53],["مِّنَ","dari","mina",1],["ٱلْـَٔايَـٰتِ","tanda-tanda","l-āyāti",34],["مَا","apa yang","mā",6],["فِيهِ","di dalamnya","fīhi",7],["بَلَـٰٓؤٌۭا۟","percobaan/ujian","balāon",1182],["مُّبِينٌ","nyata","mubīnun",112]],"t":"Dan telah Kami berikan kepada mereka di antara tanda-tanda (kebesaran Kami) sesuatu yang di dalamnya terdapat nikmat yang nyata."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",269],["لَيَقُولُونَ","benar-benar mereka berkata","layaqūlūna",10]],"t":"Sesungguhnya mereka (kaum musyrik) itu pasti akan berkata,"},{"n":35,"w":[["إِنْ","bahwa","in",19],["هِىَ","ia","hiya",203],["إِلَّا","kecuali","illā",20],["مَوْتَتُنَا","kematian kami","mawtatunā",1923],["ٱلْأُولَىٰ","pertama","l-ūlā",151],["وَمَا","dan tidaklah","wamā",6],["نَحْنُ","kami","naḥnu",140],["بِمُنشَرِينَ","orang-orang yang di bangkitkan","bimunsharīna",3844]],"t":"\"Tidak ada kematian selain kematian di dunia ini. Dan kami tidak akan dibangkitkan,"},{"n":36,"w":[["فَأْتُوا۟","maka datanglah","fatū",56],["بِـَٔابَآئِنَآ","dengan bapak-bapak kami","biābāinā",117],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",211]],"t":"maka hadirkanlah (kembali) nenek moyang kami jika kamu orang yang benar.\""},{"n":37,"w":[["أَهُمْ","apakah mereka","ahum",16],["خَيْرٌ","lebih baik","khayrun",69],["أَمْ","atau","am",93],["قَوْمُ","kaum","qawmu",33],["تُبَّعٍۢ","Tubba'","tubbaʿin",2717],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["مِن","dari","min",1],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",59],["أَهْلَكْنَـٰهُمْ ۖ","Kami telah membinasakan mereka","ahlaknāhum",243],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["مُجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",240]],"t":"Apakah mereka (kaum musyrikin) yang lebih baik atau kaum Tubba', dan orang-orang sebelum mereka yang telah Kami binasakan karena mereka adalah orang-orang yang sungguh berdosa."},{"n":38,"w":[["وَمَا","dan tidak","wamā",6],["خَلَقْنَا","Kami menciptakan/menjadikan","khalaqnā",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["وَمَا","dan apa","wamā",6],["بَيْنَهُمَا","diantara keduanya","baynahumā",55],["لَـٰعِبِينَ","bermain-main","lāʿibīna",1898]],"t":"Dan tidaklah Kami bermain-main menciptakan langit dan bumi dan apa yang ada di antara keduanya."},{"n":39,"w":[["مَا","tidak","mā",6],["خَلَقْنَـٰهُمَآ","Kami menjadikan keduanya","khalaqnāhumā",70],["إِلَّا","kecuali","illā",20],["بِٱلْحَقِّ","dengan hak","bil-ḥaqi",58],["وَلَـٰكِنَّ","tetapi","walākinna",220],["أَكْثَرَهُمْ","kebanyakan mereka","aktharahum",155],["لَا","tidak","lā",8],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Tidaklah Kami ciptakan keduanya melainkan dengan hak (benar), tetapi kebanyakan mereka tidak mengetahui."},{"n":40,"w":[["إِنَّ","sesungguhnya","inna",9],["يَوْمَ","hari","yawma",31],["ٱلْفَصْلِ","keputusan","l-faṣli",916],["مِيقَـٰتُهُمْ","waktu mereka","mīqātuhum",1001],["أَجْمَعِينَ","semuanya","ajmaʿīna",424]],"t":"Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,"},{"n":41,"w":[["يَوْمَ","hari","yawma",31],["لَا","tidak","lā",8],["يُغْنِى","berguna","yugh'nī",285],["مَوْلًى","kawan karib","mawlan",502],["عَن","dari","ʿan",27],["مَّوْلًۭى","kawan karib","mawlan",502],["شَيْـًۭٔا","sesuatu/sedikit","shayan",49],["وَلَا","dan tidaklah","walā",8],["هُمْ","mereka","hum",16],["يُنصَرُونَ","mereka mendapat pertolongan","yunṣarūna",212]],"t":"(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,"},{"n":42,"w":[["إِلَّا","kecuali","illā",20],["مَن","orang","man",17],["رَّحِمَ","merahmati","raḥima",407],["ٱللَّهُ ۚ","Allah","l-lahu",4],["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["هُوَ","Dia","huwa",25],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",124],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",114]],"t":"kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang."},{"n":43,"w":[["إِنَّ","sesungguhnya","inna",9],["شَجَرَتَ","pohon","shajarata",532],["ٱلزَّقُّومِ","zaqqum","l-zaqūmi",2087]],"t":"Sungguh pohon zaqqūm itu,"},{"n":44,"w":[["طَعَامُ","makanan","ṭaʿāmu",452],["ٱلْأَثِيمِ","orang yang berdosa","l-athīmi",1052]],"t":"makanan bagi orang yang banyak dosa."},{"n":45,"w":[["كَٱلْمُهْلِ","seperti minyak","kal-muh'li",1937],["يَغْلِى","ia mendidih","yaghlī",3489],["فِى","di dalam","fī",7],["ٱلْبُطُونِ","perut","l-buṭūni",580]],"t":"Seperti cairan tembaga yang mendidih di dalam perut,"},{"n":46,"w":[["كَغَلْىِ","seperti mendidihnya","kaghalyi",3491],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",518]],"t":"seperti mendidihnya air yang sangat panas."},{"n":47,"w":[["خُذُوهُ","tangkaplah dia","khudhūhu",103],["فَٱعْتِلُوهُ","lalu seretlah dia","fa-iʿ'tilūhu",3126],["إِلَىٰ","sampai","ilā",18],["سَوَآءِ","ke tengah-tengah","sawāi",420],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",426]],"t":"\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,"},{"n":48,"w":[["ثُمَّ","kemudian","thumma",41],["صُبُّوا۟","tuangkanlah","ṣubbū",1539],["فَوْقَ","di atas","fawqa",301],["رَأْسِهِۦ","kepalanya","rasihi",566],["مِنْ","dari","min",1],["عَذَابِ","azab","ʿadhābi",43],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",518]],"t":"kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\""},{"n":49,"w":[["ذُقْ","rasakanlah","dhuq",339],["إِنَّكَ","sesungguhnya kamu","innaka",9],["أَنتَ","kamu","anta",154],["ٱلْعَزِيزُ","seorang perkasa","l-ʿazīzu",124],["ٱلْكَرِيمُ","seorang mulia","l-karīmu",383]],"t":"\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\""},{"n":50,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰذَا","ini","hādhā",64],["مَا","apa (azab)","mā",6],["كُنتُم","kalian adalah","kuntum",12],["بِهِۦ","padanya","bihi",21],["تَمْتَرُونَ","kamu meragukan","tamtarūna",1462]],"t":"Sungguh, inilah azab yang dahulu kamu ragukan."},{"n":51,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",257],["فِى","dalam","fī",7],["مَقَامٍ","tempat","maqāmin",679],["أَمِينٍۢ","aman","amīnin",659]],"t":"Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,"},{"n":52,"w":[["فِى","dalam","fī",7],["جَنَّـٰتٍۢ","taman-taman","jannātin",86],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",218]],"t":"(yaitu) di dalam taman-taman dan mata air-mata air;"},{"n":53,"w":[["يَلْبَسُونَ","mereka memakai","yalbasūna",798],["مِن","dari","min",1],["سُندُسٍۢ","kain sutera halus","sundusin",2028],["وَإِسْتَبْرَقٍۢ","dan sutera tebal","wa-is'tabraqin",1477],["مُّتَقَـٰبِلِينَ","mereka berhadap-hadapan","mutaqābilīna",1633]],"t":"mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan,"},{"n":54,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",26],["وَزَوَّجْنَـٰهُم","Kami jodohkan mereka","wazawwajnāhum",1455],["بِحُورٍ","dengan jelita/bidadari","biḥūrin",1534],["عِينٍۢ","matanya","ʿīnin",1521]],"t":"demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah."},{"n":55,"w":[["يَدْعُونَ","mereka meminta","yadʿūna",74],["فِيهَا","di dalamnya","fīhā",7],["بِكُلِّ","dengan segala macam","bikulli",38],["فَـٰكِهَةٍ","buah-buahan","fākihatin",672],["ءَامِنِينَ","dengan aman","āminīna",571]],"t":"Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram,"},{"n":56,"w":[["لَا","tidak","lā",8],["يَذُوقُونَ","mereka merasakan","yadhūqūna",339],["فِيهَا","di dalamnya","fīhā",7],["ٱلْمَوْتَ","mati","l-mawta",249],["إِلَّا","kecuali","illā",20],["ٱلْمَوْتَةَ","kematian","l-mawtata",1923],["ٱلْأُولَىٰ ۖ","pertama","l-ūlā",151],["وَوَقَىٰهُمْ","dan Dia memelihara mereka","wawaqāhum",619],["عَذَابَ","azab","ʿadhāba",43],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",426]],"t":"mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka,"},{"n":57,"w":[["فَضْلًۭا","karunia","faḍlan",145],["مِّن","dari","min",1],["رَّبِّكَ ۚ","Tuhanmu","rabbika",15],["ذَٰلِكَ","demikian itu","dhālika",26],["هُوَ","ia/itu","huwa",25],["ٱلْفَوْزُ","keuntungan","l-fawzu",540],["ٱلْعَظِيمُ","yang besar","l-ʿaẓīmu",109]],"t":"itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung."},{"n":58,"w":[["فَإِنَّمَا","maka sesungguhnya","fa-innamā",9],["يَسَّرْنَـٰهُ","Kami mudahkannya","yassarnāhu",819],["بِلِسَانِكَ","dengan lisan/bahasamu","bilisānika",442],["لَعَلَّهُمْ","supaya mereka","laʿallahum",101],["يَتَذَكَّرُونَ","mereka mendapat pelajaran","yatadhakkarūna",245]],"t":"Sungguh, Kami mudahkan Alquran itu dengan bahasamu agar mereka mendapat pelajaran."},{"n":59,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1709],["إِنَّهُم","sesungguhnya mereka","innahum",9],["مُّرْتَقِبُونَ","orang-orang yang menunggu","mur'taqibūna",3994]],"t":"Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu."}]