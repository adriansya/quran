[{"n":1,"w":[["حمٓ","Haa Miim.","hha-meem",1060]],"t":"Ḥā Mīm."},{"n":2,"w":[["وَٱلْكِتَـٰبِ","demi kitab","wal-kitābi",49],["ٱلْمُبِينِ","yang jelas","l-mubīni",103]],"t":"Demi Kitab (Alquran) yang jelas,"},{"n":3,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَنزَلْنَـٰهُ","Kami menurunkannya","anzalnāhu",63],["فِى","pada","fī",3],["لَيْلَةٍۢ","malam hari","laylatin",987],["مُّبَـٰرَكَةٍ ۚ","yang diberkati","mubārakatin",1617],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",8],["مُنذِرِينَ","Pemberi peringatan","mundhirīna",635]],"t":"Sesungguhnya Kami menurunkannya pada malam yang diberkahi. Sungguh, Kamilah yang memberi peringatan."},{"n":4,"w":[["فِيهَا","didalamnya","fīhā",3],["يُفْرَقُ","dijelaskan","yuf'raqu",1339],["كُلُّ","segala","kullu",31],["أَمْرٍ","perkara/urusan","amrin",67],["حَكِيمٍ","hikmah/bijaksana","ḥakīmin",116]],"t":"Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,"},{"n":5,"w":[["أَمْرًۭا","perintah/urusan","amran",67],["مِّنْ","dari","min",0],["عِندِنَآ ۚ","sisi Kami","ʿindinā",60],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",8],["مُرْسِلِينَ","yang mengutus","mur'silīna",1383]],"t":"(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,"},{"n":6,"w":[["رَحْمَةًۭ","rahmat","raḥmatan",106],["مِّن","dari","min",0],["رَّبِّكَ ۚ","Tuhanmu","rabbika",10],["إِنَّهُۥ","sesungguhnya","innahu",5],["هُوَ","Dia","huwa",19],["ٱلسَّمِيعُ","Maha Mendengar","l-samīʿu",256],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",69]],"t":"sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui,"},{"n":7,"w":[["رَبِّ","Tuhan","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَآ ۖ","yang ada di antara keduanya","baynahumā",47],["إِن","jika","in",14],["كُنتُم","kalian adalah","kuntum",8],["مُّوقِنِينَ","orang yang meyakini","mūqinīna",1391]],"t":"Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini."},{"n":8,"w":[["لَآ","tidak ada","lā",4],["إِلَـٰهَ","Tuhan","ilāha",76],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",19],["يُحْىِۦ","Dia menghidupkan","yuḥ'yī",232],["وَيُمِيتُ ۖ","dan Dia mematikan","wayumītu",487],["رَبُّكُمْ","Tuhan kalian","rabbukum",10],["وَرَبُّ","dan Tuhan","warabbu",10],["ءَابَآئِكُمُ","bapak-bapak kamu","ābāikumu",107],["ٱلْأَوَّلِينَ","terdahulu","l-awalīna",142]],"t":"Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu."},{"n":9,"w":[["بَلْ","tetapi","bal",97],["هُمْ","mereka","hum",11],["فِى","dalam","fī",3],["شَكٍّۢ","keragu-raguan","shakkin",615],["يَلْعَبُونَ","mereka bermain-main","yalʿabūna",914]],"t":"Tetapi mereka dalam keraguan, mereka bermain-main."},{"n":10,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1698],["يَوْمَ","hari","yawma",25],["تَأْتِى","datang/membawa","tatī",48],["ٱلسَّمَآءُ","langit","l-samāu",37],["بِدُخَانٍۢ","dengan asap/kabut","bidukhānin",2354],["مُّبِينٍۢ","nyata","mubīnin",103]],"t":"Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,"},{"n":11,"w":[["يَغْشَى","menutupi","yaghshā",689],["ٱلنَّاسَ ۖ","manusia","l-nāsa",52],["هَـٰذَا","ini","hādhā",56],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","yang pedih","alīmun",168]],"t":"yang meliputi manusia. Inilah azab yang pedih."},{"n":12,"w":[["رَّبَّنَا","ya Tuhan kami","rabbanā",10],["ٱكْشِفْ","hilangkanlah","ik'shif",665],["عَنَّا","dari kami","ʿannā",21],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["إِنَّا","sesungguhnya kami","innā",5],["مُؤْمِنُونَ","orang-orang yang beriman","mu'minūna",55]],"t":"(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\""},{"n":13,"w":[["أَنَّىٰ","bagaimana","annā",391],["لَهُمُ","bagi mereka","lahumu",11],["ٱلذِّكْرَىٰ","peringatan","l-dhik'rā",449],["وَقَدْ","dan sungguh","waqad",24],["جَآءَهُمْ","telah datang kepada mereka","jāahum",43],["رَسُولٌۭ","seorang rasul","rasūlun",35],["مُّبِينٌۭ","nyata/jelas","mubīnun",103]],"t":"Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,"},{"n":14,"w":[["ثُمَّ","kemudian","thumma",34],["تَوَلَّوْا۟","mereka berpaling","tawallaw",150],["عَنْهُ","dari padanya","ʿanhu",21],["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مُعَلَّمٌۭ","seorang yang diajar","muʿallamun",3786],["مَّجْنُونٌ","seorang gila","majnūnun",791]],"t":"kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\""},{"n":15,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["كَاشِفُوا۟","menghilangkan","kāshifū",1358],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["قَلِيلًا ۚ","sedikit","qalīlan",176],["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["عَآئِدُونَ","orang-orang yang kembali","ʿāidūna",3071]],"t":"Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar)."},{"n":16,"w":[["يَوْمَ","pada hari","yawma",25],["نَبْطِشُ","Kami menghantam/menyerang","nabṭishu",1325],["ٱلْبَطْشَةَ","hantaman/serangan","l-baṭshata",2327],["ٱلْكُبْرَىٰٓ","yang keras","l-kub'rā",1084],["إِنَّا","sesungguhnya Kami","innā",5],["مُنتَقِمُونَ","pemberi siksaan","muntaqimūna",1930]],"t":"(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras. Kami pasti memberi balasan."},{"n":17,"w":[["۞ وَلَقَدْ","dan sesungguhnya","walaqad",24],["فَتَنَّا","Kami telah menguji","fatannā",455],["قَبْلَهُمْ","sebelum mereka","qablahum",51],["قَوْمَ","kaum","qawma",27],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",161],["وَجَآءَهُمْ","dan telah datang kepada mereka","wajāahum",43],["رَسُولٌۭ","seorang rasul","rasūlun",35],["كَرِيمٌ","yang mulia","karīmun",373]],"t":"Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun dan telah datang kepada mereka seorang Rasul yang mulia,"},{"n":18,"w":[["أَنْ","hendaklah","an",17],["أَدُّوٓا۟","serahkan","addū",1275],["إِلَىَّ","kepadaku","ilayya",13],["عِبَادَ","hamba-hamba","ʿibāda",91],["ٱللَّهِ ۖ","Allah","l-lahi",1],["إِنِّى","sesungguhnya aku","innī",5],["لَكُمْ","bagi kalian","lakum",26],["رَسُولٌ","seorang rasul","rasūlun",35],["أَمِينٌۭ","terpercaya","amīnun",650]],"t":"(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya,"},{"n":19,"w":[["وَأَن","dan sesungguhnya","wa-an",17],["لَّا","janganlah","lā",4],["تَعْلُوا۟","kamu menyombongkan diri","taʿlū",522],["عَلَى","terhadap","ʿalā",7],["ٱللَّهِ ۖ","Allah","l-lahi",1],["إِنِّىٓ","sesungguhnya aku","innī",5],["ءَاتِيكُم","aku datang kepadamu","ātīkum",48],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/bukti","bisul'ṭānin",328],["مُّبِينٍۢ","nyata","mubīnin",103]],"t":"dan jangalah kamu menyombongkan diri terhadap Allah. Sungguh, aku datang kepadamu dengan membawa bukti yang nyata."},{"n":20,"w":[["وَإِنِّى","dan sesungguhnya aku","wa-innī",5],["عُذْتُ","aku berlindung","ʿudh'tu",823],["بِرَبِّى","kepada Tuhanku","birabbī",10],["وَرَبِّكُمْ","dan Tuhanmu","warabbikum",10],["أَن","bahwa","an",17],["تَرْجُمُونِ","kamu akan merajamku","tarjumūni",1406]],"t":"Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari ancamanmu untuk merajamku,"},{"n":21,"w":[["وَإِن","dan jika","wa-in",14],["لَّمْ","tidak","lam",32],["تُؤْمِنُوا۟","kamu beriman","tu'minū",18],["لِى","kepadaku","lī",148],["فَٱعْتَزِلُونِ","maka tinggalkanlah aku","fa-iʿ'tazilūni",1121]],"t":"dan jika kamu tidak beriman kepadaku, maka biarkanlah aku (memimpin Bani Israil).\""},{"n":22,"w":[["فَدَعَا","maka dia berdo'a","fadaʿā",66],["رَبَّهُۥٓ","Tuhannya","rabbahu",10],["أَنَّ","bahwasanya","anna",30],["هَـٰٓؤُلَآءِ","mereka ini","hāulāi",259],["قَوْمٌۭ","kaum","qawmun",27],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",230]],"t":"Kemudian dia (Musa) berdoa kepada Tuhannya, \"Sungguh, mereka ini adalah kaum yang berdosa (segerakanlah azab kepada mereka).\""},{"n":23,"w":[["فَأَسْرِ","maka berjalanlah kamu","fa-asri",1139],["بِعِبَادِى","dengan hamba-hamba-Ku","biʿibādī",91],["لَيْلًا","pada malam hari","laylan",137],["إِنَّكُم","sesungguhnya kalian","innakum",5],["مُّتَّبَعُونَ","orang-orang yang diikuti/di kejar","muttabaʿūna",2548]],"t":"(Allah berfirman), \"Karena itu berjalanlah dengan hamba-hamba-Ku pada malam hari, sesungguhnya kamu akan dikejar,"},{"n":24,"w":[["وَٱتْرُكِ","dan tinggalkan/biarkan","wa-ut'ruki",298],["ٱلْبَحْرَ","laut","l-baḥra",290],["رَهْوًا ۖ","tenang","rahwan",4168],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["جُندٌۭ","bala tentara","jundun",384],["مُّغْرَقُونَ","orang-orang yang ditenggelamkan","mugh'raqūna",1618]],"t":"dan biarkanlah laut itu terbelah. Sesungguhnya mereka bala tentara yang akan ditenggelamkan.\""},{"n":25,"w":[["كَمْ","berapa banyak","kam",490],["تَرَكُوا۟","mereka tinggalkan","tarakū",298],["مِن","dari","min",0],["جَنَّـٰتٍۢ","taman-taman","jannātin",78],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",208]],"t":"Betapa banyak taman-taman dan mata air-mata air yang mereka tinggalkan,"},{"n":26,"w":[["وَزُرُوعٍۢ","dan tanaman-tanaman","wazurūʿin",871],["وَمَقَامٍۢ","dan tempat-tempat","wamaqāmin",670],["كَرِيمٍۢ","mulia/indah","karīmin",373]],"t":"juga kebun-kebun serta tempat-tempat kediaman yang indah,"},{"n":27,"w":[["وَنَعْمَةٍۢ","dan kenikmatan","wanaʿmatin",2577],["كَانُوا۟","adalah mereka","kānū",8],["فِيهَا","di dalamnya","fīhā",3],["فَـٰكِهِينَ","bersenang-senang","fākihīna",1841]],"t":"dan kesenangan-kesenangan yang dapat mereka nikmati di sana,"},{"n":28,"w":[["كَذَٰلِكَ ۖ","seperti demikian","kadhālika",20],["وَأَوْرَثْنَـٰهَا","Kami wariskannya","wa-awrathnāhā",718],["قَوْمًا","kaum","qawman",27],["ءَاخَرِينَ","yang lain","ākharīna",177]],"t":"demikianlah, dan Kami wariskan (semua) itu kepada kaum yang lain."},{"n":29,"w":[["فَمَا","maka tidaklah","famā",2],["بَكَتْ","menangis","bakat",1327],["عَلَيْهِمُ","atas mereka","ʿalayhimu",7],["ٱلسَّمَآءُ","langit","l-samāu",37],["وَٱلْأَرْضُ","dan bumi","wal-arḍu",22],["وَمَا","dan tidak ada","wamā",2],["كَانُوا۟","mereka","kānū",8],["مُنظَرِينَ","orang-orang yang diberi tangguh","munẓarīna",1206]],"t":"Maka langit dan bumi tidak menangisi mereka dan mereka pun tidak diberi penangguhan waktu."},{"n":30,"w":[["وَلَقَدْ","dan sesungguhya","walaqad",24],["نَجَّيْنَا","Kami telah menyelamatkan","najjaynā",327],["بَنِىٓ","Bani","banī",82],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",274],["مِنَ","dari","mina",0],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["ٱلْمُهِينِ","yang hina","l-muhīni",671]],"t":"Dan sungguh, telah Kami selamatkan Bani Israil dari siksaan yang menghinakan,"},{"n":31,"w":[["مِن","dari","min",0],["فِرْعَوْنَ ۚ","Fir'aun","fir'ʿawna",161],["إِنَّهُۥ","sesungguhnya","innahu",5],["كَانَ","adalah","kāna",8],["عَالِيًۭا","tinggi/sombong","ʿāliyan",1148],["مِّنَ","dari/termasuk","mina",0],["ٱلْمُسْرِفِينَ","orang-orang yang melampaui batas","l-mus'rifīna",636]],"t":"dari (siksaan) Fir'aun, sungguh, dia itu orang yang sombong, termasuk orang-orang yang melampaui batas."},{"n":32,"w":[["وَلَقَدِ","dan sesungguhnya","walaqadi",24],["ٱخْتَرْنَـٰهُمْ","Kami telah memilih mereka","ikh'tarnāhum",1707],["عَلَىٰ","dengan","ʿalā",7],["عِلْمٍ","pengetahuan","ʿil'min",112],["عَلَى","di atas","ʿalā",7],["ٱلْعَـٰلَمِينَ","alam semesta","l-ʿālamīna",164]],"t":"Dan sungguh, Kami pilih mereka (Bani Israil) dengan ilmu (Kami) di atas semua bangsa (pada masa itu)."},{"n":33,"w":[["وَءَاتَيْنَـٰهُم","dan Kami telah berikan kepada mereka","waātaynāhum",45],["مِّنَ","dari","mina",0],["ٱلْـَٔايَـٰتِ","tanda-tanda","l-āyāti",28],["مَا","apa yang","mā",2],["فِيهِ","di dalamnya","fīhi",3],["بَلَـٰٓؤٌۭا۟","percobaan/ujian","balāon",1171],["مُّبِينٌ","nyata","mubīnun",103]],"t":"Dan telah Kami berikan kepada mereka di antara tanda-tanda (kebesaran Kami) sesuatu yang di dalamnya terdapat nikmat yang nyata."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",259],["لَيَقُولُونَ","benar-benar mereka berkata","layaqūlūna",6]],"t":"Sesungguhnya mereka (kaum musyrik) itu pasti akan berkata,"},{"n":35,"w":[["إِنْ","bahwa","in",14],["هِىَ","ia","hiya",193],["إِلَّا","kecuali","illā",15],["مَوْتَتُنَا","kematian kami","mawtatunā",1912],["ٱلْأُولَىٰ","pertama","l-ūlā",142],["وَمَا","dan tidaklah","wamā",2],["نَحْنُ","kami","naḥnu",131],["بِمُنشَرِينَ","orang-orang yang di bangkitkan","bimunsharīna",3833]],"t":"\"Tidak ada kematian selain kematian di dunia ini. Dan kami tidak akan dibangkitkan,"},{"n":36,"w":[["فَأْتُوا۟","maka datanglah","fatū",48],["بِـَٔابَآئِنَآ","dengan bapak-bapak kami","biābāinā",107],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",8],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"maka hadirkanlah (kembali) nenek moyang kami jika kamu orang yang benar.\""},{"n":37,"w":[["أَهُمْ","apakah mereka","ahum",11],["خَيْرٌ","lebih baik","khayrun",61],["أَمْ","atau","am",85],["قَوْمُ","kaum","qawmu",27],["تُبَّعٍۢ","Tubba'","tubbaʿin",2706],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",51],["أَهْلَكْنَـٰهُمْ ۖ","Kami telah membinasakan mereka","ahlaknāhum",233],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",8],["مُجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",230]],"t":"Apakah mereka (kaum musyrikin) yang lebih baik atau kaum Tubba', dan orang-orang sebelum mereka yang telah Kami binasakan karena mereka adalah orang-orang yang sungguh berdosa."},{"n":38,"w":[["وَمَا","dan tidak","wamā",2],["خَلَقْنَا","Kami menciptakan/menjadikan","khalaqnā",62],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["لَـٰعِبِينَ","bermain-main","lāʿibīna",1887]],"t":"Dan tidaklah Kami bermain-main menciptakan langit dan bumi dan apa yang ada di antara keduanya."},{"n":39,"w":[["مَا","tidak","mā",2],["خَلَقْنَـٰهُمَآ","Kami menjadikan keduanya","khalaqnāhumā",62],["إِلَّا","kecuali","illā",15],["بِٱلْحَقِّ","dengan hak","bil-ḥaqi",50],["وَلَـٰكِنَّ","tetapi","walākinna",210],["أَكْثَرَهُمْ","kebanyakan mereka","aktharahum",146],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Tidaklah Kami ciptakan keduanya melainkan dengan hak (benar), tetapi kebanyakan mereka tidak mengetahui."},{"n":40,"w":[["إِنَّ","sesungguhnya","inna",5],["يَوْمَ","hari","yawma",25],["ٱلْفَصْلِ","keputusan","l-faṣli",905],["مِيقَـٰتُهُمْ","waktu mereka","mīqātuhum",990],["أَجْمَعِينَ","semuanya","ajmaʿīna",414]],"t":"Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,"},{"n":41,"w":[["يَوْمَ","hari","yawma",25],["لَا","tidak","lā",4],["يُغْنِى","berguna","yugh'nī",275],["مَوْلًى","kawan karib","mawlan",493],["عَن","dari","ʿan",21],["مَّوْلًۭى","kawan karib","mawlan",493],["شَيْـًۭٔا","sesuatu/sedikit","shayan",41],["وَلَا","dan tidaklah","walā",4],["هُمْ","mereka","hum",11],["يُنصَرُونَ","mereka mendapat pertolongan","yunṣarūna",202]],"t":"(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,"},{"n":42,"w":[["إِلَّا","kecuali","illā",15],["مَن","orang","man",12],["رَّحِمَ","merahmati","raḥima",397],["ٱللَّهُ ۚ","Allah","l-lahu",1],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",104]],"t":"kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang."},{"n":43,"w":[["إِنَّ","sesungguhnya","inna",5],["شَجَرَتَ","pohon","shajarata",523],["ٱلزَّقُّومِ","zaqqum","l-zaqūmi",2076]],"t":"Sungguh pohon zaqqūm itu,"},{"n":44,"w":[["طَعَامُ","makanan","ṭaʿāmu",442],["ٱلْأَثِيمِ","orang yang berdosa","l-athīmi",1041]],"t":"makanan bagi orang yang banyak dosa."},{"n":45,"w":[["كَٱلْمُهْلِ","seperti minyak","kal-muh'li",1926],["يَغْلِى","ia mendidih","yaghlī",3478],["فِى","di dalam","fī",3],["ٱلْبُطُونِ","perut","l-buṭūni",571]],"t":"Seperti cairan tembaga yang mendidih di dalam perut,"},{"n":46,"w":[["كَغَلْىِ","seperti mendidihnya","kaghalyi",3480],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",509]],"t":"seperti mendidihnya air yang sangat panas."},{"n":47,"w":[["خُذُوهُ","tangkaplah dia","khudhūhu",95],["فَٱعْتِلُوهُ","lalu seretlah dia","fa-iʿ'tilūhu",3115],["إِلَىٰ","sampai","ilā",13],["سَوَآءِ","ke tengah-tengah","sawāi",410],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",416]],"t":"\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,"},{"n":48,"w":[["ثُمَّ","kemudian","thumma",34],["صُبُّوا۟","tuangkanlah","ṣubbū",1528],["فَوْقَ","di atas","fawqa",291],["رَأْسِهِۦ","kepalanya","rasihi",557],["مِنْ","dari","min",0],["عَذَابِ","azab","ʿadhābi",36],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",509]],"t":"kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\""},{"n":49,"w":[["ذُقْ","rasakanlah","dhuq",329],["إِنَّكَ","sesungguhnya kamu","innaka",5],["أَنتَ","kamu","anta",145],["ٱلْعَزِيزُ","seorang perkasa","l-ʿazīzu",114],["ٱلْكَرِيمُ","seorang mulia","l-karīmu",373]],"t":"\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\""},{"n":50,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",56],["مَا","apa (azab)","mā",2],["كُنتُم","kalian adalah","kuntum",8],["بِهِۦ","padanya","bihi",16],["تَمْتَرُونَ","kamu meragukan","tamtarūna",1451]],"t":"Sungguh, inilah azab yang dahulu kamu ragukan."},{"n":51,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",247],["فِى","dalam","fī",3],["مَقَامٍ","tempat","maqāmin",670],["أَمِينٍۢ","aman","amīnin",650]],"t":"Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,"},{"n":52,"w":[["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","taman-taman","jannātin",78],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",208]],"t":"(yaitu) di dalam taman-taman dan mata air-mata air;"},{"n":53,"w":[["يَلْبَسُونَ","mereka memakai","yalbasūna",789],["مِن","dari","min",0],["سُندُسٍۢ","kain sutera halus","sundusin",2017],["وَإِسْتَبْرَقٍۢ","dan sutera tebal","wa-is'tabraqin",1466],["مُّتَقَـٰبِلِينَ","mereka berhadap-hadapan","mutaqābilīna",1622]],"t":"mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan,"},{"n":54,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",20],["وَزَوَّجْنَـٰهُم","Kami jodohkan mereka","wazawwajnāhum",1444],["بِحُورٍ","dengan jelita/bidadari","biḥūrin",1523],["عِينٍۢ","matanya","ʿīnin",1510]],"t":"demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah."},{"n":55,"w":[["يَدْعُونَ","mereka meminta","yadʿūna",66],["فِيهَا","di dalamnya","fīhā",3],["بِكُلِّ","dengan segala macam","bikulli",31],["فَـٰكِهَةٍ","buah-buahan","fākihatin",663],["ءَامِنِينَ","dengan aman","āminīna",562]],"t":"Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram,"},{"n":56,"w":[["لَا","tidak","lā",4],["يَذُوقُونَ","mereka merasakan","yadhūqūna",329],["فِيهَا","di dalamnya","fīhā",3],["ٱلْمَوْتَ","mati","l-mawta",239],["إِلَّا","kecuali","illā",15],["ٱلْمَوْتَةَ","kematian","l-mawtata",1912],["ٱلْأُولَىٰ ۖ","pertama","l-ūlā",142],["وَوَقَىٰهُمْ","dan Dia memelihara mereka","wawaqāhum",610],["عَذَابَ","azab","ʿadhāba",36],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",416]],"t":"mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka,"},{"n":57,"w":[["فَضْلًۭا","karunia","faḍlan",136],["مِّن","dari","min",0],["رَّبِّكَ ۚ","Tuhanmu","rabbika",10],["ذَٰلِكَ","demikian itu","dhālika",20],["هُوَ","ia/itu","huwa",19],["ٱلْفَوْزُ","keuntungan","l-fawzu",531],["ٱلْعَظِيمُ","yang besar","l-ʿaẓīmu",101]],"t":"itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung."},{"n":58,"w":[["فَإِنَّمَا","maka sesungguhnya","fa-innamā",5],["يَسَّرْنَـٰهُ","Kami mudahkannya","yassarnāhu",810],["بِلِسَانِكَ","dengan lisan/bahasamu","bilisānika",432],["لَعَلَّهُمْ","supaya mereka","laʿallahum",93],["يَتَذَكَّرُونَ","mereka mendapat pelajaran","yatadhakkarūna",235]],"t":"Sungguh, Kami mudahkan Alquran itu dengan bahasamu agar mereka mendapat pelajaran."},{"n":59,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1698],["إِنَّهُم","sesungguhnya mereka","innahum",5],["مُّرْتَقِبُونَ","orang-orang yang menunggu","mur'taqibūna",3983]],"t":"Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu."}]