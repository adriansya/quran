[{"n":1,"w":[["حمٓ","Haa Miim.","hha-meem",1064]],"t":"Ḥā Mīm."},{"n":2,"w":[["وَٱلْكِتَـٰبِ","demi kitab","wal-kitābi",49],["ٱلْمُبِينِ","yang jelas","l-mubīni",99]],"t":"Demi Kitab (Alquran) yang jelas,"},{"n":3,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَنزَلْنَـٰهُ","Kami menurunkannya","anzalnāhu",61],["فِى","pada","fī",3],["لَيْلَةٍۢ","malam hari","laylatin",986],["مُّبَـٰرَكَةٍ ۚ","yang diberkati","mubārakatin",1607],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",9],["مُنذِرِينَ","Pemberi peringatan","mundhirīna",636]],"t":"Sesungguhnya Kami menurunkannya pada malam yang diberkahi. Sungguh, Kamilah yang memberi peringatan."},{"n":4,"w":[["فِيهَا","didalamnya","fīhā",3],["يُفْرَقُ","dijelaskan","yuf'raqu",1337],["كُلُّ","segala","kullu",31],["أَمْرٍ","perkara/urusan","amrin",66],["حَكِيمٍ","hikmah/bijaksana","ḥakīmin",112]],"t":"Pada (malam itu) dijelaskan segala urusan yang penuh hikmah,"},{"n":5,"w":[["أَمْرًۭا","perintah/urusan","amran",66],["مِّنْ","dari","min",0],["عِندِنَآ ۚ","sisi Kami","ʿindinā",59],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",9],["مُرْسِلِينَ","yang mengutus","mur'silīna",1598]],"t":"(yaitu) urusan dari sisi Kami. Sungguh, Kamilah yang mengutus rasul-rasul,"},{"n":6,"w":[["رَحْمَةًۭ","rahmat","raḥmatan",102],["مِّن","dari","min",0],["رَّبِّكَ ۚ","Tuhanmu","rabbika",10],["إِنَّهُۥ","sesungguhnya","innahu",5],["هُوَ","Dia","huwa",20],["ٱلسَّمِيعُ","Maha Mendengar","l-samīʿu",253],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"sebagai rahmat dari Tuhanmu. Sungguh, Dia Maha Mendengar, Maha Mengetahui,"},{"n":7,"w":[["رَبِّ","Tuhan","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَآ ۖ","yang ada di antara keduanya","baynahumā",47],["إِن","jika","in",14],["كُنتُم","kalian adalah","kuntum",9],["مُّوقِنِينَ","orang yang meyakini","mūqinīna",1380]],"t":"Tuhan (yang memelihara) langit dan bumi dan apa yang ada di antara keduanya; jika kamu orang-orang yang meyakini."},{"n":8,"w":[["لَآ","tidak ada","lā",4],["إِلَـٰهَ","Tuhan","ilāha",74],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",20],["يُحْىِۦ","Dia menghidupkan","yuḥ'yī",231],["وَيُمِيتُ ۖ","dan Dia mematikan","wayumītu",486],["رَبُّكُمْ","Tuhan kalian","rabbukum",10],["وَرَبُّ","dan Tuhan","warabbu",10],["ءَابَآئِكُمُ","bapak-bapak kamu","ābāikumu",189],["ٱلْأَوَّلِينَ","terdahulu","l-awalīna",136]],"t":"Tidak ada tuhan selain Dia, Dia yang menghidupkan dan mematikan. (Dialah) Tuhanmu dan Tuhan nenek moyangmu dahulu."},{"n":9,"w":[["بَلْ","tetapi","bal",93],["هُمْ","mereka","hum",11],["فِى","dalam","fī",3],["شَكٍّۢ","keragu-raguan","shakkin",614],["يَلْعَبُونَ","mereka bermain-main","yalʿabūna",939]],"t":"Tetapi mereka dalam keraguan, mereka bermain-main."},{"n":10,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1701],["يَوْمَ","hari","yawma",25],["تَأْتِى","datang/membawa","tatī",48],["ٱلسَّمَآءُ","langit","l-samāu",38],["بِدُخَانٍۢ","dengan asap/kabut","bidukhānin",2364],["مُّبِينٍۢ","nyata","mubīnin",99]],"t":"Maka tunggulah pada hari ketika langit membawa kabut yang tampak jelas,"},{"n":11,"w":[["يَغْشَى","menutupi","yaghshā",688],["ٱلنَّاسَ ۖ","manusia","l-nāsa",52],["هَـٰذَا","ini","hādhā",37],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","yang pedih","alīmun",162]],"t":"yang meliputi manusia. Inilah azab yang pedih."},{"n":12,"w":[["رَّبَّنَا","ya Tuhan kami","rabbanā",10],["ٱكْشِفْ","hilangkanlah","ik'shif",665],["عَنَّا","dari kami","ʿannā",21],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["إِنَّا","sesungguhnya kami","innā",5],["مُؤْمِنُونَ","orang-orang yang beriman","mu'minūna",56]],"t":"(Mereka berdoa), \"Ya Tuhan kami, lenyapkanlah azab itu dari kami. Sungguh, kami akan beriman.\""},{"n":13,"w":[["أَنَّىٰ","bagaimana","annā",385],["لَهُمُ","bagi mereka","lahumu",11],["ٱلذِّكْرَىٰ","peringatan","l-dhik'rā",449],["وَقَدْ","dan sungguh","waqad",24],["جَآءَهُمْ","telah datang kepada mereka","jāahum",43],["رَسُولٌۭ","seorang rasul","rasūlun",35],["مُّبِينٌۭ","nyata/jelas","mubīnun",99]],"t":"Bagaimana mereka dapat menerima peringatan, padahal (sebelumnya pun) seorang Rasul telah datang memberi penjelasan kepada mereka,"},{"n":14,"w":[["ثُمَّ","kemudian","thumma",34],["تَوَلَّوْا۟","mereka berpaling","tawallaw",144],["عَنْهُ","dari padanya","ʿanhu",21],["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مُعَلَّمٌۭ","seorang yang diajar","muʿallamun",3777],["مَّجْنُونٌ","seorang gila","majnūnun",792]],"t":"kemudian mereka berpaling darinya dan berkata, \"Dia itu orang yang menerima ajaran (dari orang lain) dan orang gila.\""},{"n":15,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["كَاشِفُوا۟","menghilangkan","kāshifū",1867],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["قَلِيلًا ۚ","sedikit","qalīlan",173],["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["عَآئِدُونَ","orang-orang yang kembali","ʿāidūna",3097]],"t":"Sungguh, (kalau) Kami melenyapkan azab itu sedikit saja, tentu kamu akan kembali (ingkar)."},{"n":16,"w":[["يَوْمَ","pada hari","yawma",25],["نَبْطِشُ","Kami menghantam/menyerang","nabṭishu",1325],["ٱلْبَطْشَةَ","hantaman/serangan","l-baṭshata",2334],["ٱلْكُبْرَىٰٓ","yang keras","l-kub'rā",1088],["إِنَّا","sesungguhnya Kami","innā",5],["مُنتَقِمُونَ","pemberi siksaan","muntaqimūna",1917]],"t":"(Ingatlah) pada hari (ketika) Kami menghantam mereka dengan keras. Kami pasti memberi balasan."},{"n":17,"w":[["۞ وَلَقَدْ","dan sesungguhnya","walaqad",24],["فَتَنَّا","Kami telah menguji","fatannā",455],["قَبْلَهُمْ","sebelum mereka","qablahum",51],["قَوْمَ","kaum","qawma",27],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",156],["وَجَآءَهُمْ","dan telah datang kepada mereka","wajāahum",43],["رَسُولٌۭ","seorang rasul","rasūlun",35],["كَرِيمٌ","yang mulia","karīmun",364]],"t":"Dan sungguh, sebelum mereka, Kami benar-benar telah menguji kaum Fir'aun dan telah datang kepada mereka seorang Rasul yang mulia,"},{"n":18,"w":[["أَنْ","hendaklah","an",16],["أَدُّوٓا۟","serahkan","addū",1441],["إِلَىَّ","kepadaku","ilayya",13],["عِبَادَ","hamba-hamba","ʿibāda",87],["ٱللَّهِ ۖ","Allah","l-lahi",1],["إِنِّى","sesungguhnya aku","innī",5],["لَكُمْ","bagi kalian","lakum",26],["رَسُولٌ","seorang rasul","rasūlun",35],["أَمِينٌۭ","terpercaya","amīnun",651]],"t":"(dengan berkata), \"Serahkanlah kepadaku hamba-hamba Allah (Bani Israil). Sesungguhnya aku adalah utusan (Allah) yang dapat kamu percaya,"},{"n":19,"w":[["وَأَن","dan sesungguhnya","wa-an",16],["لَّا","janganlah","lā",4],["تَعْلُوا۟","kamu menyombongkan diri","taʿlū",521],["عَلَى","terhadap","ʿalā",8],["ٱللَّهِ ۖ","Allah","l-lahi",1],["إِنِّىٓ","sesungguhnya aku","innī",5],["ءَاتِيكُم","aku datang kepadamu","ātīkum",48],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/bukti","bisul'ṭānin",321],["مُّبِينٍۢ","nyata","mubīnin",99]],"t":"dan jangalah kamu menyombongkan diri terhadap Allah. Sungguh, aku datang kepadamu dengan membawa bukti yang nyata."},{"n":20,"w":[["وَإِنِّى","dan sesungguhnya aku","wa-innī",5],["عُذْتُ","aku berlindung","ʿudh'tu",824],["بِرَبِّى","kepada Tuhanku","birabbī",10],["وَرَبِّكُمْ","dan Tuhanmu","warabbikum",10],["أَن","bahwa","an",16],["تَرْجُمُونِ","kamu akan merajamku","tarjumūni",1395]],"t":"Dan sesungguhnya aku berlindung kepada Tuhanku dan Tuhanmu, dari ancamanmu untuk merajamku,"},{"n":21,"w":[["وَإِن","dan jika","wa-in",14],["لَّمْ","tidak","lam",32],["تُؤْمِنُوا۟","kamu beriman","tu'minū",18],["لِى","kepadaku","lī",179],["فَٱعْتَزِلُونِ","maka tinggalkanlah aku","fa-iʿ'tazilūni",1128]],"t":"dan jika kamu tidak beriman kepadaku, maka biarkanlah aku (memimpin Bani Israil).\""},{"n":22,"w":[["فَدَعَا","maka dia berdo'a","fadaʿā",65],["رَبَّهُۥٓ","Tuhannya","rabbahu",10],["أَنَّ","bahwasanya","anna",30],["هَـٰٓؤُلَآءِ","mereka ini","hāulāi",37],["قَوْمٌۭ","kaum","qawmun",27],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",229]],"t":"Kemudian dia (Musa) berdoa kepada Tuhannya, \"Sungguh, mereka ini adalah kaum yang berdosa (segerakanlah azab kepada mereka).\""},{"n":23,"w":[["فَأَسْرِ","maka berjalanlah kamu","fa-asri",1144],["بِعِبَادِى","dengan hamba-hamba-Ku","biʿibādī",87],["لَيْلًا","pada malam hari","laylan",131],["إِنَّكُم","sesungguhnya kalian","innakum",5],["مُّتَّبَعُونَ","orang-orang yang diikuti/di kejar","muttabaʿūna",2550]],"t":"(Allah berfirman), \"Karena itu berjalanlah dengan hamba-hamba-Ku pada malam hari, sesungguhnya kamu akan dikejar,"},{"n":24,"w":[["وَٱتْرُكِ","dan tinggalkan/biarkan","wa-ut'ruki",292],["ٱلْبَحْرَ","laut","l-baḥra",284],["رَهْوًا ۖ","tenang","rahwan",4189],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["جُندٌۭ","bala tentara","jundun",375],["مُّغْرَقُونَ","orang-orang yang ditenggelamkan","mugh'raqūna",1608]],"t":"dan biarkanlah laut itu terbelah. Sesungguhnya mereka bala tentara yang akan ditenggelamkan.\""},{"n":25,"w":[["كَمْ","berapa banyak","kam",490],["تَرَكُوا۟","mereka tinggalkan","tarakū",292],["مِن","dari","min",0],["جَنَّـٰتٍۢ","taman-taman","jannātin",76],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",208]],"t":"Betapa banyak taman-taman dan mata air-mata air yang mereka tinggalkan,"},{"n":26,"w":[["وَزُرُوعٍۢ","dan tanaman-tanaman","wazurūʿin",870],["وَمَقَامٍۢ","dan tempat-tempat","wamaqāmin",672],["كَرِيمٍۢ","mulia/indah","karīmin",364]],"t":"juga kebun-kebun serta tempat-tempat kediaman yang indah,"},{"n":27,"w":[["وَنَعْمَةٍۢ","dan kenikmatan","wanaʿmatin",2575],["كَانُوا۟","adalah mereka","kānū",9],["فِيهَا","di dalamnya","fīhā",3],["فَـٰكِهِينَ","bersenang-senang","fākihīna",1832]],"t":"dan kesenangan-kesenangan yang dapat mereka nikmati di sana,"},{"n":28,"w":[["كَذَٰلِكَ ۖ","seperti demikian","kadhālika",19],["وَأَوْرَثْنَـٰهَا","Kami wariskannya","wa-awrathnāhā",718],["قَوْمًا","kaum","qawman",27],["ءَاخَرِينَ","yang lain","ākharīna",170]],"t":"demikianlah, dan Kami wariskan (semua) itu kepada kaum yang lain."},{"n":29,"w":[["فَمَا","maka tidaklah","famā",2],["بَكَتْ","menangis","bakat",1327],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلسَّمَآءُ","langit","l-samāu",38],["وَٱلْأَرْضُ","dan bumi","wal-arḍu",22],["وَمَا","dan tidak ada","wamā",2],["كَانُوا۟","mereka","kānū",9],["مُنظَرِينَ","orang-orang yang diberi tangguh","munẓarīna",1208]],"t":"Maka langit dan bumi tidak menangisi mereka dan mereka pun tidak diberi penangguhan waktu."},{"n":30,"w":[["وَلَقَدْ","dan sesungguhya","walaqad",24],["نَجَّيْنَا","Kami telah menyelamatkan","najjaynā",320],["بَنِىٓ","Bani","banī",140],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",271],["مِنَ","dari","mina",0],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["ٱلْمُهِينِ","yang hina","l-muhīni",673]],"t":"Dan sungguh, telah Kami selamatkan Bani Israil dari siksaan yang menghinakan,"},{"n":31,"w":[["مِن","dari","min",0],["فِرْعَوْنَ ۚ","Fir'aun","fir'ʿawna",156],["إِنَّهُۥ","sesungguhnya","innahu",5],["كَانَ","adalah","kāna",9],["عَالِيًۭا","tinggi/sombong","ʿāliyan",1500],["مِّنَ","dari/termasuk","mina",0],["ٱلْمُسْرِفِينَ","orang-orang yang melampaui batas","l-mus'rifīna",637]],"t":"dari (siksaan) Fir'aun, sungguh, dia itu orang yang sombong, termasuk orang-orang yang melampaui batas."},{"n":32,"w":[["وَلَقَدِ","dan sesungguhnya","walaqadi",24],["ٱخْتَرْنَـٰهُمْ","Kami telah memilih mereka","ikh'tarnāhum",1708],["عَلَىٰ","dengan","ʿalā",8],["عِلْمٍ","pengetahuan","ʿil'min",108],["عَلَى","di atas","ʿalā",8],["ٱلْعَـٰلَمِينَ","alam semesta","l-ʿālamīna",158]],"t":"Dan sungguh, Kami pilih mereka (Bani Israil) dengan ilmu (Kami) di atas semua bangsa (pada masa itu)."},{"n":33,"w":[["وَءَاتَيْنَـٰهُم","dan Kami telah berikan kepada mereka","waātaynāhum",45],["مِّنَ","dari","mina",0],["ٱلْـَٔايَـٰتِ","tanda-tanda","l-āyāti",28],["مَا","apa yang","mā",2],["فِيهِ","di dalamnya","fīhi",3],["بَلَـٰٓؤٌۭا۟","percobaan/ujian","balāon",1174],["مُّبِينٌ","nyata","mubīnun",99]],"t":"Dan telah Kami berikan kepada mereka di antara tanda-tanda (kebesaran Kami) sesuatu yang di dalamnya terdapat nikmat yang nyata."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["لَيَقُولُونَ","benar-benar mereka berkata","layaqūlūna",6]],"t":"Sesungguhnya mereka (kaum musyrik) itu pasti akan berkata,"},{"n":35,"w":[["إِنْ","bahwa","in",14],["هِىَ","ia","hiya",190],["إِلَّا","kecuali","illā",15],["مَوْتَتُنَا","kematian kami","mawtatunā",1898],["ٱلْأُولَىٰ","pertama","l-ūlā",136],["وَمَا","dan tidaklah","wamā",2],["نَحْنُ","kami","naḥnu",125],["بِمُنشَرِينَ","orang-orang yang di bangkitkan","bimunsharīna",3839]],"t":"\"Tidak ada kematian selain kematian di dunia ini. Dan kami tidak akan dibangkitkan,"},{"n":36,"w":[["فَأْتُوا۟","maka datanglah","fatū",48],["بِـَٔابَآئِنَآ","dengan bapak-bapak kami","biābāinā",189],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",202]],"t":"maka hadirkanlah (kembali) nenek moyang kami jika kamu orang yang benar.\""},{"n":37,"w":[["أَهُمْ","apakah mereka","ahum",11],["خَيْرٌ","lebih baik","khayrun",62],["أَمْ","atau","am",82],["قَوْمُ","kaum","qawmu",27],["تُبَّعٍۢ","Tubba'","tubbaʿin",2700],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["مِن","dari","min",0],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",51],["أَهْلَكْنَـٰهُمْ ۖ","Kami telah membinasakan mereka","ahlaknāhum",232],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["مُجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",229]],"t":"Apakah mereka (kaum musyrikin) yang lebih baik atau kaum Tubba', dan orang-orang sebelum mereka yang telah Kami binasakan karena mereka adalah orang-orang yang sungguh berdosa."},{"n":38,"w":[["وَمَا","dan tidak","wamā",2],["خَلَقْنَا","Kami menciptakan/menjadikan","khalaqnā",60],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["لَـٰعِبِينَ","bermain-main","lāʿibīna",1875]],"t":"Dan tidaklah Kami bermain-main menciptakan langit dan bumi dan apa yang ada di antara keduanya."},{"n":39,"w":[["مَا","tidak","mā",2],["خَلَقْنَـٰهُمَآ","Kami menjadikan keduanya","khalaqnāhumā",60],["إِلَّا","kecuali","illā",15],["بِٱلْحَقِّ","dengan hak","bil-ḥaqi",50],["وَلَـٰكِنَّ","tetapi","walākinna",210],["أَكْثَرَهُمْ","kebanyakan mereka","aktharahum",139],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Tidaklah Kami ciptakan keduanya melainkan dengan hak (benar), tetapi kebanyakan mereka tidak mengetahui."},{"n":40,"w":[["إِنَّ","sesungguhnya","inna",5],["يَوْمَ","hari","yawma",25],["ٱلْفَصْلِ","keputusan","l-faṣli",901],["مِيقَـٰتُهُمْ","waktu mereka","mīqātuhum",989],["أَجْمَعِينَ","semuanya","ajmaʿīna",412]],"t":"Sungguh, hari keputusan (hari Kiamat) adalah waktu yang dijanjikan bagi mereka semuanya,"},{"n":41,"w":[["يَوْمَ","hari","yawma",25],["لَا","tidak","lā",4],["يُغْنِى","berguna","yugh'nī",384],["مَوْلًى","kawan karib","mawlan",553],["عَن","dari","ʿan",21],["مَّوْلًۭى","kawan karib","mawlan",553],["شَيْـًۭٔا","sesuatu/sedikit","shayan",41],["وَلَا","dan tidaklah","walā",4],["هُمْ","mereka","hum",11],["يُنصَرُونَ","mereka mendapat pertolongan","yunṣarūna",203]],"t":"(yaitu) pada hari (ketika) seorang teman sama sekali tidak dapat memberi manfaat kepada teman lainnya, dan mereka tidak akan mendapat pertolongan,"},{"n":42,"w":[["إِلَّا","kecuali","illā",15],["مَن","orang","man",12],["رَّحِمَ","merahmati","raḥima",393],["ٱللَّهُ ۚ","Allah","l-lahu",1],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",110],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",100]],"t":"kecuali orang yang diberi rahmat oleh Allah. Sungguh, Dia Mahaperkasa, Maha Penyayang."},{"n":43,"w":[["إِنَّ","sesungguhnya","inna",5],["شَجَرَتَ","pohon","shajarata",522],["ٱلزَّقُّومِ","zaqqum","l-zaqūmi",2100]],"t":"Sungguh pohon zaqqūm itu,"},{"n":44,"w":[["طَعَامُ","makanan","ṭaʿāmu",440],["ٱلْأَثِيمِ","orang yang berdosa","l-athīmi",1044]],"t":"makanan bagi orang yang banyak dosa."},{"n":45,"w":[["كَٱلْمُهْلِ","seperti minyak","kal-muh'li",1913],["يَغْلِى","ia mendidih","yaghlī",4651],["فِى","di dalam","fī",3],["ٱلْبُطُونِ","perut","l-buṭūni",571]],"t":"Seperti cairan tembaga yang mendidih di dalam perut,"},{"n":46,"w":[["كَغَلْىِ","seperti mendidihnya","kaghalyi",3478],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",508]],"t":"seperti mendidihnya air yang sangat panas."},{"n":47,"w":[["خُذُوهُ","tangkaplah dia","khudhūhu",92],["فَٱعْتِلُوهُ","lalu seretlah dia","fa-iʿ'tilūhu",4804],["إِلَىٰ","sampai","ilā",13],["سَوَآءِ","ke tengah-tengah","sawāi",409],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",414]],"t":"\"Peganglah dia, kemudian seretlah dia sampai ke tengah-tengah neraka,"},{"n":48,"w":[["ثُمَّ","kemudian","thumma",34],["صُبُّوا۟","tuangkanlah","ṣubbū",1524],["فَوْقَ","di atas","fawqa",285],["رَأْسِهِۦ","kepalanya","rasihi",557],["مِنْ","dari","min",0],["عَذَابِ","azab","ʿadhābi",36],["ٱلْحَمِيمِ","air yang sangat panas","l-ḥamīmi",508]],"t":"kemudian tuangkanlah di atas kepalanya azab (dari) air yang sangat panas.\""},{"n":49,"w":[["ذُقْ","rasakanlah","dhuq",323],["إِنَّكَ","sesungguhnya kamu","innaka",5],["أَنتَ","kamu","anta",138],["ٱلْعَزِيزُ","seorang perkasa","l-ʿazīzu",110],["ٱلْكَرِيمُ","seorang mulia","l-karīmu",364]],"t":"\"Rasakanlah, sesungguhnya engkau benar-benar orang yang perkasa lagi mulia (di tengah kaummu).\""},{"n":50,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["مَا","apa (azab)","mā",2],["كُنتُم","kalian adalah","kuntum",9],["بِهِۦ","padanya","bihi",17],["تَمْتَرُونَ","kamu meragukan","tamtarūna",1438]],"t":"Sungguh, inilah azab yang dahulu kamu ragukan."},{"n":51,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",245],["فِى","dalam","fī",3],["مَقَامٍ","tempat","maqāmin",672],["أَمِينٍۢ","aman","amīnin",651]],"t":"Sungguh, orang-orang yang bertakwa berada dalam tempat yang aman,"},{"n":52,"w":[["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","taman-taman","jannātin",76],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",208]],"t":"(yaitu) di dalam taman-taman dan mata air-mata air;"},{"n":53,"w":[["يَلْبَسُونَ","mereka memakai","yalbasūna",790],["مِن","dari","min",0],["سُندُسٍۢ","kain sutera halus","sundusin",2001],["وَإِسْتَبْرَقٍۢ","dan sutera tebal","wa-is'tabraqin",1464],["مُّتَقَـٰبِلِينَ","mereka berhadap-hadapan","mutaqābilīna",1612]],"t":"mereka memakai sutera yang halus dan sutera yang tebal, (duduk) berhadapan,"},{"n":54,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",19],["وَزَوَّجْنَـٰهُم","Kami jodohkan mereka","wazawwajnāhum",1444],["بِحُورٍ","dengan jelita/bidadari","biḥūrin",1521],["عِينٍۢ","matanya","ʿīnin",1510]],"t":"demikianlah, kemudian Kami berikan kepada mereka pasangan bidadari yang bermata indah."},{"n":55,"w":[["يَدْعُونَ","mereka meminta","yadʿūna",65],["فِيهَا","di dalamnya","fīhā",3],["بِكُلِّ","dengan segala macam","bikulli",31],["فَـٰكِهَةٍ","buah-buahan","fākihatin",783],["ءَامِنِينَ","dengan aman","āminīna",814]],"t":"Di dalamnya mereka dapat meminta segala macam buah-buahan dengan aman dan tenteram,"},{"n":56,"w":[["لَا","tidak","lā",4],["يَذُوقُونَ","mereka merasakan","yadhūqūna",323],["فِيهَا","di dalamnya","fīhā",3],["ٱلْمَوْتَ","mati","l-mawta",237],["إِلَّا","kecuali","illā",15],["ٱلْمَوْتَةَ","kematian","l-mawtata",1898],["ٱلْأُولَىٰ ۖ","pertama","l-ūlā",136],["وَوَقَىٰهُمْ","dan Dia memelihara mereka","wawaqāhum",609],["عَذَابَ","azab","ʿadhāba",36],["ٱلْجَحِيمِ","neraka jahim","l-jaḥīmi",414]],"t":"mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka,"},{"n":57,"w":[["فَضْلًۭا","karunia","faḍlan",130],["مِّن","dari","min",0],["رَّبِّكَ ۚ","Tuhanmu","rabbika",10],["ذَٰلِكَ","demikian itu","dhālika",19],["هُوَ","ia/itu","huwa",20],["ٱلْفَوْزُ","keuntungan","l-fawzu",527],["ٱلْعَظِيمُ","yang besar","l-ʿaẓīmu",97]],"t":"itu merupakan karunia dari Tuhanmu. Demikian itulah kemenangan yang agung."},{"n":58,"w":[["فَإِنَّمَا","maka sesungguhnya","fa-innamā",5],["يَسَّرْنَـٰهُ","Kami mudahkannya","yassarnāhu",811],["بِلِسَانِكَ","dengan lisan/bahasamu","bilisānika",429],["لَعَلَّهُمْ","supaya mereka","laʿallahum",95],["يَتَذَكَّرُونَ","mereka mendapat pelajaran","yatadhakkarūna",234]],"t":"Sungguh, Kami mudahkan Alquran itu dengan bahasamu agar mereka mendapat pelajaran."},{"n":59,"w":[["فَٱرْتَقِبْ","maka tunggulah","fa-ir'taqib",1701],["إِنَّهُم","sesungguhnya mereka","innahum",5],["مُّرْتَقِبُونَ","orang-orang yang menunggu","mur'taqibūna",4006]],"t":"Maka tunggulah; sungguh, mereka itu (juga sedang) menunggu."}]