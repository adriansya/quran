in",14],["نَّفَعَتِ","berguna","nafaʿati",359],["ٱلذِّكْرَىٰ","peringatan","l-dhik'rā",449]],"t":"oleh sebab itu berikanlah peringatan, karena peringatan itu bermanfaat,"},{"n":10,"w":[["سَيَذَّكَّرُ","akan menerima peringatan","sayadhakkaru",234],["مَن","orang yang","man",12],["يَخْشَىٰ","ia takut","yakhshā",295]],"t":"orang yang takut (kepada Allah) akan mendapat pelajaran,"},{"n":11,"w":[["وَيَتَجَنَّبُهَا","dan akan menjauhi","wayatajannabuhā",4697],["ٱلْأَشْقَى","orang yang celaka","l-ashqā",1723]],"t":"dan orang yang celaka (kafir) akan menjauhinya,"},{"n":12,"w":[["ٱلَّذِى","yang","alladhī",7],["يَصْلَى","ia akan masuk","yaṣlā",706],["ٱلنَّارَ","api/neraka","l-nāra",77],["ٱلْكُبْرَىٰ","yang besar","l-kub'rā",1088]],"t":"(yaitu) orang yang akan memasuki api yang besar (neraka),"},{"n":13,"w":[["ثُمَّ","kemudian","thumma",34],["لَا","tidak","lā",4],["يَمُوتُ","ia mati","yamūtu",305],["فِيهَا","di dalamnya","fīhā",3],["وَلَا","dan tidak","walā",4],["يَحْيَىٰ","ia hidup","yaḥyā",1055]],"t":"selanjutnya dia di sana tidak mati dan tidak (pula) hidup."},{"n":14,"w":[["قَدْ","sungguh","qad",24],["أَفْلَحَ","beruntung","aflaḥa",396],["مَن","siapa/orang","man",12],["تَزَكَّىٰ","dia membersihkan diri","tazakkā",1007]],"t":"Sungguh beruntung orang yang menyucikan diri (dengan beriman),"},{"n":15,"w":[["وَذَكَرَ","dan dia mengingat","wadhakara",129],["ٱسْمَ","nama","is'ma",306],["رَبِّهِۦ","Tuhannya","rabbihi",10],["فَصَلَّىٰ","dan dia mendirikan sholat","faṣallā",726]],"t":"dan mengingat nama Tuhannya, lalu dia salat."},{"n":16,"w":[["بَلْ","bahkan/tetapi","bal",93],["تُؤْثِرُونَ","kamu memilih","tu'thirūna",1291],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",148],["ٱلدُّنْيَا","dunia","l-dun'yā",101]],"t":"Sedangkan kamu (orang-orang kafir) memilih kehidupan dunia,"},{"n":17,"w":[["وَٱلْـَٔاخِرَةُ","dan akherat","wal-ākhiratu",72],["خَيْرٌۭ","lebih baik","khayrun",62],["وَأَبْقَىٰٓ","dan lebih kekal","wa-abqā",1039]],"t":"padahal kehidupan akhirat itu lebih baik dan lebih kekal