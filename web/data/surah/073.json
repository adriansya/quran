[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلْمُزَّمِّلُ","orang yang berselimut","l-muzamilu",3917]],"t":"Wahai orang yang berselimut (Muhammad)!"},{"n":2,"w":[["قُمِ","bangunlah","qumi",364],["ٱلَّيْلَ","malam hari","al-layla",146],["إِلَّا","kecuali","illā",20],["قَلِيلًۭا","sedikit","qalīlan",186]],"t":"bangunlah (untuk salat) pada malam hari, kecuali sebagian kecil."},{"n":3,"w":[["نِّصْفَهُۥٓ","seperduanya","niṣ'fahu",1108],["أَوِ","atau","awi",50],["ٱنقُصْ","kurang","unquṣ",1107],["مِنْهُ","daripada","min'hu",1],["قَلِيلًا","sedikit","qalīlan",186]],"t":"(yaitu) separuhnya atau kurang sedikit dari itu,"},{"n":4,"w":[["أَوْ","atau","aw",50],["زِدْ","lebih","zid",259],["عَلَيْهِ","atasnya","ʿalayhi",11],["وَرَتِّلِ","dan bacalah","warattili",2631],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",189],["تَرْتِيلًا","perlahan-lahan","tartīlan",2706]],"t":"atau lebih dari (seperdua) itu, dan bacalah Alquran itu dengan perlahan-lahan."},{"n":5,"w":[["إِنَّا","sesungguhnya","innā",9],["سَنُلْقِى","Kami akan menurunkan","sanul'qī",183],["عَلَيْكَ","atasmu/kepadamu","ʿalayka",11],["قَوْلًۭا","perkataan","qawlan",129],["ثَقِيلًا","berat","thaqīlan",1438]],"t":"Sesungguhnya Kami akan menurunkan perkataan yang berat kepadamu."},{"n":6,"w":[["إِنَّ","sesungguhnya","inna",9],["نَاشِئَةَ","bangun","nāshi-ata",4014],["ٱلَّيْلِ","malam","al-layli",146],["هِىَ","ia/adalah","hiya",203],["أَشَدُّ","sangat/lebih","ashaddu",376],["وَطْـًۭٔا","kuat","waṭan",4473],["وَأَقْوَمُ","dan lebih teguh/terkesan","wa-aqwamu",1500],["قِيلًا","ucapan/bacaan","qīlan",1653]],"t":"Sungguh, bangun malam itu lebih kuat (mengisi jiwa); dan (bacaan di waktu itu) lebih berkesan."},{"n":7,"w":[["إِنَّ","sesungguhnya","inna",9],["لَكَ","bagimu","laka",153],["فِى","pada","fī",7],["ٱلنَّهَارِ","siang hari","l-nahāri",221],["سَبْحًۭا","pekerjaan/urusan","sabḥan",2649],["طَوِيلًۭا","panjang/banyak","ṭawīlan",2317]],"t":"Sesungguhnya pada siang hari engkau sangat sibuk dengan urusan-urusan yang panjang."},{"n":8,"w":[["وَٱذْكُرِ","dan sebutlah","wa-udh'kuri",144],["ٱسْمَ","nama","is'ma",324],["رَبِّكَ","Tuhanmu","rabbika",15],["وَتَبَتَّلْ","dan beribadatlah","watabattal",4345],["إِلَيْهِ","kepada-Nya","ilayhi",18],["تَبْتِيلًۭا","sungguh-sungguh beribadat","tabtīlan",4349]],"t":"Dan sebutlah nama Tuhanmu, dan beribadahlah kepada-Nya dengan sepenuh hati."},{"n":9,"w":[["رَّبُّ","Tuhan/pemelihara","rabbu",15],["ٱلْمَشْرِقِ","timur","l-mashriqi",800],["وَٱلْمَغْرِبِ","dan barat","wal-maghribi",857],["لَآ","tidak ada","lā",8],["إِلَـٰهَ","tuhan","ilāha",84],["إِلَّا","kecuali","illā",20],["هُوَ","Dia","huwa",25],["فَٱتَّخِذْهُ","maka ambillah/jadikan Dia","fa-ittakhidh'hu",107],["وَكِيلًۭا","pelindung","wakīlan",456]],"t":"(Dialah) Tuhan timur dan barat, tidak ada tuhan selain Dia, maka jadikanlah Dia sebagai pelindung."},{"n":10,"w":[["وَٱصْبِرْ","dan bersabarlah","wa-iṣ'bir",215],["عَلَىٰ","atas","ʿalā",11],["مَا","apa","mā",6],["يَقُولُونَ","mereka katakan","yaqūlūna",10],["وَٱهْجُرْهُمْ","dan pindahlah/jauhilah mereka","wa-uh'jur'hum",1361],["هَجْرًۭا","pindah","hajran",3527],["جَمِيلًۭا","yang baik","jamīlan",1090]],"t":"Dan bersabarlah (Muhammad) terhadap apa yang mereka katakan dan tinggalkanlah mereka dengan cara yang baik."},{"n":11,"w":[["وَذَرْنِى","dan biarkan Aku","wadharnī",276],["وَٱلْمُكَذِّبِينَ","dan orang-orang yang mendustakan","wal-mukadhibīna",503],["أُو۟لِى","mempunyai","ulī",272],["ٱلنَّعْمَةِ","kenikmatan/kemewahan","l-naʿmati",2589],["وَمَهِّلْهُمْ","dan beri tempo mereka","wamahhil'hum",2474],["قَلِيلًا","sedikit/sebentar","qalīlan",186]],"t":"Dan biarkanlah Aku (yang bertindak) terhadap orang-orang yang mendustakan, yang memiliki segala kenikmatan hidup, dan berilah mereka penangguhan sebentar."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",9],["لَدَيْنَآ","pada sisi Kami","ladaynā",479],["أَنكَالًۭا","belenggu-belenggu","ankālan",4063],["وَجَحِيمًۭا","dan api yang menyala-nyala","wajaḥīman",426]],"t":"Sungguh, di sisi Kami ada belenggu-belenggu (yang berat) dan neraka yang menyala-nyala,"},{"n":13,"w":[["وَطَعَامًۭا","dan makanan","waṭaʿāman",452],["ذَا","menyumbat/memiliki","dhā",112],["غُصَّةٍۢ","kerongkongan","ghuṣṣatin",3509],["وَعَذَابًا","dan siksa/azab","waʿadhāban",43],["أَلِيمًۭا","pedih","alīman",178]],"t":"dan (ada) makanan yang menyumbat di kerongkongan dan azab yang pedih."},{"n":14,"w":[["يَوْمَ","hari","yawma",31],["تَرْجُفُ","bergoncang","tarjufu",2628],["ٱلْأَرْضُ","bumi","l-arḍu",28],["وَٱلْجِبَالُ","dan gunung-gunung","wal-jibālu",320],["وَكَانَتِ","dan adalah/jadilah","wakānati",12],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",320],["كَثِيبًۭا","tumpukan pasir","kathīban",3615],["مَّهِيلًا","licin/bertaburan","mahīlan",3930]],"t":"(Ingatlah) pada hari (ketika) bumi dan gunung-gunung berguncang keras, dan menjadilah gunung-gunung itu seperti onggokan pasir yang dicurahkan."},{"n":15,"w":[["إِنَّآ","sesungguhnya","innā",9],["أَرْسَلْنَآ","Kami telah mengutus","arsalnā",100],["إِلَيْكُمْ","kepadamu","ilaykum",18],["رَسُولًۭا","seorang rasul","rasūlan",42],["شَـٰهِدًا","menjadi saksi","shāhidan",491],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["كَمَآ","sebagaimana","kamā",6],["أَرْسَلْنَآ","Kami telah mengutus","arsalnā",100],["إِلَىٰ","kepada","ilā",18],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["رَسُولًۭا","seorang rasul","rasūlan",42]],"t":"Sesungguhnya Kami telah mengutus seorang Rasul (Muhammad) kepada kamu, yang menjadi saksi terhadapmu, sebagaimana Kami telah mengutus seorang Rasul kepada Fir'aun."},{"n":16,"w":[["فَعَصَىٰ","maka mendurhakai","faʿaṣā",411],["فِرْعَوْنُ","Fir'aun","fir'ʿawnu",171],["ٱلرَّسُولَ","rasul itu","l-rasūla",42],["فَأَخَذْنَـٰهُ","lalu Kami siksa dia","fa-akhadhnāhu",103],["أَخْذًۭا","siksaan","akhdhan",1154],["وَبِيلًۭا","yang berat","wabīlan",4477]],"t":"Namun Fir'aun mendurhakai Rasul itu, maka Kami siksa dia dengan siksaan yang berat."},{"n":17,"w":[["فَكَيْفَ","maka bagaimana","fakayfa",148],["تَتَّقُونَ","kamu bertakwa/memelihara diri","tattaqūna",76],["إِن","jika","in",19],["كَفَرْتُمْ","kamu kafir/ingkar","kafartum",48],["يَوْمًۭا","hari","yawman",31],["يَجْعَلُ","menjadikan","yajʿalu",40],["ٱلْوِلْدَٰنَ","anak-anak muda","l-wil'dāna",1127],["شِيبًا","beruban","shīban",2922]],"t":"Lalu bagaimanakah kamu akan dapat menjaga dirimu jika kamu tetap kafir kepada hari yang menjadikan anak-anak beruban."},{"n":18,"w":[["ٱلسَّمَآءُ","langit","al-samāu",44],["مُنفَطِرٌۢ","terbelah","munfaṭirun",3851],["بِهِۦ ۚ","karenanya/hari itu","bihi",21],["كَانَ","adalah","kāna",12],["وَعْدُهُۥ","janji-Nya","waʿduhu",258],["مَفْعُولًا","terlaksana","mafʿūlan",1098]],"t":"Langit terbelah pada hari itu. Janji Allah pasti terlaksana."},{"n":19,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰذِهِۦ","ini","hādhihi",265],["تَذْكِرَةٌۭ ۖ","peringatan","tadhkiratun",948],["فَمَن","maka barang siapa","faman",17],["شَآءَ","menghendaki","shāa",62],["ٱتَّخَذَ","ia mengambil","ittakhadha",107],["إِلَىٰ","kepada","ilā",18],["رَبِّهِۦ","Tuhannya","rabbihi",15],["سَبِيلًا","jalan","sabīlan",73]],"t":"Sungguh, ini adalah peringatan. Barangsiapa menghendaki, niscaya dia mengambil jalan (yang lurus) kepada Tuhannya."},{"n":20,"w":[["۞ إِنَّ","sesungguhnya","inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["يَعْلَمُ","mengetahui","yaʿlamu",35],["أَنَّكَ","bahwa kamu","annaka",36],["تَقُومُ","kamu berdiri","taqūmu",364],["أَدْنَىٰ","kurang","adnā",726],["مِن","dari","min",1],["ثُلُثَىِ","dua pertiga","thuluthayi",1254],["ٱلَّيْلِ","malam","al-layli",146],["وَنِصْفَهُۥ","dan/atau separuhnya","waniṣ'fahu",1108],["وَثُلُثَهُۥ","dan/atau sepertiganya","wathuluthahu",1254],["وَطَآئِفَةٌۭ","dan segolongan","waṭāifatun",451],["مِّنَ","dari","mina",1],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مَعَكَ ۚ","bersama kamu","maʿaka",78],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يُقَدِّرُ","menetapkan","yuqaddiru",613],["ٱلَّيْلَ","malam","al-layla",146],["وَٱلنَّهَارَ ۚ","dan siang","wal-nahāra",221],["عَلِمَ","Dia mengetahui","ʿalima",35],["أَن","bahwa","an",22],["لَّن","tidak dapat","lan",123],["تُحْصُوهُ","menentukannya","tuḥ'ṣūhu",828],["فَتَابَ","maka Dia menerima taubat","fatāba",205],["عَلَيْكُمْ ۖ","atas kalian","ʿalaykum",11],["فَٱقْرَءُوا۟","maka bacalah","fa-iq'raū",614],["مَا","apa","mā",6],["تَيَسَّرَ","kamu mudah","tayassara",2714],["مِنَ","dari","mina",1],["ٱلْقُرْءَانِ ۚ","Al Qur'an ini","l-qur'āni",189],["عَلِمَ","Dia mengetahui","ʿalima",35],["أَن","bahwa","an",22],["سَيَكُونُ","akan ada","sayakūnu",12],["مِنكُم","diantara kamu","minkum",1],["مَّرْضَىٰ ۙ","orang-orang yang sakit","marḍā",862],["وَءَاخَرُونَ","dan yang lain","waākharūna",187],["يَضْرِبُونَ","mereka berjalan","yaḍribūna",230],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["يَبْتَغُونَ","mereka mencari","yabtaghūna",357],["مِن","dari","min",1],["فَضْلِ","karunia","faḍli",145],["ٱللَّهِ ۙ","Allah","l-lahi",4],["وَءَاخَرُونَ","dan yang lain","waākharūna",187],["يُقَـٰتِلُونَ","mereka berperang","yuqātilūna",234],["فِى","di/pada","fī",7],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ ۖ","Allah","l-lahi",4],["فَٱقْرَءُوا۟","maka bacalah","fa-iq'raū",614],["مَا","apa","mā",6],["تَيَسَّرَ","kamu mudah","tayassara",2714],["مِنْهُ ۚ","daripadanya","min'hu",1],["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["وَءَاتُوا۟","dan tunaikan","waātū",53],["ٱلزَّكَوٰةَ","zakat","l-zakata",374],["وَأَقْرِضُوا۟","dan berikan pinjaman","wa-aqriḍū",1148],["ٱللَّهَ","Allah","l-laha",4],["قَرْضًا","pinjaman","qarḍan",1237],["حَسَنًۭا ۚ","yang baik","ḥasanan",496],["وَمَا","dan apa","wamā",6],["تُقَدِّمُوا۟","kamu kerjakan","tuqaddimū",418],["لِأَنفُسِكُم","untuk dirimu","li-anfusikum",47],["مِّنْ","dari","min",1],["خَيْرٍۢ","kebaikan","khayrin",69],["تَجِدُوهُ","kamu perolehnya","tajidūhu",120],["عِندَ","di sisi","ʿinda",68],["ٱللَّهِ","Allah","l-lahi",4],["هُوَ","Dia","huwa",25],["خَيْرًۭا","baik","khayran",69],["وَأَعْظَمَ","dan lebih besar","wa-aʿẓama",1738],["أَجْرًۭا ۚ","pahala","ajran",121],["وَٱسْتَغْفِرُوا۟","dan mohon ampunlah","wa-is'taghfirū",314],["ٱللَّهَ ۖ","Allah","l-laha",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["غَفُورٌۭ","Maha Pengampun","ghafūrun",131],["رَّحِيمٌۢ","Maha penyayang","raḥīmun",113]],"t":"Sesungguhnya Tuhanmu mengetahui bahwa engkau (Muhammad) berdiri (salat) kurang dari dua pertiga malam, atau seperdua malam atau sepertiganya dan (demikian pula) segolongan dari orang-orang yang bersamamu. Allah menetapkan ukuran malam dan siang. Allah mengetahui bahwa kamu tidak dapat menentukan batas-batas waktu itu, maka Dia memberi keringanan kepadamu, karena itu bacalah apa yang mudah (bagimu) dari Alquran; Dia mengetahui bahwa akan ada di antara kamu orang-orang yang sakit, dan yang lain berjalan di bumi mencari sebagian karunia Allah; dan yang lain berperang di jalan Allah, maka bacalah apa yang mudah (bagimu) dari Alquran dan laksanakanlah salat, tunaikanlah zakat dan berikanlah pinjaman kepada Allah pinjaman yang baik. Kebaikan apa saja yang kamu perbuat untuk dirimu niscaya kamu memperoleh (balasan)nya di sisi Allah sebagai balasan yang paling baik dan yang paling besar pahalanya. Dan mohonlah ampunan kepada Allah; sungguh, Allah Maha Pengampun, Maha Penyayang."}]