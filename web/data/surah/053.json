[{"n":1,"w":[["وَٱلنَّجْمِ","demi bintang","wal-najmi",694],["إِذَا","apabila","idhā",23],["هَوَىٰ","terbenam","hawā",975]],"t":"Demi bintang ketika terbenam,"},{"n":2,"w":[["مَا","tidak","mā",2],["ضَلَّ","sesat","ḍalla",223],["صَاحِبُكُمْ","kawanmu","ṣāḥibukum",122],["وَمَا","dan tidak","wamā",2],["غَوَىٰ","keliru/sesat","ghawā",1853]],"t":"kawanmu (Muhammad) tidak sesat dan tidak (pula) keliru,"},{"n":3,"w":[["وَمَا","dan tidak","wamā",2],["يَنطِقُ","dia mengucap/berkata","yanṭiqu",917],["عَنِ","dari","ʿani",21],["ٱلْهَوَىٰٓ","hawa nafsu","l-hawā",781]],"t":"dan tidaklah yang diucapkannya itu (Alquran) menurut keinginannya."},{"n":4,"w":[["إِنْ","tidak lain","in",14],["هُوَ","dia","huwa",20],["إِلَّا","kecuali","illā",15],["وَحْىٌۭ","wahyu","waḥyun",1239],["يُوحَىٰ","diwahyukan","yūḥā",168]],"t":"Tidak lain (Alquran itu) adalah wahyu yang diwahyukan (kepadanya),"},{"n":5,"w":[["عَلَّمَهُۥ","mengajarkan kepadanya","ʿallamahu",284],["شَدِيدُ","sangat","shadīdu",213],["ٱلْقُوَىٰ","kuat","l-quwā",371]],"t":"yang diajarkan kepadanya oleh (Jibril) yang sangat kuat,"},{"n":6,"w":[["ذُو","mempunyai","dhū",116],["مِرَّةٍۢ","kekuatan/kecerdasan","mirratin",3766],["فَٱسْتَوَىٰ","lalu dia cukup sempurna","fa-is'tawā",336]],"t":"yang mempunyai keteguhan; maka (Jibril itu) menampakkan diri dengan rupa yang asli (rupa yang bagus dan perkasa)"},{"n":7,"w":[["وَهُوَ","dan dia","wahuwa",20],["بِٱلْأُفُقِ","di ufuk","bil-ufuqi",1756],["ٱلْأَعْلَىٰ","yang tinggi","l-aʿlā",761]],"t":"Sedang dia berada di ufuk yang tinggi."},{"n":8,"w":[["ثُمَّ","kemudian","thumma",34],["دَنَا","dia mendekat","danā",2345],["فَتَدَلَّىٰ","lalu dia turun","fatadallā",4334]],"t":"Kemudian dia mendekat (pada Muhammad), lalu bertambah dekat,"},{"n":9,"w":[["فَكَانَ","maka adalah dia","fakāna",9],["قَابَ","ukuran/jarak","qāba",4083],["قَوْسَيْنِ","dua busur panah","qawsayni",4119],["أَوْ","atau","aw",42],["أَدْنَىٰ","lebih dekat","adnā",711]],"t":"sehingga jaraknya (sekitar) dua busur panah atau lebih dekat (lagi)."},{"n":10,"w":[["فَأَوْحَىٰٓ","maka Dia mewahyukan","fa-awḥā",168],["إِلَىٰ","kepada","ilā",13],["عَبْدِهِۦ","hamba-Nya","ʿabdihi",90],["مَآ","apa yang","mā",2],["أَوْحَىٰ","Dia wahyukan","awḥā",168]],"t":"Lalu disampaikannya wahyu kepada hamba-Nya (Muhammad) apa yang telah diwahyukan Allah."},{"n":11,"w":[["مَا","tidak","mā",2],["كَذَبَ","mendustakan","kadhaba",783],["ٱلْفُؤَادُ","hati itu","l-fuādu",593],["مَا","apa","mā",2],["رَأَىٰٓ","dia lihat","raā",46]],"t":"Hatinya tidak mendustakan apa yang telah dilihatnya."},{"n":12,"w":[["أَفَتُمَـٰرُونَهُۥ","apakah maka kamu membantahnya","afatumārūnahu",1665],["عَلَىٰ","atas","ʿalā",8],["مَا","apa yang","mā",2],["يَرَىٰ","dia lihat","yarā",46]],"t":"Maka apakah kamu (musyrikin Mekkah) hendak membantahnya tentang apa yang dilihatnya itu?"},{"n":13,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["رَءَاهُ","dia telah melihatnya","raāhu",46],["نَزْلَةً","satu kali turun","nazlatan",4042],["أُخْرَىٰ","yang lain","ukh'rā",176]],"t":"Dan sungguh, dia (Muhammad) telah melihatnya (dalam rupanya yang asli) pada waktu yang lain,"},{"n":14,"w":[["عِندَ","di sisi","ʿinda",59],["سِدْرَةِ","Sidratil","sid'rati",2648],["ٱلْمُنتَهَىٰ","Muntaha","l-muntahā",1923]],"t":"(yaitu) di Sidratilmuntahā,"},{"n":15,"w":[["عِندَهَا","di sisinya","ʿindahā",59],["جَنَّةُ","surga","jannatu",77],["ٱلْمَأْوَىٰٓ","tempat tinggal","l-mawā",467]],"t":"di dekatnya ada surga tempat tinggal,"},{"n":16,"w":[["إِذْ","ketika","idh",53],["يَغْشَى","meliputi","yaghshā",684],["ٱلسِّدْرَةَ","Sidratil","l-sid'rata",2648],["مَا","apa/sesuatu","mā",2],["يَغْشَىٰ","yang meliputi","yaghshā",684]],"t":"(Muhammad melihat Jibril) ketika Sidratilmuntahā diliputi oleh sesuatu yang meliputinya,"},{"n":17,"w":[["مَا","tidak","mā",2],["زَاغَ","berpaling","zāgha",1250],["ٱلْبَصَرُ","penglihatan","l-baṣaru",248],["وَمَا","dan tidak","wamā",2],["طَغَىٰ","melampaui batas","ṭaghā",725]],"t":"penglihatannya (Muhammad) tidak menyimpang dari yang dilihatnya itu dan tidak (pula) melampauinya."},{"n":18,"w":[["لَقَدْ","sesungguhnya","laqad",24],["رَأَىٰ","dia telah melihat","raā",46],["مِنْ","dari/sebagian","min",0],["ءَايَـٰتِ","tanda-tanda","āyāti",28],["رَبِّهِ","Tuhannya","rabbihi",10],["ٱلْكُبْرَىٰٓ","paling besar","l-kub'rā",1078]],"t":"Sungguh, dia telah melihat sebagian tanda-tanda (kebesaran) Tuhannya yang paling besar."},{"n":19,"w":[["أَفَرَءَيْتُمُ","apakah maka kamu perhatikan","afara-aytumu",46],["ٱللَّـٰتَ","Al Lata","l-lāta",4613],["وَٱلْعُزَّىٰ","dan Al 'Uzza","wal-ʿuzā",4614]],"t":"Maka apakah patut kamu (orang-orang musyrik) menganggap (berhala) Al-Lāta dan Al-'Uzzā,"},{"n":20,"w":[["وَمَنَوٰةَ","dan Manah","wamanata",3713],["ٱلثَّالِثَةَ","yang ketiga","l-thālithata",4440],["ٱلْأُخْرَىٰٓ","yang lain/hina","l-ukh'rā",176]],"t":"dan Manāt, yang ketiga yang paling kemudian (sebagai anak perempuan Allah)."},{"n":21,"w":[["أَلَكُمُ","apakah bagimu","alakumu",26],["ٱلذَّكَرُ","laki-laki","l-dhakaru",534],["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْأُنثَىٰ","perempuan","l-unthā",433]],"t":"Apakah (pantas) untuk kamu yang laki-laki dan untuk-Nya yang perempuan?"},{"n":22,"w":[["تِلْكَ","itu","til'ka",19],["إِذًۭا","jika demikian","idhan",360],["قِسْمَةٌۭ","pembagian","qis'matun",1974],["ضِيزَىٰٓ","tidak adil","ḍīzā",3055]],"t":"Yang demikian itu tentulah suatu pembagian yang timpang."},{"n":23,"w":[["إِنْ","tidak lain","in",14],["هِىَ","dia","hiya",191],["إِلَّآ","kecuali","illā",15],["أَسْمَآءٌۭ","nama-nama","asmāon",309],["سَمَّيْتُمُوهَآ","kamu menamainya","sammaytumūhā",1000],["أَنتُمْ","kamu","antum",87],["وَءَابَآؤُكُم","dan bapak-bapakmu","waābāukum",106],["مَّآ","tidak","mā",2],["أَنزَلَ","menurunkan","anzala",62],["ٱللَّهُ","Allah","l-lahu",1],["بِهَا","dengannya","bihā",97],["مِن","dari","min",0],["سُلْطَـٰنٍ ۚ","kekuasaan","sul'ṭānin",323],["إِن","tidak lain","in",14],["يَتَّبِعُونَ","mereka mengikuti","yattabiʿūna",86],["إِلَّا","kecuali","illā",15],["ٱلظَّنَّ","sangkaan","l-ẓana",484],["وَمَا","dan apa yang","wamā",2],["تَهْوَى","menginginkan","tahwā",975],["ٱلْأَنفُسُ ۖ","hawa nafsu","l-anfusu",39],["وَلَقَدْ","dan sesungguhnya","walaqad",24],["جَآءَهُم","telah datang kepada mereka","jāahum",43],["مِّن","dari","min",0],["رَّبِّهِمُ","Tuhan mereka","rabbihimu",10],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",133]],"t":"Itu tidak lain hanyalah nama-nama yang kamu dan nenek moyangmu mengada-adakannya; Allah tidak menurunkan suatu keterangan apa pun untuk (menyembah)nya. Mereka hanya mengikuti dugaan, dan apa yang diingini oleh keinginannya. Padahal sungguh, telah datang petunjuk dari Tuhan mereka."},{"n":24,"w":[["أَمْ","ataukah/apakah","am",84],["لِلْإِنسَـٰنِ","bagi manusia","lil'insāni",170],["مَا","apa yang","mā",2],["تَمَنَّىٰ","ia inginkan","tamannā",933]],"t":"Atau apakah manusia akan mendapat segala yang dicita-citakannya?"},{"n":25,"w":[["فَلِلَّهِ","maka kepunyaan Allah","falillahi",1],["ٱلْـَٔاخِرَةُ","kehidupan akhirat","l-ākhiratu",73],["وَٱلْأُولَىٰ","dan kehidupan dunia","wal-ūlā",141]],"t":"(Tidak!) Maka milik Allah lah kehidupan akhirat dan kehidupan dunia."},{"n":26,"w":[["۞ وَكَم","dan berapa banyak","wakam",485],["مِّن","dari","min",0],["مَّلَكٍۢ","malaikat","malakin",127],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["لَا","tidak","lā",4],["تُغْنِى","berguna","tugh'nī",271],["شَفَـٰعَتُهُمْ","pertolongan mereka","shafāʿatuhum",672],["شَيْـًٔا","sedikitpun","shayan",41],["إِلَّا","kecuali","illā",15],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["أَن","bahwa","an",17],["يَأْذَنَ","memberi izin","yadhana",446],["ٱللَّهُ","Allah","l-lahu",1],["لِمَن","bagi siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَرْضَىٰٓ","dan Dia ridhai","wayarḍā",313]],"t":"Dan betapa banyak malaikat di langit, syafaat (pertolongan) mereka sedikit pun tidak berguna kecuali apabila Allah telah mengizinkan (dan hanya) bagi siapa yang Dia kehendaki dan Dia ridai."},{"n":27,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","tidak","lā",4],["يُؤْمِنُونَ","beriman","yu'minūna",18],["بِٱلْـَٔاخِرَةِ","kepada akhirat","bil-ākhirati",73],["لَيُسَمُّونَ","sungguh mereka menamakan","layusammūna",1000],["ٱلْمَلَـٰٓئِكَةَ","malaikat","l-malāikata",127],["تَسْمِيَةَ","nama","tasmiyata",4391],["ٱلْأُنثَىٰ","perempuan","l-unthā",433]],"t":"Sesungguhnya orang-orang yang tidak beriman kepada kehidupan akhirat, sungguh mereka menamakan para malaikat dengan nama perempuan."},{"n":28,"w":[["وَمَا","dan tidak","wamā",2],["لَهُم","mereka mempunyai","lahum",11],["بِهِۦ","dengannya","bihi",16],["مِنْ","dari","min",0],["عِلْمٍ ۖ","pengetahuan","ʿil'min",111],["إِن","tidak lain","in",14],["يَتَّبِعُونَ","mereka mengikuti","yattabiʿūna",86],["إِلَّا","kecuali","illā",15],["ٱلظَّنَّ ۖ","sangkaan","l-ẓana",484],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلظَّنَّ","sankaan","l-ẓana",484],["لَا","tidak","lā",4],["يُغْنِى","berguna","yugh'nī",271],["مِنَ","dari","mina",0],["ٱلْحَقِّ","kebenaran","l-ḥaqi",50],["شَيْـًۭٔا","sedikitpun","shayan",41]],"t":"Dan mereka tidak mempunyai ilmu tentang itu. Mereka tidak lain hanyalah mengikuti dugaan, dan sesungguhnya dugaan itu tidak berfaedah sedikit pun terhadap kebenaran."},{"n":29,"w":[["فَأَعْرِضْ","maka berpalinglah","fa-aʿriḍ",351],["عَن","dari","ʿan",21],["مَّن","siapa yang","man",12],["تَوَلَّىٰ","dia berpaling","tawallā",149],["عَن","dari","ʿan",21],["ذِكْرِنَا","mengingat Kami","dhik'rinā",152],["وَلَمْ","dan tidak","walam",32],["يُرِدْ","dia menghendaki","yurid",83],["إِلَّا","kecuali","illā",15],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",153],["ٱلدُّنْيَا","dunia","l-dun'yā",104]],"t":"Maka tinggalkanlah (Muhammad) orang yang berpaling dari peringatan Kami, dan dia hanya mengingini kehidupan dunia."},{"n":30,"w":[["ذَٰلِكَ","demikian itu","dhālika",19],["مَبْلَغُهُم","kesudahan mereka","mablaghuhum",3681],["مِّنَ","dari","mina",0],["ٱلْعِلْمِ ۚ","penegtahuan","l-ʿil'mi",111],["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِمَن","kepada siapa","biman",12],["ضَلَّ","dia tersesat","ḍalla",223],["عَن","dari","ʿan",21],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",64],["وَهُوَ","dan Dia","wahuwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِمَنِ","kepada siapa","bimani",12],["ٱهْتَدَىٰ","mendapat petunjuk","ih'tadā",298]],"t":"Itulah kadar ilmu mereka. Sungguh, Tuhanmu, Dia lebih mengetahui siapa yang tersesat dari jalan-Nya dan Dia pula yang lebih mengetahui siapa yang mendapat petunjuk."},{"n":31,"w":[["وَلِلَّهِ","dan kepunyaan Allah","walillahi",1],["مَا","apa yang","mā",2],["فِى","ada di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa yang","wamā",2],["فِى","ada di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["لِيَجْزِىَ","Dia akan memberi balasan","liyajziya",164],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أَسَـٰٓـُٔوا۟","mereka berbuat jahat","asāū",1276],["بِمَا","terhadap apa","bimā",2],["عَمِلُوا۟","mereka kerjakan","ʿamilū",44],["وَيَجْزِىَ","dan dia akan memberi balasan","wayajziya",164],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أَحْسَنُوا۟","mereka berbuat baik","aḥsanū",481],["بِٱلْحُسْنَى","denganyang lebih baik","bil-ḥus'nā",565]],"t":"Dan milik Allah lah apa yang ada di langit dan apa yang ada di bumi. (Dengan demikian) Dia akan memberi balasan kepada orang-orang yang berbuat jahat sesuai dengan apa yang telah mereka kerjakan dan Dia akan memberi balasan kepada orang-orang yang berbuat baik dengan pahala yang lebih baik (surga)."},{"n":32,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَجْتَنِبُونَ","mereka menjauhi","yajtanibūna",942],["كَبَـٰٓئِرَ","besar","kabāira",1076],["ٱلْإِثْمِ","dosa","l-ith'mi",329],["وَٱلْفَوَٰحِشَ","dan perbuatan keji","wal-fawāḥisha",570],["إِلَّا","kecuali","illā",15],["ٱللَّمَمَ ۚ","teringat sepintas lalu","l-lamama",3638],["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["وَٰسِعُ","Maha Luas","wāsiʿu",701],["ٱلْمَغْفِرَةِ ۚ","ampunan","l-maghfirati",391],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِكُمْ","dengan/untuk kalian","bikum",26],["إِذْ","ketika","idh",53],["أَنشَأَكُم","Dia menjadikan kamu","ansha-akum",500],["مِّنَ","dari","mina",0],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَإِذْ","dan ketika","wa-idh",53],["أَنتُمْ","kamu","antum",87],["أَجِنَّةٌۭ","janin","ajinnatun",3550],["فِى","dalam","fī",3],["بُطُونِ","perut","buṭūni",566],["أُمَّهَـٰتِكُمْ ۖ","ibu-ibu kamu","ummahātikum",339],["فَلَا","maka jangan","falā",4],["تُزَكُّوٓا۟","kamu menganggap suci","tuzakkū",751],["أَنفُسَكُمْ ۖ","diri kalian sendiri","anfusakum",39],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِمَنِ","dengan siapa","bimani",12],["ٱتَّقَىٰٓ","yang bertakwa","ittaqā",67]],"t":"(Yaitu) mereka yang menjauhi dosa-dosa besar dan perbuatan keji, kecuali kesalahan-kesalahan kecil. Sungguh, Tuhanmu Mahaluas ampunan-Nya. Dia mengetahui tentang kamu, sejak Dia menjadikan kamu dari tanah lalu ketika kamu masih janin dalam perut ibumu. Maka janganlah kamu menganggap dirimu suci. Dia mengetahui tentang orang yang bertakwa."},{"n":33,"w":[["أَفَرَءَيْتَ","maka apakah kamu memperhatikan","afara-ayta",46],["ٱلَّذِى","orang yang","alladhī",7],["تَوَلَّىٰ","dia berpaling","tawallā",149]],"t":"Maka tidakkah engkau melihat orang yang berpaling (dari Alquran)?"},{"n":34,"w":[["وَأَعْطَىٰ","dan Dia memberi","wa-aʿṭā",949],["قَلِيلًۭا","sedikit","qalīlan",175],["وَأَكْدَىٰٓ","dan Dia menahan/tidak memberi","wa-akdā",2963]],"t":"dan dia memberikan sedikit (dari apa yang dijanjikan) lalu menahan sisanya."},{"n":35,"w":[["أَعِندَهُۥ","apakah di sisi","aʿindahu",59],["عِلْمُ","pengetahuan","ʿil'mu",111],["ٱلْغَيْبِ","gaib","l-ghaybi",242],["فَهُوَ","maka dia","fahuwa",20],["يَرَىٰٓ","dia melihat","yarā",46]],"t":"Apakah dia mempunyai ilmu tentang yang gaib sehingga dia dapat melihat(nya)?"},{"n":36,"w":[["أَمْ","ataukah/apakah","am",84],["لَمْ","belum","lam",32],["يُنَبَّأْ","diberitakan dia","yunabba",256],["بِمَا","dengan apa","bimā",2],["فِى","dalam","fī",3],["صُحُفِ","lembaran-lembaran","ṣuḥufi",962],["مُوسَىٰ","Musa","mūsā",85]],"t":"Ataukah belum diberitakan (kepadanya) apa yang ada dalam lembaran-lembaran (Kitab Suci yang diturunkan kepada) Musa?"},{"n":37,"w":[["وَإِبْرَٰهِيمَ","dan Ibrahim","wa-ib'rāhīma",181],["ٱلَّذِى","yang","alladhī",7],["وَفَّىٰٓ","dia sempurnakan","waffā",556]],"t":"Dan (lembaran-lembaran) Ibrahim yang selalu menyempurnakan janji?"},{"n":38,"w":[["أَلَّا","bahwa tidak","allā",17],["تَزِرُ","kamu memikul dosa","taziru",1110],["وَازِرَةٌۭ","orang yang berdosa","wāziratun",1421],["وِزْرَ","beban/dosa","wiz'ra",748],["أُخْرَىٰ","orang lain","ukh'rā",176]],"t":"(yaitu) bahwa seseorang yang berdosa tidak akan memikul dosa orang lain,"},{"n":39,"w":[["وَأَن","dan bahwa","wa-an",17],["لَّيْسَ","tidak","laysa",123],["لِلْإِنسَـٰنِ","bagi manusia","lil'insāni",170],["إِلَّا","kecuali","illā",15],["مَا","apa yang","mā",2],["سَعَىٰ","ia usahakan","saʿā",515]],"t":"dan bahwa manusia hanya memperoleh apa yang telah diusahakannya,"},{"n":40,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",30],["سَعْيَهُۥ","usahanya","saʿyahu",857],["سَوْفَ","kelak","sawfa",281],["يُرَىٰ","diperlihatkan","yurā",46]],"t":"dan sesungguhnya usahanya itu kelak akan diperlihatkan (kepadanya),"},{"n":41,"w":[["ثُمَّ","kemudian","thumma",34],["يُجْزَىٰهُ","diberi balasan kepadanya","yuj'zāhu",164],["ٱلْجَزَآءَ","balasan","l-jazāa",276],["ٱلْأَوْفَىٰ","cukup/sempurna","l-awfā",2180]],"t":"kemudian akan diberi balasan kepadanya dengan balasan yang paling sempurna,"},{"n":42,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",30],["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْمُنتَهَىٰ","akhir tujuan","l-muntahā",1923]],"t":"dan sesungguhnya kepada Tuhanmulah kesudahannya (segala sesuatu),"},{"n":43,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["هُوَ","Dia","huwa",20],["أَضْحَكَ","menjadikan ia tertawa","aḍḥaka",2909],["وَأَبْكَىٰ","dan menjadikan ia menangis","wa-abkā",2940]],"t":"dan sesungguhnya Dialah yang menjadikan orang tertawa dan menangis,"},{"n":44,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["هُوَ","Dia","huwa",20],["أَمَاتَ","mematikan","amāta",482],["وَأَحْيَا","dan menghidupkan","wa-aḥyā",230]],"t":"dan sesungguhnya Dialah yang mematikan dan menghidupkan,"},{"n":45,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["خَلَقَ","Dia menciptakan","khalaqa",61],["ٱلزَّوْجَيْنِ","berpasangan","l-zawjayni",155],["ٱلذَّكَرَ","laki-laki","l-dhakara",534],["وَٱلْأُنثَىٰ","dan perempuan","wal-unthā",433]],"t":"dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,"},{"n":46,"w":[["مِن","dari","min",0],["نُّطْفَةٍ","air mani","nuṭ'fatin",739],["إِذَا","apabila","idhā",23],["تُمْنَىٰ","dipancarkan","tum'nā",1739]],"t":"dari mani, apabila dipancarkan,"},{"n":47,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",30],["عَلَيْهِ","atasnya","ʿalayhi",8],["ٱلنَّشْأَةَ","kejadian","l-nashata",1960],["ٱلْأُخْرَىٰ","yang lain","l-ukh'rā",176]],"t":"dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),"},{"n":48,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["هُوَ","Dia","huwa",20],["أَغْنَىٰ","memberikan kekayaan","aghnā",271],["وَأَقْنَىٰ","dan memberikan kecukupan","wa-aqnā",2992]],"t":"dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan."},{"n":49,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",30],["هُوَ","dia","huwa",20],["رَبُّ","Tuhan","rabbu",10],["ٱلشِّعْرَىٰ","bintang syi'ra","l-shiʿ'rā",2856]],"t":"dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'rā,"},{"n":50,"w":[["وَأَنَّهُۥٓ","dan bahwasanya","wa-annahu",30],["أَهْلَكَ","Dia telah membinasakan","ahlaka",231],["عَادًا","kaum'Ad","ʿādan",434],["ٱلْأُولَىٰ","dahulu","l-ūlā",141]],"t":"dan sesungguhnya Dialah yang telah membinasakan kaum 'Ād dahulu kala,"},{"n":51,"w":[["وَثَمُودَا۟","dan kaum Tsamud","wathamūdā",415],["فَمَآ","maka tidak","famā",2],["أَبْقَىٰ","Dia tertinggal","abqā",1819]],"t":"dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),"},{"n":52,"w":[["وَقَوْمَ","dan kaum","waqawma",27],["نُوحٍۢ","Nuh","nūḥin",273],["مِّن","dari","min",0],["قَبْلُ ۖ","sebelum itu","qablu",51],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["هُمْ","mereka","hum",11],["أَظْلَمَ","lebih zalim","aẓlama",584],["وَأَطْغَىٰ","dan lebih durhaka","wa-aṭghā",2932]],"t":"dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka."},{"n":53,"w":[["وَٱلْمُؤْتَفِكَةَ","dan Mu'tafikah","wal-mu'tafikata",1912],["أَهْوَىٰ","Dia hancurkan","ahwā",975]],"t":"Dan prahara angin telah meruntuhkan (negeri kaum Luṭ),"},{"n":54,"w":[["فَغَشَّىٰهَا","maka Dia menutupinya","faghashāhā",1845],["مَا","apa(azab)","mā",2],["غَشَّىٰ","menutupi/menimpa","ghashā",1845]],"t":"lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya."},{"n":55,"w":[["فَبِأَىِّ","maka terhadap","fabi-ayyi",198],["ءَالَآءِ","atas","ālāi",338],["رَبِّكَ","Tuhanmu","rabbika",10],["تَتَمَارَىٰ","ragu","tatamārā",1665]],"t":"Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?"},{"n":56,"w":[["هَـٰذَا","Ini","hādhā",37],["نَذِيرٌۭ","pemberi peringatan","nadhīrun",204],["مِّنَ","dari","mina",0],["ٱلنُّذُرِ","antara pemberi peringatan","l-nudhuri",204],["ٱلْأُولَىٰٓ","terdahulu","l-ūlā",141]],"t":"Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu."},{"n":57,"w":[["أَزِفَتِ","telah dekat","azifati",3031],["ٱلْـَٔازِفَةُ","kiamat","l-āzifatu",2103]],"t":"Yang dekat (hari Kiamat) telah makin mendekat."},{"n":58,"w":[["لَيْسَ","tidak","laysa",123],["لَهَا","padanya","lahā",97],["مِن","dari","min",0],["دُونِ","sisi","dūni",79],["ٱللَّهِ","Allah","l-lahi",1],["كَاشِفَةٌ","menyatakan","kāshifatun",1352]],"t":"Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah."},{"n":59,"w":[["أَفَمِنْ","maka apakah","afamin",0],["هَـٰذَا","ini","hādhā",37],["ٱلْحَدِيثِ","pemberitaan","l-ḥadīthi",387],["تَعْجَبُونَ","kamu heran","taʿjabūna",956]],"t":"Maka apakah kamu merasa heran terhadap pemberitaan ini?"},{"n":60,"w":[["وَتَضْحَكُونَ","dan kamu mentertawakan","wataḍḥakūna",1038],["وَلَا","dan tidak","walā",4],["تَبْكُونَ","menangis","tabkūna",1321]],"t":"dan kamu tertawakan dan tidak menangis,"},{"n":61,"w":[["وَأَنتُمْ","dan kalian","wa-antum",87],["سَـٰمِدُونَ","melengahkan","sāmidūna",4236]],"t":"sedang kamu lengah (darinya)."},{"n":62,"w":[["فَٱسْجُدُوا۟","maka bersujudlah","fa-us'judū",335],["لِلَّهِ","kepada Allah","lillahi",1],["وَٱعْبُدُوا۟ ۩","dan sembahlah (Dia)","wa-uʿ'budū",99]],"t":"Maka bersujudlah kepada Allah dan sembahlah (Dia)!"}]