[{"n":1,"w":[["وَٱلنَّجْمِ","demi bintang","wal-najmi",708],["إِذَا","apabila","idhā",29],["هَوَىٰ","terbenam","hawā",992]],"t":"Demi bintang ketika terbenam,"},{"n":2,"w":[["مَا","tidak","mā",6],["ضَلَّ","sesat","ḍalla",235],["صَاحِبُكُمْ","kawanmu","ṣāḥibukum",132],["وَمَا","dan tidak","wamā",6],["غَوَىٰ","keliru/sesat","ghawā",1870]],"t":"kawanmu (Muhammad) tidak sesat dan tidak (pula) keliru,"},{"n":3,"w":[["وَمَا","dan tidak","wamā",6],["يَنطِقُ","dia mengucap/berkata","yanṭiqu",934],["عَنِ","dari","ʿani",27],["ٱلْهَوَىٰٓ","hawa nafsu","l-hawā",795]],"t":"dan tidaklah yang diucapkannya itu (Alquran) menurut keinginannya."},{"n":4,"w":[["إِنْ","tidak lain","in",19],["هُوَ","dia","huwa",25],["إِلَّا","kecuali","illā",20],["وَحْىٌۭ","wahyu","waḥyun",1256],["يُوحَىٰ","diwahyukan","yūḥā",179]],"t":"Tidak lain (Alquran itu) adalah wahyu yang diwahyukan (kepadanya),"},{"n":5,"w":[["عَلَّمَهُۥ","mengajarkan kepadanya","ʿallamahu",298],["شَدِيدُ","sangat","shadīdu",225],["ٱلْقُوَىٰ","kuat","l-quwā",386]],"t":"yang diajarkan kepadanya oleh (Jibril) yang sangat kuat,"},{"n":6,"w":[["ذُو","mempunyai","dhū",113],["مِرَّةٍۢ","kekuatan/kecerdasan","mirratin",3783],["فَٱسْتَوَىٰ","lalu dia cukup sempurna","fa-is'tawā",351]],"t":"yang mempunyai keteguhan; maka (Jibril itu) menampakkan diri dengan rupa yang asli (rupa yang bagus dan perkasa)"},{"n":7,"w":[["وَهُوَ","dan dia","wahuwa",25],["بِٱلْأُفُقِ","di ufuk","bil-ufuqi",1773],["ٱلْأَعْلَىٰ","yang tinggi","l-aʿlā",775]],"t":"Sedang dia berada di ufuk yang tinggi."},{"n":8,"w":[["ثُمَّ","kemudian","thumma",41],["دَنَا","dia mendekat","danā",2362],["فَتَدَلَّىٰ","lalu dia turun","fatadallā",4351]],"t":"Kemudian dia mendekat (pada Muhammad), lalu bertambah dekat,"},{"n":9,"w":[["فَكَانَ","maka adalah dia","fakāna",12],["قَابَ","ukuran/jarak","qāba",4100],["قَوْسَيْنِ","dua busur panah","qawsayni",4136],["أَوْ","atau","aw",50],["أَدْنَىٰ","lebih dekat","adnā",725]],"t":"sehingga jaraknya (sekitar) dua busur panah atau lebih dekat (lagi)."},{"n":10,"w":[["فَأَوْحَىٰٓ","maka Dia mewahyukan","fa-awḥā",179],["إِلَىٰ","kepada","ilā",18],["عَبْدِهِۦ","hamba-Nya","ʿabdihi",99],["مَآ","apa yang","mā",6],["أَوْحَىٰ","Dia wahyukan","awḥā",179]],"t":"Lalu disampaikannya wahyu kepada hamba-Nya (Muhammad) apa yang telah diwahyukan Allah."},{"n":11,"w":[["مَا","tidak","mā",6],["كَذَبَ","mendustakan","kadhaba",797],["ٱلْفُؤَادُ","hati itu","l-fuādu",607],["مَا","apa","mā",6],["رَأَىٰٓ","dia lihat","raā",54]],"t":"Hatinya tidak mendustakan apa yang telah dilihatnya."},{"n":12,"w":[["أَفَتُمَـٰرُونَهُۥ","apakah maka kamu membantahnya","afatumārūnahu",1682],["عَلَىٰ","atas","ʿalā",11],["مَا","apa yang","mā",6],["يَرَىٰ","dia lihat","yarā",54]],"t":"Maka apakah kamu (musyrikin Mekkah) hendak membantahnya tentang apa yang dilihatnya itu?"},{"n":13,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["رَءَاهُ","dia telah melihatnya","raāhu",54],["نَزْلَةً","satu kali turun","nazlatan",4059],["أُخْرَىٰ","yang lain","ukh'rā",187]],"t":"Dan sungguh, dia (Muhammad) telah melihatnya (dalam rupanya yang asli) pada waktu yang lain,"},{"n":14,"w":[["عِندَ","di sisi","ʿinda",68],["سِدْرَةِ","Sidratil","sid'rati",2665],["ٱلْمُنتَهَىٰ","Muntaha","l-muntahā",1940]],"t":"(yaitu) di Sidratilmuntahā,"},{"n":15,"w":[["عِندَهَا","di sisinya","ʿindahā",68],["جَنَّةُ","surga","jannatu",86],["ٱلْمَأْوَىٰٓ","tempat tinggal","l-mawā",481]],"t":"di dekatnya ada surga tempat tinggal,"},{"n":16,"w":[["إِذْ","ketika","idh",61],["يَغْشَى","meliputi","yaghshā",698],["ٱلسِّدْرَةَ","Sidratil","l-sid'rata",2665],["مَا","apa/sesuatu","mā",6],["يَغْشَىٰ","yang meliputi","yaghshā",698]],"t":"(Muhammad melihat Jibril) ketika Sidratilmuntahā diliputi oleh sesuatu yang meliputinya,"},{"n":17,"w":[["مَا","tidak","mā",6],["زَاغَ","berpaling","zāgha",1267],["ٱلْبَصَرُ","penglihatan","l-baṣaru",260],["وَمَا","dan tidak","wamā",6],["طَغَىٰ","melampaui batas","ṭaghā",739]],"t":"penglihatannya (Muhammad) tidak menyimpang dari yang dilihatnya itu dan tidak (pula) melampauinya."},{"n":18,"w":[["لَقَدْ","sesungguhnya","laqad",30],["رَأَىٰ","dia telah melihat","raā",54],["مِنْ","dari/sebagian","min",1],["ءَايَـٰتِ","tanda-tanda","āyāti",34],["رَبِّهِ","Tuhannya","rabbihi",15],["ٱلْكُبْرَىٰٓ","paling besar","l-kub'rā",1095]],"t":"Sungguh, dia telah melihat sebagian tanda-tanda (kebesaran) Tuhannya yang paling besar."},{"n":19,"w":[["أَفَرَءَيْتُمُ","apakah maka kamu perhatikan","afara-aytumu",54],["ٱللَّـٰتَ","Al Lata","l-lāta",4630],["وَٱلْعُزَّىٰ","dan Al 'Uzza","wal-ʿuzā",4631]],"t":"Maka apakah patut kamu (orang-orang musyrik) menganggap (berhala) Al-Lāta dan Al-'Uzzā,"},{"n":20,"w":[["وَمَنَوٰةَ","dan Manah","wamanata",3730],["ٱلثَّالِثَةَ","yang ketiga","l-thālithata",4457],["ٱلْأُخْرَىٰٓ","yang lain/hina","l-ukh'rā",187]],"t":"dan Manāt, yang ketiga yang paling kemudian (sebagai anak perempuan Allah)."},{"n":21,"w":[["أَلَكُمُ","apakah bagimu","alakumu",32],["ٱلذَّكَرُ","laki-laki","l-dhakaru",548],["وَلَهُ","dan bagi-Nya","walahu",21],["ٱلْأُنثَىٰ","perempuan","l-unthā",448]],"t":"Apakah (pantas) untuk kamu yang laki-laki dan untuk-Nya yang perempuan?"},{"n":22,"w":[["تِلْكَ","itu","til'ka",310],["إِذًۭا","jika demikian","idhan",375],["قِسْمَةٌۭ","pembagian","qis'matun",1991],["ضِيزَىٰٓ","tidak adil","ḍīzā",3072]],"t":"Yang demikian itu tentulah suatu pembagian yang timpang."},{"n":23,"w":[["إِنْ","tidak lain","in",19],["هِىَ","dia","hiya",203],["إِلَّآ","kecuali","illā",20],["أَسْمَآءٌۭ","nama-nama","asmāon",324],["سَمَّيْتُمُوهَآ","kamu menamainya","sammaytumūhā",1017],["أَنتُمْ","kamu","antum",96],["وَءَابَآؤُكُم","dan bapak-bapakmu","waābāukum",117],["مَّآ","tidak","mā",6],["أَنزَلَ","menurunkan","anzala",71],["ٱللَّهُ","Allah","l-lahu",4],["بِهَا","dengannya","bihā",106],["مِن","dari","min",1],["سُلْطَـٰنٍ ۚ","kekuasaan","sul'ṭānin",338],["إِن","tidak lain","in",19],["يَتَّبِعُونَ","mereka mengikuti","yattabiʿūna",95],["إِلَّا","kecuali","illā",20],["ٱلظَّنَّ","sangkaan","l-ẓana",498],["وَمَا","dan apa yang","wamā",6],["تَهْوَى","menginginkan","tahwā",992],["ٱلْأَنفُسُ ۖ","hawa nafsu","l-anfusu",47],["وَلَقَدْ","dan sesungguhnya","walaqad",30],["جَآءَهُم","telah datang kepada mereka","jāahum",51],["مِّن","dari","min",1],["رَّبِّهِمُ","Tuhan mereka","rabbihimu",15],["ٱلْهُدَىٰٓ","petunjuk","l-hudā",143]],"t":"Itu tidak lain hanyalah nama-nama yang kamu dan nenek moyangmu mengada-adakannya; Allah tidak menurunkan suatu keterangan apa pun untuk (menyembah)nya. Mereka hanya mengikuti dugaan, dan apa yang diingini oleh keinginannya. Padahal sungguh, telah datang petunjuk dari Tuhan mereka."},{"n":24,"w":[["أَمْ","ataukah/apakah","am",93],["لِلْإِنسَـٰنِ","bagi manusia","lil'insāni",181],["مَا","apa yang","mā",6],["تَمَنَّىٰ","ia inginkan","tamannā",950]],"t":"Atau apakah manusia akan mendapat segala yang dicita-citakannya?"},{"n":25,"w":[["فَلِلَّهِ","maka kepunyaan Allah","falillahi",4],["ٱلْـَٔاخِرَةُ","kehidupan akhirat","l-ākhiratu",82],["وَٱلْأُولَىٰ","dan kehidupan dunia","wal-ūlā",151]],"t":"(Tidak!) Maka milik Allah lah kehidupan akhirat dan kehidupan dunia."},{"n":26,"w":[["۞ وَكَم","dan berapa banyak","wakam",499],["مِّن","dari","min",1],["مَّلَكٍۢ","malaikat","malakin",137],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["لَا","tidak","lā",8],["تُغْنِى","berguna","tugh'nī",285],["شَفَـٰعَتُهُمْ","pertolongan mereka","shafāʿatuhum",686],["شَيْـًٔا","sedikitpun","shayan",49],["إِلَّا","kecuali","illā",20],["مِنۢ","dari","min",1],["بَعْدِ","sesudah","baʿdi",67],["أَن","bahwa","an",22],["يَأْذَنَ","memberi izin","yadhana",460],["ٱللَّهُ","Allah","l-lahu",4],["لِمَن","bagi siapa","liman",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيَرْضَىٰٓ","dan Dia ridhai","wayarḍā",328]],"t":"Dan betapa banyak malaikat di langit, syafaat (pertolongan) mereka sedikit pun tidak berguna kecuali apabila Allah telah mengizinkan (dan hanya) bagi siapa yang Dia kehendaki dan Dia ridai."},{"n":27,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["لَا","tidak","lā",8],["يُؤْمِنُونَ","beriman","yu'minūna",23],["بِٱلْـَٔاخِرَةِ","kepada akhirat","bil-ākhirati",82],["لَيُسَمُّونَ","sungguh mereka menamakan","layusammūna",1017],["ٱلْمَلَـٰٓئِكَةَ","malaikat","l-malāikata",137],["تَسْمِيَةَ","nama","tasmiyata",4408],["ٱلْأُنثَىٰ","perempuan","l-unthā",448]],"t":"Sesungguhnya orang-orang yang tidak beriman kepada kehidupan akhirat, sungguh mereka menamakan para malaikat dengan nama perempuan."},{"n":28,"w":[["وَمَا","dan tidak","wamā",6],["لَهُم","mereka mempunyai","lahum",16],["بِهِۦ","dengannya","bihi",21],["مِنْ","dari","min",1],["عِلْمٍ ۖ","pengetahuan","ʿil'min",122],["إِن","tidak lain","in",19],["يَتَّبِعُونَ","mereka mengikuti","yattabiʿūna",95],["إِلَّا","kecuali","illā",20],["ٱلظَّنَّ ۖ","sangkaan","l-ẓana",498],["وَإِنَّ","dan sesungguhnya","wa-inna",9],["ٱلظَّنَّ","sankaan","l-ẓana",498],["لَا","tidak","lā",8],["يُغْنِى","berguna","yugh'nī",285],["مِنَ","dari","mina",1],["ٱلْحَقِّ","kebenaran","l-ḥaqi",58],["شَيْـًۭٔا","sedikitpun","shayan",49]],"t":"Dan mereka tidak mempunyai ilmu tentang itu. Mereka tidak lain hanyalah mengikuti dugaan, dan sesungguhnya dugaan itu tidak berfaedah sedikit pun terhadap kebenaran."},{"n":29,"w":[["فَأَعْرِضْ","maka berpalinglah","fa-aʿriḍ",366],["عَن","dari","ʿan",27],["مَّن","siapa yang","man",17],["تَوَلَّىٰ","dia berpaling","tawallā",160],["عَن","dari","ʿan",27],["ذِكْرِنَا","mengingat Kami","dhik'rinā",163],["وَلَمْ","dan tidak","walam",39],["يُرِدْ","dia menghendaki","yurid",92],["إِلَّا","kecuali","illā",20],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",164],["ٱلدُّنْيَا","dunia","l-dun'yā",115]],"t":"Maka tinggalkanlah (Muhammad) orang yang berpaling dari peringatan Kami, dan dia hanya mengingini kehidupan dunia."},{"n":30,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["مَبْلَغُهُم","kesudahan mereka","mablaghuhum",3698],["مِّنَ","dari","mina",1],["ٱلْعِلْمِ ۚ","penegtahuan","l-ʿil'mi",122],["إِنَّ","sesungguhnya","inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["هُوَ","Dia","huwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَن","kepada siapa","biman",17],["ضَلَّ","dia tersesat","ḍalla",235],["عَن","dari","ʿan",27],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",73],["وَهُوَ","dan Dia","wahuwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَنِ","kepada siapa","bimani",17],["ٱهْتَدَىٰ","mendapat petunjuk","ih'tadā",313]],"t":"Itulah kadar ilmu mereka. Sungguh, Tuhanmu, Dia lebih mengetahui siapa yang tersesat dari jalan-Nya dan Dia pula yang lebih mengetahui siapa yang mendapat petunjuk."},{"n":31,"w":[["وَلِلَّهِ","dan kepunyaan Allah","walillahi",4],["مَا","apa yang","mā",6],["فِى","ada di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَمَا","dan apa yang","wamā",6],["فِى","ada di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["لِيَجْزِىَ","Dia akan memberi balasan","liyajziya",175],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["أَسَـٰٓـُٔوا۟","mereka berbuat jahat","asāū",1293],["بِمَا","terhadap apa","bimā",6],["عَمِلُوا۟","mereka kerjakan","ʿamilū",52],["وَيَجْزِىَ","dan dia akan memberi balasan","wayajziya",175],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["أَحْسَنُوا۟","mereka berbuat baik","aḥsanū",495],["بِٱلْحُسْنَى","denganyang lebih baik","bil-ḥus'nā",579]],"t":"Dan milik Allah lah apa yang ada di langit dan apa yang ada di bumi. (Dengan demikian) Dia akan memberi balasan kepada orang-orang yang berbuat jahat sesuai dengan apa yang telah mereka kerjakan dan Dia akan memberi balasan kepada orang-orang yang berbuat baik dengan pahala yang lebih baik (surga)."},{"n":32,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يَجْتَنِبُونَ","mereka menjauhi","yajtanibūna",959],["كَبَـٰٓئِرَ","besar","kabāira",1093],["ٱلْإِثْمِ","dosa","l-ith'mi",344],["وَٱلْفَوَٰحِشَ","dan perbuatan keji","wal-fawāḥisha",584],["إِلَّا","kecuali","illā",20],["ٱللَّمَمَ ۚ","teringat sepintas lalu","l-lamama",3655],["إِنَّ","sesungguhnya","inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["وَٰسِعُ","Maha Luas","wāsiʿu",715],["ٱلْمَغْفِرَةِ ۚ","ampunan","l-maghfirati",406],["هُوَ","Dia","huwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِكُمْ","dengan/untuk kalian","bikum",32],["إِذْ","ketika","idh",61],["أَنشَأَكُم","Dia menjadikan kamu","ansha-akum",514],["مِّنَ","dari","mina",1],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَإِذْ","dan ketika","wa-idh",61],["أَنتُمْ","kamu","antum",96],["أَجِنَّةٌۭ","janin","ajinnatun",3567],["فِى","dalam","fī",7],["بُطُونِ","perut","buṭūni",580],["أُمَّهَـٰتِكُمْ ۖ","ibu-ibu kamu","ummahātikum",354],["فَلَا","maka jangan","falā",8],["تُزَكُّوٓا۟","kamu menganggap suci","tuzakkū",765],["أَنفُسَكُمْ ۖ","diri kalian sendiri","anfusakum",47],["هُوَ","Dia","huwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَنِ","dengan siapa","bimani",17],["ٱتَّقَىٰٓ","yang bertakwa","ittaqā",76]],"t":"(Yaitu) mereka yang menjauhi dosa-dosa besar dan perbuatan keji, kecuali kesalahan-kesalahan kecil. Sungguh, Tuhanmu Mahaluas ampunan-Nya. Dia mengetahui tentang kamu, sejak Dia menjadikan kamu dari tanah lalu ketika kamu masih janin dalam perut ibumu. Maka janganlah kamu menganggap dirimu suci. Dia mengetahui tentang orang yang bertakwa."},{"n":33,"w":[["أَفَرَءَيْتَ","maka apakah kamu memperhatikan","afara-ayta",54],["ٱلَّذِى","orang yang","alladhī",45],["تَوَلَّىٰ","dia berpaling","tawallā",160]],"t":"Maka tidakkah engkau melihat orang yang berpaling (dari Alquran)?"},{"n":34,"w":[["وَأَعْطَىٰ","dan Dia memberi","wa-aʿṭā",966],["قَلِيلًۭا","sedikit","qalīlan",186],["وَأَكْدَىٰٓ","dan Dia menahan/tidak memberi","wa-akdā",2980]],"t":"dan dia memberikan sedikit (dari apa yang dijanjikan) lalu menahan sisanya."},{"n":35,"w":[["أَعِندَهُۥ","apakah di sisi","aʿindahu",68],["عِلْمُ","pengetahuan","ʿil'mu",122],["ٱلْغَيْبِ","gaib","l-ghaybi",254],["فَهُوَ","maka dia","fahuwa",25],["يَرَىٰٓ","dia melihat","yarā",54]],"t":"Apakah dia mempunyai ilmu tentang yang gaib sehingga dia dapat melihat(nya)?"},{"n":36,"w":[["أَمْ","ataukah/apakah","am",93],["لَمْ","belum","lam",39],["يُنَبَّأْ","diberitakan dia","yunabba",270],["بِمَا","dengan apa","bimā",6],["فِى","dalam","fī",7],["صُحُفِ","lembaran-lembaran","ṣuḥufi",979],["مُوسَىٰ","Musa","mūsā",94]],"t":"Ataukah belum diberitakan (kepadanya) apa yang ada dalam lembaran-lembaran (Kitab Suci yang diturunkan kepada) Musa?"},{"n":37,"w":[["وَإِبْرَٰهِيمَ","dan Ibrahim","wa-ib'rāhīma",192],["ٱلَّذِى","yang","alladhī",45],["وَفَّىٰٓ","dia sempurnakan","waffā",570]],"t":"Dan (lembaran-lembaran) Ibrahim yang selalu menyempurnakan janji?"},{"n":38,"w":[["أَلَّا","bahwa tidak","allā",22],["تَزِرُ","kamu memikul dosa","taziru",1127],["وَازِرَةٌۭ","orang yang berdosa","wāziratun",1438],["وِزْرَ","beban/dosa","wiz'ra",762],["أُخْرَىٰ","orang lain","ukh'rā",187]],"t":"(yaitu) bahwa seseorang yang berdosa tidak akan memikul dosa orang lain,"},{"n":39,"w":[["وَأَن","dan bahwa","wa-an",22],["لَّيْسَ","tidak","laysa",133],["لِلْإِنسَـٰنِ","bagi manusia","lil'insāni",181],["إِلَّا","kecuali","illā",20],["مَا","apa yang","mā",6],["سَعَىٰ","ia usahakan","saʿā",529]],"t":"dan bahwa manusia hanya memperoleh apa yang telah diusahakannya,"},{"n":40,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",36],["سَعْيَهُۥ","usahanya","saʿyahu",872],["سَوْفَ","kelak","sawfa",295],["يُرَىٰ","diperlihatkan","yurā",54]],"t":"dan sesungguhnya usahanya itu kelak akan diperlihatkan (kepadanya),"},{"n":41,"w":[["ثُمَّ","kemudian","thumma",41],["يُجْزَىٰهُ","diberi balasan kepadanya","yuj'zāhu",175],["ٱلْجَزَآءَ","balasan","l-jazāa",290],["ٱلْأَوْفَىٰ","cukup/sempurna","l-awfā",2197]],"t":"kemudian akan diberi balasan kepadanya dengan balasan yang paling sempurna,"},{"n":42,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",36],["إِلَىٰ","kepada","ilā",18],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلْمُنتَهَىٰ","akhir tujuan","l-muntahā",1940]],"t":"dan sesungguhnya kepada Tuhanmulah kesudahannya (segala sesuatu),"},{"n":43,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["هُوَ","Dia","huwa",25],["أَضْحَكَ","menjadikan ia tertawa","aḍḥaka",2926],["وَأَبْكَىٰ","dan menjadikan ia menangis","wa-abkā",2957]],"t":"dan sesungguhnya Dialah yang menjadikan orang tertawa dan menangis,"},{"n":44,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["هُوَ","Dia","huwa",25],["أَمَاتَ","mematikan","amāta",496],["وَأَحْيَا","dan menghidupkan","wa-aḥyā",242]],"t":"dan sesungguhnya Dialah yang mematikan dan menghidupkan,"},{"n":45,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["خَلَقَ","Dia menciptakan","khalaqa",70],["ٱلزَّوْجَيْنِ","berpasangan","l-zawjayni",166],["ٱلذَّكَرَ","laki-laki","l-dhakara",548],["وَٱلْأُنثَىٰ","dan perempuan","wal-unthā",448]],"t":"dan sesungguhnya Dialah yang menciptakan pasangan laki-laki dan perempuan,"},{"n":46,"w":[["مِن","dari","min",1],["نُّطْفَةٍ","air mani","nuṭ'fatin",753],["إِذَا","apabila","idhā",29],["تُمْنَىٰ","dipancarkan","tum'nā",1756]],"t":"dari mani, apabila dipancarkan,"},{"n":47,"w":[["وَأَنَّ","dan bahwasanya","wa-anna",36],["عَلَيْهِ","atasnya","ʿalayhi",11],["ٱلنَّشْأَةَ","kejadian","l-nashata",1977],["ٱلْأُخْرَىٰ","yang lain","l-ukh'rā",187]],"t":"dan sesungguhnya Dialah yang menetapkan penciptaan yang lain (kebangkitan setelah mati),"},{"n":48,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["هُوَ","Dia","huwa",25],["أَغْنَىٰ","memberikan kekayaan","aghnā",285],["وَأَقْنَىٰ","dan memberikan kecukupan","wa-aqnā",3009]],"t":"dan sesungguhnya Dialah yang memberikan kekayaan dan kecukupan."},{"n":49,"w":[["وَأَنَّهُۥ","dan bahwasanya","wa-annahu",36],["هُوَ","dia","huwa",25],["رَبُّ","Tuhan","rabbu",15],["ٱلشِّعْرَىٰ","bintang syi'ra","l-shiʿ'rā",2874]],"t":"dan sesungguhnya Dialah Tuhan (yang memiliki) bintang Syi'rā,"},{"n":50,"w":[["وَأَنَّهُۥٓ","dan bahwasanya","wa-annahu",36],["أَهْلَكَ","Dia telah membinasakan","ahlaka",243],["عَادًا","kaum'Ad","ʿādan",449],["ٱلْأُولَىٰ","dahulu","l-ūlā",151]],"t":"dan sesungguhnya Dialah yang telah membinasakan kaum 'Ād dahulu kala,"},{"n":51,"w":[["وَثَمُودَا۟","dan kaum Tsamud","wathamūdā",430],["فَمَآ","maka tidak","famā",6],["أَبْقَىٰ","Dia tertinggal","abqā",1836]],"t":"dan kaum Samud, tidak seorang pun yang ditinggalkan-Nya (hidup),"},{"n":52,"w":[["وَقَوْمَ","dan kaum","waqawma",33],["نُوحٍۢ","Nuh","nūḥin",287],["مِّن","dari","min",1],["قَبْلُ ۖ","sebelum itu","qablu",59],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["هُمْ","mereka","hum",16],["أَظْلَمَ","lebih zalim","aẓlama",598],["وَأَطْغَىٰ","dan lebih durhaka","wa-aṭghā",2949]],"t":"dan (juga) kaum Nuh sebelum itu. Sungguh, mereka adalah orang-orang yang paling zalim dan paling durhaka."},{"n":53,"w":[["وَٱلْمُؤْتَفِكَةَ","dan Mu'tafikah","wal-mu'tafikata",1929],["أَهْوَىٰ","Dia hancurkan","ahwā",992]],"t":"Dan prahara angin telah meruntuhkan (negeri kaum Luṭ),"},{"n":54,"w":[["فَغَشَّىٰهَا","maka Dia menutupinya","faghashāhā",1862],["مَا","apa(azab)","mā",6],["غَشَّىٰ","menutupi/menimpa","ghashā",1862]],"t":"lalu menimbuni negeri itu (sebagai azab) dengan (puing-puing) yang menimpanya."},{"n":55,"w":[["فَبِأَىِّ","maka terhadap","fabi-ayyi",210],["ءَالَآءِ","atas","ālāi",353],["رَبِّكَ","Tuhanmu","rabbika",15],["تَتَمَارَىٰ","ragu","tatamārā",1682]],"t":"Maka terhadap nikmat Tuhanmu yang manakah yang masih kamu ragukan?"},{"n":56,"w":[["هَـٰذَا","Ini","hādhā",64],["نَذِيرٌۭ","pemberi peringatan","nadhīrun",216],["مِّنَ","dari","mina",1],["ٱلنُّذُرِ","antara pemberi peringatan","l-nudhuri",216],["ٱلْأُولَىٰٓ","terdahulu","l-ūlā",151]],"t":"Ini (Muhammad) salah seorang pemberi peringatan di antara para pemberi peringatan yang telah terdahulu."},{"n":57,"w":[["أَزِفَتِ","telah dekat","azifati",3048],["ٱلْـَٔازِفَةُ","kiamat","l-āzifatu",2120]],"t":"Yang dekat (hari Kiamat) telah makin mendekat."},{"n":58,"w":[["لَيْسَ","tidak","laysa",133],["لَهَا","padanya","lahā",106],["مِن","dari","min",1],["دُونِ","sisi","dūni",88],["ٱللَّهِ","Allah","l-lahi",4],["كَاشِفَةٌ","menyatakan","kāshifatun",1369]],"t":"Tidak ada yang akan dapat mengungkapkan (terjadinya hari itu) selain Allah."},{"n":59,"w":[["أَفَمِنْ","maka apakah","afamin",1],["هَـٰذَا","ini","hādhā",64],["ٱلْحَدِيثِ","pemberitaan","l-ḥadīthi",402],["تَعْجَبُونَ","kamu heran","taʿjabūna",973]],"t":"Maka apakah kamu merasa heran terhadap pemberitaan ini?"},{"n":60,"w":[["وَتَضْحَكُونَ","dan kamu mentertawakan","wataḍḥakūna",1055],["وَلَا","dan tidak","walā",8],["تَبْكُونَ","menangis","tabkūna",1338]],"t":"dan kamu tertawakan dan tidak menangis,"},{"n":61,"w":[["وَأَنتُمْ","dan kalian","wa-antum",96],["سَـٰمِدُونَ","melengahkan","sāmidūna",4253]],"t":"sedang kamu lengah (darinya)."},{"n":62,"w":[["فَٱسْجُدُوا۟","maka bersujudlah","fa-us'judū",350],["لِلَّهِ","kepada Allah","lillahi",4],["وَٱعْبُدُوا۟ ۩","dan sembahlah (Dia)","wa-uʿ'budū",108]],"t":"Maka bersujudlah kepada Allah dan sembahlah (Dia)!"}]