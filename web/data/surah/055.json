[{"n":1,"w":[["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","al-raḥmānu",212]],"t":"(Allah) Yang Maha Pengasih,"},{"n":2,"w":[["عَلَّمَ","Dia telah mengajarkan","ʿallama",281],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",175]],"t":"Yang telah mengajarkan Alquran."},{"n":3,"w":[["خَلَقَ","Dia telah menciptakan","khalaqa",60],["ٱلْإِنسَـٰنَ","manusia","l-insāna",167]],"t":"Dia menciptakan manusia,"},{"n":4,"w":[["عَلَّمَهُ","Dia mengajarkannya","ʿallamahu",281],["ٱلْبَيَانَ","jelas/terang","l-bayāna",1815]],"t":"mengajarnya pandai berbicara."},{"n":5,"w":[["ٱلشَّمْسُ","matahari","al-shamsu",342],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",407],["بِحُسْبَانٍۢ","dengan/menurut perhitungan","biḥus'bānin",1791]],"t":"Matahari dan bulan beredar menurut perhitungan,"},{"n":6,"w":[["وَٱلنَّجْمُ","dan bintang/tumbuh-tumbuhan","wal-najmu",694],["وَٱلشَّجَرُ","dan pohon-pohonan","wal-shajaru",1027],["يَسْجُدَانِ","keduanya tunduk/sujud","yasjudāni",334]],"t":"Bintang dan pepohonan, keduanya tunduk (kepada-Nya)."},{"n":7,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",38],["رَفَعَهَا","Dia tinggikannya","rafaʿahā",473],["وَوَضَعَ","dan Dia letakkan","wawaḍaʿa",497],["ٱلْمِيزَانَ","timbangan","l-mīzāna",600]],"t":"Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,"},{"n":8,"w":[["أَلَّا","supaya jangan","allā",17],["تَطْغَوْا۟","kamu melampui batas","taṭghaw",724],["فِى","dalam","fī",3],["ٱلْمِيزَانِ","neraca/timbangan","l-mīzāni",600]],"t":"agar kamu jangan merusak keseimbangan itu."},{"n":9,"w":[["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",220],["ٱلْوَزْنَ","neraca/timbangan","l-wazna",2028],["بِٱلْقِسْطِ","dengan adil","bil-qis'ṭi",636],["وَلَا","dan janganlah","walā",4],["تُخْسِرُوا۟","kamu mengurangi","tukh'sirū",2819],["ٱلْمِيزَانَ","neraca/timbangan","l-mīzāna",600]],"t":"Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu."},{"n":10,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَضَعَهَا","Dia letakkan/hamparkannya","waḍaʿahā",497],["لِلْ