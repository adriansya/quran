[{"n":1,"w":[["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","al-raḥmānu",212]],"t":"(Allah) Yang Maha Pengasih,"},{"n":2,"w":[["عَلَّمَ","Dia telah mengajarkan","ʿallama",284],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",178]],"t":"Yang telah mengajarkan Alquran."},{"n":3,"w":[["خَلَقَ","Dia telah menciptakan","khalaqa",61],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170]],"t":"Dia menciptakan manusia,"},{"n":4,"w":[["عَلَّمَهُ","Dia mengajarkannya","ʿallamahu",284],["ٱلْبَيَانَ","jelas/terang","l-bayāna",1824]],"t":"mengajarnya pandai berbicara."},{"n":5,"w":[["ٱلشَّمْسُ","matahari","al-shamsu",343],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",404],["بِحُسْبَانٍۢ","dengan/menurut perhitungan","biḥus'bānin",1802]],"t":"Matahari dan bulan beredar menurut perhitungan,"},{"n":6,"w":[["وَٱلنَّجْمُ","dan bintang/tumbuh-tumbuhan","wal-najmu",694],["وَٱلشَّجَرُ","dan pohon-pohonan","wal-shajaru",1022],["يَسْجُدَانِ","keduanya tunduk/sujud","yasjudāni",335]],"t":"Bintang dan pepohonan, keduanya tunduk (kepada-Nya)."},{"n":7,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",38],["رَفَعَهَا","Dia tinggikannya","rafaʿahā",470],["وَوَضَعَ","dan Dia letakkan","wawaḍaʿa",493],["ٱلْمِيزَانَ","timbangan","l-mīzāna",598]],"t":"Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,"},{"n":8,"w":[["أَلَّا","supaya jangan","allā",17],["تَطْغَوْا۟","kamu melampui batas","taṭghaw",725],["فِى","dalam","fī",3],["ٱلْمِيزَانِ","neraca/timbangan","l-mīzāni",598]],"t":"agar kamu jangan merusak keseimbangan itu."},{"n":9,"w":[["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",220],["ٱلْوَزْنَ","neraca/timbangan","l-wazna",2045],["بِٱلْقِسْطِ","dengan adil","bil-qis'ṭi",633],["وَلَا","dan janganlah","walā",4],["تُخْسِرُوا۟","kamu mengurangi","tukh'sirū",2188],["ٱلْمِيزَانَ","neraca/timbangan","l-mīzāna",598]],"t":"Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu."},{"n":10,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَضَعَهَا","Dia letakkan/hamparkannya","waḍaʿahā",493],["لِلْ