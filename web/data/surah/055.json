ِ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",337],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":26,"w":[["كُلُّ","tiap-tiap/segala","kullu",31],["مَنْ","siapa/apa","man",12],["عَلَيْهَا","atasnya","ʿalayhā",8],["فَانٍۢ","binasa","fānin",3407]],"t":"Semua yang ada di bumi itu akan binasa,"},{"n":27,"w":[["وَيَبْقَىٰ","dan tetap/kekal","wayabqā",1811],["وَجْهُ","wajah/zat","wajhu",166],["رَبِّكَ","Tuhanmu","rabbika",10],["ذُو","mempunyai","dhū",113],["ٱلْجَلَـٰلِ","kebesaran","l-jalāli",2399],["وَٱلْإِكْرَامِ","dan kemuliaan","wal-ik'rāmi",2140]],"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."},{"n":28,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",337],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":29,"w":[["يَسْـَٔلُهُۥ","akan meminta kepada-Nya","yasaluhu",105],["مَن","orang/makhluk","man",12],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["كُلَّ","setiap","kulla",31],["يَوْمٍ","hari","yawmin",25],["هُوَ","Dia","huwa",20],["فِى","pada","fī",3],["شَأْنٍۢ","kesibukan/urusan","shanin",1450]],"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan."},{"n":30,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",337],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":31,"w":[["سَنَفْرُغُ","Kami akan berurusan/bertindak","sanafrughu",2364],["لَكُمْ","bagi kalian","lakum",26],["أَيُّهَ","wahai","ayyuha",73],["ٱلثَّقَلَانِ","manusia dan jin","l-thaqalāni",1239]],"t":"Kami akan memberi perhatian s