ya matahari","l-maghribayni",841]],"t":"Tuhan (yang memelihara) dua Timur dan Tuhan (yang memelihara) dua Barat."},{"n":18,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":19,"w":[["مَرَجَ","Dia alirkan","maraja",2465],["ٱلْبَحْرَيْنِ","dua lautan","l-baḥrayni",286],["يَلْتَقِيَانِ","keduanya bertemu","yaltaqiyāni",1117]],"t":"Dia membiarkan dua laut mengalir yang (kemudian) keduanya bertemu,"},{"n":20,"w":[["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["بَرْزَخٌۭ","batas","barzakhun",1823],["لَّا","tidak","lā",4],["يَبْغِيَانِ","keduanya melampui","yabghiyāni",424]],"t":"di antara keduanya ada batas yang tidak dilampaui oleh masing-masing."},{"n":21,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","nikmat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":22,"w":[["يَخْرُجُ","keluar","yakhruju",225],["مِنْهُمَا","dari keduanya","min'humā",0],["ٱللُّؤْلُؤُ","mutiara","l-lu'lu-u",1192],["وَٱلْمَرْجَانُ","dan marjan","wal-marjānu",2470]],"t":"Dari keduanya keluar mutiara dan marjan."},{"n":23,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua mendustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":24,"w":[["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْجَوَارِ","kapal-kapal","l-jawāri",1345],["ٱلْمُنشَـَٔاتُ","yang timbul/tinggi","l-munshaātu",3827],["فِى","pada","fī",3],["ٱلْبَحْرِ","lautan","l-baḥri",286],["كَٱلْأَعْلَـٰمِ","laksana gunung-gunung","kal-aʿlāmi",2218]],"t":"Milik-Nyalah kapal-kapal yang berlayar di lautan bagaikan gunung-gunung."},{"n":25,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":26,"w":[["كُلُّ","tiap-tiap/segala","kullu",31],["مَنْ","siapa/apa","man",12],["عَلَيْهَا","atasnya","ʿalayhā",8],["فَانٍۢ","binasa","fānin",3400]],"t":"Semua yang ada di bumi itu akan binasa,"},{"n":27,"w":[["وَيَبْقَىٰ","dan tetap/kekal","wayabqā",1819],["وَجْهُ","wajah/zat","wajhu",169],["رَبِّكَ","Tuhanmu","rabbika",10],["ذُو","mempunyai","dhū",116],["ٱلْجَلَـٰلِ","kebesaran","l-jalāli",2395],["وَٱلْإِكْرَامِ","dan kemuliaan","wal-ik'rāmi",2117]],"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."},{"n":28,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":29,"w":[["يَسْـَٔلُهُۥ","akan meminta kepada-Nya","yasaluhu",108],["مَن","orang/makhluk","man",12],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["كُلَّ","setiap","kulla",31],["يَوْمٍ","hari","yawmin",25],["هُوَ","Dia","huwa",20],["فِى","pada","fī",3],["شَأْنٍۢ","kesibukan/urusan","shanin",1450]],"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan."},{"n":30,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":31,"w":[["سَنَفْرُغُ","Kami akan berurusan/bertindak","sanafrughu",2357],["لَكُمْ","bagi kalian","lakum",26],["أَيُّهَ","wahai","ayyuha",74],["ٱلثَّقَلَانِ","manusia dan jin","l-thaqalāni",1235]],"t":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!"},{"n":32,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","nikmat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":33,"w":[["يَـٰمَعْشَرَ","hai jama'ah","yāmaʿshara",1895],["ٱلْجِنِّ","jin","l-jini",465],["وَٱلْإِنسِ","dan manusia","wal-insi",536],["إِنِ","jika","ini",14],["ٱسْتَطَعْتُمْ","kamu mampu/sanggup","is'taṭaʿtum",282],["أَن","bahwa","an",17],["تَنفُذُوا۟","kamu menembus/melintasi","tanfudhū",1951],["مِنْ","dari","min",0],["أَقْطَارِ","penjuru","aqṭāri",2593],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["فَٱنفُذُوا۟ ۚ","maka tembuslah/lintasilah","fa-unfudhū",1951],["لَا","tidak","lā",4],["تَنفُذُونَ","kamu menembusnya","tanfudhūna",1951],["إِلَّا","kecuali","illā",15],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/kekuatan","bisul'ṭānin",323]],"t":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah)."},{"n":34,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",198],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":35,"w":[["يُرْسَلُ","akan dikirimkan","yur'salu",91],["عَلَيْكُمَا","atas kamu berdua","ʿalaykumā",8],["شُوَاظٌۭ","nyala","shuwāẓun",2851],["مِّن","dari","min",0],["نَّارٍۢ","api","nārin",78],["وَنُحَاسٌۭ","dan cairan tembaga","wanuḥāsun",4050],["فَلَا","maka tidak","falā",4],["تَنتَصِرَانِ","kamu berdua menolong/menyelamatkan diri","tantaṣirāni",1118]],"t":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya)."},{"n":36,"w":[["فَبِأَىِّ","maka yang mana