[{"n":1,"w":[["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","al-raḥmānu",224]],"t":"(Allah) Yang Maha Pengasih,"},{"n":2,"w":[["عَلَّمَ","Dia telah mengajarkan","ʿallama",298],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",189]],"t":"Yang telah mengajarkan Alquran."},{"n":3,"w":[["خَلَقَ","Dia telah menciptakan","khalaqa",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181]],"t":"Dia menciptakan manusia,"},{"n":4,"w":[["عَلَّمَهُ","Dia mengajarkannya","ʿallamahu",298],["ٱلْبَيَانَ","jelas/terang","l-bayāna",1842]],"t":"mengajarnya pandai berbicara."},{"n":5,"w":[["ٱلشَّمْسُ","matahari","al-shamsu",358],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",419],["بِحُسْبَانٍۢ","dengan/menurut perhitungan","biḥus'bānin",1820]],"t":"Matahari dan bulan beredar menurut perhitungan,"},{"n":6,"w":[["وَٱلنَّجْمُ","dan bintang/tumbuh-tumbuhan","wal-najmu",709],["وَٱلشَّجَرُ","dan pohon-pohonan","wal-shajaru",1040],["يَسْجُدَانِ","keduanya tunduk/sujud","yasjudāni",350]],"t":"Bintang dan pepohonan, keduanya tunduk (kepada-Nya)."},{"n":7,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",44],["رَفَعَهَا","Dia tinggikannya","rafaʿahā",484],["وَوَضَعَ","dan Dia letakkan","wawaḍaʿa",507],["ٱلْمِيزَانَ","timbangan","l-mīzāna",612]],"t":"Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,"},{"n":8,"w":[["أَلَّا","supaya jangan","allā",22],["تَطْغَوْا۟","kamu melampui batas","taṭghaw",740],["فِى","dalam","fī",7],["ٱلْمِيزَانِ","neraca/timbangan","l-mīzāni",612]],"t":"agar kamu jangan merusak keseimbangan itu."},{"n":9,"w":[["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",232],["ٱلْوَزْنَ","neraca/timbangan","l-wazna",2063],["بِٱلْقِسْطِ","dengan adil","bil-qis'ṭi",648],["وَلَا","dan janganlah","walā",8],["تُخْسِرُوا۟","kamu mengurangi","tukh'sirū",2206],["ٱلْمِيزَانَ","neraca/timbangan","l-mīzāna",612]],"t":"Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu."},{"n":10,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["وَضَعَهَا","Dia letakkan/hamparkannya","waḍaʿahā",507],["لِلْأَنَامِ","untuk makhluk","lil'anāmi",2999]],"t":"Dan bumi telah dibentangkan-Nya untuk makhluk(-Nya),"},{"n":11,"w":[["فِيهَا","didalamnya/padanya","fīhā",7],["فَـٰكِهَةٌۭ","buah-buahan","fākihatun",673],["وَٱلنَّخْلُ","dan pohon kurma","wal-nakhlu",564],["ذَاتُ","yang mempunyai","dhātu",112],["ٱلْأَكْمَامِ","kelopak mayang","l-akmāmi",2441]],"t":"di dalamnya ada buah-buahan dan pohon kurma yang mempunyai kelopak mayang,"},{"n":12,"w":[["وَٱلْحَبُّ","dan biji-bijian","wal-ḥabu",1068],["ذُو","mempunyai","dhū",112],["ٱلْعَصْفِ","kulit","l-ʿaṣfi",2227],["وَٱلرَّيْحَانُ","dan harum baunya","wal-rayḥānu",2641]],"t":"dan biji-bijian yang berkulit dan bunga-bunga yang harum baunya."},{"n":13,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":14,"w":[["خَلَقَ","Dia menciptakan","khalaqa",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["مِن","dari","min",1],["صَلْصَـٰلٍۢ","tanah liat","ṣalṣālin",1543],["كَٱلْفَخَّارِ","seperti tembikar","kal-fakhāri",3464]],"t":"Dia menciptakan manusia dari tanah kering seperti tembikar,"},{"n":15,"w":[["وَخَلَقَ","dan Dia menciptakan","wakhalaqa",70],["ٱلْجَآنَّ","jin","l-jāna",1088],["مِن","dari","min",1],["مَّارِجٍۢ","nyala api","mārijin",3925],["مِّن","dari","min",1],["نَّارٍۢ","api","nārin",87]],"t":"dan Dia menciptakan jin dari nyala api tanpa asap."},{"n":16,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhan kamu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":17,"w":[["رَبُّ","Tuhan/Pemelihara","rabbu",15],["ٱلْمَشْرِقَيْنِ","dua timur/dua tempat terbit matahari","l-mashriqayni",800],["وَرَبُّ","dan Tuhan/Pemelihara","warabbu",15],["ٱلْمَغْرِبَيْنِ","dua barat/dua tempat terbenamnya matahari","l-maghribayni",857]],"t":"Tuhan (yang memelihara) dua Timur dan Tuhan (yang memelihara) dua Barat."},{"n":18,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":19,"w":[["مَرَجَ","Dia alirkan","maraja",2482],["ٱلْبَحْرَيْنِ","dua lautan","l-baḥrayni",300],["يَلْتَقِيَانِ","keduanya bertemu","yaltaqiyāni",1135]],"t":"Dia membiarkan dua laut mengalir yang (kemudian) keduanya bertemu,"},{"n":20,"w":[["بَيْنَهُمَا","diantara keduanya","baynahumā",55],["بَرْزَخٌۭ","batas","barzakhun",1841],["لَّا","tidak","lā",8],["يَبْغِيَانِ","keduanya melampui","yabghiyāni",439]],"t":"di antara keduanya ada batas yang tidak dilampaui oleh masing-masing."},{"n":21,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","nikmat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":22,"w":[["يَخْرُجُ","keluar","yakhruju",237],["مِنْهُمَا","dari keduanya","min'humā",1],["ٱللُّؤْلُؤُ","mutiara","l-lu'lu-u",1210],["وَٱلْمَرْجَانُ","dan marjan","wal-marjānu",2487]],"t":"Dari keduanya keluar mutiara dan marjan."},{"n":23,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua mendustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":24,"w":[["وَلَهُ","dan bagi-Nya","walahu",21],["ٱلْجَوَارِ","kapal-kapal","l-jawāri",1363],["ٱلْمُنشَـَٔاتُ","yang timbul/tinggi","l-munshaātu",3844],["فِى","pada","fī",7],["ٱلْبَحْرِ","lautan","l-baḥri",300],["كَٱلْأَعْلَـٰمِ","laksana gunung-gunung","kal-aʿlāmi",2235]],"t":"Milik-Nyalah kapal-kapal yang berlayar di lautan bagaikan gunung-gunung."},{"n":25,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":26,"w":[["كُلُّ","tiap-tiap/segala","kullu",38],["مَنْ","siapa/apa","man",17],["عَلَيْهَا","atasnya","ʿalayhā",11],["فَانٍۢ","binasa","fānin",3417]],"t":"Semua yang ada di bumi itu akan binasa,"},{"n":27,"w":[["وَيَبْقَىٰ","dan tetap/kekal","wayabqā",1837],["وَجْهُ","wajah/zat","wajhu",180],["رَبِّكَ","Tuhanmu","rabbika",15],["ذُو","mempunyai","dhū",112],["ٱلْجَلَـٰلِ","kebesaran","l-jalāli",2413],["وَٱلْإِكْرَامِ","dan kemuliaan","wal-ik'rāmi",2135]],"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."},{"n":28,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":29,"w":[["يَسْـَٔلُهُۥ","akan meminta kepada-Nya","yasaluhu",119],["مَن","orang/makhluk","man",17],["فِى","pada","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",28],["كُلَّ","setiap","kulla",38],["يَوْمٍ","hari","yawmin",31],["هُوَ","Dia","huwa",25],["فِى","pada","fī",7],["شَأْنٍۢ","kesibukan/urusan","shanin",1468]],"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan."},{"n":30,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":31,"w":[["سَنَفْرُغُ","Kami akan berurusan/bertindak","sanafrughu",2375],["لَكُمْ","bagi kalian","lakum",32],["أَيُّهَ","wahai","ayyuha",83],["ٱلثَّقَلَانِ","manusia dan jin","l-thaqalāni",1253]],"t":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!"},{"n":32,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","nikmat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":33,"w":[["يَـٰمَعْشَرَ","hai jama'ah","yāmaʿshara",1913],["ٱلْجِنِّ","jin","l-jini",478],["وَٱلْإِنسِ","dan manusia","wal-insi",550],["إِنِ","jika","ini",19],["ٱسْتَطَعْتُمْ","kamu mampu/sanggup","is'taṭaʿtum",296],["أَن","bahwa","an",22],["تَنفُذُوا۟","kamu menembus/melintasi","tanfudhū",1969],["مِنْ","dari","min",1],["أَقْطَارِ","penjuru","aqṭāri",2610],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["فَٱنفُذُوا۟ ۚ","maka tembuslah/lintasilah","fa-unfudhū",1969],["لَا","tidak","lā",8],["تَنفُذُونَ","kamu menembusnya","tanfudhūna",1969],["إِلَّا","kecuali","illā",20],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/kekuatan","bisul'ṭānin",338]],"t":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah)."},{"n":34,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":35,"w":[["يُرْسَلُ","akan dikirimkan","yur'salu",100],["عَلَيْكُمَا","atas kamu berdua","ʿalaykumā",11],["شُوَاظٌۭ","nyala","shuwāẓun",2869],["مِّن","dari","min",1],["نَّارٍۢ","api","nārin",87],["وَنُحَاسٌۭ","dan cairan tembaga","wanuḥāsun",4067],["فَلَا","maka tidak","falā",8],["تَنتَصِرَانِ","kamu berdua menolong/menyelamatkan diri","tantaṣirāni",1136]],"t":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya)."},{"n":36,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":37,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["ٱنشَقَّتِ","terbelah","inshaqqati",1464],["ٱلسَّمَآءُ","langit","l-samāu",44],["فَكَانَتْ","lalu adalah/menjadi ia","fakānat",12],["وَرْدَةًۭ","mawar merah","wardatan",4499],["كَٱلدِّهَانِ","seperti minyak","kal-dihāni",3414]],"t":"Maka apabila langit telah terbelah dan menjadi merah mawar seperti (kilauan) minyak."},{"n":38,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":39,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",191],["لَّا","tidak","lā",8],["يُسْـَٔلُ","ditanya","yus'alu",119],["عَن","atas","ʿan",27],["ذَنۢبِهِۦٓ","dosanya","dhanbihi",329],["إِنسٌۭ","manusia","insun",550],["وَلَا","dan tidak","walā",8],["جَآنٌّۭ","jin","jānnun",1088]],"t":"Maka pada hari itu manusia dan jin tidak ditanya tentang dosanya."},{"n":40,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",210],["ءَالَآءِ","ni'mat","ālāi",353],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",15],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",72]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":41,"w":[["يُعْرَفُ","diketahui/dikenal","yuʿ'rafu",515],["ٱلْمُجْرِمُونَ","orang-orang yang berdosa","l-muj'rimūna",240],["بِسِيمَـٰهُمْ","dengan tanda-tanda mereka","bisīmāhum",1246],["فَيُؤْخَذُ","lalu dipegang/diambil","fayu'khadhu",103],["بِٱلنَّوَٰصِى","dengan umbun-umbun","bil-nawāṣī",1636],["وَٱلْأَقْدَامِ","dan kaki-kaki","wal-aqdāmi",1012]],"t":"Orang-orang yang berdosa itu diketahui dengan tanda-tandanya, lalu direnggut ubun-ubun dan kakinya."},{"n":42,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi