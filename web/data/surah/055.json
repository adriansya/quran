ِ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",343],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",64]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":26,"w":[["كُلُّ","tiap-tiap/segala","kullu",31],["مَنْ","siapa/apa","man",12],["عَلَيْهَا","atasnya","ʿalayhā",7],["فَانٍۢ","binasa","fānin",3405]],"t":"Semua yang ada di bumi itu akan binasa,"},{"n":27,"w":[["وَيَبْقَىٰ","dan tetap/kekal","wayabqā",1825],["وَجْهُ","wajah/zat","wajhu",170],["رَبِّكَ","Tuhanmu","rabbika",10],["ذُو","mempunyai","dhū",117],["ٱلْجَلَـٰلِ","kebesaran","l-jalāli",2401],["وَٱلْإِكْرَامِ","dan kemuliaan","wal-ik'rāmi",2123]],"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."},{"n":28,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",343],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",64]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":29,"w":[["يَسْـَٔلُهُۥ","akan meminta kepada-Nya","yasaluhu",109],["مَن","orang/makhluk","man",12],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["كُلَّ","setiap","kulla",31],["يَوْمٍ","hari","yawmin",25],["هُوَ","Dia","huwa",19],["فِى","pada","fī",3],["شَأْنٍۢ","kesibukan/urusan","shanin",1456]],"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan."},{"n":30,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",343],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",64]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":31,"w":[["سَنَفْرُغُ","Kami akan berurusan/bertindak","sanafrughu",2363],["لَكُمْ","bagi kalian","lakum",26],["أَيُّهَ","wahai","ayyuha",75],["ٱلثَّقَلَانِ","manusia dan jin","l-thaqalāni",1241]],"t":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!"},{"n":32,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","nikmat","ālāi",343],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",64]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":33,"w":[["يَـٰمَعْشَرَ","hai jama'ah","yāmaʿshara",1901],["ٱلْجِنِّ","jin","l-jini",470],["وَٱلْإِنسِ","dan manusia","wal-insi",541],["إِنِ","jika","ini",14],["ٱسْتَطَعْتُمْ","kamu mampu/sanggup","is'taṭaʿtum",286],["أَن","bahwa","an",17],["تَنفُذُوا۟","kamu menembus/melintasi","tanfudhū",1957],["مِنْ","dari","min",0],["أَقْطَارِ","penjuru","aqṭāri",2598],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["فَٱنفُذُوا۟ ۚ","maka tembuslah/lintasilah","fa-unfudhū",1957],["لَا","tidak","lā",4],["تَنفُذُونَ","kamu menembusnya","tanfudhūna",1957],["إِلَّا","kecuali","illā",15],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/kekuatan","bisul'ṭānin",328]],"t":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah)."},{"n":34,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",200],["ءَالَآءِ","ni'mat","ālāi",343],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",64]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":35,"w":[["يُرْسَلُ","akan dikirimkan","yur'salu",92],["عَلَيْكُمَا","atas kamu berdua","ʿalaykumā",7],["شُوَاظٌۭ","nyala","shuwāẓun",2857],["مِّن","dari","min",0],["نَّارٍۢ","api","nārin",79],["وَنُحَاسٌۭ","dan cairan tembaga","wanuḥāsun",4055],["فَلَا","maka tidak","falā",4],["تَنتَصِرَانِ","kamu berdua menolong/menyelamatkan diri","tantaṣirāni",1124]],"t":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya)."},{"n":36,"w":[["فَبِأَىِّ","maka yang mana