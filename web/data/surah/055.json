[{"n":1,"w":[["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","al-raḥmānu",214]],"t":"(Allah) Yang Maha Pengasih,"},{"n":2,"w":[["عَلَّمَ","Dia telah mengajarkan","ʿallama",288],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",179]],"t":"Yang telah mengajarkan Alquran."},{"n":3,"w":[["خَلَقَ","Dia telah menciptakan","khalaqa",62],["ٱلْإِنسَـٰنَ","manusia","l-insāna",171]],"t":"Dia menciptakan manusia,"},{"n":4,"w":[["عَلَّمَهُ","Dia mengajarkannya","ʿallamahu",288],["ٱلْبَيَانَ","jelas/terang","l-bayāna",1830]],"t":"mengajarnya pandai berbicara."},{"n":5,"w":[["ٱلشَّمْسُ","matahari","al-shamsu",348],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",409],["بِحُسْبَانٍۢ","dengan/menurut perhitungan","biḥus'bānin",1808]],"t":"Matahari dan bulan beredar menurut perhitungan,"},{"n":6,"w":[["وَٱلنَّجْمُ","dan bintang/tumbuh-tumbuhan","wal-najmu",699],["وَٱلشَّجَرُ","dan pohon-pohonan","wal-shajaru",1028],["يَسْجُدَانِ","keduanya tunduk/sujud","yasjudāni",340]],"t":"Bintang dan pepohonan, keduanya tunduk (kepada-Nya)."},{"n":7,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",37],["رَفَعَهَا","Dia tinggikannya","rafaʿahā",476],["وَوَضَعَ","dan Dia letakkan","wawaḍaʿa",499],["ٱلْمِيزَانَ","timbangan","l-mīzāna",603]],"t":"Dan langit telah ditinggikan-Nya dan Dia ciptakan keseimbangan,"},{"n":8,"w":[["أَلَّا","supaya jangan","allā",17],["تَطْغَوْا۟","kamu melampui batas","taṭghaw",730],["فِى","dalam","fī",3],["ٱلْمِيزَانِ","neraca/timbangan","l-mīzāni",603]],"t":"agar kamu jangan merusak keseimbangan itu."},{"n":9,"w":[["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",222],["ٱلْوَزْنَ","neraca/timbangan","l-wazna",2051],["بِٱلْقِسْطِ","dengan adil","bil-qis'ṭi",638],["وَلَا","dan janganlah","walā",4],["تُخْسِرُوا۟","kamu mengurangi","tukh'sirū",2194],["ٱلْمِيزَانَ","neraca/timbangan","l-mīzāna",603]],"t":"Dan tegakkanlah keseimbangan itu dengan adil dan janganlah kamu mengurangi keseimbangan itu."},{"n":10,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَضَعَهَا","Dia letakkan/hamparkannya","waḍaʿahā",499],["لِلْ