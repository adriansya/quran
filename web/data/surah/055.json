ِ","maka yang mana","fabi-ayyi",201],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":26,"w":[["كُلُّ","tiap-tiap/segala","kullu",31],["مَنْ","siapa/apa","man",12],["عَلَيْهَا","atasnya","ʿalayhā",8],["فَانٍۢ","binasa","fānin",3414]],"t":"Semua yang ada di bumi itu akan binasa,"},{"n":27,"w":[["وَيَبْقَىٰ","dan tetap/kekal","wayabqā",1816],["وَجْهُ","wajah/zat","wajhu",164],["رَبِّكَ","Tuhanmu","rabbika",10],["ذُو","mempunyai","dhū",113],["ٱلْجَلَـٰلِ","kebesaran","l-jalāli",2405],["وَٱلْإِكْرَامِ","dan kemuliaan","wal-ik'rāmi",2145]],"t":"tetapi wajah Tuhanmu yang memiliki kebesaran dan kemuliaan tetap kekal."},{"n":28,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",201],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":29,"w":[["يَسْـَٔلُهُۥ","akan meminta kepada-Nya","yasaluhu",105],["مَن","orang/makhluk","man",12],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["كُلَّ","setiap","kulla",31],["يَوْمٍ","hari","yawmin",25],["هُوَ","Dia","huwa",20],["فِى","pada","fī",3],["شَأْنٍۢ","kesibukan/urusan","shanin",1455]],"t":"Apa yang di langit dan di bumi selalu meminta kepada-Nya. Setiap waktu Dia dalam kesibukan."},{"n":30,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",201],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":31,"w":[["سَنَفْرُغُ","Kami akan berurusan/bertindak","sanafrughu",2370],["لَكُمْ","bagi kalian","lakum",26],["أَيُّهَ","wahai","ayyuha",73],["ٱلثَّقَلَانِ","manusia dan jin","l-thaqalāni",1243]],"t":"Kami akan memberi perhatian sepenuhnya kepadamu wahai (golongan) manusia dan jin!"},{"n":32,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",201],["ءَالَآءِ","nikmat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":33,"w":[["يَـٰمَعْشَرَ","hai jama'ah","yāmaʿshara",1885],["ٱلْجِنِّ","jin","l-jini",469],["وَٱلْإِنسِ","dan manusia","wal-insi",539],["إِنِ","jika","ini",14],["ٱسْتَطَعْتُمْ","kamu mampu/sanggup","is'taṭaʿtum",280],["أَن","bahwa","an",16],["تَنفُذُوا۟","kamu menembus/melintasi","tanfudhū",2016],["مِنْ","dari","min",0],["أَقْطَارِ","penjuru","aqṭāri",2190],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["فَٱنفُذُوا۟ ۚ","maka tembuslah/lintasilah","fa-unfudhū",2016],["لَا","tidak","lā",4],["تَنفُذُونَ","kamu menembusnya","tanfudhūna",2016],["إِلَّا","kecuali","illā",15],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/kekuatan","bisul'ṭānin",321]],"t":"Wahai golongan jin dan manusia! Jika kamu sanggup menembus (melintasi) penjuru langit dan bumi, maka tembuslah. Kamu tidak akan mampu menembusnya kecuali dengan kekuatan (dari Allah)."},{"n":34,"w":[["فَبِأَىِّ","maka yang mana","fabi-ayyi",201],["ءَالَآءِ","ni'mat","ālāi",338],["رَبِّكُمَا","Tuhanmu berdua","rabbikumā",10],["تُكَذِّبَانِ","kamu berdua dustakan","tukadhibāni",63]],"t":"Maka nikmat Tuhanmu yang manakah yang kamu dustakan?"},{"n":35,"w":[["يُرْسَلُ","akan dikirimkan","yur'salu",88],["عَلَيْكُمَا","atas kamu berdua","ʿalaykumā",8],["شُوَاظٌۭ","nyala","shuwāẓun",2901],["مِّن","dari","min",0],["نَّارٍۢ","api","nārin",77],["وَنُحَاسٌۭ","dan cairan tembaga","wanuḥāsun",4079],["فَلَا","maka tidak","falā",4],["تَنتَصِرَانِ","kamu berdua menolong/menyelamatkan diri","tantaṣirāni",1131]],"t":"Kepada kamu (jin dan manusia), akan dikirim nyala api dan cairan tembaga (panas) sehingga kamu tidak dapat menyelamatkan diri (darinya)."},{"n":36,"w":[["فَبِأَىِّ","maka yang mana