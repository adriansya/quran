"yang","alladhī",38],["لَهُۥ","bagiNya/mempunyai","lahu",16],["مُلْكُ","kerajaan","mul'ku",252],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","setiap","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["شَهِيدٌ","Maha Menyaksikan","shahīdun",216]],"t":"yang memiliki kerajaan langit dan bumi. Dan Allah Maha Menyaksikan segala sesuatu."},{"n":10,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["فَتَنُوا۟","mereka (menfitnah)","fatanū",455],["ٱلْمُؤْمِنِينَ","orang-orang mu'min (beriman) laki-laki","l-mu'minīna",55],["وَٱلْمُؤْمِنَـٰتِ","orang-orang mu'min (beriman) perempuan","wal-mu'mināti",55],["ثُمَّ","kemudian","thumma",34],["لَمْ","tidak","lam",32],["يَتُوبُوا۟","bertaubat","yatūbū",195],["فَلَهُمْ","maka mereka","falahum",11],["عَذَابُ","siksa/azab","ʿadhābu",36],["جَهَنَّمَ","neraka jahanam","jahannama",152],["وَلَهُمْ","dan bagi mereka","walahum",11],["عَذَابُ","siksa/azab","ʿadhābu",36],["ٱلْحَرِيقِ","membakar","l-ḥarīqi",1304]],"t":"Sungguh, orang-orang yang mendatangkan cobaan (bencana, membunuh, menyiksa) kepada orang-orang mukmin laki-laki dan perempuan lalu mereka tidak bertobat, maka mereka akan mendapat azab Jahanam dan mereka akan mendapat azab (neraka) yang membakar."},{"n":11,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","saleh","l-ṣāliḥāti",96],["لَهُمْ","bagi mereka","lahum",11],["جَنَّـٰتٌۭ","surga","jannātun",78],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",236],["ٱلْأَنْهَـٰرُ ۚ","sungai","l-anhāru",223],["ذَٰلِكَ","demikian/itu","dhālika",20],["ٱلْفَوْزُ","keberuntungan","l-fawzu",531],["ٱلْكَبِيرُ","besar","l-kabīru",292]],"t":"Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendap