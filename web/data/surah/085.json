","yang","alladhī",45],["لَهُۥ","bagiNya/mempunyai","lahu",21],["مُلْكُ","kerajaan","mul'ku",262],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",28],["وَٱللَّهُ","dan Allah","wal-lahu",4],["عَلَىٰ","atas","ʿalā",11],["كُلِّ","setiap","kulli",38],["شَىْءٍۢ","sesuatu","shayin",49],["شَهِيدٌ","Maha Menyaksikan","shahīdun",226]],"t":"yang memiliki kerajaan langit dan bumi. Dan Allah Maha Menyaksikan segala sesuatu."},{"n":10,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["فَتَنُوا۟","mereka (menfitnah)","fatanū",464],["ٱلْمُؤْمِنِينَ","orang-orang mu'min (beriman) laki-laki","l-mu'minīna",63],["وَٱلْمُؤْمِنَـٰتِ","orang-orang mu'min (beriman) perempuan","wal-mu'mināti",63],["ثُمَّ","kemudian","thumma",41],["لَمْ","tidak","lam",39],["يَتُوبُوا۟","bertaubat","yatūbū",205],["فَلَهُمْ","maka mereka","falahum",16],["عَذَابُ","siksa/azab","ʿadhābu",43],["جَهَنَّمَ","neraka jahanam","jahannama",162],["وَلَهُمْ","dan bagi mereka","walahum",16],["عَذَابُ","siksa/azab","ʿadhābu",43],["ٱلْحَرِيقِ","membakar","l-ḥarīqi",1316]],"t":"Sungguh, orang-orang yang mendatangkan cobaan (bencana, membunuh, menyiksa) kepada orang-orang mukmin laki-laki dan perempuan lalu mereka tidak bertobat, maka mereka akan mendapat azab Jahanam dan mereka akan mendapat azab (neraka) yang membakar."},{"n":11,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَعَمِلُوا۟","dan beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","saleh","l-ṣāliḥāti",104],["لَهُمْ","bagi mereka","lahum",16],["جَنَّـٰتٌۭ","surga","jannātun",86],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ ۚ","sungai","l-anhāru",233],["ذَٰلِكَ","demikian/itu","dhālika",26],["ٱلْفَوْزُ","keberuntungan","l-fawzu",540],["ٱلْكَبِيرُ","besar","l-kabīru",302]],"t":"Sungguh, orang-orang yang beriman dan mengerjakan kebajikan, mereka akan mendapat surga yang mengalir di bawahnya sungai-sungai, itulah kemenangan yang agung."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",9],["بَطْشَ","kekuatan (azab)","baṭsha",1834],["رَبِّكَ","Tuhanmu","rabbika",15],["لَشَدِيدٌ","benar-benar/sangat keras","lashadīdun",225]],"t":"Sungguh, azab Tuhanmu sangat keras."},{"n":13,"w":[["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["هُوَ","Dia","huwa",25],["يُبْدِئُ","Dia memulai menciptakan","yub'di-u",1746],["وَيُعِيدُ","dan Dia mengulangi","wayuʿīdu",551]],"t":"Sungguh, Dialah yang memulai penciptaan (makhluk) dan yang menghidupkannya (kembali)."},{"n":14,"w":[["وَهُوَ","dan Dia","wahuwa",25],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",131],["ٱلْوَدُودُ","Maha Pengasih","l-wadūdu",2732]],"t":"Dan Dialah Yang Maha Pengampun, Maha Pengasih,"},{"n":15,"w":[["ذُو","memiliki/mempunyai","dhū",112],["ٱلْعَرْشِ","'Arsy","l-ʿarshi",392],["ٱلْمَجِيدُ","maha Terpuji/Mulia","l-majīdu",1625]],"t":"Yang memiliki Arasy, lagi Mahamulia,"},{"n":16,"w":[["فَعَّالٌۭ","berbuat","faʿʿālun",2370],["لِّمَا","terhadap apa","limā",6],["يُرِيدُ","yang dikehendaki","yurīdu",92]],"t":"Mahakuasa berbuat apa yang Dia kehendaki."},{"n":17,"w":[["هَلْ","apakah","hal",128],["أَتَىٰكَ","datang kepadamu","atāka",56],["حَدِيثُ","berita","ḥadīthu",402],["ٱلْجُنُودِ","bala tentara","l-junūdi",394]],"t":"Sudahkah sampai kepadamu berita tentang bala tentara (penentang),"},{"n":18,"w":[["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["وَثَمُودَ","dan Samud","wathamūda",430]],"t":"(yaitu) Fir'aun dan Samud?"},{"n":19,"w":[["بَلِ","bahkan","bali",105],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["فِى","dalam","fī",7],["تَكْذِيبٍۢ","kedustaan","takdhībin",4374]],"t":"Memang orang-orang kafir (selalu) mendustakan,"},{"n":20,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",4],["مِن","dari","min",1],["وَرَآئِهِم","belakang mereka","warāihim",457],["مُّحِيطٌۢ","meliputi/mengepung","muḥīṭun",803]],"t":"padahal Allah mengepung dari belakang mere