t surga yang mengalir di bawahnya sungai-sungai, itulah kemenangan yang agung."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",5],["بَطْشَ","kekuatan (azab)","baṭsha",1816],["رَبِّكَ","Tuhanmu","rabbika",10],["لَشَدِيدٌ","benar-benar/sangat keras","lashadīdun",213]],"t":"Sungguh, azab Tuhanmu sangat keras."},{"n":13,"w":[["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",20],["يُبْدِئُ","Dia memulai menciptakan","yub'di-u",1728],["وَيُعِيدُ","dan Dia mengulangi","wayuʿīdu",537]],"t":"Sungguh, Dialah yang memulai penciptaan (makhluk) dan yang menghidupkannya (kembali)."},{"n":14,"w":[["وَهُوَ","dan Dia","wahuwa",20],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",121],["ٱلْوَدُودُ","Maha Pengasih","l-wadūdu",2716]],"t":"Dan Dialah Yang Maha Pengampun, Maha Pengasih,"},{"n":15,"w":[["ذُو","memiliki/mempunyai","dhū",116],["ٱلْعَرْشِ","'Arsy","l-ʿarshi",377],["ٱلْمَجِيدُ","maha Terpuji/Mulia","l-majīdu",1607]],"t":"Yang memiliki Arasy, lagi Mahamulia,"},{"n":16,"w":[["فَعَّالٌۭ","berbuat","faʿʿālun",2353],["لِّمَا","terhadap apa","limā",2],["يُرِيدُ","yang dikehendaki","yurīdu",83]],"t":"Mahakuasa berbuat apa yang Dia kehendaki."},{"n":17,"w":[["هَلْ","apakah","hal",118],["أَتَىٰكَ","datang kepadamu","atāka",48],["حَدِيثُ","berita","ḥadīthu",387],["ٱلْجُنُودِ","bala tentara","l-junūdi",379]],"t":"Sudahkah sampai kepadamu berita tentang bala tentara (penentang),"},{"n":18,"w":[["فِرْعَوْنَ","Fir'aun","fir'ʿawna",160],["وَثَمُودَ","dan Samud","wathamūda",415]],"t":"(yaitu) Fir'aun dan Samud?"},{"n":19,"w":[["بَلِ","bahkan","bali",96],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["فِى","dalam","fī",3],["تَكْذِيبٍۢ","kedustaan","takdhībin",4358]],"t":"Memang orang-orang kafir (selalu) mendustakan,"},{"n":20,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",1],["مِن","dari","min",0],["وَرَآئِهِم","belakang mereka","warāihim",442],["مُّحِيطٌۢ","meliputi/mengepung","muḥīṭun",788]],"t":"padahal Allah mengepung dari belakang mereka (sehin