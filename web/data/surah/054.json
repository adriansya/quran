[{"n":1,"w":[["ٱقْتَرَبَتِ","Telah dekat","iq'tarabati",1465],["ٱلسَّاعَةُ","saat itu","l-sāʿatu",263],["وَٱنشَقَّ","telah terbelah","wa-inshaqqa",1464],["ٱلْقَمَرُ","bulan","l-qamaru",419]],"t":"Saat (hari Kiamat) semakin dekat, bulan pun terbelah."},{"n":2,"w":[["وَإِن","Dan jika","wa-in",19],["يَرَوْا۟","melihat","yaraw",54],["ءَايَةًۭ","tanda (mu'jizat)","āyatan",34],["يُعْرِضُوا۟","mereka berpaling","yuʿ'riḍū",366],["وَيَقُولُوا۟","berkata","wayaqūlū",10],["سِحْرٌۭ","(Ini adalah) sihir","siḥ'run",408],["مُّسْتَمِرٌّۭ","yang terus menerus","mus'tamirrun",2557]],"t":"Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\""},{"n":3,"w":[["وَكَذَّبُوا۟","Dan mereka mendustakan","wakadhabū",72],["وَٱتَّبَعُوٓا۟","dan mengikuti","wa-ittabaʿū",95],["أَهْوَآءَهُمْ ۚ","nafsu mereka","ahwāahum",585],["وَكُلُّ","sedang tiap-tiap","wakullu",38],["أَمْرٍۢ","urusan","amrin",75],["مُّسْتَقِرٌّۭ","ada ketetapannya","mus'taqirrun",1965]],"t":"Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya."},{"n":4,"w":[["وَلَقَدْ","Dan sesungguhnya","walaqad",30],["جَآءَهُم","telah datang","jāahum",51],["مِّنَ","dari","mina",1],["ٱلْأَنۢبَآءِ","beberapa kisah","l-anbāi",396],["مَا","yang/apa-apa","mā",6],["فِيهِ","di dalamnya","fīhi",7],["مُزْدَجَرٌ","terdapat cegahan (dari kekafiran)","muz'dajarun",3914]],"t":"Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),"},{"n":5,"w":[["حِكْمَةٌۢ","itulah suatu hikmat","ḥik'matun",520],["بَـٰلِغَةٌۭ ۖ","yang sempurna","bālighatun",915],["فَمَا","maka apa-apa","famā",6],["تُغْنِ","tiada berguna","tugh'ni",285],["ٱلنُّذُرُ","peringatan-peringatan","l-nudhuru",216]],"t":"(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),"},{"n":6,"w":[["فَتَوَلَّ","Maka berpalinglah","fatawalla",160],["عَنْهُمْ ۘ","dari mereka","ʿanhum",27],["يَوْمَ","hari (ketika)","yawma",31],["يَدْعُ","seorang penyeru","yadʿu",74],["ٱلدَّاعِ","menyeru","l-dāʿi",1848],["إِلَىٰ","kepada","ilā",18],["شَىْءٍۢ","sesuatu","shayin",49],["نُّكُرٍ","yang tidak menyenangkan","nukurin",4091]],"t":"maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),"},{"n":7,"w":[["خُشَّعًا","sambil menundukkan","khushaʿan",685],["أَبْصَـٰرُهُمْ","pandangan-pandangan","abṣāruhum",260],["يَخْرُجُونَ","mereka keluar","yakhrujūna",237],["مِنَ","dari","mina",1],["ٱلْأَجْدَاثِ","kuburan","l-ajdāthi",1881],["كَأَنَّهُمْ","seakan-akan","ka-annahum",395],["جَرَادٌۭ","belalang","jarādun",2418],["مُّنتَشِرٌۭ","beterbangan","muntashirun",3985]],"t":"pandangan mereka tertunduk, ketika mereka keluar dari kuburan, seakan-akan mereka belalang yang beterbangan,"},{"n":8,"w":[["مُّهْطِعِينَ","datang dengan cepat","muh'ṭiʿīna",1937],["إِلَى","kepada","ilā",18],["ٱلدَّاعِ ۖ","penyeru","l-dāʿi",1848],["يَقُولُ","berkata","yaqūlu",10],["ٱلْكَـٰفِرُونَ","Orang-orang kafir","l-kāfirūna",79],["هَـٰذَا","ini","hādhā",64],["يَوْمٌ","hari","yawmun",31],["عَسِرٌۭ","berat","ʿasirun",3124]],"t":"dengan patuh mereka segera datang kepada penyeru itu. Orang-orang kafir berkata, \"Ini adalah hari yang sulit.\""},{"n":9,"w":[["۞ كَذَّبَتْ","mendustakan","kadhabat",72],["قَبْلَهُمْ","sebelum mereka","qablahum",59],["قَوْمُ","kaum","qawmu",33],["نُوحٍۢ","Nuh","nūḥin",287],["فَكَذَّبُوا۟","mendustakan","fakadhabū",72],["عَبْدَنَا","hamba Kami","ʿabdanā",99],["وَقَالُوا۟","mengatakan","waqālū",10],["مَجْنُونٌۭ","seorang gila","majnūnun",801],["وَٱزْدُجِرَ","ancaman","wa-uz'dujira",4694]],"t":"Sebelum mereka, kaum Nuh juga telah mendustakan (rasul), maka mereka mendustakan hamba Kami (Nuh) dan mengatakan, \"Dia orang gila!\" Lalu diusirnya dengan ancaman."},{"n":10,"w":[["فَدَعَا","Maka dia mengadu","fadaʿā",74],["رَبَّهُۥٓ","Rabbnya","rabbahu",15],["أَنِّى","aku ini","annī",36],["مَغْلُوبٌۭ","orang yang dikalahkan","maghlūbun",3707],["فَٱنتَصِرْ","maka tolonglah (aku)","fa-intaṣir",1136]],"t":"Maka dia (Nuh) mengadu kepada Tuhannya, \"Sesungguhnya aku telah dikalahkan, maka tolonglah (aku).\""},{"n":11,"w":[["فَفَتَحْنَآ","Maka Kami bukakan","fafataḥnā",606],["أَبْوَٰبَ","pintu-pintu","abwāba",414],["ٱلسَّمَآءِ","langit","l-samāi",44],["بِمَآءٍۢ","dengan air","bimāin",204],["مُّنْهَمِرٍۢ","yang tercurah","mun'hamirin",3983]],"t":"Lalu Kami bukakan pintu-pintu langit dengan (menurunkan) air yang tercurah,"},{"n":12,"w":[["وَفَجَّرْنَا","memancarkan","wafajjarnā",1191],["ٱلْأَرْضَ","bumi","l-arḍa",28],["عُيُونًۭا","mata air","ʿuyūnan",218],["فَٱلْتَقَى","maka bertemulah","fal-taqā",1135],["ٱلْمَآءُ","air-air","l-māu",204],["عَلَىٰٓ","atas","ʿalā",11],["أَمْرٍۢ","urusan","amrin",75],["قَدْ","sesungguhnya","qad",30],["قُدِرَ","ditetapkan","qudira",444]],"t":"dan Kami jadikan bumi menyemburkan mata-mata air maka bertemulah (air-air) itu sehinggga (meluap menimbulkan) keadaaan (bencana) yang telah ditetapkan."},{"n":13,"w":[["وَحَمَلْنَـٰهُ","dan Kami angkut","waḥamalnāhu",299],["عَلَىٰ","atas","ʿalā",11],["ذَاتِ","memiliki","dhāti",112],["أَلْوَٰحٍۢ","papan","alwāḥin",1376],["وَدُسُرٍۢ","dan kayu","wadusurin",3406]],"t":"Dan Kami angkut dia (Nuh) ke atas (kapal) yang terbuat dari papan dan pasak,"},{"n":14,"w":[["تَجْرِى","berlayar","tajrī",219],["بِأَعْيُنِنَا","dengan pemeliharaan Kami","bi-aʿyuninā",218],["جَزَآءًۭ","balasan","jazāan",290],["لِّمَن","bagi orang-orang","liman",17],["كَانَ","adalah","kāna",12],["كُفِرَ","diingkari","kufira",48]],"t":"yang berlayar dengan pemeliharaan (pengawasan) Kami sebagai balasan bagi orang yang telah diingkari (kaumnya)."},{"n":15,"w":[["وَلَقَد","dan sesungguhnya","walaqad",30],["تَّرَكْنَـٰهَآ","Kami telah jadikan","taraknāhā",308],["ءَايَةًۭ","pelajaran","āyatan",34],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","mengambil pelajaran","muddakirin",1224]],"t":"Dan sungguh, kapal itu telah Kami jadikan sebagai tanda (pelajaran). Maka adakah orang yang mau mengambil pelajaran?"},{"n":16,"w":[["فَكَيْفَ","maka alangkah","fakayfa",148],["كَانَ","adalah","kāna",12],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan ancamanKu","wanudhuri",216]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":17,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["يَسَّرْنَا","telah Kami mudahkan","yassarnā",820],["ٱلْقُرْءَانَ","Al-Qur'an","l-qur'āna",189],["لِلذِّكْرِ","untuk peringatan","lildhik'ri",163],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1224]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":18,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["عَادٌۭ","kaum 'Ad","ʿādun",449],["فَكَيْفَ","maka bagaimana/alangkah","fakayfa",148],["كَانَ","adalah","kāna",12],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",216]],"t":"Kaum 'Ād pun telah mendustakan. Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":19,"w":[["إِنَّآ","sesungguhnya Kami","innā",9],["أَرْسَلْنَا","Kami telah mengirimkan","arsalnā",100],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["رِيحًۭا","angin","rīḥan",397],["صَرْصَرًۭا","sangat kencang","ṣarṣaran",1822],["فِى","pada","fī",7],["يَوْمِ","hari","yawmi",31],["نَحْسٍۢ","na'as/sial","naḥsin",4028],["مُّسْتَمِرٍّۢ","tetap/terus menerus","mus'tamirrin",2557]],"t":"Sesungguhnya Kami telah menghembuskan angin yang sangat kencang kepada mereka pada hari nahas yang terus menerus,"},{"n":20,"w":[["تَنزِعُ","ia mencabut/menggelimpangkan","tanziʿu",867],["ٱلنَّاسَ","manusia","l-nāsa",60],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["أَعْجَازُ","batang","aʿjāzu",2234],["نَخْلٍۢ","korma","nakhlin",564],["مُّنقَعِرٍۢ","tercabut/tumbang","munqaʿirin",3984]],"t":"yang membuat manusia bergelimpangan, mereka bagaikan pohon-pohon kurma yang tumbang dengan akar-akarnya."},{"n":21,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",148],["كَانَ","adalah","kāna",12],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",216]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":22,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["يَسَّرْنَا","Kami mudahkan","yassarnā",820],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",189],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",163],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1224]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":23,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["ثَمُودُ","kaum Samud","thamūdu",430],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",216]],"t":"Kaum Samud pun telah mendustakan peringatan itu."},{"n":24,"w":[["فَقَالُوٓا۟","maka mereka berkata","faqālū",10],["أَبَشَرًۭا","apakah sesorang manusia","abasharan",333],["مِّنَّا","dari antar kita","minnā",1],["وَٰحِدًۭا","satu/sendiri","wāḥidan",388],["نَّتَّبِعُهُۥٓ","kita mengikutinya","nattabiʿuhu",95],["إِنَّآ","sesungguhnya","innā",9],["إِذًۭا","apabila","idhan",375],["لَّفِى","benar-benar dalam","lafī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["وَسُعُرٍ","dan dalam siksaan/gila","wasuʿurin",2671]],"t":"Maka mereka berkata, \"Bagaimana kita akan mengikuti seorang manusia (biasa) di antara kita? Sungguh, kalau begitu kita benar-benar telah sesat dan gila."},{"n":25,"w":[["أَءُلْقِىَ","apakah diturunkan","a-ul'qiya",183],["ٱلذِّكْرُ","peringatan","l-dhik'ru",163],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",11],["مِنۢ","dari","min",1],["بَيْنِنَا","antara kita","bayninā",55],["بَلْ","tetapi/bahkan","bal",105],["هُوَ","dia","huwa",25],["كَذَّابٌ","pendusta","kadhābun",1369],["أَشِرٌۭ","sombong","ashirun",2142]],"t":"Apakah wahyu itu diturunkan kepadanya di antara kita? Pastilah dia (Saleh) seorang yang sangat pendusta (dan) sombong.\""},{"n":26,"w":[["سَيَعْلَمُونَ","mereka akan mengetahui","sayaʿlamūna",35],["غَدًۭا","besok","ghadan",1355],["مَّنِ","dari","mani",17],["ٱلْكَذَّابُ","amat pendusta","l-kadhābu",1369],["ٱلْأَشِرُ","sombong","l-ashiru",2142]],"t":"Kelak mereka akan mengetahui siapa yang sebenarnya sangat pendusta (dan) sombong itu."},{"n":27,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["مُرْسِلُوا۟","mengirimkan","mur'silū",1395],["ٱلنَّاقَةِ","unta betina","l-nāqati",1106],["فِتْنَةًۭ","fitnah/cobaan","fit'natan",355],["لَّهُمْ","bagi mereka","lahum",16],["فَٱرْتَقِبْهُمْ","maka tungguhlah mereka","fa-ir'taqib'hum",1710],["وَٱصْطَبِرْ","dan bersabarlah","wa-iṣ'ṭabir",2092]],"t":"Sesungguhnya Kami akan mengirimkan unta betina sebagai cobaan bagi mereka, maka tunggulah mereka dan bersabarlah (Saleh)."},{"n":28,"w":[["وَنَبِّئْهُمْ","dan beritakan kepada mereka","wanabbi'hum",270],["أَنَّ","sesungguhnya/bahwasanya","anna",36],["ٱلْمَآءَ","air","l-māa",204],["قِسْمَةٌۢ","terbagi","qis'matun",1992],["بَيْنَهُمْ ۖ","diantara mereka","baynahum",55],["كُلُّ","tiap-tiap","kullu",38],["شِرْبٍۢ","minum","shir'bin",1721],["مُّحْتَضَرٌۭ","dihadiri","muḥ'taḍarun",3967]],"t":"Dan beritahukanlah kepada mereka bahwa air itu dibagi di antara mereka (dengan unta betina itu); setiap orang berhak mendapat giliran minum."},{"n":29,"w":[["فَنَادَوْا۟","maka mereka memanggil","fanādaw",283],["صَاحِبَهُمْ","kawan mereka","ṣāḥibahum",132],["فَتَعَاطَىٰ","lalu ia berbuat nekat","fataʿāṭā",4318],["فَعَقَرَ","maka ia memunuh/melukai","faʿaqara",1308]],"t":"Maka mereka memanggil kawannya, lalu dia menangkap (unta itu) dan memotongnya."},{"n":30,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",148],["كَانَ","adalah","kāna",12],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan peringatan-Ku","wanudhuri",216]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":31,"w":[["إِنَّآ","sesungguhnya","innā",9],["أَرْسَلْنَا","Kami kirimkan","arsalnā",100],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["صَيْحَةًۭ","suara keras","ṣayḥatan",696],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",379],["فَكَانُوا۟","maka jadilah mereka","fakānū",12],["كَهَشِيمِ","seperti rumput kering","kahashīmi",2398],["ٱلْمُحْتَظِرِ","pengumpul binatang/pemelihara ternak","l-muḥ'taẓiri",3806]],"t":"Kami kirimkan atas mereka satu suara yang keras mengguntur, maka jadilah mereka seperti batang-batang kering yang lapuk."},{"n":32,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["يَسَّرْنَا","Kami mudahkan","yassarnā",820],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",189],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",163],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1224]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":33,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["قَوْمُ","kaum","qawmu",33],["لُوطٍۭ","Lut","lūṭin",416],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",216]],"t":"Kaum Luṭ pun telah mendustakan peringatan itu."},{"n":34,"w":[["إِنَّآ","sesungguhnya Kami","innā",9],["أَرْسَلْنَا","Kami kirimkan","arsalnā",100],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["حَاصِبًا","angin yang mengandung batu","ḥāṣiban",1527],["إِلَّآ","kecuali","illā",20],["ءَالَ","atas","āla",423],["لُوطٍۢ ۖ","Lut","lūṭin",416],["نَّجَّيْنَـٰهُم","Kami selamatkan mereka","najjaynāhum",337],["بِسَحَرٍۢ","diakhir malam/sebelum fajar","bisaḥarin",2014]],"t":"Sesungguhnya Kami kirimkan kepada mereka badai yang membawa batu-batu (yang menimpa mereka), kecuali keluarga Luṭ. Kami selamatkan mereka sebelum fajar menyingsing,"},{"n":35,"w":[["نِّعْمَةًۭ","ni'mat","niʿ'matan",250],["مِّنْ","dari","min",1],["عِندِنَا ۚ","sisi Kami","ʿindinā",68],["كَذَٰلِكَ","demikianlah","kadhālika",26],["نَجْزِى","Kami memberi balasan","najzī",175],["مَن","orang","man",17],["شَكَرَ","ia bersyukur","shakara",267]],"t":"sebagai nikmat dari Kami. Demikianlah Kami memberi balasan kepada orang-orang yang bersyukur."},{"n":36,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["أَنذَرَهُم","ia memperingatkan mereka","andharahum",279],["بَطْشَتَنَا","balasan/azab Kami","baṭshatanā",2338],["فَتَمَارَوْا۟","maka (tetapi) mereka membantah/mendustakan","fatamāraw",1683],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",216]],"t":"Dan sungguh, dia (Luṭ) telah memperingatkan mereka akan hukuman Kami, tetapi mereka mendustakan peringatan-Ku."},{"n":37,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["رَٰوَدُوهُ","mereka membujuknya","rāwadūhu",1015],["عَن","dari","ʿan",27],["ضَيْفِهِۦ","tamunya","ḍayfihi",1300],["فَطَمَسْنَآ","lalu Kami butakan","faṭamasnā",1332],["أَعْيُنَهُمْ","mata-mata mereka","aʿyunahum",218],["فَذُوقُوا۟","maka rasakanlah","fadhūqū",339],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan peringatan/ancaman","wanudhuri",216]],"t":"Dan sungguh, mereka telah membujuknya (agar menyerahkan) tamunya (kepada mereka), lalu Kami butakan mata mereka, maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":38,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["صَبَّحَهُم","mengenai/menimpa mereka","ṣabbaḥahum",3249],["بُكْرَةً","pagi hari","buk'ratan",1078],["عَذَابٌۭ","azab","ʿadhābun",43],["مُّسْتَقِرٌّۭ","tetap","mus'taqirrun",1965]],"t":"Dan sungguh, pada esok harinya mereka benar-benar ditimpa azab yang tetap."},{"n":39,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",339],["عَذَابِى","azab-Ku","ʿadhābī",43],["وَنُذُرِ","dan peringatan","wanudhuri",216]],"t":"Maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":40,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["يَسَّرْنَا","Kami mudahkan","yassarnā",820],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",189],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",163],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1224]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":41,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["جَآءَ","datang","jāa",51],["ءَالَ","keluarga/kaum","āla",423],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["ٱلنُّذُرُ","pemberi peringatan/ancaman","l-nudhuru",216]],"t":"Dan sungguh, peringatan telah datang kepada keluarga Fir'aun."},{"n":42,"w":[["كَذَّبُوا۟","mereka telah mendustakan","kadhabū",72],["بِـَٔايَـٰتِنَا","pada ayat-ayat Kami","biāyātinā",34],["كُلِّهَا","semuanya","kullihā",38],["فَأَخَذْنَـٰهُمْ","maka Kami ambil/azab mereka","fa-akhadhnāhum",103],["أَخْذَ","dengan azab","akhdha",1154],["عَزِيزٍۢ","Maha Perkasa","ʿazīzin",124],["مُّقْتَدِرٍ","Maha Kuasa","muq'tadirin",1633]],"t":"Mereka mendustakan mukjizat-mukjizat Kami semuanya, maka Kami azab mereka dengan azab dari Żat Yang Mahaperkasa, Mahakuasa."},{"n":43,"w":[["أَكُفَّارُكُمْ","apakah orang-orang kafir dari kamu","akuffārukum",79],["خَيْرٌۭ","lebih baik","khayrun",69],["مِّنْ","dari","min",1],["أُو۟لَـٰٓئِكُمْ","mereka itu","ulāikum",1510],["أَمْ","atau","am",93],["لَكُم","bagi kalian","lakum",32],["بَرَآءَةٌۭ","berlepas diri","barāatun",2345],["فِى","pada","fī",7],["ٱلزُّبُرِ","Kitab-Kitab terdahulu","l-zuburi",881]],"t":"Apakah orang-orang kafir di lingkunganmu (kaum musyrikin) lebih baik dari mereka, ataukah kamu telah mempunyai jaminan kebebasan (dari azab) dalam kitab-kitab terdahulu?"},{"n":44,"w":[["أَمْ","atau","am",93],["يَقُولُونَ","mereka mengatakan","yaqūlūna",10],["نَحْنُ","kami","naḥnu",140],["جَمِيعٌۭ","semua/bersatu/golongan","jamīʿun",236],["مُّنتَصِرٌۭ","dapat menolong/menang","muntaṣirun",1632]],"t":"Atau mereka mengatakan, \"Kami ini golongan yang bersatu yang pasti menang.\""},{"n":45,"w":[["سَيُهْزَمُ","akan dihacurkan/dikalahkan","sayuh'zamu",2407],["ٱلْجَمْعُ","semua/golongan","l-jamʿu",702],["وَيُوَلُّونَ","dan mereka berpaling/mundur","wayuwallūna",389],["ٱلدُّبُرَ","belakang","l-dubura",560]],"t":"Golongan itu pasti akan dikalahkan dan mereka akan mundur ke belakang."},{"n":46,"w":[["بَلِ","bahkan","bali",105],["ٱلسَّاعَةُ","hari kiamat","l-sāʿatu",263],["مَوْعِدُهُمْ","dijanjikan pada mereka","mawʿiduhum",753],["وَٱلسَّاعَةُ","dan hari kiamat","wal-sāʿatu",263],["أَدْهَىٰ","lebih buruk/dahsyat","adhā",2965],["وَأَمَرُّ","dan lebih pahit","wa-amarru",2991]],"t":"Bahkan hari Kiamat itulah hari yang dijanjikan kepada mereka dan hari Kiamat itu lebih dahsyat dan lebih pahit."},{"n":47,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",240],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["وَسُعُرٍۢ","dan dalam siksaan/gila","wasuʿurin",2671]],"t":"Sungguh, orang-orang yang berdosa berada dalam kesesatan (di dunia) dan akan berada dalam neraka (di akhirat)."},{"n":48,"w":[["يَوْمَ","pada hari","yawma",31],["يُسْحَبُونَ","mereka diseret","yus'ḥabūna",2645],["فِى","pada","fī",7],["ٱلنَّارِ","api neraka","l-nāri",87],["عَلَىٰ","atas","ʿalā",11],["وُجُوهِهِمْ","muka-muka mereka","wujūhihim",180],["ذُوقُوا۟","rasakanlah","dhūqū",339],["مَسَّ","sentuhan","massa",2490],["سَقَرَ","api/neraka","saqara",1667]],"t":"Pada hari mereka diseret ke neraka pada wajahnya. (Dikatakan kepada mereka), \"Rasakanlah sentuhan api neraka.\""},{"n":49,"w":[["إِنَّا","sesunguhnya","innā",9],["كُلَّ","setiap","kulla",38],["شَىْءٍ","sesuatu","shayin",49],["خَلَقْنَـٰهُ","Kami menciptakannya","khalaqnāhu",70],["بِقَدَرٍۢ","dengan/menurut ukuran","biqadarin",810]],"t":"Sungguh, Kami menciptakan segala sesuatu menurut ukuran."},{"n":50,"w":[["وَمَآ","dan tidaklah","wamā",6],["أَمْرُنَآ","perintah Kami","amrunā",75],["إِلَّا","kecuali","illā",20],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",379],["كَلَمْحٍۭ","seperti/secepat kejapan","kalamḥin",2449],["بِٱلْبَصَرِ","dengan pandangan mata","bil-baṣari",260]],"t":"Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata."},{"n":51,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["أَهْلَكْنَآ","telah Kami binasakan","ahlaknā",243],["أَشْيَاعَكُمْ","orang yang serupa dengan kamu","ashyāʿakum",770],["فَهَلْ","maka adakah","fahal",128],["مِن","dari","min",1],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1224]],"t":"Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?"},{"n":52,"w":[["وَكُلُّ","dan setiap","wakullu",38],["شَىْءٍۢ","sesuatu","shayin",49],["فَعَلُوهُ","telah mereka kerjakannya","faʿalūhu",136],["فِى","dalam","fī",7],["ٱلزُّبُرِ","kitab","l-zuburi",881]],"t":"Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan."},{"n":53,"w":[["وَكُلُّ","dan setiap","wakullu",38],["صَغِيرٍۢ","yang kecil","ṣaghīrin",1325],["وَكَبِيرٍۢ","dan yang besar","wakabīrin",302],["مُّسْتَطَرٌ","tertulis","mus'taṭarun",3997]],"t":"Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis."},{"n":54,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",257],["فِى","dalam","fī",7],["جَنَّـٰتٍۢ","surga/kebun-kebun","jannātin",86],["وَنَهَرٍۢ","dan sungai-sungai","wanaharin",233]],"t":"Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,"},{"n":55,"w":[["فِى","dalam","fī",7],["مَقْعَدِ","tempat duduk","maqʿadi",1608],["صِدْقٍ","kebenaran","ṣid'qin",670],["عِندَ","disisi","ʿinda",68],["مَلِيكٍۢ","yang menguasi/Raja (Tuhan)","malīkin",3723],["مُّقْتَدِرٍۭ","berkuasa","muq'tadirin",1633]],"t":"di tempat yang disenangi di sisi Tuhan Yang Mahakuasa."}]