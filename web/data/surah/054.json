[{"n":1,"w":[["ٱقْتَرَبَتِ","Telah dekat","iq'tarabati",1453],["ٱلسَّاعَةُ","saat itu","l-sāʿatu",253],["وَٱنشَقَّ","telah terbelah","wa-inshaqqa",1452],["ٱلْقَمَرُ","bulan","l-qamaru",409]],"t":"Saat (hari Kiamat) semakin dekat, bulan pun terbelah."},{"n":2,"w":[["وَإِن","Dan jika","wa-in",14],["يَرَوْا۟","melihat","yaraw",46],["ءَايَةًۭ","tanda (mu'jizat)","āyatan",28],["يُعْرِضُوا۟","mereka berpaling","yuʿ'riḍū",356],["وَيَقُولُوا۟","berkata","wayaqūlū",6],["سِحْرٌۭ","(Ini adalah) sihir","siḥ'run",398],["مُّسْتَمِرٌّۭ","yang terus menerus","mus'tamirrun",2546]],"t":"Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\""},{"n":3,"w":[["وَكَذَّبُوا۟","Dan mereka mendustakan","wakadhabū",64],["وَٱتَّبَعُوٓا۟","dan mengikuti","wa-ittabaʿū",87],["أَهْوَآءَهُمْ ۚ","nafsu mereka","ahwāahum",576],["وَكُلُّ","sedang tiap-tiap","wakullu",31],["أَمْرٍۢ","urusan","amrin",67],["مُّسْتَقِرٌّۭ","ada ketetapannya","mus'taqirrun",1953]],"t":"Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya."},{"n":4,"w":[["وَلَقَدْ","Dan sesungguhnya","walaqad",24],["جَآءَهُم","telah datang","jāahum",43],["مِّنَ","dari","mina",0],["ٱلْأَنۢبَآءِ","beberapa kisah","l-anbāi",386],["مَا","yang/apa-apa","mā",2],["فِيهِ","di dalamnya","fīhi",3],["مُزْدَجَرٌ","terdapat cegahan (dari kekafiran)","muz'dajarun",3903]],"t":"Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),"},{"n":5,"w":[["حِكْمَةٌۢ","itulah suatu hikmat","ḥik'matun",511],["بَـٰلِغَةٌۭ ۖ","yang sempurna","bālighatun",903],["فَمَا","maka apa-apa","famā",2],["تُغْنِ","tiada berguna","tugh'ni",275],["ٱلنُّذُرُ","peringatan-peringatan","l-nudhuru",206]],"t":"(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),"},{"n":6,"w":[["فَتَوَلَّ","Maka berpalinglah","fatawalla",150],["عَنْهُمْ ۘ","dari mereka","ʿanhum",21],["يَوْمَ","hari (ketika)","yawma",25],["يَدْعُ","seorang penyeru","yadʿu",66],["ٱلدَّاعِ","menyeru","l-dāʿi",1836],["إِلَىٰ","kepada","ilā",13],["شَىْءٍۢ","sesuatu","shayin",41],["نُّكُرٍ","yang tidak menyenangkan","nukurin",4080]],"t":"maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),"},{"n":7,"w":[["خُشَّعًا","sambil menundukkan","khushaʿan",675],["أَبْصَـٰرُهُمْ","pandangan-pandangan","abṣāruhum",250],["يَخْرُجُونَ","mereka keluar","yakhrujūna",227],["مِنَ","dari","mina",0],["ٱلْأَجْدَاثِ","kuburan","l-ajdāthi",1869],["كَأَنَّهُمْ","seakan-akan","ka-annahum",385],["جَرَادٌۭ","belalang","jarādun",2407],["مُّنتَشِرٌۭ","beterbangan","muntashirun",3974]],"t":"pandangan mereka tertunduk, ketika mereka keluar dari kuburan, seakan-akan mereka belalang yang beterbangan,"},{"n":8,"w":[["مُّهْطِعِينَ","datang dengan cepat","muh'ṭiʿīna",1925],["إِلَى","kepada","ilā",13],["ٱلدَّاعِ ۖ","penyeru","l-dāʿi",1836],["يَقُولُ","berkata","yaqūlu",6],["ٱلْكَـٰفِرُونَ","Orang-orang kafir","l-kāfirūna",71],["هَـٰذَا","ini","hādhā",56],["يَوْمٌ","hari","yawmun",25],["عَسِرٌۭ","berat","ʿasirun",3113]],"t":"dengan patuh mereka segera datang kepada penyeru itu. Orang-orang kafir berkata, \"Ini adalah hari yang sulit.\""},{"n":9,"w":[["۞ كَذَّبَتْ","mendustakan","kadhabat",64],["قَبْلَهُمْ","sebelum mereka","qablahum",51],["قَوْمُ","kaum","qawmu",27],["نُوحٍۢ","Nuh","nūḥin",277],["فَكَذَّبُوا۟","mendustakan","fakadhabū",64],["عَبْدَنَا","hamba Kami","ʿabdanā",91],["وَقَالُوا۟","mengatakan","waqālū",6],["مَجْنُونٌۭ","seorang gila","majnūnun",791],["وَٱزْدُجِرَ","ancaman","wa-uz'dujira",4683]],"t":"Sebelum mereka, kaum Nuh juga telah mendustakan (rasul), maka mereka mendustakan hamba Kami (Nuh) dan mengatakan, \"Dia orang gila!\" Lalu diusirnya dengan ancaman."},{"n":10,"w":[["فَدَعَا","Maka dia mengadu","fadaʿā",66],["رَبَّهُۥٓ","Rabbnya","rabbahu",10],["أَنِّى","aku ini","annī",30],["مَغْلُوبٌۭ","orang yang dikalahkan","maghlūbun",3696],["فَٱنتَصِرْ","maka tolonglah (aku)","fa-intaṣir",1124]],"t":"Maka dia (Nuh) mengadu kepada Tuhannya, \"Sesungguhnya aku telah dikalahkan, maka tolonglah (aku).\""},{"n":11,"w":[["فَفَتَحْنَآ","Maka Kami bukakan","fafataḥnā",597],["أَبْوَٰبَ","pintu-pintu","abwāba",404],["ٱلسَّمَآءِ","langit","l-samāi",37],["بِمَآءٍۢ","dengan air","bimāin",194],["مُّنْهَمِرٍۢ","yang tercurah","mun'hamirin",3972]],"t":"Lalu Kami bukakan pintu-pintu langit dengan (menurunkan) air yang tercurah,"},{"n":12,"w":[["وَفَجَّرْنَا","memancarkan","wafajjarnā",1179],["ٱلْأَرْضَ","bumi","l-arḍa",22],["عُيُونًۭا","mata air","ʿuyūnan",208],["فَٱلْتَقَى","maka bertemulah","fal-taqā",1123],["ٱلْمَآءُ","air-air","l-māu",194],["عَلَىٰٓ","atas","ʿalā",7],["أَمْرٍۢ","urusan","amrin",67],["قَدْ","sesungguhnya","qad",24],["قُدِرَ","ditetapkan","qudira",434]],"t":"dan Kami jadikan bumi menyemburkan mata-mata air maka bertemulah (air-air) itu sehinggga (meluap menimbulkan) keadaaan (bencana) yang telah ditetapkan."},{"n":13,"w":[["وَحَمَلْنَـٰهُ","dan Kami angkut","waḥamalnāhu",289],["عَلَىٰ","atas","ʿalā",7],["ذَاتِ","memiliki","dhāti",117],["أَلْوَٰحٍۢ","papan","alwāḥin",1364],["وَدُسُرٍۢ","dan kayu","wadusurin",3395]],"t":"Dan Kami angkut dia (Nuh) ke atas (kapal) yang terbuat dari papan dan pasak,"},{"n":14,"w":[["تَجْرِى","berlayar","tajrī",209],["بِأَعْيُنِنَا","dengan pemeliharaan Kami","bi-aʿyuninā",208],["جَزَآءًۭ","balasan","jazāan",280],["لِّمَن","bagi orang-orang","liman",12],["كَانَ","adalah","kāna",8],["كُفِرَ","diingkari","kufira",40]],"t":"yang berlayar dengan pemeliharaan (pengawasan) Kami sebagai balasan bagi orang yang telah diingkari (kaumnya)."},{"n":15,"w":[["وَلَقَد","dan sesungguhnya","walaqad",24],["تَّرَكْنَـٰهَآ","Kami telah jadikan","taraknāhā",298],["ءَايَةًۭ","pelajaran","āyatan",28],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","mengambil pelajaran","muddakirin",1212]],"t":"Dan sungguh, kapal itu telah Kami jadikan sebagai tanda (pelajaran). Maka adakah orang yang mau mengambil pelajaran?"},{"n":16,"w":[["فَكَيْفَ","maka alangkah","fakayfa",139],["كَانَ","adalah","kāna",8],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan ancamanKu","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":17,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","telah Kami mudahkan","yassarnā",810],["ٱلْقُرْءَانَ","Al-Qur'an","l-qur'āna",179],["لِلذِّكْرِ","untuk peringatan","lildhik'ri",153],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1212]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":18,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",64],["عَادٌۭ","kaum 'Ad","ʿādun",439],["فَكَيْفَ","maka bagaimana/alangkah","fakayfa",139],["كَانَ","adalah","kāna",8],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",206]],"t":"Kaum 'Ād pun telah mendustakan. Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":19,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَرْسَلْنَا","Kami telah mengirimkan","arsalnā",92],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["رِيحًۭا","angin","rīḥan",387],["صَرْصَرًۭا","sangat kencang","ṣarṣaran",1810],["فِى","pada","fī",3],["يَوْمِ","hari","yawmi",25],["نَحْسٍۢ","na'as/sial","naḥsin",4017],["مُّسْتَمِرٍّۢ","tetap/terus menerus","mus'tamirrin",2546]],"t":"Sesungguhnya Kami telah menghembuskan angin yang sangat kencang kepada mereka pada hari nahas yang terus menerus,"},{"n":20,"w":[["تَنزِعُ","ia mencabut/menggelimpangkan","tanziʿu",856],["ٱلنَّاسَ","manusia","l-nāsa",52],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",385],["أَعْجَازُ","batang","aʿjāzu",2223],["نَخْلٍۢ","korma","nakhlin",555],["مُّنقَعِرٍۢ","tercabut/tumbang","munqaʿirin",3973]],"t":"yang membuat manusia bergelimpangan, mereka bagaikan pohon-pohon kurma yang tumbang dengan akar-akarnya."},{"n":21,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",139],["كَانَ","adalah","kāna",8],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":22,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",810],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",179],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",153],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1212]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":23,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",64],["ثَمُودُ","kaum Samud","thamūdu",420],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Kaum Samud pun telah mendustakan peringatan itu."},{"n":24,"w":[["فَقَالُوٓا۟","maka mereka berkata","faqālū",6],["أَبَشَرًۭا","apakah sesorang manusia","abasharan",323],["مِّنَّا","dari antar kita","minnā",0],["وَٰحِدًۭا","satu/sendiri","wāḥidan",378],["نَّتَّبِعُهُۥٓ","kita mengikutinya","nattabiʿuhu",87],["إِنَّآ","sesungguhnya","innā",5],["إِذًۭا","apabila","idhan",365],["لَّفِى","benar-benar dalam","lafī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",315],["وَسُعُرٍ","dan dalam siksaan/gila","wasuʿurin",2660]],"t":"Maka mereka berkata, \"Bagaimana kita akan mengikuti seorang manusia (biasa) di antara kita? Sungguh, kalau begitu kita benar-benar telah sesat dan gila."},{"n":25,"w":[["أَءُلْقِىَ","apakah diturunkan","a-ul'qiya",173],["ٱلذِّكْرُ","peringatan","l-dhik'ru",153],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",7],["مِنۢ","dari","min",0],["بَيْنِنَا","antara kita","bayninā",47],["بَلْ","tetapi/bahkan","bal",97],["هُوَ","dia","huwa",19],["كَذَّابٌ","pendusta","kadhābun",1357],["أَشِرٌۭ","sombong","ashirun",2130]],"t":"Apakah wahyu itu diturunkan kepadanya di antara kita? Pastilah dia (Saleh) seorang yang sangat pendusta (dan) sombong.\""},{"n":26,"w":[["سَيَعْلَمُونَ","mereka akan mengetahui","sayaʿlamūna",29],["غَدًۭا","besok","ghadan",1343],["مَّنِ","dari","mani",12],["ٱلْكَذَّابُ","amat pendusta","l-kadhābu",1357],["ٱلْأَشِرُ","sombong","l-ashiru",2130]],"t":"Kelak mereka akan mengetahui siapa yang sebenarnya sangat pendusta (dan) sombong itu."},{"n":27,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["مُرْسِلُوا۟","mengirimkan","mur'silū",1383],["ٱلنَّاقَةِ","unta betina","l-nāqati",1094],["فِتْنَةًۭ","fitnah/cobaan","fit'natan",345],["لَّهُمْ","bagi mereka","lahum",11],["فَٱرْتَقِبْهُمْ","maka tungguhlah mereka","fa-ir'taqib'hum",1698],["وَٱصْطَبِرْ","dan bersabarlah","wa-iṣ'ṭabir",2080]],"t":"Sesungguhnya Kami akan mengirimkan unta betina sebagai cobaan bagi mereka, maka tunggulah mereka dan bersabarlah (Saleh)."},{"n":28,"w":[["وَنَبِّئْهُمْ","dan beritakan kepada mereka","wanabbi'hum",260],["أَنَّ","sesungguhnya/bahwasanya","anna",30],["ٱلْمَآءَ","air","l-māa",194],["قِسْمَةٌۢ","terbagi","qis'matun",1980],["بَيْنَهُمْ ۖ","diantara mereka","baynahum",47],["كُلُّ","tiap-tiap","kullu",31],["شِرْبٍۢ","minum","shir'bin",1709],["مُّحْتَضَرٌۭ","dihadiri","muḥ'taḍarun",3956]],"t":"Dan beritahukanlah kepada mereka bahwa air itu dibagi di antara mereka (dengan unta betina itu); setiap orang berhak mendapat giliran minum."},{"n":29,"w":[["فَنَادَوْا۟","maka mereka memanggil","fanādaw",273],["صَاحِبَهُمْ","kawan mereka","ṣāḥibahum",123],["فَتَعَاطَىٰ","lalu ia berbuat nekat","fataʿāṭā",4307],["فَعَقَرَ","maka ia memunuh/melukai","faʿaqara",1296]],"t":"Maka mereka memanggil kawannya, lalu dia menangkap (unta itu) dan memotongnya."},{"n":30,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",139],["كَانَ","adalah","kāna",8],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan-Ku","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":31,"w":[["إِنَّآ","sesungguhnya","innā",5],["أَرْسَلْنَا","Kami kirimkan","arsalnā",92],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["صَيْحَةًۭ","suara keras","ṣayḥatan",686],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",369],["فَكَانُوا۟","maka jadilah mereka","fakānū",8],["كَهَشِيمِ","seperti rumput kering","kahashīmi",2387],["ٱلْمُحْتَظِرِ","pengumpul binatang/pemelihara ternak","l-muḥ'taẓiri",3795]],"t":"Kami kirimkan atas mereka satu suara yang keras mengguntur, maka jadilah mereka seperti batang-batang kering yang lapuk."},{"n":32,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",810],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",179],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",153],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1212]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":33,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",64],["قَوْمُ","kaum","qawmu",27],["لُوطٍۭ","Lut","lūṭin",406],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Kaum Luṭ pun telah mendustakan peringatan itu."},{"n":34,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَرْسَلْنَا","Kami kirimkan","arsalnā",92],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["حَاصِبًا","angin yang mengandung batu","ḥāṣiban",1515],["إِلَّآ","kecuali","illā",15],["ءَالَ","atas","āla",413],["لُوطٍۢ ۖ","Lut","lūṭin",406],["نَّجَّيْنَـٰهُم","Kami selamatkan mereka","najjaynāhum",327],["بِسَحَرٍۢ","diakhir malam/sebelum fajar","bisaḥarin",2002]],"t":"Sesungguhnya Kami kirimkan kepada mereka badai yang membawa batu-batu (yang menimpa mereka), kecuali keluarga Luṭ. Kami selamatkan mereka sebelum fajar menyingsing,"},{"n":35,"w":[["نِّعْمَةًۭ","ni'mat","niʿ'matan",240],["مِّنْ","dari","min",0],["عِندِنَا ۚ","sisi Kami","ʿindinā",60],["كَذَٰلِكَ","demikianlah","kadhālika",20],["نَجْزِى","Kami memberi balasan","najzī",165],["مَن","orang","man",12],["شَكَرَ","ia bersyukur","shakara",257]],"t":"sebagai nikmat dari Kami. Demikianlah Kami memberi balasan kepada orang-orang yang bersyukur."},{"n":36,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَنذَرَهُم","ia memperingatkan mereka","andharahum",269],["بَطْشَتَنَا","balasan/azab Kami","baṭshatanā",2327],["فَتَمَارَوْا۟","maka (tetapi) mereka membantah/mendustakan","fatamāraw",1671],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Dan sungguh, dia (Luṭ) telah memperingatkan mereka akan hukuman Kami, tetapi mereka mendustakan peringatan-Ku."},{"n":37,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["رَٰوَدُوهُ","mereka membujuknya","rāwadūhu",1004],["عَن","dari","ʿan",21],["ضَيْفِهِۦ","tamunya","ḍayfihi",1288],["فَطَمَسْنَآ","lalu Kami butakan","faṭamasnā",1320],["أَعْيُنَهُمْ","mata-mata mereka","aʿyunahum",208],["فَذُوقُوا۟","maka rasakanlah","fadhūqū",329],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman","wanudhuri",206]],"t":"Dan sungguh, mereka telah membujuknya (agar menyerahkan) tamunya (kepada mereka), lalu Kami butakan mata mereka, maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":38,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["صَبَّحَهُم","mengenai/menimpa mereka","ṣabbaḥahum",3238],["بُكْرَةً","pagi hari","buk'ratan",1066],["عَذَابٌۭ","azab","ʿadhābun",36],["مُّسْتَقِرٌّۭ","tetap","mus'taqirrun",1953]],"t":"Dan sungguh, pada esok harinya mereka benar-benar ditimpa azab yang tetap."},{"n":39,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",329],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan","wanudhuri",206]],"t":"Maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":40,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",810],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",179],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",153],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1212]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":41,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["جَآءَ","datang","jāa",43],["ءَالَ","keluarga/kaum","āla",413],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",161],["ٱلنُّذُرُ","pemberi peringatan/ancaman","l-nudhuru",206]],"t":"Dan sungguh, peringatan telah datang kepada keluarga Fir'aun."},{"n":42,"w":[["كَذَّبُوا۟","mereka telah mendustakan","kadhabū",64],["بِـَٔايَـٰتِنَا","pada ayat-ayat Kami","biāyātinā",28],["كُلِّهَا","semuanya","kullihā",31],["فَأَخَذْنَـٰهُمْ","maka Kami ambil/azab mereka","fa-akhadhnāhum",95],["أَخْذَ","dengan azab","akhdha",1142],["عَزِيزٍۢ","Maha Perkasa","ʿazīzin",114],["مُّقْتَدِرٍ","Maha Kuasa","muq'tadirin",1621]],"t":"Mereka mendustakan mukjizat-mukjizat Kami semuanya, maka Kami azab mereka dengan azab dari Żat Yang Mahaperkasa, Mahakuasa."},{"n":43,"w":[["أَكُفَّارُكُمْ","apakah orang-orang kafir dari kamu","akuffārukum",71],["خَيْرٌۭ","lebih baik","khayrun",61],["مِّنْ","dari","min",0],["أُو۟لَـٰٓئِكُمْ","mereka itu","ulāikum",1498],["أَمْ","atau","am",85],["لَكُم","bagi kalian","lakum",26],["بَرَآءَةٌۭ","berlepas diri","barāatun",2334],["فِى","pada","fī",3],["ٱلزُّبُرِ","Kitab-Kitab terdahulu","l-zuburi",870]],"t":"Apakah orang-orang kafir di lingkunganmu (kaum musyrikin) lebih baik dari mereka, ataukah kamu telah mempunyai jaminan kebebasan (dari azab) dalam kitab-kitab terdahulu?"},{"n":44,"w":[["أَمْ","atau","am",85],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["نَحْنُ","kami","naḥnu",131],["جَمِيعٌۭ","semua/bersatu/golongan","jamīʿun",226],["مُّنتَصِرٌۭ","dapat menolong/menang","muntaṣirun",1620]],"t":"Atau mereka mengatakan, \"Kami ini golongan yang bersatu yang pasti menang.\""},{"n":45,"w":[["سَيُهْزَمُ","akan dihacurkan/dikalahkan","sayuh'zamu",2396],["ٱلْجَمْعُ","semua/golongan","l-jamʿu",692],["وَيُوَلُّونَ","dan mereka berpaling/mundur","wayuwallūna",379],["ٱلدُّبُرَ","belakang","l-dubura",551]],"t":"Golongan itu pasti akan dikalahkan dan mereka akan mundur ke belakang."},{"n":46,"w":[["بَلِ","bahkan","bali",97],["ٱلسَّاعَةُ","hari kiamat","l-sāʿatu",253],["مَوْعِدُهُمْ","dijanjikan pada mereka","mawʿiduhum",743],["وَٱلسَّاعَةُ","dan hari kiamat","wal-sāʿatu",253],["أَدْهَىٰ","lebih buruk/dahsyat","adhā",2954],["وَأَمَرُّ","dan lebih pahit","wa-amarru",2980]],"t":"Bahkan hari Kiamat itulah hari yang dijanjikan kepada mereka dan hari Kiamat itu lebih dahsyat dan lebih pahit."},{"n":47,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",230],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",315],["وَسُعُرٍۢ","dan dalam siksaan/gila","wasuʿurin",2660]],"t":"Sungguh, orang-orang yang berdosa berada dalam kesesatan (di dunia) dan akan berada dalam neraka (di akhirat)."},{"n":48,"w":[["يَوْمَ","pada hari","yawma",25],["يُسْحَبُونَ","mereka diseret","yus'ḥabūna",2634],["فِى","pada","fī",3],["ٱلنَّارِ","api neraka","l-nāri",79],["عَلَىٰ","atas","ʿalā",7],["وُجُوهِهِمْ","muka-muka mereka","wujūhihim",170],["ذُوقُوا۟","rasakanlah","dhūqū",329],["مَسَّ","sentuhan","massa",2479],["سَقَرَ","api/neraka","saqara",1655]],"t":"Pada hari mereka diseret ke neraka pada wajahnya. (Dikatakan kepada mereka), \"Rasakanlah sentuhan api neraka.\""},{"n":49,"w":[["إِنَّا","sesunguhnya","innā",5],["كُلَّ","setiap","kulla",31],["شَىْءٍ","sesuatu","shayin",41],["خَلَقْنَـٰهُ","Kami menciptakannya","khalaqnāhu",62],["بِقَدَرٍۢ","dengan/menurut ukuran","biqadarin",800]],"t":"Sungguh, Kami menciptakan segala sesuatu menurut ukuran."},{"n":50,"w":[["وَمَآ","dan tidaklah","wamā",2],["أَمْرُنَآ","perintah Kami","amrunā",67],["إِلَّا","kecuali","illā",15],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",369],["كَلَمْحٍۭ","seperti/secepat kejapan","kalamḥin",2438],["بِٱلْبَصَرِ","dengan pandangan mata","bil-baṣari",250]],"t":"Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata."},{"n":51,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَهْلَكْنَآ","telah Kami binasakan","ahlaknā",233],["أَشْيَاعَكُمْ","orang yang serupa dengan kamu","ashyāʿakum",760],["فَهَلْ","maka adakah","fahal",119],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1212]],"t":"Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?"},{"n":52,"w":[["وَكُلُّ","dan setiap","wakullu",31],["شَىْءٍۢ","sesuatu","shayin",41],["فَعَلُوهُ","telah mereka kerjakannya","faʿalūhu",127],["فِى","dalam","fī",3],["ٱلزُّبُرِ","kitab","l-zuburi",870]],"t":"Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan."},{"n":53,"w":[["وَكُلُّ","dan setiap","wakullu",31],["صَغِيرٍۢ","yang kecil","ṣaghīrin",1313],["وَكَبِيرٍۢ","dan yang besar","wakabīrin",292],["مُّسْتَطَرٌ","tertulis","mus'taṭarun",3986]],"t":"Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis."},{"n":54,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",247],["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","surga/kebun-kebun","jannātin",78],["وَنَهَرٍۢ","dan sungai-sungai","wanaharin",223]],"t":"Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,"},{"n":55,"w":[["فِى","dalam","fī",3],["مَقْعَدِ","tempat duduk","maqʿadi",1596],["صِدْقٍ","kebenaran","ṣid'qin",660],["عِندَ","disisi","ʿinda",60],["مَلِيكٍۢ","yang menguasi/Raja (Tuhan)","malīkin",3712],["مُّقْتَدِرٍۭ","berkuasa","muq'tadirin",1621]],"t":"di tempat yang disenangi di sisi Tuhan Yang Mahakuasa."}]