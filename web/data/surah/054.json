[{"n":1,"w":[["ٱقْتَرَبَتِ","Telah dekat","iq'tarabati",1447],["ٱلسَّاعَةُ","saat itu","l-sāʿatu",250],["وَٱنشَقَّ","telah terbelah","wa-inshaqqa",1446],["ٱلْقَمَرُ","bulan","l-qamaru",407]],"t":"Saat (hari Kiamat) semakin dekat, bulan pun terbelah."},{"n":2,"w":[["وَإِن","Dan jika","wa-in",14],["يَرَوْا۟","melihat","yaraw",46],["ءَايَةًۭ","tanda (mu'jizat)","āyatan",28],["يُعْرِضُوا۟","mereka berpaling","yuʿ'riḍū",349],["وَيَقُولُوا۟","berkata","wayaqūlū",6],["سِحْرٌۭ","(Ini adalah) sihir","siḥ'run",393],["مُّسْتَمِرٌّۭ","yang terus menerus","mus'tamirrun",2542]],"t":"Dan jika mereka (orang-orang musyrikin) melihat suatu tanda (mukjizat), mereka berpaling dan berkata, \"(Ini adalah) sihir yang terus menerus.\""},{"n":3,"w":[["وَكَذَّبُوا۟","Dan mereka mendustakan","wakadhabū",63],["وَٱتَّبَعُوٓا۟","dan mengikuti","wa-ittabaʿū",84],["أَهْوَآءَهُمْ ۚ","nafsu mereka","ahwāahum",563],["وَكُلُّ","sedang tiap-tiap","wakullu",31],["أَمْرٍۢ","urusan","amrin",66],["مُّسْتَقِرٌّۭ","ada ketetapannya","mus'taqirrun",1938]],"t":"Dan mereka mendustakan (Muhammad) dan mengikuti nafsu mereka, padahal setiap urusan telah ada ketetapannya."},{"n":4,"w":[["وَلَقَدْ","Dan sesungguhnya","walaqad",24],["جَآءَهُم","telah datang","jāahum",43],["مِّنَ","dari","mina",0],["ٱلْأَنۢبَآءِ","beberapa kisah","l-anbāi",376],["مَا","yang/apa-apa","mā",2],["فِيهِ","di dalamnya","fīhi",3],["مُزْدَجَرٌ","terdapat cegahan (dari kekafiran)","muz'dajarun",3909]],"t":"Dan sungguh, telah datang kepada mereka beberapa kisah yang di dalamnya terdapat ancaman (terhadap kekafiran),"},{"n":5,"w":[["حِكْمَةٌۢ","itulah suatu hikmat","ḥik'matun",509],["بَـٰلِغَةٌۭ ۖ","yang sempurna","bālighatun",1808],["فَمَا","maka apa-apa","famā",2],["تُغْنِ","tiada berguna","tugh'ni",383],["ٱلنُّذُرُ","peringatan-peringatan","l-nudhuru",206]],"t":"(itulah) suatu hikmah yang sempurna, tetapi peringatan-peringatan itu tidak berguna (bagi mereka),"},{"n":6,"w":[["فَتَوَلَّ","Maka berpalinglah","fatawalla",146],["عَنْهُمْ ۘ","dari mereka","ʿanhum",21],["يَوْمَ","hari (ketika)","yawma",25],["يَدْعُ","seorang penyeru","yadʿu",65],["ٱلدَّاعِ","menyeru","l-dāʿi",1822],["إِلَىٰ","kepada","ilā",13],["شَىْءٍۢ","sesuatu","shayin",41],["نُّكُرٍ","yang tidak menyenangkan","nukurin",4109]],"t":"maka berpalinglah engkau (Muhammad) dari mereka pada hari (ketika) penyeru (malaikat) mengajak (mereka) kepada sesuatu yang tidak menyenangkan (hari pembalasan),"},{"n":7,"w":[["خُشَّعًا","sambil menundukkan","khushaʿan",674],["أَبْصَـٰرُهُمْ","pandangan-pandangan","abṣāruhum",247],["يَخْرُجُونَ","mereka keluar","yakhrujūna",225],["مِنَ","dari","mina",0],["ٱلْأَجْدَاثِ","kuburan","l-ajdāthi",1734],["كَأَنَّهُمْ","seakan-akan","ka-annahum",375],["جَرَادٌۭ","belalang","jarādun",2403],["مُّنتَشِرٌۭ","beterbangan","muntashirun",3989]],"t":"pandangan mereka tertunduk, ketika mereka keluar dari kuburan, seakan-akan mereka belalang yang beterbangan,"},{"n":8,"w":[["مُّهْطِعِينَ","datang dengan cepat","muh'ṭiʿīna",1907],["إِلَى","kepada","ilā",13],["ٱلدَّاعِ ۖ","penyeru","l-dāʿi",1822],["يَقُولُ","berkata","yaqūlu",6],["ٱلْكَـٰفِرُونَ","Orang-orang kafir","l-kāfirūna",90],["هَـٰذَا","ini","hādhā",37],["يَوْمٌ","hari","yawmun",25],["عَسِرٌۭ","berat","ʿasirun",3127]],"t":"dengan patuh mereka segera datang kepada penyeru itu. Orang-orang kafir berkata, \"Ini adalah hari yang sulit.\""},{"n":9,"w":[["۞ كَذَّبَتْ","mendustakan","kadhabat",63],["قَبْلَهُمْ","sebelum mereka","qablahum",51],["قَوْمُ","kaum","qawmu",27],["نُوحٍۢ","Nuh","nūḥin",272],["فَكَذَّبُوا۟","mendustakan","fakadhabū",63],["عَبْدَنَا","hamba Kami","ʿabdanā",87],["وَقَالُوا۟","mengatakan","waqālū",6],["مَجْنُونٌۭ","seorang gila","majnūnun",789],["وَٱزْدُجِرَ","ancaman","wa-uz'dujira",4862]],"t":"Sebelum mereka, kaum Nuh juga telah mendustakan (rasul), maka mereka mendustakan hamba Kami (Nuh) dan mengatakan, \"Dia orang gila!\" Lalu diusirnya dengan ancaman."},{"n":10,"w":[["فَدَعَا","Maka dia mengadu","fadaʿā",65],["رَبَّهُۥٓ","Rabbnya","rabbahu",10],["أَنِّى","aku ini","annī",30],["مَغْلُوبٌۭ","orang yang dikalahkan","maghlūbun",3676],["فَٱنتَصِرْ","maka tolonglah (aku)","fa-intaṣir",1127]],"t":"Maka dia (Nuh) mengadu kepada Tuhannya, \"Sesungguhnya aku telah dikalahkan, maka tolonglah (aku).\""},{"n":11,"w":[["فَفَتَحْنَآ","Maka Kami bukakan","fafataḥnā",595],["أَبْوَٰبَ","pintu-pintu","abwāba",399],["ٱلسَّمَآءِ","langit","l-samāi",38],["بِمَآءٍۢ","dengan air","bimāin",192],["مُّنْهَمِرٍۢ","yang tercurah","mun'hamirin",3987]],"t":"Lalu Kami bukakan pintu-pintu langit dengan (menurunkan) air yang tercurah,"},{"n":12,"w":[["وَفَجَّرْنَا","memancarkan","wafajjarnā",1181],["ٱلْأَرْضَ","bumi","l-arḍa",22],["عُيُونًۭا","mata air","ʿuyūnan",207],["فَٱلْتَقَى","maka bertemulah","fal-taqā",1126],["ٱلْمَآءُ","air-air","l-māu",192],["عَلَىٰٓ","atas","ʿalā",8],["أَمْرٍۢ","urusan","amrin",66],["قَدْ","sesungguhnya","qad",24],["قُدِرَ","ditetapkan","qudira",430]],"t":"dan Kami jadikan bumi menyemburkan mata-mata air maka bertemulah (air-air) itu sehinggga (meluap menimbulkan) keadaaan (bencana) yang telah ditetapkan."},{"n":13,"w":[["وَحَمَلْنَـٰهُ","dan Kami angkut","waḥamalnāhu",282],["عَلَىٰ","atas","ʿalā",8],["ذَاتِ","memiliki","dhāti",113],["أَلْوَٰحٍۢ","papan","alwāḥin",1352],["وَدُسُرٍۢ","dan kayu","wadusurin",3399]],"t":"Dan Kami angkut dia (Nuh) ke atas (kapal) yang terbuat dari papan dan pasak,"},{"n":14,"w":[["تَجْرِى","berlayar","tajrī",208],["بِأَعْيُنِنَا","dengan pemeliharaan Kami","bi-aʿyuninā",207],["جَزَآءًۭ","balasan","jazāan",275],["لِّمَن","bagi orang-orang","liman",12],["كَانَ","adalah","kāna",9],["كُفِرَ","diingkari","kufira",40]],"t":"yang berlayar dengan pemeliharaan (pengawasan) Kami sebagai balasan bagi orang yang telah diingkari (kaumnya)."},{"n":15,"w":[["وَلَقَد","dan sesungguhnya","walaqad",24],["تَّرَكْنَـٰهَآ","Kami telah jadikan","taraknāhā",291],["ءَايَةًۭ","pelajaran","āyatan",28],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","mengambil pelajaran","muddakirin",1211]],"t":"Dan sungguh, kapal itu telah Kami jadikan sebagai tanda (pelajaran). Maka adakah orang yang mau mengambil pelajaran?"},{"n":16,"w":[["فَكَيْفَ","maka alangkah","fakayfa",134],["كَانَ","adalah","kāna",9],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan ancamanKu","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":17,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","telah Kami mudahkan","yassarnā",808],["ٱلْقُرْءَانَ","Al-Qur'an","l-qur'āna",175],["لِلذِّكْرِ","untuk peringatan","lildhik'ri",149],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1211]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":18,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["عَادٌۭ","kaum 'Ad","ʿādun",436],["فَكَيْفَ","maka bagaimana/alangkah","fakayfa",134],["كَانَ","adalah","kāna",9],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",206]],"t":"Kaum 'Ād pun telah mendustakan. Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":19,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَرْسَلْنَا","Kami telah mengirimkan","arsalnā",88],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["رِيحًۭا","angin","rīḥan",378],["صَرْصَرًۭا","sangat kencang","ṣarṣaran",1794],["فِى","pada","fī",3],["يَوْمِ","hari","yawmi",25],["نَحْسٍۢ","na'as/sial","naḥsin",4029],["مُّسْتَمِرٍّۢ","tetap/terus menerus","mus'tamirrin",2542]],"t":"Sesungguhnya Kami telah menghembuskan angin yang sangat kencang kepada mereka pada hari nahas yang terus menerus,"},{"n":20,"w":[["تَنزِعُ","ia mencabut/menggelimpangkan","tanziʿu",854],["ٱلنَّاسَ","manusia","l-nāsa",52],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",375],["أَعْجَازُ","batang","aʿjāzu",2154],["نَخْلٍۢ","korma","nakhlin",796],["مُّنقَعِرٍۢ","tercabut/tumbang","munqaʿirin",3988]],"t":"yang membuat manusia bergelimpangan, mereka bagaikan pohon-pohon kurma yang tumbang dengan akar-akarnya."},{"n":21,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",134],["كَانَ","adalah","kāna",9],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman-Ku","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":22,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",808],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",175],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",149],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1211]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":23,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["ثَمُودُ","kaum Samud","thamūdu",417],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Kaum Samud pun telah mendustakan peringatan itu."},{"n":24,"w":[["فَقَالُوٓا۟","maka mereka berkata","faqālū",6],["أَبَشَرًۭا","apakah sesorang manusia","abasharan",315],["مِّنَّا","dari antar kita","minnā",0],["وَٰحِدًۭا","satu/sendiri","wāḥidan",368],["نَّتَّبِعُهُۥٓ","kita mengikutinya","nattabiʿuhu",84],["إِنَّآ","sesungguhnya","innā",5],["إِذًۭا","apabila","idhan",356],["لَّفِى","benar-benar dalam","lafī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",306],["وَسُعُرٍ","dan dalam siksaan/gila","wasuʿurin",2642]],"t":"Maka mereka berkata, \"Bagaimana kita akan mengikuti seorang manusia (biasa) di antara kita? Sungguh, kalau begitu kita benar-benar telah sesat dan gila."},{"n":25,"w":[["أَءُلْقِىَ","apakah diturunkan","a-ul'qiya",169],["ٱلذِّكْرُ","peringatan","l-dhik'ru",149],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",8],["مِنۢ","dari","min",0],["بَيْنِنَا","antara kita","bayninā",47],["بَلْ","tetapi/bahkan","bal",93],["هُوَ","dia","huwa",20],["كَذَّابٌ","pendusta","kadhābun",1346],["أَشِرٌۭ","sombong","ashirun",2147]],"t":"Apakah wahyu itu diturunkan kepadanya di antara kita? Pastilah dia (Saleh) seorang yang sangat pendusta (dan) sombong.\""},{"n":26,"w":[["سَيَعْلَمُونَ","mereka akan mengetahui","sayaʿlamūna",29],["غَدًۭا","besok","ghadan",1335],["مَّنِ","dari","mani",12],["ٱلْكَذَّابُ","amat pendusta","l-kadhābu",1346],["ٱلْأَشِرُ","sombong","l-ashiru",2147]],"t":"Kelak mereka akan mengetahui siapa yang sebenarnya sangat pendusta (dan) sombong itu."},{"n":27,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["مُرْسِلُوا۟","mengirimkan","mur'silū",1593],["ٱلنَّاقَةِ","unta betina","l-nāqati",1093],["فِتْنَةًۭ","fitnah/cobaan","fit'natan",339],["لَّهُمْ","bagi mereka","lahum",11],["فَٱرْتَقِبْهُمْ","maka tungguhlah mereka","fa-ir'taqib'hum",1696],["وَٱصْطَبِرْ","dan bersabarlah","wa-iṣ'ṭabir",2099]],"t":"Sesungguhnya Kami akan mengirimkan unta betina sebagai cobaan bagi mereka, maka tunggulah mereka dan bersabarlah (Saleh)."},{"n":28,"w":[["وَنَبِّئْهُمْ","dan beritakan kepada mereka","wanabbi'hum",255],["أَنَّ","sesungguhnya/bahwasanya","anna",30],["ٱلْمَآءَ","air","l-māa",192],["قِسْمَةٌۢ","terbagi","qis'matun",1965],["بَيْنَهُمْ ۖ","diantara mereka","baynahum",47],["كُلُّ","tiap-tiap","kullu",31],["شِرْبٍۢ","minum","shir'bin",1706],["مُّحْتَضَرٌۭ","dihadiri","muḥ'taḍarun",3970]],"t":"Dan beritahukanlah kepada mereka bahwa air itu dibagi di antara mereka (dengan unta betina itu); setiap orang berhak mendapat giliran minum."},{"n":29,"w":[["فَنَادَوْا۟","maka mereka memanggil","fanādaw",269],["صَاحِبَهُمْ","kawan mereka","ṣāḥibahum",824],["فَتَعَاطَىٰ","lalu ia berbuat nekat","fataʿāṭā",4330],["فَعَقَرَ","maka ia memunuh/melukai","faʿaqara",1295]],"t":"Maka mereka memanggil kawannya, lalu dia menangkap (unta itu) dan memotongnya."},{"n":30,"w":[["فَكَيْفَ","maka bagaimanakah","fakayfa",134],["كَانَ","adalah","kāna",9],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan-Ku","wanudhuri",206]],"t":"Maka betapa dahsyatnya azab-Ku dan peringatan-Ku!"},{"n":31,"w":[["إِنَّآ","sesungguhnya","innā",5],["أَرْسَلْنَا","Kami kirimkan","arsalnā",88],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["صَيْحَةًۭ","suara keras","ṣayḥatan",683],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",359],["فَكَانُوا۟","maka jadilah mereka","fakānū",9],["كَهَشِيمِ","seperti rumput kering","kahashīmi",2386],["ٱلْمُحْتَظِرِ","pengumpul binatang/pemelihara ternak","l-muḥ'taẓiri",3783]],"t":"Kami kirimkan atas mereka satu suara yang keras mengguntur, maka jadilah mereka seperti batang-batang kering yang lapuk."},{"n":32,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",808],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",175],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",149],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1211]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":33,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["قَوْمُ","kaum","qawmu",27],["لُوطٍۭ","Lut","lūṭin",403],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Kaum Luṭ pun telah mendustakan peringatan itu."},{"n":34,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَرْسَلْنَا","Kami kirimkan","arsalnā",88],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["حَاصِبًا","angin yang mengandung batu","ḥāṣiban",1509],["إِلَّآ","kecuali","illā",15],["ءَالَ","atas","āla",410],["لُوطٍۢ ۖ","Lut","lūṭin",403],["نَّجَّيْنَـٰهُم","Kami selamatkan mereka","najjaynāhum",319],["بِسَحَرٍۢ","diakhir malam/sebelum fajar","bisaḥarin",1984]],"t":"Sesungguhnya Kami kirimkan kepada mereka badai yang membawa batu-batu (yang menimpa mereka), kecuali keluarga Luṭ. Kami selamatkan mereka sebelum fajar menyingsing,"},{"n":35,"w":[["نِّعْمَةًۭ","ni'mat","niʿ'matan",237],["مِّنْ","dari","min",0],["عِندِنَا ۚ","sisi Kami","ʿindinā",59],["كَذَٰلِكَ","demikianlah","kadhālika",19],["نَجْزِى","Kami memberi balasan","najzī",161],["مَن","orang","man",12],["شَكَرَ","ia bersyukur","shakara",253]],"t":"sebagai nikmat dari Kami. Demikianlah Kami memberi balasan kepada orang-orang yang bersyukur."},{"n":36,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَنذَرَهُم","ia memperingatkan mereka","andharahum",264],["بَطْشَتَنَا","balasan/azab Kami","baṭshatanā",2328],["فَتَمَارَوْا۟","maka (tetapi) mereka membantah/mendustakan","fatamāraw",1648],["بِٱلنُّذُرِ","dengan peringatan/ancaman","bil-nudhuri",206]],"t":"Dan sungguh, dia (Luṭ) telah memperingatkan mereka akan hukuman Kami, tetapi mereka mendustakan peringatan-Ku."},{"n":37,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["رَٰوَدُوهُ","mereka membujuknya","rāwadūhu",999],["عَن","dari","ʿan",21],["ضَيْفِهِۦ","tamunya","ḍayfihi",1288],["فَطَمَسْنَآ","lalu Kami butakan","faṭamasnā",1318],["أَعْيُنَهُمْ","mata-mata mereka","aʿyunahum",207],["فَذُوقُوا۟","maka rasakanlah","fadhūqū",322],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan/ancaman","wanudhuri",206]],"t":"Dan sungguh, mereka telah membujuknya (agar menyerahkan) tamunya (kepada mereka), lalu Kami butakan mata mereka, maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":38,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["صَبَّحَهُم","mengenai/menimpa mereka","ṣabbaḥahum",3251],["بُكْرَةً","pagi hari","buk'ratan",1067],["عَذَابٌۭ","azab","ʿadhābun",36],["مُّسْتَقِرٌّۭ","tetap","mus'taqirrun",1938]],"t":"Dan sungguh, pada esok harinya mereka benar-benar ditimpa azab yang tetap."},{"n":39,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",322],["عَذَابِى","azab-Ku","ʿadhābī",36],["وَنُذُرِ","dan peringatan","wanudhuri",206]],"t":"Maka rasakanlah azab-Ku dan peringatan-Ku!"},{"n":40,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["يَسَّرْنَا","Kami mudahkan","yassarnā",808],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",175],["لِلذِّكْرِ","untuk peringatan/pelajaran","lildhik'ri",149],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang-orang yang memikirkan","muddakirin",1211]],"t":"Dan sungguh, telah Kami mudahkan Alquran untuk peringatan, maka adakah orang yang mau mengambil pelajaran?"},{"n":41,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["جَآءَ","datang","jāa",43],["ءَالَ","keluarga/kaum","āla",410],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",158],["ٱلنُّذُرُ","pemberi peringatan/ancaman","l-nudhuru",206]],"t":"Dan sungguh, peringatan telah datang kepada keluarga Fir'aun."},{"n":42,"w":[["كَذَّبُوا۟","mereka telah mendustakan","kadhabū",63],["بِـَٔايَـٰتِنَا","pada ayat-ayat Kami","biāyātinā",28],["كُلِّهَا","semuanya","kullihā",31],["فَأَخَذْنَـٰهُمْ","maka Kami ambil/azab mereka","fa-akhadhnāhum",92],["أَخْذَ","dengan azab","akhdha",1143],["عَزِيزٍۢ","Maha Perkasa","ʿazīzin",110],["مُّقْتَدِرٍ","Maha Kuasa","muq'tadirin",1606]],"t":"Mereka mendustakan mukjizat-mukjizat Kami semuanya, maka Kami azab mereka dengan azab dari Żat Yang Mahaperkasa, Mahakuasa."},{"n":43,"w":[["أَكُفَّارُكُمْ","apakah orang-orang kafir dari kamu","akuffārukum",402],["خَيْرٌۭ","lebih baik","khayrun",62],["مِّنْ","dari","min",0],["أُو۟لَـٰٓئِكُمْ","mereka itu","ulāikum",1491],["أَمْ","atau","am",82],["لَكُم","bagi kalian","lakum",26],["بَرَآءَةٌۭ","berlepas diri","barāatun",2337],["فِى","pada","fī",3],["ٱلزُّبُرِ","Kitab-Kitab terdahulu","l-zuburi",1122]],"t":"Apakah orang-orang kafir di lingkunganmu (kaum musyrikin) lebih baik dari mereka, ataukah kamu telah mempunyai jaminan kebebasan (dari azab) dalam kitab-kitab terdahulu?"},{"n":44,"w":[["أَمْ","atau","am",82],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["نَحْنُ","kami","naḥnu",126],["جَمِيعٌۭ","semua/bersatu/golongan","jamīʿun",224],["مُّنتَصِرٌۭ","dapat menolong/menang","muntaṣirun",1605]],"t":"Atau mereka mengatakan, \"Kami ini golongan yang bersatu yang pasti menang.\""},{"n":45,"w":[["سَيُهْزَمُ","akan dihacurkan/dikalahkan","sayuh'zamu",2394],["ٱلْجَمْعُ","semua/golongan","l-jamʿu",688],["وَيُوَلُّونَ","dan mereka berpaling/mundur","wayuwallūna",369],["ٱلدُّبُرَ","belakang","l-dubura",549]],"t":"Golongan itu pasti akan dikalahkan dan mereka akan mundur ke belakang."},{"n":46,"w":[["بَلِ","bahkan","bali",93],["ٱلسَّاعَةُ","hari kiamat","l-sāʿatu",250],["مَوْعِدُهُمْ","dijanjikan pada mereka","mawʿiduhum",736],["وَٱلسَّاعَةُ","dan hari kiamat","wal-sāʿatu",250],["أَدْهَىٰ","lebih buruk/dahsyat","adhā",2982],["وَأَمَرُّ","dan lebih pahit","wa-amarru",3010]],"t":"Bahkan hari Kiamat itulah hari yang dijanjikan kepada mereka dan hari Kiamat itu lebih dahsyat dan lebih pahit."},{"n":47,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",228],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",306],["وَسُعُرٍۢ","dan dalam siksaan/gila","wasuʿurin",2642]],"t":"Sungguh, orang-orang yang berdosa berada dalam kesesatan (di dunia) dan akan berada dalam neraka (di akhirat)."},{"n":48,"w":[["يَوْمَ","pada hari","yawma",25],["يُسْحَبُونَ","mereka diseret","yus'ḥabūna",2814],["فِى","pada","fī",3],["ٱلنَّارِ","api neraka","l-nāri",77],["عَلَىٰ","atas","ʿalā",8],["وُجُوهِهِمْ","muka-muka mereka","wujūhihim",166],["ذُوقُوا۟","rasakanlah","dhūqū",322],["مَسَّ","sentuhan","massa",2468],["سَقَرَ","api/neraka","saqara",1638]],"t":"Pada hari mereka diseret ke neraka pada wajahnya. (Dikatakan kepada mereka), \"Rasakanlah sentuhan api neraka.\""},{"n":49,"w":[["إِنَّا","sesunguhnya","innā",5],["كُلَّ","setiap","kulla",31],["شَىْءٍ","sesuatu","shayin",41],["خَلَقْنَـٰهُ","Kami menciptakannya","khalaqnāhu",60],["بِقَدَرٍۢ","dengan/menurut ukuran","biqadarin",797]],"t":"Sungguh, Kami menciptakan segala sesuatu menurut ukuran."},{"n":50,"w":[["وَمَآ","dan tidaklah","wamā",2],["أَمْرُنَآ","perintah Kami","amrunā",66],["إِلَّا","kecuali","illā",15],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",359],["كَلَمْحٍۭ","seperti/secepat kejapan","kalamḥin",2431],["بِٱلْبَصَرِ","dengan pandangan mata","bil-baṣari",247]],"t":"Dan perintah Kami hanyalah (dengan) satu perkataan seperti kejapan mata."},{"n":51,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَهْلَكْنَآ","telah Kami binasakan","ahlaknā",231],["أَشْيَاعَكُمْ","orang yang serupa dengan kamu","ashyāʿakum",757],["فَهَلْ","maka adakah","fahal",115],["مِن","dari","min",0],["مُّدَّكِرٍۢ","orang yang memikirkan","muddakirin",1211]],"t":"Dan sungguh, telah Kami binasakan orang yang serupa dengan kamu (kekafirannya). Maka adakah orang yang mau mengambil pelajaran?"},{"n":52,"w":[["وَكُلُّ","dan setiap","wakullu",31],["شَىْءٍۢ","sesuatu","shayin",41],["فَعَلُوهُ","telah mereka kerjakannya","faʿalūhu",122],["فِى","dalam","fī",3],["ٱلزُّبُرِ","kitab","l-zuburi",1122]],"t":"Dan segala sesuatu yang telah mereka perbuat tercatat dalam buku-buku catatan."},{"n":53,"w":[["وَكُلُّ","dan setiap","wakullu",31],["صَغِيرٍۢ","yang kecil","ṣaghīrin",1793],["وَكَبِيرٍۢ","dan yang besar","wakabīrin",290],["مُّسْتَطَرٌ","tertulis","mus'taṭarun",4003]],"t":"Dan segala (sesuatu) yang kecil maupun yang besar (semuanya) tertulis."},{"n":54,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",244],["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","surga/kebun-kebun","jannātin",76],["وَنَهَرٍۢ","dan sungai-sungai","wanaharin",221]],"t":"Sungguh, orang-orang yang bertakwa berada di taman-taman dan sungai-sungai,"},{"n":55,"w":[["فِى","dalam","fī",3],["مَقْعَدِ","tempat duduk","maqʿadi",1581],["صِدْقٍ","kebenaran","ṣid'qin",658],["عِندَ","disisi","ʿinda",59],["مَلِيكٍۢ","yang menguasi/Raja (Tuhan)","malīkin",3691],["مُّقْتَدِرٍۭ","berkuasa","muq'tadirin",1606]],"t":"di tempat yang disenangi di sisi Tuhan Yang Mahakuasa."}]