,601]],"t":"sekali lagi, celakalah dia! Bagaimana dia menetapkan?"},{"n":21,"w":[["ثُمَّ","kemudian","thumma",34],["نَظَرَ","dia memperhatikan/memikirkan","naẓara",125]],"t":"kemudian dia (merenung) memikirkan,"},{"n":22,"w":[["ثُمَّ","kemudian","thumma",34],["عَبَسَ","dia bermasam muka","ʿabasa",2233],["وَبَسَرَ","dan dia merengut","wabasara",3357]],"t":"lalu berwajah masam dan cemberut,"},{"n":23,"w":[["ثُمَّ","kemudian","thumma",34],["أَدْبَرَ","dia berpaling","adbara",1465],["وَٱسْتَكْبَرَ","dan dia menyombongkan diri","wa-is'takbara",297]],"t":"kemudian berpaling (dari kebenaran) dan menyombongkan diri,"},{"n":24,"w":[["فَقَالَ","lalu dia berkata","faqāla",6],["إِنْ","tidaklah","in",14],["هَـٰذَآ","ini","hādhā",37],["إِلَّا","kecuali","illā",15],["سِحْرٌۭ","sihir","siḥ'run",393],["يُؤْثَرُ","diceritakan/dipelajari","yu'tharu",4711]],"t":"lalu dia berkata, \"(Alquran) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu)."},{"n":25,"w":[["إِنْ","tidaklah","in",14],["هَـٰذَآ","ini","hādhā",37],["إِلَّا","kecuali","illā",15],["قَوْلُ","perkataan","qawlu",117],["ٱلْبَشَرِ","manusia","l-bashari",315]],"t":"Ini hanyalah perkataan manusia.\""},{"n":26,"w":[["سَأُصْلِيهِ","akan Aku masukkan dia","sa-uṣ'līhi",1488],["سَقَرَ","neraka saqar","saqara",1638]],"t":"Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,"},{"n":27,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu mengetahui","adrāka",562],["مَا","apa","mā",2],["سَقَرُ","neraka saqar","saqaru",1638]],"t":"Dan tahukah kamu apa (neraka) Saqar itu?"},{"n":28,"w":[["لَا","tidak","lā",4],["تُبْقِى","ia meninggalkan","tub'qī",4468],["وَلَا","dan tidak","walā",4],["تَذَرُ","ia membiarkan","tadharu",262]],"t":"Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,"},{"n":29,"w":[["لَوَّاحَةٌۭ","yang membakar","lawwāḥatun",3615],["لِّلْبَشَرِ","bagi manusia","lil'bashari",315]],"t":"yang menghanguskan kulit manusia."},{"n":30,"w":[["عَلَيْهَا","di atasnya","ʿalayhā",8],["تِسْعَةَ","sembilan","tis'ʿata",2691],["عَشَرَ","belas","ʿashara",1494]],"t":"Di atasnya ada sembilan belas (malaikat penjaga)."},{"n":31,"w":[["وَمَا","dan tidak","wamā",2],["جَعَلْنَآ","Kami jadikan","jaʿalnā",33],["أَصْحَـٰبَ","penghuni/penjaga","aṣḥāba",143],["ٱلنَّارِ","neraka","l-nāri",77],["إِلَّا","kecuali","illā",15],["مَلَـٰٓئِكَةًۭ ۙ","malaikat","malāikatan",123],["وَمَا","dan tidak","wamā",2],["جَعَلْنَا","Kami jadikan","jaʿalnā",33],["عِدَّتَهُمْ","bilangan mereka","ʿiddatahum",772],["إِلَّا","kecuali","illā",15],["فِتْنَةًۭ","fitnah/cobaan","fit'natan",339],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لِيَسْتَيْقِنَ","supaya meyakini","liyastayqina",2853],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",49],["وَيَزْدَادَ","dan bertambah","wayazdāda",1025],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِيمَـٰنًۭا ۙ","keimanan","īmānan",256],["وَلَا","dan tidak","walā",4],["يَرْتَابَ","ragu-ragu","yartāba",946],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",49],["وَٱلْمُؤْمِنُونَ ۙ","dan orang-orang yang beriman","wal-mu'minūna",56],["وَلِيَقُولَ","dan supaya mengatakan","waliyaqūla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["فِى","dalam","fī",3],["قُلُوبِهِم","hati mereka","qulūbihim",86],["مَّرَضٌۭ","penyakit","maraḍun",693],["وَٱلْكَـٰفِرُونَ","dan orang-orang kafir","wal-kāfirūna",90],["مَاذَآ","apakah","mādhā",415],["أَرَادَ","menghendaki","arāda",81],["ٱللَّهُ","Allah","l-lahu",1],["بِهَـٰذَا","dengan ini","bihādhā",37],["مَثَلًۭا ۚ","perumpamaan","mathalan",124],["كَذَٰلِكَ","demikianlah","kadhālika",19],["يُضِلُّ","menyesatkan","yuḍillu",185],["ٱللَّهُ","Allah","l-lahu",1],["مَن","siapa/orang","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَهْدِى","dan Dia memberi petunjuk","wayahdī",79],["مَن","siapa/orang","man",12],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["وَمَا","dan tidak","wamā",2],["يَعْلَمُ","mengetahui","yaʿlamu",29],["جُنُودَ","bala tentara","junūda",374],["رَبِّكَ","Tuhanmu","rabbika",10],["إِلَّا","kecuali","illā",15],["هُوَ ۚ","Dia","huwa",20],["وَمَا","dan tidaklah","wamā",2],["هِىَ","ia","hiya",190],["إِلَّا","kecuali","illā",15],["ذِكْرَىٰ","peringatan","dhik'rā",448],["لِلْبَشَرِ","bagi manusia","lil'bashari",315]],"t":"Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia."},{"n":32,"w":[["كَلَّا","sekali-kali tidak","kallā",346],["وَٱلْقَمَرِ","demi bulan","wal-qamari",407]],"t":"Tidak! Demi bulan,"},{"n":33,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",132],["إِذْ","tatkala","idh",53],["أَدْبَرَ","mundur/berlalu","adbara",1465]],"t":"dan demi malam ketika telah berlalu,"},{"n":34,"w":[["وَٱلصُّبْحِ","dan subuh","wal-ṣub'ḥi",1313],["إِذَآ","tatkala","idhā",23],["أَسْفَرَ","terbit/terang","asfara",3036]],"t":"dan demi subuh apabila mulai terang,"},{"n":35,"w":[["إِنَّهَا","sesungguhnya ia (saqar)","innahā",5],["لَإِحْدَى","salah satu","la-iḥ'dā",759],["ٱلْكُبَرِ","amat besar","l-kubari",1084]],"t":"sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,"},{"n":36,"w":[["نَذِيرًۭا","peringatan","nadhīran",206],["لِّلْبَشَرِ","bagi manusia","lil'bashari",315]],"t":"sebagai peringatan bagi manusia,"},{"n":37,"w":[["لِمَن","bagi siapa","liman",12],["شَآءَ","menghendaki","shāa",54],["مِنكُمْ","diantara kamu","minkum",0],["أَن","bahwa","an",17],["يَتَقَدَّمَ","akan maju","yataqaddama",2675],["أَوْ","atau","aw",42],["يَتَأَخَّرَ","akan mundur","yata-akhara",2003]],"t":"(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur."},{"n":38,"w":[["كُلُّ","tiap-tiap","kullu",31],["نَفْسٍۭ","jiwa/diri","nafsin",39],["بِمَا","terhadap apa","bimā",2],["كَسَبَتْ","ia usahakan/ia perbuat","kasabat",196],["رَهِينَةٌ","tergadai/terikat","rahīnatun",4179]],"t":"Setiap orang bertanggung jawab atas apa yang telah dilakukannya,"},{"n":39,"w":[["إِلَّآ","kecuali","illā",15],["أَصْحَـٰبَ","kaum/golongan","aṣḥāba",143],["ٱلْيَمِينِ","kanan","l-yamīni",184]],"t":"kecuali golongan kanan,"},{"n":40,"w":[["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","sorga","jannātin",76],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",939]],"t":"berada di dalam surga, mereka saling menanyakan,"},{"n":41,"w":[["عَنِ","dari/tentang","ʿani",21],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",228]],"t":"tentang (keadaan) orang-orang yang berdosa,"},{"n":42,"w":[["مَا","apa yang","mā",2],["سَلَكَكُمْ","memasukkan kamu","salakakum",741],["فِى","dalam","fī",3],["سَقَرَ","neraka saqar","saqara",1638]],"t":"\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\""},{"n":43,"w":[["قَالُوا۟","mereka berkata","qālū",6],["لَمْ","tidak ada","lam",32],["نَكُ","kami","naku",9],["مِنَ","dari","mina",0],["ٱلْمُصَلِّينَ","orang-orang yang mengerjakan sholat","l-muṣalīna",1903]],"t":"Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,"},{"n":44,"w":[["وَلَمْ","dan tidak ada","walam",32],["نَكُ","kami","naku",9],["نُطْعِمُ","kami memberi makan","nuṭ'ʿimu",677],["ٱلْمِسْكِينَ","orang-orang miskin","l-mis'kīna",457]],"t":"dan kami (juga) tidak memberi makan orang miskin,"},{"n":45,"w":[["وَكُنَّا","dan kami adalah","wakunnā",9],["نَخُوضُ","kam