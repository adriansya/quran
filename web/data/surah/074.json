آءُ ۚ","Dia kehendaki","yashāu",54],["وَمَا","dan tidak","wamā",2],["يَعْلَمُ","mengetahui","yaʿlamu",29],["جُنُودَ","bala tentara","junūda",384],["رَبِّكَ","Tuhanmu","rabbika",10],["إِلَّا","kecuali","illā",15],["هُوَ ۚ","Dia","huwa",19],["وَمَا","dan tidaklah","wamā",2],["هِىَ","ia","hiya",193],["إِلَّا","kecuali","illā",15],["ذِكْرَىٰ","peringatan","dhik'rā",449],["لِلْبَشَرِ","bagi manusia","lil'bashari",323]],"t":"Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia."},{"n":32,"w":[["كَلَّا","sekali-kali tidak","kallā",352],["وَٱلْقَمَرِ","demi bulan","wal-qamari",409]],"t":"Tidak! Demi bulan,"},{"n":33,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",137],["إِذْ","tatkala","idh",53],["أَدْبَرَ","mundur/berlalu","adbara",1474]],"t":"dan demi malam ketika telah berlalu,"},{"n":34,"w":[["وَٱلصُّبْحِ","dan subuh","wal-ṣub'ḥi",1317],["إِذَآ","tatkala","idhā",23],["أَسْفَرَ","terbit/terang","asfara",3010]],"t":"dan demi subuh apabila mulai terang,"},{"n":35,"w":[["إِنَّهَا","sesungguhnya ia (saqar)","innahā",5],["لَإِحْدَى","salah satu","la-iḥ'dā",762],["ٱلْكُبَرِ","amat besar","l-kubari",1084]],"t":"sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,"},{"n":36,"w":[["نَذِيرًۭا","peringatan","nadhīran",206],["لِّلْبَشَرِ","bagi manusia","lil'bashari",323]],"t":"sebagai peringatan bagi manusia,"},{"n":37,"w":[["لِمَن","bagi siapa","liman",12],["شَآءَ","menghendaki","shāa",54],["مِنكُمْ","diantara kamu","minkum",0],["أَن","bahwa","an",17],["يَتَقَدَّمَ","akan maju","yataqaddama",2688],["أَوْ","atau","aw",42],["يَتَأَخَّرَ","akan mundur","yata-akhara",2023]],"t":"(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur."},{"n":38,"w":[["كُلُّ","tiap-tiap","kullu",31],["نَفْسٍۭ","jiwa/diri","nafsin",39],["بِمَا","terhadap apa","bimā",2],["كَسَبَتْ","ia usahakan/ia perbuat","kasabat",196],["رَهِينَةٌ","tergadai/terikat","rahīnatun",4165]],"t":"Setiap orang bertanggung jawab atas apa yang telah dilakukannya,"},{"n":39,"w":[["إِلَّآ","kecuali","illā",15],["أَصْحَـٰبَ","kaum/golongan","aṣḥāba",123],["ٱلْيَمِينِ","kanan","l-yamīni",188]],"t":"kecuali golongan kanan,"},{"n":40,"w":[["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","sorga","jannātin",78],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",940]],"t":"berada di dalam surga, mereka saling menanyakan,"},{"n":41,"w":[["عَنِ","dari/tentang","ʿani",21],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",230]],"t":"tentang (keadaan) orang-orang yang berdosa,"},{"n":42,"w":[["مَا","apa yang","mā",2],["سَلَكَكُمْ","memasukkan kamu","salakakum",749],["فِى","dalam","fī",3],["سَقَرَ","neraka saqar","saqara",1655]],"t":"\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\""},{"n":43,"w":[["قَالُوا۟","mereka berkata","qālū",6],["لَمْ","tidak ada","lam",32],["نَكُ","kami","naku",8],["مِنَ","dari","mina",0],["ٱلْمُصَلِّينَ","orang-orang yang mengerjakan sholat","l-muṣalīna",1921]],"t":"Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,"},{"n":44,"w":[["وَلَمْ","dan tidak ada","walam",32],["نَكُ","kami","naku",8],["نُطْعِمُ","kami memberi makan","nuṭ'ʿimu",678],["ٱلْمِسْكِينَ","orang-orang miskin","l-mis'kīna",458]],"t":"dan kami (juga) tidak memberi makan orang miskin,"},{"n":45,"w":[["وَكُنَّا","dan kami adalah","wakunnā",8],["نَخُوضُ","kami 