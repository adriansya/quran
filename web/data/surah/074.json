[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلْمُدَّثِّرُ","orang yang berkemul","l-mudathiru",3827]],"t":"Wahai orang yang berkemul (berselimut)!"},{"n":2,"w":[["قُمْ","bangunlah","qum",364],["فَأَنذِرْ","lalu berilah peringatan","fa-andhir",279]],"t":"bangunlah, lalu berilah peringatan!"},{"n":3,"w":[["وَرَبَّكَ","dan Tuhanmu","warabbaka",15],["فَكَبِّرْ","maka besarkan/agungkan","fakabbir",1590]],"t":"dan agungkanlah Tuhanmu,"},{"n":4,"w":[["وَثِيَابَكَ","dan pakaianmu","wathiyābaka",1022],["فَطَهِّرْ","maka bersihkan","faṭahhir",909]],"t":"dan bersihkanlah pakaianmu,"},{"n":5,"w":[["وَٱلرُّجْزَ","dan perbuatan dosa","wal-ruj'za",4229],["فَٱهْجُرْ","maka tinggalkan","fa-uh'jur",1361]],"t":"dan tinggalkanlah segala (perbuatan) yang keji,"},{"n":6,"w":[["وَلَا","dan jangan","walā",8],["تَمْنُن","kamu memberi/anugerah","tamnun",610],["تَسْتَكْثِرُ","kamu mengharap lebih banyak","tastakthiru",2103]],"t":"dan janganlah engkau (Muhammad) memberi (dengan maksud) memperoleh (balasan) yang lebih banyak."},{"n":7,"w":[["وَلِرَبِّكَ","dan untuk Tuhanmu","walirabbika",15],["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",215]],"t":"Dan karena Tuhanmu, bersabarlah."},{"n":8,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["نُقِرَ","ditiup","nuqira",4050],["فِى","pada","fī",7],["ٱلنَّاقُورِ","sangkakala","l-nāqūri",4075]],"t":"Maka apabila sangkakala ditiup,"},{"n":9,"w":[["فَذَٰلِكَ","maka demikian itu","fadhālika",26],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["يَوْمٌ","hari","yawmun",31],["عَسِيرٌ","sulit","ʿasīrun",2245]],"t":"maka itulah hari yang serba sulit,"},{"n":10,"w":[["عَلَى","atas/bagi","ʿalā",11],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79],["غَيْرُ","tidak","ghayru",85],["يَسِيرٍۢ","mudah","yasīrin",653]],"t":"bagi orang-orang kafir tidak mudah."},{"n":11,"w":[["ذَرْنِى","biarkan Aku","dharnī",276],["وَمَنْ","dan orang","waman",17],["خَلَقْتُ","Aku ciptakan","khalaqtu",70],["وَحِيدًۭا","satu/sendiri","waḥīdan",4466]],"t":"Biarkanlah Aku (yang bertindak) terhadap orang yang Aku sendiri telah menciptakannya,"},{"n":12,"w":[["وَجَعَلْتُ","dan Aku jadikan","wajaʿaltu",40],["لَهُۥ","baginya","lahu",21],["مَالًۭا","harta","mālan",141],["مَّمْدُودًۭا","panjang/banyak","mamdūdan",2541]],"t":"dan Aku berikan baginya kekayaan yang melimpah,"},{"n":13,"w":[["وَبَنِينَ","dan anak-anak","wabanīna",90],["شُهُودًۭا","saksi-saksi/hadir","shuhūdan",492]],"t":"dan anak-anak yang selalu bersamanya,"},{"n":14,"w":[["وَمَهَّدتُّ","dan Aku lapangkan (rizki)","wamahhadttu",3712],["لَهُۥ","baginya","lahu",21],["تَمْهِيدًۭا","selapang-lapangnya","tamhīdan",4386]],"t":"dan Aku berikan baginya kelapangan (hidup) seluas-luasnya."},{"n":15,"w":[["ثُمَّ","kemudian","thumma",41],["يَطْمَعُ","dia ingin sekali","yaṭmaʿu",982],["أَنْ","bahwa/supaya","an",22],["أَزِيدَ","Aku menambahnya","azīda",259]],"t":"kemudian dia ingin sekali agar Aku menambahnya."},{"n":16,"w":[["كَلَّآ ۖ","sekali-kali tidak","kallā",362],["إِنَّهُۥ","karena sesungguhnya","innahu",9],["كَانَ","adalah","kāna",12],["لِـَٔايَـٰتِنَا","kepada ayat-ayat Kami","liāyātinā",34],["عَنِيدًۭا","menentang","ʿanīdan",1517]],"t":"Tidak bisa! Sesungguhnya dia telah menentang ayat-ayat Kami (Alquran)."},{"n":17,"w":[["سَأُرْهِقُهُۥ","akan aku timpakan","sa-ur'hiquhu",1765],["صَعُودًا","siksaan yang payah/berat","ṣaʿūdan",3240]],"t":"Aku akan membebaninya dengan pendakian yang meletihkan."},{"n":18,"w":[["إِنَّهُۥ","sesungguhnya","innahu",9],["فَكَّرَ","dia telah memikirkan","fakkara",3436],["وَقَدَّرَ","dan telah menetapkan","waqaddara",613]],"t":"Sesungguhnya dia telah memikirkan dan menetapkan (apa yang ditetapkannya),"},{"n":19,"w":[["فَقُتِلَ","maka celakalah ia","faqutila",149],["كَيْفَ","bagaimanakah","kayfa",148],["قَدَّرَ","dia menetapkan","qaddara",613]],"t":"maka celakalah dia! Bagaimana dia menetapkan?"},{"n":20,"w":[["ثُمَّ","sesungguhnya","thumma",41],["قُتِلَ","celakalah dia","qutila",149],["كَيْفَ","bagaimanakah","kayfa",148],["قَدَّرَ","dia menetapkan","qaddara",613]],"t":"sekali lagi, celakalah dia! Bagaimana dia menetapkan?"},{"n":21,"w":[["ثُمَّ","kemudian","thumma",41],["نَظَرَ","dia memperhatikan/memikirkan","naẓara",139]],"t":"kemudian dia (merenung) memikirkan,"},{"n":22,"w":[["ثُمَّ","kemudian","thumma",41],["عَبَسَ","dia bermasam muka","ʿabasa",2229],["وَبَسَرَ","dan dia merengut","wabasara",3365]],"t":"lalu berwajah masam dan cemberut,"},{"n":23,"w":[["ثُمَّ","kemudian","thumma",41],["أَدْبَرَ","dia berpaling","adbara",1486],["وَٱسْتَكْبَرَ","dan dia menyombongkan diri","wa-is'takbara",315]],"t":"kemudian berpaling (dari kebenaran) dan menyombongkan diri,"},{"n":24,"w":[["فَقَالَ","lalu dia berkata","faqāla",10],["إِنْ","tidaklah","in",19],["هَـٰذَآ","ini","hādhā",64],["إِلَّا","kecuali","illā",20],["سِحْرٌۭ","sihir","siḥ'run",408],["يُؤْثَرُ","diceritakan/dipelajari","yu'tharu",3027]],"t":"lalu dia berkata, \"(Alquran) ini hanyalah sihir yang dipelajari (dari orang-orang dahulu)."},{"n":25,"w":[["إِنْ","tidaklah","in",19],["هَـٰذَآ","ini","hādhā",64],["إِلَّا","kecuali","illā",20],["قَوْلُ","perkataan","qawlu",129],["ٱلْبَشَرِ","manusia","l-bashari",333]],"t":"Ini hanyalah perkataan manusia.\""},{"n":26,"w":[["سَأُصْلِيهِ","akan Aku masukkan dia","sa-uṣ'līhi",1483],["سَقَرَ","neraka saqar","saqara",1667]],"t":"Kelak, Aku akan memasukkannya ke dalam (neraka) Saqar,"},{"n":27,"w":[["وَمَآ","dan apakah","wamā",6],["أَدْرَىٰكَ","kamu mengetahui","adrāka",574],["مَا","apa","mā",6],["سَقَرُ","neraka saqar","saqaru",1667]],"t":"Dan tahukah kamu apa (neraka) Saqar itu?"},{"n":28,"w":[["لَا","tidak","lā",8],["تُبْقِى","ia meninggalkan","tub'qī",2959],["وَلَا","dan tidak","walā",8],["تَذَرُ","ia membiarkan","tadharu",276]],"t":"Ia (Saqar itu) tidak meninggalkan dan tidak membiarkan,"},{"n":29,"w":[["لَوَّاحَةٌۭ","yang membakar","lawwāḥatun",3645],["لِّلْبَشَرِ","bagi manusia","lil'bashari",333]],"t":"yang menghanguskan kulit manusia."},{"n":30,"w":[["عَلَيْهَا","di atasnya","ʿalayhā",11],["تِسْعَةَ","sembilan","tis'ʿata",2716],["عَشَرَ","belas","ʿashara",1512]],"t":"Di atasnya ada sembilan belas (malaikat penjaga)."},{"n":31,"w":[["وَمَا","dan tidak","wamā",6],["جَعَلْنَآ","Kami jadikan","jaʿalnā",40],["أَصْحَـٰبَ","penghuni/penjaga","aṣḥāba",132],["ٱلنَّارِ","neraka","l-nāri",87],["إِلَّا","kecuali","illā",20],["مَلَـٰٓئِكَةًۭ ۙ","malaikat","malāikatan",137],["وَمَا","dan tidak","wamā",6],["جَعَلْنَا","Kami jadikan","jaʿalnā",40],["عِدَّتَهُمْ","bilangan mereka","ʿiddatahum",785],["إِلَّا","kecuali","illā",20],["فِتْنَةًۭ","fitnah/cobaan","fit'natan",355],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لِيَسْتَيْقِنَ","supaya meyakini","liyastayqina",2818],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["أُوتُوا۟","(mereka) diberi","ūtū",53],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",57],["وَيَزْدَادَ","dan bertambah","wayazdāda",1038],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوٓا۟","beriman","āmanū",23],["إِيمَـٰنًۭا ۙ","keimanan","īmānan",271],["وَلَا","dan tidak","walā",8],["يَرْتَابَ","ragu-ragu","yartāba",962],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["أُوتُوا۟","(mereka) diberi","ūtū",53],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",57],["وَٱلْمُؤْمِنُونَ ۙ","dan orang-orang yang beriman","wal-mu'minūna",63],["وَلِيَقُولَ","dan supaya mengatakan","waliyaqūla",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["فِى","dalam","fī",7],["قُلُوبِهِم","hati mereka","qulūbihim",98],["مَّرَضٌۭ","penyakit","maraḍun",708],["وَٱلْكَـٰفِرُونَ","dan orang-orang kafir","wal-kāfirūna",79],["مَاذَآ","apakah","mādhā",428],["أَرَادَ","menghendaki","arāda",92],["ٱللَّهُ","Allah","l-lahu",4],["بِهَـٰذَا","dengan ini","bihādhā",64],["مَثَلًۭا ۚ","perumpamaan","mathalan",138],["كَذَٰلِكَ","demikianlah","kadhālika",26],["يُضِلُّ","menyesatkan","yuḍillu",199],["ٱللَّهُ","Allah","l-lahu",4],["مَن","siapa/orang","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيَهْدِى","dan Dia memberi petunjuk","wayahdī",89],["مَن","siapa/orang","man",17],["يَشَآءُ ۚ","Dia kehendaki","yashāu",62],["وَمَا","dan tidak","wamā",6],["يَعْلَمُ","mengetahui","yaʿlamu",35],["جُنُودَ","bala tentara","junūda",394],["رَبِّكَ","Tuhanmu","rabbika",15],["إِلَّا","kecuali","illā",20],["هُوَ ۚ","Dia","huwa",25],["وَمَا","dan tidaklah","wamā",6],["هِىَ","ia","hiya",203],["إِلَّا","kecuali","illā",20],["ذِكْرَىٰ","peringatan","dhik'rā",458],["لِلْبَشَرِ","bagi manusia","lil'bashari",333]],"t":"Dan yang Kami jadikan penjaga neraka itu hanya dari malaikat; dan Kami menentukan bilangan mereka itu hanya sebagai cobaan bagi orang-orang kafir, agar orang-orang yang diberi kitab menjadi yakin, agar orang yang beriman bertambah imannya, agar orang-orang yang diberi kitab dan orang-orang mukmin itu tidak ragu-ragu; dan agar orang-orang yang di dalam hatinya ada penyakit dan orang-orang kafir (berkata), \"Apakah yang dikehendaki Allah dengan (bilangan) ini sebagai suatu perumpamaan?\" Demikianlah Allah membiarkan sesat orang-orang yang Dia kehendaki dan memberi petunjuk kepada orang-orang yang Dia kehendaki. Dan tidak ada yang mengetahui bala tentara Tuhanmu kecuali Dia sendiri. Dan Saqar itu tidak lain hanyalah peringatan bagi manusia."},{"n":32,"w":[["كَلَّا","sekali-kali tidak","kallā",362],["وَٱلْقَمَرِ","demi bulan","wal-qamari",419]],"t":"Tidak! Demi bulan,"},{"n":33,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",146],["إِذْ","tatkala","idh",61],["أَدْبَرَ","mundur/berlalu","adbara",1486]],"t":"dan demi malam ketika telah berlalu,"},{"n":34,"w":[["وَٱلصُّبْحِ","dan subuh","wal-ṣub'ḥi",1329],["إِذَآ","tatkala","idhā",29],["أَسْفَرَ","terbit/terang","asfara",3020]],"t":"dan demi subuh apabila mulai terang,"},{"n":35,"w":[["إِنَّهَا","sesungguhnya ia (saqar)","innahā",9],["لَإِحْدَى","salah satu","la-iḥ'dā",772],["ٱلْكُبَرِ","amat besar","l-kubari",1096]],"t":"sesungguhnya (Saqar itu) adalah salah satu (bencana) yang sangat besar,"},{"n":36,"w":[["نَذِيرًۭا","peringatan","nadhīran",216],["لِّلْبَشَرِ","bagi manusia","lil'bashari",333]],"t":"sebagai peringatan bagi manusia,"},{"n":37,"w":[["لِمَن","bagi siapa","liman",17],["شَآءَ","menghendaki","shāa",62],["مِنكُمْ","diantara kamu","minkum",1],["أَن","bahwa","an",22],["يَتَقَدَّمَ","akan maju","yataqaddama",2699],["أَوْ","atau","aw",50],["يَتَأَخَّرَ","akan mundur","yata-akhara",2035]],"t":"(yaitu) bagi siapa di antara kamu yang ingin maju atau mundur."},{"n":38,"w":[["كُلُّ","tiap-tiap","kullu",38],["نَفْسٍۭ","jiwa/diri","nafsin",47],["بِمَا","terhadap apa","bimā",6],["كَسَبَتْ","ia usahakan/ia perbuat","kasabat",206],["رَهِينَةٌ","tergadai/terikat","rahīnatun",4175]],"t":"Setiap orang bertanggung jawab atas apa yang telah dilakukannya,"},{"n":39,"w":[["إِلَّآ","kecuali","illā",20],["أَصْحَـٰبَ","kaum/golongan","aṣḥāba",132],["ٱلْيَمِينِ","kanan","l-yamīni",198]],"t":"kecuali golongan kanan,"},{"n":40,"w":[["فِى","dalam","fī",7],["جَنَّـٰتٍۢ","sorga","jannātin",86],["يَتَسَآءَلُونَ","mereka saling bertanya","yatasāalūna",952]],"t":"berada di dalam surga, mereka saling menanyakan,"},{"n":41,"w":[["عَنِ","dari/tentang","ʿani",27],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",240]],"t":"tentang (keadaan) orang-orang yang berdosa,"},{"n":42,"w":[["مَا","apa yang","mā",6],["سَلَكَكُمْ","memasukkan kamu","salakakum",759],["فِى","dalam","fī",7],["سَقَرَ","neraka saqar","saqara",1667]],"t":"\"Apa yang menyebabkan kamu masuk ke dalam (neraka) Saqar?\""},{"n":43,"w":[["قَالُوا۟","mereka berkata","qālū",10],["لَمْ","tidak ada","lam",39],["نَكُ","kami","naku",12],["مِنَ","dari","mina",1],["ٱلْمُصَلِّينَ","orang-orang yang mengerjakan sholat","l-muṣalīna",1933]],"t":"Mereka menjawab, \"Dahulu kami tidak termasuk orang-orang yang melaksanakan salat,"},{"n":44,"w":[["وَلَمْ","dan tidak ada","walam",39],["نَكُ","kami","naku",12],["نُطْعِمُ","kami memberi makan","nuṭ'ʿimu",688],["ٱلْمِسْكِينَ","orang-orang miskin","l-mis'kīna",467]],"t":"dan kami (juga) tidak memberi makan orang miskin,"},{"n":45,"w":[["وَكُنَّا","dan kami adalah","wakunnā",12],["نَخُوضُ","kami mencela/memperolok-olok","nakhūḍu",955],["مَعَ","bersama","maʿa",78],["ٱلْخَآئِضِينَ","orang-orang yang mencela/memperolok-olok","l-khāiḍīna",4518]],"t":"bahkan kami biasa berbincang (untuk tujuan yang batil), bersama orang-orang yang membicarakannya,"},{"n":46,"w":[["وَكُنَّا","dan kami adalah","wakunnā",12],["نُكَذِّبُ","kami mendustakan","nukadhibu",72],["بِيَوْمِ","dengan hari","biyawmi",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"dan kami mendustakan hari pembalasan,"},{"n":47,"w":[["حَتَّىٰٓ","sehingga","ḥattā",91],["أَتَىٰنَا","datang kepada kami","atānā",56],["ٱلْيَقِينُ","kepastian","l-yaqīnu",1030]],"t":"sampai datang kepada kami kematian.\""},{"n":48,"w":[["فَمَا","maka tidak","famā",6],["تَنفَعُهُمْ","berguna kepada mereka","tanfaʿuhum",378],["شَفَـٰعَةُ","pertolongan/syafaat","shafāʿatu",687],["ٱلشَّـٰفِعِينَ","orang-orang yang memberi pertolongan/syafaat","l-shāfiʿīna",2110]],"t":"Maka tidak berguna lagi bagi mereka syafaat (pertolongan) dari orang-orang yang memberikan syafaat."},{"n":49,"w":[["فَمَا","maka mengapa","famā",6],["لَهُمْ","bagi mereka","lahum",16],["عَنِ","dari","ʿani",27],["ٱلتَّذْكِرَةِ","peringatan","l-tadhkirati",948],["مُعْرِضِينَ","orang-orang yang berpaling","muʿ'riḍīna",543]],"t":"Lalu mengapa mereka (orang-orang kafir) berpaling dari peringatan (Allah)?"},{"n":50,"w":[["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["حُمُرٌۭ","keledai","ḥumurun",1171],["مُّسْتَنفِرَةٌۭ","yang terkejut","mus'tanfiratun",3999]],"t":"seakan-akan mereka keledai liar yang lari terkejut,"},{"n":51,"w":[["فَرَّتْ","ia lari","farrat",1194],["مِن","dari","min",1],["قَسْوَرَةٍۭ","singa","qaswaratin",4129]],"t":"lari dari singa."},{"n":52,"w":[["بَلْ","bahkan","bal",105],["يُرِيدُ","menghendaki","yurīdu",92],["كُلُّ","tiap-tiap","kullu",38],["ٱمْرِئٍۢ","seseorang","im'ri-in",1462],["مِّنْهُمْ","di antara mereka","min'hum",1],["أَن","untuk","an",22],["يُؤْتَىٰ","diberi ia","yu'tā",53],["صُحُفًۭا","lembaran-lembaran","ṣuḥufan",979],["مُّنَشَّرَةًۭ","ditebarkan/terbuka","munasharatan",3980]],"t":"Bahkan setiap orang dari mereka ingin agar diberikan kepadanya lembaran-lembaran (kitab) yang terbuka."},{"n":53,"w":[["كَلَّا ۖ","sekali-kali tidak","kallā",362],["بَل","bahkan","bal",105],["لَّا","tidak","lā",8],["يَخَافُونَ","mereka takut","yakhāfūna",150],["ٱلْـَٔاخِرَةَ","hari akhirat","l-ākhirata",82]],"t":"Tidak! Sebenarnya mereka tidak takut kepada akhirat."},{"n":54,"w":[["كَلَّآ","sekali-kali tidak","kallā",362],["إِنَّهُۥ","sesungguhnya ia","innahu",9],["تَذْكِرَةٌۭ","peringatan/pelajaran","tadhkiratun",948]],"t":"Tidak! Sesungguhnya (Alquran) itu benar-benar suatu peringatan."},{"n":55,"w":[["فَمَن","maka barangsiapa","faman",17],["شَآءَ","dia menghendaki","shāa",62],["ذَكَرَهُۥ","dia mengingatnya","dhakarahu",144]],"t":"Maka barangsiapa menghendaki, tentu dia mengambil pelajaran darinya."},{"n":56,"w":[["وَمَا","dan tidak","wamā",6],["يَذْكُرُونَ","mereka mengingat","yadhkurūna",144],["إِلَّآ","kecuali","illā",20],["أَن","bahwa","an",22],["يَشَآءَ","menghendaki","yashāa",62],["ٱللَّهُ ۚ","Allah","l-lahu",4],["هُوَ","Dia","huwa",25],["أَهْلُ","berhak/patut","ahlu",102],["ٱلتَّقْوَىٰ","takwa/taat","l-taqwā",592],["وَأَهْلُ","dan berhak/patut","wa-ahlu",102],["ٱلْمَغْفِرَةِ","ampunan","l-maghfirati",406]],"t":"Dan mereka tidak akan mengambil pelajaran darinya (Alquran) kecuali (jika) Allah menghendakinya. Dialah Tuhan yang patut (kita) bertakwa kepada-Nya dan yang berhak memberi ampun."}]