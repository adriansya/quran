n pemeriksaan yang mudah,"},{"n":9,"w":[["وَيَنقَلِبُ","dan dia akan dikembalikan","wayanqalibu",588],["إِلَىٰٓ","kepada","ilā",13],["أَهْلِهِۦ","keluarganya","ahlihi",94],["مَسْرُورًۭا","dengan gembira","masrūran",2478]],"t":"dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira."},{"n":10,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["مَنْ","siapa/orang","man",12],["أُوتِىَ","diberikan","ūtiya",45],["كِتَـٰبَهُۥ","kitabnya","kitābahu",49],["وَرَآءَ","belakang","warāa",447],["ظَهْرِهِۦ","punggungnya","ẓahrihi",627]],"t":"Dan adapun orang yang catatannya diberikan dari arah belakang,"},{"n":11,"w":[["فَسَوْفَ","maka nanti","fasawfa",285],["يَدْعُوا۟","mereka berseru/berteriak","yadʿū",66],["ثُبُورًۭا","kebinasaan/kecelakaan","thubūran",1678]],"t":"maka dia akan berteriak, \"Celakalah aku!\""},{"n":12,"w":[["وَيَصْلَىٰ","dan dia akan masuk","wayaṣlā",685],["سَعِيرًا","api yang menyala-nyala","saʿīran",608]],"t":"Dan dia akan masuk ke dalam api yang menyala-nyala (neraka)."},{"n":13,"w":[["إِنَّهُۥ","sesungguhnya dia","innahu",5],["كَانَ","adalah","kāna",8],["فِىٓ","dalam","fī",3],["أَهْلِهِۦ","keluarganya","ahlihi",94],["مَسْرُورًا","bergembira","masrūran",2478]],"t":"Sungguh, dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir)."},{"n":14,"w":[["إِنَّهُۥ","sesungguhnya","innahu",5],["ظَنَّ","dia menyangka","ẓanna",254],["أَن","bahwa","an",17],["لَّن","tidak","lan",113],["يَحُورَ","dia akan kembali","yaḥūra",3150]],"t":"Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya)."},{"n":15,"w":[["بَلَىٰٓ","yang benar","balā",466],["إِنَّ","sesungguhnya","inna",5],["رَبَّهُۥ","Tuhannya","rabbahu",10],["كَانَ","adalah","kāna",8],["بِهِۦ","kepadanya","bihi",16],["بَصِيرًۭا","melihat","baṣīran",234]],"t":"Tidak demikian, sesungguhnya Tuhannya selalu melihatnya."},{"n":16,"w":[["فَلَآ","maka","falā",4],["أُقْسِمُ","Aku bersumpah","uq'simu",506],["بِٱلشَّفَقِ","dengan cahaya merah di waktu senja","bil-shafa