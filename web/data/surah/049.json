[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["لَا","jangan","lā",4],["تُقَدِّمُوا۟","kamu mendahului","tuqaddimū",406],["بَيْنَ","antara","bayna",47],["يَدَىِ","hadapan","yadayi",99],["ٱللَّهِ","Allah","l-lahi",1],["وَرَسُولِهِۦ ۖ","dan rasul-Nya","warasūlihi",35],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ ۚ","Allah","l-laha",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["سَمِيعٌ","Maha Mendengar","samīʿun",252],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",68]],"t":"Wahai orang-orang yang beriman! Janganlah kamu mendahului Allah dan Rasul-Nya, dan bertakwalah kepada Allah. Sungguh, Allah Maha Mendengar, Maha Mengetahui."},{"n":2,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["لَا","jangan","lā",4],["تَرْفَعُوٓا۟","kamu meninggikan","tarfaʿū",473],["أَصْوَٰتَكُمْ","suaramu","aṣwātakum",963],["فَوْقَ","di atas","fawqa",284],["صَوْتِ","suara","ṣawti",963],["ٱلنَّبِىِّ","nabi","l-nabiyi",156],["وَلَا","dan jangan","walā",4],["تَجْهَرُوا۟","kamu keraskan","tajharū",1343],["لَهُۥ","kepadanya","lahu",16],["بِٱلْقَوْلِ","dengan perkataan","bil-qawli",117],["كَجَهْرِ","seperti keras","kajahri",1078],["بَعْضِكُمْ","sebagian kamu","baʿḍikum",70],["لِبَعْضٍ","terhadap sebagian","libaʿḍin",70],["أَن","bahwa","an",17],["تَحْبَطَ","akan hapus","taḥbaṭa",719],["أَعْمَـٰلُكُمْ","amal-amal kamu","aʿmālukum",170],["وَأَنتُمْ","dan kalian","wa-antum",85],["لَا","tidak","lā",4],["تَشْعُرُونَ","menyadari","tashʿurūna",432]],"t":"Wahai orang-orang yang beriman! Janganlah kamu meninggikan suaramu melebihi suara Nabi, dan janganlah kamu berkata kepadanya dengan suara keras sebagaimana kerasnya (suara) sebagian kamu terhadap yang lain, nanti (pahala) segala amalmu bisa terhapus sedangkan kamu tidak menyadari."},{"n":3,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَغُضُّونَ","merendahkan","yaghuḍḍūna",1668],["أَصْوَٰتَهُمْ","suara  mereka","aṣwātahum",963],["عِندَ","di sisi","ʿinda",59],["رَسُولِ","rasul","rasūli",35],["ٱللَّهِ","Allah","l-lahi",1],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ٱمْتَحَنَ","menguji","im'taḥana",2840],["ٱللَّهُ","Allah","l-lahu",1],["قُلُوبَهُمْ","hati mereka","qulūbahum",86],["لِلتَّقْوَىٰ ۚ","untuk bertakwa","lilttaqwā",580],["لَهُم","bagi mereka","lahum",11],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",390],["وَأَجْرٌ","dan pahala","wa-ajrun",107],["عَظِيمٌ","besar","ʿaẓīmun",98]],"t":"Sesungguhnya orang-orang yang merendahkan suaranya di sisi Rasulullah, mereka itulah orang-orang yang telah diuji hatinya oleh Allah untuk bertakwa. Mereka akan memperoleh ampunan dan pahala yang besar."},{"n":4,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُنَادُونَكَ","mereka memanggil kamu","yunādūnaka",269],["مِن","dari","min",0],["وَرَآءِ","belakang","warāi",445],["ٱلْحُجُرَٰتِ","kamar-kamar","l-ḥujurāti",3218],["أَكْثَرُهُمْ","kebanyakan mereka","aktharuhum",140],["لَا","tidak","lā",4],["يَعْقِلُونَ","mengerti","yaʿqilūna",241]],"t":"Sesungguhnya orang-orang yang memanggil engkau (Muhammad) dari luar kamar(mu) kebanyakan mereka tidak mengerti."},{"n":5,"w":[["وَلَوْ","dan kalau","walaw",57],["أَنَّهُمْ","sekiranya mereka","annahum",30],["صَبَرُوا۟","mereka sabar","ṣabarū",205],["حَتَّىٰ","sehingga","ḥattā",80],["تَخْرُجَ","kamu keluar","takhruja",225],["إِلَيْهِمْ","kepada mereka","ilayhim",13],["لَكَانَ","sungguh adalah","lakāna",9],["خَيْرًۭا","lebih baik","khayran",62],["لَّهُمْ ۚ","bagi mereka","lahum",11],["وَٱللَّهُ","dan Allah","wal-lahu",1],["غَفُورٌۭ","Maha Pengampun","ghafūrun",118],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",101]],"t":"Dan sekiranya mereka bersabar sampai engkau keluar menemui mereka, tentu akan lebih baik bagi mereka. Dan Allah Maha Pengampun, Maha Penyayang."},{"n":6,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِن","jika","in",14],["جَآءَكُمْ","datang kepadamu","jāakum",43],["فَاسِقٌۢ","orang fasik","fāsiqun",316],["بِنَبَإٍۢ","dengan berita","binaba-in",376],["فَتَبَيَّنُوٓا۟","maka jelaskan","fatabayyanū",557],["أَن","agar","an",17],["تُصِيبُوا۟","kamu (tidak) menimpakan","tuṣībū",187],["قَوْمًۢا","kaum","qawman",27],["بِجَهَـٰلَةٍۢ","karena kebodohan/tidak tahu","bijahālatin",1559],["فَتُصْبِحُوا۟","maka jadilah kamu","fatuṣ'biḥū",380],["عَلَىٰ","atas","ʿalā",8],["مَا","apa","mā",2],["فَعَلْتُمْ","perbuatanmu","faʿaltum",122],["نَـٰدِمِينَ","orang-orang yang menyesal","nādimīna",1378]],"t":"Wahai orang-orang yang beriman! Jika seorang yang fasik datang kepadamu membawa suatu berita, maka telitilah kebenarannya, agar kamu tidak mencelakakan suatu kaum karena kebodohan (kecerobohan), yang akhirnya kamu menyesali perbuatanmu itu."},{"n":7,"w":[["وَٱعْلَمُوٓا۟","dan ketahuilah","wa-iʿ'lamū",29],["أَنَّ","bahwa","anna",30],["فِيكُمْ","diantara kamu","fīkum",3],["رَسُولَ","rasul","rasūla",35],["ٱللَّهِ ۚ","Allah","l-lahi",1],["لَوْ","jika","law",57],["يُطِيعُكُمْ","dia mentaati kamu","yuṭīʿukum",163],["فِى","dalam","fī",3],["كَثِيرٍۢ","banyak","kathīrin",191],["مِّنَ","dari","mina",0],["ٱلْأَمْرِ","urusan","l-amri",66],["لَعَنِتُّمْ","tentu menyusahkan kamu","laʿanittum",1766],["وَلَـٰكِنَّ","tetapi","walākinna",209],["ٱللَّهَ","Allah","l-laha",1],["حَبَّبَ","menjadikan cinta","ḥabbaba",3178],["إِلَيْكُمُ","kepadamu","ilaykumu",13],["ٱلْإِيمَـٰنَ","keimanan","l-īmāna",256],["وَزَيَّنَهُۥ","dan Dia menjadikannya indah","wazayyanahu",419],["فِى","dalam","fī",3],["قُلُوبِكُمْ","hatimu","qulūbikum",86],["وَكَرَّهَ","dan Dia menjadikan benci","wakarraha",3581],["إِلَيْكُمُ","kepadamu","ilaykumu",13],["ٱلْكُفْرَ","kekafiran","l-kuf'ra",317],["وَٱلْفُسُوقَ","dan kefasikan","wal-fusūqa",1550],["وَٱلْعِصْيَانَ ۚ","dan kedurhakaan","wal-ʿiṣ'yāna",3138],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["هُمُ","mereka","humu",11],["ٱلرَّٰشِدُونَ","orang-orang yang mengikuti jalan yang lurus","l-rāshidūna",4225]],"t":"Dan ketahuilah bahwa di tengah-tengah kamu ada Rasulullah. Kalau dia menuruti (kemauan) kamu dalam banyak hal, pasti kamu akan mendapatkan kesusahan. Tetapi Allah menjadikan kamu cinta kepada keimanan, dan menjadikan (iman) itu indah dalam hatimu, serta menjadikan kamu benci kepada kekafiran, kefasikan dan kedurhakaan. Mereka itulah orang-orang yang mengikuti jalan yang lurus,"},{"n":8,"w":[["فَضْلًۭا","karunia","faḍlan",131],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["وَنِعْمَةًۭ ۚ","dan nikmat","waniʿ'matan",237],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",68],["حَكِيمٌۭ","Maha Bijaksana","ḥakīmun",112]],"t":"sebagai karunia dan nikmat dari Allah. Dan Allah Maha Mengetahui, Mahabijaksana."},{"n":9,"w":[["وَإِن","dan jika","wa-in",14],["طَآئِفَتَانِ","dua golongan","ṭāifatāni",438],["مِنَ","dari","mina",0],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",56],["ٱقْتَتَلُوا۟","mereka berperang","iq'tatalū",1695],["فَأَصْلِحُوا۟","maka damaikanlah","fa-aṣliḥū",381],["بَيْنَهُمَا ۖ","diantara keduanya","baynahumā",47],["فَإِنۢ","maka jika","fa-in",14],["بَغَتْ","berbuat aniaya","baghat",425],["إِحْدَىٰهُمَا","salah seorang dari keduanya","iḥ'dāhumā",759],["عَلَى","atas","ʿalā",8],["ٱلْأُخْرَىٰ","yang lain","l-ukh'rā",172],["فَقَـٰتِلُوا۟","maka perangilah","faqātilū",222],["ٱلَّتِى","yang","allatī",7],["تَبْغِى","berbuat aniaya","tabghī",425],["حَتَّىٰ","sehingga","ḥattā",80],["تَفِىٓءَ","(golongan) kembali","tafīa",1823],["إِلَىٰٓ","kepada","ilā",13],["أَمْرِ","perintah","amri",66],["ٱللَّهِ ۚ","Allah","l-lahi",1],["فَإِن","maka jika","fa-in",14],["فَآءَتْ","kembali","fāat",1823],["فَأَصْلِحُوا۟","maka damaikanlah","fa-aṣliḥū",381],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["بِٱلْعَدْلِ","dengan adil","bil-ʿadli",654],["وَأَقْسِطُوٓا۟ ۖ","dan berlaku adil-lah kamu","wa-aqsiṭū",2018],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["يُحِبُّ","menyukai","yuḥibbu",186],["ٱلْمُقْسِطِينَ","orang-orang yang berbuat adil","l-muq'siṭīna",1914]],"t":"Dan apabila ada dua golongan orang mukmin berperang, maka damaikanlah antara keduanya. Jika salah satu dari keduanya berbuat zalim terhadap (golongan) yang lain, maka perangilah (golongan) yang berbuat zalim itu, sehingga golongan itu kembali kepada perintah Allah. Jika golongan itu telah kembali (kepada perintah Allah), maka damaikanlah antara keduanya dengan adil, dan berlakulah adil. Sungguh, Allah mencintai orang-orang yang berlaku adil."},{"n":10,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["ٱلْمُؤْمِنُونَ","orang-orang yang beriman","l-mu'minūna",56],["إِخْوَةٌۭ","bersaudara","ikh'watun",1031],["فَأَصْلِحُوا۟","maka damaikanlah","fa-aṣliḥū",381],["بَيْنَ","antara","bayna",47],["أَخَوَيْكُمْ ۚ","kedua saudaramu","akhawaykum",153],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["لَعَلَّكُمْ","agar kalian","laʿallakum",96],["تُرْحَمُونَ","kamu dirahmati","tur'ḥamūna",392]],"t":"Sesungguhnya orang-orang mukmin itu bersaudara, karena itu damaikanlah antara kedua saudaramu (yang berselisih) dan bertakwalah kepada Allah agar kamu mendapat rahmat."},{"n":11,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["لَا","jangan","lā",4],["يَسْخَرْ","memperolok-olok","yaskhar",800],["قَوْمٌۭ","suatu kamu","qawmun",27],["مِّن","dari","min",0],["قَوْمٍ","kaum","qawmin",27],["عَسَىٰٓ","boleh jadi","ʿasā",361],["أَن","bahwa","an",17],["يَكُونُوا۟","adalah mereka","yakūnū",9],["خَيْرًۭا","lebih baik","khayran",62],["مِّنْهُمْ","dari pada mereka","min'hum",0],["وَلَا","dan jangan","walā",4],["نِسَآءٌۭ","wanita","nisāon",203],["مِّن","dari","min",0],["نِّسَآءٍ","wanita","nisāin",203],["عَسَىٰٓ","boleh jadi","ʿasā",361],["أَن","bahwa","an",17],["يَكُنَّ","mereka adalah","yakunna",9],["خَيْرًۭا","lebih baik","khayran",62],["مِّنْهُنَّ ۖ","dari mereka","min'hunna",0],["وَلَا","dan jangan","walā",4],["تَلْمِزُوٓا۟","kamu mencela","talmizū",2060],["أَنفُسَكُمْ","diri kalian sendiri","anfusakum",39],["وَلَا","dan jangan","walā",4],["تَنَابَزُوا۟","kamu panggil memanggil","tanābazū",4409],["بِٱلْأَلْقَـٰبِ ۖ","dengan julukan","bil-alqābi",3008],["بِئْسَ","seburuk-buruk","bi'sa",289],["ٱلِٱسْمُ","nama","l-s'mu",305],["ٱلْفُسُوقُ","fasik","l-fusūqu",1550],["بَعْدَ","sesudah","baʿda",58],["ٱلْإِيمَـٰنِ ۚ","keimanan","l-īmāni",256],["وَمَن","dan barang siapa","waman",12],["لَّمْ","tidak","lam",32],["يَتُبْ","berbuat","yatub",193],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",55],["هُمُ","mereka","humu",11],["ٱلظَّـٰلِمُونَ","orang-orang yang zalim","l-ẓālimūna",89]],"t":"Wahai orang-orang yang beriman! Janganlah suatu kaum mengolok-olok kaum yang lain, (karena) boleh jadi mereka (yang diperolok-olokkan) lebih baik dari mereka (yang mengolok-olok), dan jangan pula perempuan-perempuan (mengolok-olokkan) perempuan lain, (karena) boleh jadi perempuan (yang diperolok-olokkan) lebih baik dari perempuan (yang mengolok-olok). Janganlah kamu saling mencela satu sama lain, dan janganlah saling memanggil dengan gelar-gelar yang buruk. Seburuk-buruk panggilan adalah (panggilan) yang buruk (fasik) setelah beriman. Dan barangsiapa tidak bertobat, maka mereka itulah orang-orang yang zalim."},{"n":12,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["ٱجْتَنِبُوا۟","jauhilah","ij'tanibū",944],["كَثِيرًۭا","banyak","kathīran",191],["مِّنَ","dari","mina",0],["ٱلظَّنِّ","berprasangka","l-ẓani",488],["إِنَّ","sesungguhnya","inna",5],["بَعْضَ","sebagian","baʿḍa",70],["ٱلظَّنِّ","berprasangka","l-ẓani",488],["إِثْمٌۭ ۖ","dosa","ith'mun",327],["وَلَا","dan jangan","walā",4],["تَجَسَّسُوا۟","kamu mencari kesalahan","tajassasū",4391],["وَلَا","dan jangan","walā",4],["يَغْتَب","kamu mengumpat","yaghtab",4645],["بَّعْضُكُم","sebagian kamu","baʿḍukum",70],["بَعْضًا ۚ","sebagian","baʿḍan",70],["أَيُحِبُّ","apakah kamu menyukai","ayuḥibbu",186],["أَحَدُكُمْ","salah seorang diantara kamu","aḥadukum",157],["أَن","bahwa","an",17],["يَأْكُلَ","memakan","yakula",114],["لَحْمَ","daging","laḥma",732],["أَخِيهِ","saudaranya","akhīhi",153],["مَيْتًۭا","yang mati","maytan",1371],["فَكَرِهْتُمُوهُ ۚ","maka kamu jijik padanya","fakarih'tumūhu",574],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ ۚ","Allah","l-laha",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["تَوَّابٌۭ","Maha Penerima taubat","tawwābun",745],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",101]],"t":"Wahai orang-orang yang beriman! Jauhilah banyak dari prasangka, sesungguhnya sebagian prasangka itu dosa, dan janganlah kamu mencari-cari kesalahan orang lain, dan janganlah ada di antara kamu yang menggunjing sebagian yang lain. Apakah ada di antara kamu yang suka memakan daging saudaranya yang sudah mati? Tentu kamu merasa jijik. Dan bertakwalah kepada Allah, sungguh Allah Maha Penerima tobat, Maha Penyayang."},{"n":13,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلنَّاسُ","manusia","l-nāsu",52],["إِنَّا","sesungguhnya Kami","innā",5],["خَلَقْنَـٰكُم","Kami menciptakan Kamu","khalaqnākum",60],["مِّن","dari","min",0],["ذَكَرٍۢ","laki-laki","dhakarin",536],["وَأُنثَىٰ","dan perempuan","wa-unthā",435],["وَجَعَلْنَـٰكُمْ","dan Kami jadikan kamu","wajaʿalnākum",33],["شُعُوبًۭا","berbangsa-bangsa","shuʿūban",2887],["وَقَبَآئِلَ","dan bersuku-suku","waqabāila",4130],["لِتَعَارَفُوٓا۟ ۚ","supaya kamu saling mengenal","litaʿārafū",2782],["إِنَّ","sesungguhnya","inna",5],["أَكْرَمَكُمْ","paling mulia diantara kamu","akramakum",2174],["عِندَ","di sisi","ʿinda",59],["ٱللَّهِ","Allah","l-lahi",1],["أَتْقَىٰكُمْ ۚ","paling bertakwa diantara kamu","atqākum",2195],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",68],["خَبِيرٌۭ","Maha Melihat","khabīrun",261]],"t":"Wahai manusia! Sungguh, Kami telah menciptakan kamu dari seorang laki-laki dan seorang perempuan, kemudian Kami jadikan kamu berbangsa-bangsa dan bersuku-suku agar kamu saling mengenal. Sungguh, yang paling mulia di antara kamu di sisi Allah ialah orang yang paling bertakwa. Sungguh, Allah Maha Mengetahui, Mahateliti."},{"n":14,"w":[["۞ قَالَتِ","berkata","qālati",6],["ٱلْأَعْرَابُ","orang-orang Arab dusun","l-aʿrābu",813],["ءَامَنَّا ۖ","kami telah beriman","āmannā",18],["قُل","katakanlah","qul",6],["لَّمْ","belum","lam",32],["تُؤْمِنُوا۟","kamu beriman","tu'minū",18],["وَلَـٰكِن","tetapi","walākin",162],["قُولُوٓا۟","katakan","qūlū",6],["أَسْلَمْنَا","kami telah menyerahkan diri","aslamnā",463],["وَلَمَّا","dan belum","walammā",32],["يَدْخُلِ","masuk","yadkhuli",151],["ٱلْإِيمَـٰنُ","keimanan","l-īmānu",256],["فِى","dalam","fī",3],["قُلُوبِكُمْ ۖ","hati kamu","qulūbikum",86],["وَإِن","dan jika","wa-in",14],["تُطِيعُوا۟","kamu taat","tuṭīʿū",163],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ","dan rasul-Nya","warasūlahu",35],["لَا","tidak","lā",4],["يَلِتْكُم","Dia mengurangi kamu","yalit'kum",4653],["مِّنْ","dari","min",0],["أَعْمَـٰلِكُمْ","amalanmu","aʿmālikum",170],["شَيْـًٔا ۚ","sesuatu pun","shayan",41],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["غَفُورٌۭ","Maha Pengampun","ghafūrun",118],["رَّحِيمٌ","Maha Penyayang","raḥīmun",101]],"t":"Orang-orang Arab Badui berkata, \"Kami telah beriman.\" Katakanlah (kepada mereka), \"Kamu belum beriman, tetapi katakanlah 'Kami telah tunduk (Islam)', karena iman belum masuk ke dalam hatimu. Dan jika kamu taat kepada Allah dan Rasul-Nya, Dia tidak akan mengurangi sedikit pun (pahala) amalmu. Sungguh, Allah Maha Pengampun, Maha Penyayang.\""},{"n":15,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["ٱلْمُؤْمِنُونَ","orang-orang mukmin","l-mu'minūna",56],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ","dan rasul-Nya","warasūlihi",35],["ثُمَّ","kemudian","thumma",34],["لَمْ","tidak","lam",32],["يَرْتَابُوا۟","mereka ragu-ragu","yartābū",946],["وَجَـٰهَدُوا۟","dan mereka berjihad","wajāhadū",401],["بِأَمْوَٰلِهِمْ","dengan harta mereka","bi-amwālihim",127],["وَأَنفُسِهِمْ","dan diri/jiwa mereka","wa-anfusihim",39],["فِى","di","fī",3],["سَبِيلِ","jalan","sabīli",64],["ٱللَّهِ ۚ","Allah","l-lahi",1],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["هُمُ","mereka","humu",11],["ٱلصَّـٰدِقُونَ","orang-orang yang benar","l-ṣādiqūna",201]],"t":"Sesungguhnya orang-orang mukmin yang sebenarnya adalah mereka yang beriman kepada Allah dan Rasul-Nya, kemudian mereka tidak ragu-ragu, dan mereka berjihad dengan harta dan jiwanya di jalan Allah. Mereka itulah orang-orang yang benar."},{"n":16,"w":[["قُلْ","katakanlah","qul",6],["أَتُعَلِّمُونَ","apakah kamu akan memberitahukan","atuʿallimūna",281],["ٱللَّهَ","Allah","l-laha",1],["بِدِينِكُمْ","tentang agamamu","bidīnikum",116],["وَٱللَّهُ","dan Allah","wal-lahu",1],["يَعْلَمُ","mengetahui","yaʿlamu",29],["مَا","apa yang ada","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa yang ada","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ ۚ","bumi","l-arḍi",22],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِكُلِّ","terhadap segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",68]],"t":"Katakanlah (kepada mereka), \"Apakah kamu akan memberitahukan kepada Allah tentang agamamu (keyakinanmu), padahal Allah mengetahui apa yang ada di langit dan apa yang ada di bumi; dan Allah Maha Mengetahui segala sesuatu.\""},{"n":17,"w":[["يَمُنُّونَ","mereka merasa memberi nikmat","yamunnūna",598],["عَلَيْكَ","atas kamu","ʿalayka",8],["أَنْ","bahwa","an",17],["أَسْلَمُوا۟ ۖ","mereka masuk Islam","aslamū",463],["قُل","katakan","qul",6],["لَّا","jangan","lā",4],["تَمُنُّوا۟","kamu merasa memberi nikmat","tamunnū",598],["عَلَىَّ","atas","ʿalayya",8],["إِسْلَـٰمَكُم ۖ","keislamanmu","is'lāmakum",949],["بَلِ","bahkan","bali",93],["ٱللَّهُ","Allah","l-lahu",1],["يَمُنُّ","memberi nikmat","yamunnu",598],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["أَنْ","bahwa","an",17],["هَدَىٰكُمْ","Dia memberi petunjuk kepadamu","hadākum",79],["لِلْإِيمَـٰنِ","kepada keimanan","lil'īmāni",256],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Mereka merasa berjasa kepadamu dengan keislaman mereka. Katakanlah, \"Janganlah kamu merasa berjasa kepadaku dengan keislamanmu, sebenarnya Allah yang melimpahkan nikmat kepadamu dengan menunjukkan kamu kepada keimanan, jika kamu orang yang benar.\""},{"n":18,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["يَعْلَمُ","Maha Mengetahui","yaʿlamu",29],["غَيْبَ","kegaiban","ghayba",242],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بَصِيرٌۢ","Maha Melihat","baṣīrun",232],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Sungguh, Allah mengetahui apa yang gaib di langit dan di bumi. Dan Allah Maha Melihat apa yang kamu kerjakan."}]