[{"n":1,"w":[["وَٱلطُّورِ","demi bukit","wal-ṭūri",831]],"t":"Demi gunung (Sinai),"},{"n":2,"w":[["وَكِتَـٰبٍۢ","dan kitab","wakitābin",49],["مَّسْطُورٍۢ","tertulis","masṭūrin",1908]],"t":"dan demi Kitab yang ditulis,"},{"n":3,"w":[["فِى","pada","fī",3],["رَقٍّۢ","lembaran","raqqin",4181],["مَّنشُورٍۢ","terbentang","manshūrin",2464]],"t":"pada lembaran yang terbuka,"},{"n":4,"w":[["وَٱلْبَيْتِ","dan rumah","wal-bayti",186],["ٱلْمَعْمُورِ","dimakmurkan","l-maʿmūri",3667]],"t":"demi Baitulma'mur (Ka'bah),"},{"n":5,"w":[["وَٱلسَّقْفِ","dan atap","wal-saqfi",1656],["ٱلْمَرْفُوعِ","ditinggikan","l-marfūʿi",1598]],"t":"demi atap yang ditinggikan (langit),"},{"n":6,"w":[["وَٱلْبَحْرِ","dan laut","wal-baḥri",290],["ٱلْمَسْجُورِ","mendidih","l-masjūri",3744]],"t":"demi lautan yang penuh gelombang,"},{"n":7,"w":[["إِنَّ","sesungguhnya","inna",5],["عَذَابَ","azab","ʿadhāba",36],["رَبِّكَ","Tuhanmu","rabbika",10],["لَوَٰقِعٌۭ","pasti terjadi","lawāqiʿun",1243]],"t":"sungguh, azab Tuhanmu pasti terjadi,"},{"n":8,"w":[["مَّا","tidak ada","mā",2],["لَهُۥ","baginya","lahu",16],["مِن","dari yang","min",0],["دَافِعٍۢ","menolak","dāfiʿin",2346]],"t":"tidak sesuatu pun yang dapat menolaknya,"},{"n":9,"w":[["يَوْمَ","pada hari","yawma",25],["تَمُورُ","bergoncang","tamūru",1899],["ٱلسَّمَآءُ","langit","l-samāu",37],["مَوْرًۭا","sungguh-sungguh bergoncang","mawran",3757]],"t":"pada hari (ketika) langit berguncang sekeras-kerasnya,"},{"n":10,"w":[["وَتَسِيرُ","dan berjalan","watasīru",607],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",310],["سَيْرًۭا","sungguh-sungguh berjalan","sayran",2652]],"t":"dan gunung berjalan (berpindah-pindah)."},{"n":11,"w":[["فَوَيْلٌۭ","maka kecelakaanlah","fawaylun",301],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Maka celakalah pada hari itu orang-orang yang mendustakan."},{"n":12,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["هُمْ","mereka","hum",11],["فِى","dalam","fī",3],["خَوْضٍۢ","kesesatan","khawḍin",2756],["يَلْعَبُونَ","mereka bermain-main","yalʿabūna",914]],"t":"Orang-orang yang bermain-main dalam kebatilan (perbuatan dosa),"},{"n":13,"w":[["يَوْمَ","pada hari","yawma",25],["يُدَعُّونَ","mereka di dorong","yudaʿʿūna",2347],["إِلَىٰ","kepada","ilā",13],["نَارِ","api neraka","nāri",79],["جَهَنَّمَ","jahanam","jahannama",152],["دَعًّا","sungguh-sungguh di dorong","daʿʿan",3379]],"t":"pada hari (ketika) itu mereka di dorong ke neraka Jahanam dengan sekuat-kuatnya."},{"n":14,"w":[["هَـٰذِهِ","inilah","hādhihi",255],["ٱلنَّارُ","api/neraka","l-nāru",79],["ٱلَّتِى","yang","allatī",185],["كُنتُم","kalian adalah","kuntum",8],["بِهَا","dengannya","bihā",98],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",64]],"t":"(Dikatakan kepada mereka), \"Inilah neraka yang dahulu kamu mendustakannya.\""},{"n":15,"w":[["أَفَسِحْرٌ","maka apakah sihir","afasiḥ'run",398],["هَـٰذَآ","ini","hādhā",56],["أَمْ","atau","am",85],["أَنتُمْ","kamu","antum",88],["لَا","tidak","lā",4],["تُبْصِرُونَ","kamu melihat","tub'ṣirūna",380]],"t":"Maka apakah ini sihir? Ataukah kamu tidak melihat?"},{"n":16,"w":[["ٱصْلَوْهَا","masuklah kedalam","iṣ'lawhā",685],["فَٱصْبِرُوٓا۟","maka bersabarlah kamu","fa-iṣ'birū",205],["أَوْ","atau","aw",42],["لَا","tidak","lā",4],["تَصْبِرُوا۟","kamu sabar","taṣbirū",205],["سَوَآءٌ","sama saja","sawāon",410],["عَلَيْكُمْ ۖ","atas kalian","ʿalaykum",7],["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",165],["مَا","apa yang","mā",2],["كُنتُمْ","kalian adalah","kuntum",8],["تَعْمَلُونَ","kamu perbuat","taʿmalūna",44]],"t":"Masuklah ke dalamnya (rasakanlah panas apinya); baik kamu bersabar atau tidak, sama saja bagimu; sesungguhnya kamu hanya diberi balasan atas apa yang telah kamu kerjakan."},{"n":17,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",247],["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","surga","jannātin",78],["وَنَعِيمٍۢ","dan kenikmatan","wanaʿīmin",579]],"t":"Sesungguhnya orang-orang yang bertakwa berada dalam surga dan kenikmatan,"},{"n":18,"w":[["فَـٰكِهِينَ","mereka bersuka ria","fākihīna",1841],["بِمَآ","dengan apa yang","bimā",2],["ءَاتَىٰهُمْ","memberikan kepada mereka","ātāhum",45],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["وَوَقَىٰهُمْ","dan memelihara mereka","wawaqāhum",610],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["عَذَابَ","azab","ʿadhāba",36],["ٱلْجَحِيمِ","neraka jahanam","l-jaḥīmi",416]],"t":"mereka bersuka ria dengan apa yang diberikan Tuhan kepada mereka; dan Tuhan memelihara mereka dari azab neraka."},{"n":19,"w":[["كُلُوا۟","makanlah","kulū",118],["وَٱشْرَبُوا۟","dan minumlah","wa-ish'rabū",616],["هَنِيٓـًٔۢا","dengan enak","hanīan",1568],["بِمَا","terhadap apa","bimā",2],["كُنتُمْ","kalian adalah","kuntum",8],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"(Dikatakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\""},{"n":20,"w":[["مُتَّكِـِٔينَ","mereka bersandar","muttakiīna",997],["عَلَىٰ","atas","ʿalā",7],["سُرُرٍۢ","dipan","sururin",1233],["مَّصْفُوفَةٍۢ ۖ","berbaris/teratur","maṣfūfatin",2454],["وَزَوَّجْنَـٰهُم","dan Kami jodohkan mereka","wazawwajnāhum",1444],["بِحُورٍ","jelita/bidadari","biḥūrin",1523],["عِينٍۢ","mata","ʿīnin",1510]],"t":"Mereka bersandar di atas dipan-dipan yang tersusun dan Kami berikan kepada mereka pasangan bidadari yang bermata indah."},{"n":21,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["ءَامَنُوا۟","beriman","āmanū",18],["وَٱتَّبَعَتْهُمْ","dan mengikuti mereka","wa-ittabaʿathum",87],["ذُرِّيَّتُهُم","anak cucu mereka","dhurriyyatuhum",355],["بِإِيمَـٰنٍ","dalam keimanan","biīmānin",261],["أَلْحَقْنَا","Kami pertemukan","alḥaqnā",1481],["بِهِمْ","dengan mereka","bihim",11],["ذُرِّيَّتَهُمْ","anak cucu mereka","dhurriyyatahum",355],["وَمَآ","dan tidak","wamā",2],["أَلَتْنَـٰهُم","Kami mengurangi mereka","alatnāhum",2976],["مِّنْ","dari","min",0],["عَمَلِهِم","amal perbuatan mereka","ʿamalihim",174],["مِّن","dari","min",0],["شَىْءٍۢ ۚ","sedikit pun","shayin",41],["كُلُّ","tiap-tiap","kullu",31],["ٱمْرِئٍۭ","seseorang","im'ri-in",1450],["بِمَا","dengan apa yang","bimā",2],["كَسَبَ","ia kerjakan","kasaba",196],["رَهِينٌۭ","terikat/tergantung","rahīnun",4163]],"t":"Dan orang-orang yang beriman, beserta anak cucu mereka yang mengikuti mereka dalam keimanan, Kami pertemukan mereka dengan anak cucu mereka (di dalam surga), dan Kami tidak mengurangi sedikit pun pahala amal (kebajikan) mereka. Setiap orang terikat dengan apa yang dikerjakannya."},{"n":22,"w":[["وَأَمْدَدْنَـٰهُم","dan Kami tambah mereka","wa-amdadnāhum",819],["بِفَـٰكِهَةٍۢ","dengan buah-buahan","bifākihatin",663],["وَلَحْمٍۢ","dan daging","walaḥmin",739],["مِّمَّا","dari apa","mimmā",0],["يَشْتَهُونَ","mereka ingini","yashtahūna",1020]],"t":"Dan Kami berikan kepada mereka tambahan berupa buah-buahan dan daging dari segala jenis yang mereka ingini."},{"n":23,"w":[["يَتَنَـٰزَعُونَ","mereka saling mengedarkan","yatanāzaʿūna",1110],["فِيهَا","didalamnya","fīhā",3],["كَأْسًۭا","piala-piala","kasan",1191],["لَّا","tidak ada","lā",4],["لَغْوٌۭ","sesuatu yang sia-sia","laghwun",915],["فِيهَا","didalamnya","fīhā",3],["وَلَا","dan tidak ada","walā",4],["تَأْثِيمٌۭ","perbuatan dosa","tathīmun",2669]],"t":"(Di dalam surga itu) mereka saling mengulurkan gelas yang isinya tidak (menimbulkan) ucapan sia-sia ataupun perbuatan dosa."},{"n":24,"w":[["۞ وَيَطُوفُ","dan berkeliling","wayaṭūfu",970],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["غِلْمَانٌۭ","anak-anak muda","ghil'mānun",691],["لَّهُمْ","untuk mereka","lahum",11],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",385],["لُؤْلُؤٌۭ","mutiara","lu'lu-on",1198],["مَّكْنُونٌۭ","tersimpan","maknūnun",1615]],"t":"Dan di sekitar mereka ada anak-anak muda yang berkeliling untuk (melayani) mereka, seakan-akan mereka itu mutiara yang tersimpan."},{"n":25,"w":[["وَأَقْبَلَ","dan menghadap","wa-aqbala",881],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",72],["عَلَىٰ","atas","ʿalā",7],["بَعْضٍۢ","sebagian","baʿḍin",72],["يَتَسَآءَلُونَ","mereka saling tanya menanya","yatasāalūna",940]],"t":"Dan sebagian mereka berhadap-hadapan satu sama lain saling bertegur sapa."},{"n":26,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya kami","innā",5],["كُنَّا","adalah kami","kunnā",8],["قَبْلُ","dahulu","qablu",51],["فِىٓ","dalam","fī",3],["أَهْلِنَا","keluarga kami","ahlinā",94],["مُشْفِقِينَ","orang-orang yang takut","mush'fiqīna",991]],"t":"Mereka berkata, \"Sesungguhnya kami dahulu, sewaktu berada di tengah-tengah keluarga kami merasa takut (akan diazab)."},{"n":27,"w":[["فَمَنَّ","maka memberi karunia","famanna",601],["ٱللَّهُ","Allah","l-lahu",1],["عَلَيْنَا","atas kami","ʿalaynā",7],["وَوَقَىٰنَا","dan Dia memelihara kami","wawaqānā",610],["عَذَابَ","azab","ʿadhāba",36],["ٱلسَّمُومِ","sangat panas","l-samūmi",2008]],"t":"Maka Allah memberikan karunia kepada kami dan memelihara kami dari azab neraka."},{"n":28,"w":[["إِنَّا","sesungguhnya kami","innā",5],["كُنَّا","adalah kami","kunnā",8],["مِن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["نَدْعُوهُ ۖ","kami menyembah-Nya","nadʿūhu",66],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",19],["ٱلْبَرُّ","Yang Melimpahkan Kebaikan","l-baru",467],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",104]],"t":"Sesungguhnya kami menyembah-Nya sejak dahulu. Dialah Yang Maha Melimpahkan Kebaikan, Maha Penyayang.\""},{"n":29,"w":[["فَذَكِّرْ","maka berilah peringatan","fadhakkir",540],["فَمَآ","maka tidaklah","famā",2],["أَنتَ","kamu","anta",145],["بِنِعْمَتِ","dengan nikmat","biniʿ'mati",240],["رَبِّكَ","Tuhanmu","rabbika",10],["بِكَاهِنٍۢ","dengan dukun/tukang tenung","bikāhinin",2414],["وَلَا","dan tidak","walā",4],["مَجْنُونٍ","seorang gila","majnūnin",791]],"t":"Maka peringatkanlah, karena dengan nikmat Tuhanmu engkau (Muhammad) bukanlah seorang tukang tenung dan bukan pula orang gila."},{"n":30,"w":[["أَمْ","ataukah/apakah","am",85],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["شَاعِرٌۭ","seorang penyair","shāʿirun",1262],["نَّتَرَبَّصُ","kita tunggu-tunggu","natarabbaṣu",702],["بِهِۦ","dengannya","bihi",16],["رَيْبَ","ragu-ragu","rayba",558],["ٱلْمَنُونِ","zaman/masa","l-manūni",3724]],"t":"Bahkan mereka berkata, \"Dia adalah seorang penyair yang kami tunggu-tunggu kecelakaan menimpanya.\""},{"n":31,"w":[["قُلْ","katakanlah","qul",6],["تَرَبَّصُوا۟","tunggulah","tarabbaṣū",702],["فَإِنِّى","maka sesungguhnya aku","fa-innī",5],["مَعَكُم","bersamamu","maʿakum",70],["مِّنَ","dari","mina",0],["ٱلْمُتَرَبِّصِينَ","orang-orang yanng menunggu","l-mutarabiṣīna",1954]],"t":"Katakanlah (Muhammad), \"Tunggulah! Sesungguhnya aku pun termasuk orang yang sedang menunggu bersama kamu.\""},{"n":32,"w":[["أَمْ","ataukah/apakah","am",85],["تَأْمُرُهُمْ","memerintahkan mereka","tamuruhum",151],["أَحْلَـٰمُهُم","pikiran-pikiran mereka","aḥlāmuhum",1160],["بِهَـٰذَآ ۚ","dengan ini","bihādhā",56],["أَمْ","ataukah/apakah","am",85],["هُمْ","mereka","hum",11],["قَوْمٌۭ","kaum","qawmun",27],["طَاغُونَ","melampaui batas","ṭāghūna",1163]],"t":"Apakah mereka diperintah oleh pikiran-pikiran mereka untuk mengucapkan (tuduhan-tuduhan) ini ataukah mereka kaum yang melampaui batas?"},{"n":33,"w":[["أَمْ","ataukah/apakah","am",85],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["تَقَوَّلَهُۥ ۚ","ia mengada-adakannya","taqawwalahu",2689],["بَل","bahkan","bal",97],["لَّا","tidak","lā",4],["يُؤْمِنُونَ","mereka tidak beriman","yu'minūna",18]],"t":"Ataukah mereka berkata, \"Dia (Muhammad) mereka-rekanya.\" Tidak! Merekalah yang tidak beriman."},{"n":34,"w":[["فَلْيَأْتُوا۟","maka hendaklah mereka mendatangkan","falyatū",48],["بِحَدِيثٍۢ","dengan perkataan","biḥadīthin",392],["مِّثْلِهِۦٓ","serupa dengannya","mith'lihi",158],["إِن","jika","in",14],["كَانُوا۟","mereka adalah","kānū",8],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Maka cobalah mereka membuat yang semisal dengannya (Alquran) jika mereka orang-orang yang benar."},{"n":35,"w":[["أَمْ","ataukah/apakah","am",85],["خُلِقُوا۟","mereka diciptakan","khuliqū",62],["مِنْ","dari","min",0],["غَيْرِ","selain","ghayri",77],["شَىْءٍ","sesuatu","shayin",41],["أَمْ","ataukah/apakah","am",85],["هُمُ","mereka","humu",11],["ٱلْخَـٰلِقُونَ","yang menciptakan","l-khāliqūna",754]],"t":"Atau apakah mereka tercipta tanpa asal-usul ataukah mereka yang menciptakan (diri mereka sendiri)?"},{"n":36,"w":[["أَمْ","ataukah/apakah","am",85],["خَلَقُوا۟","mereka menciptakan","khalaqū",62],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضَ ۚ","dan bumi","wal-arḍa",22],["بَل","tetapi","bal",97],["لَّا","tidak","lā",4],["يُوقِنُونَ","mereka meyakini","yūqinūna",720]],"t":"Ataukah mereka telah menciptakan langit dan bumi? Sebenarnya mereka tidak meyakini (apa yang mereka katakan)."},{"n":37,"w":[["أَمْ","ataukah/apakah","am",85],["عِندَهُمْ","di sisi mereka","ʿindahum",60],["خَزَآئِنُ","perbendaharaan","khazāinu",1016],["رَبِّكَ","Tuhanmu","rabbika",10],["أَمْ","ataukah/apakah","am",85],["هُمُ","mereka","humu",11],["ٱلْمُصَۣيْطِرُونَ","yang berkuasa","l-muṣayṭirūna",2495]],"t":"Ataukah di sisi mereka ada perbendaharaan Tuhanmu ataukah mereka yang berkuasa?"},{"n":38,"w":[["أَمْ","ataukah/apakah","am",85],["لَهُمْ","bagi mereka","lahum",11],["سُلَّمٌۭ","tangga","sullamun",2663],["يَسْتَمِعُونَ","mereka mendengarkan","yastamiʿūna",614],["فِيهِ ۖ","padanya","fīhi",3],["فَلْيَأْتِ","maka hendaklah mendatangkan","falyati",48],["مُسْتَمِعُهُم","orang yang mendengarkan diantara mereka","mus'tamiʿuhum",2517],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/keterangan","bisul'ṭānin",328],["مُّبِينٍ","nyata","mubīnin",103]],"t":"Atau apakah mereka mempunyai tangga (ke langit) untuk mendengarkan (hal-hal yang gaib)? Maka hendaklah orang yang mendengarkan di antara mereka itu datang membawa keterangan yang nyata."},{"n":39,"w":[["أَمْ","ataukah/apakah","am",85],["لَهُ","bagi-Nya","lahu",16],["ٱلْبَنَـٰتُ","anak-anak perempuan","l-banātu",572],["وَلَكُمُ","dan bagimu","walakumu",26],["ٱلْبَنُونَ","anak-anak laki-laki","l-banūna",82]],"t":"Ataukah (pantas) untuk Dia anak-anak perempuan sedangkan untuk kamu anak-anak laki-laki?"},{"n":40,"w":[["أَمْ","atau","am",85],["تَسْـَٔلُهُمْ","kamu meminta kepada mereka","tasaluhum",109],["أَجْرًۭا","upah","ajran",111],["فَهُم","maka mereka","fahum",11],["مِّن","dari","min",0],["مَّغْرَمٍۢ","hutang","maghramin",1942],["مُّثْقَلُونَ","orang-orang yang dibebani","muth'qalūna",2549]],"t":"Ataukah engkau (Muhammad) meminta imbalan kepada mereka sehingga mereka dibebani dengan hutang?"},{"n":41,"w":[["أَمْ","ataukah/apakah","am",85],["عِندَهُمُ","di sisi mereka","ʿindahumu",60],["ٱلْغَيْبُ","kegaiban","l-ghaybu",244],["فَهُمْ","lalu mereka","fahum",11],["يَكْتُبُونَ","mereka menulis","yaktubūna",245]],"t":"Ataukah di sisi mereka mempunyai (pengetahuan) tentang yang gaib lalu mereka menuliskannya?"},{"n":42,"w":[["أَمْ","ataukah/apakah","am",85],["يُرِيدُونَ","mereka hendak","yurīdūna",84],["كَيْدًۭا ۖ","tipu-daya","kaydan",417],["فَٱلَّذِينَ","maka orang-orang yang","fa-alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["هُمُ","mereka","humu",11],["ٱلْمَكِيدُونَ","orang-orang yang kena tipu daya","l-makīdūna",3706]],"t":"Ataukah mereka hendak melakukan tipu daya? Tetapi orang-orang yang kafir itu, justru merekalah yang terkena tipu daya."},{"n":43,"w":[["أَمْ","ataukah/apakah","am",85],["لَهُمْ","bagi mereka","lahum",11],["إِلَـٰهٌ","Tuhan","ilāhun",76],["غَيْرُ","selain","ghayru",77],["ٱللَّهِ ۚ","Allah","l-lahi",1],["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",293],["ٱللَّهِ","Allah","l-lahi",1],["عَمَّا","dari apa yang","ʿammā",21],["يُشْرِكُونَ","mereka persekutukan","yush'rikūna",172]],"t":"Ataukah mereka mempunyai tuhan selain Allah? Mahasuci Allah dari apa yang mereka persekutukan."},{"n":44,"w":[["وَإِن","dan jika","wa-in",14],["يَرَوْا۟","mereka melihat","yaraw",46],["كِسْفًۭا","sepotong/sebagian","kis'fan",3611],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",37],["سَاقِطًۭا","jatuh","sāqiṭan",4229],["يَقُولُوا۟","mereka mengatakan","yaqūlū",6],["سَحَابٌۭ","awan","saḥābun",933],["مَّرْكُومٌۭ","bertumpuk-tumpuk","markūmun",3930]],"t":"Dan jika mereka melihat gumpalan-gumpalan awan berjatuhan dari langit, mereka berkata, \"Itu adalah awan yang bertumpuk-tumpuk.\""},{"n":45,"w":[["فَذَرْهُمْ","maka biarkanlah mereka","fadharhum",266],["حَتَّىٰ","sehingga","ḥattā",83],["يُلَـٰقُوا۟","mereka menemui","yulāqū",1886],["يَوْمَهُمُ","hari mereka","yawmahumu",25],["ٱلَّذِى","yang","alladhī",38],["فِيهِ","pada hari itu","fīhi",3],["يُصْعَقُونَ","mereka dibinasakan","yuṣ'ʿaqūna",2282]],"t":"Maka biarkanlah mereka hingga mereka menemui hari (yang dijanjikan kepada) mereka, pada hari itu mereka dibinasakan,"},{"n":46,"w":[["يَوْمَ","hari","yawma",25],["لَا","tidak","lā",4],["يُغْنِى","berguna","yugh'nī",275],["عَنْهُمْ","dari mereka","ʿanhum",21],["كَيْدُهُمْ","tipu daya mereka","kayduhum",417],["شَيْـًۭٔا","sedikit pun","shayan",41],["وَلَا","dan tidaklah","walā",4],["هُمْ","mereka","hum",11],["يُنصَرُونَ","mereka di tolong","yunṣarūna",202]],"t":"(yaitu) pada hari (ketika) tipu daya mereka tidak berguna sedikit pun bagi mereka dan mereka tidak akan diberi pertolongan."},{"n":47,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",9],["ظَلَمُوا۟","zallim","ẓalamū",108],["عَذَابًۭا","azab","ʿadhāban",36],["دُونَ","selain","dūna",80],["ذَٰلِكَ","demikian itu/dari itu","dhālika",20],["وَلَـٰكِنَّ","akan tetapi","walākinna",210],["أَكْثَرَهُمْ","kebanyakan mereka","aktharahum",146],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Dan sesungguhnya bagi orang-orang yang zalim masih ada azab selain itu. Tetapi kebanyakan mereka tidak mengetahui."},{"n":48,"w":[["وَٱصْبِرْ","dan bersabarlah","wa-iṣ'bir",205],["لِحُكْمِ","pada ketetapan","liḥuk'mi",372],["رَبِّكَ","Tuhanmu","rabbika",10],["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["بِأَعْيُنِنَا ۖ","pada pengawasan Kami","bi-aʿyuninā",208],["وَسَبِّحْ","dan bertasbihlah","wasabbiḥ",283],["بِحَمْدِ","dengan memuji","biḥamdi",276],["رَبِّكَ","Tuhanmu","rabbika",10],["حِينَ","ketika","ḥīna",335],["تَقُومُ","kamu berdiri/bangun","taqūmu",354]],"t":"Dan bersabarlah (Muhammad) menunggu ketetapan Tuhanmu, karena sesungguhnya engkau berada dalam pengawasan Kami, dan bertasbihlah dengan memuji Tuhanmu ketika engkau bangun."},{"n":49,"w":[["وَمِنَ","dan dari","wamina",0],["ٱلَّيْلِ","malam","al-layli",137],["فَسَبِّحْهُ","maka bertasbihlah","fasabbiḥ'hu",283],["وَإِدْبَـٰرَ","dan dibelakang/terbenam","wa-id'bāra",2888],["ٱلنُّجُومِ","bintang-bintang","l-nujūmi",699]],"t":"dan pada sebagian malam bertasbihlah kepada-Nya dan (juga) pada waktu terbenamnya bintang-bintang (pada waktu fajar)."}]