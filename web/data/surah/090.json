[{"n":1,"w":[["لَآ","sungguh","lā",4],["أُقْسِمُ","Aku bersumpah","uq'simu",505],["بِهَـٰذَا","dengan ini","bihādhā",37],["ٱلْبَلَدِ","negeri","l-baladi",663]],"t":"Aku bersumpah dengan negeri ini (Mekkah),"},{"n":2,"w":[["وَأَنتَ","dan kamu","wa-anta",138],["حِلٌّۢ","halal/bertempat","ḥillun",1308],["بِهَـٰذَا","dengan ini","bihādhā",37],["ٱلْبَلَدِ","negeri","l-baladi",663]],"t":"dan engkau (Muhammad), bertempat di negeri (Mekkah) ini,"},{"n":3,"w":[["وَوَالِدٍۢ","demi bapak","wawālidin",676],["وَمَا","dan apa","wamā",2],["وَلَدَ","ia lahirkan (anak)","walada",934]],"t":"dan demi (pertalian) bapak dan anaknya."},{"n":4,"w":[["لَقَدْ","sesungguhnya","laqad",24],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",60],["ٱلْإِنسَـٰنَ","manusia","l-insāna",165],["فِى","dalam","fī",3],["كَبَدٍ","susah payah","kabadin",3582]],"t":"Sungguh, Kami telah menciptakan manusia berada dalam susah payah."},{"n":5,"w":[["أَيَحْسَبُ","apakah (manusia) menyangka","ayaḥsabu",266],["أَن","bahwa","an",16],["لَّن","tidak","lan",109],["يَقْدِرَ","berkuasa","yaqdira",431],["عَلَيْهِ","atasnya","ʿalayhi",8],["أَحَدٌۭ","seseorang/satu","aḥadun",155]],"t":"Apakah dia (manusia) itu mengira bahwa tidak ada sesuatu pun yang berkuasa atasnya?"},{"n":6,"w":[["يَقُولُ","ia berkata","yaqūlu",6],["أَهْلَكْتُ","aku telah binasakan/habiskan","ahlaktu",232],["مَالًۭا","harta","mālan",126],["لُّبَدًا","banyak","lubadan",3636]],"t":"Dia mengatakan, \"Aku telah menghabiskan harta yang banyak.\""},{"n":7,"w":[["أَيَحْسَبُ","apakah ia menyangka","ayaḥsabu",266],["أَن","bahwa","an",16],["لَّمْ","tidak","lam",32],["يَرَهُۥٓ","berkuasa","yarahu",46],["أَحَدٌ","seorang/satu","aḥadun",155]],"t":"Apakah dia mengira bahwa tidak ada sesuatu pun yang melihatnya?"},{"n":8,"w":[["أَلَمْ","bukankah","alam",32],["نَجْعَل","Kami jadikan","najʿal",33],["لَّهُۥ","baginya","lahu",17],["عَيْنَيْنِ","dua buah mata","ʿaynayni",208]],"t":"Bukankah Kami telah menjadikan untuknya sepasang mata,"},{"n":9,"w":[["وَلِسَانًۭا","dan lisan/lidah","walisānan",429],["وَشَفَتَيْنِ","dan dua buah bibir","washafatayni",2872]],"t":"dan lidah dan sepasang bibir?"},{"n":10,"w":[["وَهَدَيْنَـٰهُ","dan Kami telah tunjukannya","wahadaynāhu",79],["ٱلنَّجْدَيْنِ","dua jalan","l-najdayni",4109]],"t":"Dan Kami telah menunjukkan kepadanya dua jalan (kebajikkan dan kejahatan)."},{"n":11,"w":[["فَلَا","maka/tetapi tidak","falā",4],["ٱقْتَحَمَ","ia menempuh","iq'taḥama",4843],["ٱلْعَقَبَةَ","pendakian/mendaki","l-ʿaqabata",2247]],"t":"Tetapi dia tidak menempuh jalan yang mendaki dan sukar?"},{"n":12,"w":[["وَمَآ","da apakah","wamā",2],["أَدْرَىٰكَ","kamu tahu","adrāka",564],["مَا","apa","mā",2],["ٱلْعَقَبَةُ","pendakian itu","l-ʿaqabatu",2247]],"t":"Dan tahukah kamu apakah jalan yang mendaki dan sukar itu?"},{"n":13,"w":[["فَكُّ","memerdekakan","fakku",3432],["رَقَبَةٍ","budak","raqabatin",924]],"t":"(Yaitu) membebaskan budak (hamba sahaya),"},{"n":14,"w":[["أَوْ","atau","aw",42],["إِطْعَـٰمٌۭ","memberi makan","iṭ'ʿāmun",1720],["فِى","pada","fī",3],["يَوْمٍۢ","hari","yawmin",25],["ذِى","mempunyai","dhī",113],["مَسْغَبَةٍۢ","kelaparan","masghabatin",3734]],"t":"atau memberi makan pada hari terjadi kelaparan,"},{"n":15,"w":[["يَتِيمًۭا","anak yatim","yatīman",462],["ذَا","mempunyai","dhā",448],["مَقْرَبَةٍ","dekat/kerabat","maqrabatin",3716]],"t":"(kepada) anak yatim yang ada hubungan kerabat,"},{"n":16,"w":[["أَوْ","atau","aw",42],["مِسْكِينًۭا","orang miskin","mis'kīnan",458],["ذَا","mempunyai","dhā",448],["مَتْرَبَةٍۢ","sangat payah/melarat","matrabatin",3738]],"t":"atau orang miskin yang sangat fakir."},{"n":17,"w":[["ثُمَّ","kemudian","thumma",34],["كَانَ","adalah ia","kāna",9],["مِنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَتَوَاصَوْا۟","dan mereka saling berwasiat/berpesan","watawāṣaw",1411],["بِٱلصَّبْرِ","dengan kesabaran","bil-ṣabri",625],["وَتَوَاصَوْا۟","dan mereka saling berwasiat/berpesan","watawāṣaw",1411],["بِٱلْمَرْحَمَةِ","dengan kasih-sayang","bil-marḥamati",3722]],"t":"Kemudian dia termasuk orang-orang yang beriman, dan saling berpesan untuk bersabar dan saling berpesan untuk berkasih sayang."},{"n":18,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["أَصْحَـٰبُ","golongan","aṣḥābu",142],["ٱلْمَيْمَنَةِ","kanan","l-maymanati",1899]],"t":"Mereka (orang-orang yang beriman dan saling berpesan itu) adalah golongan kanan."},{"n":19,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["هُمْ","mereka","hum",11],["أَصْحَـٰبُ","golongan","aṣḥābu",142],["ٱلْمَشْـَٔمَةِ","kiri","l-mashamati",1880]],"t":"Dan orang-orang yang kafir kepada ayat-ayat Kami, mereka itu adalah golongan kiri."},{"n":20,"w":[["عَلَيْهِمْ","atas/untuk mereka","ʿalayhim",8],["نَارٌۭ","api/neraka","nārun",77],["مُّؤْصَدَةٌۢ","tertutup rapat","mu'ṣadatun",2541]],"t":"Mereka berada dalam neraka yang ditutup rapat."}]