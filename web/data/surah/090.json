[{"n":1,"w":[["لَآ","sungguh","lā",8],["أُقْسِمُ","Aku bersumpah","uq'simu",514],["بِهَـٰذَا","dengan ini","bihādhā",64],["ٱلْبَلَدِ","negeri","l-baladi",672]],"t":"Aku bersumpah dengan negeri ini (Mekkah),"},{"n":2,"w":[["وَأَنتَ","dan kamu","wa-anta",154],["حِلٌّۢ","halal/bertempat","ḥillun",1320],["بِهَـٰذَا","dengan ini","bihādhā",64],["ٱلْبَلَدِ","negeri","l-baladi",672]],"t":"dan engkau (Muhammad), bertempat di negeri (Mekkah) ini,"},{"n":3,"w":[["وَوَالِدٍۢ","demi bapak","wawālidin",595],["وَمَا","dan apa","wamā",6],["وَلَدَ","ia lahirkan (anak)","walada",954]],"t":"dan demi (pertalian) bapak dan anaknya."},{"n":4,"w":[["لَقَدْ","sesungguhnya","laqad",30],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["فِى","dalam","fī",7],["كَبَدٍ","susah payah","kabadin",3604]],"t":"Sungguh, Kami telah menciptakan manusia berada dalam susah payah."},{"n":5,"w":[["أَيَحْسَبُ","apakah (manusia) menyangka","ayaḥsabu",280],["أَن","bahwa","an",22],["لَّن","tidak","lan",123],["يَقْدِرَ","berkuasa","yaqdira",444],["عَلَيْهِ","atasnya","ʿalayhi",11],["أَحَدٌۭ","seseorang/satu","aḥadun",170]],"t":"Apakah dia (manusia) itu mengira bahwa tidak ada sesuatu pun yang berkuasa atasnya?"},{"n":6,"w":[["يَقُولُ","ia berkata","yaqūlu",10],["أَهْلَكْتُ","aku telah binasakan/habiskan","ahlaktu",243],["مَالًۭا","harta","mālan",141],["لُّبَدًا","banyak","lubadan",3661]],"t":"Dia mengatakan, \"Aku telah menghabiskan harta yang banyak.\""},{"n":7,"w":[["أَيَحْسَبُ","apakah ia menyangka","ayaḥsabu",280],["أَن","bahwa","an",22],["لَّمْ","tidak","lam",39],["يَرَهُۥٓ","berkuasa","yarahu",54],["أَحَدٌ","seorang/satu","aḥadun",170]],"t":"Apakah dia mengira bahwa tidak ada sesuatu pun yang melihatnya?"},{"n":8,"w":[["أَلَمْ","bukankah","alam",39],["نَجْعَل","Kami jadikan","najʿal",40],["لَّهُۥ","baginya","lahu",21],["عَيْنَيْنِ","dua buah mata","ʿaynayni",218]],"t":"Bukankah Kami telah menjadikan untuknya sepasang mata,"},{"n":9,"w":[["وَلِسَانًۭا","dan lisan/lidah","walisānan",442],["وَشَفَتَيْنِ","dan dua buah bibir","washafatayni",2841]],"t":"dan lidah dan sepasang bibir?"},{"n":10,"w":[["وَهَدَيْنَـٰهُ","dan Kami telah tunjukannya","wahadaynāhu",89],["ٱلنَّجْدَيْنِ","dua jalan","l-najdayni",4087]],"t":"Dan Kami telah menunjukkan kepadanya dua jalan (kebajikkan dan kejahatan)."},{"n":11,"w":[["فَلَا","maka/tetapi tidak","falā",8],["ٱقْتَحَمَ","ia menempuh","iq'taḥama",4652],["ٱلْعَقَبَةَ","pendakian/mendaki","l-ʿaqabata",2240]],"t":"Tetapi dia tidak menempuh jalan yang mendaki dan sukar?"},{"n":12,"w":[["وَمَآ","da apakah","wamā",6],["أَدْرَىٰكَ","kamu tahu","adrāka",574],["مَا","apa","mā",6],["ٱلْعَقَبَةُ","pendakian itu","l-ʿaqabatu",2240]],"t":"Dan tahukah kamu apakah jalan yang mendaki dan sukar itu?"},{"n":13,"w":[["فَكُّ","memerdekakan","fakku",3436],["رَقَبَةٍ","budak","raqabatin",942]],"t":"(Yaitu) membebaskan budak (hamba sahaya),"},{"n":14,"w":[["أَوْ","atau","aw",50],["إِطْعَـٰمٌۭ","memberi makan","iṭ'ʿāmun",1731],["فِى","pada","fī",7],["يَوْمٍۢ","hari","yawmin",31],["ذِى","mempunyai","dhī",112],["مَسْغَبَةٍۢ","kelaparan","masghabatin",3754]],"t":"atau memberi makan pada hari terjadi kelaparan,"},{"n":15,"w":[["يَتِيمًۭا","anak yatim","yatīman",471],["ذَا","mempunyai","dhā",112],["مَقْرَبَةٍ","dekat/kerabat","maqrabatin",3740]],"t":"(kepada) anak yatim yang ada hubungan kerabat,"},{"n":16,"w":[["أَوْ","atau","aw",50],["مِسْكِينًۭا","orang miskin","mis'kīnan",467],["ذَا","mempunyai","dhā",112],["مَتْرَبَةٍۢ","sangat payah/melarat","matrabatin",3759]],"t":"atau orang miskin yang sangat fakir."},{"n":17,"w":[["ثُمَّ","kemudian","thumma",41],["كَانَ","adalah ia","kāna",12],["مِنَ","dari","mina",1],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَتَوَاصَوْا۟","dan mereka saling berwasiat/berpesan","watawāṣaw",1434],["بِٱلصَّبْرِ","dengan kesabaran","bil-ṣabri",634],["وَتَوَاصَوْا۟","dan mereka saling berwasiat/berpesan","watawāṣaw",1434],["بِٱلْمَرْحَمَةِ","dengan kasih-sayang","bil-marḥamati",3744]],"t":"Kemudian dia termasuk orang-orang yang beriman, dan saling berpesan untuk bersabar dan saling berpesan untuk berkasih sayang."},{"n":18,"w":[["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["أَصْحَـٰبُ","golongan","aṣḥābu",132],["ٱلْمَيْمَنَةِ","kanan","l-maymanati",1925]],"t":"Mereka (orang-orang yang beriman dan saling berpesan itu) adalah golongan kanan."},{"n":19,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",34],["هُمْ","mereka","hum",16],["أَصْحَـٰبُ","golongan","aṣḥābu",132],["ٱلْمَشْـَٔمَةِ","kiri","l-mashamati",1906]],"t":"Dan orang-orang yang kafir kepada ayat-ayat Kami, mereka itu adalah golongan kiri."},{"n":20,"w":[["عَلَيْهِمْ","atas/untuk mereka","ʿalayhim",11],["نَارٌۭ","api/neraka","nārun",87],["مُّؤْصَدَةٌۢ","tertutup rapat","mu'ṣadatun",2552]],"t":"Mereka berada dalam neraka yang ditutup rapat."}]