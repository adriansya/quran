[{"n":1,"w":[["وَٱلَّيْلِ","demi malam","wa-al-layli",146],["إِذَا","apabila","idhā",29],["يَغْشَىٰ","ia menutup","yaghshā",699]],"t":"Demi malam apabila menutupi (cahaya siang),"},{"n":2,"w":[["وَٱلنَّهَارِ","dan siang","wal-nahāri",221],["إِذَا","apabila","idhā",29],["تَجَلَّىٰ","terang benderang","tajallā",2697]],"t":"demi siang bila terang benderang,"},{"n":3,"w":[["وَمَا","dan apa","wamā",6],["خَلَقَ","ciptakan","khalaqa",70],["ٱلذَّكَرَ","laki-laki","l-dhakara",548],["وَٱلْأُنثَىٰٓ","dan perempuan","wal-unthā",448]],"t":"demi penciptaan laki-laki dan perempuan,"},{"n":4,"w":[["إِنَّ","sesungguhnya","inna",9],["سَعْيَكُمْ","usahamu","saʿyakum",873],["لَشَتَّىٰ","sungguh berbeda-beda","lashattā",1720]],"t":"sungguh, usahamu memang beraneka macam."},{"n":5,"w":[["فَأَمَّا","maka adapun","fa-ammā",229],["مَنْ","orang","man",17],["أَعْطَىٰ","ia memberikan","aʿṭā",967],["وَٱتَّقَىٰ","dan bertaqwa","wa-ittaqā",76]],"t":"Maka barangsiapa memberikan (hartanya di jalan Allah) dan bertakwa,"},{"n":6,"w":[["وَصَدَّقَ","dan ia membenarkan/akui","waṣaddaqa",838],["بِٱلْحُسْنَىٰ","dengan kebaikan","bil-ḥus'nā",579]],"t":"dan membenarkan (adanya pahala) yang terbaik (surga),"},{"n":7,"w":[["فَسَنُيَسِّرُهُۥ","maka Kami akan memudahkannya","fasanuyassiruhu",820],["لِلْيُسْرَىٰ","pada yang mudah","lil'yus'rā",2781]],"t":"maka akan Kami mudahkan baginya jalan menuju kemudahan (kebahagiaan)."},{"n":8,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["مَنۢ","orang","man",17],["بَخِلَ","ia kikir","bakhila",845],["وَٱسْتَغْنَىٰ","dan ia merasa cukup","wa-is'taghnā",1716]],"t":"Dan adapun orang yang kikir dan merasa dirinya cukup (tidak perlu pertolongan Allah),"},{"n":9,"w":[["وَكَذَّبَ","dan ia mendustakan","wakadhaba",72],["بِٱلْحُسْنَىٰ","dengan kebaikan","bil-ḥus'nā",579]],"t":"serta mendustakan (pahala) yang terbaik,"},{"n":10,"w":[["فَسَنُيَسِّرُهُۥ","maka Kami akan memudahkan","fasanuyassiruhu",820],["لِلْعُسْرَىٰ","pada yang sukar","lil'ʿus'rā",3150]],"t":"maka akan Kami mudahkan baginya jalan menuju kesukaran (kesengsaraan)."},{"n":11,"w":[["وَمَا","dan tidak","wamā",6],["يُغْنِى","mencukupi/berguna","yugh'nī",285],["عَنْهُ","dari padanya/baginya","ʿanhu",27],["مَالُهُۥٓ","hartanya","māluhu",141],["إِذَا","apabila","idhā",29],["تَرَدَّىٰٓ","ia telah binasa","taraddā",4401]],"t":"Dan hartanya tidak bermanfaat baginya apabila dia telah binasa."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",9],["عَلَيْنَا","bagi Kami","ʿalaynā",11],["لَلْهُدَىٰ","kesudahan/akherat","lalhudā",143]],"t":"Sesungguhnya Kami lah yang memberi petunjuk,"},{"n":13,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",9],["لَنَا","milik Kamilah","lanā",135],["لَلْـَٔاخِرَةَ","akhirat","lalākhirata",82],["وَٱلْأُولَىٰ","dan dunia itu","wal-ūlā",151]],"t":"dan sesungguhnya milik Kami lah akhirat dan dunia."},{"n":14,"w":[["فَأَنذَرْتُكُمْ","maka peringatkanlah","fa-andhartukum",279],["نَارًۭا","api neraka","nāran",87],["تَلَظَّىٰ","menyala-nyala","talaẓẓā",4380]],"t":"Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,"},{"n":15,"w":[["لَا","tidak","lā",8],["يَصْلَىٰهَآ","masuk kedalamnya","yaṣlāhā",695],["إِلَّا","kecuali","illā",20],["ٱلْأَشْقَى","paling celaka","l-ashqā",1734]],"t":"yang hanya dimasuki oleh orang yang paling celaka,"},{"n":16,"w":[["ٱلَّذِى","orang-orang yang","alladhī",45],["كَذَّبَ","mendustakan","kadhaba",72],["وَتَوَلَّىٰ","dan berpaling","watawallā",160]],"t":"yang mendustakan (kebenaran) dan berpaling (dari iman)."},{"n":17,"w":[["وَسَيُجَنَّبُهَا","dan akan dijauhkan-dia","wasayujannabuhā",3571],["ٱلْأَتْقَى","berbakti","l-atqā",2192]],"t":"Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,"},{"n":18,"w":[["ٱلَّذِى","orang-orang yang","alladhī",45],["يُؤْتِى","mendermakan","yu'tī",53],["مَالَهُۥ","apa yang dia miliki (hartanya)","mālahu",141],["يَتَزَكَّىٰ","mensucikan","yatazakkā",1020]],"t":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),"},{"n":19,"w":[["وَمَا","dan tidak","wamā",6],["لِأَحَدٍ","satupun","li-aḥadin",170],["عِندَهُۥ","pada sisinya","ʿindahu",68],["مِن","dari","min",1],["نِّعْمَةٍۢ","nikmat","niʿ'matin",250],["تُجْزَىٰٓ","patut dibalas","tuj'zā",175]],"t":"dan tidak ada seorang pun memberikan suatu nikmat padanya yang harus dibalasnya,"},{"n":20,"w":[["إِلَّا","kecuali","illā",20],["ٱبْتِغَآءَ","mencari","ib'tighāa",686],["وَجْهِ","keridhaan","wajhi",180],["رَبِّهِ","Tuhannya","rabbihi",15],["ٱلْأَعْلَىٰ","yang Maha Tinggi","l-aʿlā",776]],"t":"tetapi (dia memberikan itu semata-mata) karena mencari keridaan Tuhannya Yang Mahatinggi."},{"n":21,"w":[["وَلَسَوْفَ","dan kelak","walasawfa",295],["يَرْضَىٰ","ridha","yarḍā",328]],"t":"Dan niscaya kelak dia akan mendapat kesenangan (yang sempurna)."}]