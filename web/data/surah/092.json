n baginya jalan menuju kesukaran (kesengsaraan)."},{"n":11,"w":[["وَمَا","dan tidak","wamā",2],["يُغْنِى","mencukupi/berguna","yugh'nī",383],["عَنْهُ","dari padanya/baginya","ʿanhu",21],["مَالُهُۥٓ","hartanya","māluhu",127],["إِذَا","apabila","idhā",23],["تَرَدَّىٰٓ","ia telah binasa","taraddā",4423]],"t":"Dan hartanya tidak bermanfaat baginya apabila dia telah binasa."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",5],["عَلَيْنَا","bagi Kami","ʿalaynā",8],["لَلْهُدَىٰ","kesudahan/akherat","lalhudā",129]],"t":"Sesungguhnya Kami lah yang memberi petunjuk,"},{"n":13,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَنَا","milik Kamilah","lanā",121],["لَلْـَٔاخِرَةَ","akhirat","lalākhirata",72],["وَٱلْأُولَىٰ","dan dunia itu","wal-ūlā",137]],"t":"dan sesungguhnya milik Kami lah akhirat dan dunia."},{"n":14,"w":[["فَأَنذَرْتُكُمْ","maka peringatkanlah","fa-andhartukum",264],["نَارًۭا","api neraka","nāran",77],["تَلَظَّىٰ","menyala-nyala","talaẓẓā",4397]],"t":"Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,"},{"n":15,"w":[["لَا","tidak","lā",4],["يَصْلَىٰهَآ","masuk kedalamnya","yaṣlāhā",703],["إِلَّا","kecuali","illā",15],["ٱلْأَشْقَى","paling celaka","l-ashqā",1718]],"t":"yang hanya dimasuki oleh orang yang paling celaka,"},{"n":16,"w":[["ٱلَّذِى","orang-orang yang","alladhī",7],["كَذَّبَ","mendustakan","kadhaba",63],["وَتَوَلَّىٰ","dan berpaling","watawallā",146]],"t":"yang mendustakan (kebenaran) dan berpaling (dari iman)."},{"n":17,"w":[["وَسَيُجَنَّبُهَا","dan akan dijauhkan-dia","wasayujannabuhā",4735],["ٱلْأَتْقَى","berbakti","l-atqā",2195]],"t":"Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,"},{"n":18,"w":[["ٱلَّذِى","orang-orang yang","alladhī",7],["يُؤْتِى","mendermakan","yu'tī",45],["مَالَهُۥ","apa yang dia miliki (hartanya)","mālahu",127],["يَتَزَكَّىٰ","mensucikan","yatazakkā",1003]],"t":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),"},{"n":19,"w":[["وَمَا","dan tidak","wamā",2],["لِأَحَدٍ","satupu