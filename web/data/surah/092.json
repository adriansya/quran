n baginya jalan menuju kesukaran (kesengsaraan)."},{"n":11,"w":[["وَمَا","dan tidak","wamā",2],["يُغْنِى","mencukupi/berguna","yugh'nī",275],["عَنْهُ","dari padanya/baginya","ʿanhu",21],["مَالُهُۥٓ","hartanya","māluhu",132],["إِذَا","apabila","idhā",23],["تَرَدَّىٰٓ","ia telah binasa","taraddā",4390]],"t":"Dan hartanya tidak bermanfaat baginya apabila dia telah binasa."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",5],["عَلَيْنَا","bagi Kami","ʿalaynā",7],["لَلْهُدَىٰ","kesudahan/akherat","lalhudā",134]],"t":"Sesungguhnya Kami lah yang memberi petunjuk,"},{"n":13,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَنَا","milik Kamilah","lanā",126],["لَلْـَٔاخِرَةَ","akhirat","lalākhirata",74],["وَٱلْأُولَىٰ","dan dunia itu","wal-ūlā",142]],"t":"dan sesungguhnya milik Kami lah akhirat dan dunia."},{"n":14,"w":[["فَأَنذَرْتُكُمْ","maka peringatkanlah","fa-andhartukum",269],["نَارًۭا","api neraka","nāran",79],["تَلَظَّىٰ","menyala-nyala","talaẓẓā",4369]],"t":"Maka aku memperingatkan kamu dengan neraka yang menyala-nyala,"},{"n":15,"w":[["لَا","tidak","lā",4],["يَصْلَىٰهَآ","masuk kedalamnya","yaṣlāhā",685],["إِلَّا","kecuali","illā",15],["ٱلْأَشْقَى","paling celaka","l-ashqā",1722]],"t":"yang hanya dimasuki oleh orang yang paling celaka,"},{"n":16,"w":[["ٱلَّذِى","orang-orang yang","alladhī",38],["كَذَّبَ","mendustakan","kadhaba",64],["وَتَوَلَّىٰ","dan berpaling","watawallā",150]],"t":"yang mendustakan (kebenaran) dan berpaling (dari iman)."},{"n":17,"w":[["وَسَيُجَنَّبُهَا","dan akan dijauhkan-dia","wasayujannabuhā",3560],["ٱلْأَتْقَى","berbakti","l-atqā",2180]],"t":"Dan akan dijauhkan darinya (neraka) orang yang paling bertakwa,"},{"n":18,"w":[["ٱلَّذِى","orang-orang yang","alladhī",38],["يُؤْتِى","mendermakan","yu'tī",45],["مَالَهُۥ","apa yang dia miliki (hartanya)","mālahu",132],["يَتَزَكَّىٰ","mensucikan","yatazakkā",1008]],"t":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (dirinya),"},{"n":19,"w":[["وَمَا","dan tidak","wamā",2],["لِأَحَدٍ","satu