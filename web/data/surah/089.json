[{"n":1,"w":[["وَٱلْفَجْرِ","demi fajar","wal-fajri",1172]],"t":"Demi fajar,"},{"n":2,"w":[["وَلَيَالٍ","dan malam-malam","walayālin",136],["عَشْرٍۢ","sepuluh","ʿashrin",1039]],"t":"demi malam yang sepuluh,"},{"n":3,"w":[["وَٱلشَّفْعِ","dan yang genap","wal-shafʿi",2853],["وَٱلْوَتْرِ","dan yang ganjil","wal-watri",4489]],"t":"demi yang genap dan yang ganjil,"},{"n":4,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",136],["إِذَا","apabila","idhā",23],["يَسْرِ","berlalu","yasri",4260]],"t":"demi malam apabila berlalu."},{"n":5,"w":[["هَلْ","apakah/bukankah","hal",118],["فِى","pada","fī",3],["ذَٰلِكَ","itu/yang demikian","dhālika",19],["قَسَمٌۭ","sumpah","qasamun",2582],["لِّذِى","bagi memiliki","lidhī",116],["حِجْرٍ","akal","ḥij'rin",1300]],"t":"Adakah pada yang demikian itu terdapat sumpah (yang dapat diterima) bagi orang-orang yang berakal?"},{"n":6,"w":[["أَلَمْ","tidakkah","alam",32],["تَرَ","lihat/perhatikan","tara",46],["كَيْفَ","bagaimana","kayfa",138],["فَعَلَ","berbuat","faʿala",126],["رَبُّكَ","Tuhanmu","rabbuka",10],["بِعَادٍ","terhadap kaum 'Ad","biʿādin",434]],"t":"Tidakkah engkau (Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) 'Ād?"},{"n":7,"w":[["إِرَمَ","kaum Iram","irama",2893],["ذَاتِ","memiliki","dhāti",116],["ٱلْعِمَادِ","tiang/bangunan tinggi","l-ʿimādi",3122]],"t":"(yaitu) penduduk Iram (ibukota kaum 'Ād) yang mempunyai bangunan-bangunan yang tinggi,"},{"n":8,"w":[["ٱلَّتِى","yang","allatī",7],["لَمْ","tidak/belum","lam",32],["يُخْلَقْ","diciptakan/dibangun","yukh'laq",61],["مِثْلُهَا","seperti itu/serupa itu","mith'luhā",157],["فِى","pada","fī",3],["ٱلْبِلَـٰدِ","negeri","l-bilādi",657]],"t":"yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,"},{"n":9,"w":[["وَثَمُودَ","dan Samud","wathamūda",415],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["جَابُوا۟","(mereka) memotong","jābū",3526],["ٱلصَّخْرَ","batu-batu besar","l-ṣakhra",3273],["بِٱلْوَادِ","di lembah","bil-wādi",1107]],"t":"dan (terhadap) kaum Sa