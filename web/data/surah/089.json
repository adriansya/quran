u",1015],["فَقَدَرَ","lalu Dia menentukan/menyempitkan","faqadara",429],["عَلَيْهِ","atasnya","ʿalayhi",8],["رِزْقَهُۥ","rizkinya","riz'qahu",219],["فَيَقُولُ","lalu dia akan berkata","fayaqūlu",6],["رَبِّىٓ","Tuhanku","rabbī",10],["أَهَـٰنَنِ","Dia menghinaku","ahānani",2150]],"t":"Namun apabila Tuhan mengujinya lalu membatasi rezekinya, maka dia berkata, \"Tuhanku telah menghinaku.\""},{"n":17,"w":[["كَلَّا ۖ","sekali-kali tidak","kallā",347],["بَل","tetapi/bahkan","bal",96],["لَّا","tidak","lā",4],["تُكْرِمُونَ","kamu memuliakan","tuk'rimūna",1474],["ٱلْيَتِيمَ","anak yatim","l-yatīma",457]],"t":"Sekali-kali tidak! Bahkan kamu tidak memuliakan anak yatim,"},{"n":18,"w":[["وَلَا","dan tidak","walā",4],["تَحَـٰٓضُّونَ","saling menganjurkan","taḥāḍḍūna",4306],["عَلَىٰ","atas","ʿalā",8],["طَعَامِ","memberi makan","ṭaʿāmi",437],["ٱلْمِسْكِينِ","orang miskin","l-mis'kīni",453]],"t":"dan kamu tidak saling mengajak memberi makan orang miskin,"},{"n":19,"w":[["وَتَأْكُلُونَ","dan kamu memakan","watakulūna",117],["ٱلتُّرَاثَ","harta warisan","l-turātha",4427],["أَكْلًۭا","dengan makan","aklan",1473],["لَّمًّۭا","loba","lamman",3639]],"t":"sedangkan kamu memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),"},{"n":20,"w":[["وَتُحِبُّونَ","dan kamu mencintai","watuḥibbūna",188],["ٱلْمَالَ","harta","l-māla",131],["حُبًّۭا","cinta","ḥubban",888],["جَمًّۭا","berlebihan","jamman",3546]],"t":"dan kamu mencintai harta dengan kecintaan yang berlebihan."},{"n":21,"w":[["كَلَّآ","sekali-kali tidak","kallā",347],["إِذَا","apabila","idhā",23],["دُكَّتِ","digoncangkan/dihancurkan","dukkati",2344],["ٱلْأَرْضُ","bumi","l-arḍu",22],["دَكًّۭا","goncangan","dakkan",1829],["دَكًّۭا","goncangan","dakkan",1829]],"t":"Sekali-kali tidak! Apabila bumi diguncangkan berturut-turut (berbenturan),"},{"n":22,"w":[["وَجَآءَ","dan datang","wajāa",43],["رَبُّكَ","Tuhanmu","rabbuka",10],["وَٱلْمَلَكُ","dan malaikat","wal-malaku",127],["صَفًّۭا","berbaris","ṣaffan",1056],["صَفًّۭا","baris","ṣaffan",1056]],"t":"dan datanglah Tuhanmu; dan malaikat berbaris-baris,"},{"n":23,"w":[["وَجِا۟ىٓءَ","dan didatangkan/diperlihatkan","wajīa",43],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",180],["بِجَهَنَّمَ ۚ","neraka Jahanam","bijahannama",151],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["يَتَذَكَّرُ","akan ingat","yatadhakkaru",233],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["وَأَنَّىٰ","dan bagaimana","wa-annā",386],["لَهُ","baginya","lahu",16],["ٱلذِّكْرَىٰ","ingat/mengingat","l-dhik'rā",444]],"t":"dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu."},{"n":24,"w":[["يَقُولُ","dia berkata","yaqūlu",6],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",664],["قَدَّمْتُ","aku dahulukan/kerjakan","qaddamtu",403],["لِحَيَاتِى","untuk hidupku","liḥayātī",153]],"t":"Dia berkata, \"Alangkah baiknya sekiranya dahulu aku mengerjakan (kebajikan) untuk hidupku ini.\""},{"n":25,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",180],["لَّا","tidak","lā",4],["يُعَذِّبُ","menyiksa","yuʿadhibu",283],["عَذَابَهُۥٓ","siksa-Nya","ʿadhābahu",36],["أَحَدٌۭ","seorang/satu","aḥadun",159]],"t":"Maka pada hari itu tidak ada seorang pun yang mengazab seperti azab-Nya (yang adil),"},{"n":26,"w":[["وَلَا","dan tidak","walā",4],["يُوثِقُ","mengikat","yūthiqu",3024],["وَثَاقَهُۥٓ","ikatan-Nya","wathāqahu",2724],["أَحَدٌۭ","seorang/satu","aḥadun",159]],"t":"dan tidak ada seorang pun yang mengikat seperti ikatan-Nya."},{"n":27,"w":[["يَـٰٓأَيَّتُهَا","hai","yāayyatuhā",2190],["ٱلنَّفْسُ","jiwa/diri","l-nafsu",39],["ٱلْمُطْمَئِنَّةُ","tenang","l-muṭ'ma-inatu",1597]],"t":"Wahai jiwa yang tenang!"},{"n":28,"w":[["ٱرْجِعِىٓ","kembalilah","ir'jiʿī",146],["إِلَىٰ","kepada","ilā",13],["رَبِّكِ","Tuhanmu","rabbiki",10],["رَاضِيَةًۭ","rida/puas","rāḍiyatan",1638],["مَّرْضِيَّةًۭ","diridhoi","marḍiyyatan",2465]],"t":"Kembalilah kepada Tuhanmu dengan hati yang rida dan diridai-Nya."},{"n":29,"w":[["فَٱدْخُلِى","maka masuklah","fa-ud'khulī",154],["فِى","dalam","fī",3],["عِبَـٰدِى","hamba-Ku","ʿibādī",90]],"t":"Maka masuklah ke dalam golongan hamba-hamba-Ku,"},{"n":30,"w":[["وَٱدْخُلِى","dan masuklah","wa-ud'khulī",154],["جَنَّتِى","surga-Ku","jannatī",77]],"t":"dan masuklah ke dalam surga-Ku."}]