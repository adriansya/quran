[{"n":1,"w":[["وَٱلْفَجْرِ","demi fajar","wal-fajri",1176]],"t":"Demi fajar,"},{"n":2,"w":[["وَلَيَالٍ","dan malam-malam","walayālin",132],["عَشْرٍۢ","sepuluh","ʿashrin",1045]],"t":"demi malam yang sepuluh,"},{"n":3,"w":[["وَٱلشَّفْعِ","dan yang genap","wal-shafʿi",2898],["وَٱلْوَتْرِ","dan yang ganjil","wal-watri",4554]],"t":"demi yang genap dan yang ganjil,"},{"n":4,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",132],["إِذَا","apabila","idhā",23],["يَسْرِ","berlalu","yasri",4671]],"t":"demi malam apabila berlalu."},{"n":5,"w":[["هَلْ","apakah/bukankah","hal",115],["فِى","pada","fī",3],["ذَٰلِكَ","itu/yang demikian","dhālika",19],["قَسَمٌۭ","sumpah","qasamun",2581],["لِّذِى","bagi memiliki","lidhī",113],["حِجْرٍ","akal","ḥij'rin",1303]],"t":"Adakah pada yang demikian itu terdapat sumpah (yang dapat diterima) bagi orang-orang yang berakal?"},{"n":6,"w":[["أَلَمْ","tidakkah","alam",32],["تَرَ","lihat/perhatikan","tara",46],["كَيْفَ","bagaimana","kayfa",134],["فَعَلَ","berbuat","faʿala",122],["رَبُّكَ","Tuhanmu","rabbuka",10],["بِعَادٍ","terhadap kaum 'Ad","biʿādin",436]],"t":"Tidakkah engkau (Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) 'Ād?"},{"n":7,"w":[["إِرَمَ","kaum Iram","irama",2937],["ذَاتِ","memiliki","dhāti",113],["ٱلْعِمَادِ","tiang/bangunan tinggi","l-ʿimādi",3141]],"t":"(yaitu) penduduk Iram (ibukota kaum 'Ād) yang mempunyai bangunan-bangunan yang tinggi,"},{"n":8,"w":[["ٱلَّتِى","yang","allatī",7],["لَمْ","tidak/belum","lam",32],["يُخْلَقْ","diciptakan/dibangun","yukh'laq",60],["مِثْلُهَا","seperti itu/serupa itu","mith'luhā",155],["فِى","pada","fī",3],["ٱلْبِلَـٰدِ","negeri","l-bilādi",660]],"t":"yang belum pernah dibangun (suatu kota) seperti itu, di negeri-negeri lain,"},{"n":9,"w":[["وَثَمُودَ","dan Samud","wathamūda",417],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["جَابُوا۟","(mereka) memotong","jābū",3520],["ٱلصَّخْرَ","batu-batu besar","l-ṣakhra",3295],["بِٱلْوَادِ","di lembah","bil-wādi",1112]],"t":"dan (terhadap) kaum Sa