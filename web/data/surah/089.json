ًۭا","baris","ṣaffan",1062]],"t":"dan datanglah Tuhanmu; dan malaikat berbaris-baris,"},{"n":23,"w":[["وَجِا۟ىٓءَ","dan didatangkan/diperlihatkan","wajīa",43],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",181],["بِجَهَنَّمَ ۚ","neraka Jahanam","bijahannama",152],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["يَتَذَكَّرُ","akan ingat","yatadhakkaru",235],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["وَأَنَّىٰ","dan bagaimana","wa-annā",391],["لَهُ","baginya","lahu",16],["ٱلذِّكْرَىٰ","ingat/mengingat","l-dhik'rā",449]],"t":"dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu."},{"n":24,"w":[["يَقُولُ","dia berkata","yaqūlu",6],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",669],["قَدَّمْتُ","aku dahulukan/kerjakan","qaddamtu",408],["لِحَيَاتِى","untuk hidupku","liḥayātī",154]],"t":"Dia berkata, \"Alangkah baiknya sekiranya dahulu aku mengerjakan (kebajikan) untuk hidupku ini.\""},{"n":25,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",181],["لَّا","tidak","lā",4],["يُعَذِّبُ","menyiksa","yuʿadhibu",287],["عَذَابَهُۥٓ","siksa-Nya","ʿadhābahu",36],["أَحَدٌۭ","seorang/satu","aḥadun",160]],"t":"Maka pada hari itu tidak ada seorang pun yang mengazab seperti azab-Nya (yang adil),"},{"n":26,"w":[["وَلَا","dan tidak","walā",4],["يُوثِقُ","mengikat","yūthiqu",3031],["وَثَاقَهُۥٓ","ikatan-Nya","wathāqahu",2730],["أَحَدٌۭ","seorang/satu","aḥadun",160]],"t":"dan tidak ada seorang pun yang mengikat seperti ikatan-Nya."},{"n":27,"w":[["يَـٰٓأَيَّتُهَا","hai","yāayyatuhā",2196],["ٱلنَّفْسُ","jiwa/diri","l-nafsu",39],["ٱلْمُطْمَئِنَّةُ","tenang","l-muṭ'ma-inatu",1603]],"t":"Wahai jiwa yang tenang!"},{"n":28,"w":[["ٱرْجِعِىٓ","kembalilah","ir'jiʿī",147],["إِلَىٰ","kepada","ilā",13],["رَبِّكِ","Tuhanmu","rabbiki",10],["رَاضِيَةًۭ","rida/puas","rāḍiyatan",1644],["مَّرْضِيَّةًۭ","diridhoi","marḍiyyatan",2471]],"t":"Kembalilah kepada Tuhanmu dengan hati yang rida dan diridai-Nya."},{"n":29,