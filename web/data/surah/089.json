],["صَفًّۭا","baris","ṣaffan",1074]],"t":"dan datanglah Tuhanmu; dan malaikat berbaris-baris,"},{"n":23,"w":[["وَجِا۟ىٓءَ","dan didatangkan/diperlihatkan","wajīa",51],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",191],["بِجَهَنَّمَ ۚ","neraka Jahanam","bijahannama",162],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["يَتَذَكَّرُ","akan ingat","yatadhakkaru",245],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["وَأَنَّىٰ","dan bagaimana","wa-annā",401],["لَهُ","baginya","lahu",21],["ٱلذِّكْرَىٰ","ingat/mengingat","l-dhik'rā",458]],"t":"dan pada hari itu diperlihatkan neraka Jahanam; pada hari itu sadarlah manusia, tetapi tidak berguna lagi baginya kesadaran itu."},{"n":24,"w":[["يَقُولُ","dia berkata","yaqūlu",10],["يَـٰلَيْتَنِى","alangkah baiknya aku dulu","yālaytanī",679],["قَدَّمْتُ","aku dahulukan/kerjakan","qaddamtu",418],["لِحَيَاتِى","untuk hidupku","liḥayātī",164]],"t":"Dia berkata, \"Alangkah baiknya sekiranya dahulu aku mengerjakan (kebajikan) untuk hidupku ini.\""},{"n":25,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",191],["لَّا","tidak","lā",8],["يُعَذِّبُ","menyiksa","yuʿadhibu",297],["عَذَابَهُۥٓ","siksa-Nya","ʿadhābahu",43],["أَحَدٌۭ","seorang/satu","aḥadun",170]],"t":"Maka pada hari itu tidak ada seorang pun yang mengazab seperti azab-Nya (yang adil),"},{"n":26,"w":[["وَلَا","dan tidak","walā",8],["يُوثِقُ","mengikat","yūthiqu",3041],["وَثَاقَهُۥٓ","ikatan-Nya","wathāqahu",2741],["أَحَدٌۭ","seorang/satu","aḥadun",170]],"t":"dan tidak ada seorang pun yang mengikat seperti ikatan-Nya."},{"n":27,"w":[["يَـٰٓأَيَّتُهَا","hai","yāayyatuhā",2208],["ٱلنَّفْسُ","jiwa/diri","l-nafsu",47],["ٱلْمُطْمَئِنَّةُ","tenang","l-muṭ'ma-inatu",1615]],"t":"Wahai jiwa yang tenang!"},{"n":28,"w":[["ٱرْجِعِىٓ","kembalilah","ir'jiʿī",156],["إِلَىٰ","kepada","ilā",18],["رَبِّكِ","Tuhanmu","rabbiki",15],["رَاضِيَةًۭ","rida/puas","rāḍiyatan",1656],["مَّرْضِيَّةًۭ","diridhoi","marḍiyyatan",2482]],"t":"Kembalilah kepada Tuhanmu dengan hati yang rida dan diridai-Nya."}