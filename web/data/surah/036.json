[{"n":1,"w":[["يسٓ","Yâ­Sîn","ya-seen",3238]],"t":"Yā Sīn"},{"n":2,"w":[["وَٱلْقُرْءَانِ","demi Al Qur'an","wal-qur'āni",175],["ٱلْحَكِيمِ","penuh hikmat","l-ḥakīmi",112]],"t":"Demi Alquran yang penuh hikmah,"},{"n":3,"w":[["إِنَّكَ","sesungguhnya kamu","innaka",5],["لَمِنَ","sungguh dari (salah seorang)","lamina",0],["ٱلْمُرْسَلِينَ","para rasul","l-mur'salīna",331]],"t":"sungguh, engkau (Muhammad) adalah salah seorang dari rasul-rasul,"},{"n":4,"w":[["عَلَىٰ","atas","ʿalā",8],["صِرَٰطٍۢ","jalan","ṣirāṭin",259],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",318]],"t":"(yang berada) di atas jalan yang lurus,"},{"n":5,"w":[["تَنزِيلَ","diturunkan","tanzīla",639],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",110],["ٱلرَّحِيمِ","Maha Penyayang","l-raḥīmi",101]],"t":"(sebagai wahyu) yang diturunkan oleh (Allah) Yang Mahaperkasa, Maha Penyayang,"},{"n":6,"w":[["لِتُنذِرَ","agar kamu memberi peringatan","litundhira",264],["قَوْمًۭا","kaum","qawman",27],["مَّآ","belum","mā",2],["أُنذِرَ","diberi peringatan","undhira",264],["ءَابَآؤُهُمْ","bapak-bapak mereka","ābāuhum",189],["فَهُمْ","maka mereka","fahum",11],["غَـٰفِلُونَ","mereka lalai","ghāfilūna",400]],"t":"agar engkau memberi peringatan kepada suatu kaum yang nenek moyangnya belum pernah diberi peringatan, karena itu mereka lalai."},{"n":7,"w":[["لَقَدْ","sesungguhnya","laqad",24],["حَقَّ","pasti berlaku","ḥaqqa",508],["ٱلْقَوْلُ","perkataan/keputusan","l-qawlu",117],["عَلَىٰٓ","atas","ʿalā",8],["أَكْثَرِهِمْ","kebanyakan mereka","aktharihim",140],["فَهُمْ","maka mereka","fahum",11],["لَا","tidak","lā",4],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18]],"t":"Sungguh, pasti berlaku perkataan (hukuman) terhadap kebanyakan mereka, karena mereka tidak beriman."},{"n":8,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["جَعَلْنَا","Kami telah menjadikan","jaʿalnā",33],["فِىٓ","pada","fī",3],["أَعْنَـٰقِهِمْ","leher-leher mereka","aʿnāqihim",886],["أَغْلَـٰلًۭا","belenggu","aghlālan",901],["فَهِىَ","lalu ia","fahiya",190],["إِلَى","sampai","ilā",13],["ٱلْأَذْقَانِ","dagu","l-adhqāni",1719],["فَهُم","maka mereka","fahum",11],["مُّقْمَحُونَ","tertengadah","muq'maḥūna",3992]],"t":"Sungguh, Kami telah memasang belenggu di leher mereka, lalu tangan mereka (diangkat) ke dagu, karena itu mereka tertengadah."},{"n":9,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["مِنۢ","dari","min",0],["بَيْنِ","antara","bayni",47],["أَيْدِيهِمْ","hadapan mereka","aydīhim",99],["سَدًّۭا","tutup/dinding","saddan",1635],["وَمِنْ","dan dari","wamin",0],["خَلْفِهِمْ","belakang mereka","khalfihim",479],["سَدًّۭا","tutup/dinding","saddan",1635],["فَأَغْشَيْنَـٰهُمْ","lalu Kami tutup mereka","fa-aghshaynāhum",1489],["فَهُمْ","maka mereka","fahum",11],["لَا","tidak","lā",4],["يُبْصِرُونَ","mereka tidak dapat melihat","yub'ṣirūna",370]],"t":"Dan Kami jadikan di hadapan mereka sekat (dinding) dan di belakang mereka juga sekat, dan Kami tutup (mata) mereka sehingga mereka tidak dapat melihat."},{"n":10,"w":[["وَسَوَآءٌ","dan sama saja","wasawāon",408],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ءَأَنذَرْتَهُمْ","apakah kamu beri peringatan mereka","a-andhartahum",264],["أَمْ","atau","am",82],["لَمْ","tidak","lam",32],["تُنذِرْهُمْ","kamu beri peringatan","tundhir'hum",264],["لَا","tidak","lā",4],["يُؤْمِنُونَ","mereka akan beriman","yu'minūna",18]],"t":"Dan sama saja bagi mereka, apakah engkau memberi peringatan kepada mereka atau engkau tidak memberi peringatan kepada mereka, mereka tidak akan beriman juga."},{"n":11,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["تُنذِرُ","kamu memberi peringatan","tundhiru",264],["مَنِ","orang-orang","mani",12],["ٱتَّبَعَ","mengikuti","ittabaʿa",84],["ٱلذِّكْرَ","peringatan/pengajaran","l-dhik'ra",149],["وَخَشِىَ","dan dia takut","wakhashiya",294],["ٱلرَّحْمَـٰنَ","Maha Pengasih","l-raḥmāna",212],["بِٱلْغَيْبِ ۖ","dengan yang ghaib/tidak kelihatan","bil-ghaybi",242],["فَبَشِّرْهُ","maka berilah dia kabar gembira","fabashir'hu",307],["بِمَغْفِرَةٍۢ","dengan ampunan","bimaghfiratin",390],["وَأَجْرٍۢ","dan pahala","wa-ajrin",107],["كَرِيمٍ","yang mulia","karīmin",363]],"t":"Sesungguhnya engkau hanya memberi peringatan kepada orang-orang yang mau mengikuti peringatan dan yang takut kepada Tuhan Yang Maha Pengasih, walaupun mereka tidak melihat-Nya. Maka berilah mereka kabar gembira dengan ampunan dan pahala yang mulia."},{"n":12,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["نَحْنُ","Kami","naḥnu",126],["نُحْىِ","Kami menghidupkan","nuḥ'yī",230],["ٱلْمَوْتَىٰ","orang mati","l-mawtā",310],["وَنَكْتُبُ","dan Kami tulis","wanaktubu",243],["مَا","apa","mā",2],["قَدَّمُوا۟","yang mereka kerjakan","qaddamū",406],["وَءَاثَـٰرَهُمْ ۚ","dan bekas-bekas mereka","waāthārahum",649],["وَكُلَّ","dan segala","wakulla",31],["شَىْءٍ","sesuatu","shayin",41],["أَحْصَيْنَـٰهُ","Kami hitung/kumpulkan","aḥṣaynāhu",815],["فِىٓ","dalam","fī",3],["إِمَامٍۢ","Kitab","imāmin",707],["مُّبِينٍۢ","yang nyata","mubīnin",100]],"t":"Sungguh, Kamilah yang menghidupkan orang-orang yang mati, dan Kamilah yang mencatat apa yang telah mereka kerjakan dan bekas-bekas yang mereka (tinggalkan). Dan segala sesuatu Kami kumpulkan dalam Kitab yang jelas (Lauḥ Maḥfūẓ)."},{"n":13,"w":[["وَٱضْرِبْ","dan buatlah","wa-iḍ'rib",218],["لَهُم","bagi mereka","lahum",11],["مَّثَلًا","perumpamaan","mathalan",124],["أَصْحَـٰبَ","penghuni/penduduk","aṣḥāba",143],["ٱلْقَرْيَةِ","suatu negeri","l-qaryati",211],["إِذْ","ketika","idh",53],["جَآءَهَا","datang kepada mereka","jāahā",43],["ٱلْمُرْسَلُونَ","utusan-utusan","l-mur'salūna",331]],"t":"Dan buatlah suatu perumpamaan bagi mereka, yaitu penduduk suatu negeri, ketika utusan-utusan datang kepada mereka;"},{"n":14,"w":[["إِذْ","ketika","idh",53],["أَرْسَلْنَآ","Kami mengutus","arsalnā",88],["إِلَيْهِمُ","kepada mereka","ilayhimu",13],["ٱثْنَيْنِ","dua orang","ith'nayni",705],["فَكَذَّبُوهُمَا","lalu mereka mendustakan keduanya","fakadhabūhumā",63],["فَعَزَّزْنَا","maka Kami kuatkan","faʿazzaznā",3133],["بِثَالِثٍۢ","dengan yang ketiga","bithālithin",2700],["فَقَالُوٓا۟","lalu mereka berkata","faqālū",6],["إِنَّآ","seesungguhnya kami","innā",5],["إِلَيْكُم","kepadamu","ilaykum",13],["مُّرْسَلُونَ","orang-orang yang diutus","mur'salūna",331]],"t":"(yaitu) ketika Kami mengutus kepada mereka dua orang utusan, lalu mereka mendustakan keduanya; kemudian Kami kuatkan dengan (utusan) yang ketiga, maka ketiga (utusan itu) berkata, \"Sungguh, kami adalah orang-orang yang diutus kepadamu.\""},{"n":15,"w":[["قَالُوا۟","mereka berkata","qālū",6],["مَآ","tidaklah","mā",2],["أَنتُمْ","kamu","antum",85],["إِلَّا","kecuali","illā",15],["بَشَرٌۭ","manusia","basharun",315],["مِّثْلُنَا","seperti kami","mith'lunā",155],["وَمَآ","dan tidak","wamā",2],["أَنزَلَ","menurunkan","anzala",61],["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","l-raḥmānu",212],["مِن","dari","min",0],["شَىْءٍ","sesuatu","shayin",41],["إِنْ","tidaklah","in",14],["أَنتُمْ","kamu","antum",85],["إِلَّا","kecuali","illā",15],["تَكْذِبُونَ","kamu berdusta","takdhibūna",785]],"t":"Mereka (penduduk negeri) menjawab, \"Kamu ini hanyalah manusia seperti kami, dan (Allah) Yang Maha Pengasih tidak menurunkan sesuatu apa pun; kamu hanyalah pendusta belaka.\""},{"n":16,"w":[["قَالُوا۟","mereka berkata","qālū",6],["رَبُّنَا","Tuhan kami","rabbunā",10],["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["إِنَّآ","sesungguhnya kami","innā",5],["إِلَيْكُمْ","kepada kamu","ilaykum",13],["لَمُرْسَلُونَ","benar-benar orang yang diutus","lamur'salūna",331]],"t":"Mereka berkata, \"Tuhan kami mengetahui sesungguhnya kami adalah utusan-utusan (-Nya) kepada kamu."},{"n":17,"w":[["وَمَا","dan tidak ada","wamā",2],["عَلَيْنَآ","atas kami","ʿalaynā",8],["إِلَّا","kecuali","illā",15],["ٱلْبَلَـٰغُ","penyampaian","l-balāghu",626],["ٱلْمُبِينُ","yang nyata","l-mubīnu",100]],"t":"Dan kewajiban kami hanyalah meyampaikan (perintah Allah) dengan jelas.\""},{"n":18,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya kami","innā",5],["تَطَيَّرْنَا","kami sial/celaka","taṭayyarnā",2100],["بِكُمْ ۖ","dengan/untuk kalian","bikum",26],["لَئِن","sungguh jika","la-in",14],["لَّمْ","tidak","lam",32],["تَنتَهُوا۟","kamu berhenti","tantahū",611],["لَنَرْجُمَنَّكُمْ","niscaya kami lempari batu kamu","lanarjumannakum",1390],["وَلَيَمَسَّنَّكُم","dan sungguh akan menimpa kamu","walayamassannakum",215],["مِّنَّا","dari kami","minnā",0],["عَذَابٌ","siksaan","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",164]],"t":"Mereka menjawab, \"Sesungguhnya kami bernasib malang karena kamu. Sungguh, jika kamu tidak berhenti (menyeru kami), niscaya kami rajam kamu dan kamu pasti akan merasakan siksaan yang pedih dari kami.\""},{"n":19,"w":[["قَالُوا۟","mereka berkata","qālū",6],["طَـٰٓئِرُكُم","kesialan/kecelakaan kamu","ṭāirukum",1315],["مَّعَكُمْ ۚ","bersamamu/karena kamu","maʿakum",69],["أَئِن","apakah jika","a-in",14],["ذُكِّرْتُم ۚ","kamu diberi peringatan","dhukkir'tum",537],["بَلْ","bahkan/tetapi","bal",93],["أَنتُمْ","kamu","antum",85],["قَوْمٌۭ","kaum","qawmun",27],["مُّسْرِفُونَ","orang-orang yang melampaui batas","mus'rifūna",634]],"t":"Mereka (utusan-utusan) itu berkata, \"Kemalangan kamu itu adalah karena kamu sendiri. Apakah kamu diberi peringatan? Sebenarnya kamu adalah kaum yang melampaui batas.\""},{"n":20,"w":[["وَجَآءَ","dan datanglah","wajāa",43],["مِنْ","dari","min",0],["أَقْصَا","ujung","aqṣā",1739],["ٱلْمَدِينَةِ","kota","l-madīnati",668],["رَجُلٌۭ","seorang laki-laki","rajulun",377],["يَسْعَىٰ","terburu-buru","yasʿā",518],["قَالَ","ia berkata","qāla",6],["يَـٰقَوْمِ","wahai kaumku","yāqawmi",27],["ٱتَّبِعُوا۟","ikutilah","ittabiʿū",84],["ٱلْمُرْسَلِينَ","utusan-utusan","l-mur'salīna",331]],"t":"Dan datanglah dari ujung kota, seorang laki-laki dengan bergegas dia berkata, \"Wahai kaumku! Ikutilah utusan-utusan itu."},{"n":21,"w":[["ٱتَّبِعُوا۟","ikutilah","ittabiʿū",84],["مَن","orang","man",12],["لَّا","tidak","lā",4],["يَسْـَٔلُكُمْ","ia minta kepadamu","yasalukum",105],["أَجْرًۭا","upah","ajran",107],["وَهُم","dan mereka","wahum",11],["مُّهْتَدُونَ","orang-orang yang mendapat petunjuk","muh'tadūna",575]],"t":"Ikutilah orang yang tidak meminta imbalan kepadamu; dan mereka adalah orang-orang yang mendapat petunjuk."},{"n":22,"w":[["وَمَا","dan mengapa","wamā",2],["لِىَ","bagiku","liya",144],["لَآ","tidak","lā",4],["أَعْبُدُ","aku menyembah","aʿbudu",97],["ٱلَّذِى","(Tuhan) yang","alladhī",7],["فَطَرَنِى","telah menciptakan aku","faṭaranī",833],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",142]],"t":"Dan tidak ada alasan bagiku untuk tidak menyembah (Allah) yang telah menciptakanku dan hanya kepada-Nyalah kamu akan dikembalikan."},{"n":23,"w":[["ءَأَتَّخِذُ","apakah aku akan mengambil/menyembah","a-attakhidhu",95],["مِن","dari","min",0],["دُونِهِۦٓ","selain Dia","dūnihi",78],["ءَالِهَةً","tuhan-tuhan","ālihatan",74],["إِن","jika","in",14],["يُرِدْنِ","menghendaki terhadapku","yurid'ni",81],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",212],["بِضُرٍّۢ","dengan kemudaratan","biḍurrin",524],["لَّا","tidak","lā",4],["تُغْنِ","memberi manfaat","tugh'ni",383],["عَنِّى","dariku/bagiku","ʿannī",21],["شَفَـٰعَتُهُمْ","syafaat/pertolongan mereka","shafāʿatuhum",676],["شَيْـًۭٔا","sedikitpun/sesuatu","shayan",41],["وَلَا","dan tidak","walā",4],["يُنقِذُونِ","mereka melepaskan/menyelamatkan aku","yunqidhūni",1477]],"t":"Mengapa aku akan menyembah tuhan-tuhan selain-Nya? Jika (Allah) Yang Maha Pengasih menghendaki bencana terhadapku, pasti pertolongan mereka tidak berguna sama sekali bagi diriku dan mereka (juga) tidak dapat menyelamatkanku."},{"n":24,"w":[["إِنِّىٓ","sesungguhnya aku","innī",5],["إِذًۭا","jika demikian","idhan",356],["لَّفِى","sungguh/pasti dalam","lafī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",306],["مُّبِينٍ","yang nyata","mubīnin",100]],"t":"Sesungguhnya jika aku (berbuat) begitu, pasti aku berada dalam kesesatan yang nyata."},{"n":25,"w":[["إِنِّىٓ","sesungguhnya aku","innī",5],["ءَامَنتُ","aku telah beriman","āmantu",18],["بِرَبِّكُمْ","dengan/kepada Tuhanmu","birabbikum",10],["فَٱسْمَعُونِ","maka dengarkanlah aku","fa-is'maʿūni",145]],"t":"Sesungguhnya aku telah beriman kepada Tuhanmu; maka dengarkanlah (pengakuan keimanan)ku.\""},{"n":26,"w":[["قِيلَ","dikatakan","qīla",6],["ٱدْخُلِ","masuklah","ud'khuli",151],["ٱلْجَنَّةَ ۖ","sorga","l-janata",76],["قَالَ","ia berkata","qāla",6],["يَـٰلَيْتَ","seandainya","yālayta",667],["قَوْمِى","kaumku","qawmī",27],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Dikatakan (kepadanya), \"Masuklah ke surga.\" Dia (laki-laki itu) berkata, \"Alangkah baiknya sekiranya kaumku mengetahui,"},{"n":27,"w":[["بِمَا","dengan apa/sebab","bimā",2],["غَفَرَ","memberi ampun","ghafara",183],["لِى","padaku","lī",144],["رَبِّى","Tuhanku","rabbī",10],["وَجَعَلَنِى","dan Dia menjadikan aku","wajaʿalanī",33],["مِنَ","dari/termasuk","mina",0],["ٱلْمُكْرَمِينَ","orang-orang yang dimuliakan","l-muk'ramīna",1373]],"t":"apa yang menyebabkan Tuhanku memberi ampun kepadaku dan menjadikan aku termasuk orang-orang yang telah dimuliakan.\""},{"n":28,"w":[["۞ وَمَآ","dan tidak","wamā",2],["أَنزَلْنَا","Kami tidak menurunkan","anzalnā",61],["عَلَىٰ","atas","ʿalā",8],["قَوْمِهِۦ","kaumnya","qawmihi",27],["مِنۢ","dari","min",0],["بَعْدِهِۦ","sesudahnya/dia","baʿdihi",58],["مِن","dari","min",0],["جُندٍۢ","tentara","jundin",374],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["وَمَا","dan tidak","wamā",2],["كُنَّا","layak Kami","kunnā",9],["مُنزِلِينَ","yang menurunkan","munzilīna",1367]],"t":"Dan setelah dia (meninggal), Kami tidak menurunkan suatu pasukan pun dari langit kepada kaumnya, dan Kami tidak perlu menurunkannya."},{"n":29,"w":[["إِن","tidak","in",14],["كَانَتْ","ada","kānat",9],["إِلَّا","kecuali","illā",15],["صَيْحَةًۭ","suara keras","ṣayḥatan",683],["وَٰحِدَةًۭ","satu kali","wāḥidatan",359],["فَإِذَا","maka tiba-tiba","fa-idhā",645],["هُمْ","mereka","hum",11],["خَـٰمِدُونَ","mereka padam/mati","khāmidūna",2731]],"t":"Tidak ada siksaan terhadap mereka melainkan dengan satu teriakan saja; maka seketika itu mereka mati."},{"n":30,"w":[["يَـٰحَسْرَةً","alangkah besarnya penyesalan","yāḥasratan",1057],["عَلَى","atas","ʿalā",8],["ٱلْعِبَادِ ۚ","hamba-hamba","l-ʿibādi",87],["مَا","tidak","mā",2],["يَأْتِيهِم","datang kepada mereka","yatīhim",48],["مِّن","dari","min",0],["رَّسُولٍ","seorang Rasul","rasūlin",35],["إِلَّا","kecuali","illā",15],["كَانُوا۟","adalah mereka","kānū",9],["بِهِۦ","dengannya/padanya","bihi",16],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",499]],"t":"Alangkah besar penyesalan terhadap hamba-hamba itu, setiap datang seorang rasul kepada mereka, mereka selalu memperolok-olokkannya."},{"n":31,"w":[["أَلَمْ","apakah tidak","alam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["كَمْ","berapa banyak","kam",489],["أَهْلَكْنَا","Kami telah binasakan","ahlaknā",231],["قَبْلَهُم","sebelum mereka","qablahum",51],["مِّنَ","dari","mina",0],["ٱلْقُرُونِ","kurun/ummat-ummat","l-qurūni",458],["أَنَّهُمْ","bahwasannya mereka","annahum",30],["إِلَيْهِمْ","kepada mereka","ilayhim",13],["لَا","tidak","lā",4],["يَرْجِعُونَ","mereka akan menyembah","yarjiʿūna",142]],"t":"Tidakkah mereka mengetahui berapa banyak umat-umat sebelum mereka yang telah Kami binasakan. Orang-orang (yang telah Kami binasakan) itu tidak ada yang kembali kepada mereka."},{"n":32,"w":[["وَإِن","dan tidak lain","wa-in",14],["كُلٌّۭ","setiap mereka","kullun",31],["لَّمَّا","melainkan","lammā",71],["جَمِيعٌۭ","kesemuanya","jamīʿun",224],["لَّدَيْنَا","disisi Kami","ladaynā",516],["مُحْضَرُونَ","mereka dihadirkan/dihadapkan","muḥ'ḍarūna",849]],"t":"Dan setiap (umat), semuanya akan dihadapkan kepada Kami."},{"n":33,"w":[["وَءَايَةٌۭ","dan suatu tanda","waāyatun",28],["لَّهُمُ","bagi mereka","lahumu",11],["ٱلْأَرْضُ","bumi","l-arḍu",22],["ٱلْمَيْتَةُ","yang mati","l-maytatu",1201],["أَحْيَيْنَـٰهَا","dan Kami keluarkan","aḥyaynāhā",230],["وَأَخْرَجْنَا","daripadanya","wa-akhrajnā",111],["مِنْهَا","daripadanya","min'hā",0],["حَبًّۭا","biji-bijian","ḥabban",1054],["فَمِنْهُ","maka daripadanya","famin'hu",0],["يَأْكُلُونَ","mereka makan","yakulūna",114]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah bumi yang mati (tandus). Kami hidupkan bumi itu dan Kami keluarkan darinya biji-bijian, maka dari (biji-bijian) itu mereka makan."},{"n":34,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["فِيهَا","di dalamnya/padanya","fīhā",3],["جَنَّـٰتٍۢ","kebun-kebun","jannātin",76],["مِّن","dari","min",0],["نَّخِيلٍۢ","korma","nakhīlin",1095],["وَأَعْنَـٰبٍۢ","dan anggur","wa-aʿnābin",773],["وَفَجَّرْنَا","dan Kami pancarkan","wafajjarnā",1181],["فِيهَا","di dalamnya","fīhā",3],["مِنَ","dari","mina",0],["ٱلْعُيُونِ","mata air","l-ʿuyūni",207]],"t":"Dan Kami jadikan padanya di bumi itu kebun-kebun kurma dan anggur dan Kami pancarkan padanya beberapa mata air,"},{"n":35,"w":[["لِيَأْكُلُوا۟","supaya mereka makan","liyakulū",114],["مِن","dari","min",0],["ثَمَرِهِۦ","buahnya","thamarihi",1409],["وَمَا","dan apa","wamā",2],["عَمِلَتْهُ","yang diusahakannya","ʿamilathu",44],["أَيْدِيهِمْ ۖ","tangan-tangan mereka","aydīhim",99],["أَفَلَا","maka mengapa tidak","afalā",4],["يَشْكُرُونَ","mereka bersyukur","yashkurūna",253]],"t":"agar mereka dapat makan dari buahnya, dan dari hasil usaha tangan mereka. Maka mengapa mereka tidak bersyukur?"},{"n":36,"w":[["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",285],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","telah menciptakan","khalaqa",60],["ٱلْأَزْوَٰجَ","pasangan-pasangan","l-azwāja",152],["كُلَّهَا","semuanya","kullahā",31],["مِمَّا","dari apa","mimmā",0],["تُنۢبِتُ","ditumbuhkan","tunbitu",587],["ٱلْأَرْضُ","bumi","l-arḍu",22],["وَمِنْ","dan dari","wamin",0],["أَنفُسِهِمْ","diri mereka sendiri","anfusihim",39],["وَمِمَّا","dan dari apa","wamimmā",0],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka ketahui","yaʿlamūna",29]],"t":"Mahasuci (Allah) yang telah menciptakan semuanya berpasang-pasangan, baik dari apa yang ditumbuhkan oleh bumi dan dari diri mereka sendiri, maupun dari apa yang tidak mereka ketahui."},{"n":37,"w":[["وَءَايَةٌۭ","dan suatu tanda","waāyatun",28],["لَّهُمُ","bagi mereka","lahumu",11],["ٱلَّيْلُ","malam","al-laylu",132],["نَسْلَخُ","Kami tanggalkan","naslakhu",4060],["مِنْهُ","daripadanya/malam itu","min'hu",0],["ٱلنَّهَارَ","siang","l-nahāra",210],["فَإِذَا","maka tiba-tiba","fa-idhā",23],["هُم","mereka","hum",11],["مُّظْلِمُونَ","mereka kegelapan","muẓ'limūna",2489]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah malam; Kami tanggalkan siang dari (malam) itu, maka seketika itu mereka (berada dalam) kegelapan,"},{"n":38,"w":[["وَٱلشَّمْسُ","dan matahari","wal-shamsu",342],["تَجْرِى","berjalan","tajrī",208],["لِمُسْتَقَرٍّۢ","di tempat ketetapan/peredaran","limus'taqarrin",847],["لَّهَا ۚ","baginya","lahā",94],["ذَٰلِكَ","demikian","dhālika",19],["تَقْدِيرُ","ketetapan","taqdīru",1405],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",110],["ٱلْعَلِيمِ","Maha Mengetahui","l-ʿalīmi",68]],"t":"dan matahari berjalan di tempat peredarannya. Demikianlah ketetapan (Allah) Yang Mahaperkasa, Maha Mengetahui."},{"n":39,"w":[["وَٱلْقَمَرَ","dan bulan","wal-qamara",407],["قَدَّرْنَـٰهُ","telah Kami tetapkannya","qaddarnāhu",601],["مَنَازِلَ","tempat-tempat(nya)","manāzila",2457],["حَتَّىٰ","sehingga","ḥattā",80],["عَادَ","ia kembali","ʿāda",545],["كَٱلْعُرْجُونِ","seperti tandan","kal-ʿur'jūni",3153],["ٱلْقَدِيمِ","yang tua","l-qadīmi",1956]],"t":"Dan telah Kami tetapkan tempat peredaran bagi bulan, sehingga (setelah ia sampai ke tempat peredaran yang terakhir) kembalilah ia seperti bentuk tandan yang tua."},{"n":40,"w":[["لَا","tidak","lā",4],["ٱلشَّمْسُ","matahari","l-shamsu",342],["يَنۢبَغِى","patut/mungkin","yanbaghī",1253],["لَهَآ","baginya","lahā",94],["أَن","bahwa","an",17],["تُدْرِكَ","mendapatkan/mengejar","tud'rika",1136],["ٱلْقَمَرَ","bulan","l-qamara",407],["وَلَا","and not","walā",4],["ٱلَّيْلُ","malam","al-laylu",132],["سَابِقُ","mendahului","sābiqu",1102],["ٱلنَّهَارِ ۚ","siang","l-nahāri",210],["وَكُلٌّۭ","dan masing-masing","wakullun",31],["فِى","dalam","fī",3],["فَلَكٍۢ","garis edar","falakin",2363],["يَسْبَحُونَ","mereka beredar","yasbaḥūna",2779]],"t":"Tidaklah mungkin bagi matahari mengejar bulan dan malam pun tidak dapat mendahului siang. Masing-masing beredar pada garis edarnya."},{"n":41,"w":[["وَءَايَةٌۭ","dan dan suatu tanda","waāyatun",28],["لَّهُمْ","bagi mereka","lahum",11],["أَنَّا","bahwasannya Kami","annā",30],["حَمَلْنَا","Kami bawa/angkut","ḥamalnā",282],["ذُرِّيَّتَهُمْ","keturunan mereka","dhurriyyatahum",379],["فِى","dalam","fī",3],["ٱلْفُلْكِ","perahu/bahtera","l-ful'ki",455],["ٱلْمَشْحُونِ","penuh muatan","l-mashḥūni",1874]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah bahwa Kami angkut keturunan mereka dalam kapal yang penuh muatan,"},{"n":42,"w":[["وَخَلَقْنَا","dan Kami ciptakan","wakhalaqnā",60],["لَهُم","untuk mereka","lahum",11],["مِّن","dari","min",0],["مِّثْلِهِۦ","seperti/serupa itu","mith'lihi",155],["مَا","apa","mā",2],["يَرْكَبُونَ","mereka kendarai","yarkabūna",918]],"t":"dan Kami ciptakan (juga) untuk mereka (angkutan lain) seperti apa yang mereka kendarai."},{"n":43,"w":[["وَإِن","dan jika","wa-in",14],["نَّشَأْ","Kami menghendaki","nasha",54],["نُغْرِقْهُمْ","Kami tenggelamkan mereka","nugh'riq'hum",565],["فَلَا","maka tidak","falā",4],["صَرِيخَ","pertolongan","ṣarīkha",3262],["لَهُمْ","bagi mereka","lahum",11],["وَلَا","dan tidak","walā",4],["هُمْ","mereka","hum",11],["يُنقَذُونَ","mereka dilepaskan/diselamatkan","yunqadhūna",1477]],"t":"Dan jika Kami menghendaki, Kami tenggelamkan mereka. Maka tidak ada penolong bagi mereka dan tidak (pula) mereka diselamatkan,"},{"n":44,"w":[["إِلَّا","kecuali","illā",15],["رَحْمَةًۭ","rahmat","raḥmatan",103],["مِّنَّا","dari Kami","minnā",0],["وَمَتَـٰعًا","dan kesenangan hidup","wamatāʿan",330],["إِلَىٰ","sampai","ilā",13],["حِينٍۢ","suatu waktu","ḥīnin",328]],"t":"melainkan (Kami selamatkan mereka) karena rahmat yang besar dari Kami dan untuk memberikan kesenangan hidup sampai waktu tertentu."},{"n":45,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["لَهُمُ","kepada mereka","lahumu",11],["ٱتَّقُوا۟","takutlah kamu","ittaqū",67],["مَا","apa","mā",2],["بَيْنَ","yang diantara","bayna",47],["أَيْدِيكُمْ","tanganmu/hadapanmu","aydīkum",99],["وَمَا","dan apa","wamā",2],["خَلْفَكُمْ","di belakangmu","khalfakum",479],["لَعَلَّكُمْ","agar kalian","laʿallakum",96],["تُرْحَمُونَ","kamu diberi rahmat","tur'ḥamūna",392]],"t":"Dan apabila dikatakan kepada mereka, \"Takutlah kamu akan siksa yang dihadapanmu (di dunia) dan azab yang akan datang (akhirat) agar kamu mendapat rahmat.\""},{"n":46,"w":[["وَمَا","dan tidak","wamā",2],["تَأْتِيهِم","datang kepada mereka","tatīhim",48],["مِّنْ","dari","min",0],["ءَايَةٍۢ","suatu tanda","āyatin",28],["مِّنْ","dari","min",0],["ءَايَـٰتِ","tanda-tanda","āyāti",28],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["إِلَّا","kecuali","illā",15],["كَانُوا۟","adalah mereka","kānū",9],["عَنْهَا","daripadanya","ʿanhā",21],["مُعْرِضِينَ","orang-orang yang berpaling","muʿ'riḍīna",530]],"t":"Dan setiap kali suatu tanda dari tanda-tanda (kebesaran) Tuhan datang kepada mereka, mereka selalu berpaling darinya."},{"n":47,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["لَهُمْ","kepada mereka","lahum",11],["أَنفِقُوا۟","nafkahkan/belanjakan","anfiqū",179],["مِمَّا","dari sebagian","mimmā",0],["رَزَقَكُمُ","memberi rezeki","razaqakumu",198],["ٱللَّهُ","Allah","l-lahu",1],["قَالَ","berkata","qāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لِلَّذِينَ","kepada orang yang","lilladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["أَنُطْعِمُ","apakah kami memberi makan","anuṭ'ʿimu",677],["مَن","orang","man",12],["لَّوْ","jika","law",57],["يَشَآءُ","menghendaki","yashāu",54],["ٱللَّهُ","Allah","l-lahu",1],["أَطْعَمَهُۥٓ","Dia memberinya makan","aṭʿamahu",677],["إِنْ","tidaklah","in",14],["أَنتُمْ","kamu","antum",85],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",306],["مُّبِينٍۢ","nyata","mubīnin",100]],"t":"Dan apabila dikatakan kepada mereka, \"Infakkanlah sebagian rezeki yang diberikan Allah kepadamu,\" orang-orang yang kafir itu berkata kepada orang-orang yang beriman, \"Apakah pantas kami memberi makan kepada orang-orang yang jika Allah menghendaki Dia akan memberinya makan? Kamu benar-benar dalam kesesatan yang nyata.\""},{"n":48,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["مَتَىٰ","bilakah","matā",909],["هَـٰذَا","ini","hādhā",37],["ٱلْوَعْدُ","janji","l-waʿdu",245],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Dan mereka (orang-orang kafir) berkata, \"Kapan janji (hari berbangkit) itu (terjadi) jika kamu orang-orang yang benar?\""},{"n":49,"w":[["مَا","tidak","mā",2],["يَنظُرُونَ","mereka menunggu","yanẓurūna",125],["إِلَّا","kecuali","illā",15],["صَيْحَةًۭ","teriakan/suara keras","ṣayḥatan",683],["وَٰحِدَةًۭ","satu kali","wāḥidatan",359],["تَأْخُذُهُمْ","menimpa mereka","takhudhuhum",92],["وَهُمْ","dan/ketika mereka","wahum",11],["يَخِصِّمُونَ","mereka bertengkar","yakhiṣṣimūna",1024]],"t":"Mereka hanya menunggu satu teriakan, yang akan membinasakan mereka ketika mereka sedang bertengkar."},{"n":50,"w":[["فَلَا","maka tidak","falā",4],["يَسْتَطِيعُونَ","mereka kuasa (membuat)","yastaṭīʿūna",279],["تَوْصِيَةًۭ","satu wasiat","tawṣiyatan",4444],["وَلَآ","dan tidak","walā",4],["إِلَىٰٓ","kecuali","ilā",13],["أَهْلِهِمْ","keluarga mereka","ahlihim",91],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",142]],"t":"Sehingga mereka tidak mampu membuat suatu wasiat dan mereka (juga) tidak dapat kembali kepada keluarganya."},{"n":51,"w":[["وَنُفِخَ","dan ditiuplah","wanufikha",531],["فِى","dalam","fī",3],["ٱلصُّورِ","sangkakala","l-ṣūri",827],["فَإِذَا","maka tiba-tiba","fa-idhā",23],["هُم","mereka","hum",11],["مِّنَ","dari","mina",0],["ٱلْأَجْدَاثِ","kubur","l-ajdāthi",1734],["إِلَىٰ","kepada","ilā",13],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["يَنسِلُونَ","mereka datang/menuju","yansilūna",2777]],"t":"Lalu ditiuplah sangkakala, maka seketika itu mereka keluar dari kuburnya (dalam keadaan hidup), menuju kepada Tuhannya."},{"n":52,"w":[["قَالُوا۟","mereka berkata","qālū",6],["يَـٰوَيْلَنَا","betapa celakanya kami","yāwaylanā",293],["مَنۢ","siapakah","man",12],["بَعَثَنَا","membangkitkan kami","baʿathanā",227],["مِن","dari","min",0],["مَّرْقَدِنَا ۜ ۗ","tempat tidur kami","marqadinā",3942],["هَـٰذَا","ini","hādhā",37],["مَا","apa","mā",2],["وَعَدَ","dijanjikan","waʿada",176],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",212],["وَصَدَقَ","dan benar","waṣadaqa",623],["ٱلْمُرْسَلُونَ","para Rasul","l-mur'salūna",331]],"t":"Mereka berkata, \"Celakalah kami! Siapakah yang membangkitkan kami dari tempat tidur kami (kubur)?\" Inilah yang dijanjikan (Allah) Yang Maha Pengasih dan benarlah rasul-rasul(-Nya)."},{"n":53,"w":[["إِن","tidak","in",14],["كَانَتْ","ada","kānat",9],["إِلَّا","kecuali","illā",15],["صَيْحَةًۭ","teriakan/suara keras","ṣayḥatan",683],["وَٰحِدَةًۭ","satu kali","wāḥidatan",359],["فَإِذَا","maka tiba-tiba","fa-idhā",23],["هُمْ","mereka","hum",11],["جَمِيعٌۭ","semuanya","jamīʿun",224],["لَّدَيْنَا","di sisi/di hadapan Kami","ladaynā",516],["مُحْضَرُونَ","orang-orang yang dihadapkan/dikumpulkan","muḥ'ḍarūna",849]],"t":"Teriakan itu hanya sekali saja, maka seketika itu mereka semua dihadapkan kepada Kami (untuk dihisab)."},{"n":54,"w":[["فَٱلْيَوْمَ","maka pada hari itu","fal-yawma",25],["لَا","tidak","lā",4],["تُظْلَمُ","dianiaya/dirugikan","tuẓ'lamu",104],["نَفْسٌۭ","seseorang","nafsun",39],["شَيْـًۭٔا","sesuatu/sedikitpun","shayan",41],["وَلَا","dan tidak","walā",4],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",161],["إِلَّا","kecuali","illā",15],["مَا","apa","mā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Maka pada hari itu seseorang tidak akan dirugikan sedikit pun dan kamu tidak akan diberi balasan, kecuali sesuai dengan apa yang telah kamu kerjakan."},{"n":55,"w":[["إِنَّ","sesungguhnya","inna",5],["أَصْحَـٰبَ","penghuni","aṣḥāba",143],["ٱلْجَنَّةِ","sorga","l-janati",76],["ٱلْيَوْمَ","pada hari itu","l-yawma",25],["فِى","dalam","fī",3],["شُغُلٍۢ","kesibukan","shughulin",2890],["فَـٰكِهُونَ","bersenang-senang","fākihūna",1827]],"t":"Sesungguhnya penghuni surga pada hari itu bersenang-senang dalam kesibukan (mereka)."},{"n":56,"w":[["هُمْ","mereka","hum",11],["وَأَزْوَٰجُهُمْ","dan isteri-isteri mereka","wa-azwājuhum",152],["فِى","dalam","fī",3],["ظِلَـٰلٍ","tempat yang teduh","ẓilālin",659],["عَلَى","di atas","ʿalā",8],["ٱلْأَرَآئِكِ","tempat duduk/pelamin","l-arāiki",1276],["مُتَّكِـُٔونَ","mereka bersandar","muttakiūna",991]],"t":"Mereka dan pasangan-pasangannya berada dalam tempat yang teduh, bersandar di atas dipan-dipan."},{"n":57,"w":[["لَهُمْ","bagi mereka/memperoleh","lahum",11],["فِيهَا","di dalamnya (sorga)","fīhā",3],["فَـٰكِهَةٌۭ","buah-buahan","fākihatun",780],["وَلَهُم","dan bagi mereka/memperoleh","walahum",11],["مَّا","apa","mā",2],["يَدَّعُونَ","yang mereka minta","yaddaʿūna",2053]],"t":"Di surga itu mereka memperoleh buah-buahan dan memperoleh apa saja yang mereka inginkan."},{"n":58,"w":[["سَلَـٰمٌۭ","penghormatan/sejahtera","salāmun",277],["قَوْلًۭا","perkataan/kata","qawlan",117],["مِّن","dari","min",0],["رَّبٍّۢ","Tuhan","rabbin",10],["رَّحِيمٍۢ","Maha Penyayang","raḥīmin",101]],"t":"(Kepada mereka dikatakan), \"Salām,\" sebagai ucapan selamat dari Tuhan Yang Maha Penyayang."},{"n":59,"w":[["وَٱمْتَـٰزُوا۟","dan berpisahlah kamu","wa-im'tāzū",4821],["ٱلْيَوْمَ","hari ini","l-yawma",25],["أَيُّهَا","hai","ayyuhā",73],["ٱلْمُجْرِمُونَ","orang-orang yang berdosa","l-muj'rimūna",228]],"t":"Dan (dikatakan kepada orang-orang kafir), \"Berpisahlah kamu (dari orang-orang mukmin) pada hari ini, wahai orang-orang yang berdosa!"},{"n":60,"w":[["۞ أَلَمْ","tidaklah","alam",32],["أَعْهَدْ","Aku peringatkan/memerintahkan","aʿhad",1153],["إِلَيْكُمْ","kepadamu","ilaykum",13],["يَـٰبَنِىٓ","Wahai keturunan","yābanī",141],["ءَادَمَ","Adam","ādama",421],["أَن","bahwa","an",17],["لَّا","tidak","lā",4],["تَعْبُدُوا۟","kamu menyembah","taʿbudū",97],["ٱلشَّيْطَـٰنَ ۖ","syaitan","l-shayṭāna",120],["إِنَّهُۥ","sesungguhnya ia","innahu",5],["لَكُمْ","bagi kalian","lakum",26],["عَدُوٌّۭ","musuh","ʿaduwwun",235],["مُّبِينٌۭ","nyata","mubīnun",100]],"t":"Bukankah Aku telah memerintahkan kepadamu wahai anak cucu Adam agar kamu tidak menyembah setan? Sungguh, setan itu musuh yang nyata bagi kamu,"},{"n":61,"w":[["وَأَنِ","dan hendaklah","wa-ani",17],["ٱعْبُدُونِى ۚ","kamu menyembah-Ku","uʿ'budūnī",97],["هَـٰذَا","ini","hādhā",37],["صِرَٰطٌۭ","jalan","ṣirāṭun",259],["مُّسْتَقِيمٌۭ","lurus","mus'taqīmun",318]],"t":"dan hendaklah kamu menyembah-Ku. Inilah jalan yang lurus.\""},{"n":62,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَضَلَّ","ia telah menyesatkan","aḍalla",185],["مِنكُمْ","diantara kamu","minkum",0],["جِبِلًّۭا","sejumlah/sebagian","jibillan",2404],["كَثِيرًا ۖ","banyak/besar","kathīran",191],["أَفَلَمْ","maka apakah tidak","afalam",32],["تَكُونُوا۟","kalian menjadi","takūnū",9],["تَعْقِلُونَ","kalian menggunakan akal","taʿqilūna",241]],"t":"Dan sungguh, ia (setan itu) telah menyesatkan sebagian besar di antara kamu. Maka apakah kamu tidak mengerti?"},{"n":63,"w":[["هَـٰذِهِۦ","ini","hādhihi",37],["جَهَنَّمُ","Jahannam","jahannamu",148],["ٱلَّتِى","adalah","allatī",7],["كُنتُمْ","kalian adalah","kuntum",9],["تُوعَدُونَ","kamu diancam","tūʿadūna",176]],"t":"Inilah (neraka) Jahanam yang dahulu telah diperingatkan kepadamu."},{"n":64,"w":[["ٱصْلَوْهَا","masuklah ke dalamnya","iṣ'lawhā",703],["ٱلْيَوْمَ","hari ini","l-yawma",25],["بِمَا","karena","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَكْفُرُونَ","kalian kafir","takfurūna",40]],"t":"Masuklah ke dalamnya pada hari ini karena dahulu kamu mengingkarinya."},{"n":65,"w":[["ٱلْيَوْمَ","pada hari ini","al-yawma",25],["نَخْتِمُ","Kami kunci/tutup","nakhtimu",1421],["عَلَىٰٓ","atas","ʿalā",8],["أَفْوَٰهِهِمْ","mulut-mulut mereka","afwāhihim",713],["وَتُكَلِّمُنَآ","dan berkata kepada Kami","watukallimunā",515],["أَيْدِيهِمْ","tangan-tangan mereka","aydīhim",99],["وَتَشْهَدُ","dan memberi kesaksian","watashhadu",263],["أَرْجُلُهُم","kaki-kaki mereka","arjuluhum",637],["بِمَا","dengan/terhadap apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَكْسِبُونَ","mereka usahakan","yaksibūna",196]],"t":"Pada hari ini Kami tutup mulut mereka; tangan mereka akan berkata kepada Kami dan kaki mereka akan memberi kesaksian terhadap apa yang dahulu mereka kerjakan."},{"n":66,"w":[["وَلَوْ","dan jika","walaw",57],["نَشَآءُ","Kami menghendaki","nashāu",54],["لَطَمَسْنَا","tentu Kami hapuskan/gelapkan","laṭamasnā",1318],["عَلَىٰٓ","atas","ʿalā",8],["أَعْيُنِهِمْ","penglihatan mata mereka","aʿyunihim",207],["فَٱسْتَبَقُوا۟","lalu mereka berlomba-lomba","fa-is'tabaqū",1448],["ٱلصِّرَٰطَ","jalan","l-ṣirāṭa",259],["فَأَنَّىٰ","maka bagaimana","fa-annā",384],["يُبْصِرُونَ","mereka melihat","yub'ṣirūna",370]],"t":"Dan jika Kami menghendaki, pastilah Kami hapuskan penglihatan mata mereka; sehingga mereka berlomba-lomba (mencari) jalan. Maka bagaimana mungkin mereka dapat melihat?"},{"n":67,"w":[["وَلَوْ","dan jika","walaw",57],["نَشَآءُ","Kami menghendaki","nashāu",54],["لَمَسَخْنَـٰهُمْ","tentu Kami rubah rupa mereka","lamasakhnāhum",3725],["عَلَىٰ","atas","ʿalā",8],["مَكَانَتِهِمْ","tempat mereka berada","makānatihim",1355],["فَمَا","maka tidak","famā",2],["ٱسْتَطَـٰعُوا۟","mereka sanggup","is'taṭāʿū",279],["مُضِيًّۭا","maju/berjalan","muḍiyyan",3766],["وَلَا","dan tidak","walā",4],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",142]],"t":"Dan jika Kami menghendaki, pastilah Kami ubah bentuk mereka di tempat mereka berada; sehingga mereka tidak sanggup berjalan lagi dan juga tidak sanggup kembali."},{"n":68,"w":[["وَمَن","dan barangsiapa","waman",12],["نُّعَمِّرْهُ","Kami panjangkan umurnya","nuʿammir'hu",1437],["نُنَكِّسْهُ","Kami kembalikan dia","nunakkis'hu",4079],["فِى","dalam/kepada","fī",3],["ٱلْخَلْقِ ۖ","kejadian","l-khalqi",229],["أَفَلَا","apakah maka tidak","afalā",4],["يَعْقِلُونَ","mereka menggunakan akal/berpikir","yaʿqilūna",241]],"t":"Dan barang siapa Kami panjangkan umurnya niscaya Kami kembalikan dia kepada awal kejadian(nya). Maka mengapa mereka tidak mengerti?"},{"n":69,"w":[["وَمَا","dan tidak","wamā",2],["عَلَّمْنَـٰهُ","Kami mengajarkannya","ʿallamnāhu",281],["ٱلشِّعْرَ","syair","l-shiʿ'ra",2123],["وَمَا","dan tidak","wamā",2],["يَنۢبَغِى","layak","yanbaghī",1253],["لَهُۥٓ ۚ","baginya","lahu",16],["إِنْ","tidak","in",14],["هُوَ","ia","huwa",20],["إِلَّا","kecuali","illā",15],["ذِكْرٌۭ","peringatan/pelajaran","dhik'run",149],["وَقُرْءَانٌۭ","dan bacaan","waqur'ānun",175],["مُّبِينٌۭ","nyata","mubīnun",100]],"t":"Dan Kami tidak mengajarkan syair kepadanya (Muhammad) dan bersyair itu tidaklah pantas baginya. Alquran itu tidak lain hanyalah pelajaran dan Kitab yang jelas."},{"n":70,"w":[["لِّيُنذِرَ","supaya dia memberi peringatan","liyundhira",264],["مَن","orang-orang","man",12],["كَانَ","adalah","kāna",9],["حَيًّۭا","hidup","ḥayyan",437],["وَيَحِقَّ","dan pasti berlaku","wayaḥiqqa",508],["ٱلْقَوْلُ","perkataan/azab","l-qawlu",117],["عَلَى","atas","ʿalā",8],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",90]],"t":"agar dia (Muhammad) memberi peringatan kepada orang-orang yang hidup (hatinya) dan agar pasti ketetapan (azab) terhadap orang-orang kafir."},{"n":71,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka melihat/memperlihatkan","yaraw",46],["أَنَّا","bahwasannya Kami","annā",30],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",60],["لَهُم","untuk mereka","lahum",11],["مِّمَّا","dari sebagian apa","mimmā",0],["عَمِلَتْ","mengerjakan/menciptakan","ʿamilat",44],["أَيْدِينَآ","tangan/kekuasaan Kami","aydīnā",99],["أَنْعَـٰمًۭا","binatang ternak","anʿāman",347],["فَهُمْ","lalu mereka","fahum",11],["لَهَا","padanya","lahā",94],["مَـٰلِكُونَ","mereka memiliki/menguasai","mālikūna",1885]],"t":"Dan tidakkah mereka melihat bahwa Kami telah meciptakan hewan ternak untuk mereka, yaitu sebagian dari apa yang telah Kami ciptakan dengan kekuasaan Kami, lalu mereka menguasainya ?"},{"n":72,"w":[["وَذَلَّلْنَـٰهَا","dan Kami tundukkannya","wadhallalnāhā",2133],["لَهُمْ","untuk mereka","lahum",11],["فَمِنْهَا","maka sebagiannya","famin'hā",0],["رَكُوبُهُمْ","tunggangan mereka","rakūbuhum",4186],["وَمِنْهَا","dan sebagiannya","wamin'hā",0],["يَأْكُلُونَ","mereka makan","yakulūna",114]],"t":"Dan Kami menundukkannya (hewan-hewan itu) untuk mereka; lalu sebagiannya untuk menjadi tunggangan mereka dan sebagian untuk mereka makan."},{"n":73,"w":[["وَلَهُمْ","dan bagi mereka (memperoleh)","walahum",11],["فِيهَا","padanya","fīhā",3],["مَنَـٰفِعُ","kemanfaatan","manāfiʿu",983],["وَمَشَارِبُ ۖ","dan minuman","wamashāribu",1920],["أَفَلَا","apakah maka tidak","afalā",4],["يَشْكُرُونَ","mereka bersyukur","yashkurūna",253]],"t":"Dan mereka memperoleh berbagai manfaat dan minuman darinya. Maka mengapa mereka tidak bersyukur?"},{"n":74,"w":[["وَٱتَّخَذُوا۟","dan mereka mengambil/menyembah","wa-ittakhadhū",95],["مِن","dari","min",0],["دُونِ","selain","dūni",78],["ٱللَّهِ","Allah","l-lahi",1],["ءَالِهَةًۭ","tuhan-tuhan","ālihatan",74],["لَّعَلَّهُمْ","agar mereka","laʿallahum",96],["يُنصَرُونَ","mereka ditolong","yunṣarūna",202]],"t":"Dan mereka mengangkat sesembahan selain Allah agar mereka mendapat pertolongan."},{"n":75,"w":[["لَا","tidak","lā",4],["يَسْتَطِيعُونَ","mereka tidak kuasa","yastaṭīʿūna",279],["نَصْرَهُمْ","menolong mereka","naṣrahum",472],["وَهُمْ","sedang mereka","wahum",11],["لَهُمْ","untuk mereka","lahum",11],["جُندٌۭ","bala tentara","jundun",374],["مُّحْضَرُونَ","dihadapkan/disiapkan","muḥ'ḍarūna",849]],"t":"Mereka (sesembahan) itu tidak dapat menolong mereka; padahal mereka itu menjadi tentara yang disiapkan untuk menjaga (sesembahan) itu."},{"n":76,"w":[["فَلَا","maka janganlah","falā",4],["يَحْزُنكَ","menyedihkan kamu","yaḥzunka",321],["قَوْلُهُمْ ۘ","perkataan mereka","qawluhum",117],["إِنَّا","sesungguhnya Kami","innā",5],["نَعْلَمُ","Kami mengetahui","naʿlamu",29],["مَا","apa","mā",2],["يُسِرُّونَ","yang mereka rahasiakan","yusirrūna",540],["وَمَا","dan apa yang","wamā",2],["يُعْلِنُونَ","mereka nyatakan","yuʿ'linūna",710]],"t":"Maka jangan sampai ucapan mereka membuat engkau (Muhammad) bersedih hati. Sungguhnya, Kami mengetahui apa yang mereka rahasiakan dan apa yang mereka tampakkan."},{"n":77,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَ","memperhatikan","yara",46],["ٱلْإِنسَـٰنُ","manusia","l-insānu",167],["أَنَّا","bahwasannya Kami","annā",30],["خَلَقْنَـٰهُ","Kami menciptakannya","khalaqnāhu",60],["مِن","dari","min",0],["نُّطْفَةٍۢ","air mani","nuṭ'fatin",737],["فَإِذَا","maka tiba-tiba","fa-idhā",23],["هُوَ","dia","huwa",20],["خَصِيمٌۭ","musuh","khaṣīmun",1417],["مُّبِينٌۭ","nyata","mubīnun",100]],"t":"Dan tidakkah manusia memperhatikan bahwa Kami menciptakannya dari setetes mani, ternyata dia menjadi musuh yang nyata!"},{"n":78,"w":[["وَضَرَبَ","dan dia membuat","waḍaraba",218],["لَنَا","bagi Kami","lanā",121],["مَثَلًۭا","perumpamaan","mathalan",124],["وَنَسِىَ","dan dia lupa","wanasiya",333],["خَلْقَهُۥ ۖ","kejadiannya","khalqahu",229],["قَالَ","dia berkata","qāla",6],["مَن","siapa","man",12],["يُحْىِ","menghidupkan","yuḥ'yī",230],["ٱلْعِظَـٰمَ","tulang-tulang","l-ʿiẓāma",98],["وَهِىَ","padahal ia","wahiya",190],["رَمِيمٌۭ","sudah hancur","ramīmun",2606]],"t":"Dan dia membuat perumpamaan bagi Kami dan melupakan asal kejadiannya; dia berkata, \"Siapakah yang dapat menghidupkan tulang-belulang, yang telah hancur luluh?"},{"n":79,"w":[["قُلْ","katakanlah","qul",6],["يُحْيِيهَا","menghidupkannya","yuḥ'yīhā",230],["ٱلَّذِىٓ","yang","alladhī",7],["أَنشَأَهَآ","menumbuhkan/menjadikannya","ansha-ahā",503],["أَوَّلَ","pertama","awwala",137],["مَرَّةٍۢ ۖ","kali","marratin",528],["وَهُوَ","dan Dia","wahuwa",20],["بِكُلِّ","dengan/tentang segala","bikulli",31],["خَلْقٍ","makhluk","khalqin",229],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",68]],"t":"Katakanlah (Muhammad), \"Yang akan menghidupkannya ialah (Allah) yang menciptakannya pertama kali. Dan Dia Maha Mengetahui tentang segala makhluk,"},{"n":80,"w":[["ٱلَّذِى","yang","alladhī",7],["جَعَلَ","menjadikan","jaʿala",33],["لَكُم","bagi kalian","lakum",26],["مِّنَ","dari","mina",0],["ٱلشَّجَرِ","pohon","l-shajari",1027],["ٱلْأَخْضَرِ","hijau","l-akhḍari",3054],["نَارًۭا","api","nāran",77],["فَإِذَآ","maka tiba-tiba","fa-idhā",23],["أَنتُم","kamu","antum",85],["مِّنْهُ","dari padanya (kayu itu)","min'hu",0],["تُوقِدُونَ","kamu menyalakan","tūqidūna",1285]],"t":"yaitu (Allah) yang menjadikan api untukmu dari kayu yang hijau, maka seketika itu kamu nyalakan (api) dari kayu itu.\""},{"n":81,"w":[["أَوَلَيْسَ","ataukah bukan","awalaysa",119],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",60],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["بِقَـٰدِرٍ","berkuasa","biqādirin",672],["عَلَىٰٓ","atas","ʿalā",8],["أَن","bahwa","an",17],["يَخْلُقَ","menciptakan","yakhluqa",60],["مِثْلَهُم ۚ","serupa mereka itu","mith'lahum",155],["بَلَىٰ","ya/benar","balā",464],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْخَلَّـٰقُ","Maha Pencipta","l-khalāqu",2738],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Dan bukankah (Allah) yang menciptakan langit dan bumi, mampu menciptakan kembali yang serupa itu (jasad mereka yang sudah hancur)? Benar, dan Dia Maha Pencipta, Maha Mengetahui."},{"n":82,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَمْرُهُۥٓ","urusan-Nya/perintah-Nya","amruhu",66],["إِذَآ","apabila","idhā",23],["أَرَادَ","Dia menghendaki","arāda",81],["شَيْـًٔا","sesuatu","shayan",41],["أَن","bahwa","an",17],["يَقُولَ","Dia berkata","yaqūla",6],["لَهُۥ","kepadanya","lahu",16],["كُن","jadi","kun",9],["فَيَكُونُ","maka jadilah","fayakūnu",9]],"t":"Sesungguhnya urusan-Nya apabila Dia menghendaki sesuatu Dia hanya berkata kepadanya, \"Jadilah!\" Maka jadilah sesuatu itu."},{"n":83,"w":[["فَسُبْحَـٰنَ","maka Maha Suci","fasub'ḥāna",285],["ٱلَّذِى","yang","alladhī",7],["بِيَدِهِۦ","di tangan-Nya","biyadihi",99],["مَلَكُوتُ","kekuasaan","malakūtu",1577],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["وَإِلَيْهِ","dan kepadaNya","wa-ilayhi",13],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",142]],"t":"Maka Mahasuci (Allah) yang ditangan-Nya kekuasaan atas segala sesuatu dan kepada-Nya kamu dikembalikan."}]