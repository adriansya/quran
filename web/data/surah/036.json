[{"n":1,"w":[["يسٓ","Yâ­Sîn","ya-seen",3233]],"t":"Yā Sīn"},{"n":2,"w":[["وَٱلْقُرْءَانِ","demi Al Qur'an","wal-qur'āni",189],["ٱلْحَكِيمِ","penuh hikmat","l-ḥakīmi",126]],"t":"Demi Alquran yang penuh hikmah,"},{"n":3,"w":[["إِنَّكَ","sesungguhnya kamu","innaka",9],["لَمِنَ","sungguh dari (salah seorang)","lamina",1],["ٱلْمُرْسَلِينَ","para rasul","l-mur'salīna",341]],"t":"sungguh, engkau (Muhammad) adalah salah seorang dari rasul-rasul,"},{"n":4,"w":[["عَلَىٰ","atas","ʿalā",11],["صِرَٰطٍۢ","jalan","ṣirāṭin",274],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",336]],"t":"(yang berada) di atas jalan yang lurus,"},{"n":5,"w":[["تَنزِيلَ","diturunkan","tanzīla",650],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",124],["ٱلرَّحِيمِ","Maha Penyayang","l-raḥīmi",114]],"t":"(sebagai wahyu) yang diturunkan oleh (Allah) Yang Mahaperkasa, Maha Penyayang,"},{"n":6,"w":[["لِتُنذِرَ","agar kamu memberi peringatan","litundhira",279],["قَوْمًۭا","kaum","qawman",33],["مَّآ","belum","mā",6],["أُنذِرَ","diberi peringatan","undhira",279],["ءَابَآؤُهُمْ","bapak-bapak mereka","ābāuhum",117],["فَهُمْ","maka mereka","fahum",16],["غَـٰفِلُونَ","mereka lalai","ghāfilūna",403]],"t":"agar engkau memberi peringatan kepada suatu kaum yang nenek moyangnya belum pernah diberi peringatan, karena itu mereka lalai."},{"n":7,"w":[["لَقَدْ","sesungguhnya","laqad",30],["حَقَّ","pasti berlaku","ḥaqqa",519],["ٱلْقَوْلُ","perkataan/keputusan","l-qawlu",129],["عَلَىٰٓ","atas","ʿalā",11],["أَكْثَرِهِمْ","kebanyakan mereka","aktharihim",155],["فَهُمْ","maka mereka","fahum",16],["لَا","tidak","lā",8],["يُؤْمِنُونَ","mereka beriman","yu'minūna",23]],"t":"Sungguh, pasti berlaku perkataan (hukuman) terhadap kebanyakan mereka, karena mereka tidak beriman."},{"n":8,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["جَعَلْنَا","Kami telah menjadikan","jaʿalnā",40],["فِىٓ","pada","fī",7],["أَعْنَـٰقِهِمْ","leher-leher mereka","aʿnāqihim",902],["أَغْلَـٰلًۭا","belenggu","aghlālan",920],["فَهِىَ","lalu ia","fahiya",203],["إِلَى","sampai","ilā",18],["ٱلْأَذْقَانِ","dagu","l-adhqāni",1724],["فَهُم","maka mereka","fahum",16],["مُّقْمَحُونَ","tertengadah","muq'maḥūna",3988]],"t":"Sungguh, Kami telah memasang belenggu di leher mereka, lalu tangan mereka (diangkat) ke dagu, karena itu mereka tertengadah."},{"n":9,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["مِنۢ","dari","min",1],["بَيْنِ","antara","bayni",55],["أَيْدِيهِمْ","hadapan mereka","aydīhim",110],["سَدًّۭا","tutup/dinding","saddan",1663],["وَمِنْ","dan dari","wamin",1],["خَلْفِهِمْ","belakang mereka","khalfihim",491],["سَدًّۭا","tutup/dinding","saddan",1663],["فَأَغْشَيْنَـٰهُمْ","lalu Kami tutup mereka","fa-aghshaynāhum",1486],["فَهُمْ","maka mereka","fahum",16],["لَا","tidak","lā",8],["يُبْصِرُونَ","mereka tidak dapat melihat","yub'ṣirūna",390]],"t":"Dan Kami jadikan di hadapan mereka sekat (dinding) dan di belakang mereka juga sekat, dan Kami tutup (mata) mereka sehingga mereka tidak dapat melihat."},{"n":10,"w":[["وَسَوَآءٌ","dan sama saja","wasawāon",420],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["ءَأَنذَرْتَهُمْ","apakah kamu beri peringatan mereka","a-andhartahum",279],["أَمْ","atau","am",93],["لَمْ","tidak","lam",39],["تُنذِرْهُمْ","kamu beri peringatan","tundhir'hum",279],["لَا","tidak","lā",8],["يُؤْمِنُونَ","mereka akan beriman","yu'minūna",23]],"t":"Dan sama saja bagi mereka, apakah engkau memberi peringatan kepada mereka atau engkau tidak memberi peringatan kepada mereka, mereka tidak akan beriman juga."},{"n":11,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["تُنذِرُ","kamu memberi peringatan","tundhiru",279],["مَنِ","orang-orang","mani",17],["ٱتَّبَعَ","mengikuti","ittabaʿa",95],["ٱلذِّكْرَ","peringatan/pengajaran","l-dhik'ra",163],["وَخَشِىَ","dan dia takut","wakhashiya",312],["ٱلرَّحْمَـٰنَ","Maha Pengasih","l-raḥmāna",224],["بِٱلْغَيْبِ ۖ","dengan yang ghaib/tidak kelihatan","bil-ghaybi",254],["فَبَشِّرْهُ","maka berilah dia kabar gembira","fabashir'hu",326],["بِمَغْفِرَةٍۢ","dengan ampunan","bimaghfiratin",406],["وَأَجْرٍۢ","dan pahala","wa-ajrin",121],["كَرِيمٍ","yang mulia","karīmin",383]],"t":"Sesungguhnya engkau hanya memberi peringatan kepada orang-orang yang mau mengikuti peringatan dan yang takut kepada Tuhan Yang Maha Pengasih, walaupun mereka tidak melihat-Nya. Maka berilah mereka kabar gembira dengan ampunan dan pahala yang mulia."},{"n":12,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["نَحْنُ","Kami","naḥnu",140],["نُحْىِ","Kami menghidupkan","nuḥ'yī",242],["ٱلْمَوْتَىٰ","orang mati","l-mawtā",327],["وَنَكْتُبُ","dan Kami tulis","wanaktubu",255],["مَا","apa","mā",6],["قَدَّمُوا۟","yang mereka kerjakan","qaddamū",418],["وَءَاثَـٰرَهُمْ ۚ","dan bekas-bekas mereka","waāthārahum",660],["وَكُلَّ","dan segala","wakulla",38],["شَىْءٍ","sesuatu","shayin",49],["أَحْصَيْنَـٰهُ","Kami hitung/kumpulkan","aḥṣaynāhu",827],["فِىٓ","dalam","fī",7],["إِمَامٍۢ","Kitab","imāmin",720],["مُّبِينٍۢ","yang nyata","mubīnin",112]],"t":"Sungguh, Kamilah yang menghidupkan orang-orang yang mati, dan Kamilah yang mencatat apa yang telah mereka kerjakan dan bekas-bekas yang mereka (tinggalkan). Dan segala sesuatu Kami kumpulkan dalam Kitab yang jelas (Lauḥ Maḥfūẓ)."},{"n":13,"w":[["وَٱضْرِبْ","dan buatlah","wa-iḍ'rib",230],["لَهُم","bagi mereka","lahum",16],["مَّثَلًا","perumpamaan","mathalan",138],["أَصْحَـٰبَ","penghuni/penduduk","aṣḥāba",132],["ٱلْقَرْيَةِ","suatu negeri","l-qaryati",222],["إِذْ","ketika","idh",61],["جَآءَهَا","datang kepada mereka","jāahā",51],["ٱلْمُرْسَلُونَ","utusan-utusan","l-mur'salūna",341]],"t":"Dan buatlah suatu perumpamaan bagi mereka, yaitu penduduk suatu negeri, ketika utusan-utusan datang kepada mereka;"},{"n":14,"w":[["إِذْ","ketika","idh",61],["أَرْسَلْنَآ","Kami mengutus","arsalnā",100],["إِلَيْهِمُ","kepada mereka","ilayhimu",18],["ٱثْنَيْنِ","dua orang","ith'nayni",718],["فَكَذَّبُوهُمَا","lalu mereka mendustakan keduanya","fakadhabūhumā",72],["فَعَزَّزْنَا","maka Kami kuatkan","faʿazzaznā",3132],["بِثَالِثٍۢ","dengan yang ketiga","bithālithin",2723],["فَقَالُوٓا۟","lalu mereka berkata","faqālū",10],["إِنَّآ","seesungguhnya kami","innā",9],["إِلَيْكُم","kepadamu","ilaykum",18],["مُّرْسَلُونَ","orang-orang yang diutus","mur'salūna",341]],"t":"(yaitu) ketika Kami mengutus kepada mereka dua orang utusan, lalu mereka mendustakan keduanya; kemudian Kami kuatkan dengan (utusan) yang ketiga, maka ketiga (utusan itu) berkata, \"Sungguh, kami adalah orang-orang yang diutus kepadamu.\""},{"n":15,"w":[["قَالُوا۟","mereka berkata","qālū",10],["مَآ","tidaklah","mā",6],["أَنتُمْ","kamu","antum",96],["إِلَّا","kecuali","illā",20],["بَشَرٌۭ","manusia","basharun",333],["مِّثْلُنَا","seperti kami","mith'lunā",168],["وَمَآ","dan tidak","wamā",6],["أَنزَلَ","menurunkan","anzala",71],["ٱلرَّحْمَـٰنُ","Yang Maha Pengasih","l-raḥmānu",224],["مِن","dari","min",1],["شَىْءٍ","sesuatu","shayin",49],["إِنْ","tidaklah","in",19],["أَنتُمْ","kamu","antum",96],["إِلَّا","kecuali","illā",20],["تَكْذِبُونَ","kamu berdusta","takdhibūna",797]],"t":"Mereka (penduduk negeri) menjawab, \"Kamu ini hanyalah manusia seperti kami, dan (Allah) Yang Maha Pengasih tidak menurunkan sesuatu apa pun; kamu hanyalah pendusta belaka.\""},{"n":16,"w":[["قَالُوا۟","mereka berkata","qālū",10],["رَبُّنَا","Tuhan kami","rabbunā",15],["يَعْلَمُ","Dia mengetahui","yaʿlamu",35],["إِنَّآ","sesungguhnya kami","innā",9],["إِلَيْكُمْ","kepada kamu","ilaykum",18],["لَمُرْسَلُونَ","benar-benar orang yang diutus","lamur'salūna",341]],"t":"Mereka berkata, \"Tuhan kami mengetahui sesungguhnya kami adalah utusan-utusan (-Nya) kepada kamu."},{"n":17,"w":[["وَمَا","dan tidak ada","wamā",6],["عَلَيْنَآ","atas kami","ʿalaynā",11],["إِلَّا","kecuali","illā",20],["ٱلْبَلَـٰغُ","penyampaian","l-balāghu",637],["ٱلْمُبِينُ","yang nyata","l-mubīnu",112]],"t":"Dan kewajiban kami hanyalah meyampaikan (perintah Allah) dengan jelas.\""},{"n":18,"w":[["قَالُوٓا۟","mereka berkata","qālū",10],["إِنَّا","sesungguhnya kami","innā",9],["تَطَيَّرْنَا","kami sial/celaka","taṭayyarnā",2040],["بِكُمْ ۖ","dengan/untuk kalian","bikum",32],["لَئِن","sungguh jika","la-in",19],["لَّمْ","tidak","lam",39],["تَنتَهُوا۟","kamu berhenti","tantahū",622],["لَنَرْجُمَنَّكُمْ","niscaya kami lempari batu kamu","lanarjumannakum",1417],["وَلَيَمَسَّنَّكُم","dan sungguh akan menimpa kamu","walayamassannakum",227],["مِّنَّا","dari kami","minnā",1],["عَذَابٌ","siksaan","ʿadhābun",43],["أَلِيمٌۭ","pedih","alīmun",178]],"t":"Mereka menjawab, \"Sesungguhnya kami bernasib malang karena kamu. Sungguh, jika kamu tidak berhenti (menyeru kami), niscaya kami rajam kamu dan kamu pasti akan merasakan siksaan yang pedih dari kami.\""},{"n":19,"w":[["قَالُوا۟","mereka berkata","qālū",10],["طَـٰٓئِرُكُم","kesialan/kecelakaan kamu","ṭāirukum",1330],["مَّعَكُمْ ۚ","bersamamu/karena kamu","maʿakum",78],["أَئِن","apakah jika","a-in",19],["ذُكِّرْتُم ۚ","kamu diberi peringatan","dhukkir'tum",549],["بَلْ","bahkan/tetapi","bal",105],["أَنتُمْ","kamu","antum",96],["قَوْمٌۭ","kaum","qawmun",33],["مُّسْرِفُونَ","orang-orang yang melampaui batas","mus'rifūna",645]],"t":"Mereka (utusan-utusan) itu berkata, \"Kemalangan kamu itu adalah karena kamu sendiri. Apakah kamu diberi peringatan? Sebenarnya kamu adalah kaum yang melampaui batas.\""},{"n":20,"w":[["وَجَآءَ","dan datanglah","wajāa",51],["مِنْ","dari","min",1],["أَقْصَا","ujung","aqṣā",1760],["ٱلْمَدِينَةِ","kota","l-madīnati",587],["رَجُلٌۭ","seorang laki-laki","rajulun",223],["يَسْعَىٰ","terburu-buru","yasʿā",529],["قَالَ","ia berkata","qāla",10],["يَـٰقَوْمِ","wahai kaumku","yāqawmi",33],["ٱتَّبِعُوا۟","ikutilah","ittabiʿū",95],["ٱلْمُرْسَلِينَ","utusan-utusan","l-mur'salīna",341]],"t":"Dan datanglah dari ujung kota, seorang laki-laki dengan bergegas dia berkata, \"Wahai kaumku! Ikutilah utusan-utusan itu."},{"n":21,"w":[["ٱتَّبِعُوا۟","ikutilah","ittabiʿū",95],["مَن","orang","man",17],["لَّا","tidak","lā",8],["يَسْـَٔلُكُمْ","ia minta kepadamu","yasalukum",119],["أَجْرًۭا","upah","ajran",121],["وَهُم","dan mereka","wahum",16],["مُّهْتَدُونَ","orang-orang yang mendapat petunjuk","muh'tadūna",527]],"t":"Ikutilah orang yang tidak meminta imbalan kepadamu; dan mereka adalah orang-orang yang mendapat petunjuk."},{"n":22,"w":[["وَمَا","dan mengapa","wamā",6],["لِىَ","bagiku","liya",158],["لَآ","tidak","lā",8],["أَعْبُدُ","aku menyembah","aʿbudu",108],["ٱلَّذِى","(Tuhan) yang","alladhī",45],["فَطَرَنِى","telah menciptakan aku","faṭaranī",846],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",18],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",156]],"t":"Dan tidak ada alasan bagiku untuk tidak menyembah (Allah) yang telah menciptakanku dan hanya kepada-Nyalah kamu akan dikembalikan."},{"n":23,"w":[["ءَأَتَّخِذُ","apakah aku akan mengambil/menyembah","a-attakhidhu",107],["مِن","dari","min",1],["دُونِهِۦٓ","selain Dia","dūnihi",88],["ءَالِهَةً","tuhan-tuhan","ālihatan",84],["إِن","jika","in",19],["يُرِدْنِ","menghendaki terhadapku","yurid'ni",92],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",224],["بِضُرٍّۢ","dengan kemudaratan","biḍurrin",537],["لَّا","tidak","lā",8],["تُغْنِ","memberi manfaat","tugh'ni",285],["عَنِّى","dariku/bagiku","ʿannī",27],["شَفَـٰعَتُهُمْ","syafaat/pertolongan mereka","shafāʿatuhum",686],["شَيْـًۭٔا","sedikitpun/sesuatu","shayan",49],["وَلَا","dan tidak","walā",8],["يُنقِذُونِ","mereka melepaskan/menyelamatkan aku","yunqidhūni",1497]],"t":"Mengapa aku akan menyembah tuhan-tuhan selain-Nya? Jika (Allah) Yang Maha Pengasih menghendaki bencana terhadapku, pasti pertolongan mereka tidak berguna sama sekali bagi diriku dan mereka (juga) tidak dapat menyelamatkanku."},{"n":24,"w":[["إِنِّىٓ","sesungguhnya aku","innī",9],["إِذًۭا","jika demikian","idhan",375],["لَّفِى","sungguh/pasti dalam","lafī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["مُّبِينٍ","yang nyata","mubīnin",112]],"t":"Sesungguhnya jika aku (berbuat) begitu, pasti aku berada dalam kesesatan yang nyata."},{"n":25,"w":[["إِنِّىٓ","sesungguhnya aku","innī",9],["ءَامَنتُ","aku telah beriman","āmantu",23],["بِرَبِّكُمْ","dengan/kepada Tuhanmu","birabbikum",15],["فَٱسْمَعُونِ","maka dengarkanlah aku","fa-is'maʿūni",159]],"t":"Sesungguhnya aku telah beriman kepada Tuhanmu; maka dengarkanlah (pengakuan keimanan)ku.\""},{"n":26,"w":[["قِيلَ","dikatakan","qīla",10],["ٱدْخُلِ","masuklah","ud'khuli",165],["ٱلْجَنَّةَ ۖ","sorga","l-janata",86],["قَالَ","ia berkata","qāla",10],["يَـٰلَيْتَ","seandainya","yālayta",678],["قَوْمِى","kaumku","qawmī",33],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Dikatakan (kepadanya), \"Masuklah ke surga.\" Dia (laki-laki itu) berkata, \"Alangkah baiknya sekiranya kaumku mengetahui,"},{"n":27,"w":[["بِمَا","dengan apa/sebab","bimā",6],["غَفَرَ","memberi ampun","ghafara",197],["لِى","padaku","lī",158],["رَبِّى","Tuhanku","rabbī",15],["وَجَعَلَنِى","dan Dia menjadikan aku","wajaʿalanī",40],["مِنَ","dari/termasuk","mina",1],["ٱلْمُكْرَمِينَ","orang-orang yang dimuliakan","l-muk'ramīna",1400]],"t":"apa yang menyebabkan Tuhanku memberi ampun kepadaku dan menjadikan aku termasuk orang-orang yang telah dimuliakan.\""},{"n":28,"w":[["۞ وَمَآ","dan tidak","wamā",6],["أَنزَلْنَا","Kami tidak menurunkan","anzalnā",71],["عَلَىٰ","atas","ʿalā",11],["قَوْمِهِۦ","kaumnya","qawmihi",33],["مِنۢ","dari","min",1],["بَعْدِهِۦ","sesudahnya/dia","baʿdihi",67],["مِن","dari","min",1],["جُندٍۢ","tentara","jundin",394],["مِّنَ","dari","mina",1],["ٱلسَّمَآءِ","langit","l-samāi",44],["وَمَا","dan tidak","wamā",6],["كُنَّا","layak Kami","kunnā",12],["مُنزِلِينَ","yang menurunkan","munzilīna",1393]],"t":"Dan setelah dia (meninggal), Kami tidak menurunkan suatu pasukan pun dari langit kepada kaumnya, dan Kami tidak perlu menurunkannya."},{"n":29,"w":[["إِن","tidak","in",19],["كَانَتْ","ada","kānat",12],["إِلَّا","kecuali","illā",20],["صَيْحَةًۭ","suara keras","ṣayḥatan",695],["وَٰحِدَةًۭ","satu kali","wāḥidatan",379],["فَإِذَا","maka tiba-tiba","fa-idhā",656],["هُمْ","mereka","hum",16],["خَـٰمِدُونَ","mereka padam/mati","khāmidūna",2755]],"t":"Tidak ada siksaan terhadap mereka melainkan dengan satu teriakan saja; maka seketika itu mereka mati."},{"n":30,"w":[["يَـٰحَسْرَةً","alangkah besarnya penyesalan","yāḥasratan",976],["عَلَى","atas","ʿalā",11],["ٱلْعِبَادِ ۚ","hamba-hamba","l-ʿibādi",99],["مَا","tidak","mā",6],["يَأْتِيهِم","datang kepada mereka","yatīhim",56],["مِّن","dari","min",1],["رَّسُولٍ","seorang Rasul","rasūlin",42],["إِلَّا","kecuali","illā",20],["كَانُوا۟","adalah mereka","kānū",12],["بِهِۦ","dengannya/padanya","bihi",21],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",510]],"t":"Alangkah besar penyesalan terhadap hamba-hamba itu, setiap datang seorang rasul kepada mereka, mereka selalu memperolok-olokkannya."},{"n":31,"w":[["أَلَمْ","apakah tidak","alam",39],["يَرَوْا۟","mereka memperhatikan","yaraw",54],["كَمْ","berapa banyak","kam",499],["أَهْلَكْنَا","Kami telah binasakan","ahlaknā",243],["قَبْلَهُم","sebelum mereka","qablahum",59],["مِّنَ","dari","mina",1],["ٱلْقُرُونِ","kurun/ummat-ummat","l-qurūni",468],["أَنَّهُمْ","bahwasannya mereka","annahum",36],["إِلَيْهِمْ","kepada mereka","ilayhim",18],["لَا","tidak","lā",8],["يَرْجِعُونَ","mereka akan menyembah","yarjiʿūna",156]],"t":"Tidakkah mereka mengetahui berapa banyak umat-umat sebelum mereka yang telah Kami binasakan. Orang-orang (yang telah Kami binasakan) itu tidak ada yang kembali kepada mereka."},{"n":32,"w":[["وَإِن","dan tidak lain","wa-in",19],["كُلٌّۭ","setiap mereka","kullun",38],["لَّمَّا","melainkan","lammā",81],["جَمِيعٌۭ","kesemuanya","jamīʿun",236],["لَّدَيْنَا","disisi Kami","ladaynā",480],["مُحْضَرُونَ","mereka dihadirkan/dihadapkan","muḥ'ḍarūna",862]],"t":"Dan setiap (umat), semuanya akan dihadapkan kepada Kami."},{"n":33,"w":[["وَءَايَةٌۭ","dan suatu tanda","waāyatun",34],["لَّهُمُ","bagi mereka","lahumu",16],["ٱلْأَرْضُ","bumi","l-arḍu",28],["ٱلْمَيْتَةُ","yang mati","l-maytatu",1215],["أَحْيَيْنَـٰهَا","dan Kami keluarkan","aḥyaynāhā",242],["وَأَخْرَجْنَا","daripadanya","wa-akhrajnā",125],["مِنْهَا","daripadanya","min'hā",1],["حَبًّۭا","biji-bijian","ḥabban",1067],["فَمِنْهُ","maka daripadanya","famin'hu",1],["يَأْكُلُونَ","mereka makan","yakulūna",127]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah bumi yang mati (tandus). Kami hidupkan bumi itu dan Kami keluarkan darinya biji-bijian, maka dari (biji-bijian) itu mereka makan."},{"n":34,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["فِيهَا","di dalamnya/padanya","fīhā",7],["جَنَّـٰتٍۢ","kebun-kebun","jannātin",86],["مِّن","dari","min",1],["نَّخِيلٍۢ","korma","nakhīlin",564],["وَأَعْنَـٰبٍۢ","dan anggur","wa-aʿnābin",785],["وَفَجَّرْنَا","dan Kami pancarkan","wafajjarnā",1190],["فِيهَا","di dalamnya","fīhā",7],["مِنَ","dari","mina",1],["ٱلْعُيُونِ","mata air","l-ʿuyūni",218]],"t":"Dan Kami jadikan padanya di bumi itu kebun-kebun kurma dan anggur dan Kami pancarkan padanya beberapa mata air,"},{"n":35,"w":[["لِيَأْكُلُوا۟","supaya mereka makan","liyakulū",127],["مِن","dari","min",1],["ثَمَرِهِۦ","buahnya","thamarihi",1436],["وَمَا","dan apa","wamā",6],["عَمِلَتْهُ","yang diusahakannya","ʿamilathu",52],["أَيْدِيهِمْ ۖ","tangan-tangan mereka","aydīhim",110],["أَفَلَا","maka mengapa tidak","afalā",8],["يَشْكُرُونَ","mereka bersyukur","yashkurūna",267]],"t":"agar mereka dapat makan dari buahnya, dan dari hasil usaha tangan mereka. Maka mengapa mereka tidak bersyukur?"},{"n":36,"w":[["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",303],["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","telah menciptakan","khalaqa",70],["ٱلْأَزْوَٰجَ","pasangan-pasangan","l-azwāja",166],["كُلَّهَا","semuanya","kullahā",38],["مِمَّا","dari apa","mimmā",1],["تُنۢبِتُ","ditumbuhkan","tunbitu",600],["ٱلْأَرْضُ","bumi","l-arḍu",28],["وَمِنْ","dan dari","wamin",1],["أَنفُسِهِمْ","diri mereka sendiri","anfusihim",47],["وَمِمَّا","dan dari apa","wamimmā",1],["لَا","tidak","lā",8],["يَعْلَمُونَ","mereka ketahui","yaʿlamūna",35]],"t":"Mahasuci (Allah) yang telah menciptakan semuanya berpasang-pasangan, baik dari apa yang ditumbuhkan oleh bumi dan dari diri mereka sendiri, maupun dari apa yang tidak mereka ketahui."},{"n":37,"w":[["وَءَايَةٌۭ","dan suatu tanda","waāyatun",34],["لَّهُمُ","bagi mereka","lahumu",16],["ٱلَّيْلُ","malam","al-laylu",146],["نَسْلَخُ","Kami tanggalkan","naslakhu",4271],["مِنْهُ","daripadanya/malam itu","min'hu",1],["ٱلنَّهَارَ","siang","l-nahāra",221],["فَإِذَا","maka tiba-tiba","fa-idhā",29],["هُم","mereka","hum",16],["مُّظْلِمُونَ","mereka kegelapan","muẓ'limūna",2510]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah malam; Kami tanggalkan siang dari (malam) itu, maka seketika itu mereka (berada dalam) kegelapan,"},{"n":38,"w":[["وَٱلشَّمْسُ","dan matahari","wal-shamsu",358],["تَجْرِى","berjalan","tajrī",219],["لِمُسْتَقَرٍّۢ","di tempat ketetapan/peredaran","limus'taqarrin",860],["لَّهَا ۚ","baginya","lahā",106],["ذَٰلِكَ","demikian","dhālika",26],["تَقْدِيرُ","ketetapan","taqdīru",1432],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",124],["ٱلْعَلِيمِ","Maha Mengetahui","l-ʿalīmi",77]],"t":"dan matahari berjalan di tempat peredarannya. Demikianlah ketetapan (Allah) Yang Mahaperkasa, Maha Mengetahui."},{"n":39,"w":[["وَٱلْقَمَرَ","dan bulan","wal-qamara",419],["قَدَّرْنَـٰهُ","telah Kami tetapkannya","qaddarnāhu",613],["مَنَازِلَ","tempat-tempat(nya)","manāzila",2477],["حَتَّىٰ","sehingga","ḥattā",91],["عَادَ","ia kembali","ʿāda",556],["كَٱلْعُرْجُونِ","seperti tandan","kal-ʿur'jūni",3148],["ٱلْقَدِيمِ","yang tua","l-qadīmi",1984]],"t":"Dan telah Kami tetapkan tempat peredaran bagi bulan, sehingga (setelah ia sampai ke tempat peredaran yang terakhir) kembalilah ia seperti bentuk tandan yang tua."},{"n":40,"w":[["لَا","tidak","lā",8],["ٱلشَّمْسُ","matahari","l-shamsu",358],["يَنۢبَغِى","patut/mungkin","yanbaghī",1268],["لَهَآ","baginya","lahā",106],["أَن","bahwa","an",22],["تُدْرِكَ","mendapatkan/mengejar","tud'rika",1144],["ٱلْقَمَرَ","bulan","l-qamara",419],["وَلَا","and not","walā",8],["ٱلَّيْلُ","malam","al-laylu",146],["سَابِقُ","mendahului","sābiqu",1016],["ٱلنَّهَارِ ۚ","siang","l-nahāri",221],["وَكُلٌّۭ","dan masing-masing","wakullun",38],["فِى","dalam","fī",7],["فَلَكٍۢ","garis edar","falakin",2372],["يَسْبَحُونَ","mereka beredar","yasbaḥūna",2647]],"t":"Tidaklah mungkin bagi matahari mengejar bulan dan malam pun tidak dapat mendahului siang. Masing-masing beredar pada garis edarnya."},{"n":41,"w":[["وَءَايَةٌۭ","dan dan suatu tanda","waāyatun",34],["لَّهُمْ","bagi mereka","lahum",16],["أَنَّا","bahwasannya Kami","annā",36],["حَمَلْنَا","Kami bawa/angkut","ḥamalnā",299],["ذُرِّيَّتَهُمْ","keturunan mereka","dhurriyyatahum",365],["فِى","dalam","fī",7],["ٱلْفُلْكِ","perahu/bahtera","l-ful'ki",465],["ٱلْمَشْحُونِ","penuh muatan","l-mashḥūni",1904]],"t":"Dan suatu tanda (kebesaran Allah) bagi mereka adalah bahwa Kami angkut keturunan mereka dalam kapal yang penuh muatan,"},{"n":42,"w":[["وَخَلَقْنَا","dan Kami ciptakan","wakhalaqnā",70],["لَهُم","untuk mereka","lahum",16],["مِّن","dari","min",1],["مِّثْلِهِۦ","seperti/serupa itu","mith'lihi",168],["مَا","apa","mā",6],["يَرْكَبُونَ","mereka kendarai","yarkabūna",939]],"t":"dan Kami ciptakan (juga) untuk mereka (angkutan lain) seperti apa yang mereka kendarai."},{"n":43,"w":[["وَإِن","dan jika","wa-in",19],["نَّشَأْ","Kami menghendaki","nasha",62],["نُغْرِقْهُمْ","Kami tenggelamkan mereka","nugh'riq'hum",575],["فَلَا","maka tidak","falā",8],["صَرِيخَ","pertolongan","ṣarīkha",3267],["لَهُمْ","bagi mereka","lahum",16],["وَلَا","dan tidak","walā",8],["هُمْ","mereka","hum",16],["يُنقَذُونَ","mereka dilepaskan/diselamatkan","yunqadhūna",1497]],"t":"Dan jika Kami menghendaki, Kami tenggelamkan mereka. Maka tidak ada penolong bagi mereka dan tidak (pula) mereka diselamatkan,"},{"n":44,"w":[["إِلَّا","kecuali","illā",20],["رَحْمَةًۭ","rahmat","raḥmatan",116],["مِّنَّا","dari Kami","minnā",1],["وَمَتَـٰعًا","dan kesenangan hidup","wamatāʿan",347],["إِلَىٰ","sampai","ilā",18],["حِينٍۢ","suatu waktu","ḥīnin",345]],"t":"melainkan (Kami selamatkan mereka) karena rahmat yang besar dari Kami dan untuk memberikan kesenangan hidup sampai waktu tertentu."},{"n":45,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["قِيلَ","dikatakan","qīla",10],["لَهُمُ","kepada mereka","lahumu",16],["ٱتَّقُوا۟","takutlah kamu","ittaqū",76],["مَا","apa","mā",6],["بَيْنَ","yang diantara","bayna",55],["أَيْدِيكُمْ","tanganmu/hadapanmu","aydīkum",110],["وَمَا","dan apa","wamā",6],["خَلْفَكُمْ","di belakangmu","khalfakum",491],["لَعَلَّكُمْ","agar kalian","laʿallakum",101],["تُرْحَمُونَ","kamu diberi rahmat","tur'ḥamūna",407]],"t":"Dan apabila dikatakan kepada mereka, \"Takutlah kamu akan siksa yang dihadapanmu (di dunia) dan azab yang akan datang (akhirat) agar kamu mendapat rahmat.\""},{"n":46,"w":[["وَمَا","dan tidak","wamā",6],["تَأْتِيهِم","datang kepada mereka","tatīhim",56],["مِّنْ","dari","min",1],["ءَايَةٍۢ","suatu tanda","āyatin",34],["مِّنْ","dari","min",1],["ءَايَـٰتِ","tanda-tanda","āyāti",34],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["إِلَّا","kecuali","illā",20],["كَانُوا۟","adalah mereka","kānū",12],["عَنْهَا","daripadanya","ʿanhā",27],["مُعْرِضِينَ","orang-orang yang berpaling","muʿ'riḍīna",543]],"t":"Dan setiap kali suatu tanda dari tanda-tanda (kebesaran) Tuhan datang kepada mereka, mereka selalu berpaling darinya."},{"n":47,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["قِيلَ","dikatakan","qīla",10],["لَهُمْ","kepada mereka","lahum",16],["أَنفِقُوا۟","nafkahkan/belanjakan","anfiqū",193],["مِمَّا","dari sebagian","mimmā",1],["رَزَقَكُمُ","memberi rezeki","razaqakumu",208],["ٱللَّهُ","Allah","l-lahu",4],["قَالَ","berkata","qāla",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لِلَّذِينَ","kepada orang yang","lilladhīna",13],["ءَامَنُوٓا۟","beriman","āmanū",23],["أَنُطْعِمُ","apakah kami memberi makan","anuṭ'ʿimu",687],["مَن","orang","man",17],["لَّوْ","jika","law",66],["يَشَآءُ","menghendaki","yashāu",62],["ٱللَّهُ","Allah","l-lahu",4],["أَطْعَمَهُۥٓ","Dia memberinya makan","aṭʿamahu",687],["إِنْ","tidaklah","in",19],["أَنتُمْ","kamu","antum",96],["إِلَّا","kecuali","illā",20],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["مُّبِينٍۢ","nyata","mubīnin",112]],"t":"Dan apabila dikatakan kepada mereka, \"Infakkanlah sebagian rezeki yang diberikan Allah kepadamu,\" orang-orang yang kafir itu berkata kepada orang-orang yang beriman, \"Apakah pantas kami memberi makan kepada orang-orang yang jika Allah menghendaki Dia akan memberinya makan? Kamu benar-benar dalam kesesatan yang nyata.\""},{"n":48,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",10],["مَتَىٰ","bilakah","matā",929],["هَـٰذَا","ini","hādhā",64],["ٱلْوَعْدُ","janji","l-waʿdu",258],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",211]],"t":"Dan mereka (orang-orang kafir) berkata, \"Kapan janji (hari berbangkit) itu (terjadi) jika kamu orang-orang yang benar?\""},{"n":49,"w":[["مَا","tidak","mā",6],["يَنظُرُونَ","mereka menunggu","yanẓurūna",139],["إِلَّا","kecuali","illā",20],["صَيْحَةًۭ","teriakan/suara keras","ṣayḥatan",695],["وَٰحِدَةًۭ","satu kali","wāḥidatan",379],["تَأْخُذُهُمْ","menimpa mereka","takhudhuhum",103],["وَهُمْ","dan/ketika mereka","wahum",16],["يَخِصِّمُونَ","mereka bertengkar","yakhiṣṣimūna",1036]],"t":"Mereka hanya menunggu satu teriakan, yang akan membinasakan mereka ketika mereka sedang bertengkar."},{"n":50,"w":[["فَلَا","maka tidak","falā",8],["يَسْتَطِيعُونَ","mereka kuasa (membuat)","yastaṭīʿūna",296],["تَوْصِيَةًۭ","satu wasiat","tawṣiyatan",4418],["وَلَآ","dan tidak","walā",8],["إِلَىٰٓ","kecuali","ilā",18],["أَهْلِهِمْ","keluarga mereka","ahlihim",102],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",156]],"t":"Sehingga mereka tidak mampu membuat suatu wasiat dan mereka (juga) tidak dapat kembali kepada keluarganya."},{"n":51,"w":[["وَنُفِخَ","dan ditiuplah","wanufikha",544],["فِى","dalam","fī",7],["ٱلصُّورِ","sangkakala","l-ṣūri",839],["فَإِذَا","maka tiba-tiba","fa-idhā",29],["هُم","mereka","hum",16],["مِّنَ","dari","mina",1],["ٱلْأَجْدَاثِ","kubur","l-ajdāthi",1880],["إِلَىٰ","kepada","ilā",18],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["يَنسِلُونَ","mereka datang/menuju","yansilūna",2578]],"t":"Lalu ditiuplah sangkakala, maka seketika itu mereka keluar dari kuburnya (dalam keadaan hidup), menuju kepada Tuhannya."},{"n":52,"w":[["قَالُوا۟","mereka berkata","qālū",10],["يَـٰوَيْلَنَا","betapa celakanya kami","yāwaylanā",311],["مَنۢ","siapakah","man",17],["بَعَثَنَا","membangkitkan kami","baʿathanā",239],["مِن","dari","min",1],["مَّرْقَدِنَا ۜ ۗ","tempat tidur kami","marqadinā",3942],["هَـٰذَا","ini","hādhā",64],["مَا","apa","mā",6],["وَعَدَ","dijanjikan","waʿada",190],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",224],["وَصَدَقَ","dan benar","waṣadaqa",634],["ٱلْمُرْسَلُونَ","para Rasul","l-mur'salūna",341]],"t":"Mereka berkata, \"Celakalah kami! Siapakah yang membangkitkan kami dari tempat tidur kami (kubur)?\" Inilah yang dijanjikan (Allah) Yang Maha Pengasih dan benarlah rasul-rasul(-Nya)."},{"n":53,"w":[["إِن","tidak","in",19],["كَانَتْ","ada","kānat",12],["إِلَّا","kecuali","illā",20],["صَيْحَةًۭ","teriakan/suara keras","ṣayḥatan",695],["وَٰحِدَةًۭ","satu kali","wāḥidatan",379],["فَإِذَا","maka tiba-tiba","fa-idhā",29],["هُمْ","mereka","hum",16],["جَمِيعٌۭ","semuanya","jamīʿun",236],["لَّدَيْنَا","di sisi/di hadapan Kami","ladaynā",480],["مُحْضَرُونَ","orang-orang yang dihadapkan/dikumpulkan","muḥ'ḍarūna",862]],"t":"Teriakan itu hanya sekali saja, maka seketika itu mereka semua dihadapkan kepada Kami (untuk dihisab)."},{"n":54,"w":[["فَٱلْيَوْمَ","maka pada hari itu","fal-yawma",31],["لَا","tidak","lā",8],["تُظْلَمُ","dianiaya/dirugikan","tuẓ'lamu",118],["نَفْسٌۭ","seseorang","nafsun",47],["شَيْـًۭٔا","sesuatu/sedikitpun","shayan",49],["وَلَا","dan tidak","walā",8],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",175],["إِلَّا","kecuali","illā",20],["مَا","apa","mā",6],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52]],"t":"Maka pada hari itu seseorang tidak akan dirugikan sedikit pun dan kamu tidak akan diberi balasan, kecuali sesuai dengan apa yang telah kamu kerjakan."},{"n":55,"w":[["إِنَّ","sesungguhnya","inna",9],["أَصْحَـٰبَ","penghuni","aṣḥāba",132],["ٱلْجَنَّةِ","sorga","l-janati",86],["ٱلْيَوْمَ","pada hari itu","l-yawma",31],["فِى","dalam","fī",7],["شُغُلٍۢ","kesibukan","shughulin",2864],["فَـٰكِهُونَ","bersenang-senang","fākihūna",1852]],"t":"Sesungguhnya penghuni surga pada hari itu bersenang-senang dalam kesibukan (mereka)."},{"n":56,"w":[["هُمْ","mereka","hum",16],["وَأَزْوَٰجُهُمْ","dan isteri-isteri mereka","wa-azwājuhum",166],["فِى","dalam","fī",7],["ظِلَـٰلٍ","tempat yang teduh","ẓilālin",670],["عَلَى","di atas","ʿalā",11],["ٱلْأَرَآئِكِ","tempat duduk/pelamin","l-arāiki",1292],["مُتَّكِـُٔونَ","mereka bersandar","muttakiūna",1008]],"t":"Mereka dan pasangan-pasangannya berada dalam tempat yang teduh, bersandar di atas dipan-dipan."},{"n":57,"w":[["لَهُمْ","bagi mereka/memperoleh","lahum",16],["فِيهَا","di dalamnya (sorga)","fīhā",7],["فَـٰكِهَةٌۭ","buah-buahan","fākihatun",672],["وَلَهُم","dan bagi mereka/memperoleh","walahum",16],["مَّا","apa","mā",6],["يَدَّعُونَ","yang mereka minta","yaddaʿūna",2093]],"t":"Di surga itu mereka memperoleh buah-buahan dan memperoleh apa saja yang mereka inginkan."},{"n":58,"w":[["سَلَـٰمٌۭ","penghormatan/sejahtera","salāmun",294],["قَوْلًۭا","perkataan/kata","qawlan",129],["مِّن","dari","min",1],["رَّبٍّۢ","Tuhan","rabbin",15],["رَّحِيمٍۢ","Maha Penyayang","raḥīmin",114]],"t":"(Kepada mereka dikatakan), \"Salām,\" sebagai ucapan selamat dari Tuhan Yang Maha Penyayang."},{"n":59,"w":[["وَٱمْتَـٰزُوا۟","dan berpisahlah kamu","wa-im'tāzū",4637],["ٱلْيَوْمَ","hari ini","l-yawma",31],["أَيُّهَا","hai","ayyuhā",83],["ٱلْمُجْرِمُونَ","orang-orang yang berdosa","l-muj'rimūna",240]],"t":"Dan (dikatakan kepada orang-orang kafir), \"Berpisahlah kamu (dari orang-orang mukmin) pada hari ini, wahai orang-orang yang berdosa!"},{"n":60,"w":[["۞ أَلَمْ","tidaklah","alam",39],["أَعْهَدْ","Aku peringatkan/memerintahkan","aʿhad",1163],["إِلَيْكُمْ","kepadamu","ilaykum",18],["يَـٰبَنِىٓ","Wahai keturunan","yābanī",90],["ءَادَمَ","Adam","ādama",435],["أَن","bahwa","an",22],["لَّا","tidak","lā",8],["تَعْبُدُوا۟","kamu menyembah","taʿbudū",108],["ٱلشَّيْطَـٰنَ ۖ","syaitan","l-shayṭāna",134],["إِنَّهُۥ","sesungguhnya ia","innahu",9],["لَكُمْ","bagi kalian","lakum",32],["عَدُوٌّۭ","musuh","ʿaduwwun",248],["مُّبِينٌۭ","nyata","mubīnun",112]],"t":"Bukankah Aku telah memerintahkan kepadamu wahai anak cucu Adam agar kamu tidak menyembah setan? Sungguh, setan itu musuh yang nyata bagi kamu,"},{"n":61,"w":[["وَأَنِ","dan hendaklah","wa-ani",22],["ٱعْبُدُونِى ۚ","kamu menyembah-Ku","uʿ'budūnī",108],["هَـٰذَا","ini","hādhā",64],["صِرَٰطٌۭ","jalan","ṣirāṭun",274],["مُّسْتَقِيمٌۭ","lurus","mus'taqīmun",336]],"t":"dan hendaklah kamu menyembah-Ku. Inilah jalan yang lurus.\""},{"n":62,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["أَضَلَّ","ia telah menyesatkan","aḍalla",199],["مِنكُمْ","diantara kamu","minkum",1],["جِبِلًّۭا","sejumlah/sebagian","jibillan",2419],["كَثِيرًا ۖ","banyak/besar","kathīran",172],["أَفَلَمْ","maka apakah tidak","afalam",39],["تَكُونُوا۟","kalian menjadi","takūnū",12],["تَعْقِلُونَ","kalian menggunakan akal","taʿqilūna",253]],"t":"Dan sungguh, ia (setan itu) telah menyesatkan sebagian besar di antara kamu. Maka apakah kamu tidak mengerti?"},{"n":63,"w":[["هَـٰذِهِۦ","ini","hādhihi",265],["جَهَنَّمُ","Jahannam","jahannamu",162],["ٱلَّتِى","adalah","allatī",195],["كُنتُمْ","kalian adalah","kuntum",12],["تُوعَدُونَ","kamu diancam","tūʿadūna",190]],"t":"Inilah (neraka) Jahanam yang dahulu telah diperingatkan kepadamu."},{"n":64,"w":[["ٱصْلَوْهَا","masuklah ke dalamnya","iṣ'lawhā",694],["ٱلْيَوْمَ","hari ini","l-yawma",31],["بِمَا","karena","bimā",6],["كُنتُمْ","kalian adalah","kuntum",12],["تَكْفُرُونَ","kalian kafir","takfurūna",48]],"t":"Masuklah ke dalamnya pada hari ini karena dahulu kamu mengingkarinya."},{"n":65,"w":[["ٱلْيَوْمَ","pada hari ini","al-yawma",31],["نَخْتِمُ","Kami kunci/tutup","nakhtimu",1448],["عَلَىٰٓ","atas","ʿalā",11],["أَفْوَٰهِهِمْ","mulut-mulut mereka","afwāhihim",697],["وَتُكَلِّمُنَآ","dan berkata kepada Kami","watukallimunā",525],["أَيْدِيهِمْ","tangan-tangan mereka","aydīhim",110],["وَتَشْهَدُ","dan memberi kesaksian","watashhadu",278],["أَرْجُلُهُم","kaki-kaki mereka","arjuluhum",648],["بِمَا","dengan/terhadap apa","bimā",6],["كَانُوا۟","adalah mereka","kānū",12],["يَكْسِبُونَ","mereka usahakan","yaksibūna",206]],"t":"Pada hari ini Kami tutup mulut mereka; tangan mereka akan berkata kepada Kami dan kaki mereka akan memberi kesaksian terhadap apa yang dahulu mereka kerjakan."},{"n":66,"w":[["وَلَوْ","dan jika","walaw",66],["نَشَآءُ","Kami menghendaki","nashāu",62],["لَطَمَسْنَا","tentu Kami hapuskan/gelapkan","laṭamasnā",1331],["عَلَىٰٓ","atas","ʿalā",11],["أَعْيُنِهِمْ","penglihatan mata mereka","aʿyunihim",218],["فَٱسْتَبَقُوا۟","lalu mereka berlomba-lomba","fa-is'tabaqū",1465],["ٱلصِّرَٰطَ","jalan","l-ṣirāṭa",274],["فَأَنَّىٰ","maka bagaimana","fa-annā",401],["يُبْصِرُونَ","mereka melihat","yub'ṣirūna",390]],"t":"Dan jika Kami menghendaki, pastilah Kami hapuskan penglihatan mata mereka; sehingga mereka berlomba-lomba (mencari) jalan. Maka bagaimana mungkin mereka dapat melihat?"},{"n":67,"w":[["وَلَوْ","dan jika","walaw",66],["نَشَآءُ","Kami menghendaki","nashāu",62],["لَمَسَخْنَـٰهُمْ","tentu Kami rubah rupa mereka","lamasakhnāhum",3751],["عَلَىٰ","atas","ʿalā",11],["مَكَانَتِهِمْ","tempat mereka berada","makānatihim",1379],["فَمَا","maka tidak","famā",6],["ٱسْتَطَـٰعُوا۟","mereka sanggup","is'taṭāʿū",296],["مُضِيًّۭا","maju/berjalan","muḍiyyan",3793],["وَلَا","dan tidak","walā",8],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",156]],"t":"Dan jika Kami menghendaki, pastilah Kami ubah bentuk mereka di tempat mereka berada; sehingga mereka tidak sanggup berjalan lagi dan juga tidak sanggup kembali."},{"n":68,"w":[["وَمَن","dan barangsiapa","waman",17],["نُّعَمِّرْهُ","Kami panjangkan umurnya","nuʿammir'hu",1306],["نُنَكِّسْهُ","Kami kembalikan dia","nunakkis'hu",4047],["فِى","dalam/kepada","fī",7],["ٱلْخَلْقِ ۖ","kejadian","l-khalqi",241],["أَفَلَا","apakah maka tidak","afalā",8],["يَعْقِلُونَ","mereka menggunakan akal/berpikir","yaʿqilūna",253]],"t":"Dan barang siapa Kami panjangkan umurnya niscaya Kami kembalikan dia kepada awal kejadian(nya). Maka mengapa mereka tidak mengerti?"},{"n":69,"w":[["وَمَا","dan tidak","wamā",6],["عَلَّمْنَـٰهُ","Kami mengajarkannya","ʿallamnāhu",298],["ٱلشِّعْرَ","syair","l-shiʿ'ra",2118],["وَمَا","dan tidak","wamā",6],["يَنۢبَغِى","layak","yanbaghī",1268],["لَهُۥٓ ۚ","baginya","lahu",21],["إِنْ","tidak","in",19],["هُوَ","ia","huwa",25],["إِلَّا","kecuali","illā",20],["ذِكْرٌۭ","peringatan/pelajaran","dhik'run",163],["وَقُرْءَانٌۭ","dan bacaan","waqur'ānun",189],["مُّبِينٌۭ","nyata","mubīnun",112]],"t":"Dan Kami tidak mengajarkan syair kepadanya (Muhammad) dan bersyair itu tidaklah pantas baginya. Alquran itu tidak lain hanyalah pelajaran dan Kitab yang jelas."},{"n":70,"w":[["لِّيُنذِرَ","supaya dia memberi peringatan","liyundhira",279],["مَن","orang-orang","man",17],["كَانَ","adalah","kāna",12],["حَيًّۭا","hidup","ḥayyan",450],["وَيَحِقَّ","dan pasti berlaku","wayaḥiqqa",519],["ٱلْقَوْلُ","perkataan/azab","l-qawlu",129],["عَلَى","atas","ʿalā",11],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79]],"t":"agar dia (Muhammad) memberi peringatan kepada orang-orang yang hidup (hatinya) dan agar pasti ketetapan (azab) terhadap orang-orang kafir."},{"n":71,"w":[["أَوَلَمْ","ataukah tidak","awalam",39],["يَرَوْا۟","mereka melihat/memperlihatkan","yaraw",54],["أَنَّا","bahwasannya Kami","annā",36],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",70],["لَهُم","untuk mereka","lahum",16],["مِّمَّا","dari sebagian apa","mimmā",1],["عَمِلَتْ","mengerjakan/menciptakan","ʿamilat",52],["أَيْدِينَآ","tangan/kekuasaan Kami","aydīnā",110],["أَنْعَـٰمًۭا","binatang ternak","anʿāman",363],["فَهُمْ","lalu mereka","fahum",16],["لَهَا","padanya","lahā",106],["مَـٰلِكُونَ","mereka memiliki/menguasai","mālikūna",1916]],"t":"Dan tidakkah mereka melihat bahwa Kami telah meciptakan hewan ternak untuk mereka, yaitu sebagian dari apa yang telah Kami ciptakan dengan kekuasaan Kami, lalu mereka menguasainya ?"},{"n":72,"w":[["وَذَلَّلْنَـٰهَا","dan Kami tundukkannya","wadhallalnāhā",2123],["لَهُمْ","untuk mereka","lahum",16],["فَمِنْهَا","maka sebagiannya","famin'hā",1],["رَكُوبُهُمْ","tunggangan mereka","rakūbuhum",4186],["وَمِنْهَا","dan sebagiannya","wamin'hā",1],["يَأْكُلُونَ","mereka makan","yakulūna",127]],"t":"Dan Kami menundukkannya (hewan-hewan itu) untuk mereka; lalu sebagiannya untuk menjadi tunggangan mereka dan sebagian untuk mereka makan."},{"n":73,"w":[["وَلَهُمْ","dan bagi mereka (memperoleh)","walahum",16],["فِيهَا","padanya","fīhā",7],["مَنَـٰفِعُ","kemanfaatan","manāfiʿu",999],["وَمَشَارِبُ ۖ","dan minuman","wamashāribu",1951],["أَفَلَا","apakah maka tidak","afalā",8],["يَشْكُرُونَ","mereka bersyukur","yashkurūna",267]],"t":"Dan mereka memperoleh berbagai manfaat dan minuman darinya. Maka mengapa mereka tidak bersyukur?"},{"n":74,"w":[["وَٱتَّخَذُوا۟","dan mereka mengambil/menyembah","wa-ittakhadhū",107],["مِن","dari","min",1],["دُونِ","selain","dūni",88],["ٱللَّهِ","Allah","l-lahi",4],["ءَالِهَةًۭ","tuhan-tuhan","ālihatan",84],["لَّعَلَّهُمْ","agar mereka","laʿallahum",101],["يُنصَرُونَ","mereka ditolong","yunṣarūna",212]],"t":"Dan mereka mengangkat sesembahan selain Allah agar mereka mendapat pertolongan."},{"n":75,"w":[["لَا","tidak","lā",8],["يَسْتَطِيعُونَ","mereka tidak kuasa","yastaṭīʿūna",296],["نَصْرَهُمْ","menolong mereka","naṣrahum",483],["وَهُمْ","sedang mereka","wahum",16],["لَهُمْ","untuk mereka","lahum",16],["جُندٌۭ","bala tentara","jundun",394],["مُّحْضَرُونَ","dihadapkan/disiapkan","muḥ'ḍarūna",862]],"t":"Mereka (sesembahan) itu tidak dapat menolong mereka; padahal mereka itu menjadi tentara yang disiapkan untuk menjaga (sesembahan) itu."},{"n":76,"w":[["فَلَا","maka janganlah","falā",8],["يَحْزُنكَ","menyedihkan kamu","yaḥzunka",331],["قَوْلُهُمْ ۘ","perkataan mereka","qawluhum",129],["إِنَّا","sesungguhnya Kami","innā",9],["نَعْلَمُ","Kami mengetahui","naʿlamu",35],["مَا","apa","mā",6],["يُسِرُّونَ","yang mereka rahasiakan","yusirrūna",553],["وَمَا","dan apa yang","wamā",6],["يُعْلِنُونَ","mereka nyatakan","yuʿ'linūna",723]],"t":"Maka jangan sampai ucapan mereka membuat engkau (Muhammad) bersedih hati. Sungguhnya, Kami mengetahui apa yang mereka rahasiakan dan apa yang mereka tampakkan."},{"n":77,"w":[["أَوَلَمْ","ataukah tidak","awalam",39],["يَرَ","memperhatikan","yara",54],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["أَنَّا","bahwasannya Kami","annā",36],["خَلَقْنَـٰهُ","Kami menciptakannya","khalaqnāhu",70],["مِن","dari","min",1],["نُّطْفَةٍۢ","air mani","nuṭ'fatin",753],["فَإِذَا","maka tiba-tiba","fa-idhā",29],["هُوَ","dia","huwa",25],["خَصِيمٌۭ","musuh","khaṣīmun",1444],["مُّبِينٌۭ","nyata","mubīnun",112]],"t":"Dan tidakkah manusia memperhatikan bahwa Kami menciptakannya dari setetes mani, ternyata dia menjadi musuh yang nyata!"},{"n":78,"w":[["وَضَرَبَ","dan dia membuat","waḍaraba",230],["لَنَا","bagi Kami","lanā",135],["مَثَلًۭا","perumpamaan","mathalan",138],["وَنَسِىَ","dan dia lupa","wanasiya",349],["خَلْقَهُۥ ۖ","kejadiannya","khalqahu",241],["قَالَ","dia berkata","qāla",10],["مَن","siapa","man",17],["يُحْىِ","menghidupkan","yuḥ'yī",242],["ٱلْعِظَـٰمَ","tulang-tulang","l-ʿiẓāma",109],["وَهِىَ","padahal ia","wahiya",203],["رَمِيمٌۭ","sudah hancur","ramīmun",2629]],"t":"Dan dia membuat perumpamaan bagi Kami dan melupakan asal kejadiannya; dia berkata, \"Siapakah yang dapat menghidupkan tulang-belulang, yang telah hancur luluh?"},{"n":79,"w":[["قُلْ","katakanlah","qul",10],["يُحْيِيهَا","menghidupkannya","yuḥ'yīhā",242],["ٱلَّذِىٓ","yang","alladhī",45],["أَنشَأَهَآ","menumbuhkan/menjadikannya","ansha-ahā",514],["أَوَّلَ","pertama","awwala",151],["مَرَّةٍۢ ۖ","kali","marratin",526],["وَهُوَ","dan Dia","wahuwa",25],["بِكُلِّ","dengan/tentang segala","bikulli",38],["خَلْقٍ","makhluk","khalqin",241],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",77]],"t":"Katakanlah (Muhammad), \"Yang akan menghidupkannya ialah (Allah) yang menciptakannya pertama kali. Dan Dia Maha Mengetahui tentang segala makhluk,"},{"n":80,"w":[["ٱلَّذِى","yang","alladhī",45],["جَعَلَ","menjadikan","jaʿala",40],["لَكُم","bagi kalian","lakum",32],["مِّنَ","dari","mina",1],["ٱلشَّجَرِ","pohon","l-shajari",1039],["ٱلْأَخْضَرِ","hijau","l-akhḍari",3043],["نَارًۭا","api","nāran",87],["فَإِذَآ","maka tiba-tiba","fa-idhā",29],["أَنتُم","kamu","antum",96],["مِّنْهُ","dari padanya (kayu itu)","min'hu",1],["تُوقِدُونَ","kamu menyalakan","tūqidūna",1298]],"t":"yaitu (Allah) yang menjadikan api untukmu dari kayu yang hijau, maka seketika itu kamu nyalakan (api) dari kayu itu.\""},{"n":81,"w":[["أَوَلَيْسَ","ataukah bukan","awalaysa",133],["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","menciptakan","khalaqa",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["بِقَـٰدِرٍ","berkuasa","biqādirin",682],["عَلَىٰٓ","atas","ʿalā",11],["أَن","bahwa","an",22],["يَخْلُقَ","menciptakan","yakhluqa",70],["مِثْلَهُم ۚ","serupa mereka itu","mith'lahum",168],["بَلَىٰ","ya/benar","balā",475],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْخَلَّـٰقُ","Maha Pencipta","l-khalāqu",2763],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",77]],"t":"Dan bukankah (Allah) yang menciptakan langit dan bumi, mampu menciptakan kembali yang serupa itu (jasad mereka yang sudah hancur)? Benar, dan Dia Maha Pencipta, Maha Mengetahui."},{"n":82,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",9],["أَمْرُهُۥٓ","urusan-Nya/perintah-Nya","amruhu",75],["إِذَآ","apabila","idhā",29],["أَرَادَ","Dia menghendaki","arāda",92],["شَيْـًٔا","sesuatu","shayan",49],["أَن","bahwa","an",22],["يَقُولَ","Dia berkata","yaqūla",10],["لَهُۥ","kepadanya","lahu",21],["كُن","jadi","kun",12],["فَيَكُونُ","maka jadilah","fayakūnu",12]],"t":"Sesungguhnya urusan-Nya apabila Dia menghendaki sesuatu Dia hanya berkata kepadanya, \"Jadilah!\" Maka jadilah sesuatu itu."},{"n":83,"w":[["فَسُبْحَـٰنَ","maka Maha Suci","fasub'ḥāna",303],["ٱلَّذِى","yang","alladhī",45],["بِيَدِهِۦ","di tangan-Nya","biyadihi",110],["مَلَكُوتُ","kekuasaan","malakūtu",1603],["كُلِّ","segala","kulli",38],["شَىْءٍۢ","sesuatu","shayin",49],["وَإِلَيْهِ","dan kepadaNya","wa-ilayhi",18],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",156]],"t":"Maka Mahasuci (Allah) yang ditangan-Nya kekuasaan atas segala sesuatu dan kepada-Nya kamu dikembalikan."}]