[{"n":1,"w":[["إِذَا","apabila/tatkala","idhā",29],["جَآءَكَ","datang kepadamu","jāaka",51],["ٱلْمُنَـٰفِقُونَ","orang-orang munafik","l-munāfiqūna",371],["قَالُوا۟","mereka berkata","qālū",10],["نَشْهَدُ","kami menyaksikan/mengetahui","nashhadu",278],["إِنَّكَ","sesungguhnya kamu","innaka",9],["لَرَسُولُ","benar-benar Rasul","larasūlu",42],["ٱللَّهِ ۗ","Allah","l-lahi",4],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَعْلَمُ","mengetahui","yaʿlamu",35],["إِنَّكَ","sesungguhnya kamu","innaka",9],["لَرَسُولُهُۥ","benar-benar rasul-Nya","larasūluhu",42],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَشْهَدُ","menyaksikan","yashhadu",278],["إِنَّ","sesungguhnya","inna",9],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",371],["لَكَـٰذِبُونَ","benar-benar pendusta","lakādhibūna",369]],"t":"Apabila orang-orang munafik datang kepadamu (Muhammad), mereka berkata, \"Kami mengakui, bahwa engkau adalah Rasul Allah.\" Dan Allah mengetahui bahwa engkau benar-benar Rasul-Nya; dan Allah menyaksikan bahwa orang-orang munafik itu benar-benar pendusta."},{"n":2,"w":[["ٱتَّخَذُوٓا۟","mereka mengambil/menjadikan","ittakhadhū",107],["أَيْمَـٰنَهُمْ","sumpah mereka","aymānahum",198],["جُنَّةًۭ","tameng/perisai","junnatan",2423],["فَصَدُّوا۟","lalu mereka menghalangi","faṣaddū",332],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ ۚ","Allah","l-lahi",4],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["سَآءَ","amat buruk","sāa",387],["مَا","apa","mā",6],["كَانُوا۟","mereka adalah","kānū",12],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",52]],"t":"Mereka menjadikan sumpah-sumpah mereka sebagai perisai, lalu mereka menghalang-halangi (manusia) dari jalan Allah. Sungguh, betapa buruknya apa yang telah mereka kerjakan."},{"n":3,"w":[["ذَٰلِكَ","demikian itu","dhālika",26],["بِأَنَّهُمْ","karena sesungguhnya mereka","bi-annahum",36],["ءَامَنُوا۟","mereka beriman","āmanū",23],["ثُمَّ","kamudian","thumma",41],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["فَطُبِعَ","lalu dikunci mati","faṭubiʿa",788],["عَلَىٰ","atas","ʿalā",11],["قُلُوبِهِمْ","hati-hati mereka","qulūbihim",98],["فَهُمْ","maka mereka","fahum",16],["لَا","tidak","lā",8],["يَفْقَهُونَ","mengerti","yafqahūna",539]],"t":"Yang demikian itu karena sesungguhnya mereka telah beriman, kemudian menjadi kafir, maka hati mereka dikunci, sehingga mereka tidak dapat mengerti."},{"n":4,"w":[["۞ وَإِذَا","dan apabila","wa-idhā",29],["رَأَيْتَهُمْ","kamu melihat mereka","ra-aytahum",54],["تُعْجِبُكَ","kamu kagum/tertarik","tuʿ'jibuka",774],["أَجْسَامُهُمْ ۖ","tubuh-tubuh mereka","ajsāmuhum",2421],["وَإِن","dan jika","wa-in",19],["يَقُولُوا۟","mereka berkata","yaqūlū",10],["تَسْمَعْ","kamu mendengarkan","tasmaʿ",159],["لِقَوْلِهِمْ ۖ","pada perkataan mereka","liqawlihim",129],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["خُشُبٌۭ","kayu","khushubun",4514],["مُّسَنَّدَةٌۭ ۖ","tersandar","musannadatun",3995],["يَحْسَبُونَ","mereka mengira","yaḥsabūna",280],["كُلَّ","tiap-tiap","kulla",38],["صَيْحَةٍ","teriakan keras","ṣayḥatin",695],["عَلَيْهِمْ ۚ","atas mereka","ʿalayhim",11],["هُمُ","mereka","humu",16],["ٱلْعَدُوُّ","musuh","l-ʿaduwu",248],["فَٱحْذَرْهُمْ ۚ","maka takutlah/waspadalah terhadap mereka","fa-iḥ'dharhum",732],["قَـٰتَلَهُمُ","membunuh/membinasakan mereka","qātalahumu",234],["ٱللَّهُ ۖ","Allah","l-lahu",4],["أَنَّىٰ","bagaimana","annā",401],["يُؤْفَكُونَ","mereka dipalingkan","yu'fakūna",599]],"t":"Dan apabila engkau melihat mereka, tubuh mereka mengagumkanmu. Dan jika mereka berkata, engkau mendengarkan tutur katanya. Mereka seakan-akan kayu yang tersandar. Mereka mengira bahwa setiap teriakan ditujukan kepada mereka. Mereka itulah musuh (yang sebenarnya), maka waspadalah terhadap mereka; semoga Allah membinasakan mereka. Bagaimanakah mereka dapat dipalingkan (dari kebenaran)?"},{"n":5,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["قِيلَ","dikatakan","qīla",10],["لَهُمْ","kepada mereka","lahum",16],["تَعَالَوْا۟","marilah","taʿālaw",967],["يَسْتَغْفِرْ","memohonkan ampunan","yastaghfir",314],["لَكُمْ","bagi kalian","lakum",32],["رَسُولُ","rasul","rasūlu",42],["ٱللَّهِ","Allah","l-lahi",4],["لَوَّوْا۟","mereka memalingkan","lawwaw",3646],["رُءُوسَهُمْ","kepala mereka","ruūsahum",566],["وَرَأَيْتَهُمْ","dan kamu lihat mereka","wara-aytahum",54],["يَصُدُّونَ","mereka berpaling","yaṣuddūna",332],["وَهُم","dan mereka","wahum",16],["مُّسْتَكْبِرُونَ","menyombongkan","mus'takbirūna",1219]],"t":"Dan apabila dikatakan kepada mereka, \"Marilah (beriman), agar Rasulullah memohonkan ampunan bagimu,\" mereka membuang muka dan engkau lihat mereka berpaling dengan menyombongkan diri."},{"n":6,"w":[["سَوَآءٌ","sama saja","sawāon",420],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["أَسْتَغْفَرْتَ","kamu mohonkan ampunan","astaghfarta",314],["لَهُمْ","bagi mereka","lahum",16],["أَمْ","atau","am",93],["لَمْ","tidak","lam",39],["تَسْتَغْفِرْ","kamu mohonkan ampunan","tastaghfir",314],["لَهُمْ","bagi mereka","lahum",16],["لَن","tidak","lan",123],["يَغْفِرَ","akan mengampuni","yaghfira",197],["ٱللَّهُ","Allah","l-lahu",4],["لَهُمْ ۚ","bagi mereka","lahum",16],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَا","tidak","lā",8],["يَهْدِى","memberi petunjuk","yahdī",89],["ٱلْقَوْمَ","kaum","l-qawma",33],["ٱلْفَـٰسِقِينَ","orang-orang yang fasik","l-fāsiqīna",334]],"t":"Sama saja bagi mereka, engkau (Muhammad) mohonkan ampunan untuk mereka atau tidak engkau mohonkan ampunan bagi mereka, Allah tidak akan mengampuni mereka; sesungguhnya Allah tidak akan memberi petunjuk kepada orang-orang yang fasik."},{"n":7,"w":[["هُمُ","mereka","humu",16],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يَقُولُونَ","(mereka) mengatakan","yaqūlūna",10],["لَا","jangan","lā",8],["تُنفِقُوا۟","kamu beri belanja","tunfiqū",193],["عَلَىٰ","atas","ʿalā",11],["مَنْ","orang","man",17],["عِندَ","di sisi","ʿinda",68],["رَسُولِ","Rasul","rasūli",42],["ٱللَّهِ","Allah","l-lahi",4],["حَتَّىٰ","sehingga","ḥattā",91],["يَنفَضُّوا۟ ۗ","mereka bercerai-berai","yanfaḍḍū",2095],["وَلِلَّهِ","dan bagi Allah","walillahi",4],["خَزَآئِنُ","perbendaharaan","khazāinu",1027],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["وَلَـٰكِنَّ","akan tetapi","walākinna",220],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",371],["لَا","tidak","lā",8],["يَفْقَهُونَ","mereka memahami/mengerti","yafqahūna",539]],"t":"Mereka yang berkata (kepada orang-orang Ansar), \"Janganlah kamu bersedekah kepada orang-orang (Muhajirin) yang ada di sisi Rasulullah sampai mereka bubar (meninggalkan Rasulullah).\" Padahal milik Allah lah perbendaharaan langit dan bumi, tetapi orang-orang munafik itu tidak memahami."},{"n":8,"w":[["يَقُولُونَ","mereka berkata","yaqūlūna",10],["لَئِن","sungguh jika","la-in",19],["رَّجَعْنَآ","kita telah kembali","rajaʿnā",156],["إِلَى","ke","ilā",18],["ٱلْمَدِينَةِ","Madinah","l-madīnati",587],["لَيُخْرِجَنَّ","pasti akan mengusir","layukh'rijanna",125],["ٱلْأَعَزُّ","orang-orang mulia/kuat","l-aʿazu",1736],["مِنْهَا","dari padanya","min'hā",1],["ٱلْأَذَلَّ ۚ","orang-orang hina/lemah","l-adhala",2144],["وَلِلَّهِ","dan bagi Allah","walillahi",4],["ٱلْعِزَّةُ","kemuliaan/kekuatan","l-ʿizatu",786],["وَلِرَسُولِهِۦ","dan bagi rasul-Nya","walirasūlihi",42],["وَلِلْمُؤْمِنِينَ","dan bagi orang-orang yang beriman","walil'mu'minīna",63],["وَلَـٰكِنَّ","akan tetapi","walākinna",220],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",371],["لَا","tidak","lā",8],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Mereka berkata, \"Sungguh, jika kita kembali ke Madinah (kembali dari perang Bani Mustalik), pastilah orang yang kuat akan mengusir orang-orang yang lemah dari sana.\" Padahal kekuatan itu hanyalah bagi Allah, Rasul-Nya dan bagi orang-orang mukmin, tetapi orang-orang munafik itu tidak mengetahui."},{"n":9,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["لَا","tidak/jangan","lā",8],["تُلْهِكُمْ","melalaikan kamu","tul'hikum",1493],["أَمْوَٰلُكُمْ","harta-hartamu","amwālukum",141],["وَلَآ","dan jangan","walā",8],["أَوْلَـٰدُكُمْ","anak-anakmu","awlādukum",228],["عَن","dari","ʿan",27],["ذِكْرِ","mengingat","dhik'ri",163],["ٱللَّهِ ۚ","Allah","l-lahi",4],["وَمَن","dan barang siapa","waman",17],["يَفْعَلْ","berbuat","yafʿal",136],["ذَٰلِكَ","demikian","dhālika",26],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",65],["هُمُ","mereka","humu",16],["ٱلْخَـٰسِرُونَ","orang-orang yang rugi","l-khāsirūna",373]],"t":"Wahai orang-orang yang beriman! Janganlah harta bendamu dan anak-anakmu melalaikan kamu dari mengingat Allah. Dan barangsiapa berbuat demikian, maka mereka itulah orang-orang yang rugi."},{"n":10,"w":[["وَأَنفِقُوا۟","dan nafkahkan/belanjakan","wa-anfiqū",193],["مِن","dari","min",1],["مَّا","apa","mā",6],["رَزَقْنَـٰكُم","Kami rizkikan kepadamu","razaqnākum",208],["مِّن","dari","min",1],["قَبْلِ","sebelum","qabli",59],["أَن","bahwa","an",22],["يَأْتِىَ","datang","yatiya",56],["أَحَدَكُمُ","salah satu dari kamu","aḥadakumu",170],["ٱلْمَوْتُ","kematian","l-mawtu",249],["فَيَقُولَ","lalu dia berkata","fayaqūla",10],["رَبِّ","ya Tuhanku","rabbi",15],["لَوْلَآ","mengapa tidak","lawlā",167],["أَخَّرْتَنِىٓ","Engkau akhirkan/undurkan aku","akhartanī",629],["إِلَىٰٓ","sampai","ilā",18],["أَجَلٍۢ","waktu","ajalin",238],["قَرِيبٍۢ","dekat","qarībin",429],["فَأَصَّدَّقَ","maka aku akan bersedekah","fa-aṣṣaddaqa",1250],["وَأَكُن","dan jadilah aku","wa-akun",12],["مِّنَ","dari","mina",1],["ٱلصَّـٰلِحِينَ","orang-orang yang saleh","l-ṣāliḥīna",104]],"t":"Dan infakkanlah sebagian dari apa yang telah Kami berikan kepadamu sebelum kematian datang kepada salah seorang di antara kamu; lalu dia berkata (menyesali), \"Ya Tuhanku, sekiranya Engkau berkenan menunda (kematian)ku sedikit waktu lagi, maka aku dapat bersedekah dan aku akan termasuk orang-orang yang saleh.\""},{"n":11,"w":[["وَلَن","dan tidak","walan",123],["يُؤَخِّرَ","akan mengundurkan","yu-akhira",629],["ٱللَّهُ","Allah","l-lahu",4],["نَفْسًا","seseorang","nafsan",47],["إِذَا","apabila","idhā",29],["جَآءَ","datang","jāa",51],["أَجَلُهَا ۚ","waktunya","ajaluhā",238],["وَٱللَّهُ","dan Allah","wal-lahu",4],["خَبِيرٌۢ","Maha Mengetahui","khabīrun",277],["بِمَا","terhadap apa","bimā",6],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52]],"t":"Dan Allah tidak akan menunda (kematian) seseorang apabila waktu kematiannya telah datang. Dan Allah Mahateliti terhadap apa yang kamu kerjakan."}]