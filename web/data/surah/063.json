[{"n":1,"w":[["إِذَا","apabila/tatkala","idhā",23],["جَآءَكَ","datang kepadamu","jāaka",43],["ٱلْمُنَـٰفِقُونَ","orang-orang munafik","l-munāfiqūna",356],["قَالُوا۟","mereka berkata","qālū",6],["نَشْهَدُ","kami menyaksikan/mengetahui","nashhadu",264],["إِنَّكَ","sesungguhnya kamu","innaka",5],["لَرَسُولُ","benar-benar Rasul","larasūlu",35],["ٱللَّهِ ۗ","Allah","l-lahi",1],["وَٱللَّهُ","dan Allah","wal-lahu",1],["يَعْلَمُ","mengetahui","yaʿlamu",29],["إِنَّكَ","sesungguhnya kamu","innaka",5],["لَرَسُولُهُۥ","benar-benar rasul-Nya","larasūluhu",35],["وَٱللَّهُ","dan Allah","wal-lahu",1],["يَشْهَدُ","menyaksikan","yashhadu",264],["إِنَّ","sesungguhnya","inna",5],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",356],["لَكَـٰذِبُونَ","benar-benar pendusta","lakādhibūna",354]],"t":"Apabila orang-orang munafik datang kepadamu (Muhammad), mereka berkata, \"Kami mengakui, bahwa engkau adalah Rasul Allah.\" Dan Allah mengetahui bahwa engkau benar-benar Rasul-Nya; dan Allah menyaksikan bahwa orang-orang munafik itu benar-benar pendusta."},{"n":2,"w":[["ٱتَّخَذُوٓا۟","mereka mengambil/menjadikan","ittakhadhū",98],["أَيْمَـٰنَهُمْ","sumpah mereka","aymānahum",186],["جُنَّةًۭ","tameng/perisai","junnatan",2409],["فَصَدُّوا۟","lalu mereka menghalangi","faṣaddū",317],["عَن","dari","ʿan",21],["سَبِيلِ","jalan","sabīli",64],["ٱللَّهِ ۚ","Allah","l-lahi",1],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["سَآءَ","amat buruk","sāa",372],["مَا","apa","mā",2],["كَانُوا۟","mereka adalah","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Mereka menjadikan sumpah-sumpah mereka sebagai perisai, lalu mereka menghalang-halangi (manusia) dari jalan Allah. Sungguh, betapa buruknya apa yang telah mereka kerjakan."},{"n":3,"w":[["ذَٰلِكَ","demikian itu","dhālika",19],["بِأَنَّهُمْ","karena sesungguhnya mereka","bi-annahum",30],["ءَامَنُوا۟","mereka beriman","āmanū",18],["ثُمَّ","kamudian","thumma",34],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["فَطُبِعَ","lalu dikunci mati","faṭubiʿa",773],["عَلَىٰ","atas","ʿalā",8],["قُلُوبِهِمْ","hati-hati mereka","qulūbihim",89],["فَهُمْ","maka mereka","fahum",11],["لَا","tidak","lā",4],["يَفْقَهُونَ","mengerti","yafqahūna",525]],"t":"Yang demikian itu karena sesungguhnya mereka telah beriman, kemudian menjadi kafir, maka hati mereka dikunci, sehingga mereka tidak dapat mengerti."},{"n":4,"w":[["۞ وَإِذَا","dan apabila","wa-idhā",23],["رَأَيْتَهُمْ","kamu melihat mereka","ra-aytahum",46],["تُعْجِبُكَ","kamu kagum/tertarik","tuʿ'jibuka",759],["أَجْسَامُهُمْ ۖ","tubuh-tubuh mereka","ajsāmuhum",2407],["وَإِن","dan jika","wa-in",14],["يَقُولُوا۟","mereka berkata","yaqūlū",6],["تَسْمَعْ","kamu mendengarkan","tasmaʿ",148],["لِقَوْلِهِمْ ۖ","pada perkataan mereka","liqawlihim",120],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",380],["خُشُبٌۭ","kayu","khushubun",4508],["مُّسَنَّدَةٌۭ ۖ","tersandar","musannadatun",3988],["يَحْسَبُونَ","mereka mengira","yaḥsabūna",266],["كُلَّ","tiap-tiap","kulla",31],["صَيْحَةٍ","teriakan keras","ṣayḥatin",680],["عَلَيْهِمْ ۚ","atas mereka","ʿalayhim",8],["هُمُ","mereka","humu",11],["ٱلْعَدُوُّ","musuh","l-ʿaduwu",236],["فَٱحْذَرْهُمْ ۚ","maka takutlah/waspadalah terhadap mereka","fa-iḥ'dharhum",717],["قَـٰتَلَهُمُ","membunuh/membinasakan mereka","qātalahumu",222],["ٱللَّهُ ۖ","Allah","l-lahu",1],["أَنَّىٰ","bagaimana","annā",386],["يُؤْفَكُونَ","mereka dipalingkan","yu'fakūna",585]],"t":"Dan apabila engkau melihat mereka, tubuh mereka mengagumkanmu. Dan jika mereka berkata, engkau mendengarkan tutur katanya. Mereka seakan-akan kayu yang tersandar. Mereka mengira bahwa setiap teriakan ditujukan kepada mereka. Mereka itulah musuh (yang sebenarnya), maka waspadalah terhadap mereka; semoga Allah membinasakan mereka. Bagaimanakah mereka dapat dipalingkan (dari kebenaran)?"},{"n":5,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["لَهُمْ","kepada mereka","lahum",11],["تَعَالَوْا۟","marilah","taʿālaw",950],["يَسْتَغْفِرْ","memohonkan ampunan","yastaghfir",299],["لَكُمْ","bagi kalian","lakum",26],["رَسُولُ","rasul","rasūlu",35],["ٱللَّهِ","Allah","l-lahi",1],["لَوَّوْا۟","mereka memalingkan","lawwaw",3636],["رُءُوسَهُمْ","kepala mereka","ruūsahum",552],["وَرَأَيْتَهُمْ","dan kamu lihat mereka","wara-aytahum",46],["يَصُدُّونَ","mereka berpaling","yaṣuddūna",317],["وَهُم","dan mereka","wahum",11],["مُّسْتَكْبِرُونَ","menyombongkan","mus'takbirūna",1202]],"t":"Dan apabila dikatakan kepada mereka, \"Marilah (beriman), agar Rasulullah memohonkan ampunan bagimu,\" mereka membuang muka dan engkau lihat mereka berpaling dengan menyombongkan diri."},{"n":6,"w":[["سَوَآءٌ","sama saja","sawāon",405],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["أَسْتَغْفَرْتَ","kamu mohonkan ampunan","astaghfarta",299],["لَهُمْ","bagi mereka","lahum",11],["أَمْ","atau","am",84],["لَمْ","tidak","lam",32],["تَسْتَغْفِرْ","kamu mohonkan ampunan","tastaghfir",299],["لَهُمْ","bagi mereka","lahum",11],["لَن","tidak","lan",112],["يَغْفِرَ","akan mengampuni","yaghfira",185],["ٱللَّهُ","Allah","l-lahu",1],["لَهُمْ ۚ","bagi mereka","lahum",11],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["لَا","tidak","lā",4],["يَهْدِى","memberi petunjuk","yahdī",80],["ٱلْقَوْمَ","kaum","l-qawma",27],["ٱلْفَـٰسِقِينَ","orang-orang yang fasik","l-fāsiqīna",319]],"t":"Sama saja bagi mereka, engkau (Muhammad) mohonkan ampunan untuk mereka atau tidak engkau mohonkan ampunan bagi mereka, Allah tidak akan mengampuni mereka; sesungguhnya Allah tidak akan memberi petunjuk kepada orang-orang yang fasik."},{"n":7,"w":[["هُمُ","mereka","humu",11],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَقُولُونَ","(mereka) mengatakan","yaqūlūna",6],["لَا","jangan","lā",4],["تُنفِقُوا۟","kamu beri belanja","tunfiqū",182],["عَلَىٰ","atas","ʿalā",8],["مَنْ","orang","man",12],["عِندَ","di sisi","ʿinda",59],["رَسُولِ","Rasul","rasūli",35],["ٱللَّهِ","Allah","l-lahi",1],["حَتَّىٰ","sehingga","ḥattā",82],["يَنفَضُّوا۟ ۗ","mereka bercerai-berai","yanfaḍḍū",2079],["وَلِلَّهِ","dan bagi Allah","walillahi",1],["خَزَآئِنُ","perbendaharaan","khazāinu",1010],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَلَـٰكِنَّ","akan tetapi","walākinna",208],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",356],["لَا","tidak","lā",4],["يَفْقَهُونَ","mereka memahami/mengerti","yafqahūna",525]],"t":"Mereka yang berkata (kepada orang-orang Ansar), \"Janganlah kamu bersedekah kepada orang-orang (Muhajirin) yang ada di sisi Rasulullah sampai mereka bubar (meninggalkan Rasulullah).\" Padahal milik Allah lah perbendaharaan langit dan bumi, tetapi orang-orang munafik itu tidak memahami."},{"n":8,"w":[["يَقُولُونَ","mereka berkata","yaqūlūna",6],["لَئِن","sungguh jika","la-in",14],["رَّجَعْنَآ","kita telah kembali","rajaʿnā",146],["إِلَى","ke","ilā",13],["ٱلْمَدِينَةِ","Madinah","l-madīnati",573],["لَيُخْرِجَنَّ","pasti akan mengusir","layukh'rijanna",114],["ٱلْأَعَزُّ","orang-orang mulia/kuat","l-aʿazu",1713],["مِنْهَا","dari padanya","min'hā",0],["ٱلْأَذَلَّ ۚ","orang-orang hina/lemah","l-adhala",2129],["وَلِلَّهِ","dan bagi Allah","walillahi",1],["ٱلْعِزَّةُ","kemuliaan/kekuatan","l-ʿizatu",771],["وَلِرَسُولِهِۦ","dan bagi rasul-Nya","walirasūlihi",35],["وَلِلْمُؤْمِنِينَ","dan bagi orang-orang yang beriman","walil'mu'minīna",55],["وَلَـٰكِنَّ","akan tetapi","walākinna",208],["ٱلْمُنَـٰفِقِينَ","orang-orang munafik","l-munāfiqīna",356],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Mereka berkata, \"Sungguh, jika kita kembali ke Madinah (kembali dari perang Bani Mustalik), pastilah orang yang kuat akan mengusir orang-orang yang lemah dari sana.\" Padahal kekuatan itu hanyalah bagi Allah, Rasul-Nya dan bagi orang-orang mukmin, tetapi orang-orang munafik itu tidak mengetahui."},{"n":9,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",74],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["لَا","tidak/jangan","lā",4],["تُلْهِكُمْ","melalaikan kamu","tul'hikum",1473],["أَمْوَٰلُكُمْ","harta-hartamu","amwālukum",131],["وَلَآ","dan jangan","walā",4],["أَوْلَـٰدُكُمْ","anak-anakmu","awlādukum",216],["عَن","dari","ʿan",21],["ذِكْرِ","mengingat","dhik'ri",152],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَمَن","dan barang siapa","waman",12],["يَفْعَلْ","berbuat","yafʿal",126],["ذَٰلِكَ","demikian","dhālika",19],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",56],["هُمُ","mereka","humu",11],["ٱلْخَـٰسِرُونَ","orang-orang yang rugi","l-khāsirūna",358]],"t":"Wahai orang-orang yang beriman! Janganlah harta bendamu dan anak-anakmu melalaikan kamu dari mengingat Allah. Dan barangsiapa berbuat demikian, maka mereka itulah orang-orang yang rugi."},{"n":10,"w":[["وَأَنفِقُوا۟","dan nafkahkan/belanjakan","wa-anfiqū",182],["مِن","dari","min",0],["مَّا","apa","mā",2],["رَزَقْنَـٰكُم","Kami rizkikan kepadamu","razaqnākum",196],["مِّن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",17],["يَأْتِىَ","datang","yatiya",48],["أَحَدَكُمُ","salah satu dari kamu","aḥadakumu",159],["ٱلْمَوْتُ","kematian","l-mawtu",237],["فَيَقُولَ","lalu dia berkata","fayaqūla",6],["رَبِّ","ya Tuhanku","rabbi",10],["لَوْلَآ","mengapa tidak","lawlā",156],["أَخَّرْتَنِىٓ","Engkau akhirkan/undurkan aku","akhartanī",615],["إِلَىٰٓ","sampai","ilā",13],["أَجَلٍۢ","waktu","ajalin",226],["قَرِيبٍۢ","dekat","qarībin",414],["فَأَصَّدَّقَ","maka aku akan bersedekah","fa-aṣṣaddaqa",1233],["وَأَكُن","dan jadilah aku","wa-akun",9],["مِّنَ","dari","mina",0],["ٱلصَّـٰلِحِينَ","orang-orang yang saleh","l-ṣāliḥīna",95]],"t":"Dan infakkanlah sebagian dari apa yang telah Kami berikan kepadamu sebelum kematian datang kepada salah seorang di antara kamu; lalu dia berkata (menyesali), \"Ya Tuhanku, sekiranya Engkau berkenan menunda (kematian)ku sedikit waktu lagi, maka aku dapat bersedekah dan aku akan termasuk orang-orang yang saleh.\""},{"n":11,"w":[["وَلَن","dan tidak","walan",112],["يُؤَخِّرَ","akan mengundurkan","yu-akhira",615],["ٱللَّهُ","Allah","l-lahu",1],["نَفْسًا","seseorang","nafsan",39],["إِذَا","apabila","idhā",23],["جَآءَ","datang","jāa",43],["أَجَلُهَا ۚ","waktunya","ajaluhā",226],["وَٱللَّهُ","dan Allah","wal-lahu",1],["خَبِيرٌۢ","Maha Mengetahui","khabīrun",263],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Dan Allah tidak akan menunda (kematian) seseorang apabila waktu kematiannya telah datang. Dan Allah Mahateliti terhadap apa yang kamu kerjakan."}]