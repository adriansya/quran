ustakan (kebenaran)."},{"n":20,"w":[["أَلَمْ","tidaklah/bukankah","alam",32],["نَخْلُقكُّم","Kami menciptakan","nakhluqkkum",62],["مِّن","dari","min",0],["مَّآءٍۢ","air","māin",194],["مَّهِينٍۢ","yang hina","mahīnin",1612]],"t":"Bukankah Kami menciptakan kamu dari air yang hina (mani),"},{"n":21,"w":[["فَجَعَلْنَـٰهُ","lalu Kami jadikannya","fajaʿalnāhu",33],["فِى","dalam","fī",3],["قَرَارٍۢ","tempat","qarārin",927],["مَّكِينٍ","kokoh","makīnin",1614]],"t":"kemudian Kami letakkan ia dalam tempat yang kokoh (rahim),"},{"n":22,"w":[["إِلَىٰ","kepada/sampai","ilā",13],["قَدَرٍۢ","ketentuan/waktu","qadarin",800],["مَّعْلُومٍۢ","ditentukan","maʿlūmin",697]],"t":"sampai waktu yang ditentukan,"},{"n":23,"w":[["فَقَدَرْنَا","lalu Kami tentukan","faqadarnā",434],["فَنِعْمَ","maka sebaik-baik","faniʿ'ma",556],["ٱلْقَـٰدِرُونَ","yang menentukan","l-qādirūna",673]],"t":"lalu Kami tentukan (bentuknya), maka (Kamilah) sebaik-baik yang menentukan."},{"n":24,"w":[["وَيْلٌۭ","kecelakaan","waylun",301],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":25,"w":[["أَلَمْ","tidakkah/bukankah","alam",32],["نَجْعَلِ","Kami menjadikan","najʿali",33],["ٱلْأَرْضَ","bumi","l-arḍa",22],["كِفَاتًا","tempat berkumpul","kifātan",3608]],"t":"Bukankah Kami jadikan bumi untuk (tempat) berkumpul,"},{"n":26,"w":[["أَحْيَآءًۭ","orang-orang yang hidup","aḥyāan",440],["وَأَمْوَٰتًۭا","dan orang-orang yang mati","wa-amwātan",317]],"t":"bagi yang masih hidup dan yang sudah mati?"},{"n":27,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["فِيهَا","padanya","fīhā",3],["رَوَٰسِىَ","gunung-gunung","rawāsiya",859],["شَـٰمِخَـٰتٍۢ","yang tinggi","shāmikhātin",2826],["وَأَسْقَيْنَـٰكُم","dan Kami beri minum kamu","wa-asqaynākum",960],["مَّآءًۭ","air","māan",194],["فُرَاتًۭا","tawar","furātan",1850]],"t":"Dan Kami jadikan padanya gunung-gunung yang