ustakan (kebenaran)."},{"n":20,"w":[["أَلَمْ","tidaklah/bukankah","alam",39],["نَخْلُقكُّم","Kami menciptakan","nakhluqkkum",70],["مِّن","dari","min",1],["مَّآءٍۢ","air","māin",204],["مَّهِينٍۢ","yang hina","mahīnin",1624]],"t":"Bukankah Kami menciptakan kamu dari air yang hina (mani),"},{"n":21,"w":[["فَجَعَلْنَـٰهُ","lalu Kami jadikannya","fajaʿalnāhu",40],["فِى","dalam","fī",7],["قَرَارٍۢ","tempat","qarārin",939],["مَّكِينٍ","kokoh","makīnin",1626]],"t":"kemudian Kami letakkan ia dalam tempat yang kokoh (rahim),"},{"n":22,"w":[["إِلَىٰ","kepada/sampai","ilā",18],["قَدَرٍۢ","ketentuan/waktu","qadarin",810],["مَّعْلُومٍۢ","ditentukan","maʿlūmin",707]],"t":"sampai waktu yang ditentukan,"},{"n":23,"w":[["فَقَدَرْنَا","lalu Kami tentukan","faqadarnā",444],["فَنِعْمَ","maka sebaik-baik","faniʿ'ma",566],["ٱلْقَـٰدِرُونَ","yang menentukan","l-qādirūna",683]],"t":"lalu Kami tentukan (bentuknya), maka (Kamilah) sebaik-baik yang menentukan."},{"n":24,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":25,"w":[["أَلَمْ","tidakkah/bukankah","alam",39],["نَجْعَلِ","Kami menjadikan","najʿali",40],["ٱلْأَرْضَ","bumi","l-arḍa",28],["كِفَاتًا","tempat berkumpul","kifātan",3619]],"t":"Bukankah Kami jadikan bumi untuk (tempat) berkumpul,"},{"n":26,"w":[["أَحْيَآءًۭ","orang-orang yang hidup","aḥyāan",450],["وَأَمْوَٰتًۭا","dan orang-orang yang mati","wa-amwātan",327]],"t":"bagi yang masih hidup dan yang sudah mati?"},{"n":27,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",40],["فِيهَا","padanya","fīhā",7],["رَوَٰسِىَ","gunung-gunung","rawāsiya",870],["شَـٰمِخَـٰتٍۢ","yang tinggi","shāmikhātin",2838],["وَأَسْقَيْنَـٰكُم","dan Kami beri minum kamu","wa-asqaynākum",972],["مَّآءًۭ","air","māan",204],["فُرَاتًۭا","tawar","furātan",1862]],"t":"Dan Kami jadikan padanya gunung-gunung yang