","wafawākiha",1838],["مِمَّا","dari apa","mimmā",0],["يَشْتَهُونَ","mereka inginkan","yashtahūna",1024]],"t":"dan buah-buahan yang mereka sukai."},{"n":43,"w":[["كُلُوا۟","makanlah","kulū",114],["وَٱشْرَبُوا۟","dan minumlah kamu","wa-ish'rabū",615],["هَنِيٓـًٔۢا","dengan senang/sepuas hati","hanīan",1560],["بِمَا","dengan apa/karena apa","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu telah kerjakan","taʿmalūna",44]],"t":"(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\""},{"n":44,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["كَذَٰلِكَ","seperti demikian","kadhālika",19],["نَجْزِى","Kami memberi balasan","najzī",159],["ٱلْمُحْسِنِينَ","orang-orang yang berbuat baik","l-muḥ'sinīna",309]],"t":"Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."},{"n":45,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":46,"w":[["كُلُوا۟","makanlah","kulū",114],["وَتَمَتَّعُوا۟","dan bersenang-senanglah kamu","watamattaʿū",805],["قَلِيلًا","sedikit/sebentar","qalīlan",173],["إِنَّكُم","sesungguhnya kalian","innakum",5],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",229]],"t":"(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\""},{"n":47,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":48,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["لَهُمُ","kepada mereka","lahumu",11],["ٱرْكَعُوا۟","tunduklah","ir'kaʿū",1440],["لَا","tidak","lā",4],["يَرْكَعُونَ","mereka tunduk","yarkaʿūna",1440]],"t":"Dan apabila dikatakan kepada mereka, \"Rukuklah,\" mereka tidak mau rukuk."},{"n":49,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)!"},{"n":50,"w":[["فَبِأَىِّ","maka yang manakah","fabi-ayyi",201],["حَدِيثٍۭ","perkataan","ḥadīthin",386],["بَعْدَهُۥ","sesudahnya (Al Qur'an)","baʿdahu",58],["يُؤْمِنُونَ","mereka akan beriman","yu'minūna",18]],"t":"Maka kepada ajaran manakah (selain Alquran) ini mereka akan beriman?"}]