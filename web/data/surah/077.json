":35,"w":[["هَـٰذَا","ini","hādhā",56],["يَوْمُ","hari","yawmu",25],["لَا","tidak","lā",4],["يَنطِقُونَ","mereka dapat bicara","yanṭiqūna",923]],"t":"Inilah hari, saat mereka tidak dapat berbicara,"},{"n":36,"w":[["وَلَا","dan tidak","walā",4],["يُؤْذَنُ","diizinkan","yu'dhanu",451],["لَهُمْ","bagi mereka","lahum",11],["فَيَعْتَذِرُونَ","maka/sehingga mereka minta uzur","fayaʿtadhirūna",1446]],"t":"dan tidak diizinkan kepada mereka mengemukakan alasan agar mereka dimaafkan."},{"n":37,"w":[["وَيْلٌۭ","kecelakaan","waylun",301],["يَوْمَئِذٍۢ","pada hari ini","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":38,"w":[["هَـٰذَا","ini","hādhā",56],["يَوْمُ","hari","yawmu",25],["ٱلْفَصْلِ ۖ","keputusan","l-faṣli",905],["جَمَعْنَـٰكُمْ","Kami mengumpulkan kamu","jamaʿnākum",469],["وَٱلْأَوَّلِينَ","dan orang-orang terdahulu","wal-awalīna",142]],"t":"Inilah hari keputusan; (pada hari ini) Kami kumpulkan kamu dan orang-orang yang terdahulu."},{"n":39,"w":[["فَإِن","maka jika","fa-in",14],["كَانَ","adalah","kāna",8],["لَكُمْ","bagi kalian","lakum",26],["كَيْدٌۭ","tipu daya","kaydun",417],["فَكِيدُونِ","maka tipu dayalah Aku","fakīdūni",358]],"t":"Maka jika kamu punya tipu daya, maka lakukanlah (tipu daya) itu terhadap-Ku."},{"n":40,"w":[["وَيْلٌۭ","kecelakaan","waylun",301],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":41,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",247],["فِى","dalam","fī",3],["ظِلَـٰلٍۢ","naungan","ẓilālin",661],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",208]],"t":"Sungguh, orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (di sekitar) mata air,"},{"n":42,"w":[["وَفَوَٰكِهَ","dan buah-buahan","wafawākiha",663],["مِمَّا","dari apa","mimmā",0],["يَشْتَهُونَ","mereka inginkan","yashtahūna",1020]],"t":"dan buah-buahan yang mereka sukai."},{"n":43,"w":[["كُلُوا۟","makanlah","kulū",118],["وَٱشْرَبُوا۟","dan minumlah kamu","wa-ish'rabū",616],["هَنِيٓـًٔۢا","dengan senang/sepuas hati","hanīan",1568],["بِمَا","dengan apa/karena apa","bimā",2],["كُنتُمْ","kalian adalah","kuntum",8],["تَعْمَلُونَ","kamu telah kerjakan","taʿmalūna",44]],"t":"(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\""},{"n":44,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["كَذَٰلِكَ","seperti demikian","kadhālika",20],["نَجْزِى","Kami memberi balasan","najzī",165],["ٱلْمُحْسِنِينَ","orang-orang yang berbuat baik","l-muḥ'sinīna",311]],"t":"Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."},{"n":45,"w":[["وَيْلٌۭ","kecelakaan","waylun",301],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":46,"w":[["كُلُوا۟","makanlah","kulū",118],["وَتَمَتَّعُوا۟","dan bersenang-senanglah kamu","watamattaʿū",806],["قَلِيلًا","sedikit/sebentar","qalīlan",176],["إِنَّكُم","sesungguhnya kalian","innakum",5],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",230]],"t":"(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\""},{"n":47,"w":[["وَيْلٌۭ","kecelakaan","waylun",301],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",495]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":48,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["لَهُمُ","kepada mereka","lahumu",11],["ٱرْكَعُوا۟","tunduklah","ir'kaʿū",1407],["لَا","tidak","lā",4],["يَرْكَعُونَ","