ila","wa-idhā",23],["ٱلرُّسُلُ","rasul-rasul","l-rusulu",35],["أُقِّتَتْ","ditetapkan waktunya","uqqitat",3072]],"t":"dan apabila rasul-rasul telah ditetapkan waktunya."},{"n":12,"w":[["لِأَىِّ","untuk manakah","li-ayyi",201],["يَوْمٍ","hari","yawmin",25],["أُجِّلَتْ","ditentukan/ditangguhkan","ujjilat",2175]],"t":"(Niscaya dikatakan kepada mereka), \"Sampai hari apakah ditangguhkan (azab orang-orang kafir itu)?\""},{"n":13,"w":[["لِيَوْمِ","untuk/sampai hari","liyawmi",25],["ٱلْفَصْلِ","keputusan","l-faṣli",901]],"t":"Sampai hari keputusan."},{"n":14,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","tahukah kamu","adrāka",564],["مَا","apakah","mā",2],["يَوْمُ","hari","yawmu",25],["ٱلْفَصْلِ","keputusan","l-faṣli",901]],"t":"Dan tahukah kamu apakah hari keputusan itu?"},{"n":15,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":16,"w":[["أَلَمْ","tidaklah/bukanlah","alam",32],["نُهْلِكِ","Kami telah membinasakan","nuh'liki",232],["ٱلْأَوَّلِينَ","orang-orang yang dahulu","l-awalīna",136]],"t":"Bukankah telah Kami binasakan orang-orang yang dahulu?"},{"n":17,"w":[["ثُمَّ","kemudian","thumma",34],["نُتْبِعُهُمُ","Kami ikutkan/iringi mereka","nut'biʿuhumu",618],["ٱلْـَٔاخِرِينَ","orang-orang yang kemudian","l-ākhirīna",72]],"t":"Lalu Kami susulkan (azab Kami terhadap) orang-orang yang datang kemudian."},{"n":18,"w":[["كَذَٰلِكَ","seperti demikianlah","kadhālika",19],["نَفْعَلُ","Kami berbuat","nafʿalu",121],["بِٱلْمُجْرِمِينَ","terhadap orang-orang berdosa","bil-muj'rimīna",229]],"t":"Demikianlah Kami perlakukan orang-orang yang berdosa."},{"n":19,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi mereka yang men