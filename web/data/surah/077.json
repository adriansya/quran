n":35,"w":[["هَـٰذَا","ini","hādhā",64],["يَوْمُ","hari","yawmu",31],["لَا","tidak","lā",8],["يَنطِقُونَ","mereka dapat bicara","yanṭiqūna",935]],"t":"Inilah hari, saat mereka tidak dapat berbicara,"},{"n":36,"w":[["وَلَا","dan tidak","walā",8],["يُؤْذَنُ","diizinkan","yu'dhanu",461],["لَهُمْ","bagi mereka","lahum",16],["فَيَعْتَذِرُونَ","maka/sehingga mereka minta uzur","fayaʿtadhirūna",1458]],"t":"dan tidak diizinkan kepada mereka mengemukakan alasan agar mereka dimaafkan."},{"n":37,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari ini","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":38,"w":[["هَـٰذَا","ini","hādhā",64],["يَوْمُ","hari","yawmu",31],["ٱلْفَصْلِ ۖ","keputusan","l-faṣli",917],["جَمَعْنَـٰكُمْ","Kami mengumpulkan kamu","jamaʿnākum",479],["وَٱلْأَوَّلِينَ","dan orang-orang terdahulu","wal-awalīna",151]],"t":"Inilah hari keputusan; (pada hari ini) Kami kumpulkan kamu dan orang-orang yang terdahulu."},{"n":39,"w":[["فَإِن","maka jika","fa-in",19],["كَانَ","adalah","kāna",12],["لَكُمْ","bagi kalian","lakum",32],["كَيْدٌۭ","tipu daya","kaydun",427],["فَكِيدُونِ","maka tipu dayalah Aku","fakīdūni",368]],"t":"Maka jika kamu punya tipu daya, maka lakukanlah (tipu daya) itu terhadap-Ku."},{"n":40,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":41,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",257],["فِى","dalam","fī",7],["ظِلَـٰلٍۢ","naungan","ẓilālin",671],["وَعُيُونٍۢ","dan mata air","waʿuyūnin",218]],"t":"Sungguh, orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (di sekitar) mata air,"},{"n":42,"w":[["وَفَوَٰكِهَ","dan buah-buahan","wafawākiha",673],["مِمَّا","dari apa","mimmā",1],["يَشْتَهُونَ","mereka inginkan","yashtahūna",1032]],"t":"dan buah-buahan yang mereka sukai."},{"n":43,"w":[["كُلُوا۟","makanlah","kulū",127],["وَٱشْرَبُوا۟","dan minumlah kamu","wa-ish'rabū",626],["هَنِيٓـًٔۢا","dengan senang/sepuas hati","hanīan",1580],["بِمَا","dengan apa/karena apa","bimā",6],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْمَلُونَ","kamu telah kerjakan","taʿmalūna",52]],"t":"(Katakan kepada mereka), \"Makan dan minumlah dengan rasa nikmat sebagai balasan dari apa yang telah kamu kerjakan.\""},{"n":44,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["كَذَٰلِكَ","seperti demikian","kadhālika",26],["نَجْزِى","Kami memberi balasan","najzī",175],["ٱلْمُحْسِنِينَ","orang-orang yang berbuat baik","l-muḥ'sinīna",321]],"t":"Sungguh, demikianlah Kami memberi balasan kepada orang-orang yang berbuat baik."},{"n":45,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":46,"w":[["كُلُوا۟","makanlah","kulū",127],["وَتَمَتَّعُوا۟","dan bersenang-senanglah kamu","watamattaʿū",816],["قَلِيلًا","sedikit/sebentar","qalīlan",186],["إِنَّكُم","sesungguhnya kalian","innakum",9],["مُّجْرِمُونَ","orang-orang yang berdosa","muj'rimūna",240]],"t":"(Katakan kepada orang-orang kafir), \"Makan dan bersenang-senanglah kamu (di dunia) sebentar, sesungguhnya kamu orang-orang durhaka!\""},{"n":47,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)."},{"n":48,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["قِيلَ","dikatakan","qīla",10],["لَهُمُ","kepada mereka","lahumu",16],["ٱرْكَعُوا۟","tunduklah","ir'kaʿū",1419],["لَا","tidak","lā",8],["يَرْكَعُونَ","mereka tunduk","yarkaʿūna",1419]],"t":"Dan apabila dikatakan kepada mereka, \"Rukuklah,\" mereka tidak mau rukuk."},{"n":49,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",505]],"t":"Celakalah pada hari itu, bagi mereka yang mendustakan (kebenaran)!"},{"n":50,"w":[["فَبِأَىِّ","maka yang manakah","fabi-ayyi",210],["حَدِيثٍۭ","perkataan","ḥadīthin",402],["بَعْدَهُۥ","sesudahnya (Al Qur'an)","baʿdahu",67],["يُؤْمِنُونَ","mereka akan beriman","yu'minūna",23]],"t":"Maka kepada ajaran manakah (selain Alquran) ini mereka akan beriman?"}]