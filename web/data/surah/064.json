[{"n":1,"w":[["يُسَبِّحُ","bertasbih","yusabbiḥu",283],["لِلَّهِ","kepada Allah","lillahi",1],["مَا","apa","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَمَا","dan apa","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",22],["لَهُ","bagi-Nya","lahu",16],["ٱلْمُلْكُ","kerajaan","l-mul'ku",252],["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْحَمْدُ ۖ","puji-pujian","l-ḥamdu",276],["وَهُوَ","dan Dia","wahuwa",19],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌ","Maha Kuasa","qadīrun",265]],"t":"Apa yang ada di langit dan apa yang ada di bumi senantiasa bertasbih kepada Allah; milik-Nya semua kerajaan dan bagi-Nya (pula) segala puji; dan Dia Mahakuasa atas segala sesuatu."},{"n":2,"w":[["هُوَ","Dia","huwa",19],["ٱلَّذِى","yang","alladhī",38],["خَلَقَكُمْ","menciptakan kalian","khalaqakum",62],["فَمِنكُمْ","maka diantara kamu","faminkum",0],["كَافِرٌۭ","kafir","kāfirun",71],["وَمِنكُم","dan antara kamu","waminkum",0],["مُّؤْمِنٌۭ ۚ","orang yang beriman","mu'minun",55],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["بَصِيرٌ","Maha Melihat","baṣīrun",234]],"t":"Dialah yang menciptakan kamu, lalu di antara kamu ada yang kafir dan di antara kamu (juga) ada yang mukmin. Dan Allah Maha Melihat apa yang kamu kerjakan."},{"n":3,"w":[["خَلَقَ","Dia menciptakan","khalaqa",62],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["بِٱلْحَقِّ","dengan benar/hak","bil-ḥaqi",50],["وَصَوَّرَكُمْ","dan Dia membentuk rupa kamu","waṣawwarakum",1534],["فَأَحْسَنَ","lalu Dia membaguskan","fa-aḥsana",486],["صُوَرَكُمْ ۖ","bentuk rupa kamu","ṣuwarakum",1811],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",394]],"t":"Dia menciptakan langit dan bumi dengan (tujuan) yang benar, Dia membentuk rupamu lalu memperbagus rupamu, dan kepada-Nya tempat kembali."},{"n":4,"w":[["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["مَا","apa","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",37],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَيَعْلَمُ","dan Dia mengetahui","wayaʿlamu",29],["مَا","apa","mā",2],["تُسِرُّونَ","kamu rahasiakan","tusirrūna",544],["وَمَا","dan apa","wamā",2],["تُعْلِنُونَ ۚ","kamu nyatakan","tuʿ'linūna",714],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",69],["بِذَاتِ","dengan yang ada","bidhāti",117],["ٱلصُّدُورِ","dada","l-ṣudūri",271]],"t":"Dia mengetahui apa yang ada di langit dan di bumi, dan mengetahui apa yang kamu rahasiakan dan apa yang kamu nyatakan. Dan Allah Maha Mengetahui segala isi hati."},{"n":5,"w":[["أَلَمْ","apakah tidak/belum","alam",32],["يَأْتِكُمْ","datang kepadamu","yatikum",48],["نَبَؤُا۟","berita","naba-u",386],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِن","dari","min",0],["قَبْلُ","sebelum/dahulu","qablu",51],["فَذَاقُوا۟","maka mereka merasakan","fadhāqū",329],["وَبَالَ","akibat buruk","wabāla",1681],["أَمْرِهِمْ","urusan/perbuatan mereka","amrihim",67],["وَلَهُمْ","dan bagi mereka","walahum",11],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",168]],"t":"Apakah belum sampai kepadamu (orang-orang kafir) berita orang-orang kafir dahulu? Maka mereka telah merasakan akibat buruk dari perbuatannya dan mereka memperoleh azab yang pedih."},{"n":6,"w":[["ذَٰلِكَ","demikian itu","dhālika",20],["بِأَنَّهُۥ","karena sesungguhnya","bi-annahu",30],["كَانَت","adalah","kānat",8],["تَّأْتِيهِمْ","datang kepada mereka","tatīhim",48],["رُسُلُهُم","rasul-rasul mereka","rusuluhum",35],["بِٱلْبَيِّنَـٰتِ","dengan keterangan-keterangan","bil-bayināti",175],["فَقَالُوٓا۟","lalu mereka berkata","faqālū",6],["أَبَشَرٌۭ","apakah manusia","abasharun",323],["يَهْدُونَنَا","memberi petunjuk kepada kami","yahdūnanā",81],["فَكَفَرُوا۟","lalu mereka ingkar","fakafarū",40],["وَتَوَلَّوا۟ ۚ","dan mereka berpaling","watawallaw",150],["وَّٱسْتَغْنَى","dan mencukupi/tidak memerlukan","wa-is'taghnā",1704],["ٱللَّهُ ۚ","Allah","l-lahu",1],["وَٱللَّهُ","dan Allah","wal-lahu",1],["غَنِىٌّ","Maha Kaya","ghaniyyun",443],["حَمِيدٌۭ","Maha Terpuji","ḥamīdun",568]],"t":"Yang demikian itu karena sesungguhnya ketika rasul-rasul datang kepada mereka membawa keterangan-keterangan, lalu mereka berkata, \"Apakah (pantas) manusia yang memberi petunjuk kepada kami?\" Lalu mereka ingkar dan berpaling; padahal Allah tidak memerlukan (mereka). Dan Allah Mahakaya, Maha Terpuji."},{"n":7,"w":[["زَعَمَ","mengira","zaʿama",708],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوٓا۟","kafir/ingkar","kafarū",40],["أَن","bahwa","an",17],["لَّن","tidak","lan",113],["يُبْعَثُوا۟ ۚ","mereka dibangkitkan","yub'ʿathū",229],["قُلْ","katakan","qul",6],["بَلَىٰ","bahkan/tidak demikian","balā",466],["وَرَبِّى","demi Tuhanku","warabbī",10],["لَتُبْعَثُنَّ","sungguh kamu akan dibangkitkan","latub'ʿathunna",229],["ثُمَّ","kemudian","thumma",34],["لَتُنَبَّؤُنَّ","sungguh kamu akan diberitahukan","latunabba-unna",260],["بِمَا","terhadap apa","bimā",2],["عَمِلْتُمْ ۚ","kamu kerjakan","ʿamil'tum",44],["وَذَٰلِكَ","dan demikian itu","wadhālika",20],["عَلَى","atas","ʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["يَسِيرٌۭ","mudah","yasīrun",643]],"t":"Orang-orang yang kafir mengira, bahwa mereka tidak akan dibangkitkan. Katakanlah (Muhammad), \"Tidak demikian, demi Tuhanku, kamu pasti dibangkitkan, kemudian diberitakan semua yang telah kamu kerjakan.\" Dan yang demikian itu mudah bagi Allah."},{"n":8,"w":[["فَـَٔامِنُوا۟","maka berimanlah kamu","faāminū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ","dan rasul-Nya","warasūlihi",35],["وَٱلنُّورِ","dan cahaya","wal-nūri",278],["ٱلَّذِىٓ","yang","alladhī",38],["أَنزَلْنَا ۚ","Kami turunkan","anzalnā",63],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",267]],"t":"Maka berimanlah kamu kepada Allah dan Rasul-Nya dan kepada cahaya (Alquran) yang telah Kami turunkan. Dan Allah Mahateliti terhadap apa yang kamu kerjakan."},{"n":9,"w":[["يَوْمَ","hari","yawma",25],["يَجْمَعُكُمْ","Dia mengumpulkan kamu","yajmaʿukum",469],["لِيَوْمِ","di hari","liyawmi",25],["ٱلْجَمْعِ ۖ","pengumpulan","l-jamʿi",692],["ذَٰلِكَ","demikian itu","dhālika",20],["يَوْمُ","hari","yawmu",25],["ٱلتَّغَابُنِ ۗ","dinampakkan kesalahan-kesalahan","l-taghābuni",4427],["وَمَن","dan barangsiapa","waman",12],["يُؤْمِنۢ","beriman","yu'min",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَيَعْمَلْ","dan berbuat/beramal","wayaʿmal",44],["صَـٰلِحًۭا","kebaikan/saleh","ṣāliḥan",96],["يُكَفِّرْ","dan akan menutup/menghapus","yukaffir",666],["عَنْهُ","dari padanya","ʿanhu",21],["سَيِّـَٔاتِهِۦ","kesalahan-kesalahannya","sayyiātihi",207],["وَيُدْخِلْهُ","dan Dia akan memasukkannya","wayud'khil'hu",279],["جَنَّـٰتٍۢ","sorga","jannātin",78],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",236],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",223],["خَـٰلِدِينَ","mereka kekal","khālidīna",163],["فِيهَآ","di dalamnya","fīhā",3],["أَبَدًۭا ۚ","selama-lamanya","abadan",390],["ذَٰلِكَ","demikan itu","dhālika",20],["ٱلْفَوْزُ","keuntungan","l-fawzu",531],["ٱلْعَظِيمُ","yang besar","l-ʿaẓīmu",101]],"t":"(Ingatlah) pada hari (ketika) Allah mengumpulkan kamu pada hari berhimpun, itulah hari pengungkapan kesalahan-kesalahan. Dan barangsiapa beriman kepada Allah dan mengerjakan kebajikan niscaya Allah akan menghapus kesalahan-kesalahannya dan memasukkannya ke dalam surga yang mengalir di bawahnya sungai-sungai, mereka kekal di dalamnya selama-lamanya. Itulah kemenangan yang agung."},{"n":10,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَكَذَّبُوا۟","dan mereka mendustakan","wakadhabū",64],["بِـَٔايَـٰتِنَآ","pada ayat-ayat Kami","biāyātinā",28],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",57],["أَصْحَـٰبُ","penghuni","aṣḥābu",123],["ٱلنَّارِ","api/neraka","l-nāri",79],["خَـٰلِدِينَ","mereka kekal","khālidīna",163],["فِيهَا ۖ","di dalamnya","fīhā",3],["وَبِئْسَ","dan seburuk-buruk","wabi'sa",297],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",394]],"t":"Dan orang-orang yang kafir dan mendustakan ayat-ayat Kami, mereka itulah penghuni neraka, mereka kekal di dalamnya. Dan itulah seburuk-buruk tempat kembali."},{"n":11,"w":[["مَآ","tidak","mā",2],["أَصَابَ","menimpa","aṣāba",191],["مِن","dari","min",0],["مُّصِيبَةٍ","musibah","muṣībatin",853],["إِلَّا","kecuali","illā",15],["بِإِذْنِ","dengan izin","bi-idh'ni",306],["ٱللَّهِ ۗ","Allah","l-lahi",1],["وَمَن","dan barangsiapa","waman",12],["يُؤْمِنۢ","beriman","yu'min",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["يَهْدِ","Dia memberi petunjuk","yahdi",81],["قَلْبَهُۥ ۚ","hatinya","qalbahu",90],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",69]],"t":"Tidak ada suatu musibah yang menimpa (seseorang), kecuali dengan izin Allah; dan barangsiapa beriman kepada Allah, niscaya Allah akan memberi petunjuk kepada hatinya. Dan Allah Maha Mengetahui segala sesuatu."},{"n":12,"w":[["وَأَطِيعُوا۟","dan taatlah","wa-aṭīʿū",167],["ٱللَّهَ","Allah","l-laha",1],["وَأَطِيعُوا۟","dan taatlah","wa-aṭīʿū",167],["ٱلرَّسُولَ ۚ","rasul","l-rasūla",35],["فَإِن","maka sesungguhnya hanyalah","fa-in",14],["تَوَلَّيْتُمْ","kamu berpaling","tawallaytum",150],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",5],["عَلَىٰ","atas","ʿalā",7],["رَسُولِنَا","rasul Kami","rasūlinā",35],["ٱلْبَلَـٰغُ","penyampaian","l-balāghu",628],["ٱلْمُبِينُ","terang/nyata","l-mubīnu",103]],"t":"Dan taatlah kepada Allah dan taatlah kepada Rasul. Jika kamu berpaling maka sesungguhnya kewajiban Rasul Kami hanyalah menyampaikan (amanah Allah) dengan terang."},{"n":13,"w":[["ٱللَّهُ","Allah","al-lahu",1],["لَآ","tidak","lā",4],["إِلَـٰهَ","Tuhan","ilāha",76],["إِلَّا","kecuali","illā",15],["هُوَ ۚ","Dia","huwa",19],["وَعَلَى","dan atas/kepada","waʿalā",7],["ٱللَّهِ","Allah","l-lahi",1],["فَلْيَتَوَكَّلِ","maka hendaklah bertawakkal","falyatawakkali",299],["ٱلْمُؤْمِنُونَ","orang-orang yang beriman","l-mu'minūna",55]],"t":"(Dialah) Allah, tidak ada tuhan selain Dia. Dan hendaklah orang-orang mukmin bertawakal kepada Allah."},{"n":14,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",75],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِنَّ","sesungguhnya","inna",5],["مِنْ","dari","min",0],["أَزْوَٰجِكُمْ","isteri-isterimu","azwājikum",156],["وَأَوْلَـٰدِكُمْ","dan anak-anakmu","wa-awlādikum",218],["عَدُوًّۭا","musuh","ʿaduwwan",238],["لَّكُمْ","bagi kalian","lakum",26],["فَٱحْذَرُوهُمْ ۚ","maka berhati-hatilah kepada mereka","fa-iḥ'dharūhum",723],["وَإِن","dan jika","wa-in",14],["تَعْفُوا۟","kamu memaafkan","taʿfū",402],["وَتَصْفَحُوا۟","dan kamu berhati lapang","wataṣfaḥū",1162],["وَتَغْفِرُوا۟","dan kamu mengampuni","wataghfirū",187],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["غَفُورٌۭ","Maha Pengampun","ghafūrun",122],["رَّحِيمٌ","Maha Penyayang","raḥīmun",104]],"t":"Wahai orang-orang yang beriman! Sesungguhnya di antara istri-istrimu dan anak-anakmu ada yang menjadi musuh bagimu, maka berhati-hatilah kamu terhadap mereka; dan jika kamu maafkan dan kamu santuni serta ampuni (mereka), maka sungguh, Allah Maha Pengampun, Maha Penyayang."},{"n":15,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَمْوَٰلُكُمْ","hartamu","amwālukum",132],["وَأَوْلَـٰدُكُمْ","dan anak-anakmu","wa-awlādukum",218],["فِتْنَةٌۭ ۚ","fitnah/ujian","fit'natun",345],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عِندَهُۥٓ","disisi-Nya","ʿindahu",60],["أَجْرٌ","pahala","ajrun",111],["عَظِيمٌۭ","besar","ʿaẓīmun",101]],"t":"Sesungguhnya hartamu dan anak-anakmu hanyalah cobaan (bagimu), dan di sisi Allah pahala yang besar."},{"n":16,"w":[["فَٱتَّقُوا۟","maka bertakwalah kamu","fa-ittaqū",68],["ٱللَّهَ","Allah","l-laha",1],["مَا","apa","mā",2],["ٱسْتَطَعْتُمْ","menurut kesanggupanmu","is'taṭaʿtum",286],["وَٱسْمَعُوا۟","dan dengarlah","wa-is'maʿū",149],["وَأَطِيعُوا۟","dan taatlah","wa-aṭīʿū",167],["وَأَنفِقُوا۟","dan belanjakan","wa-anfiqū",183],["خَيْرًۭا","baik","khayran",61],["لِّأَنفُسِكُمْ ۗ","bagi dirimu","li-anfusikum",39],["وَمَن","dan barang siapa","waman",12],["يُوقَ","dipelihara","yūqa",610],["شُحَّ","kekikiran","shuḥḥa",1268],["نَفْسِهِۦ","dirinya","nafsihi",39],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",57],["هُمُ","mereka","humu",11],["ٱلْمُفْلِحُونَ","orang-orang yang beruntung","l-muf'liḥūna",696]],"t":"Maka bertakwalah kamu kepada Allah menurut kesanggupanmu dan dengarlah serta taatlah; dan infakkanlah harta yang baik untuk dirimu. Dan barangsiapa dijaga dirinya dari kekikiran, mereka itulah orang-orang yang beruntung."},{"n":17,"w":[["إِن","jika","in",14],["تُقْرِضُوا۟","kamu memberi pinjaman","tuq'riḍū",1136],["ٱللَّهَ","Allah","l-laha",1],["قَرْضًا","pinjaman","qarḍan",1225],["حَسَنًۭا","baik","ḥasanan",488],["يُضَـٰعِفْهُ","Dia melipat gandakannya","yuḍāʿif'hu",886],["لَكُمْ","bagi kalian","lakum",26],["وَيَغْفِرْ","dan Dia mengampuni","wayaghfir",187],["لَكُمْ ۚ","bagi kalian","lakum",26],["وَٱللَّهُ","dan Allah","wal-lahu",1],["شَكُورٌ","Maha Mensyukuri","shakūrun",813],["حَلِيمٌ","Maha Penyantun","ḥalīmun",622]],"t":"Jika kamu meminjamkan kepada Allah dengan pinjaman yang baik, niscaya Dia melipatgandakan (balasan) untukmu dan mengampuni kamu. Dan Allah Maha Mensyukuri, Maha Penyantun."},{"n":18,"w":[["عَـٰلِمُ","Yang Mengetahui","ʿālimu",548],["ٱلْغَيْبِ","yang gaib","l-ghaybi",244],["وَٱلشَّهَـٰدَةِ","dan yang nyata","wal-shahādati",412],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",116]],"t":"Yang Mengetahui yang gaib dan yang nyata. Yang Mahaperkasa, Mahabijaksana."}]