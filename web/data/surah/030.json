[{"n":1,"w":[["الٓمٓ","Alif laam miim","alif-lam-meem",1155]],"t":"Alif Lām Mīm."},{"n":2,"w":[["غُلِبَتِ","Telah dikalahkan","ghulibati",625],["ٱلرُّومُ","bangsa Romawi","l-rūmu",4214]],"t":"Bangsa Romawi telah dikalahkan,"},{"n":3,"w":[["فِىٓ","di","fī",3],["أَدْنَى","dekat","adnā",711],["ٱلْأَرْضِ","bumi/negeri","l-arḍi",22],["وَهُم","dan mereka","wahum",11],["مِّنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["غَلَبِهِمْ","kekalahan mereka","ghalabihim",3474],["سَيَغْلِبُونَ","mereka akan mengalahkan","sayaghlibūna",625]],"t":"di negeri yang terdekat dan mereka setelah kekalahannya itu akan menang,"},{"n":4,"w":[["فِى","dalam","fī",3],["بِضْعِ","beberapa","biḍ'ʿi",2335],["سِنِينَ ۗ","tahun","sinīna",531],["لِلَّهِ","bagi Allah","lillahi",1],["ٱلْأَمْرُ","urusan","l-amru",66],["مِن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["وَمِنۢ","dan dari","wamin",0],["بَعْدُ ۚ","sesudah","baʿdu",58],["وَيَوْمَئِذٍۢ","dan pada hari itu","wayawma-idhin",180],["يَفْرَحُ","bergembira","yafraḥu",591],["ٱلْمُؤْمِنُونَ","orang-orang yang beriman","l-mu'minūna",55]],"t":"dalam beberapa tahun (lagi). Bagi Allah lah urusan sebelum dan setelah (mereka menang). Dan pada hari (kemenangan bangsa Romawi) itu bergembiralah orang-orang yang beriman,"},{"n":5,"w":[["بِنَصْرِ","dengan pertolongan","binaṣri",468],["ٱللَّهِ ۚ","Allah","l-lahi",1],["يَنصُرُ","Dia menolong","yanṣuru",200],["مَن","siapa","man",12],["يَشَآءُ ۖ","Dia kehendaki","yashāu",54],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",113],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",103]],"t":"karena pertolongan Allah. Dia menolong siapa yang Dia kehendaki. Dia Mahaperkasa, Maha Penyayang."},{"n":6,"w":[["وَعْدَ","janji","waʿda",246],["ٱللَّهِ ۖ","Allah","l-lahi",1],["لَا","tidak","lā",4],["يُخْلِفُ","menyalahi","yukh'lifu",647],["ٱللَّهُ","Allah","l-lahu",1],["وَعْدَهُۥ","janji-nya","waʿdahu",246],["وَلَـٰكِنَّ","tetapi","walākinna",208],["أَكْثَرَ","kebanyakan","akthara",145],["ٱلنَّاسِ","manusia","l-nāsi",52],["لَا","tidak","lā",4],["يَعْلَمُونَ","mengetahui","yaʿlamūna",29]],"t":"(Itulah) janji Allah. Allah tidak akan menyalahi janji-Nya, tetapi kebanyakan manusia tidak mengetahui."},{"n":7,"w":[["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29],["ظَـٰهِرًۭا","yang lahir","ẓāhiran",827],["مِّنَ","dari","mina",0],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",153],["ٱلدُّنْيَا","dunia","l-dun'yā",104],["وَهُمْ","dan mereka","wahum",11],["عَنِ","dari/terhadap","ʿani",21],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",73],["هُمْ","mereka","hum",11],["غَـٰفِلُونَ","orang-orang yang lalai","ghāfilūna",388]],"t":"Mereka mengetahui yang lahir (tampak) dari kehidupan dunia; sedangkan terhadap (kehidupan) akhirat mereka lalai."},{"n":8,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَتَفَكَّرُوا۟","mereka memikirkan","yatafakkarū",577],["فِىٓ","dalam/tentang","fī",3],["أَنفُسِهِم ۗ","diri mereka","anfusihim",39],["مَّا","tidak","mā",2],["خَلَقَ","menciptakan","khalaqa",61],["ٱللَّهُ","Allah","l-lahu",1],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَآ","diantara kedudukannya","baynahumā",47],["إِلَّا","melainkan","illā",15],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَأَجَلٍۢ","dan waktu","wa-ajalin",226],["مُّسَمًّۭى ۗ","ditentukan","musamman",490],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["كَثِيرًۭا","kebanyakan","kathīran",161],["مِّنَ","dari","mina",0],["ٱلنَّاسِ","manusia","l-nāsi",52],["بِلِقَآئِ","dengan pertemuan","biliqāi",439],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["لَكَـٰفِرُونَ","benar-benar ingkar","lakāfirūna",70]],"t":"Dan mengapa mereka tidak memikirkan tentang (kejadian) diri mereka? Allah tidak menciptakan langit dan bumi dan apa yang ada di antara keduanya melainkan dengan (tujuan) yang benar dan dalam waktu yang ditentukan. Dan sesungguhnya banyak di antara manusia benar-benar mengingkari pertemuan dengan Tuhannya."},{"n":9,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَسِيرُوا۟","mereka berjalan","yasīrū",602],["فِى","di","fī",3],["ٱلْأَرْضِ","muka bumi","l-arḍi",22],["فَيَنظُرُوا۟","lalu mereka memperhatikan","fayanẓurū",129],["كَيْفَ","bagaimana","kayfa",138],["كَانَ","adalah","kāna",9],["عَـٰقِبَةُ","akibat","ʿāqibatu",352],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",51],["كَانُوٓا۟","adalah mereka","kānū",9],["أَشَدَّ","sangat/lebih","ashadda",361],["مِنْهُمْ","daripada mereka","min'hum",0],["قُوَّةًۭ","kekuatan","quwwatan",371],["وَأَثَارُوا۟","dan mereka meninggalkan bekas/mengolah","wa-athārū",1278],["ٱلْأَرْضَ","bumi","l-arḍa",22],["وَعَمَرُوهَآ","dan mereka memakmurkannya","waʿamarūhā",1498],["أَكْثَرَ","lebih banyak","akthara",145],["مِمَّا","daripada apa","mimmā",0],["عَمَرُوهَا","mereka memakmurkannya","ʿamarūhā",1498],["وَجَآءَتْهُمْ","dan telah datang kepada mereka","wajāathum",43],["رُسُلُهُم","rasul-rasul mereka","rusuluhum",35],["بِٱلْبَيِّنَـٰتِ ۖ","dengan bukti-bukti nyata","bil-bayināti",174],["فَمَا","maka tidak","famā",2],["كَانَ","ada","kāna",9],["ٱللَّهُ","Allah","l-lahu",1],["لِيَظْلِمَهُمْ","menganiaya mereka","liyaẓlimahum",107],["وَلَـٰكِن","akan tetapi","walākin",165],["كَانُوٓا۟","adalah mereka","kānū",9],["أَنفُسَهُمْ","diri mereka","anfusahum",39],["يَظْلِمُونَ","mereka menganiaya","yaẓlimūna",107]],"t":"Dan tidakkah mereka bepergian di bumi lalu melihat bagaimana kesudahan orang-orang sebelum mereka (yang mendustakan rasul)? Orang-orang itu lebih kuat dari mereka (sendiri) dan mereka telah mengolah bumi (tanah) serta memakmurkannya melebihi apa yang telah mereka makmurkan. Dan telah datang kepada mereka rasul-rasul mereka dengan membawa bukti-bukti yang jelas. Maka Allah sama sekali tidak berlaku zalim kepada mereka, tetapi merekalah yang berlaku zalim kepada diri mereka sendiri."},{"n":10,"w":[["ثُمَّ","kemudian","thumma",34],["كَانَ","adalah","kāna",9],["عَـٰقِبَةَ","akibat","ʿāqibata",352],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أَسَـٰٓـُٔوا۟","(mereka) berbuat kejahatan","asāū",1276],["ٱلسُّوٓأَىٰٓ","kejahatan (lebih buruk)","l-sūā",4296],["أَن","karena","an",17],["كَذَّبُوا۟","mereka mendustakan","kadhabū",63],["بِـَٔايَـٰتِ","dengan ayat-ayat","biāyāti",28],["ٱللَّهِ","Allah","l-lahi",1],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["بِهَا","dengannya/padanya","bihā",97],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",495]],"t":"Kemudian, azab yang lebih buruk adalah kesudahan bagi orang-orang yang mengerjakan kejahatan. Karena mereka mendustakan ayat-ayat Allah dan mereka selalu memperolok-olokkannya."},{"n":11,"w":[["ٱللَّهُ","Allah","al-lahu",1],["يَبْدَؤُا۟","memulai menciptakan","yabda-u",727],["ٱلْخَلْقَ","makhluk","l-khalqa",229],["ثُمَّ","kemudian","thumma",34],["يُعِيدُهُۥ","Dia mengulanginya","yuʿīduhu",537],["ثُمَّ","kemudian","thumma",34],["إِلَيْهِ","kepada-Nya","ilayhi",13],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",146]],"t":"Allah yang memulai penciptaan (makhluk), kemudian mengulanginya kembali; kemudian kepada-Nya kamu dikembalikan."},{"n":12,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["تَقُومُ","berdiri/terjadi","taqūmu",349],["ٱلسَّاعَةُ","kiamat","l-sāʿatu",251],["يُبْلِسُ","berputus asa","yub'lisu",2942],["ٱلْمُجْرِمُونَ","orang-orang yang berdosa","l-muj'rimūna",228]],"t":"Dan pada hari (ketika) terjadi Kiamat, orang-orang yang berdosa (kaum musyrik) terdiam berputus asa."},{"n":13,"w":[["وَلَمْ","dan tidaklah","walam",32],["يَكُن","ada","yakun",9],["لَّهُم","bagi mereka","lahum",11],["مِّن","dari","min",0],["شُرَكَآئِهِمْ","sekutu-sekutu (berhala-berhala) mereka","shurakāihim",290],["شُفَعَـٰٓؤُا۟","mereka mendapat syafa'at","shufaʿāu",807],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["بِشُرَكَآئِهِمْ","pada sekutu-sekutu/berhala-berhala mereka","bishurakāihim",290],["كَـٰفِرِينَ","mereka ingkar","kāfirīna",70]],"t":"Dan tidak mungkin ada pemberi syafaat (pertolongan) bagi mereka dari berhala-berhala mereka, sedangkan mereka mengingkari berhala-berhala mereka itu."},{"n":14,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["تَقُومُ","berdiri/terjadi","taqūmu",349],["ٱلسَّاعَةُ","kiamat","l-sāʿatu",251],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["يَتَفَرَّقُونَ","mereka bercerai berai","yatafarraqūna",1001]],"t":"Dan pada hari (ketika) terjadi Kiamat, pada hari itu manusia terpecah-pecah (dalam kelompok)."},{"n":15,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",95],["فَهُمْ","maka mereka","fahum",11],["فِى","di dalam","fī",3],["رَوْضَةٍۢ","taman","rawḍatin",2615],["يُحْبَرُونَ","mereka bergembira","yuḥ'barūna",2258]],"t":"Adapun orang-orang yang beriman dan mengerjakan kebajikan, maka mereka di dalam taman (surga) bergembira."},{"n":16,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَكَذَّبُوا۟","dan mereka mendustakan","wakadhabū",63],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["وَلِقَآئِ","dan pertemuan","waliqāi",439],["ٱلْـَٔاخِرَةِ","hari akhirat","l-ākhirati",73],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",56],["فِى","dalam","fī",3],["ٱلْعَذَابِ","siksaan","l-ʿadhābi",36],["مُحْضَرُونَ","mereka dihadapkan","muḥ'ḍarūna",847]],"t":"Sedangkan orang-orang yang kafir dan mendustakan ayat-ayat Kami serta (mendustakan) pertemuan hari akhirat, maka mereka tetap berada di dalam azab (neraka)."},{"n":17,"w":[["فَسُبْحَـٰنَ","maka Maha Suci","fasub'ḥāna",289],["ٱللَّهِ","Allah","l-lahi",1],["حِينَ","sewaktu","ḥīna",330],["تُمْسُونَ","kamu dipetang hari","tum'sūna",2978],["وَحِينَ","dan sewaktu","waḥīna",330],["تُصْبِحُونَ","kamu dipagi hari","tuṣ'biḥūna",383]],"t":"Maka bertasbihlah kepada Allah pada petang hari dan pada pagi hari (waktu subuh),"},{"n":18,"w":[["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْحَمْدُ","segala puji","l-ḥamdu",272],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan di bumi","wal-arḍi",22],["وَعَشِيًّۭا","diwaktu 'isya","waʿashiyyan",817],["وَحِينَ","dan sewaktu","waḥīna",330],["تُظْهِرُونَ","kamu diwaktu dzhuhur","tuẓ'hirūna",951]],"t":"dan segala puji bagi-Nya di langit, di bumi, pada malam hari dan pada waktu zuhur (tengah hari)."},{"n":19,"w":[["يُخْرِجُ","Dia mengeluarkan","yukh'riju",114],["ٱلْحَىَّ","yang hidup","l-ḥaya",435],["مِنَ","dari","mina",0],["ٱلْمَيِّتِ","yang mati","l-mayiti",312],["وَيُخْرِجُ","dan Dia mengeluarkan","wayukh'riju",114],["ٱلْمَيِّتَ","yang mati","l-mayita",312],["مِنَ","dari","mina",0],["ٱلْحَىِّ","yang hidup","l-ḥayi",435],["وَيُحْىِ","dan Dia menghidupkan","wayuḥ'yī",230],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",58],["مَوْتِهَا ۚ","matinya","mawtihā",237],["وَكَذَٰلِكَ","dan seperti demikian","wakadhālika",19],["تُخْرَجُونَ","kamu dikeluarkan","tukh'rajūna",114]],"t":"Dia mengeluarkan yang hidup dari yang mati dan mengeluarkan yang mati dari yang hidup dan menghidupkan bumi setelah mati (kering). Dan seperti itulah kamu akan dikeluarkan (dari kubur)."},{"n":20,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦٓ","ayat-ayat-Nya","āyātihi",28],["أَنْ","bahwa","an",17],["خَلَقَكُم","menciptakan kalian","khalaqakum",61],["مِّن","dari","min",0],["تُرَابٍۢ","tanah","turābin",579],["ثُمَّ","kemudian","thumma",34],["إِذَآ","tiba-tiba","idhā",23],["أَنتُم","kamu","antum",87],["بَشَرٌۭ","manusia","basharun",318],["تَنتَشِرُونَ","kamu bertebaran/berkembang biak","tantashirūna",2079]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan kamu dari tanah, kemudian tiba-tiba kamu (menjadi) manusia yang berkembang biak."},{"n":21,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦٓ","ayat-ayat-Nya","āyātihi",28],["أَنْ","bahwa","an",17],["خَلَقَ","Dia menciptakan","khalaqa",61],["لَكُم","bagi kalian","lakum",26],["مِّنْ","dari","min",0],["أَنفُسِكُمْ","diri kalian sendiri","anfusikum",39],["أَزْوَٰجًۭا","jodoh/isteri-isteri","azwājan",155],["لِّتَسْكُنُوٓا۟","agar kamu tenteram/cenderung","litaskunū",635],["إِلَيْهَا","kepadanya","ilayhā",13],["وَجَعَلَ","dan Dia menjadikan","wajaʿala",33],["بَيْنَكُم","diantara kamu","baynakum",47],["مَّوَدَّةًۭ","rasa kasih","mawaddatan",992],["وَرَحْمَةً ۚ","dan rasa sayang","waraḥmatan",105],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","yang demikian","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّقَوْمٍۢ","bagi kamu","liqawmin",27],["يَتَفَكَّرُونَ","mereka berfikir","yatafakkarūna",577]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan diantaramu rasa kasih dan sayang. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang berpikir."},{"n":22,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦ","ayat-ayat-Nya","āyātihi",28],["خَلْقُ","ciptaan","khalqu",229],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَٱخْتِلَـٰفُ","dan perbedaan","wa-ikh'tilāfu",1121],["أَلْسِنَتِكُمْ","bahasamu","alsinatikum",427],["وَأَلْوَٰنِكُمْ ۚ","dan warnamu","wa-alwānikum",910],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","yang demikian","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّلْعَـٰلِمِينَ","bagi orang-orang yang mengetahui","lil'ʿālimīna",543]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah penciptaan langit dan bumi, perbedaan bahasamu dan warna kulitmu. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi orang-orang yang mengetahui."},{"n":23,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦ","ayat-ayat-Nya","āyātihi",28],["مَنَامُكُم","tidurmu","manāmukum",1588],["بِٱلَّيْلِ","diwaktu malam","bi-al-layli",136],["وَٱلنَّهَارِ","dan siang hari","wal-nahāri",209],["وَٱبْتِغَآؤُكُم","dan usaha pencarianmu","wa-ib'tighāukum",671],["مِّن","dari/sebagian","min",0],["فَضْلِهِۦٓ ۚ","karunia-Nya","faḍlihi",135],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","yang demikian","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يَسْمَعُونَ","mereka mendengarkan","yasmaʿūna",148]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah tidurmu pada waktu malam dan siang hari serta usahamu mencari sebagian dari karunia-Nya. Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi kaum yang mendengarkan."},{"n":24,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦ","ayat-ayatnya","āyātihi",28],["يُرِيكُمُ","Dia memperlihatkan padamu","yurīkumu",291],["ٱلْبَرْقَ","kilat","l-barqa",1324],["خَوْفًۭا","rasa takut","khawfan",416],["وَطَمَعًۭا","dan harapan","waṭamaʿan",1532],["وَيُنَزِّلُ","dan Dia menurunkan","wayunazzilu",195],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["مَآءًۭ","air","māan",192],["فَيُحْىِۦ","lalu Dia menghidupkan","fayuḥ'yī",230],["بِهِ","dengannya","bihi",16],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",58],["مَوْتِهَآ ۚ","matinya","mawtihā",237],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","yang demikian","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يَعْقِلُونَ","mereka mempergunakan akal","yaʿqilūna",241]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya, Dia memperlihatkan kilat kepadamu untuk (menimbulkan) ketakutan dan harapan, dan Dia menurunkan air (hujan) dari langit, lalu dengan air itu dihidupkannya bumi setelah mati (kering). Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda bagi kaum yang mengerti."},{"n":25,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦٓ","ayat-ayat-Nya","āyātihi",28],["أَن","bahwa","an",17],["تَقُومَ","berdiri","taqūma",349],["ٱلسَّمَآءُ","langit","l-samāu",38],["وَٱلْأَرْضُ","dan bumi","wal-arḍu",22],["بِأَمْرِهِۦ ۚ","dengan perintah-Nya/iradat-Nya","bi-amrihi",66],["ثُمَّ","kemudian","thumma",34],["إِذَا","apabila","idhā",23],["دَعَاكُمْ","Dia memanggil kamu","daʿākum",65],["دَعْوَةًۭ","panggilan","daʿwatan",1170],["مِّنَ","dari","mina",0],["ٱلْأَرْضِ","bumi","l-arḍi",22],["إِذَآ","apabila/seketika itu","idhā",642],["أَنتُمْ","kamu","antum",87],["تَخْرُجُونَ","kamu keluar","takhrujūna",225]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah berdirinya langit dan bumi dengan kehendak-Nya. Kemudian apabila Dia memanggil kamu sekali panggil dari bumi, seketika itu kamu keluar (dari kubur)."},{"n":26,"w":[["وَلَهُۥ","dan kepunyaan-Nya","walahu",16],["مَن","siapa","man",12],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۖ","dan di bumi","wal-arḍi",22],["كُلٌّۭ","semua","kullun",31],["لَّهُۥ","kepada-Nya","lahu",16],["قَـٰنِتُونَ","patuh/tunduk","qānitūna",794]],"t":"Dan milik-Nya apa yang di langit dan di bumi. Semuanya hanya kepada-Nya tunduk."},{"n":27,"w":[["وَهُوَ","dan Dia","wahuwa",20],["ٱلَّذِى","yang","alladhī",7],["يَبْدَؤُا۟","memulai penciptaan","yabda-u",727],["ٱلْخَلْقَ","makhluk","l-khalqa",229],["ثُمَّ","kemudian","thumma",34],["يُعِيدُهُۥ","Dia mengembalikannya","yuʿīduhu",537],["وَهُوَ","dan hal itu","wahuwa",20],["أَهْوَنُ","lebih mudah","ahwanu",2958],["عَلَيْهِ ۚ","atasNya/bagiNya","ʿalayhi",8],["وَلَهُ","dan bagiNya","walahu",16],["ٱلْمَثَلُ","perumpamaan (sifat-sifat)","l-mathalu",128],["ٱلْأَعْلَىٰ","Maha Tinggi","l-aʿlā",761],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",113],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",115]],"t":"Dan Dialah yang memulai penciptaan, kemudian mengulanginya kembali, dan itu lebih mudah bagi-Nya. Dia memiliki sifat yang Mahatinggi di langit dan di bumi. Dan Dialah Yang Mahaperkasa, Mahabijaksana."},{"n":28,"w":[["ضَرَبَ","Dia membuat","ḍaraba",218],["لَكُم","bagi kalian","lakum",26],["مَّثَلًۭا","perumpamaan","mathalan",128],["مِّنْ","dari","min",0],["أَنفُسِكُمْ ۖ","diri kalian sendiri","anfusikum",39],["هَل","apakah","hal",118],["لَّكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["مَّا","apa (hamba sahaya)","mā",2],["مَلَكَتْ","memiliki","malakat",268],["أَيْمَـٰنُكُم","tangan kananmu","aymānukum",186],["مِّن","dari","min",0],["شُرَكَآءَ","sekutu-sekutu","shurakāa",290],["فِى","dalam","fī",3],["مَا","apa (rezeki)","mā",2],["رَزَقْنَـٰكُمْ","Kami telah rezekikan kepadamu","razaqnākum",196],["فَأَنتُمْ","maka kamu","fa-antum",87],["فِيهِ","di dalamnya","fīhi",3],["سَوَآءٌۭ","sama","sawāon",405],["تَخَافُونَهُمْ","kamu takut kepada mereka","takhāfūnahum",140],["كَخِيفَتِكُمْ","seperti takutmu","kakhīfatikum",1248],["أَنفُسَكُمْ ۚ","diri kalian sendiri","anfusakum",39],["كَذَٰلِكَ","seperti demikianlah","kadhālika",19],["نُفَصِّلُ","Kami jelaskan","nufaṣṣilu",569],["ٱلْـَٔايَـٰتِ","ayat-ayat","l-āyāti",28],["لِقَوْمٍۢ","bagi kaum","liqawmin",27],["يَعْقِلُونَ","mereka mempergunakan akal","yaʿqilūna",241]],"t":"Dia membuat perumpamaan bagimu dari dirimu sendiri. Apakah (kamu rela jika) ada di antara hamba sahaya yang kamu miliki, menjadi sekutu bagimu dalam (memiliki) rezeki yang telah Kami berikan kepadamu, sehingga kamu menjadi setara dengan mereka dalam hal ini, lalu kamu takut kepada mereka sebagaimana kamu takut kepada sesamamu. Demikianlah Kami jelaskan ayat-ayat itu bagi kaum yang mengerti."},{"n":29,"w":[["بَلِ","bahkan/tetapi","bali",96],["ٱتَّبَعَ","mengikuti","ittabaʿa",86],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ظَلَمُوٓا۟","(mereka) zalim","ẓalamū",107],["أَهْوَآءَهُم","hawa nafsu mereka","ahwāahum",571],["بِغَيْرِ","dengan tidak (tanpa)","bighayri",76],["عِلْمٍۢ ۖ","ilmu pengetahuan","ʿil'min",111],["فَمَن","maka siapakah","faman",12],["يَهْدِى","memberi petunjuk","yahdī",80],["مَنْ","orang","man",12],["أَضَلَّ","menyesatkan","aḍalla",187],["ٱللَّهُ ۖ","Allah","l-lahu",1],["وَمَا","dan tidaklah","wamā",2],["لَهُم","bagi mereka","lahum",11],["مِّن","dari","min",0],["نَّـٰصِرِينَ","seorang penolong","nāṣirīna",790]],"t":"Tetapi orang-orang yang zalim, mengikuti hawa nafsunya tanpa ilmu pengetahuan; maka siapakah yang dapat memberi petunjuk kepada orang yang telah disesatkan Allah. Dan tidak ada seorang penolong pun bagi mereka."},{"n":30,"w":[["فَأَقِمْ","maka tegakkan/hadapkanlah","fa-aqim",220],["وَجْهَكَ","wajahmu","wajhaka",169],["لِلدِّينِ","kepada agama","lilddīni",120],["حَنِيفًۭا ۚ","yang lurus","ḥanīfan",723],["فِطْرَتَ","fitrah/ciptaan","fiṭ'rata",3450],["ٱللَّهِ","Allah","l-lahi",1],["ٱلَّتِى","yang","allatī",7],["فَطَرَ","menciptakan","faṭara",831],["ٱلنَّاسَ","manusia","l-nāsa",52],["عَلَيْهَا ۚ","atasnya (menurut fitrah)","ʿalayhā",8],["لَا","tidak ada","lā",4],["تَبْدِيلَ","perubahan","tabdīla",1103],["لِخَلْقِ","bagi ciptaan","likhalqi",229],["ٱللَّهِ ۚ","Allah","l-lahi",1],["ذَٰلِكَ","demikian itu","dhālika",19],["ٱلدِّينُ","agama","l-dīnu",120],["ٱلْقَيِّمُ","yang lurus","l-qayimu",1093],["وَلَـٰكِنَّ","akan tetapi","walākinna",208],["أَكْثَرَ","kebanyakan","akthara",145],["ٱلنَّاسِ","manusia","l-nāsi",52],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Maka hadapkanlah wajahmu dengan lurus kepada agama (Islam); (sesuai) fitrah Allah disebabkan Dia telah menciptakan manusia menurut (fitrah) itu. Tidak ada perubahan pada ciptaan Allah. (Itulah) agama yang lurus, tetapi kebanyakan manusia tidak mengetahui,"},{"n":31,"w":[["۞ مُنِيبِينَ","kembali bertaubat","munībīna",1087],["إِلَيْهِ","kepada-NYA","ilayhi",13],["وَٱتَّقُوهُ","dan bertakwalah kepada-Nya","wa-ittaqūhu",67],["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",220],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",137],["وَلَا","dan janganlah","walā",4],["تَكُونُوا۟","kalian menjadi","takūnū",9],["مِنَ","dari/termasuk","mina",0],["ٱلْمُشْرِكِينَ","orang-orang yang mempersekutukan","l-mush'rikīna",244]],"t":"dengan kembali bertobat kepada-Nya dan bertakwalah kepada-Nya serta laksanakanlah salat dan janganlah kamu termasuk orang-orang yang mempersekutukan Allah,"},{"n":32,"w":[["مِنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["فَرَّقُوا۟","(mereka) memecah belah","farraqū",901],["دِينَهُمْ","agama mereka","dīnahum",120],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["شِيَعًۭا ۖ","beberapa golongan","shiyaʿan",755],["كُلُّ","tiap","kullu",31],["حِزْبٍۭ","golongan","ḥiz'bin",506],["بِمَا","dengan apa-apa","bimā",2],["لَدَيْهِمْ","disisi mereka","ladayhim",511],["فَرِحُونَ","mereka bangga","fariḥūna",1174]],"t":"yaitu orang-orang yang memecah belah agama mereka dan mereka menjadi beberapa golongan. Setiap golongan merasa bangga dengan apa yang ada pada golongan mereka."},{"n":33,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["مَسَّ","menimpa","massa",215],["ٱلنَّاسَ","manusia","l-nāsa",52],["ضُرٌّۭ","bahaya","ḍurrun",523],["دَعَوْا۟","mereka menyeru/berdoa","daʿaw",65],["رَبَّهُم","Tuhan mereka","rabbahum",10],["مُّنِيبِينَ","kembali bertaubat","munībīna",1087],["إِلَيْهِ","kepada-Nya","ilayhi",13],["ثُمَّ","kemudian","thumma",34],["إِذَآ","apabila","idhā",23],["أَذَاقَهُم","Dia merasakan kepada mereka","adhāqahum",458],["مِّنْهُ","dari pada-Nya","min'hu",0],["رَحْمَةً","rahmat","raḥmatan",105],["إِذَا","apabila","idhā",23],["فَرِيقٌۭ","segolongan/sebagian","farīqun",345],["مِّنْهُم","dari mereka","min'hum",0],["بِرَبِّهِمْ","dengan/kepada Tuhan mereka","birabbihim",10],["يُشْرِكُونَ","mereka mempersekutukan","yush'rikūna",171]],"t":"Dan apabila manusia ditimpa oleh suatu bahaya, mereka menyeru Tuhannya dengan kembali (bertobat) kepada-Nya, kemudian apabila Dia memberikan sedikit rahmat-Nya kepada mereka, tiba-tiba sebagian mereka mempersekutukan Allah,"},{"n":34,"w":[["لِيَكْفُرُوا۟","karena mereka mengingkari","liyakfurū",40],["بِمَآ","dengan apa (rahmat)","bimā",2],["ءَاتَيْنَـٰهُمْ ۚ","Kami telah berikan kepada mereka","ātaynāhum",45],["فَتَمَتَّعُوا۟","maka bersenang-senanglah","fatamattaʿū",801],["فَسَوْفَ","maka kelak","fasawfa",281],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29]],"t":"biarkan mereka mengingkari rahmat yang telah Kami berikan. Dan bersenang-senanglah kamu, maka kelak kamu akan mengetahui (akibat perbuatanmu)."},{"n":35,"w":[["أَمْ","ataukah/apakah","am",84],["أَنزَلْنَا","Kami menurunkan","anzalnā",62],["عَلَيْهِمْ","atas/kepada mereka","ʿalayhim",8],["سُلْطَـٰنًۭا","kekuasaan/keterangan","sul'ṭānan",323],["فَهُوَ","lalu ia","fahuwa",20],["يَتَكَلَّمُ","berbicara/mengatakan","yatakallamu",1663],["بِمَا","dengan apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["بِهِۦ","dengan-Nya/Tuhan","bihi",16],["يُشْرِكُونَ","mereka mempersekutukan","yush'rikūna",171]],"t":"Atau pernahkah Kami menurunkan kepada mereka keterangan, yang menjelaskan (membenarkan) apa yang (selalu) mereka persekutukan dengan Tuhan?"},{"n":36,"w":[["وَإِذَآ","dan apabila","wa-idhā",23],["أَذَقْنَا","Kami rasakan","adhaqnā",458],["ٱلنَّاسَ","manusia","l-nāsa",52],["رَحْمَةًۭ","suatu rahmat","raḥmatan",105],["فَرِحُوا۟","mereka gembira","fariḥū",591],["بِهَا ۖ","dengannya/karenanya","bihā",97],["وَإِن","dan jika","wa-in",14],["تُصِبْهُمْ","menimpa mereka","tuṣib'hum",189],["سَيِّئَةٌۢ","kejahatan","sayyi-atun",205],["بِمَا","dengan apa/sebab","bimā",2],["قَدَّمَتْ","mengerjakan","qaddamat",403],["أَيْدِيهِمْ","tangan-tangan mereka","aydīhim",101],["إِذَا","tiba-tiba","idhā",642],["هُمْ","mereka","hum",11],["يَقْنَطُونَ","mereka berputus asa","yaqnaṭūna",1631]],"t":"Dan apabila Kami berikan suatu rahmat kepada manusia, niscaya mereka gembira dengan (rahmat) itu. Tetapi apabila mereka ditimpa suatu musibah (bahaya) karena kesalahan mereka sendiri, seketika itu mereka berputus asa."},{"n":37,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["أَنَّ","bahwasanya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["يَبْسُطُ","melapangkan","yabsuṭu",589],["ٱلرِّزْقَ","rizki","l-riz'qa",219],["لِمَن","bagi siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَقْدِرُ ۚ","dan Dia menyempitkan","wayaqdiru",429],["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ذَٰلِكَ","yang demikian itu","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يُؤْمِنُونَ","yang beriman","yu'minūna",18]],"t":"Dan tidakkah mereka memperhatikan bahwa Allah yang melapangkan rezeki bagi siapa yang Dia kehendaki dan Dia (pula) yang membatasi (bagi siapa yang Dia kehendaki). Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi kaum yang beriman."},{"n":38,"w":[["فَـَٔاتِ","maka berikanlah","faāti",45],["ذَا","memiliki","dhā",443],["ٱلْقُرْبَىٰ","kerabat yang dekat","l-qur'bā",601],["حَقَّهُۥ","haknya","ḥaqqahu",50],["وَٱلْمِسْكِينَ","dan orang-orang miskin","wal-mis'kīna",453],["وَٱبْنَ","dan orang-orang","wa-ib'na",81],["ٱلسَّبِيلِ ۚ","dijalan/dalam perjalanan","l-sabīli",64],["ذَٰلِكَ","seperti itulah","dhālika",19],["خَيْرٌۭ","kebaikan","khayrun",60],["لِّلَّذِينَ","kepada orang-orang","lilladhīna",7],["يُرِيدُونَ","(mereka) menghendaki","yurīdūna",83],["وَجْهَ","wajah/keridaan","wajha",169],["ٱللَّهِ ۖ","Allah","l-lahi",1],["وَأُو۟لَـٰٓئِكَ","dan mereka itu","wa-ulāika",56],["هُمُ","mereka","humu",11],["ٱلْمُفْلِحُونَ","orang-orang yang beruntung","l-muf'liḥūna",691]],"t":"Maka berikanlah haknya kepada kerabat dekat, juga kepada orang miskin dan orang-orang yang dalam perjalanan. Itulah yang lebih baik bagi orang-orang yang mencari keridaan Allah. Dan mereka itulah orang-orang yang beruntung."},{"n":39,"w":[["وَمَآ","dan apa","wamā",2],["ءَاتَيْتُم","yang kamu berikan","ātaytum",45],["مِّن","dari","min",0],["رِّبًۭا","riba","riban",4208],["لِّيَرْبُوَا۟","untuk menambah","liyarbuwā",1640],["فِىٓ","pada","fī",3],["أَمْوَٰلِ","harta","amwāli",131],["ٱلنَّاسِ","manusia","l-nāsi",52],["فَلَا","maka tidak","falā",4],["يَرْبُوا۟","ia menambah","yarbū",1640],["عِندَ","pada sisi","ʿinda",59],["ٱللَّهِ ۖ","Allah","l-lahi",1],["وَمَآ","dan apa","wamā",2],["ءَاتَيْتُم","yang kamu berikan","ātaytum",45],["مِّن","dari","min",0],["زَكَوٰةٍۢ","zakat","zakatin",359],["تُرِيدُونَ","kamu menghendaki","turīdūna",83],["وَجْهَ","wajah/keridaan","wajha",169],["ٱللَّهِ","Allah","l-lahi",1],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",56],["هُمُ","mereka","humu",11],["ٱلْمُضْعِفُونَ","orang-orang yang melipat-gandakan","l-muḍ'ʿifūna",3778]],"t":"Dan suatu riba (tambahan) yang kamu berikan agar harta manusia bertambah, maka tidak bertambah dalam pandangan Allah. Dan apa yang kamu berikan berupa zakat yang kamu maksudkan untuk memperoleh keridaan Allah, maka itulah orang-orang yang melipatgandakan (pahalanya)."},{"n":40,"w":[["ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَكُمْ","menciptakan kalian","khalaqakum",61],["ثُمَّ","kemudian","thumma",34],["رَزَقَكُمْ","Dia memberi rezeki kamu","razaqakum",196],["ثُمَّ","kemudian","thumma",34],["يُمِيتُكُمْ","Dia mematikan kalian","yumītukum",481],["ثُمَّ","kemudian","thumma",34],["يُحْيِيكُمْ ۖ","Dia menghidupkan kalian","yuḥ'yīkum",230],["هَلْ","adakah","hal",118],["مِن","dari","min",0],["شُرَكَآئِكُم","sekutu-sekutu kamu","shurakāikum",290],["مَّن","orang (sekutu)","man",12],["يَفْعَلُ","membuat","yafʿalu",126],["مِن","dari","min",0],["ذَٰلِكُم","yang demikian itu","dhālikum",19],["مِّن","dari","min",0],["شَىْءٍۢ ۚ","sesuatu","shayin",41],["سُبْحَـٰنَهُۥ","Maha Suci Dia","sub'ḥānahu",289],["وَتَعَـٰلَىٰ","dan Maha Tinggi","wataʿālā",517],["عَمَّا","dari apa","ʿammā",21],["يُشْرِكُونَ","mereka persekutukan","yush'rikūna",171]],"t":"Allah yang menciptakan kamu, kemudian memberimu rezeki, lalu mematikanmu, kemudian menghidupkanmu (kembali). Adakah di antara mereka yang kamu sekutukan dengan Allah yang dapat berbuat hal yang demikian? Mahasuci Dia dan Mahatinggi dari apa yang mereka persekutukan."},{"n":41,"w":[["ظَهَرَ","telah nampak","ẓahara",828],["ٱلْفَسَادُ","kerusakan","l-fasādu",778],["فِى","di","fī",3],["ٱلْبَرِّ","darat","l-bari",462],["وَٱلْبَحْرِ","dan di laut","wal-baḥri",286],["بِمَا","dengan apa/sebab","bimā",2],["كَسَبَتْ","perbuatan","kasabat",194],["أَيْدِى","tangan-tangan","aydī",101],["ٱلنَّاسِ","manusia","l-nāsi",52],["لِيُذِيقَهُم","untuk Dia merasakan kepada mereka","liyudhīqahum",458],["بَعْضَ","sebagian","baʿḍa",71],["ٱلَّذِى","yang","alladhī",7],["عَمِلُوا۟","mereka perbuat","ʿamilū",44],["لَعَلَّهُمْ","agar mereka","laʿallahum",92],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",146]],"t":"Telah tampak kerusakan di darat dan di laut disebabkan karena perbuatan tangan manusia; Allah menghendaki agar mereka merasakan sebagian dari (akibat) perbuatan mereka, agar mereka kembali (ke jalan yang benar)."},{"n":42,"w":[["قُلْ","katakanlah","qul",6],["سِيرُوا۟","berjalanlah kamu","sīrū",602],["فِى","di","fī",3],["ٱلْأَرْضِ","muka bumi","l-arḍi",22],["فَٱنظُرُوا۟","maka perhatikanlah","fa-unẓurū",129],["كَيْفَ","bagaimana","kayfa",138],["كَانَ","adalah","kāna",9],["عَـٰقِبَةُ","akibat","ʿāqibatu",352],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلُ ۚ","sebelum/dahulu","qablu",51],["كَانَ","adalah","kāna",9],["أَكْثَرُهُم","kebanyakan mereka","aktharuhum",145],["مُّشْرِكِينَ","orang-orang yang mempersekutukan","mush'rikīna",244]],"t":"Katakanlah (Muhammad), \"Bepergianlah di bumi lalu lihatlah bagaimana kesudahan orang-orang dahulu. Kebanyakan dari mereka adalah orang-orang yang mempersekutukan (Allah).\""},{"n":43,"w":[["فَأَقِمْ","maka hadapkan","fa-aqim",220],["وَجْهَكَ","wajahmu","wajhaka",169],["لِلدِّينِ","kepada agama","lilddīni",120],["ٱلْقَيِّمِ","yang lurus","l-qayimi",1093],["مِن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",17],["يَأْتِىَ","akan datang","yatiya",48],["يَوْمٌۭ","suatu hari","yawmun",25],["لَّا","tidak","lā",4],["مَرَدَّ","dapat menolak","maradda",1196],["لَهُۥ","baginya","lahu",16],["مِنَ","dari","mina",0],["ٱللَّهِ ۖ","Allah","l-lahi",1],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["يَصَّدَّعُونَ","mereka terpisah-pisah","yaṣṣaddaʿūna",4316]],"t":"Oleh karena itu, hadapkanlah wajahmu kepada agama yang lurus (Islam) sebelum datang dari Allah suatu hari (Kiamat) yang tidak dapat ditolak, pada hari itu mereka terpisah-pisah."},{"n":44,"w":[["مَن","barangsiapa","man",12],["كَفَرَ","kafir","kafara",40],["فَعَلَيْهِ","maka atasnya","faʿalayhi",8],["كُفْرُهُۥ ۖ","kekafirannya","kuf'ruhu",320],["وَمَنْ","dan barangsiapa","waman",12],["عَمِلَ","beramal","ʿamila",44],["صَـٰلِحًۭا","kebajikan/saleh","ṣāliḥan",95],["فَلِأَنفُسِهِمْ","maka untuk diri mereka sendiri","fali-anfusihim",39],["يَمْهَدُونَ","mereka menyiapkan","yamhadūna",3692]],"t":"Barangsiapa kafir maka dia sendirilah yang menanggung (akibat) kekafirannya; dan barangsiapa mengerjakan kebajikan maka mereka menyiapkan untuk diri mereka sendiri (tempat yang menyenangkan),"},{"n":45,"w":[["لِيَجْزِىَ","karena Dia akan memberi balasan","liyajziya",164],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",95],["مِن","dari","min",0],["فَضْلِهِۦٓ ۚ","karunia-Nya","faḍlihi",135],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["لَا","tidak","lā",4],["يُحِبُّ","Dia menyukai","yuḥibbu",188],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",70]],"t":"agar Allah memberi balasan (pahala) kepada orang-orang yang beriman dan mengerjakan kebajikan dari karunia-Nya. Sungguh, Dia tidak menyukai orang-orang yang ingkar (kafir)."},{"n":46,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦٓ","ayat-ayat-Nya","āyātihi",28],["أَن","bahwa","an",17],["يُرْسِلَ","Dia mengirimkan","yur'sila",91],["ٱلرِّيَاحَ","angin","l-riyāḥa",382],["مُبَشِّرَٰتٍۢ","pembawa berita gembira","mubashirātin",844],["وَلِيُذِيقَكُم","dan untuk merasakan kepadamu","waliyudhīqakum",458],["مِّن","dari","min",0],["رَّحْمَتِهِۦ","rahmat-Nya","raḥmatihi",105],["وَلِتَجْرِىَ","dan supaya berlayar","walitajriya",207],["ٱلْفُلْكُ","perahu","l-ful'ku",451],["بِأَمْرِهِۦ","dengan perintah-Nya","bi-amrihi",66],["وَلِتَبْتَغُوا۟","dan supaya kamu mencari","walitabtaghū",342],["مِن","dari","min",0],["فَضْلِهِۦ","karunia-Nya","faḍlihi",135],["وَلَعَلَّكُمْ","dan agar kamu","walaʿallakum",92],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",254]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya adalah bahwa Dia mengirimkan angin sebagai pembawa berita gembira dan agar kamu merasakan sebagian dari rahmat-Nya dan agar kapal dapat berlayar dengan perintah-Nya dan (juga) agar kamu dapat mencari sebagian dari karunia-Nya, dan agar kamu bersyukur."},{"n":47,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",91],["مِن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["رُسُلًا","para Rasul","rusulan",35],["إِلَىٰ","kepada","ilā",13],["قَوْمِهِمْ","kaum mereka","qawmihim",27],["فَجَآءُوهُم","maka (Rasul) datang kepada mereka","fajāūhum",43],["بِٱلْبَيِّنَـٰتِ","dengan keterangan-keterangan","bil-bayināti",174],["فَٱنتَقَمْنَا","lalu Kami menyiksa","fa-intaqamnā",1252],["مِنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أَجْرَمُوا۟ ۖ","(mereka) berdosa","ajramū",1271],["وَكَانَ","dan adalah","wakāna",9],["حَقًّا","berhak/berkewajiban","ḥaqqan",50],["عَلَيْنَا","atas kami","ʿalaynā",8],["نَصْرُ","pertolongan","naṣru",468],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",55]],"t":"Dan sungguh, Kami telah mengutus sebelum engkau (Muhammad) beberapa orang rasul kepada kaumnya, mereka datang kepadanya dengan membawa keterangan-keterangan (yang cukup), lalu Kami melakukan pembalasan terhadap orang-orang yang berdosa. Dan merupakan hak Kami untuk menolong orang-orang yang beriman."},{"n":48,"w":[["ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["يُرْسِلُ","mengirimkan","yur'silu",91],["ٱلرِّيَـٰحَ","angin","l-riyāḥa",382],["فَتُثِيرُ","lalu (angin) menghalau","fatuthīru",1278],["سَحَابًۭا","awan","saḥāban",927],["فَيَبْسُطُهُۥ","lalu membentangkannya","fayabsuṭuhu",589],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["كَيْفَ","bagaimana menurut","kayfa",138],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَجْعَلُهُۥ","dan Dia menjadikannya","wayajʿaluhu",33],["كِسَفًۭا","gumpalan-gumpalan","kisafan",1578],["فَتَرَى","maka kamu melihat","fatarā",46],["ٱلْوَدْقَ","hujan","l-wadqa",2715],["يَخْرُجُ","keluar","yakhruju",225],["مِنْ","dari","min",0],["خِلَـٰلِهِۦ ۖ","celah-celahnya","khilālihi",1009],["فَإِذَآ","maka apabila","fa-idhā",23],["أَصَابَ","mengenai","aṣāba",189],["بِهِۦ","dengannya","bihi",16],["مَن","siapa","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["مِنْ","daripada","min",0],["عِبَادِهِۦٓ","hamba-hamba-Nya","ʿibādihi",90],["إِذَا","tiba-tiba","idhā",23],["هُمْ","mereka","hum",11],["يَسْتَبْشِرُونَ","mereka bergembira","yastabshirūna",1119]],"t":"Allah lah yang mengirimkan angin, lalu angin itu menggerakkan awan dan Allah membentangkannya di langit menurut yang Dia kehendaki, dan menjadikannya bergumpal-gumpal, lalu engkau lihat hujan keluar dari celah-celahnya, maka apabila Dia menurunkannya kepada hamba-hamba-Nya yang Dia kehendaki tiba-tiba mereka bergembira."},{"n":49,"w":[["وَإِن","dan sesungguhnya","wa-in",14],["كَانُوا۟","adalah mereka","kānū",9],["مِن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",17],["يُنَزَّلَ","diturunkan","yunazzala",195],["عَلَيْهِم","atas mereka","ʿalayhim",8],["مِّن","dari","min",0],["قَبْلِهِۦ","sebelumnya","qablihi",51],["لَمُبْلِسِينَ","benar-benar berputus asa","lamub'lisīna",1598]],"t":"Padahal sebelum hujan diturunkan kepada mereka, sungguh mereka benar-benar telah berputus asa."},{"n":50,"w":[["فَٱنظُرْ","maka perhatikanlah","fa-unẓur",129],["إِلَىٰٓ","kepada","ilā",13],["ءَاثَـٰرِ","bekas-bekas","āthāri",646],["رَحْمَتِ","rahmat","raḥmati",105],["ٱللَّهِ","Allah","l-lahi",1],["كَيْفَ","bagaimana","kayfa",138],["يُحْىِ","Dia menghidupkan","yuḥ'yī",230],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",58],["مَوْتِهَآ ۚ","matinya","mawtihā",237],["إِنَّ","sesungguhnya","inna",5],["ذَٰلِكَ","yang demikian","dhālika",19],["لَمُحْىِ","benar-benar menghidupkan","lamuḥ'yī",2488],["ٱلْمَوْتَىٰ ۖ","orang mati","l-mawtā",312],["وَهُوَ","dan Dia","wahuwa",20],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha Kuasa","qadīrun",261]],"t":"Maka perhatikanlah bekas-bekas rahmat Allah, bagaimana Allah menghidupkan bumi setelah mati (kering). Sungguh, itu berarti Dia pasti (berkuasa) menghidupkan yang telah mati. Dan Dia Mahakuasa atas segala sesuatu."},{"n":51,"w":[["وَلَئِنْ","dan sungguh jika","wala-in",14],["أَرْسَلْنَا","Kami mengirimkan","arsalnā",91],["رِيحًۭا","angin","rīḥan",382],["فَرَأَوْهُ","maka mereka melihatnya","fara-awhu",46],["مُصْفَرًّۭا","menjadi kuning","muṣ'farran",1916],["لَّظَلُّوا۟","niscaya mereka tetap","laẓallū",894],["مِنۢ","dari","min",0],["بَعْدِهِۦ","sesudahnya/itu","baʿdihi",58],["يَكْفُرُونَ","mereka ingkar","yakfurūna",40]],"t":"Dan sungguh, jika Kami mengirimkan angin lalu mereka melihat (tumbuh-tumbuhan itu) menjadi kuning (kering), niscaya setelah itu mereka tetap ingkar."},{"n":52,"w":[["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["لَا","kamu tidak","lā",4],["تُسْمِعُ","dapat menjadikan mendengar","tus'miʿu",675],["ٱلْمَوْتَىٰ","orang mati","l-mawtā",312],["وَلَا","dan tidak","walā",4],["تُسْمِعُ","kamu menjadikan mendengar","tus'miʿu",675],["ٱلصُّمَّ","orang tuli","l-ṣuma",710],["ٱلدُّعَآءَ","seruan","l-duʿāa",463],["إِذَا","apabila","idhā",23],["وَلَّوْا۟","mereka berpaling","wallaw",374],["مُدْبِرِينَ","membelakang","mud'birīna",988]],"t":"Maka sungguh, engkau tidak akan sanggup menjadikan orang-orang yang mati itu dapat mendengar, dan menjadikan orang-orang yang tuli dapat mendengar seruan, apabila mereka berpaling ke belakang."},{"n":53,"w":[["وَمَآ","dan tidaklah","wamā",2],["أَنتَ","kamu","anta",144],["بِهَـٰدِ","dengan memberi petunjuk","bihādi",1067],["ٱلْعُمْىِ","orang yang buta","l-ʿum'yi",479],["عَن","dari","ʿan",21],["ضَلَـٰلَتِهِمْ ۖ","kesesatan mereka","ḍalālatihim",881],["إِن","tidaklah","in",14],["تُسْمِعُ","kamu menjadikan mendengar","tus'miʿu",675],["إِلَّا","kecuali","illā",15],["مَن","orang","man",12],["يُؤْمِنُ","dia beriman","yu'minu",18],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["فَهُم","maka mereka","fahum",11],["مُّسْلِمُونَ","orang-orang yang berserah diri","mus'limūna",278]],"t":"Dan engkau tidak akan dapat memberi petunjuk kepada orang-orang yang buta (mata hatinya) dari kesesatannya. Dan engkau tidak dapat memperdengarkan (petunjuk Tuhan) kecuali kepada orang-orang yang beriman dengan ayat-ayat Kami, maka mereka itulah orang-orang yang berserah diri (kepada Kami)."},{"n":54,"w":[["۞ ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَكُم","menciptakan kalian","khalaqakum",61],["مِّن","dari","min",0],["ضَعْفٍۢ","keadaan lemah","ḍaʿfin",1493],["ثُمَّ","kemudian","thumma",34],["جَعَلَ","Dia menjadikan","jaʿala",33],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["ضَعْفٍۢ","keadaan lemah","ḍaʿfin",1493],["قُوَّةًۭ","kuat","quwwatan",371],["ثُمَّ","kemudian","thumma",34],["جَعَلَ","Dia menjadikan","jaʿala",33],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["قُوَّةٍۢ","kuat","quwwatin",371],["ضَعْفًۭا","keadaan lemah","ḍaʿfan",1493],["وَشَيْبَةًۭ ۚ","dan beruban","washaybatan",2840],["يَخْلُقُ","Dia menciptakan","yakhluqu",61],["مَا","apa","mā",2],["يَشَآءُ ۖ","yang dikehendaki-Nya","yashāu",54],["وَهُوَ","Dan dia","wahuwa",20],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68],["ٱلْقَدِيرُ","Maha Kuasa","l-qadīru",261]],"t":"Allah lah yang menciptakan kamu dari keadaan lemah, kemudian Dia menjadikan (kamu) setelah keadaan lemah itu menjadi kuat, kemudian Dia menjadikan (kamu) setelah kuat itu lemah (kembali) dan beruban. Dia menciptakan apa yang Dia kehendaki. Dan Dia Maha Mengetahui, Mahakuasa."},{"n":55,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["تَقُومُ","terjadi","taqūmu",349],["ٱلسَّاعَةُ","kiamat","l-sāʿatu",251],["يُقْسِمُ","bersumpah","yuq'simu",500],["ٱلْمُجْرِمُونَ","orang-orang yang berdosa","l-muj'rimūna",228],["مَا","tidaklah","mā",2],["لَبِثُوا۟","mereka tinggal","labithū",369],["غَيْرَ","melainkan","ghayra",76],["سَاعَةٍۢ ۚ","sesaat","sāʿatin",251],["كَذَٰلِكَ","seperti demikianlah","kadhālika",19],["كَانُوا۟","adalah mereka","kānū",9],["يُؤْفَكُونَ","mereka dipalingkan","yu'fakūna",585]],"t":"Dan pada hari (ketika) terjadinya Kiamat, orang-orang yang berdosa bersumpah, bahwa mereka berdiam (dalam kubur) hanya sesaat (saja). Begitulah dahulu mereka dipalingkan (dari kebenaran)."},{"n":56,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْعِلْمَ","ilmu pengetahuan","l-ʿil'ma",111],["وَٱلْإِيمَـٰنَ","dan keimanan","wal-īmāna",257],["لَقَدْ","sesungguhnya","laqad",24],["لَبِثْتُمْ","kamu telah tinggal","labith'tum",369],["فِى","dalam/menurut","fī",3],["كِتَـٰبِ","ketetapan","kitābi",49],["ٱللَّهِ","Allah","l-lahi",1],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْبَعْثِ ۖ","berbangkit","l-baʿthi",1539],["فَهَـٰذَا","maka ini","fahādhā",37],["يَوْمُ","hari","yawmu",25],["ٱلْبَعْثِ","berbangkit","l-baʿthi",1539],["وَلَـٰكِنَّكُمْ","akan tetapi kamu","walākinnakum",208],["كُنتُمْ","kalian adalah","kuntum",9],["لَا","tidak","lā",4],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29]],"t":"Dan orang-orang yang diberi ilmu dan keimanan berkata (kepada orang-orang kafir), \"Sungguh, kamu telah berdiam (dalam kubur) menurut ketetapan Allah, sampai hari berbangkit. Maka inilah hari berbangkit itu, tetapi (dahulu) kamu tidak meyakini(nya).\""},{"n":57,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",180],["لَّا","tidak","lā",4],["يَنفَعُ","bermanfaat","yanfaʿu",363],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ظَلَمُوا۟","(mereka) zalim","ẓalamū",107],["مَعْذِرَتُهُمْ","permintaan uzur mereka","maʿdhiratuhum",1582],["وَلَا","dan tidak","walā",4],["هُمْ","mereka","hum",11],["يُسْتَعْتَبُونَ","mereka diberi kesempatan bertaubat","yus'taʿtabūna",1695]],"t":"Maka pada hari itu tidak bermanfaat (lagi) permintaan maaf orang-orang yang zalim, dan mereka tidak pula diberi kesempatan bertobat lagi."},{"n":58,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["ضَرَبْنَا","Kami telah membuat","ḍarabnā",218],["لِلنَّاسِ","untuk manusia","lilnnāsi",52],["فِى","dalam","fī",3],["هَـٰذَا","ini","hādhā",37],["ٱلْقُرْءَانِ","Al-Qur'an","l-qur'āni",178],["مِن","dari","min",0],["كُلِّ","segala","kulli",31],["مَثَلٍۢ ۚ","perumpamaan","mathalin",128],["وَلَئِن","dan sungguh jika","wala-in",14],["جِئْتَهُم","kamu datang pada mereka","ji'tahum",43],["بِـَٔايَةٍۢ","dengan suatu ayat","biāyatin",28],["لَّيَقُولَنَّ","pasti akan berkata","layaqūlanna",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوٓا۟","kafir/ingkar","kafarū",40],["إِنْ","tidaklah","in",14],["أَنتُمْ","kamu","antum",87],["إِلَّا","kecuali","illā",15],["مُبْطِلُونَ","orang-orang yang membuat kepalsuan","mub'ṭilūna",1373]],"t":"Dan sesungguhnya telah Kami jelaskan kepada manusia segala macam perumpamaan dalam Alquran ini. Dan jika engkau membawa suatu ayat kepada mereka, pastilah orang-orang kafir itu akan berkata, \"Kamu hanyalah orang-orang yang membuat kepalsuan belaka.\""},{"n":59,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",19],["يَطْبَعُ","mengunci mati/mencap","yaṭbaʿu",774],["ٱللَّهُ","Allah","l-lahu",1],["عَلَىٰ","atas","ʿalā",8],["قُلُوبِ","hati-hati","qulūbi",89],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","(mereka) tidak","lā",4],["يَعْلَمُونَ","mengetahui/memahami","yaʿlamūna",29]],"t":"Demikianlah Allah mengunci hati orang-orang yang tidak (mau) memahami."},{"n":60,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",203],["إِنَّ","sesungguhnya","inna",5],["وَعْدَ","janji","waʿda",246],["ٱللَّهِ","Allah","l-lahi",1],["حَقٌّۭ ۖ","hak/benar","ḥaqqun",50],["وَلَا","dan jangan","walā",4],["يَسْتَخِفَّنَّكَ","sekali-kali menggelisahkan kamu","yastakhiffannaka",2088],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","(mereka) tidak","lā",4],["يُوقِنُونَ","meyakini","yūqinūna",715]],"t":"Maka bersabarlah engkau (Muhammad), sungguh, janji Allah itu benar dan sekali-kali jangan sampai orang-orang yang tidak meyakini (kebenaran ayat-ayat Allah) itu menggelisahkan engkau."}]