[{"n":1,"w":[["هَلْ","apakah/bukankah","hal",118],["أَتَىٰ","telah datang","atā",48],["عَلَى","atas","ʿalā",8],["ٱلْإِنسَـٰنِ","manusia","l-insāni",170],["حِينٌۭ","waktu","ḥīnun",330],["مِّنَ","dari","mina",0],["ٱلدَّهْرِ","masa","l-dahri",2351],["لَمْ","tidaklah","lam",32],["يَكُن","dia","yakun",9],["شَيْـًۭٔا","sesuatu","shayan",41],["مَّذْكُورًا","yang disebut","madhkūran",3912]],"t":"Bukankah pernah datang kepada manusia waktu dari masa, yang ketika itu belum merupakan sesuatu yang dapat disebut?"},{"n":2,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",61],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["مِن","dari","min",0],["نُّطْفَةٍ","setetes mani","nuṭ'fatin",738],["أَمْشَاجٍۢ","bercampur","amshājin",3654],["نَّبْتَلِيهِ","Kami mengujinya","nabtalīhi",1015],["فَجَعَلْنَـٰهُ","maka Kami jadikan ia","fajaʿalnāhu",33],["سَمِيعًۢا","mendengar","samīʿan",253],["بَصِيرًا","melihat","baṣīran",232]],"t":"Sungguh, Kami telah menciptakan manusia dari setetes mani yang bercampur yang Kami hendak mengujinya (dengan perintah dan larangan), karena itu Kami jadikan dia mendengar dan melihat."},{"n":3,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["هَدَيْنَـٰهُ","Kami beri petunjuk padanya","hadaynāhu",80],["ٱلسَّبِيلَ","jalan","l-sabīla",64],["إِمَّا","terkadang/adakalanya","immā",445],["شَاكِرًۭا","bersyukur","shākiran",641],["وَإِمَّا","dan terkadang","wa-immā",445],["كَفُورًا","kufur/ingkar","kafūran",732]],"t":"Sungguh, Kami telah menunjukkan kepadanya jalan yang lurus; ada yang bersyukur dan ada pula yang kufur."},{"n":4,"w":[["إِنَّآ","sesungguhnya kami","innā",5],["أَعْتَدْنَا","Kami menyediakan","aʿtadnā",643],["لِلْكَـٰفِرِينَ","bagi orang-orang kafir","lil'kāfirīna",70],["سَلَـٰسِلَا۟","rantai-rantai","salāsilā",2010],["وَأَغْلَـٰلًۭا","dan belenggu-belenggu","wa-aghlālan",902],["وَسَعِيرًا","dan neraka yang menyala-nyala","wasaʿīran",603]],"t":"Sungguh, Kami telah menyediakan bagi orang-orang kafir rantai, belenggu dan neraka yang menyala-nyala."},{"n":5,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْأَبْرَارَ","yang berbuat baik","l-abrāra",462],["يَشْرَبُونَ","mereka akan minum","yashrabūna",611],["مِن","dari","min",0],["كَأْسٍۢ","piala/gelas","kasin",1185],["كَانَ","adalah ia","kāna",9],["مِزَاجُهَا","campurannya","mizājuhā",1911],["كَافُورًا","air kafur","kāfūran",3587]],"t":"Sungguh, orang-orang yang berbuat kebajikan akan minum dari gelas (berisi minuman) yang campurannya adalah air kafur,"},{"n":6,"w":[["عَيْنًۭا","mata air","ʿaynan",206],["يَشْرَبُ","minuman","yashrabu",611],["بِهَا","padanya","bihā",97],["عِبَادُ","hamba-hamba","ʿibādu",90],["ٱللَّهِ","Allah","l-lahi",1],["يُفَجِّرُونَهَا","mereka memancarkannya/mengalirkannya","yufajjirūnahā",1173],["تَفْجِيرًۭا","dengan pancaran/aliran","tafjīran",2683]],"t":"(yaitu) mata air (dalam surga) yang di minum oleh hamba-hamba Allah dan mereka dapat memancarkannya dengan sebaik-baiknya."},{"n":7,"w":[["يُوفُونَ","mereka memenuhi","yūfūna",540],["بِٱلنَّذْرِ","dengan nazar","bil-nadhri",2575],["وَيَخَافُونَ","dan mereka takut","wayakhāfūna",140],["يَوْمًۭا","hari","yawman",25],["كَانَ","adalah ia","kāna",9],["شَرُّهُۥ","bahayanya/azabnya","sharruhu",365],["مُسْتَطِيرًۭا","merata kemana-mana","mus'taṭīran",3863]],"t":"Mereka memenuhi nazar dan takut akan suatu hari yang azabnya merata di mana-mana."},{"n":8,"w":[["وَيُطْعِمُونَ","dan mereka memberi makan","wayuṭ'ʿimūna",672],["ٱلطَّعَامَ","makanan","l-ṭaʿāma",437],["عَلَىٰ","atas","ʿalā",8],["حُبِّهِۦ","yang disukainya","ḥubbihi",887],["مِسْكِينًۭا","orang miskin","mis'kīnan",453],["وَيَتِيمًۭا","dan anak yatim","wayatīman",457],["وَأَسِيرًا","dan tawanan","wa-asīran",1483]],"t":"Dan mereka memberikan makanan yang disukainya kepada orang miskin, anak yatim dan orang yang ditawan,"},{"n":9,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["نُطْعِمُكُمْ","kami memberi makan kepadamu","nuṭ'ʿimukum",672],["لِوَجْهِ","karena mengharap keridhaan","liwajhi",169],["ٱللَّهِ","Allah","l-lahi",1],["لَا","tidak","lā",4],["نُرِيدُ","kami mengharap","nurīdu",83],["مِنكُمْ","dari kamu","minkum",0],["جَزَآءًۭ","balasan","jazāan",276],["وَلَا","dan tidak","walā",4],["شُكُورًا","terima kasih","shukūran",2102]],"t":"(sambil berkata), \"Sesungguhnya kami memberi makanan kepadamu hanyalah karena mengharapkan keridaan Allah, kami tidak mengharap balasan dan terima kasih dari kamu."},{"n":10,"w":[["إِنَّا","sesungguhnya kami","innā",5],["نَخَافُ","kami takut","nakhāfu",140],["مِن","dari","min",0],["رَّبِّنَا","Tuhan kami","rabbinā",10],["يَوْمًا","suatu hari","yawman",25],["عَبُوسًۭا","bermuka masam","ʿabūsan",3088],["قَمْطَرِيرًۭا","penuh kesulitan","qamṭarīran",4119]],"t":"Sungguh, kami takut akan (azab) Tuhan pada hari (ketika) orang-orang berwajah masam penuh kesulitan.\""},{"n":11,"w":[["فَوَقَىٰهُمُ","maka memelihara mereka","fawaqāhumu",605],["ٱللَّهُ","Allah","l-lahu",1],["شَرَّ","kejelekan/kesusahan","sharra",365],["ذَٰلِكَ","demikian/itu","dhālika",19],["ٱلْيَوْمِ","hari","l-yawmi",25],["وَلَقَّىٰهُمْ","dan Dia menemukan/memberikan pada mereka","walaqqāhum",1191],["نَضْرَةًۭ","pandangan/kejernihan","naḍratan",2556],["وَسُرُورًۭا","dan kegembiraan","wasurūran",4292]],"t":"Maka Allah melindungi mereka dari kesusahan hari itu, dan memberikan kepada mereka keceriaan dan kegembiraan."},{"n":12,"w":[["وَجَزَىٰهُم","dan Dia memberi balasan pada mereka","wajazāhum",164],["بِمَا","dengan apa/sebab","bimā",2],["صَبَرُوا۟","mereka sabar","ṣabarū",203],["جَنَّةًۭ","sorga","jannatan",77],["وَحَرِيرًۭا","dan sutera","waḥarīran",1786]],"t":"Dan Dia memberi balasan kepada mereka karena kesabarannya (berupa) surga dan (pakaian) sutera."},{"n":13,"w":[["مُّتَّكِـِٔينَ","mereka duduk bersandar","muttakiīna",991],["فِيهَا","didalamnya","fīhā",3],["عَلَى","atas","ʿalā",8],["ٱلْأَرَآئِكِ ۖ","pelaminan/dipan","l-arāiki",1275],["لَا","tidak","lā",4],["يَرَوْنَ","mereka melihat","yarawna",46],["فِيهَا","didalamnya","fīhā",3],["شَمْسًۭا","matahari","shamsan",343],["وَلَا","dan tidak","walā",4],["زَمْهَرِيرًۭا","kedinginan yang sangat","zamharīran",4585]],"t":"di sana mereka duduk bersandar di atas dipan, di sana mereka tidak melihat (merasakan teriknya) matahari dan tidak pula dingin yang berlebihan."},{"n":14,"w":[["وَدَانِيَةً","dan dekat","wadāniyatan",1823],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ظِلَـٰلُهَا","naungannya","ẓilāluhā",656],["وَذُلِّلَتْ","dan didekatkan/dimudahkan","wadhullilat",2108],["قُطُوفُهَا","buah-buahnya","quṭūfuhā",2592],["تَذْلِيلًۭا","sedekat-dekatnya/semudah-mudahnya","tadhlīlan",4309]],"t":"Dan naungan (pepohonan)nya dekat di atas mereka dan dimudahkan semudah-mudahnya untuk memetik (buah)nya."},{"n":15,"w":[["وَيُطَافُ","dan diedarkan","wayuṭāfu",964],["عَلَيْهِم","atas mereka","ʿalayhim",8],["بِـَٔانِيَةٍۢ","dengan bejana-bejana","biāniyatin",2104],["مِّن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1178],["وَأَكْوَابٍۢ","dan piala-piala","wa-akwābin",1575],["كَانَتْ","adalah ia","kānat",9],["قَوَارِيرَا۠","kaca-kaca","qawārīrā",1965]],"t":"Dan kepada mereka diedarkan bejana-bejana dari perak dan piala-piala yang bening laksana kristal,"},{"n":16,"w":[["قَوَارِيرَا۟","kaca-kaca","qawārīrā",1965],["مِن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1178],["قَدَّرُوهَا","mereka mengukurnya","qaddarūhā",599],["تَقْدِيرًۭا","dengan ukuran","taqdīran",1412]],"t":"kristal yang jernih terbuat dari perak, mereka tentukan ukurannya yang sesuai (dengan kehendak mereka)."},{"n":17,"w":[["وَيُسْقَوْنَ","dan mereka diberi minum","wayus'qawna",954],["فِيهَا","didalamnya","fīhā",3],["كَأْسًۭا","piala/gelas","kasan",1185],["كَانَ","adalah ia","kāna",9],["مِزَاجُهَا","campurannya","mizājuhā",1911],["زَنجَبِيلًا","jahe","zanjabīlan",4587]],"t":"Dan di sana mereka diberi segelas minuman bercampur jahe."},{"n":18,"w":[["عَيْنًۭا","mata air","ʿaynan",206],["فِيهَا","di dalamnya (di dalam sorga)","fīhā",3],["تُسَمَّىٰ","dinamakan","tusammā",1000],["سَلْسَبِيلًۭا","salsabil","salsabīlan",4266]],"t":"(Yang didatangkan dari) suatu mata air (di surga) yang dinamakan Salsabīl."},{"n":19,"w":[["۞ وَيَطُوفُ","dan mengelilingi","wayaṭūfu",964],["عَلَيْهِمْ","atas atas mereka","ʿalayhim",8],["وِلْدَٰنٌۭ","anak-anak muda","wil'dānun",1109],["مُّخَلَّدُونَ","mereka kekal/tetap","mukhalladūna",2549],["إِذَا","apabila","idhā",23],["رَأَيْتَهُمْ","kamu melihat mereka","ra-aytahum",46],["حَسِبْتَهُمْ","kamu mengira mereka","ḥasib'tahum",266],["لُؤْلُؤًۭا","mutiara","lu'lu-an",1192],["مَّنثُورًۭا","bertaburan","manthūran",2531]],"t":"Dan mereka dikelilingi oleh para pemuda-pemuda yang tetap muda. Apabila kamu melihatnya, akan kamu kira mereka, mutiara yang bertaburan."},{"n":20,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["رَأَيْتَ","kamu melihat","ra-ayta",46],["ثَمَّ","di sana","thamma",1664],["رَأَيْتَ","kamu melihat","ra-ayta",46],["نَعِيمًۭا","kenikmatan","naʿīman",574],["وَمُلْكًۭا","dan kerajaan","wamul'kan",250],["كَبِيرًا","yang besar","kabīran",288]],"t":"Dan apabila engkau melihat (keadaan) di sana (surga), niscaya engkau akan melihat berbagai macam kenikmatan dan kerajaan yang besar."},{"n":21,"w":[["عَـٰلِيَهُمْ","mereka memakai","ʿāliyahum",1142],["ثِيَابُ","pakaian","thiyābu",1004],["سُندُسٍ","sutera halus","sundusin",2012],["خُضْرٌۭ","yang hijau","khuḍ'run",1431],["وَإِسْتَبْرَقٌۭ ۖ","dan sutera tebal","wa-is'tabraqun",1457],["وَحُلُّوٓا۟","dan mereka diberi perhiasan","waḥullū",1510],["أَسَاوِرَ","gelang-gelang","asāwira",1406],["مِن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1178],["وَسَقَىٰهُمْ","dan memberi minum mereka","wasaqāhum",744],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["شَرَابًۭا","minuman","sharāban",753],["طَهُورًا","suci/bersih","ṭahūran",2299]],"t":"Mereka berpakaian sutera halus yang hijau dan sutera tebal dan memakai gelang terbuat dari perak, dan Tuhan memberikan kepada mereka minuman yang bersih (dan suci)."},{"n":22,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["كَانَ","adalah ia","kāna",9],["لَكُمْ","bagi kalian","lakum",26],["جَزَآءًۭ","balasan","jazāan",276],["وَكَانَ","dan adalah","wakāna",9],["سَعْيُكُم","usahamu","saʿyukum",856],["مَّشْكُورًا","disyukuri","mashkūran",2521]],"t":"Inilah balasan untukmu, dan segala usahamu diterima dan diakui (Allah)."},{"n":23,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["نَحْنُ","Kami","naḥnu",130],["نَزَّلْنَا","Kami telah turunkan","nazzalnā",195],["عَلَيْكَ","atasmu","ʿalayka",8],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",178],["تَنزِيلًۭا","turun","tanzīlan",636]],"t":"Sesungguhnya Kamilah yang menurunkan Alquran kepadamu (Muhammad) secara berangsur-angsur."},{"n":24,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",203],["لِحُكْمِ","bagi/untuk hukum","liḥuk'mi",367],["رَبِّكَ","Tuhanmu","rabbika",10],["وَلَا","dan jangan","walā",4],["تُطِعْ","kamu ikuti","tuṭiʿ",166],["مِنْهُمْ","di antara mereka","min'hum",0],["ءَاثِمًا","orang yang berdosa","āthiman",1754],["أَوْ","atau","aw",42],["كَفُورًۭا","orang yang kafir","kafūran",732]],"t":"Maka bersabarlah untuk (melaksanakan) ketetapan Tuhanmu, dan janganlah engkau ikuti orang yang berdosa dan orang yang kafir di antara mereka."},{"n":25,"w":[["وَٱذْكُرِ","dan ingatlah/sebutlah","wa-udh'kuri",134],["ٱسْمَ","nama","is'ma",309],["رَبِّكَ","Tuhanmu","rabbika",10],["بُكْرَةًۭ","di waktu pagi","buk'ratan",1060],["وَأَصِيلًۭا","dan petang","wa-aṣīlan",1027]],"t":"Dan sebutlah nama Tuhanmu pada (waktu) pagi dan petang."},{"n":26,"w":[["وَمِنَ","dan dari","wamina",0],["ٱلَّيْلِ","sebagian malam","al-layli",136],["فَٱسْجُدْ","maka bersujudlah","fa-us'jud",335],["لَهُۥ","kepada-Nya","lahu",16],["وَسَبِّحْهُ","dan bertasbihlah kepada-Nya","wasabbiḥ'hu",279],["لَيْلًۭا","malam","laylan",136],["طَوِيلًا","panjang","ṭawīlan",2302]],"t":"Dan pada sebagian dari malam, maka bersujudlah kepada-Nya dan bertasbihlah kepada-Nya pada bagian yang panjang di malam hari."},{"n":27,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["يُحِبُّونَ","mereka mencintai","yuḥibbūna",188],["ٱلْعَاجِلَةَ","cepat-cepat/kehidupan","l-ʿājilata",1764],["وَيَذَرُونَ","dan mereka meninggalkan","wayadharūna",262],["وَرَآءَهُمْ","di belakang mereka","warāahum",442],["يَوْمًۭا","hari","yawman",25],["ثَقِيلًۭا","yang berat","thaqīlan",1417]],"t":"Sesungguhnya mereka (orang kafir) itu mencintai kehidupan (dunia) dan meningggalkan hari yang berat (hari akhirat) di belakangnya."},{"n":28,"w":[["نَّحْنُ","Kami","naḥnu",130],["خَلَقْنَـٰهُمْ","Kami menciptakan mereka","khalaqnāhum",61],["وَشَدَدْنَآ","dan Kami kuatkan","washadadnā",1122],["أَسْرَهُمْ ۖ","tubuh mereka","asrahum",3011],["وَإِذَا","dan apabila","wa-idhā",23],["شِئْنَا","Kami menghendaki","shi'nā",54],["بَدَّلْنَآ","Kami mengganti","baddalnā",449],["أَمْثَـٰلَهُمْ","serupa mereka","amthālahum",128],["تَبْدِيلًا","penggantian","tabdīlan",1103]],"t":"Kami telah menciptakan mereka dan menguatkan persendian tubuh mereka. Tetapi, jika Kami menghendaki, Kami dapat mengganti dengan yang serupa mereka."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذِهِۦ","ini","hādhihi",37],["تَذْكِرَةٌۭ ۖ","peringatan/pengajaran","tadhkiratun",929],["فَمَن","maka barang siapa","faman",12],["شَآءَ","dia menghendaki","shāa",54],["ٱتَّخَذَ","dia mengambil","ittakhadha",98],["إِلَىٰ","kepada","ilā",13],["رَبِّهِۦ","Tuhannya","rabbihi",10],["سَبِيلًۭا","jalan","sabīlan",64]],"t":"Sungguh, (ayat-ayat) ini adalah peringatan, maka barang siapa menghendaki (kebaikan bagi dirinya) tentu dia mengambil jalan menuju kepada Tuhannya."},{"n":30,"w":[["وَمَا","dan tidak","wamā",2],["تَشَآءُونَ","kamu menghendaki","tashāūna",54],["إِلَّآ","kecuali","illā",15],["أَن","bahwa","an",17],["يَشَآءَ","menghendaki","yashāa",54],["ٱللَّهُ ۚ","Allah","l-lahu",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["كَانَ","adalah ia","kāna",9],["عَلِيمًا","Maha Mengetahui","ʿalīman",68],["حَكِيمًۭا","Maha Bijaksana","ḥakīman",115]],"t":"Tetapi kamu tidak mampu (menempuh jalan itu), kecuali apabila dikehendaki Allah. Sungguh, Allah Maha Mengetahui, Mahabijaksana."},{"n":31,"w":[["يُدْخِلُ","Dia memasukkan","yud'khilu",275],["مَن","siapa","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["فِى","dalam","fī",3],["رَحْمَتِهِۦ ۚ","rahmat-Nya","raḥmatihi",105],["وَٱلظَّـٰلِمِينَ","dan orang-orang zalim","wal-ẓālimīna",88],["أَعَدَّ","Dia sediakan","aʿadda",496],["لَهُمْ","bagi mereka","lahum",11],["عَذَابًا","azab","ʿadhāban",36],["أَلِيمًۢا","pedih","alīman",167]],"t":"Dia memasukkan siapa pun yang Dia kehendaki ke dalam rahmat-Nya (surga). Adapun bagi orang-orang zalim disediakan-Nya azab yang pedih."}]