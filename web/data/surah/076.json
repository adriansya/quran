[{"n":1,"w":[["هَلْ","apakah/bukankah","hal",115],["أَتَىٰ","telah datang","atā",48],["عَلَى","atas","ʿalā",8],["ٱلْإِنسَـٰنِ","manusia","l-insāni",167],["حِينٌۭ","waktu","ḥīnun",328],["مِّنَ","dari","mina",0],["ٱلدَّهْرِ","masa","l-dahri",2359],["لَمْ","tidaklah","lam",32],["يَكُن","dia","yakun",9],["شَيْـًۭٔا","sesuatu","shayan",41],["مَّذْكُورًا","yang disebut","madhkūran",3915]],"t":"Bukankah pernah datang kepada manusia waktu dari masa, yang ketika itu belum merupakan sesuatu yang dapat disebut?"},{"n":2,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",60],["ٱلْإِنسَـٰنَ","manusia","l-insāna",167],["مِن","dari","min",0],["نُّطْفَةٍ","setetes mani","nuṭ'fatin",737],["أَمْشَاجٍۢ","bercampur","amshājin",3011],["نَّبْتَلِيهِ","Kami mengujinya","nabtalīhi",1021],["فَجَعَلْنَـٰهُ","maka Kami jadikan ia","fajaʿalnāhu",33],["سَمِيعًۢا","mendengar","samīʿan",252],["بَصِيرًا","melihat","baṣīran",232]],"t":"Sungguh, Kami telah menciptakan manusia dari setetes mani yang bercampur yang Kami hendak mengujinya (dengan perintah dan larangan), karena itu Kami jadikan dia mendengar dan melihat."},{"n":3,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["هَدَيْنَـٰهُ","Kami beri petunjuk padanya","hadaynāhu",79],["ٱلسَّبِيلَ","jalan","l-sabīla",64],["إِمَّا","terkadang/adakalanya","immā",449],["شَاكِرًۭا","bersyukur","shākiran",644],["وَإِمَّا","dan terkadang","wa-immā",449],["كَفُورًا","kufur/ingkar","kafūran",731]],"t":"Sungguh, Kami telah menunjukkan kepadanya jalan yang lurus; ada yang bersyukur dan ada pula yang kufur."},{"n":4,"w":[["إِنَّآ","sesungguhnya kami","innā",5],["أَعْتَدْنَا","Kami menyediakan","aʿtadnā",646],["لِلْكَـٰفِرِينَ","bagi orang-orang kafir","lil'kāfirīna",90],["سَلَـٰسِلَا۟","rantai-rantai","salāsilā",1994],["وَأَغْلَـٰلًۭا","dan belenggu-belenggu","wa-aghlālan",901],["وَسَعِيرًا","dan neraka yang menyala-nyala","wasaʿīran",605]],"t":"Sungguh, Kami telah menyediakan bagi orang-orang kafir rantai, belenggu dan neraka yang menyala-nyala."},{"n":5,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْأَبْرَارَ","yang berbuat baik","l-abrāra",465],["يَشْرَبُونَ","mereka akan minum","yashrabūna",614],["مِن","dari","min",0],["كَأْسٍۢ","piala/gelas","kasin",1188],["كَانَ","adalah ia","kāna",9],["مِزَاجُهَا","campurannya","mizājuhā",1897],["كَافُورًا","air kafur","kāfūran",3569]],"t":"Sungguh, orang-orang yang berbuat kebajikan akan minum dari gelas (berisi minuman) yang campurannya adalah air kafur,"},{"n":6,"w":[["عَيْنًۭا","mata air","ʿaynan",207],["يَشْرَبُ","minuman","yashrabu",614],["بِهَا","padanya","bihā",94],["عِبَادُ","hamba-hamba","ʿibādu",87],["ٱللَّهِ","Allah","l-lahi",1],["يُفَجِّرُونَهَا","mereka memancarkannya/mengalirkannya","yufajjirūnahā",1181],["تَفْجِيرًۭا","dengan pancaran/aliran","tafjīran",2669]],"t":"(yaitu) mata air (dalam surga) yang di minum oleh hamba-hamba Allah dan mereka dapat memancarkannya dengan sebaik-baiknya."},{"n":7,"w":[["يُوفُونَ","mereka memenuhi","yūfūna",541],["بِٱلنَّذْرِ","dengan nazar","bil-nadhri",2568],["وَيَخَافُونَ","dan mereka takut","wayakhāfūna",136],["يَوْمًۭا","hari","yawman",25],["كَانَ","adalah ia","kāna",9],["شَرُّهُۥ","bahayanya/azabnya","sharruhu",360],["مُسْتَطِيرًۭا","merata kemana-mana","mus'taṭīran",3866]],"t":"Mereka memenuhi nazar dan takut akan suatu hari yang azabnya merata di mana-mana."},{"n":8,"w":[["وَيُطْعِمُونَ","dan mereka memberi makan","wayuṭ'ʿimūna",677],["ٱلطَّعَامَ","makanan","l-ṭaʿāma",439],["عَلَىٰ","atas","ʿalā",8],["حُبِّهِۦ","yang disukainya","ḥubbihi",888],["مِسْكِينًۭا","orang miskin","mis'kīnan",457],["وَيَتِيمًۭا","dan anak yatim","wayatīman",461],["وَأَسِيرًا","dan tawanan","wa-asīran",1482]],"t":"Dan mereka memberikan makanan yang disukainya kepada orang miskin, anak yatim dan orang yang ditawan,"},{"n":9,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["نُطْعِمُكُمْ","kami memberi makan kepadamu","nuṭ'ʿimukum",677],["لِوَجْهِ","karena mengharap keridhaan","liwajhi",166],["ٱللَّهِ","Allah","l-lahi",1],["لَا","tidak","lā",4],["نُرِيدُ","kami mengharap","nurīdu",81],["مِنكُمْ","dari kamu","minkum",0],["جَزَآءًۭ","balasan","jazāan",275],["وَلَا","dan tidak","walā",4],["شُكُورًا","terima kasih","shukūran",2122]],"t":"(sambil berkata), \"Sesungguhnya kami memberi makanan kepadamu hanyalah karena mengharapkan keridaan Allah, kami tidak mengharap balasan dan terima kasih dari kamu."},{"n":10,"w":[["إِنَّا","sesungguhnya kami","innā",5],["نَخَافُ","kami takut","nakhāfu",136],["مِن","dari","min",0],["رَّبِّنَا","Tuhan kami","rabbinā",10],["يَوْمًا","suatu hari","yawman",25],["عَبُوسًۭا","bermuka masam","ʿabūsan",3107],["قَمْطَرِيرًۭا","penuh kesulitan","qamṭarīran",4137]],"t":"Sungguh, kami takut akan (azab) Tuhan pada hari (ketika) orang-orang berwajah masam penuh kesulitan.\""},{"n":11,"w":[["فَوَقَىٰهُمُ","maka memelihara mereka","fawaqāhumu",608],["ٱللَّهُ","Allah","l-lahu",1],["شَرَّ","kejelekan/kesusahan","sharra",360],["ذَٰلِكَ","demikian/itu","dhālika",19],["ٱلْيَوْمِ","hari","l-yawmi",25],["وَلَقَّىٰهُمْ","dan Dia menemukan/memberikan pada mereka","walaqqāhum",1194],["نَضْرَةًۭ","pandangan/kejernihan","naḍratan",2552],["وَسُرُورًۭا","dan kegembiraan","wasurūran",4295]],"t":"Maka Allah melindungi mereka dari kesusahan hari itu, dan memberikan kepada mereka keceriaan dan kegembiraan."},{"n":12,"w":[["وَجَزَىٰهُم","dan Dia memberi balasan pada mereka","wajazāhum",161],["بِمَا","dengan apa/sebab","bimā",2],["صَبَرُوا۟","mereka sabar","ṣabarū",205],["جَنَّةًۭ","sorga","jannatan",76],["وَحَرِيرًۭا","dan sutera","waḥarīran",1780]],"t":"Dan Dia memberi balasan kepada mereka karena kesabarannya (berupa) surga dan (pakaian) sutera."},{"n":13,"w":[["مُّتَّكِـِٔينَ","mereka duduk bersandar","muttakiīna",991],["فِيهَا","didalamnya","fīhā",3],["عَلَى","atas","ʿalā",8],["ٱلْأَرَآئِكِ ۖ","pelaminan/dipan","l-arāiki",1276],["لَا","tidak","lā",4],["يَرَوْنَ","mereka melihat","yarawna",46],["فِيهَا","didalamnya","fīhā",3],["شَمْسًۭا","matahari","shamsan",342],["وَلَا","dan tidak","walā",4],["زَمْهَرِيرًۭا","kedinginan yang sangat","zamharīran",4769]],"t":"di sana mereka duduk bersandar di atas dipan, di sana mereka tidak melihat (merasakan teriknya) matahari dan tidak pula dingin yang berlebihan."},{"n":14,"w":[["وَدَانِيَةً","dan dekat","wadāniyatan",1820],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ظِلَـٰلُهَا","naungannya","ẓilāluhā",659],["وَذُلِّلَتْ","dan didekatkan/dimudahkan","wadhullilat",2133],["قُطُوفُهَا","buah-buahnya","quṭūfuhā",2590],["تَذْلِيلًۭا","sedekat-dekatnya/semudah-mudahnya","tadhlīlan",4322]],"t":"Dan naungan (pepohonan)nya dekat di atas mereka dan dimudahkan semudah-mudahnya untuk memetik (buah)nya."},{"n":15,"w":[["وَيُطَافُ","dan diedarkan","wayuṭāfu",965],["عَلَيْهِم","atas mereka","ʿalayhim",8],["بِـَٔانِيَةٍۢ","dengan bejana-bejana","biāniyatin",2125],["مِّن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1180],["وَأَكْوَابٍۢ","dan piala-piala","wa-akwābin",1470],["كَانَتْ","adalah ia","kānat",9],["قَوَارِيرَا۠","kaca-kaca","qawārīrā",1960]],"t":"Dan kepada mereka diedarkan bejana-bejana dari perak dan piala-piala yang bening laksana kristal,"},{"n":16,"w":[["قَوَارِيرَا۟","kaca-kaca","qawārīrā",1960],["مِن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1180],["قَدَّرُوهَا","mereka mengukurnya","qaddarūhā",601],["تَقْدِيرًۭا","dengan ukuran","taqdīran",1405]],"t":"kristal yang jernih terbuat dari perak, mereka tentukan ukurannya yang sesuai (dengan kehendak mereka)."},{"n":17,"w":[["وَيُسْقَوْنَ","dan mereka diberi minum","wayus'qawna",955],["فِيهَا","didalamnya","fīhā",3],["كَأْسًۭا","piala/gelas","kasan",1188],["كَانَ","adalah ia","kāna",9],["مِزَاجُهَا","campurannya","mizājuhā",1897],["زَنجَبِيلًا","jahe","zanjabīlan",4771]],"t":"Dan di sana mereka diberi segelas minuman bercampur jahe."},{"n":18,"w":[["عَيْنًۭا","mata air","ʿaynan",207],["فِيهَا","di dalamnya (di dalam sorga)","fīhā",3],["تُسَمَّىٰ","dinamakan","tusammā",1000],["سَلْسَبِيلًۭا","salsabil","salsabīlan",4266]],"t":"(Yang didatangkan dari) suatu mata air (di surga) yang dinamakan Salsabīl."},{"n":19,"w":[["۞ وَيَطُوفُ","dan mengelilingi","wayaṭūfu",965],["عَلَيْهِمْ","atas atas mereka","ʿalayhim",8],["وِلْدَٰنٌۭ","anak-anak muda","wil'dānun",1114],["مُّخَلَّدُونَ","mereka kekal/tetap","mukhalladūna",2546],["إِذَا","apabila","idhā",23],["رَأَيْتَهُمْ","kamu melihat mereka","ra-aytahum",46],["حَسِبْتَهُمْ","kamu mengira mereka","ḥasib'tahum",265],["لُؤْلُؤًۭا","mutiara","lu'lu-an",1195],["مَّنثُورًۭا","bertaburan","manthūran",2527]],"t":"Dan mereka dikelilingi oleh para pemuda-pemuda yang tetap muda. Apabila kamu melihatnya, akan kamu kira mereka, mutiara yang bertaburan."},{"n":20,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["رَأَيْتَ","kamu melihat","ra-ayta",46],["ثَمَّ","di sana","thamma",1653],["رَأَيْتَ","kamu melihat","ra-ayta",46],["نَعِيمًۭا","kenikmatan","naʿīman",576],["وَمُلْكًۭا","dan kerajaan","wamul'kan",249],["كَبِيرًا","yang besar","kabīran",290]],"t":"Dan apabila engkau melihat (keadaan) di sana (surga), niscaya engkau akan melihat berbagai macam kenikmatan dan kerajaan yang besar."},{"n":21,"w":[["عَـٰلِيَهُمْ","mereka memakai","ʿāliyahum",1495],["ثِيَابُ","pakaian","thiyābu",1005],["سُندُسٍ","sutera halus","sundusin",1996],["خُضْرٌۭ","yang hijau","khuḍ'run",1424],["وَإِسْتَبْرَقٌۭ ۖ","dan sutera tebal","wa-is'tabraqun",1459],["وَحُلُّوٓا۟","dan mereka diberi perhiasan","waḥullū",1515],["أَسَاوِرَ","gelang-gelang","asāwira",1279],["مِن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1180],["وَسَقَىٰهُمْ","dan memberi minum mereka","wasaqāhum",742],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["شَرَابًۭا","minuman","sharāban",756],["طَهُورًا","suci/bersih","ṭahūran",2307]],"t":"Mereka berpakaian sutera halus yang hijau dan sutera tebal dan memakai gelang terbuat dari perak, dan Tuhan memberikan kepada mereka minuman yang bersih (dan suci)."},{"n":22,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["كَانَ","adalah ia","kāna",9],["لَكُمْ","bagi kalian","lakum",26],["جَزَآءًۭ","balasan","jazāan",275],["وَكَانَ","dan adalah","wakāna",9],["سَعْيُكُم","usahamu","saʿyukum",858],["مَّشْكُورًا","disyukuri","mashkūran",2516]],"t":"Inilah balasan untukmu, dan segala usahamu diterima dan diakui (Allah)."},{"n":23,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["نَحْنُ","Kami","naḥnu",126],["نَزَّلْنَا","Kami telah turunkan","nazzalnā",197],["عَلَيْكَ","atasmu","ʿalayka",8],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",175],["تَنزِيلًۭا","turun","tanzīlan",639]],"t":"Sesungguhnya Kamilah yang menurunkan Alquran kepadamu (Muhammad) secara berangsur-angsur."},{"n":24,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",205],["لِحُكْمِ","bagi/untuk hukum","liḥuk'mi",362],["رَبِّكَ","Tuhanmu","rabbika",10],["وَلَا","dan jangan","walā",4],["تُطِعْ","kamu ikuti","tuṭiʿ",163],["مِنْهُمْ","di antara mereka","min'hum",0],["ءَاثِمًا","orang yang berdosa","āthiman",1754],["أَوْ","atau","aw",42],["كَفُورًۭا","orang yang kafir","kafūran",731]],"t":"Maka bersabarlah untuk (melaksanakan) ketetapan Tuhanmu, dan janganlah engkau ikuti orang yang berdosa dan orang yang kafir di antara mereka."},{"n":25,"w":[["وَٱذْكُرِ","dan ingatlah/sebutlah","wa-udh'kuri",130],["ٱسْمَ","nama","is'ma",305],["رَبِّكَ","Tuhanmu","rabbika",10],["بُكْرَةًۭ","di waktu pagi","buk'ratan",1067],["وَأَصِيلًۭا","dan petang","wa-aṣīlan",1033]],"t":"Dan sebutlah nama Tuhanmu pada (waktu) pagi dan petang."},{"n":26,"w":[["وَمِنَ","dan dari","wamina",0],["ٱلَّيْلِ","sebagian malam","al-layli",132],["فَٱسْجُدْ","maka bersujudlah","fa-us'jud",334],["لَهُۥ","kepada-Nya","lahu",16],["وَسَبِّحْهُ","dan bertasbihlah kepada-Nya","wasabbiḥ'hu",276],["لَيْلًۭا","malam","laylan",132],["طَوِيلًا","panjang","ṭawīlan",2310]],"t":"Dan pada sebagian dari malam, maka bersujudlah kepada-Nya dan bertasbihlah kepada-Nya pada bagian yang panjang di malam hari."},{"n":27,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["يُحِبُّونَ","mereka mencintai","yuḥibbūna",186],["ٱلْعَاجِلَةَ","cepat-cepat/kehidupan","l-ʿājilata",1762],["وَيَذَرُونَ","dan mereka meninggalkan","wayadharūna",262],["وَرَآءَهُمْ","di belakang mereka","warāahum",445],["يَوْمًۭا","hari","yawman",25],["ثَقِيلًۭا","yang berat","thaqīlan",1410]],"t":"Sesungguhnya mereka (orang kafir) itu mencintai kehidupan (dunia) dan meningggalkan hari yang berat (hari akhirat) di belakangnya."},{"n":28,"w":[["نَّحْنُ","Kami","naḥnu",126],["خَلَقْنَـٰهُمْ","Kami menciptakan mereka","khalaqnāhum",60],["وَشَدَدْنَآ","dan Kami kuatkan","washadadnā",1130],["أَسْرَهُمْ ۖ","tubuh mereka","asrahum",3037],["وَإِذَا","dan apabila","wa-idhā",23],["شِئْنَا","Kami menghendaki","shi'nā",54],["بَدَّلْنَآ","Kami mengganti","baddalnā",453],["أَمْثَـٰلَهُمْ","serupa mereka","amthālahum",124],["تَبْدِيلًا","penggantian","tabdīlan",1108]],"t":"Kami telah menciptakan mereka dan menguatkan persendian tubuh mereka. Tetapi, jika Kami menghendaki, Kami dapat mengganti dengan yang serupa mereka."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذِهِۦ","ini","hādhihi",37],["تَذْكِرَةٌۭ ۖ","peringatan/pengajaran","tadhkiratun",925],["فَمَن","maka barang siapa","faman",12],["شَآءَ","dia menghendaki","shāa",54],["ٱتَّخَذَ","dia mengambil","ittakhadha",95],["إِلَىٰ","kepada","ilā",13],["رَبِّهِۦ","Tuhannya","rabbihi",10],["سَبِيلًۭا","jalan","sabīlan",64]],"t":"Sungguh, (ayat-ayat) ini adalah peringatan, maka barang siapa menghendaki (kebaikan bagi dirinya) tentu dia mengambil jalan menuju kepada Tuhannya."},{"n":30,"w":[["وَمَا","dan tidak","wamā",2],["تَشَآءُونَ","kamu menghendaki","tashāūna",54],["إِلَّآ","kecuali","illā",15],["أَن","bahwa","an",17],["يَشَآءَ","menghendaki","yashāa",54],["ٱللَّهُ ۚ","Allah","l-lahu",1],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["كَانَ","adalah ia","kāna",9],["عَلِيمًا","Maha Mengetahui","ʿalīman",68],["حَكِيمًۭا","Maha Bijaksana","ḥakīman",112]],"t":"Tetapi kamu tidak mampu (menempuh jalan itu), kecuali apabila dikehendaki Allah. Sungguh, Allah Maha Mengetahui, Mahabijaksana."},{"n":31,"w":[["يُدْخِلُ","Dia memasukkan","yud'khilu",274],["مَن","siapa","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["فِى","dalam","fī",3],["رَحْمَتِهِۦ ۚ","rahmat-Nya","raḥmatihi",103],["وَٱلظَّـٰلِمِينَ","dan orang-orang zalim","wal-ẓālimīna",89],["أَعَدَّ","Dia sediakan","aʿadda",500],["لَهُمْ","bagi mereka","lahum",11],["عَذَابًا","azab","ʿadhāban",36],["أَلِيمًۢا","pedih","alīman",164]],"t":"Dia memasukkan siapa pun yang Dia kehendaki ke dalam rahmat-Nya (surga). Adapun bagi orang-orang zalim disediakan-Nya azab yang pedih."}]