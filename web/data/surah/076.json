[{"n":1,"w":[["هَلْ","apakah/bukankah","hal",128],["أَتَىٰ","telah datang","atā",56],["عَلَى","atas","ʿalā",11],["ٱلْإِنسَـٰنِ","manusia","l-insāni",181],["حِينٌۭ","waktu","ḥīnun",345],["مِّنَ","dari","mina",1],["ٱلدَّهْرِ","masa","l-dahri",2366],["لَمْ","tidaklah","lam",39],["يَكُن","dia","yakun",12],["شَيْـًۭٔا","sesuatu","shayan",49],["مَّذْكُورًا","yang disebut","madhkūran",3920]],"t":"Bukankah pernah datang kepada manusia waktu dari masa, yang ketika itu belum merupakan sesuatu yang dapat disebut?"},{"n":2,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",70],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["مِن","dari","min",1],["نُّطْفَةٍ","setetes mani","nuṭ'fatin",753],["أَمْشَاجٍۢ","bercampur","amshājin",3664],["نَّبْتَلِيهِ","Kami mengujinya","nabtalīhi",1032],["فَجَعَلْنَـٰهُ","maka Kami jadikan ia","fajaʿalnāhu",40],["سَمِيعًۢا","mendengar","samīʿan",266],["بَصِيرًا","melihat","baṣīran",244]],"t":"Sungguh, Kami telah menciptakan manusia dari setetes mani yang bercampur yang Kami hendak mengujinya (dengan perintah dan larangan), karena itu Kami jadikan dia mendengar dan melihat."},{"n":3,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["هَدَيْنَـٰهُ","Kami beri petunjuk padanya","hadaynāhu",89],["ٱلسَّبِيلَ","jalan","l-sabīla",73],["إِمَّا","terkadang/adakalanya","immā",459],["شَاكِرًۭا","bersyukur","shākiran",655],["وَإِمَّا","dan terkadang","wa-immā",459],["كَفُورًا","kufur/ingkar","kafūran",747]],"t":"Sungguh, Kami telah menunjukkan kepadanya jalan yang lurus; ada yang bersyukur dan ada pula yang kufur."},{"n":4,"w":[["إِنَّآ","sesungguhnya kami","innā",9],["أَعْتَدْنَا","Kami menyediakan","aʿtadnā",657],["لِلْكَـٰفِرِينَ","bagi orang-orang kafir","lil'kāfirīna",79],["سَلَـٰسِلَا۟","rantai-rantai","salāsilā",2026],["وَأَغْلَـٰلًۭا","dan belenggu-belenggu","wa-aghlālan",920],["وَسَعِيرًا","dan neraka yang menyala-nyala","wasaʿīran",617]],"t":"Sungguh, Kami telah menyediakan bagi orang-orang kafir rantai, belenggu dan neraka yang menyala-nyala."},{"n":5,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْأَبْرَارَ","yang berbuat baik","l-abrāra",476],["يَشْرَبُونَ","mereka akan minum","yashrabūna",625],["مِن","dari","min",1],["كَأْسٍۢ","piala/gelas","kasin",1202],["كَانَ","adalah ia","kāna",12],["مِزَاجُهَا","campurannya","mizājuhā",1928],["كَافُورًا","air kafur","kāfūran",3597]],"t":"Sungguh, orang-orang yang berbuat kebajikan akan minum dari gelas (berisi minuman) yang campurannya adalah air kafur,"},{"n":6,"w":[["عَيْنًۭا","mata air","ʿaynan",218],["يَشْرَبُ","minuman","yashrabu",625],["بِهَا","padanya","bihā",106],["عِبَادُ","hamba-hamba","ʿibādu",99],["ٱللَّهِ","Allah","l-lahi",4],["يُفَجِّرُونَهَا","mereka memancarkannya/mengalirkannya","yufajjirūnahā",1190],["تَفْجِيرًۭا","dengan pancaran/aliran","tafjīran",2695]],"t":"(yaitu) mata air (dalam surga) yang di minum oleh hamba-hamba Allah dan mereka dapat memancarkannya dengan sebaik-baiknya."},{"n":7,"w":[["يُوفُونَ","mereka memenuhi","yūfūna",554],["بِٱلنَّذْرِ","dengan nazar","bil-nadhri",2587],["وَيَخَافُونَ","dan mereka takut","wayakhāfūna",150],["يَوْمًۭا","hari","yawman",31],["كَانَ","adalah ia","kāna",12],["شَرُّهُۥ","bahayanya/azabnya","sharruhu",380],["مُسْتَطِيرًۭا","merata kemana-mana","mus'taṭīran",3871]],"t":"Mereka memenuhi nazar dan takut akan suatu hari yang azabnya merata di mana-mana."},{"n":8,"w":[["وَيُطْعِمُونَ","dan mereka memberi makan","wayuṭ'ʿimūna",687],["ٱلطَّعَامَ","makanan","l-ṭaʿāma",452],["عَلَىٰ","atas","ʿalā",11],["حُبِّهِۦ","yang disukainya","ḥubbihi",904],["مِسْكِينًۭا","orang miskin","mis'kīnan",467],["وَيَتِيمًۭا","dan anak yatim","wayatīman",471],["وَأَسِيرًا","dan tawanan","wa-asīran",1503]],"t":"Dan mereka memberikan makanan yang disukainya kepada orang miskin, anak yatim dan orang yang ditawan,"},{"n":9,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["نُطْعِمُكُمْ","kami memberi makan kepadamu","nuṭ'ʿimukum",687],["لِوَجْهِ","karena mengharap keridhaan","liwajhi",180],["ٱللَّهِ","Allah","l-lahi",4],["لَا","tidak","lā",8],["نُرِيدُ","kami mengharap","nurīdu",92],["مِنكُمْ","dari kamu","minkum",1],["جَزَآءًۭ","balasan","jazāan",290],["وَلَا","dan tidak","walā",8],["شُكُورًا","terima kasih","shukūran",2117]],"t":"(sambil berkata), \"Sesungguhnya kami memberi makanan kepadamu hanyalah karena mengharapkan keridaan Allah, kami tidak mengharap balasan dan terima kasih dari kamu."},{"n":10,"w":[["إِنَّا","sesungguhnya kami","innā",9],["نَخَافُ","kami takut","nakhāfu",150],["مِن","dari","min",1],["رَّبِّنَا","Tuhan kami","rabbinā",15],["يَوْمًا","suatu hari","yawman",31],["عَبُوسًۭا","bermuka masam","ʿabūsan",3099],["قَمْطَرِيرًۭا","penuh kesulitan","qamṭarīran",4125]],"t":"Sungguh, kami takut akan (azab) Tuhan pada hari (ketika) orang-orang berwajah masam penuh kesulitan.\""},{"n":11,"w":[["فَوَقَىٰهُمُ","maka memelihara mereka","fawaqāhumu",619],["ٱللَّهُ","Allah","l-lahu",4],["شَرَّ","kejelekan/kesusahan","sharra",380],["ذَٰلِكَ","demikian/itu","dhālika",26],["ٱلْيَوْمِ","hari","l-yawmi",31],["وَلَقَّىٰهُمْ","dan Dia menemukan/memberikan pada mereka","walaqqāhum",1208],["نَضْرَةًۭ","pandangan/kejernihan","naḍratan",2568],["وَسُرُورًۭا","dan kegembiraan","wasurūran",4298]],"t":"Maka Allah melindungi mereka dari kesusahan hari itu, dan memberikan kepada mereka keceriaan dan kegembiraan."},{"n":12,"w":[["وَجَزَىٰهُم","dan Dia memberi balasan pada mereka","wajazāhum",175],["بِمَا","dengan apa/sebab","bimā",6],["صَبَرُوا۟","mereka sabar","ṣabarū",215],["جَنَّةًۭ","sorga","jannatan",86],["وَحَرِيرًۭا","dan sutera","waḥarīran",1809]],"t":"Dan Dia memberi balasan kepada mereka karena kesabarannya (berupa) surga dan (pakaian) sutera."},{"n":13,"w":[["مُّتَّكِـِٔينَ","mereka duduk bersandar","muttakiīna",1008],["فِيهَا","didalamnya","fīhā",7],["عَلَى","atas","ʿalā",11],["ٱلْأَرَآئِكِ ۖ","pelaminan/dipan","l-arāiki",1292],["لَا","tidak","lā",8],["يَرَوْنَ","mereka melihat","yarawna",54],["فِيهَا","didalamnya","fīhā",7],["شَمْسًۭا","matahari","shamsan",358],["وَلَا","dan tidak","walā",8],["زَمْهَرِيرًۭا","kedinginan yang sangat","zamharīran",4591]],"t":"di sana mereka duduk bersandar di atas dipan, di sana mereka tidak melihat (merasakan teriknya) matahari dan tidak pula dingin yang berlebihan."},{"n":14,"w":[["وَدَانِيَةً","dan dekat","wadāniyatan",1845],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["ظِلَـٰلُهَا","naungannya","ẓilāluhā",670],["وَذُلِّلَتْ","dan didekatkan/dimudahkan","wadhullilat",2123],["قُطُوفُهَا","buah-buahnya","quṭūfuhā",2604],["تَذْلِيلًۭا","sedekat-dekatnya/semudah-mudahnya","tadhlīlan",4315]],"t":"Dan naungan (pepohonan)nya dekat di atas mereka dan dimudahkan semudah-mudahnya untuk memetik (buah)nya."},{"n":15,"w":[["وَيُطَافُ","dan diedarkan","wayuṭāfu",981],["عَلَيْهِم","atas mereka","ʿalayhim",11],["بِـَٔانِيَةٍۢ","dengan bejana-bejana","biāniyatin",2119],["مِّن","dari","min",1],["فِضَّةٍۢ","perak","fiḍḍatin",1195],["وَأَكْوَابٍۢ","dan piala-piala","wa-akwābin",1596],["كَانَتْ","adalah ia","kānat",12],["قَوَارِيرَا۠","kaca-kaca","qawārīrā",1981]],"t":"Dan kepada mereka diedarkan bejana-bejana dari perak dan piala-piala yang bening laksana kristal,"},{"n":16,"w":[["قَوَارِيرَا۟","kaca-kaca","qawārīrā",1981],["مِن","dari","min",1],["فِضَّةٍۢ","perak","fiḍḍatin",1195],["قَدَّرُوهَا","mereka mengukurnya","qaddarūhā",613],["تَقْدِيرًۭا","dengan ukuran","taqdīran",1432]],"t":"kristal yang jernih terbuat dari perak, mereka tentukan ukurannya yang sesuai (dengan kehendak mereka)."},{"n":17,"w":[["وَيُسْقَوْنَ","dan mereka diberi minum","wayus'qawna",971],["فِيهَا","didalamnya","fīhā",7],["كَأْسًۭا","piala/gelas","kasan",1202],["كَانَ","adalah ia","kāna",12],["مِزَاجُهَا","campurannya","mizājuhā",1928],["زَنجَبِيلًا","jahe","zanjabīlan",4593]],"t":"Dan di sana mereka diberi segelas minuman bercampur jahe."},{"n":18,"w":[["عَيْنًۭا","mata air","ʿaynan",218],["فِيهَا","di dalamnya (di dalam sorga)","fīhā",7],["تُسَمَّىٰ","dinamakan","tusammā",1017],["سَلْسَبِيلًۭا","salsabil","salsabīlan",4272]],"t":"(Yang didatangkan dari) suatu mata air (di surga) yang dinamakan Salsabīl."},{"n":19,"w":[["۞ وَيَطُوفُ","dan mengelilingi","wayaṭūfu",981],["عَلَيْهِمْ","atas atas mereka","ʿalayhim",11],["وِلْدَٰنٌۭ","anak-anak muda","wil'dānun",1126],["مُّخَلَّدُونَ","mereka kekal/tetap","mukhalladūna",2561],["إِذَا","apabila","idhā",29],["رَأَيْتَهُمْ","kamu melihat mereka","ra-aytahum",54],["حَسِبْتَهُمْ","kamu mengira mereka","ḥasib'tahum",280],["لُؤْلُؤًۭا","mutiara","lu'lu-an",1209],["مَّنثُورًۭا","bertaburan","manthūran",2543]],"t":"Dan mereka dikelilingi oleh para pemuda-pemuda yang tetap muda. Apabila kamu melihatnya, akan kamu kira mereka, mutiara yang bertaburan."},{"n":20,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["رَأَيْتَ","kamu melihat","ra-ayta",54],["ثَمَّ","di sana","thamma",1687],["رَأَيْتَ","kamu melihat","ra-ayta",54],["نَعِيمًۭا","kenikmatan","naʿīman",588],["وَمُلْكًۭا","dan kerajaan","wamul'kan",262],["كَبِيرًا","yang besar","kabīran",302]],"t":"Dan apabila engkau melihat (keadaan) di sana (surga), niscaya engkau akan melihat berbagai macam kenikmatan dan kerajaan yang besar."},{"n":21,"w":[["عَـٰلِيَهُمْ","mereka memakai","ʿāliyahum",1159],["ثِيَابُ","pakaian","thiyābu",1021],["سُندُسٍ","sutera halus","sundusin",2028],["خُضْرٌۭ","yang hijau","khuḍ'run",1451],["وَإِسْتَبْرَقٌۭ ۖ","dan sutera tebal","wa-is'tabraqun",1477],["وَحُلُّوٓا۟","dan mereka diberi perhiasan","waḥullū",1530],["أَسَاوِرَ","gelang-gelang","asāwira",1426],["مِن","dari","min",1],["فِضَّةٍۢ","perak","fiḍḍatin",1195],["وَسَقَىٰهُمْ","dan memberi minum mereka","wasaqāhum",759],["رَبُّهُمْ","Tuhan mereka","rabbuhum",15],["شَرَابًۭا","minuman","sharāban",768],["طَهُورًا","suci/bersih","ṭahūran",2314]],"t":"Mereka berpakaian sutera halus yang hijau dan sutera tebal dan memakai gelang terbuat dari perak, dan Tuhan memberikan kepada mereka minuman yang bersih (dan suci)."},{"n":22,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰذَا","ini","hādhā",64],["كَانَ","adalah ia","kāna",12],["لَكُمْ","bagi kalian","lakum",32],["جَزَآءًۭ","balasan","jazāan",290],["وَكَانَ","dan adalah","wakāna",12],["سَعْيُكُم","usahamu","saʿyukum",872],["مَّشْكُورًا","disyukuri","mashkūran",2533]],"t":"Inilah balasan untukmu, dan segala usahamu diterima dan diakui (Allah)."},{"n":23,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["نَحْنُ","Kami","naḥnu",140],["نَزَّلْنَا","Kami telah turunkan","nazzalnā",207],["عَلَيْكَ","atasmu","ʿalayka",11],["ٱلْقُرْءَانَ","Al Qur'an","l-qur'āna",189],["تَنزِيلًۭا","turun","tanzīlan",650]],"t":"Sesungguhnya Kamilah yang menurunkan Alquran kepadamu (Muhammad) secara berangsur-angsur."},{"n":24,"w":[["فَٱصْبِرْ","maka bersabarlah kamu","fa-iṣ'bir",215],["لِحُكْمِ","bagi/untuk hukum","liḥuk'mi",382],["رَبِّكَ","Tuhanmu","rabbika",15],["وَلَا","dan jangan","walā",8],["تُطِعْ","kamu ikuti","tuṭiʿ",177],["مِنْهُمْ","di antara mereka","min'hum",1],["ءَاثِمًا","orang yang berdosa","āthiman",1777],["أَوْ","atau","aw",50],["كَفُورًۭا","orang yang kafir","kafūran",747]],"t":"Maka bersabarlah untuk (melaksanakan) ketetapan Tuhanmu, dan janganlah engkau ikuti orang yang berdosa dan orang yang kafir di antara mereka."},{"n":25,"w":[["وَٱذْكُرِ","dan ingatlah/sebutlah","wa-udh'kuri",144],["ٱسْمَ","nama","is'ma",324],["رَبِّكَ","Tuhanmu","rabbika",15],["بُكْرَةًۭ","di waktu pagi","buk'ratan",1077],["وَأَصِيلًۭا","dan petang","wa-aṣīlan",1044]],"t":"Dan sebutlah nama Tuhanmu pada (waktu) pagi dan petang."},{"n":26,"w":[["وَمِنَ","dan dari","wamina",1],["ٱلَّيْلِ","sebagian malam","al-layli",146],["فَٱسْجُدْ","maka bersujudlah","fa-us'jud",350],["لَهُۥ","kepada-Nya","lahu",21],["وَسَبِّحْهُ","dan bertasbihlah kepada-Nya","wasabbiḥ'hu",293],["لَيْلًۭا","malam","laylan",146],["طَوِيلًا","panjang","ṭawīlan",2317]],"t":"Dan pada sebagian dari malam, maka bersujudlah kepada-Nya dan bertasbihlah kepada-Nya pada bagian yang panjang di malam hari."},{"n":27,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",269],["يُحِبُّونَ","mereka mencintai","yuḥibbūna",200],["ٱلْعَاجِلَةَ","cepat-cepat/kehidupan","l-ʿājilata",1787],["وَيَذَرُونَ","dan mereka meninggalkan","wayadharūna",276],["وَرَآءَهُمْ","di belakang mereka","warāahum",457],["يَوْمًۭا","hari","yawman",31],["ثَقِيلًۭا","yang berat","thaqīlan",1437]],"t":"Sesungguhnya mereka (orang kafir) itu mencintai kehidupan (dunia) dan meningggalkan hari yang berat (hari akhirat) di belakangnya."},{"n":28,"w":[["نَّحْنُ","Kami","naḥnu",140],["خَلَقْنَـٰهُمْ","Kami menciptakan mereka","khalaqnāhum",70],["وَشَدَدْنَآ","dan Kami kuatkan","washadadnā",1139],["أَسْرَهُمْ ۖ","tubuh mereka","asrahum",3022],["وَإِذَا","dan apabila","wa-idhā",29],["شِئْنَا","Kami menghendaki","shi'nā",62],["بَدَّلْنَآ","Kami mengganti","baddalnā",463],["أَمْثَـٰلَهُمْ","serupa mereka","amthālahum",138],["تَبْدِيلًا","penggantian","tabdīlan",1120]],"t":"Kami telah menciptakan mereka dan menguatkan persendian tubuh mereka. Tetapi, jika Kami menghendaki, Kami dapat mengganti dengan yang serupa mereka."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",9],["هَـٰذِهِۦ","ini","hādhihi",265],["تَذْكِرَةٌۭ ۖ","peringatan/pengajaran","tadhkiratun",947],["فَمَن","maka barang siapa","faman",17],["شَآءَ","dia menghendaki","shāa",62],["ٱتَّخَذَ","dia mengambil","ittakhadha",107],["إِلَىٰ","kepada","ilā",18],["رَبِّهِۦ","Tuhannya","rabbihi",15],["سَبِيلًۭا","jalan","sabīlan",73]],"t":"Sungguh, (ayat-ayat) ini adalah peringatan, maka barang siapa menghendaki (kebaikan bagi dirinya) tentu dia mengambil jalan menuju kepada Tuhannya."},{"n":30,"w":[["وَمَا","dan tidak","wamā",6],["تَشَآءُونَ","kamu menghendaki","tashāūna",62],["إِلَّآ","kecuali","illā",20],["أَن","bahwa","an",22],["يَشَآءَ","menghendaki","yashāa",62],["ٱللَّهُ ۚ","Allah","l-lahu",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["كَانَ","adalah ia","kāna",12],["عَلِيمًا","Maha Mengetahui","ʿalīman",77],["حَكِيمًۭا","Maha Bijaksana","ḥakīman",126]],"t":"Tetapi kamu tidak mampu (menempuh jalan itu), kecuali apabila dikehendaki Allah. Sungguh, Allah Maha Mengetahui, Mahabijaksana."},{"n":31,"w":[["يُدْخِلُ","Dia memasukkan","yud'khilu",289],["مَن","siapa","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["فِى","dalam","fī",7],["رَحْمَتِهِۦ ۚ","rahmat-Nya","raḥmatihi",116],["وَٱلظَّـٰلِمِينَ","dan orang-orang zalim","wal-ẓālimīna",97],["أَعَدَّ","Dia sediakan","aʿadda",511],["لَهُمْ","bagi mereka","lahum",16],["عَذَابًا","azab","ʿadhāban",43],["أَلِيمًۢا","pedih","alīman",178]],"t":"Dia memasukkan siapa pun yang Dia kehendaki ke dalam rahmat-Nya (surga). Adapun bagi orang-orang zalim disediakan-Nya azab yang pedih."}]