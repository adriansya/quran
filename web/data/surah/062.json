[{"n":1,"w":[["يُسَبِّحُ","bertasbih","yusabbiḥu",276],["لِلَّهِ","kepada Allah","lillahi",1],["مَا","apa","mā",2],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa","wamā",2],["فِى","pada","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["ٱلْمَلِكِ","Raja","l-maliki",631],["ٱلْقُدُّوسِ","Maha Suci","l-qudūsi",2591],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",110],["ٱلْحَكِيمِ","Maha Bijaksana","l-ḥakīmi",112]],"t":"Apa yang ada di langit dan apa yang ada di bumi senantiasa bertasbih kepada Allah. Maharaja, Yang Mahasuci, Yang Mahaperkasa, Mahabijaksana."},{"n":2,"w":[["هُوَ","Dia","huwa",20],["ٱلَّذِى","yang","alladhī",7],["بَعَثَ","mengutus","baʿatha",227],["فِى","pada","fī",3],["ٱلْأُمِّيِّـۧنَ","yang buta huruf","l-umiyīna",1146],["رَسُولًۭا","seorang rasul","rasūlan",35],["مِّنْهُمْ","diantara mereka","min'hum",0],["يَتْلُوا۟","dia membacakan","yatlū",199],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ءَايَـٰتِهِۦ","ayat-ayat-Nya","āyātihi",28],["وَيُزَكِّيهِمْ","dan dia mensucikan mereka","wayuzakkīhim",753],["وَيُعَلِّمُهُمُ","dan dia mengajarkan mereka","wayuʿallimuhumu",281],["ٱلْكِتَـٰبَ","kitab","l-kitāba",49],["وَٱلْحِكْمَةَ","dan hikmah","wal-ḥik'mata",509],["وَإِن","dan sungguh","wa-in",14],["كَانُوا۟","mereka adalah","kānū",9],["مِن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["لَفِى","benar-benar dalam","lafī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",306],["مُّبِينٍۢ","nyata","mubīnin",100]],"t":"Dialah yang mengutus seorang Rasul kepada kaum yang buta huruf dari kalangan mereka sendiri, yang membacakan kepada mereka ayat-ayat-Nya, menyucikan (jiwa) mereka dan mengajarkan kepada mereka Kitab dan Hikmah (Sunah), meskipun sebelumnya, mereka benar-benar dalam kesesatan yang nyata,"},{"n":3,"w":[["وَءَاخَرِينَ","dan yang lain","waākharīna",172],["مِنْهُمْ","dari mereka","min'hum",0],["لَمَّا","tatkala/belum","lammā",32],["يَلْحَقُوا۟","mereka bertemu/berhubungan","yalḥaqū",2770],["بِهِمْ ۚ","dengan mereka","bihim",11],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",110],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",112]],"t":"dan (juga) kepada kaum yang lain dari mereka yang belum bertemu dengan mereka. Dan Dialah Yang Mahaperkasa, Mahabijaksana."},{"n":4,"w":[["ذَٰلِكَ","demikian itu","dhālika",19],["فَضْلُ","karunia","faḍlu",131],["ٱللَّهِ","Allah","l-lahi",1],["يُؤْتِيهِ","diberikannya","yu'tīhi",45],["مَن","siapa","man",12],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["وَٱللَّهُ","dan Allah","wal-lahu",1],["ذُو","memiliki/mempunyai","dhū",113],["ٱلْفَضْلِ","karunia","l-faḍli",131],["ٱلْعَظِيمِ","besar","l-ʿaẓīmi",98]],"t":"Demikianlah karunia Allah, yang diberikan kepada siapa yang Dia kehendaki; dan Allah memiliki karunia yang besar."},{"n":5,"w":[["مَثَلُ","perumpamaan","mathalu",124],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["حُمِّلُوا۟","(mereka) dipikulkan","ḥummilū",1306],["ٱلتَّوْرَىٰةَ","taurat","l-tawrāta",558],["ثُمَّ","kemudian","thumma",34],["لَمْ","tidak","lam",32],["يَحْمِلُوهَا","mereka memikulnya","yaḥmilūhā",282],["كَمَثَلِ","seperti","kamathali",124],["ٱلْحِمَارِ","keledai","l-ḥimāri",1305],["يَحْمِلُ","memikul/membawa","yaḥmilu",282],["أَسْفَارًۢا ۚ","kitab yang tebal","asfāran",2191],["بِئْسَ","sangat buruk","bi'sa",289],["مَثَلُ","perumpamaan","mathalu",124],["ٱلْقَوْمِ","kaum","l-qawmi",27],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَذَّبُوا۟","(mereka) mendustakan","kadhabū",63],["بِـَٔايَـٰتِ","pada ayat-ayat","biāyāti",28],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَٱللَّهُ","dan Allah","wal-lahu",1],["لَا","tidak","lā",4],["يَهْدِى","memberi petunjuk","yahdī",79],["ٱلْقَوْمَ","kaum","l-qawma",27],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89]],"t":"Perumpamaan orang-orang yang diberi tugas membawa Taurat, kemudian mereka tidak membawanya (tidak mengamalkannya) adalah seperti keledai yang membawa kitab-kitab yang tebal. Sangat buruk perumpamaan kaum yang mendustakan ayat-ayat Allah. Dan Allah tidak memberi petunjuk kepada orang-orang yang zalim."},{"n":6,"w":[["قُلْ","katakanlah","qul",6],["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["هَادُوٓا۟","(mereka) beragama Yahudi","hādū",782],["إِن","jika","in",14],["زَعَمْتُمْ","kamu mengira","zaʿamtum",704],["أَنَّكُمْ","bahwa sesungguhnya kamu","annakum",30],["أَوْلِيَآءُ","kekasih","awliyāu",128],["لِلَّهِ","Allah","lillahi",1],["مِن","dari","min",0],["دُونِ","selain/bukan","dūni",78],["ٱلنَّاسِ","manusia","l-nāsi",52],["فَتَمَنَّوُا۟","maka harapkanlah","fatamannawū",1256],["ٱلْمَوْتَ","kematian","l-mawta",236],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Katakanlah (Muhammad), \"Wahai orang-orang Yahudi! Jika kamu mengira bahwa kamulah kekasih Allah, bukan orang-orang yang lain, maka harapkanlah kematianmu, jika kamu orang yang benar.\""},{"n":7,"w":[["وَلَا","dan tidak","walā",4],["يَتَمَنَّوْنَهُۥٓ","mereka mengharapkannya","yatamannawnahu",1256],["أَبَدًۢا","selama-lamanya","abadan",382],["بِمَا","dengan apa/disebabkan","bimā",2],["قَدَّمَتْ","mendahulukan/memperbuat","qaddamat",406],["أَيْدِيهِمْ ۚ","tangan-tangan mereka","aydīhim",99],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",68],["بِٱلظَّـٰلِمِينَ","pada orang-orang yang zalim","bil-ẓālimīna",89]],"t":"Dan mereka tidak akan mengharapkan kematian itu selamanya disebabkan kejahatan yang telah mereka perbuat dengan tangan mereka sendiri. Dan Allah Maha Mengetahui orang-orang yang zalim."},{"n":8,"w":[["قُلْ","katakanlah","qul",6],["إِنَّ","sesungguhnya","inna",5],["ٱلْمَوْتَ","kematian","l-mawta",236],["ٱلَّذِى","orang-orang yang","alladhī",7],["تَفِرُّونَ","kamu lari","tafirrūna",1179],["مِنْهُ","dari padanya","min'hu",0],["فَإِنَّهُۥ","maka sesungguhnya ia","fa-innahu",5],["مُلَـٰقِيكُمْ ۖ","menemui kamu","mulāqīkum",2493],["ثُمَّ","kemudian","thumma",34],["تُرَدُّونَ","kamu dikembalikan","turaddūna",324],["إِلَىٰ","kepada","ilā",13],["عَـٰلِمِ","yang mengetahui","ʿālimi",546],["ٱلْغَيْبِ","yang gaib","l-ghaybi",242],["وَٱلشَّهَـٰدَةِ","dan yang nyata","wal-shahādati",446],["فَيُنَبِّئُكُم","lalu Dia menerangkan kepadamu","fayunabbi-ukum",255],["بِمَا","terhadap apa","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Katakanlah, \"Sesungguhnya kematian yang kamu lari dari padanya, ia pasti menemui kamu, kemudian kamu akan dikembalikan kepada (Allah), yang mengetahui yang gaib dan yang nyata, lalu Dia beritakan kepadamu apa yang telah kamu kerjakan.\""},{"n":9,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِذَا","apabila","idhā",23],["نُودِىَ","diseru/dipanggil","nūdiya",269],["لِلصَّلَوٰةِ","untuk menunaikan sholat","lilṣṣalati",133],["مِن","dari","min",0],["يَوْمِ","hari","yawmi",25],["ٱلْجُمُعَةِ","jum'at","l-jumuʿati",3560],["فَٱسْعَوْا۟","maka berjalanlah kamu","fa-is'ʿaw",518],["إِلَىٰ","kepada/untuk","ilā",13],["ذِكْرِ","mengingat","dhik'ri",149],["ٱللَّهِ","Allah","l-lahi",1],["وَذَرُوا۟","dan tinggalkanlah","wadharū",262],["ٱلْبَيْعَ ۚ","jual beli/perdagangan","l-bayʿa",1065],["ذَٰلِكُمْ","demikian itu","dhālikum",19],["خَيْرٌۭ","lebih baik","khayrun",62],["لَّكُمْ","bagi kalian","lakum",26],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29]],"t":"Wahai orang-orang yang beriman! Apabila telah diseru untuk melaksanakan salat pada hari Jumat, maka segeralah kamu mengingat Allah dan tinggalkanlah jual beli. Yang demikian itu lebih baik bagimu jika kamu mengetahui."},{"n":10,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["قُضِيَتِ","telah diselesaikan","quḍiyati",204],["ٱلصَّلَوٰةُ","sholat","l-ṣalatu",133],["فَٱنتَشِرُوا۟","maka bertebaranlah kamu","fa-intashirū",2012],["فِى","pada","fī",3],["ٱلْأَرْضِ","muka bumi","l-arḍi",22],["وَٱبْتَغُوا۟","dan carilah","wa-ib'taghū",341],["مِن","dari","min",0],["فَضْلِ","karunia","faḍli",131],["ٱللَّهِ","Allah","l-lahi",1],["وَٱذْكُرُوا۟","dan ingatlah","wa-udh'kurū",130],["ٱللَّهَ","Allah","l-laha",1],["كَثِيرًۭا","banyak","kathīran",191],["لَّعَلَّكُمْ","agar kalian","laʿallakum",96],["تُفْلِحُونَ","kamu beruntung","tuf'liḥūna",395]],"t":"Apabila salat telah dilaksanakan, maka bertebaranlah kamu di bumi; carilah karunia Allah dan ingatlah Allah banyak-banyak agar kamu beruntung."},{"n":11,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["رَأَوْا۟","mereka melihat","ra-aw",46],["تِجَـٰرَةً","perniagaan","tijāratan",928],["أَوْ","atau","aw",42],["لَهْوًا","permainan","lahwan",841],["ٱنفَضُّوٓا۟","mereka menuju","infaḍḍū",2104],["إِلَيْهَا","kepadanya","ilayhā",13],["وَتَرَكُوكَ","dan mereka meninggalkan kamu","watarakūka",291],["قَآئِمًۭا ۚ","berdiri","qāiman",577],["قُلْ","katakanlah","qul",6],["مَا","apa","mā",2],["عِندَ","disisi","ʿinda",59],["ٱللَّهِ","Allah","l-lahi",1],["خَيْرٌۭ","lebih baik","khayrun",62],["مِّنَ","dari","mina",0],["ٱللَّهْوِ","permainan","l-lahwi",841],["وَمِنَ","dan dari","wamina",0],["ٱلتِّجَـٰرَةِ ۚ","perniagaan","l-tijārati",928],["وَٱللَّهُ","dan Allah","wal-lahu",1],["خَيْرُ","sebaik-baik","khayru",62],["ٱلرَّٰزِقِينَ","pemberi rizki/imbalan","l-rāziqīna",1227]],"t":"Dan apabila mereka melihat perdagangan atau permainan, mereka segera menuju kepadanya dan mereka tinggalkan engkau (Muhammad) sedang berdiri (berkhotbah). Katakanlah, \"Apa yang ada di sisi Allah lebih baik daripada permainan dan perdagangan,\" dan Allah Pemberi rezeki yang terbaik."}]