[{"n":1,"w":[["وَٱلضُّحَىٰ","demi matahari naik","wal-ḍuḥā",1152]],"t":"Demi waktu duha (ketika matahari naik sepenggalan),"},{"n":2,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",131],["إِذَا","apabila","idhā",23],["سَجَىٰ","telah sunyi","sajā",4268]],"t":"dan demi malam apabila telah sunyi,"},{"n":3,"w":[["مَا","tidak","mā",2],["وَدَّعَكَ","meninggalkan kamu","waddaʿaka",4541],["رَبُّكَ","Tuhanmu","rabbuka",10],["وَمَا","dan tidak","wamā",2],["قَلَىٰ","marah/benci","qalā",4141]],"t":"Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu,"},{"n":4,"w":[["وَلَلْـَٔاخِرَةُ","dan sungguh kesudahan/akhirat","walalākhiratu",72],["خَيْرٌۭ","lebih baik","khayrun",62],["لَّكَ","bagimu","laka",137],["مِنَ","dari pada","mina",0],["ٱلْأُولَىٰ","permulaan/dunia","l-ūlā",136]],"t":"dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan."},{"n":5,"w":[["وَلَسَوْفَ","dan sungguh kelak","walasawfa",279],["يُعْطِيكَ","memberikan kepadamu","yuʿ'ṭīka",955],["رَبُّكَ","Tuhanmu","rabbuka",10],["فَتَرْضَىٰٓ","maka kamu jadi puas","fatarḍā",312]],"t":"Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."},{"n":6,"w":[["أَلَمْ","apakah tidak/bukanlah","alam",32],["يَجِدْكَ","Dia mendapatimu","yajid'ka",106],["يَتِيمًۭا","seorang yatim","yatīman",462],["فَـَٔاوَىٰ","lalu Dia melindungi","faāwā",873]],"t":"Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu)."},{"n":7,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",106],["ضَآلًّۭا","sesat/bingung","ḍāllan",655],["فَهَدَىٰ","lalu Dia memberi petunjuk","fahadā",79]],"t":"Dan Dia mendapatimu sebagai seorang yang bingung, lalu Dia memberikan petunjuk."},{"n":8,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",106],["عَآئِلًۭا","miskin/kekurangan","ʿāilan",3098],["فَأَغْنَىٰ","lalu Dia memberi kecukupan","fa-aghnā",617]],"t":"Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan."},{"n":9,"w":[["فَأَمَّا","maka adapun","fa-ammā",218],["ٱلْيَتِيمَ","anak yatim","l-yatīma",462],["فَلَا","maka jangan","falā",4],["تَقْهَرْ","kamu paksa/bersikap bengis","taqhar",4426]],"t":"Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang."},{"n":10,"w":[["وَأَمَّا","dan adapun","wa-ammā",218],["ٱلسَّآئِلَ","orang minta-minta","l-sāila",1105],["فَلَا","maka jangan","falā",4],["تَنْهَرْ","kamu menghardik","tanhar",2680]],"t":"Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya)."},{"n":11,"w":[["وَأَمَّا","dan adapun","wa-ammā",218],["بِنِعْمَةِ","dengan/terhadap nikmat","biniʿ'mati",238],["رَبِّكَ","Tuhanmu","rabbika",10],["فَحَدِّثْ","maka hendaklah kamu ceritakan","faḥaddith",2021]],"t":"Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur)."}]