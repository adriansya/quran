[{"n":1,"w":[["وَٱلضُّحَىٰ","demi matahari naik","wal-ḍuḥā",1159]],"t":"Demi waktu duha (ketika matahari naik sepenggalan),"},{"n":2,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",146],["إِذَا","apabila","idhā",29],["سَجَىٰ","telah sunyi","sajā",4263]],"t":"dan demi malam apabila telah sunyi,"},{"n":3,"w":[["مَا","tidak","mā",6],["وَدَّعَكَ","meninggalkan kamu","waddaʿaka",4480],["رَبُّكَ","Tuhanmu","rabbuka",15],["وَمَا","dan tidak","wamā",6],["قَلَىٰ","marah/benci","qalā",4122]],"t":"Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu,"},{"n":4,"w":[["وَلَلْـَٔاخِرَةُ","dan sungguh kesudahan/akhirat","walalākhiratu",82],["خَيْرٌۭ","lebih baik","khayrun",69],["لَّكَ","bagimu","laka",153],["مِنَ","dari pada","mina",1],["ٱلْأُولَىٰ","permulaan/dunia","l-ūlā",151]],"t":"dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan."},{"n":5,"w":[["وَلَسَوْفَ","dan sungguh kelak","walasawfa",295],["يُعْطِيكَ","memberikan kepadamu","yuʿ'ṭīka",967],["رَبُّكَ","Tuhanmu","rabbuka",15],["فَتَرْضَىٰٓ","maka kamu jadi puas","fatarḍā",328]],"t":"Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."},{"n":6,"w":[["أَلَمْ","apakah tidak/bukanlah","alam",39],["يَجِدْكَ","Dia mendapatimu","yajid'ka",120],["يَتِيمًۭا","seorang yatim","yatīman",471],["فَـَٔاوَىٰ","lalu Dia melindungi","faāwā",913]],"t":"Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu)."},{"n":7,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",120],["ضَآلًّۭا","sesat/bingung","ḍāllan",664],["فَهَدَىٰ","lalu Dia memberi petunjuk","fahadā",89]],"t":"Dan Dia mendapatimu sebagai seorang yang bingung, lalu Dia memberikan petunjuk."},{"n":8,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",120],["عَآئِلًۭا","miskin/kekurangan","ʿāilan",3084],["فَأَغْنَىٰ","lalu Dia memberi kecukupan","fa-aghnā",285]],"t":"Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan."},{"n":9,"w":[["فَأَمَّا","maka adapun","fa-ammā",229],["ٱلْيَتِيمَ","anak yatim","l-yatīma",471],["فَلَا","maka jangan","falā",8],["تَقْهَرْ","kamu paksa/bersikap bengis","taqhar",4121]],"t":"Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang."},{"n":10,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["ٱلسَّآئِلَ","orang minta-minta","l-sāila",1115],["فَلَا","maka jangan","falā",8],["تَنْهَرْ","kamu menghardik","tanhar",2572]],"t":"Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya)."},{"n":11,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["بِنِعْمَةِ","dengan/terhadap nikmat","biniʿ'mati",250],["رَبِّكَ","Tuhanmu","rabbika",15],["فَحَدِّثْ","maka hendaklah kamu ceritakan","faḥaddith",1806]],"t":"Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur)."}]