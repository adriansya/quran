[{"n":1,"w":[["وَٱلضُّحَىٰ","demi matahari naik","wal-ḍuḥā",1147]],"t":"Demi waktu duha (ketika matahari naik sepenggalan),"},{"n":2,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",137],["إِذَا","apabila","idhā",23],["سَجَىٰ","telah sunyi","sajā",4252]],"t":"dan demi malam apabila telah sunyi,"},{"n":3,"w":[["مَا","tidak","mā",2],["وَدَّعَكَ","meninggalkan kamu","waddaʿaka",4469],["رَبُّكَ","Tuhanmu","rabbuka",10],["وَمَا","dan tidak","wamā",2],["قَلَىٰ","marah/benci","qalā",4111]],"t":"Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu,"},{"n":4,"w":[["وَلَلْـَٔاخِرَةُ","dan sungguh kesudahan/akhirat","walalākhiratu",74],["خَيْرٌۭ","lebih baik","khayrun",61],["لَّكَ","bagimu","laka",144],["مِنَ","dari pada","mina",0],["ٱلْأُولَىٰ","permulaan/dunia","l-ūlā",142]],"t":"dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan."},{"n":5,"w":[["وَلَسَوْفَ","dan sungguh kelak","walasawfa",285],["يُعْطِيكَ","memberikan kepadamu","yuʿ'ṭīka",955],["رَبُّكَ","Tuhanmu","rabbuka",10],["فَتَرْضَىٰٓ","maka kamu jadi puas","fatarḍā",318]],"t":"Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."},{"n":6,"w":[["أَلَمْ","apakah tidak/bukanlah","alam",32],["يَجِدْكَ","Dia mendapatimu","yajid'ka",110],["يَتِيمًۭا","seorang yatim","yatīman",462],["فَـَٔاوَىٰ","lalu Dia melindungi","faāwā",901]],"t":"Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu)."},{"n":7,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",110],["ضَآلًّۭا","sesat/bingung","ḍāllan",654],["فَهَدَىٰ","lalu Dia memberi petunjuk","fahadā",81]],"t":"Dan Dia mendapatimu sebagai seorang yang bingung, lalu Dia memberikan petunjuk."},{"n":8,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",110],["عَآئِلًۭا","miskin/kekurangan","ʿāilan",3073],["فَأَغْنَىٰ","lalu Dia memberi kecukupan","fa-aghnā",275]],"t":"Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan."},{"n":9,"w":[["فَأَمَّا","maka adapun","fa-ammā",219],["ٱلْيَتِيمَ","anak yatim","l-yatīma",462],["فَلَا","maka jangan","falā",4],["تَقْهَرْ","kamu paksa/bersikap bengis","taqhar",4110]],"t":"Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang."},{"n":10,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["ٱلسَّآئِلَ","orang minta-minta","l-sāila",1103],["فَلَا","maka jangan","falā",4],["تَنْهَرْ","kamu menghardik","tanhar",2560]],"t":"Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya)."},{"n":11,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["بِنِعْمَةِ","dengan/terhadap nikmat","biniʿ'mati",240],["رَبِّكَ","Tuhanmu","rabbika",10],["فَحَدِّثْ","maka hendaklah kamu ceritakan","faḥaddith",1794]],"t":"Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur)."}]