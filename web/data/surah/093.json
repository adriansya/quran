[{"n":1,"w":[["وَٱلضُّحَىٰ","demi matahari naik","wal-ḍuḥā",1141]],"t":"Demi waktu duha (ketika matahari naik sepenggalan),"},{"n":2,"w":[["وَٱلَّيْلِ","dan malam","wa-al-layli",136],["إِذَا","apabila","idhā",23],["سَجَىٰ","telah sunyi","sajā",4256]],"t":"dan demi malam apabila telah sunyi,"},{"n":3,"w":[["مَا","tidak","mā",2],["وَدَّعَكَ","meninggalkan kamu","waddaʿaka",4473],["رَبُّكَ","Tuhanmu","rabbuka",10],["وَمَا","dan tidak","wamā",2],["قَلَىٰ","marah/benci","qalā",4115]],"t":"Tuhanmu tidak meninggalkan engkau (Muhammad) dan tidak (pula) membencimu,"},{"n":4,"w":[["وَلَلْـَٔاخِرَةُ","dan sungguh kesudahan/akhirat","walalākhiratu",73],["خَيْرٌۭ","lebih baik","khayrun",60],["لَّكَ","bagimu","laka",143],["مِنَ","dari pada","mina",0],["ٱلْأُولَىٰ","permulaan/dunia","l-ūlā",141]],"t":"dan sungguh, yang kemudian itu lebih baik bagimu daripada yang permulaan."},{"n":5,"w":[["وَلَسَوْفَ","dan sungguh kelak","walasawfa",281],["يُعْطِيكَ","memberikan kepadamu","yuʿ'ṭīka",949],["رَبُّكَ","Tuhanmu","rabbuka",10],["فَتَرْضَىٰٓ","maka kamu jadi puas","fatarḍā",313]],"t":"Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."},{"n":6,"w":[["أَلَمْ","apakah tidak/bukanlah","alam",32],["يَجِدْكَ","Dia mendapatimu","yajid'ka",109],["يَتِيمًۭا","seorang yatim","yatīman",457],["فَـَٔاوَىٰ","lalu Dia melindungi","faāwā",894]],"t":"Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(mu)."},{"n":7,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",109],["ضَآلًّۭا","sesat/bingung","ḍāllan",649],["فَهَدَىٰ","lalu Dia memberi petunjuk","fahadā",80]],"t":"Dan Dia mendapatimu sebagai seorang yang bingung, lalu Dia memberikan petunjuk."},{"n":8,"w":[["وَوَجَدَكَ","dan Dia mendapatimu","wawajadaka",109],["عَآئِلًۭا","miskin/kekurangan","ʿāilan",3072],["فَأَغْنَىٰ","lalu Dia memberi kecukupan","fa-aghnā",271]],"t":"Dan Dia mendapatimu sebagai seorang yang kekurangan, lalu Dia memberikan kecukupan."},{"n":9,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["ٱلْيَتِيمَ","anak yatim","l-yatīma",457],["فَلَا","maka jangan","falā",4],["تَقْهَرْ","kamu paksa/bersikap bengis","taqhar",4114]],"t":"Maka terhadap anak yatim janganlah engkau berlaku sewenang-wenang."},{"n":10,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["ٱلسَّآئِلَ","orang minta-minta","l-sāila",1097],["فَلَا","maka jangan","falā",4],["تَنْهَرْ","kamu menghardik","tanhar",2559]],"t":"Dan terhadap orang yang meminta-minta, janganlah engkau menghardik(nya)."},{"n":11,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["بِنِعْمَةِ","dengan/terhadap nikmat","biniʿ'mati",238],["رَبِّكَ","Tuhanmu","rabbika",10],["فَحَدِّثْ","maka hendaklah kamu ceritakan","faḥaddith",1782]],"t":"Dan terhadap nikmat Tuhanmu, hendaklah engkau nyatakan (dengan bersyukur)."}]