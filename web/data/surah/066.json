[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلنَّبِىُّ","Nabi","l-nabiyu",169],["لِمَ","mengapa","lima",6],["تُحَرِّمُ","kamu mengharamkan","tuḥarrimu",318],["مَآ","apa","mā",6],["أَحَلَّ","yang menghalalkan","aḥalla",512],["ٱللَّهُ","Allah","l-lahu",4],["لَكَ ۖ","bagimu","laka",153],["تَبْتَغِى","kamu mencari","tabtaghī",357],["مَرْضَاتَ","kesenangan","marḍāta",1381],["أَزْوَٰجِكَ ۚ","isteri-isterimu","azwājika",166],["وَٱللَّهُ","dan Allah","wal-lahu",4],["غَفُورٌۭ","Maha Pengampun","ghafūrun",131],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",114]],"t":"Wahai Nabi! Mengapa engkau mengharamkan apa yang dihalalkan Allah bagimu? Engkau ingin menyenangkan hati istri-istrimu? Dan Allah Maha Pengampun, Maha Penyayang."},{"n":2,"w":[["قَدْ","sesungguhnya","qad",30],["فَرَضَ","mewajibkan","faraḍa",917],["ٱللَّهُ","Allah","l-lahu",4],["لَكُمْ","bagi kalian","lakum",32],["تَحِلَّةَ","pembebasan","taḥillata",4330],["أَيْمَـٰنِكُمْ ۚ","sumpah-sumpahmu","aymānikum",198],["وَٱللَّهُ","dan Allah","wal-lahu",4],["مَوْلَىٰكُمْ ۖ","pelindungmu","mawlākum",502],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",77],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",126]],"t":"Sungguh, Allah telah mewajibkan kepadamu membebaskan diri dari sumpahmu; dan Allah adalah pelindungmu dan Dia Maha Mengetahui, Mahabijaksana."},{"n":3,"w":[["وَإِذْ","dan ketika","wa-idh",61],["أَسَرَّ","merahasiakan","asarra",553],["ٱلنَّبِىُّ","Nabi","l-nabiyu",169],["إِلَىٰ","kepada","ilā",18],["بَعْضِ","sebagian","baʿḍi",80],["أَزْوَٰجِهِۦ","isteri-isterinya","azwājihi",166],["حَدِيثًۭا","pembicaraan","ḥadīthan",402],["فَلَمَّا","maka tatkala","falammā",81],["نَبَّأَتْ","ia memberitakan","nabba-at",270],["بِهِۦ","dengannya/pembicaraan","bihi",21],["وَأَظْهَرَهُ","dan menyatakannya","wa-aẓharahu",968],["ٱللَّهُ","Allah","l-lahu",4],["عَلَيْهِ","kepadanya (Nabi)","ʿalayhi",11],["عَرَّفَ","dia memberitahukan","ʿarrafa",2244],["بَعْضَهُۥ","sebagiannya","baʿḍahu",80],["وَأَعْرَضَ","dan dia palingkan/sembunyikan","wa-aʿraḍa",366],["عَنۢ","dari","ʿan",27],["بَعْضٍۢ ۖ","sebagian","baʿḍin",80],["فَلَمَّا","maka tatkala","falammā",81],["نَبَّأَهَا","dia memberitakan kepadanya","nabba-ahā",270],["بِهِۦ","dengannya/hal itu","bihi",21],["قَالَتْ","ia berkata","qālat",10],["مَنْ","siapa","man",17],["أَنۢبَأَكَ","memberitakan kepadamu","anba-aka",1496],["هَـٰذَا ۖ","ini/hal itu","hādhā",64],["قَالَ","dia berkata","qāla",10],["نَبَّأَنِىَ","memberitakan kepadaku","nabba-aniya",270],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",77],["ٱلْخَبِيرُ","Maha Melihat","l-khabīru",277]],"t":"Dan ingatlah ketika secara rahasia Nabi membicarakan suatu peristiwa kepada salah seorang istrinya (Hafsah). Lalu dia menceritakan peristiwa itu (kepada Aisyah) dan Allah memberitahukan peristiwa itu kepadanya (Nabi), lalu (Nabi) memberitahukan (kepada Hafsah) sebagian dan menyembunyikan sebagian yang lain. Maka ketika dia (Nabi) memberitahukan pembicaraan itu kepadanya (Hafsah), dia bertanya, \"Siapa yang telah memberitahukan hal ini kepadamu?\" Nabi menjawab, \"Yang memberitahukan kepadaku adalah Allah Yang Maha Mengetahui, Mahateliti.\""},{"n":4,"w":[["إِن","jika","in",19],["تَتُوبَآ","kamu berdua bertaubat","tatūbā",205],["إِلَى","kepada","ilā",18],["ٱللَّهِ","Allah","l-lahi",4],["فَقَدْ","maka sesungguhnya","faqad",30],["صَغَتْ","condong/cenderung","ṣaghat",2299],["قُلُوبُكُمَا ۖ","hati kamu berdua","qulūbukumā",98],["وَإِن","dan jika","wa-in",19],["تَظَـٰهَرَا","kamu berdua bantu-membantu","taẓāharā",2689],["عَلَيْهِ","atasnya/Nabi","ʿalayhi",11],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["مَوْلَىٰهُ","Pelindungnya","mawlāhu",502],["وَجِبْرِيلُ","dan Jibril","wajib'rīlu",1885],["وَصَـٰلِحُ","dan orang baik","waṣāliḥu",104],["ٱلْمُؤْمِنِينَ ۖ","orang-orang mu'min","l-mu'minīna",63],["وَٱلْمَلَـٰٓئِكَةُ","dan malaikat","wal-malāikatu",137],["بَعْدَ","sesudah","baʿda",67],["ذَٰلِكَ","demikian/itu","dhālika",26],["ظَهِيرٌ","pembantu/penolong","ẓahīrun",1177]],"t":"Jika kamu berdua bertobat kepada Allah, maka sungguh, hati kamu berdua telah condong (untuk menerima kebenaran); dan jika kamu berdua saling bantu membantu menyusahkan Nabi, maka sungguh, Allah menjadi pelindungnya dan (juga) Jibril dan orang-orang mukmin yang baik; dan selain itu malaikat-malaikat adalah penolongnya."},{"n":5,"w":[["عَسَىٰ","boleh jadi/mudah-mudahan","ʿasā",381],["رَبُّهُۥٓ","Tuhannya","rabbuhu",15],["إِن","jika","in",19],["طَلَّقَكُنَّ","dia menceraikan kamu","ṭallaqakunna",840],["أَن","bahwa","an",22],["يُبْدِلَهُۥٓ","Dia akan menggantikannya","yub'dilahu",1746],["أَزْوَٰجًا","isteri-isteri","azwājan",166],["خَيْرًۭا","lebih baik","khayran",69],["مِّنكُنَّ","daripada kamu","minkunna",1],["مُسْلِمَـٰتٍۢ","muslimat/patuh","mus'limātin",292],["مُّؤْمِنَـٰتٍۢ","yang beriman","mu'minātin",63],["قَـٰنِتَـٰتٍۢ","yang taat","qānitātin",808],["تَـٰٓئِبَـٰتٍ","yang bertaubat","tāibātin",2719],["عَـٰبِدَٰتٍۢ","yang beribadat","ʿābidātin",730],["سَـٰٓئِحَـٰتٍۢ","yang berpuasa","sāiḥātin",2675],["ثَيِّبَـٰتٍۢ","yang janda","thayyibātin",4454],["وَأَبْكَارًۭا","dan perawan","wa-abkāran",1843]],"t":"Jika dia (Nabi) menceraikan kamu, boleh jadi Tuhan akan memberi ganti kepadanya dengan istri-istri yang lebih baik dari kamu, perempuan-perempuan yang patuh, yang beriman, yang taat, yang bertobat, yang beribadah, yang berpuasa, yang janda dan yang perawan."},{"n":6,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["قُوٓا۟","peliharalah","qū",619],["أَنفُسَكُمْ","diri kalian sendiri","anfusakum",47],["وَأَهْلِيكُمْ","dan keluargamu","wa-ahlīkum",102],["نَارًۭا","api/neraka","nāran",87],["وَقُودُهَا","dan bahan bakarnya","waqūduhā",1693],["ٱلنَّاسُ","manusia","l-nāsu",60],["وَٱلْحِجَارَةُ","dan batu-batu","wal-ḥijāratu",835],["عَلَيْهَا","atasnya","ʿalayhā",11],["مَلَـٰٓئِكَةٌ","malaikat","malāikatun",137],["غِلَاظٌۭ","yang kasar","ghilāẓun",919],["شِدَادٌۭ","yang keras","shidādun",225],["لَّا","tidak","lā",8],["يَعْصُونَ","mereka mendurhakai","yaʿṣūna",411],["ٱللَّهَ","Allah","l-laha",4],["مَآ","apa","mā",6],["أَمَرَهُمْ","diperintahkanNya kepada mereka","amarahum",161],["وَيَفْعَلُونَ","dan mereka mengerjakan","wayafʿalūna",136],["مَا","apa","mā",6],["يُؤْمَرُونَ","mereka diperintahkan","yu'marūna",161]],"t":"Wahai orang-orang yang beriman! Peliharalah dirimu dan keluargamu dari api neraka yang bahan bakarnya adalah manusia dan batu; penjaganya malaikat-malaikat yang kasar, dan keras, yang tidak durhaka kepada apa yang Allah perintahkan kepada mereka dan selalu mengerjakan apa yang diperintahkan."},{"n":7,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لَا","tidak/jangan","lā",8],["تَعْتَذِرُوا۟","kamu mengemukakan uzur","taʿtadhirū",1457],["ٱلْيَوْمَ ۖ","hari ini","l-yawma",31],["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",175],["مَا","apa","mā",6],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52]],"t":"Wahai orang-orang kafir! Janganlah kamu mengemukakan alasan pada hari ini. Sesungguhnya kamu hanya diberi balasan menurut apa yang telah kamu kerjakan."},{"n":8,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["تُوبُوٓا۟","bertaubatlah kamu","tūbū",205],["إِلَى","kepada","ilā",18],["ٱللَّهِ","Allah","l-lahi",4],["تَوْبَةًۭ","taubat","tawbatan",1123],["نَّصُوحًا","sungguh-sungguh dan ikhlas","naṣūḥan",4079],["عَسَىٰ","boleh jadi/mudah-mudahan","ʿasā",381],["رَبُّكُمْ","Tuhan kalian","rabbukum",15],["أَن","akan","an",22],["يُكَفِّرَ","menghapus/menutupi","yukaffira",675],["عَنكُمْ","dari kalian","ʿankum",27],["سَيِّـَٔاتِكُمْ","kesalahan-kesalahanmu","sayyiātikum",217],["وَيُدْخِلَكُمْ","dan akan memasukkan kamu","wayud'khilakum",289],["جَنَّـٰتٍۢ","surga-surga","jannātin",86],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",233],["يَوْمَ","pada hari","yawma",31],["لَا","tidak","lā",8],["يُخْزِى","menghinakan","yukh'zī",728],["ٱللَّهُ","Allah","l-lahu",4],["ٱلنَّبِىَّ","Nabi","l-nabiya",169],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["مَعَهُۥ ۖ","bersama dia","maʿahu",78],["نُورُهُمْ","cahaya mereka","nūruhum",288],["يَسْعَىٰ","berjalan/bersinar","yasʿā",529],["بَيْنَ","diantara","bayna",55],["أَيْدِيهِمْ","hadapan mereka","aydīhim",110],["وَبِأَيْمَـٰنِهِمْ","dan di sebelah kanan mereka","wabi-aymānihim",198],["يَقُولُونَ","mereka mengatakan","yaqūlūna",10],["رَبَّنَآ","ya Tuhan kami","rabbanā",15],["أَتْمِمْ","sempurnakanlah","atmim",601],["لَنَا","bagi kami","lanā",135],["نُورَنَا","cahaya kami","nūranā",288],["وَٱغْفِرْ","dan ampunilah","wa-igh'fir",197],["لَنَآ ۖ","bagi kami","lanā",135],["إِنَّكَ","sesungguhnya Engkau","innaka",9],["عَلَىٰ","atas","ʿalā",11],["كُلِّ","segala","kulli",38],["شَىْءٍۢ","sesuatu","shayin",49],["قَدِيرٌۭ","Maha Kuasa","qadīrun",275]],"t":"Wahai orang-orang yang beriman! Bertobatlah kepada Allah dengan tobat yang semurni-murninya, mudah-mudahan Tuhan kamu akan menghapus kesalahan-kesalahanmu dan memasukkan kamu ke dalam surga-surga yang mengalir di bawahnya sungai-sungai, pada hari ketika Allah tidak mengecewakan Nabi dan orang-orang yang beriman bersama dengannya; sedang cahaya mereka memancar di hadapan dan di sebelah kanan mereka, sambil mereka berkata, \"Ya Tuhan kami, sempurnakanlah untuk kami cahaya kami dan ampunilah kami; sungguh, Engkau Mahakuasa atas segala sesuatu.\""},{"n":9,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلنَّبِىُّ","Nabi","l-nabiyu",169],["جَـٰهِدِ","perangilah","jāhidi",415],["ٱلْكُفَّارَ","orang-orang kafir","l-kufāra",79],["وَٱلْمُنَـٰفِقِينَ","dan orang-orang munafik","wal-munāfiqīna",371],["وَٱغْلُظْ","dan bersikap keraslah","wa-ugh'luẓ",2387],["عَلَيْهِمْ ۚ","atas/terhadap mereka","ʿalayhim",11],["وَمَأْوَىٰهُمْ","dan tempat tinggal mereka","wamawāhum",481],["جَهَنَّمُ ۖ","neraka Jahannam","jahannamu",162],["وَبِئْسَ","dan seburuk-buruk","wabi'sa",307],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",404]],"t":"Wahai Nabi! Perangilah orang-orang kafir dan orang-orang munafik dan bersikap keraslah terhadap mereka. Tempat mereka adalah neraka Jahanam dan itulah seburuk-buruk tempat kembali."},{"n":10,"w":[["ضَرَبَ","telah membuat","ḍaraba",230],["ٱللَّهُ","Allah","l-lahu",4],["مَثَلًۭا","perumpamaan","mathalan",138],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["ٱمْرَأَتَ","isteri","im'ra-ata",433],["نُوحٍۢ","Nuh","nūḥin",287],["وَٱمْرَأَتَ","dan isteri","wa-im'ra-ata",433],["لُوطٍۢ ۖ","Luth","lūṭin",416],["كَانَتَا","keduanya adalah","kānatā",12],["تَحْتَ","di bawah","taḥta",246],["عَبْدَيْنِ","dua orang hamba","ʿabdayni",99],["مِنْ","dari","min",1],["عِبَادِنَا","hamba Kami","ʿibādinā",99],["صَـٰلِحَيْنِ","dua orang saleh","ṣāliḥayni",104],["فَخَانَتَاهُمَا","lalu keduanya berkhianat kepada keduanya","fakhānatāhumā",1441],["فَلَمْ","maka tidak","falam",39],["يُغْنِيَا","keduanya mampu","yugh'niyā",285],["عَنْهُمَا","dari keduanya","ʿanhumā",27],["مِنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["شَيْـًۭٔا","sesuatu/sedikitpun","shayan",49],["وَقِيلَ","dan dikatakan","waqīla",10],["ٱدْخُلَا","masuklah kamu berdua","ud'khulā",165],["ٱلنَّارَ","api/neraka","l-nāra",87],["مَعَ","bersama","maʿa",78],["ٱلدَّٰخِلِينَ","orang-orang yang masuk","l-dākhilīna",2359]],"t":"Allah membuat perumpamaan bagi orang-orang kafir, istri Nuh dan istri Luṭ. Keduanya berada di bawah pengawasan dua orang hamba yang saleh di antara hamba-hamba Kami; lalu kedua istri itu berkhianat kepada kedua suaminya, tetapi kedua suaminya itu tidak dapat membantu mereka sedikit pun dari (siksa) Allah; dan dikatakan (kepada kedua istri itu), \"Masuklah kamu berdua ke neraka bersama orang-orang yang masuk (neraka).\""},{"n":11,"w":[["وَضَرَبَ","dan membuat","waḍaraba",230],["ٱللَّهُ","Allah","l-lahu",4],["مَثَلًۭا","perumpamaan","mathalan",138],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["ٱمْرَأَتَ","isteri","im'ra-ata",433],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["إِذْ","ketika","idh",61],["قَالَتْ","ia berkata","qālat",10],["رَبِّ","ya Tuhanku","rabbi",15],["ٱبْنِ","bangunlah","ib'ni",791],["لِى","untukku","lī",158],["عِندَكَ","di sisi-Mu","ʿindaka",68],["بَيْتًۭا","sebuah rumah","baytan",196],["فِى","dalam","fī",7],["ٱلْجَنَّةِ","surga","l-janati",86],["وَنَجِّنِى","dan selamatkanlah aku","wanajjinī",337],["مِن","dari","min",1],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["وَعَمَلِهِۦ","dan perbuatannya","waʿamalihi",184],["وَنَجِّنِى","dan selamatkanlah aku","wanajjinī",337],["مِنَ","dari","mina",1],["ٱلْقَوْمِ","kaum","l-qawmi",33],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97]],"t":"Dan Allah membuat perumpamaan bagi orang-orang yang beriman, istri Fir'aun, ketika dia berkata, \"Ya Tuhanku, bangunkanlah untukku satu rumah di sisi-Mu dalam surga dan selamatkanlah aku dari Fir'aun dan perbuatannya, dan selamatkanlah aku dari kaum yang zalim,\""},{"n":12,"w":[["وَمَرْيَمَ","dan Maryam","wamaryama",356],["ٱبْنَتَ","puteri","ib'nata",2796],["عِمْرَٰنَ","Imran","ʿim'rāna",1796],["ٱلَّتِىٓ","yang","allatī",195],["أَحْصَنَتْ","ia memelihara","aḥṣanat",1284],["فَرْجَهَا","kemaluannya/kehormatannya","farjahā",989],["فَنَفَخْنَا","maka Kami tiupkan","fanafakhnā",544],["فِيهِ","ke dalamnya","fīhi",7],["مِن","dari","min",1],["رُّوحِنَا","ruh Kami","rūḥinā",507],["وَصَدَّقَتْ","dan ia membenarkan","waṣaddaqat",837],["بِكَلِمَـٰتِ","dengan kalimat","bikalimāti",291],["رَبِّهَا","Tuhannya","rabbihā",15],["وَكُتُبِهِۦ","dan Kitab-kitab-Nya","wakutubihi",57],["وَكَانَتْ","dan ia adalah","wakānat",12],["مِنَ","dari/termasuk","mina",1],["ٱلْقَـٰنِتِينَ","orang-orang yang taat","l-qānitīna",808]],"t":"dan Maryam putri Imran yang memelihara kehormatannya, maka Kami tiupkan ke dalam rahimnya sebagian dari roh (ciptaan) Kami; dan dia membenarkan kalimat-kalimat Tuhannya dan kitab-kitab-Nya; dan dia termasuk orang-orang yang taat."}]