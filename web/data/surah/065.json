[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلنَّبِىُّ","Nabi","l-nabiyu",156],["إِذَا","apabila","idhā",23],["طَلَّقْتُمُ","kamu menceraikan","ṭallaqtumu",828],["ٱلنِّسَآءَ","isteri-isteri","l-nisāa",203],["فَطَلِّقُوهُنَّ","maka ceraikanlah mereka","faṭalliqūhunna",828],["لِعِدَّتِهِنَّ","bagi iddah mereka","liʿiddatihinna",772],["وَأَحْصُوا۟","dan hitunglah","wa-aḥṣū",815],["ٱلْعِدَّةَ ۖ","iddah itu","l-ʿidata",772],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["رَبَّكُمْ ۖ","Tuhan kalian","rabbakum",10],["لَا","tidak/jangan","lā",4],["تُخْرِجُوهُنَّ","kamu keluarkan mereka","tukh'rijūhunna",111],["مِنۢ","dari","min",0],["بُيُوتِهِنَّ","rumah-rumah mereka","buyūtihinna",182],["وَلَا","dan tidak/jangan","walā",4],["يَخْرُجْنَ","mereka keluar","yakhruj'na",225],["إِلَّآ","kecuali","illā",15],["أَن","bahwa","an",17],["يَأْتِينَ","mereka mendatangkan/berbuat","yatīna",48],["بِفَـٰحِشَةٍۢ","dengan kekejian","bifāḥishatin",573],["مُّبَيِّنَةٍۢ ۚ","terang/nyata","mubayyinatin",1931],["وَتِلْكَ","dan itu","watil'ka",19],["حُدُودُ","batas-batas/hukum-hukum","ḥudūdu",656],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَمَن","dan barang siapa","waman",12],["يَتَعَدَّ","melampaui batas/melanggar","yataʿadda",2071],["حُدُودَ","batas-batas/hukum-hukum","ḥudūda",656],["ٱللَّهِ","Allah","l-lahi",1],["فَقَدْ","maka sesungguhnya","faqad",24],["ظَلَمَ","dia berbuat zalim","ẓalama",104],["نَفْسَهُۥ ۚ","dirinya sendiri","nafsahu",39],["لَا","tidak","lā",4],["تَدْرِى","kamu mengetahui","tadrī",744],["لَعَلَّ","barang kali","laʿalla",96],["ٱللَّهَ","Allah","l-laha",1],["يُحْدِثُ","mengadakan yang baru","yuḥ'dithu",2076],["بَعْدَ","sesudah","baʿda",58],["ذَٰلِكَ","demikian itu","dhālika",19],["أَمْرًۭا","perkara/sesuatu","amran",66]],"t":"Wahai Nabi! Apabila kamu menceraikan istri-istrimu maka hendaklah kamu ceraikan mereka pada waktu mereka dapat (menghadapi) idahnya (yang wajar), dan hitunglah waktu idah itu, serta bertakwalah kepada Allah Tuhanmu. Janganlah kamu keluarkan mereka dari rumahnya dan janganlah (diizinkan) keluar kecuali jika mereka mengerjakan perbuatan keji yang jelas. Itulah hukum-hukum Allah, dan barangsiapa melanggar hukum-hukum Allah, maka sungguh, dia telah berbuat zalim terhadap dirinya sendiri. Kamu tidak mengetahui barangkali setelah itu Allah mengadakan suatu ketentuan yang baru."},{"n":2,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["بَلَغْنَ","telah sampai","balaghna",288],["أَجَلَهُنَّ","waktu mereka","ajalahunna",226],["فَأَمْسِكُوهُنَّ","maka tahanlah mereka","fa-amsikūhunna",539],["بِمَعْرُوفٍ","dengan baik","bimaʿrūfin",309],["أَوْ","atau","aw",42],["فَارِقُوهُنَّ","ceraikan mereka","fāriqūhunna",3411],["بِمَعْرُوفٍۢ","dengan baik","bimaʿrūfin",309],["وَأَشْهِدُوا۟","dan persaksikan","wa-ashhidū",1032],["ذَوَىْ","dua orang mempunyai","dhaway",113],["عَدْلٍۢ","keadilan","ʿadlin",654],["مِّنكُمْ","diantara kamu","minkum",0],["وَأَقِيمُوا۟","dan dirikanlah","wa-aqīmū",220],["ٱلشَّهَـٰدَةَ","kesakisan-kesaksian","l-shahādata",446],["لِلَّهِ ۚ","karena Allah","lillahi",1],["ذَٰلِكُمْ","demikian itu","dhālikum",19],["يُوعَظُ","diberi pengajaran","yūʿaẓu",640],["بِهِۦ","dengannya/dengan itu","bihi",16],["مَن","orang","man",12],["كَانَ","adalah","kāna",9],["يُؤْمِنُ","dia beriman","yu'minu",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَٱلْيَوْمِ","dan hari","wal-yawmi",25],["ٱلْـَٔاخِرِ ۚ","akhirat","l-ākhiri",72],["وَمَن","dan barang siapa","waman",12],["يَتَّقِ","bertaqwa","yattaqi",67],["ٱللَّهَ","Allah","l-laha",1],["يَجْعَل","Dia menjadikan","yajʿal",33],["لَّهُۥ","baginya","lahu",16],["مَخْرَجًۭا","jalan keluar","makhrajan",3747]],"t":"Maka apabila mereka telah mendekati akhir idahnya, maka rujuklah (kembali kepada) mereka dengan baik atau lepaskanlah mereka dengan baik dan persaksikanlah dengan dua orang saksi yang adil di antara kamu dan hendaklah kamu tegakkan kesaksian itu karena Allah. Demikianlah pengajaran itu diberikan bagi orang yang beriman kepada Allah dan hari akhirat. Barangsiapa bertakwa kepada Allah niscaya Dia akan membukakan jalan keluar baginya,"},{"n":3,"w":[["وَيَرْزُقْهُ","dan Dia memberi rizki","wayarzuq'hu",198],["مِنْ","dari","min",0],["حَيْثُ","arah","ḥaythu",373],["لَا","tidak","lā",4],["يَحْتَسِبُ ۚ","disangka","yaḥtasibu",2050],["وَمَن","dan barang siapa","waman",12],["يَتَوَكَّلْ","bertawakkal","yatawakkal",292],["عَلَى","atas","ʿalā",8],["ٱللَّهِ","Allah","l-lahi",1],["فَهُوَ","maka Dia","fahuwa",20],["حَسْبُهُۥٓ ۚ","mencukupi","ḥasbuhu",775],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["بَـٰلِغُ","menyampaikan","bālighu",1169],["أَمْرِهِۦ ۚ","urusan-Nya","amrihi",66],["قَدْ","sesungguhnya","qad",24],["جَعَلَ","menjadikan","jaʿala",33],["ٱللَّهُ","Allah","l-lahu",1],["لِكُلِّ","bagi segenap/tiap-tiap","likulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدْرًۭا","ketentuan/ukuran","qadran",1097]],"t":"Dan Dia memberinya rezeki dari arah yang tidak disangka-sangkanya. Dan barangsiapa bertawakal kepada Allah, niscaya Allah akan mencukupkan (keperluan)nya. Sesungguhnya Allah melaksanakan urusan-Nya. Sungguh, Allah telah mengadakan ketentuan bagi setiap sesuatu."},{"n":4,"w":[["وَٱلَّـٰٓـِٔى","dan wanita-wanita","wa-allāī",1692],["يَئِسْنَ","mereka berputus asa","ya-is'na",1018],["مِنَ","dari","mina",0],["ٱلْمَحِيضِ","haid","l-maḥīḍi",1884],["مِن","dari","min",0],["نِّسَآئِكُمْ","isteri-isterimu","nisāikum",203],["إِنِ","jika","ini",14],["ٱرْتَبْتُمْ","kamu ragu-ragu","ir'tabtum",946],["فَعِدَّتُهُنَّ","maka iddah mereka","faʿiddatuhunna",772],["ثَلَـٰثَةُ","tiga","thalāthatu",699],["أَشْهُرٍۢ","bulan","ashhurin",482],["وَٱلَّـٰٓـِٔى","dan wanita-wanita","wa-allāī",1692],["لَمْ","tidak","lam",32],["يَحِضْنَ ۚ","mereka haid","yaḥiḍ'na",4620],["وَأُو۟لَـٰتُ","dan wanita yang mempunyai","wa-ulātu",257],["ٱلْأَحْمَالِ","mengandung/hamil","l-aḥmāli",2958],["أَجَلُهُنَّ","waktu mereka","ajaluhunna",226],["أَن","bahwa","an",17],["يَضَعْنَ","mereka melahirkan","yaḍaʿna",497],["حَمْلَهُنَّ ۚ","kandungan mereka","ḥamlahunna",1056],["وَمَن","dan barang siapa","waman",12],["يَتَّقِ","bertakwa","yattaqi",67],["ٱللَّهَ","Allah","l-laha",1],["يَجْعَل","Dia akan menjadikan","yajʿal",33],["لَّهُۥ","baginya","lahu",16],["مِنْ","dari","min",0],["أَمْرِهِۦ","urusannya","amrihi",66],["يُسْرًۭا","mudah","yus'ran",1120]],"t":"Perempuan-perempuan yang tidak haid lagi (menopause) di antara istri-istrimu jika kamu ragu-ragu (tentang masa idahnya) maka idahnya adalah tiga bulan; dan begitu (pula) perempuan-perempuan yang tidak haid. Sedangkan perempuan-perempuan yang hamil, waktu idah mereka itu sampai mereka melahirkan kandungannya. Dan barangsiapa bertakwa kepada Allah, niscaya Dia menjadikan kemudahan baginya dalam urusannya."},{"n":5,"w":[["ذَٰلِكَ","demikian/itu","dhālika",19],["أَمْرُ","perintah","amru",66],["ٱللَّهِ","Allah","l-lahi",1],["أَنزَلَهُۥٓ","Dia diturunkannya","anzalahu",61],["إِلَيْكُمْ ۚ","kepada kamu","ilaykum",13],["وَمَن","dan barang siapa","waman",12],["يَتَّقِ","bertakwa","yattaqi",67],["ٱللَّهَ","Allah","l-laha",1],["يُكَفِّرْ","Dia menutupi/menghapus","yukaffir",663],["عَنْهُ","dari padanya","ʿanhu",21],["سَيِّـَٔاتِهِۦ","kesalahan-kesalahannya","sayyiātihi",325],["وَيُعْظِمْ","dan Dia memperbesar","wayuʿ'ẓim",4714],["لَهُۥٓ","baginya","lahu",16],["أَجْرًا","pahala","ajran",107]],"t":"Itulah perintah Allah yang diturunkan-Nya kepada kamu; barangsiapa bertakwa kepada Allah, niscaya Allah akan menghapus kesalahan-kesalahannya dan akan melipatgandakan pahala baginya."},{"n":6,"w":[["أَسْكِنُوهُنَّ","tempatkanlah mereka","askinūhunna",1281],["مِنْ","dari","min",0],["حَيْثُ","mana","ḥaythu",373],["سَكَنتُم","kamu bertempat tinggal","sakantum",638],["مِّن","dari","min",0],["وُجْدِكُمْ","yang kamu dapati/menurut kemampuan","wuj'dikum",4561],["وَلَا","dan jangan","walā",4],["تُضَآرُّوهُنَّ","kamu menyusahkan mereka","tuḍārrūhunna",2075],["لِتُضَيِّقُوا۟","untuk kamu menyempitkan","lituḍayyiqū",4462],["عَلَيْهِنَّ ۚ","atas mereka","ʿalayhinna",8],["وَإِن","dan jika","wa-in",14],["كُنَّ","mereka","kunna",9],["أُو۟لَـٰتِ","mempunyai","ulāti",257],["حَمْلٍۢ","kandungan","ḥamlin",1056],["فَأَنفِقُوا۟","maka berilah nafkah","fa-anfiqū",179],["عَلَيْهِنَّ","atas mereka","ʿalayhinna",8],["حَتَّىٰ","sehingga","ḥattā",80],["يَضَعْنَ","mereka melahirkan","yaḍaʿna",497],["حَمْلَهُنَّ ۚ","kandungan mereka","ḥamlahunna",1056],["فَإِنْ","maka jika","fa-in",14],["أَرْضَعْنَ","mereka menyusukan","arḍaʿna",1277],["لَكُمْ","bagi kalian","lakum",26],["فَـَٔاتُوهُنَّ","maka berilah mereka","faātūhunna",45],["أُجُورَهُنَّ ۖ","upah mereka","ujūrahunna",107],["وَأْتَمِرُوا۟","dan musyawarahkanlah","watamirū",2755],["بَيْنَكُم","diantara kamu","baynakum",47],["بِمَعْرُوفٍۢ ۖ","dengan baik","bimaʿrūfin",309],["وَإِن","dan jika","wa-in",14],["تَعَاسَرْتُمْ","kamu menemui kesulitan","taʿāsartum",4331],["فَسَتُرْضِعُ","maka akan menyusahkan","fasatur'ḍiʿu",1277],["لَهُۥٓ","kepadanya","lahu",16],["أُخْرَىٰ","lain","ukh'rā",172]],"t":"Tempatkanlah mereka (para istri) di mana kamu bertempat tinggal menurut kemampuanmu dan janganlah kamu menyusahkan mereka untuk menyempitkan (hati) mereka. Dan jika mereka (istri-istri yang sudah ditalak) itu sedang hamil, maka berikanlah kepada mereka nafkahnya sampai mereka melahirkan kandungannya, kemudian jika mereka menyusukan (anak-anak)mu maka berikanlah imbalannya kepada mereka; dan musyawarahkanlah di antara kamu (segala sesuatu) dengan baik; dan jika kamu menemui kesulitan, maka perempuan lain boleh menyusukan (anak itu) untuknya."},{"n":7,"w":[["لِيُنفِقْ","agar memberi nafkah","liyunfiq",179],["ذُو","orang yang mempunyai","dhū",113],["سَعَةٍۢ","keluasan/kemampuan","saʿatin",1228],["مِّن","dari/menurut","min",0],["سَعَتِهِۦ ۖ","kemampuan","saʿatihi",1228],["وَمَن","dan barang siapa","waman",12],["قُدِرَ","ditentukan/disempitkan","qudira",430],["عَلَيْهِ","atasnya","ʿalayhi",8],["رِزْقُهُۥ","rizkinya","riz'quhu",219],["فَلْيُنفِقْ","maka hendaknya memberi nafkah","falyunfiq",179],["مِمَّآ","dari apa (rizki)","mimmā",0],["ءَاتَىٰهُ","memberi kepadanya","ātāhu",45],["ٱللَّهُ ۚ","Allah","l-lahu",1],["لَا","tidak","lā",4],["يُكَلِّفُ","memaksa/memikulkan","yukallifu",1118],["ٱللَّهُ","Allah","l-lahu",1],["نَفْسًا","seseorang","nafsan",39],["إِلَّا","kecuali","illā",15],["مَآ","apa","mā",2],["ءَاتَىٰهَا ۚ","yang Dia berikannya","ātāhā",45],["سَيَجْعَلُ","kelak akan menjadikan","sayajʿalu",33],["ٱللَّهُ","Allah","l-lahu",1],["بَعْدَ","sesudah","baʿda",58],["عُسْرٍۢ","kesulitan","ʿus'rin",1298],["يُسْرًۭا","kemudahan","yus'ran",1120]],"t":"Hendaklah orang yang mempunyai keluasan memberi nafkah menurut kemampuannya, dan orang yang terbatas rezekinya, hendaklah memberi nafkah dari harta yang diberikan Allah kepadanya. Allah tidak membebani seseorang melainkan (sesuai) dengan apa yang diberikan Allah kepadanya. Allah kelak akan memberikan kelapangan setelah kesempitan."},{"n":8,"w":[["وَكَأَيِّن","dan berapa banyak","waka-ayyin",1081],["مِّن","dari","min",0],["قَرْيَةٍ","negeri","qaryatin",211],["عَتَتْ","sombong/mendurhakai","ʿatat",1296],["عَنْ","dari","ʿan",21],["أَمْرِ","perintah","amri",66],["رَبِّهَا","Tuhannya","rabbihā",10],["وَرُسُلِهِۦ","dan rasul-rasul-Nya","warusulihi",35],["فَحَاسَبْنَـٰهَا","maka Kami perhitungkannya","faḥāsabnāhā",1774],["حِسَابًۭا","perhitungan","ḥisāban",301],["شَدِيدًۭا","sangat/keras","shadīdan",213],["وَعَذَّبْنَـٰهَا","dan Kami mengazabnya","waʿadhabnāhā",280],["عَذَابًۭا","azab","ʿadhāban",36],["نُّكْرًۭا","mengerikan","nuk'ran",1951]],"t":"Dan betapa banyak (penduduk) negeri yang mendurhakai perintah Tuhan mereka dan rasul-rasul-Nya, maka Kami buat perhitungan terhadap penduduk negeri itu dengan perhitungan yang ketat, dan Kami azab mereka dengan azab yang mengerikan (di akhirat)."},{"n":9,"w":[["فَذَاقَتْ","maka mereka merasakan","fadhāqat",322],["وَبَالَ","akibat buruk","wabāla",1658],["أَمْرِهَا","urusannya/perbuatannya","amrihā",66],["وَكَانَ","dan adalah","wakāna",9],["عَـٰقِبَةُ","akibat/kesudahan","ʿāqibatu",350],["أَمْرِهَا","urusannya/perbuatannya","amrihā",66],["خُسْرًا","kerugian","khus'ran",2751]],"t":"Sehingga mereka merasakan akibat yang buruk dari perbuatannya, dan akibat perbuatan mereka itu adalah kerugian yang besar."},{"n":10,"w":[["أَعَدَّ","menyediakan","aʿadda",500],["ٱللَّهُ","Allah","l-lahu",1],["لَهُمْ","bagi mereka","lahum",11],["عَذَابًۭا","azab","ʿadhāban",36],["شَدِيدًۭا ۖ","sangat/keras","shadīdan",213],["فَٱتَّقُوا۟","maka bertakwalah","fa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["يَـٰٓأُو۟لِى","wahai orang-orang","yāulī",257],["ٱلْأَلْبَـٰبِ","pikiran/akal","l-albābi",586],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟ ۚ","(mereka) beriman","āmanū",18],["قَدْ","sesungguhnya","qad",24],["أَنزَلَ","menurunkan","anzala",61],["ٱللَّهُ","Allah","l-lahu",1],["إِلَيْكُمْ","kepadamu","ilaykum",13],["ذِكْرًۭا","pikiran/Al Qur'an","dhik'ran",149]],"t":"Allah menyediakan azab yang keras bagi mereka, maka bertakwalah kepada Allah wahai orang-orang yang mempunyai akal! (Yaitu) orang-orang yang beriman. Sungguh, Allah telah menurunkan peringatan kepadamu,"},{"n":11,"w":[["رَّسُولًۭا","seorang Rasul","rasūlan",35],["يَتْلُوا۟","membacakan","yatlū",199],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["ءَايَـٰتِ","ayat-ayat","āyāti",28],["ٱللَّهِ","Allah","l-lahi",1],["مُبَيِّنَـٰتٍۢ","yang menjelaskan","mubayyinātin",1930],["لِّيُخْرِجَ","karena Dia akan mengeluarkan","liyukh'rija",111],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan berbuat/beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",195],["مِنَ","dari","mina",0],["ٱلظُّلُمَـٰتِ","kegelapan","l-ẓulumāti",452],["إِلَى","kepada","ilā",13],["ٱلنُّورِ ۚ","cahaya","l-nūri",273],["وَمَن","dan barang siapa","waman",12],["يُؤْمِنۢ","beriman","yu'min",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَيَعْمَلْ","dan berbuat/beramal","wayaʿmal",44],["صَـٰلِحًۭا","kebajikan/saleh","ṣāliḥan",181],["يُدْخِلْهُ","Dia memasukkannya","yud'khil'hu",274],["جَنَّـٰتٍۢ","surga","jannātin",76],["تَجْرِى","mengalir","tajrī",208],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",234],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",221],["خَـٰلِدِينَ","mereka kekal","khālidīna",159],["فِيهَآ","di dalamnya","fīhā",3],["أَبَدًۭا ۖ","selama-lamanya","abadan",382],["قَدْ","sesungguhnya","qad",24],["أَحْسَنَ","membaguskan","aḥsana",484],["ٱللَّهُ","Allah","l-lahu",1],["لَهُۥ","kepadanya","lahu",16],["رِزْقًا","rizki","riz'qan",219]],"t":"(dengan mengutus) seorang Rasul yang membacakan ayat-ayat Allah kepadamu yang menerangkan (bermacam-macam hukum), agar Dia mengeluarkan orang-orang yang beriman dan mengerjakan kebajikan, dari kegelapan kepada cahaya. Dan barangsiapa beriman kepada Allah dan mengerjakan kebajikan, niscaya Dia akan memasukkannya ke dalam surga-surga yang mengalir di bawahnya sungai-sungai; mereka kekal di dalamnya selama-lamanya. Sungguh, Allah memberikan rezeki yang baik kepadanya."},{"n":12,"w":[["ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptkan","khalaqa",60],["سَبْعَ","tujuh","sabʿa",460],["سَمَـٰوَٰتٍۢ","langit","samāwātin",38],["وَمِنَ","dan dari","wamina",0],["ٱلْأَرْضِ","bumi","l-arḍi",22],["مِثْلَهُنَّ","seperti itu","mith'lahunna",155],["يَتَنَزَّلُ","turun/berlaku","yatanazzalu",1110],["ٱلْأَمْرُ","perintah","l-amru",66],["بَيْنَهُنَّ","diantara mereka/diantaranya","baynahunna",47],["لِتَعْلَمُوٓا۟","supaya kamu mengetahui","litaʿlamū",29],["أَنَّ","bahwa sesungguhnya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha Kuasa","qadīrun",260],["وَأَنَّ","dan bahwa sesungguhnya","wa-anna",30],["ٱللَّهَ","Allah","l-laha",1],["قَدْ","sungguh/benar-benar","qad",24],["أَحَاطَ","meliputi","aḥāṭa",561],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عِلْمًۢا","ilmu","ʿil'man",108]],"t":"Allah yang menciptakan tujuh langit dan dari (penciptaan) bumi juga serupa. Perintah Allah berlaku padanya, agar kamu mengetahui bahwa Allah Mahakuasa atas segala sesuatu, dan ilmu Allah benar-benar meliputi segala sesuatu."}]