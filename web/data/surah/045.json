[{"n":1,"w":[["حمٓ","Haa miim","hha-meem",1054]],"t":"Ḥā Mīm."},{"n":2,"w":[["تَنزِيلُ","turunnya","tanzīlu",636],["ٱلْكِتَـٰبِ","kitab","l-kitābi",49],["مِنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",113],["ٱلْحَكِيمِ","Maha Bijaksana","l-ḥakīmi",115]],"t":"Kitab (ini) diturunkan dari Allah Yang Mahaperkasa, Mahabijaksana."},{"n":3,"w":[["إِنَّ","sesungguhnya","inna",5],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["لَـَٔايَـٰتٍۢ","benar-benar terdapat tanda-tanda","laāyātin",28],["لِّلْمُؤْمِنِينَ","bagi orang-orang yang beriman","lil'mu'minīna",55]],"t":"Sungguh, pada langit dan bumi benar-benar terdapat tanda-tanda (kebesaran Allah) bagi orang-orang mukmin."},{"n":4,"w":[["وَفِى","dan pada","wafī",3],["خَلْقِكُمْ","menciptakan kalian","khalqikum",229],["وَمَا","dan apa yang","wamā",2],["يَبُثُّ","bertebaran","yabuthu",1325],["مِن","dari","min",0],["دَآبَّةٍ","binatang ternak","dābbatin",544],["ءَايَـٰتٌۭ","tanda-tanda","āyātun",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يُوقِنُونَ","mereka meyakini","yūqinūna",715]],"t":"Dan pada penciptaan dirimu dan pada makhluk bergerak yang bernyawa yang bertebaran (di bumi) terdapat tanda-tanda (kebesaran Allah) untuk kaum yang meyakini,"},{"n":5,"w":[["وَٱخْتِلَـٰفِ","dan pergantian","wa-ikh'tilāfi",1121],["ٱلَّيْلِ","malam","al-layli",136],["وَٱلنَّهَارِ","dan siang","wal-nahāri",209],["وَمَآ","dan apa yang","wamā",2],["أَنزَلَ","diturunkan","anzala",62],["ٱللَّهُ","Allah","l-lahu",1],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["مِن","dari","min",0],["رِّزْقٍۢ","rezeki","riz'qin",219],["فَأَحْيَا","lalu Dia menghidupkan","fa-aḥyā",230],["بِهِ","dengannya","bihi",16],["ٱلْأَرْضَ","bumi","l-arḍa",22],["بَعْدَ","sesudah","baʿda",58],["مَوْتِهَا","matinya","mawtihā",237],["وَتَصْرِيفِ","dan perkisaran","wataṣrīfi",2670],["ٱلرِّيَـٰحِ","angin","l-riyāḥi",382],["ءَايَـٰتٌۭ","tanda-tanda","āyātun",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يَعْقِلُونَ","mereka berakal","yaʿqilūna",241]],"t":"dan pada pergantian malam dan siang, dan hujan yang diturunkan Allah dari langit, lalu dengan (air hujan) itu dihidupkan-Nya bumi setelah mati (kering); dan pada perkisaran angin terdapat pula tanda-tanda (kebesaran Allah) bagi kaum yang mengerti."},{"n":6,"w":[["تِلْكَ","itulah","til'ka",19],["ءَايَـٰتُ","ayat-ayat","āyātu",28],["ٱللَّهِ","Allah","l-lahi",1],["نَتْلُوهَا","Kami bacakan","natlūhā",197],["عَلَيْكَ","atas kamu","ʿalayka",8],["بِٱلْحَقِّ ۖ","dengan benar","bil-ḥaqi",50],["فَبِأَىِّ","maka dengan yang mana","fabi-ayyi",198],["حَدِيثٍۭ","perkataan","ḥadīthin",387],["بَعْدَ","sesudah","baʿda",58],["ٱللَّهِ","Allah","l-lahi",1],["وَءَايَـٰتِهِۦ","dan ayat-ayat-Nya","waāyātihi",28],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18]],"t":"Itulah ayat-ayat Allah yang Kami bacakan kepadamu dengan sebenarnya; maka dengan perkataan mana lagi mereka akan beriman setelah Allah dan ayat-ayat-Nya."},{"n":7,"w":[["وَيْلٌۭ","kecelakaanlah","waylun",296],["لِّكُلِّ","bagi tiap-tiap","likulli",31],["أَفَّاكٍ","banyak berdusta","affākin",2146],["أَثِيمٍۢ","berdosa","athīmin",1035]],"t":"Celakalah bagi setiap orang yang banyak berdusta lagi banyak berdosa,"},{"n":8,"w":[["يَسْمَعُ","dia mendengar","yasmaʿu",148],["ءَايَـٰتِ","ayat-ayat","āyāti",28],["ٱللَّهِ","Allah","l-lahi",1],["تُتْلَىٰ","dibacakan","tut'lā",197],["عَلَيْهِ","atasnya","ʿalayhi",8],["ثُمَّ","kemudian","thumma",34],["يُصِرُّ","dia tetap","yuṣirru",1464],["مُسْتَكْبِرًۭا","menyombongkan diri","mus'takbiran",1202],["كَأَن","seakan-akan","ka-an",17],["لَّمْ","tidak","lam",32],["يَسْمَعْهَا ۖ","dia mendengar","yasmaʿhā",148],["فَبَشِّرْهُ","maka beri kabar gembira","fabashir'hu",311],["بِعَذَابٍ","dengan azab","biʿadhābin",36],["أَلِيمٍۢ","pedih","alīmin",167]],"t":"(yaitu) orang yang mendengar ayat-ayat Allah ketika dibacakan kepadanya, namun dia tetap menyombongkan diri seakan-akan dia tidak mendengarnya. Maka peringatkanlah dia dengan azab yang pedih."},{"n":9,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["عَلِمَ","dia mengetahui","ʿalima",29],["مِنْ","dari","min",0],["ءَايَـٰتِنَا","ayat-ayat Kami","āyātinā",28],["شَيْـًٔا","sesuatu","shayan",41],["ٱتَّخَذَهَا","dia menjadikannya","ittakhadhahā",98],["هُزُوًا ۚ","ejekan","huzuwan",782],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["مُّهِينٌۭ","menghinakan","muhīnun",666]],"t":"Dan apabila dia mengetahui sedikit tentang ayat-ayat Kami, maka (ayat-ayat itu) dijadikan olok-olok. Merekalah yang akan menerima azab yang menghinakan."},{"n":10,"w":[["مِّن","dari","min",0],["وَرَآئِهِمْ","belakang mereka","warāihim",442],["جَهَنَّمُ ۖ","neraka jahanam","jahannamu",151],["وَلَا","dan tidak","walā",4],["يُغْنِى","berguna","yugh'nī",271],["عَنْهُم","dari mereka","ʿanhum",21],["مَّا","apa-apa","mā",2],["كَسَبُوا۟","yang mereka kerjakan","kasabū",194],["شَيْـًۭٔا","sesuatu","shayan",41],["وَلَا","dan tidak","walā",4],["مَا","apa yang","mā",2],["ٱتَّخَذُوا۟","mereka jadikan","ittakhadhū",98],["مِن","dari","min",0],["دُونِ","selain","dūni",79],["ٱللَّهِ","Allah","l-lahi",1],["أَوْلِيَآءَ ۖ","penolong","awliyāa",132],["وَلَهُمْ","dan bagi mereka","walahum",11],["عَذَابٌ","azab","ʿadhābun",36],["عَظِيمٌ","besar","ʿaẓīmun",100]],"t":"Di hadapan mereka neraka Jahanam, dan tidak akan berguna bagi mereka sedikit pun apa yang telah mereka kerjakan, dan tidak pula (bermanfaat) apa yang mereka jadikan sebagai pelindung-pelindung (mereka) selain Allah. Dan mereka akan mendapat azab yang besar."},{"n":11,"w":[["هَـٰذَا","ini","hādhā",37],["هُدًۭى ۖ","petunjuk","hudan",133],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِـَٔايَـٰتِ","terhadap ayat-ayat","biāyāti",28],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["مِّن","dari","min",0],["رِّجْزٍ","siksaan","rij'zin",925],["أَلِيمٌ","pedih","alīmun",167]],"t":"Ini (Alquran) adalah petunjuk. Dan orang-orang yang mengingkari ayat-ayat Tuhannya, mereka akan mendapat azab berupa siksaan yang sangat pedih."},{"n":12,"w":[["۞ ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["سَخَّرَ","menundukkan","sakhara",474],["لَكُمُ","bagi kalian","lakumu",26],["ٱلْبَحْرَ","lautan","l-baḥra",286],["لِتَجْرِىَ","supaya berlayar","litajriya",207],["ٱلْفُلْكُ","perahu","l-ful'ku",451],["فِيهِ","di dalamnya/padanya","fīhi",3],["بِأَمْرِهِۦ","dengan perintah-Nya","bi-amrihi",66],["وَلِتَبْتَغُوا۟","dan supaya kamu mencari","walitabtaghū",342],["مِن","dari","min",0],["فَضْلِهِۦ","karunia-Nya","faḍlihi",135],["وَلَعَلَّكُمْ","dan supaya kamu","walaʿallakum",92],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",254]],"t":"Allah lah yang menundukkan laut untukmu agar kapal-kapal dapat berlayar di atasnya dengan perintah-Nya, dan agar kamu dapat mencari sebagian karunia-Nya, dan agar kamu bersyukur."},{"n":13,"w":[["وَسَخَّرَ","dan Dia menundukkan","wasakhara",474],["لَكُم","bagi kalian","lakum",26],["مَّا","apa yang","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa yang","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["جَمِيعًۭا","semuanya","jamīʿan",224],["مِّنْهُ ۚ","dari pada-Nya","min'hu",0],["إِنَّ","sesungguhnya","inna",5],["فِى","pada yang","fī",3],["ذَٰلِكَ","demikian itu","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar terdapat tanda-tanda","laāyātin",28],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يَتَفَكَّرُونَ","mereka berfikir","yatafakkarūna",577]],"t":"Dan Dia menundukkan apa yang ada di langit dan apa yang ada di bumi untukmu semuanya (sebagai rahmat) dari-Nya. Sungguh, dalam hal yang demikian itu benar-benar terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang berpikir."},{"n":14,"w":[["قُل","katakanlah","qul",6],["لِّلَّذِينَ","kepada orang-orang yang","lilladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["يَغْفِرُوا۟","mereka memaafkan","yaghfirū",185],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",7],["لَا","tidak","lā",4],["يَرْجُونَ","mereka mengharap","yarjūna",471],["أَيَّامَ","hari-hari","ayyāma",25],["ٱللَّهِ","Allah","l-lahi",1],["لِيَجْزِىَ","untuk Dia memberi balasan","liyajziya",164],["قَوْمًۢا","kaum","qawman",27],["بِمَا","terhadap apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَكْسِبُونَ","mereka kerjakan","yaksibūna",194]],"t":"Katakanlah (Muhammad) kepada orang-orang yang beriman, hendaklah mereka memaafkan orang-orang yang tidak takut akan hari-hari Allah, karena Dia akan membalas suatu kaum sesuai dengan apa yang telah mereka kerjakan."},{"n":15,"w":[["مَنْ","barang siapa","man",12],["عَمِلَ","berbuat","ʿamila",44],["صَـٰلِحًۭا","kebaikan","ṣāliḥan",95],["فَلِنَفْسِهِۦ ۖ","maka untuk dirinya sendiri","falinafsihi",39],["وَمَنْ","dan barang siapa","waman",12],["أَسَآءَ","berbuat kejahatan","asāa",1276],["فَعَلَيْهَا ۖ","maka atasnya","faʿalayhā",8],["ثُمَّ","kemudian","thumma",34],["إِلَىٰ","kepada","ilā",13],["رَبِّكُمْ","Tuhan kalian","rabbikum",10],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",146]],"t":"Barangsiapa mengerjakan kebajikan, maka itu untuk dirinya sendiri, dan barangsiapa mengerjakan kejahatan, maka itu akan menimpa dirinya sendiri; kemudian kepada Tuhanmu kamu dikembalikan."},{"n":16,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["ءَاتَيْنَا","telah Kami berikan","ātaynā",45],["بَنِىٓ","Bani","banī",81],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",270],["ٱلْكِتَـٰبَ","Al kitab","l-kitāba",49],["وَٱلْحُكْمَ","dan hukkum-hukum","wal-ḥuk'ma",367],["وَٱلنُّبُوَّةَ","dan kenabian","wal-nubuwata",1393],["وَرَزَقْنَـٰهُم","dan Kami berikan mereka rezeki","warazaqnāhum",196],["مِّنَ","dari","mina",0],["ٱلطَّيِّبَـٰتِ","yang baik-baik","l-ṭayibāti",255],["وَفَضَّلْنَـٰهُمْ","dan Kami lebihkan mereka","wafaḍḍalnāhum",568],["عَلَى","atas","ʿalā",8],["ٱلْعَـٰلَمِينَ","alam semesta","l-ʿālamīna",163]],"t":"Dan sungguh, kepada Bani Israil telah Kami berikan Kitab (Taurat), kekuasaan dan kenabian, Kami anugerahkan kepada mereka rezeki yang baik, dan Kami lebihkan mereka atas bangsa-bangsa (pada masa itu)."},{"n":17,"w":[["وَءَاتَيْنَـٰهُم","dan Kami berikan kepada mereka","waātaynāhum",45],["بَيِّنَـٰتٍۢ","keterangan-keterangan","bayyinātin",174],["مِّنَ","dari","mina",0],["ٱلْأَمْرِ ۖ","urusan","l-amri",66],["فَمَا","maka tidak","famā",2],["ٱخْتَلَفُوٓا۟","mereka perselisihkan","ikh'talafū",337],["إِلَّا","kecuali","illā",15],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["مَا","apa","mā",2],["جَآءَهُمُ","datang kepada mereka","jāahumu",43],["ٱلْعِلْمُ","ilmu pengetahuan","l-ʿil'mu",111],["بَغْيًۢا","kedengkian","baghyan",776],["بَيْنَهُمْ ۚ","diantara mereka","baynahum",47],["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["يَقْضِى","Dia akan memutuskan","yaqḍī",202],["بَيْنَهُمْ","diantara mereka","baynahum",47],["يَوْمَ","hari","yawma",25],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",177],["فِيمَا","tentang apa","fīmā",3],["كَانُوا۟","adalah mereka","kānū",9],["فِيهِ","didalamnya","fīhi",3],["يَخْتَلِفُونَ","mereka perselisihkan","yakhtalifūna",337]],"t":"Dan Kami berikan kepada mereka keterangan-keterangan yang jelas tentang urusan (agama); maka mereka tidak berselisih kecuali setelah datang ilmu kepada mereka, karena kedengkian (yang ada) di antara mereka. Sungguh, Tuhanmu akan memberi putusan kepada mereka pada hari Kiamat terhadap apa yang selalu mereka perselisihkan."},{"n":18,"w":[["ثُمَّ","kemudian","thumma",34],["جَعَلْنَـٰكَ","Kami jadikan kamu","jaʿalnāka",33],["عَلَىٰ","atas","ʿalā",8],["شَرِيعَةٍۢ","suatu syari'at","sharīʿatin",2832],["مِّنَ","dari","mina",0],["ٱلْأَمْرِ","urusan itu","l-amri",66],["فَٱتَّبِعْهَا","maka ikutilah ia","fa-ittabiʿ'hā",86],["وَلَا","dan jangan","walā",4],["تَتَّبِعْ","kamu mengikuti","tattabiʿ",86],["أَهْوَآءَ","keinginan","ahwāa",571],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Kemudian Kami jadikan engkau (Muhammad) mengikuti syariat (peraturan) dari agama itu, maka ikutilah (syariat itu) dan janganlah engkau ikuti keinginan orang-orang yang tidak tahu."},{"n":19,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["لَن","tidak","lan",112],["يُغْنُوا۟","mereka dapat menolak","yugh'nū",271],["عَنكَ","dari kamu","ʿanka",21],["مِنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["شَيْـًۭٔا ۚ","sedikit","shayan",41],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلظَّـٰلِمِينَ","orang-orang ynag zalim","l-ẓālimīna",88],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",71],["أَوْلِيَآءُ","penolong/pelindung","awliyāu",132],["بَعْضٍۢ ۖ","sebagian","baʿḍin",71],["وَٱللَّهُ","dan Allah","wal-lahu",1],["وَلِىُّ","penolong/pelindung","waliyyu",132],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",245]],"t":"Sungguh, mereka tidak akan dapat menghindarkan engkau sedikit pun dari (azab) Allah. Dan sungguh, orang-orang yang zalim itu sebagian menjadi pelindung atas sebagian yang lain; sedang Allah pelindung bagi orang-orang yang bertakwa."},{"n":20,"w":[["هَـٰذَا","ini","hādhā",37],["بَصَـٰٓئِرُ","pedoman","baṣāiru",1057],["لِلنَّاسِ","bagi manusia","lilnnāsi",52],["وَهُدًۭى","dan petunjuk","wahudan",133],["وَرَحْمَةٌۭ","dan rahmat","waraḥmatun",105],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يُوقِنُونَ","mereka meyakini","yūqinūna",715]],"t":"(Alquran) ini adalah pedoman bagi manusia, petunjuk dan rahmat bagi kaum yang meyakini."},{"n":21,"w":[["أَمْ","ataukah/apakah","am",84],["حَسِبَ","mengira","ḥasiba",266],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ٱجْتَرَحُوا۟","mereka berbuat","ij'taraḥū",4611],["ٱلسَّيِّـَٔاتِ","kejahatan","l-sayiāti",205],["أَن","bahwa","an",17],["نَّجْعَلَهُمْ","Kami menjadikan mereka","najʿalahum",33],["كَٱلَّذِينَ","seperti orang-orang yang","ka-alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan berbuat","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebaikan","l-ṣāliḥāti",95],["سَوَآءًۭ","sama","sawāan",405],["مَّحْيَاهُمْ","kehidupan mereka","maḥyāhum",2521],["وَمَمَاتُهُمْ ۚ","dan kematian mereka","wamamātuhum",1900],["سَآءَ","amat buruk","sāa",372],["مَا","apa yang","mā",2],["يَحْكُمُونَ","mereka putuskan","yaḥkumūna",259]],"t":"Apakah orang-orang yang melakukan kejahatan itu mengira bahwa Kami akan memperlakukan mereka seperti orang-orang yang beriman dan yang mengerjakan kebajikan, yaitu sama dalam kehidupan dan kematian mereka? Alangkah buruknya penilaian mereka itu."},{"n":22,"w":[["وَخَلَقَ","dan menciptakan","wakhalaqa",61],["ٱللَّهُ","Allah","l-lahu",1],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَلِتُجْزَىٰ","dan untuk diberi balasan","walituj'zā",164],["كُلُّ","tiap-tiap","kullu",31],["نَفْسٍۭ","jiwa","nafsin",39],["بِمَا","dengan apa","bimā",2],["كَسَبَتْ","ia usahakan","kasabat",194],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يُظْلَمُونَ","mereka dianiaya/dirugikan","yuẓ'lamūna",107]],"t":"Dan Allah menciptakan langit dan bumi dengan tujuan yang benar, dan agar setiap jiwa diberi balasan sesuai dengan apa yang dikerjakannya, dan mereka tidak akan dirugikan."},{"n":23,"w":[["أَفَرَءَيْتَ","adakah kamu melihat","afara-ayta",46],["مَنِ","orang","mani",12],["ٱتَّخَذَ","ia menjadikan","ittakhadha",98],["إِلَـٰهَهُۥ","Tuhannya","ilāhahu",75],["هَوَىٰهُ","hawa nafsunya","hawāhu",781],["وَأَضَلَّهُ","dan membiarkan sesat padanya","wa-aḍallahu",187],["ٱللَّهُ","Allah","l-lahu",1],["عَلَىٰ","atas","ʿalā",8],["عِلْمٍۢ","pengetahuan","ʿil'min",111],["وَخَتَمَ","dan Dia menutup","wakhatama",1431],["عَلَىٰ","atas","ʿalā",8],["سَمْعِهِۦ","pendengarannya","samʿihi",473],["وَقَلْبِهِۦ","dan hatinya","waqalbihi",89],["وَجَعَلَ","dan Dia menjadikan","wajaʿala",33],["عَلَىٰ","atas","ʿalā",8],["بَصَرِهِۦ","penglihatannya","baṣarihi",248],["غِشَـٰوَةًۭ","tutupan","ghishāwatan",2376],["فَمَن","maka siapakah","faman",12],["يَهْدِيهِ","memberi petunjuk kepadanya","yahdīhi",80],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["ٱللَّهِ ۚ","Allah","l-lahi",1],["أَفَلَا","apakah maka tidak","afalā",4],["تَذَكَّرُونَ","kamu ingat/mengambil pelajaran","tadhakkarūna",233]],"t":"Maka pernahkah kamu melihat orang yang menjadikan hawa nafsunya sebagai tuhannya dan Allah membiarkannya sesat dengan sepengetahuan-Nya, dan Allah telah mengunci pendengaran dan hatinya serta meletakkan tutup atas penglihatannya? Maka siapakah yang mampu memberinya petunjuk setelah Allah (membiarkannya sesat)? Mengapa kamu tidak mengambil pelajaran?"},{"n":24,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مَا","tidaklah","mā",2],["هِىَ","ini","hiya",191],["إِلَّا","kecuali","illā",15],["حَيَاتُنَا","kehidupan kami","ḥayātunā",153],["ٱلدُّنْيَا","dunia","l-dun'yā",104],["نَمُوتُ","kami mati","namūtu",307],["وَنَحْيَا","dan kami hidup","wanaḥyā",1047],["وَمَا","dan tidak","wamā",2],["يُهْلِكُنَآ","membinasakan kami","yuh'likunā",231],["إِلَّا","kecuali","illā",15],["ٱلدَّهْرُ ۚ","masa","l-dahru",2349],["وَمَا","dan tidak","wamā",2],["لَهُم","mereka mempunyai","lahum",11],["بِذَٰلِكَ","tentang itu","bidhālika",19],["مِنْ","dari","min",0],["عِلْمٍ ۖ","pengetahuan","ʿil'min",111],["إِنْ","tidaklah","in",14],["هُمْ","mereka","hum",11],["إِلَّا","kecuali","illā",15],["يَظُنُّونَ","mereka menduga-duga","yaẓunnūna",252]],"t":"Dan mereka berkata, \"Kehidupan ini tidak lain hanyalah kehidupan di dunia saja, kita mati dan kita hidup, dan tidak ada yang membinasakan kita selain masa.\" Tetapi mereka tidak mempunyai ilmu tentang itu, mereka hanyalah menduga-duga saja."},{"n":25,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",197],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["بَيِّنَـٰتٍۢ","nyata/jelas","bayyinātin",174],["مَّا","tidak","mā",2],["كَانَ","adalah","kāna",9],["حُجَّتَهُمْ","bantahan mereka","ḥujjatahum",960],["إِلَّآ","kecuali","illā",15],["أَن","bahwa","an",17],["قَالُوا۟","mereka mengatakan","qālū",6],["ٱئْتُوا۟","datangkanlah","i'tū",48],["بِـَٔابَآئِنَآ","dengan bapak-bapak kami","biābāinā",106],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",199]],"t":"Dan apabila kepada mereka dibacakan ayat-ayat Kami yang jelas, tidak ada bantahan mereka selain mengatakan, \"Hidupkanlah kembali nenek moyang kami, jika kamu orang yang benar.\""},{"n":26,"w":[["قُلِ","katakanlah","quli",6],["ٱللَّهُ","Allah","l-lahu",1],["يُحْيِيكُمْ","Dia menghidupkan kalian","yuḥ'yīkum",230],["ثُمَّ","kemudian","thumma",34],["يُمِيتُكُمْ","Dia mematikan kalian","yumītukum",481],["ثُمَّ","kemudian","thumma",34],["يَجْمَعُكُمْ","Dia mengumpulkan kamu","yajmaʿukum",464],["إِلَىٰ","pada","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",177],["لَا","tidak ada","lā",4],["رَيْبَ","keraguan","rayba",553],["فِيهِ","didalamnya","fīhi",3],["وَلَـٰكِنَّ","akan tetapi","walākinna",208],["أَكْثَرَ","kebanyakan","akthara",145],["ٱلنَّاسِ","manusia","l-nāsi",52],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Katakanlah, \"Allah yang menghidupkan kemudian mematikan kamu, setelah itu mengumpulkan kamu pada hari Kiamat yang tidak diragukan lagi; tetapi kebanyakan manusia tidak mengetahui.\""},{"n":27,"w":[["وَلِلَّهِ","dan bagi Allah","walillahi",1],["مُلْكُ","kerajaan","mul'ku",250],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["وَيَوْمَ","dan hari","wayawma",25],["تَقُومُ","terjadi","taqūmu",349],["ٱلسَّاعَةُ","kiamat","l-sāʿatu",251],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["يَخْسَرُ","rugilah","yakhsaru",606],["ٱلْمُبْطِلُونَ","orang-orang yang mengerjakan kebathilan","l-mub'ṭilūna",1373]],"t":"Dan milik Allah lah kerajaan langit dan bumi. Dan pada hari terjadinya Kiamat, akan rugilah pada hari itu orang-orang yang mengerjakan kebatilan (dosa)."},{"n":28,"w":[["وَتَرَىٰ","dan kamu lihat","watarā",46],["كُلَّ","tiap-tiap","kulla",31],["أُمَّةٍۢ","ummat","ummatin",190],["جَاثِيَةًۭ ۚ","berlutut","jāthiyatan",3532],["كُلُّ","setiap","kullu",31],["أُمَّةٍۢ","ummat","ummatin",190],["تُدْعَىٰٓ","dipanggil","tud'ʿā",65],["إِلَىٰ","kepada","ilā",13],["كِتَـٰبِهَا","kitabnya/catatannya","kitābihā",49],["ٱلْيَوْمَ","pada hari","l-yawma",25],["تُجْزَوْنَ","kamu diberi balasan","tuj'zawna",164],["مَا","apa yang","mā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Dan (pada hari itu) engkau akan melihat setiap umat berlutut. Setiap umat dipanggil untuk (melihat) buku catatan amalnya. Pada hari itu kamu diberi balasan atas apa yang telah kamu kerjakan."},{"n":29,"w":[["هَـٰذَا","ini","hādhā",37],["كِتَـٰبُنَا","kitab/catatan kami","kitābunā",49],["يَنطِقُ","ia menuturkan","yanṭiqu",917],["عَلَيْكُم","atas kalian","ʿalaykum",8],["بِٱلْحَقِّ ۚ","dengan benar","bil-ḥaqi",50],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",9],["نَسْتَنسِخُ","Kami menyuruh mencatat","nastansikhu",4655],["مَا","apa yang","mā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"(Allah berfirman), \"Inilah kitab (catatan) Kami yang menuturkan kepadamu dengan sebenar-benarnya. Sesungguhnya Kami telah menyuruh mencatat apa yang telah kamu kerjakan.\""},{"n":30,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan berbuat","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebaikan","l-ṣāliḥāti",95],["فَيُدْخِلُهُمْ","maka memasukkan mereka","fayud'khiluhum",275],["رَبُّهُمْ","Tuhan mereka","rabbuhum",10],["فِى","dalam","fī",3],["رَحْمَتِهِۦ ۚ","rahmat-Nya","raḥmatihi",105],["ذَٰلِكَ","demikian itu","dhālika",19],["هُوَ","ia/itu","huwa",20],["ٱلْفَوْزُ","keuntungan","l-fawzu",526],["ٱلْمُبِينُ","nyata","l-mubīnu",102]],"t":"Adapun orang-orang yang beriman dan mengerjakan kebajikan, maka Tuhan memasukkan mereka ke dalam rahmat-Nya (surga). Demikian itulah kemenangan yang nyata."},{"n":31,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوٓا۟","kafir/ingkar","kafarū",40],["أَفَلَمْ","apakah belum/tidak","afalam",32],["تَكُنْ","adalah","takun",9],["ءَايَـٰتِى","ayat-ayat-Ku","āyātī",28],["تُتْلَىٰ","dibacakan","tut'lā",197],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["فَٱسْتَكْبَرْتُمْ","lalu kamu menyombngkan diri","fa-is'takbartum",300],["وَكُنتُمْ","dan kalian","wakuntum",9],["قَوْمًۭا","kaum","qawman",27],["مُّجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",228]],"t":"Sedangkan (kepada) orang-orang yang kafir (difirmankan), \"Bukankah ayat-ayat-Ku telah dibacakan kepadamu, tetapi kamu menyombongkan diri dan kamu menjadi orang-orang yang berbuat dosa?\""},{"n":32,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["إِنَّ","sesungguhnya","inna",5],["وَعْدَ","janji","waʿda",246],["ٱللَّهِ","Allah","l-lahi",1],["حَقٌّۭ","benar","ḥaqqun",50],["وَٱلسَّاعَةُ","dan kiamat","wal-sāʿatu",251],["لَا","tidak ada","lā",4],["رَيْبَ","keraguan","rayba",553],["فِيهَا","didalamnya","fīhā",3],["قُلْتُم","kamu mengatakan","qul'tum",6],["مَّا","tidak","mā",2],["نَدْرِى","kami tahu","nadrī",729],["مَا","apa","mā",2],["ٱلسَّاعَةُ","kiamat itu","l-sāʿatu",251],["إِن","tidaklah","in",14],["نَّظُنُّ","kami mengira","naẓunnu",252],["إِلَّا","kecuali","illā",15],["ظَنًّۭا","dugaan","ẓannan",483],["وَمَا","dan tidaklah","wamā",2],["نَحْنُ","kami","naḥnu",130],["بِمُسْتَيْقِنِينَ","orang-orang yang meyakini","bimus'tayqinīna",3865]],"t":"Dan apabila dikatakan (kepadamu), \"Sungguh, janji Allah itu benar, dan hari Kiamat itu tidak diragukan adanya,\" kamu menjawab, \"Kami tidak tahu apakah hari Kiamat itu, kami hanyalah menduga-duga saja, dan kami tidak yakin.\""},{"n":33,"w":[["وَبَدَا","dan nyata","wabadā",775],["لَهُمْ","bagi mereka","lahum",11],["سَيِّـَٔاتُ","kejelekan-kejelekan","sayyiātu",205],["مَا","apa yang","mā",2],["عَمِلُوا۟","mereka perbuat","ʿamilū",44],["وَحَاقَ","dan meliputi","waḥāqa",820],["بِهِم","pada mereka","bihim",11],["مَّا","apa yang","mā",2],["كَانُوا۟","mereka adalah","kānū",9],["بِهِۦ","dengannya","bihi",16],["يَسْتَهْزِءُونَ","mereka memperolok-olokan","yastahziūna",495]],"t":"Dan nyatalah bagi mereka keburukan-keburukan yang mereka kerjakan, dan berlakulah (azab) terhadap mereka yang dahulu mereka perolok-olokkan."},{"n":34,"w":[["وَقِيلَ","dan dikatakan","waqīla",6],["ٱلْيَوْمَ","pada hari","l-yawma",25],["نَنسَىٰكُمْ","Kami melupakan","nansākum",334],["كَمَا","sebagaimana","kamā",2],["نَسِيتُمْ","kamu melupakan","nasītum",334],["لِقَآءَ","perjumpaan","liqāa",439],["يَوْمِكُمْ","harimu","yawmikum",25],["هَـٰذَا","ini","hādhā",37],["وَمَأْوَىٰكُمُ","dan tempat tinggalmu","wamawākumu",466],["ٱلنَّارُ","neraka","l-nāru",78],["وَمَا","dan tidak ada","wamā",2],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["نَّـٰصِرِينَ","seorang penolong","nāṣirīna",790]],"t":"Dan kepada mereka dikatakan, \"Pada hari ini Kami melupakan kamu sebagaimana kamu telah melupakan pertemuan (dengan) harimu ini; dan tempat kembalimu ialah neraka, dan sekali-kali tidak akan ada penolong bagimu."},{"n":35,"w":[["ذَٰلِكُم","demikian tiu","dhālikum",19],["بِأَنَّكُمُ","karena sesungguhnya kamu","bi-annakumu",30],["ٱتَّخَذْتُمْ","kalian menjadikan","ittakhadhtum",98],["ءَايَـٰتِ","ayat-ayat","āyāti",28],["ٱللَّهِ","Allah","l-lahi",1],["هُزُوًۭا","olok-olokan","huzuwan",782],["وَغَرَّتْكُمُ","dan telah menipu kamu","wagharratkumu",626],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",153],["ٱلدُّنْيَا ۚ","dunia","l-dun'yā",104],["فَٱلْيَوْمَ","maka pada hari","fal-yawma",25],["لَا","tidak","lā",4],["يُخْرَجُونَ","mereka dikeluarkan","yukh'rajūna",114],["مِنْهَا","darinya(neraka)","min'hā",0],["وَلَا","dan tidaklah","walā",4],["هُمْ","mereka","hum",11],["يُسْتَعْتَبُونَ","mereka diberi kesempatan bertaubat","yus'taʿtabūna",1695]],"t":"Yang demikian itu karena sesungguhnya kamu telah menjadikan ayat-ayat Allah sebagai olok-olokkan, dan kamu telah ditipu oleh kehidupan dunia.\" Maka pada hari ini mereka tidak dikeluarkan dari neraka dan tidak pula mereka diberi kesempatan untuk bertobat."},{"n":36,"w":[["فَلِلَّهِ","maka bagi Allah","falillahi",1],["ٱلْحَمْدُ","segala puji","l-ḥamdu",272],["رَبِّ","Tuhan","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَرَبِّ","dan Tuhan","warabbi",10],["ٱلْأَرْضِ","Bumi","l-arḍi",22],["رَبِّ","Tuhan","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",163]],"t":"Segala puji hanya bagi Allah, Tuhan (pemilik) langit dan bumi, Tuhan seluruh alam."},{"n":37,"w":[["وَلَهُ","dan bagi-Nya","walahu",16],["ٱلْكِبْرِيَآءُ","kebesaran","l-kib'riyāu",2422],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",113],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",115]],"t":"Dan hanya bagi-Nya segala keagungan di langit dan di bumi, dan Dialah Yang Mahaperkasa, Mahabijaksana."}]