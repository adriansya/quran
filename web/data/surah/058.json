[{"n":1,"w":[["قَدْ","sesungguhnya","qad",24],["سَمِعَ","mendengar","samiʿa",143],["ٱللَّهُ","Allah","l-lahu",1],["قَوْلَ","perkataan","qawla",117],["ٱلَّتِى","yang (wanita)","allatī",7],["تُجَـٰدِلُكَ","ia mengajukan gugatan kepadamu","tujādiluka",427],["فِى","pada/tentang","fī",3],["زَوْجِهَا","suaminya/pasangannya","zawjihā",150],["وَتَشْتَكِىٓ","dan ia mengadukan","watashtakī",4324],["إِلَى","kepada","ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["وَٱللَّهُ","dan Allah","wal-lahu",1],["يَسْمَعُ","mendengar","yasmaʿu",143],["تَحَاوُرَكُمَآ ۚ","soal jawab kamu berdua","taḥāwurakumā",4348],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["سَمِيعٌۢ","Maha Mendengar","samīʿun",253],["بَصِيرٌ","Maha Melihat","baṣīrun",233]],"t":"Sungguh, Allah telah mendengar ucapan perempuan yang mengajukan gugatan kepadamu (Muhammad) tentang suaminya, dan mengadukan (halnya) kepada Allah, dan Allah mendengar percakapan antara kamu berdua. Sesungguhnya Allah Maha Mendengar, Maha Melihat."},{"n":2,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُظَـٰهِرُونَ","(mereka) menzihar","yuẓāhirūna",1167],["مِنكُم","diantara kamu","minkum",0],["مِّن","dari","min",0],["نِّسَآئِهِم","istri-istri mereka","nisāihim",204],["مَّا","tidak","mā",2],["هُنَّ","mereka (istri-istri)","hunna",399],["أُمَّهَـٰتِهِمْ ۖ","ibu-ibu mereka","ummahātihim",339],["إِنْ","bahwa","in",14],["أُمَّهَـٰتُهُمْ","ibu mereka","ummahātuhum",339],["إِلَّا","kecuali","illā",15],["ٱلَّـٰٓـِٔى","yang (ibu-ibu)","allāī",1697],["وَلَدْنَهُمْ ۚ","melahirkan mereka","waladnahum",934],["وَإِنَّهُمْ","dan sesungguhnya mereka","wa-innahum",5],["لَيَقُولُونَ","benar-benar mengatakan","layaqūlūna",6],["مُنكَرًۭا","mungkar","munkaran",554],["مِّنَ","dari","mina",0],["ٱلْقَوْلِ","perkataan","l-qawli",117],["وَزُورًۭا ۚ","dan dusta","wazūran",1695],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["لَعَفُوٌّ","benar-benar Maha Pemaaf","laʿafuwwun",1294],["غَفُورٌۭ","Maha Pengampun","ghafūrun",118]],"t":"Orang-orang di antara kamu yang menzihar istrinya, (menganggap istrinya sebagai ibunya, padahal) istri mereka itu bukanlah ibunya. Ibu-ibu mereka hanyalah perempuan yang melahirkannya. Dan sesungguhnya mereka benar-benar telah mengucapkan suatu perkataan yang mungkar dan dusta. Dan sesungguhnya Allah Maha Pemaaf, Maha Pengampun."},{"n":3,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["يُظَـٰهِرُونَ","(mereka) menzhihar","yuẓāhirūna",1167],["مِن","dari","min",0],["نِّسَآئِهِمْ","istri-istri mereka","nisāihim",204],["ثُمَّ","kemudian","thumma",34],["يَعُودُونَ","mereka kembali","yaʿūdūna",546],["لِمَا","terhadap apa-apa","limā",2],["قَالُوا۟","mereka katakan/ucapkan","qālū",6],["فَتَحْرِيرُ","maka memerdekakan","fataḥrīru",1404],["رَقَبَةٍۢ","seorang budak","raqabatin",924],["مِّن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",16],["يَتَمَآسَّا ۚ","keduanya bercampur","yatamāssā",2791],["ذَٰلِكُمْ","demikian itu","dhālikum",19],["تُوعَظُونَ","kamu diajar","tūʿaẓūna",643],["بِهِۦ ۚ","dengannya","bihi",17],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",262]],"t":"Dan mereka yang menzihar istrinya, kemudian menarik kembali apa yang telah mereka ucapkan, maka (mereka diwajibkan) memerdekakan seorang budak sebelum kedua suami istri itu bercampur. Demikianlah yang diajarkan kepadamu, dan Allah Mahateliti atas apa yang kamu kerjakan."},{"n":4,"w":[["فَمَن","maka barang siapa","faman",12],["لَّمْ","tidak","lam",32],["يَجِدْ","mendapatkan","yajid",106],["فَصِيَامُ","maka berpuasalah","faṣiyāmu",894],["شَهْرَيْنِ","dua bulan","shahrayni",483],["مُتَتَابِعَيْنِ","berturut-turut","mutatābiʿayni",2518],["مِن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",16],["يَتَمَآسَّا ۖ","keduanya bercampur","yatamāssā",2791],["فَمَن","maka barang siapa","faman",12],["لَّمْ","tidak","lam",32],["يَسْتَطِعْ","kuasa","yastaṭiʿ",280],["فَإِطْعَامُ","maka memberi makan","fa-iṭ'ʿāmu",1720],["سِتِّينَ","enam puluh","sittīna",4285],["مِسْكِينًۭا ۚ","orang miskin","mis'kīnan",458],["ذَٰلِكَ","demikian itu","dhālika",19],["لِتُؤْمِنُوا۟","supaya kamu beriman","litu'minū",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَرَسُولِهِۦ ۚ","dan rasulnya","warasūlihi",35],["وَتِلْكَ","dan itulah","watil'ka",19],["حُدُودُ","batas/batas/hukum-hukum","ḥudūdu",659],["ٱللَّهِ ۗ","Allah","l-lahi",1],["وَلِلْكَـٰفِرِينَ","dan orang-orang kafir","walil'kāfirīna",90],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌ","pedih","alīmun",162]],"t":"Maka barangsiapa tidak dapat (memerdekakan hamba sahaya), maka (dia wajib) berpuasa dua bulan berturut-turut sebelum keduanya bercampur. Tetapi barangsiapa tidak mampu, maka (wajib) memberi makan enam puluh orang miskin. Demikianlah agar kamu beriman kepada Allah dan Rasul-Nya. Itulah hukum-hukum Allah, dan bagi orang-orang yang mengingkarinya akan mendapat azab yang sangat pedih."},{"n":5,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُحَآدُّونَ","(mereka) menentang","yuḥāddūna",2805],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ","dan rasulnya","warasūlahu",35],["كُبِتُوا۟","mereka dihinakan","kubitū",1871],["كَمَا","sebagaimana","kamā",2],["كُبِتَ","dihinakan","kubita",1871],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلِهِمْ ۚ","sebelum mereka","qablihim",51],["وَقَدْ","dan sesungguhnya","waqad",24],["أَنزَلْنَآ","Kami menurunkan","anzalnā",61],["ءَايَـٰتٍۭ","ayat-ayat","āyātin",28],["بَيِّنَـٰتٍۢ ۚ","jelas/nyata","bayyinātin",169],["وَلِلْكَـٰفِرِينَ","dan bagi orang-orang kafir","walil'kāfirīna",90],["عَذَابٌۭ","azab","ʿadhābun",36],["مُّهِينٌۭ","menghinakan","muhīnun",673]],"t":"Sesungguhnya orang-orang yang menentang Allah dan Rasul-Nya pasti mendapat kehinaan sebagaimana kehinaan yang telah didapat oleh orang-orang sebelum mereka. Dan sungguh, kami telah menurunkan bukti-bukti yang nyata. Dan bagi orang-orang yang mengingkarinya akan mendapat azab yang menghinakan."},{"n":6,"w":[["يَوْمَ","pada hari","yawma",25],["يَبْعَثُهُمُ","membangkitkan mereka","yabʿathuhumu",228],["ٱللَّهُ","Allah","l-lahu",1],["جَمِيعًۭا","semuanya","jamīʿan",225],["فَيُنَبِّئُهُم","lalu Dia memberi tahu mereka","fayunabbi-uhum",256],["بِمَا","tentang apa-apa","bimā",2],["عَمِلُوٓا۟ ۚ","mereka kerjakan","ʿamilū",44],["أَحْصَىٰهُ","menghitungnya","aḥṣāhu",818],["ٱللَّهُ","Allah","l-lahu",1],["وَنَسُوهُ ۚ","dan mereka melupakannya","wanasūhu",334],["وَٱللَّهُ","dan Allah","wal-lahu",1],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","setiap/segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["شَهِيدٌ","Maha Menyaksikan","shahīdun",215]],"t":"Pada hari itu mereka semuanya dibangkitkan Allah, lalu diberitakan-Nya kepada mereka apa yang telah mereka kerjakan. Allah menghitungnya (semua amal perbuatan itu), meskipun mereka telah melupakannya. Dan Allah Maha Menyaksikan segala sesuatu."},{"n":7,"w":[["أَلَمْ","tidaklah","alam",32],["تَرَ","kamu lihat","tara",46],["أَنَّ","sesungguhnya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["يَعْلَمُ","mengetahui","yaʿlamu",29],["مَا","apa-apa","mā",2],["فِى","pada","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa-apa","wamā",2],["فِى","pada","fī",3],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",22],["مَا","tidak","mā",2],["يَكُونُ","adalah","yakūnu",9],["مِن","dari","min",0],["نَّجْوَىٰ","pembicaraan rahasia","najwā",798],["ثَلَـٰثَةٍ","tiga","thalāthatin",702],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",20],["رَابِعُهُمْ","keempat mereka","rābiʿuhum",2600],["وَلَا","dan tidak","walā",4],["خَمْسَةٍ","kelima","khamsatin",2046],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",20],["سَادِسُهُمْ","keenam mereka","sādisuhum",2624],["وَلَآ","dan tidak","walā",4],["أَدْنَىٰ","lebih kurang","adnā",715],["مِن","dari","min",0],["ذَٰلِكَ","demikian itu","dhālika",19],["وَلَآ","dan tidak","walā",4],["أَكْثَرَ","lebih banyak","akthara",139],["إِلَّا","kecuali","illā",15],["هُوَ","Dia","huwa",20],["مَعَهُمْ","bersama mereka","maʿahum",69],["أَيْنَ","dimana","ayna",524],["مَا","apa","mā",2],["كَانُوا۟ ۖ","adalah mereka","kānū",9],["ثُمَّ","kemudian","thumma",34],["يُنَبِّئُهُم","Dia memberitahukan kepada mereka","yunabbi-uhum",256],["بِمَا","tentang apa-apa","bimā",2],["عَمِلُوا۟","mereka telah kerjakan","ʿamilū",44],["يَوْمَ","hari","yawma",25],["ٱلْقِيَـٰمَةِ ۚ","kiamat","l-qiyāmati",174],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",68]],"t":"Tidakkah engkau perhatikan, bahwa Allah mengetahui apa yang ada di langit dan apa yang ada di bumi? Tidak ada pembicaraan rahasia antara tiga orang, melainkan Dialah yang keempatnya. Dan tidak ada lima orang, melainkan Dialah yang keenamnya. Dan tidak ada yang kurang dari itu atau lebih banyak, melainkan Dia pasti ada bersama mereka di mana pun mereka berada. Kemudian Dia akan memberitakan kepada mereka pada hari Kiamat apa yang telah mereka kerjakan. Sesungguhnya Allah Maha Mengetahui segala sesuatu."},{"n":8,"w":[["أَلَمْ","tidaklah","alam",32],["تَرَ","kamu lihat","tara",46],["إِلَى","atas","ilā",13],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["نُهُوا۟","(mereka) dilarang","nuhū",354],["عَنِ","dari","ʿani",21],["ٱلنَّجْوَىٰ","pembicaraan rahasia","l-najwā",798],["ثُمَّ","kemudian","thumma",34],["يَعُودُونَ","mereka kembali","yaʿūdūna",546],["لِمَا","kepada apa","limā",2],["نُهُوا۟","mereka dilarang","nuhū",354],["عَنْهُ","dari padanya","ʿanhu",21],["وَيَتَنَـٰجَوْنَ","dan mereka berbicara rahasia","wayatanājawna",1655],["بِٱلْإِثْمِ","untuk berbuat dosa","bil-ith'mi",328],["وَٱلْعُدْوَٰنِ","dan permungsuhan","wal-ʿud'wāni",964],["وَمَعْصِيَتِ","dan mendurhakai","wamaʿṣiyati",2451],["ٱلرَّسُولِ","rasul","l-rasūli",35],["وَإِذَا","dan apabila","wa-idhā",23],["جَآءُوكَ","mereka datang kepadamu","jāūka",43],["حَيَّوْكَ","mereka mengucapkan salam kehormatan kepadamu","ḥayyawka",1518],["بِمَا","dengan apa-apa","bimā",2],["لَمْ","tidak","lam",32],["يُحَيِّكَ","menurut salam kehormatan kepadamu","yuḥayyika",1518],["بِهِ","dengannya","bihi",17],["ٱللَّهُ","Allah","l-lahu",1],["وَيَقُولُونَ","dan mereka mengatakan","wayaqūlūna",6],["فِىٓ","pada","fī",3],["أَنفُسِهِمْ","diri mereka sendiri","anfusihim",39],["لَوْلَا","mengapa tidak","lawlā",152],["يُعَذِّبُنَا","menyiksa kita","yuʿadhibunā",281],["ٱللَّهُ","Allah","l-lahu",1],["بِمَا","dengan apa/disebabkan","bimā",2],["نَقُولُ ۚ","kita katakan","naqūlu",6],["حَسْبُهُمْ","cukup bagi mereka","ḥasbuhum",778],["جَهَنَّمُ","neraka jahanam","jahannamu",146],["يَصْلَوْنَهَا ۖ","mereka memasukinya","yaṣlawnahā",706],["فَبِئْسَ","maka seburuk-buruk","fabi'sa",290],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",389]],"t":"Tidakkah engkau perhatikan orang-orang yang telah dilarang mengadakan pembicaraan rahasia, kemudian mereka kembali (mengerjakan) larangan itu dan mereka mengadakan pembicaraan rahasia untuk berbuat dosa, permusuhan dan durhaka kepada Rasul. Dan apabila mereka datang kepadamu (Muhammad), mereka mengucapkan salam dengan cara yang bukan seperti yang ditentukan Allah untukmu. Dan mereka mengatakan pada diri mereka sendiri, \"Mengapa Allah tidak menyiksa kita atas apa yang kita katakan itu?\" Cukuplah bagi mereka neraka Jahanam yang akan mereka masuki. Maka neraka itu seburuk-buruk tempat kembali."},{"n":9,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِذَا","apabila","idhā",23],["تَنَـٰجَيْتُمْ","kamu bicara rahasia","tanājaytum",1655],["فَلَا","maka jangan","falā",4],["تَتَنَـٰجَوْا۟","kamu bicara rahasia","tatanājaw",1655],["بِٱلْإِثْمِ","dengan berbuat dosa","bil-ith'mi",328],["وَٱلْعُدْوَٰنِ","dan permungsuhan","wal-ʿud'wāni",964],["وَمَعْصِيَتِ","dan mendurhakai","wamaʿṣiyati",2451],["ٱلرَّسُولِ","rasul","l-rasūli",35],["وَتَنَـٰجَوْا۟","dan berbicara rahasia","watanājaw",1655],["بِٱلْبِرِّ","dengan kebaikan","bil-biri",974],["وَٱلتَّقْوَىٰ ۖ","dan takwa","wal-taqwā",582],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["ٱلَّذِىٓ","orang-orang yang","alladhī",7],["إِلَيْهِ","kepada-Nya","ilayhi",13],["تُحْشَرُونَ","kamu dikembalikan","tuḥ'sharūna",314]],"t":"Wahai orang-orang yang beriman! Apabila kamu mengadakan pembicaraan rahasia, janganlah kamu membicarakan perbuatan dosa, permusuhan dan durhaka kepada Rasul. Tetapi bicarakanlah tentang perbuatan kebajikan dan takwa. Dan bertakwalah kepada Allah yang kepada-Nya kamu akan dikumpulkan kembali."},{"n":10,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["ٱلنَّجْوَىٰ","pembicaraan rahasia","l-najwā",798],["مِنَ","dari","mina",0],["ٱلشَّيْطَـٰنِ","syaitan","l-shayṭāni",120],["لِيَحْزُنَ","supaya berduka cita","liyaḥzuna",322],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَلَيْسَ","dan tidaklah","walaysa",119],["بِضَآرِّهِمْ","memberi mudarat kepada mereka","biḍārrihim",2222],["شَيْـًٔا","sesuatu/sedikitpun","shayan",41],["إِلَّا","kecuali","illā",15],["بِإِذْنِ","dengan izin","bi-idh'ni",299],["ٱللَّهِ ۚ","Allah","l-lahi",1],["وَعَلَى","dan atas","waʿalā",8],["ٱللَّهِ","Allah","l-lahi",1],["فَلْيَتَوَكَّلِ","bertawakal","falyatawakkali",293],["ٱلْمُؤْمِنُونَ","orang-orang yang beriman","l-mu'minūna",56]],"t":"Sesungguhnya pembicaraan rahasia itu termasuk (perbuatan) setan, agar orang-orang yang beriman itu bersedih hati, sedang (pembicaraan) itu tidaklah memberi bencana sedikit pun kepada mereka, kecuali dengan izin Allah. Dan kepada Allah hendaknya orang-orang yang beriman bertawakal."},{"n":11,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِذَا","apabila","idhā",23],["قِيلَ","dikatakan","qīla",6],["لَكُمْ","bagi kalian","lakum",26],["تَفَسَّحُوا۟","berlapang-lapanglah","tafassaḥū",4387],["فِى","dalam","fī",3],["ٱلْمَجَـٰلِسِ","majlis","l-majālisi",3688],["فَٱفْسَحُوا۟","maka lapangkanlah","fa-if'saḥū",2774],["يَفْسَحِ","melapangkan","yafsaḥi",2774],["ٱللَّهُ","Allah","l-lahu",1],["لَكُمْ ۖ","bagi kalian","lakum",26],["وَإِذَا","dan apabila","wa-idhā",23],["قِيلَ","dikatakan","qīla",6],["ٱنشُزُوا۟","bangunlah","unshuzū",2847],["فَٱنشُزُوا۟","maka bangunlah","fa-unshuzū",2847],["يَرْفَعِ","meninggikan","yarfaʿi",474],["ٱللَّهُ","Allah","l-lahu",1],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","yang beriman","āmanū",18],["مِنكُمْ","diantara kamu","minkum",0],["وَٱلَّذِينَ","dan orang-orang","wa-alladhīna",7],["أُوتُوا۟","(mereka) diberi","ūtū",45],["ٱلْعِلْمَ","ilmu","l-ʿil'ma",108],["دَرَجَـٰتٍۢ ۚ","derajat","darajātin",550],["وَٱللَّهُ","dan Allah","wal-lahu",1],["بِمَا","dengan apa-apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["خَبِيرٌۭ","Maha Mengetahui","khabīrun",262]],"t":"Wahai orang-orang yang beriman! Apabila dikatakan kepadamu, \"Berilah kelapangan di dalam majelis-majelis,\" maka lapangkanlah, niscaya Allah akan memberi kelapangan untukmu. Dan apabila dikatakan, \"Berdirilah kamu,\" maka berdirilah, niscaya Allah akan mengangkat (derajat) orang-orang yang beriman di antaramu dan orang-orang yang diberi ilmu beberapa derajat. Dan Allah Mahateliti atas apa yang kamu kerjakan."},{"n":12,"w":[["يَـٰٓأَيُّهَا","Wahai","yāayyuhā",73],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِذَا","apabila","idhā",23],["نَـٰجَيْتُمُ","kamu berbicara rahasia","nājaytumu",4041],["ٱلرَّسُولَ","rasul","l-rasūla",35],["فَقَدِّمُوا۟","maka dahulukan","faqaddimū",407],["بَيْنَ","diantara","bayna",47],["يَدَىْ","hadapan (sebelum)","yaday",98],["نَجْوَىٰكُمْ","pembicaraan rahasiamu","najwākum",798],["صَدَقَةًۭ ۚ","bersedekahlah","ṣadaqatan",1315],["ذَٰلِكَ","demikian itu","dhālika",19],["خَيْرٌۭ","lebih baik","khayrun",62],["لَّكُمْ","bagi kalian","lakum",26],["وَأَطْهَرُ ۚ","dan lebih bersih","wa-aṭharu",1469],["فَإِن","maka jika","fa-in",14],["لَّمْ","tidak","lam",32],["تَجِدُوا۟","kamu mendapatkan","tajidū",106],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱللَّهَ","Allah","l-laha",1],["غَفُورٌۭ","maha Pengampun","ghafūrun",118],["رَّحِيمٌ","Maha Penyayang","raḥīmun",100]],"t":"Wahai orang-orang yang beriman! Apabila kamu mengadakan pembicaraan khusus dengan Rasul, hendaklah kamu mengeluarkan sedekah (kepada orang miskin) sebelum (melakukan) pembicaraan itu. Yang demikian itu lebih baik bagimu dan lebih bersih. Tetapi jika kamu tidak memperoleh (yang akan disedekahkan) maka sungguh, Allah Maha Pengampun, Maha Penyayang."},{"n":13,"w":[["ءَأَشْفَقْتُمْ","apakah kamu takut","a-ashfaqtum",2153],["أَن","bahwa","an",16],["تُقَدِّمُوا۟","mendahulukan","tuqaddimū",407],["بَيْنَ","diantara","bayna",47],["يَدَىْ","hadapan (sebelum)","yaday",98],["نَجْوَىٰكُمْ","pembicaraan rahasiamu","najwākum",798],["صَدَقَـٰتٍۢ ۚ","bersedekah","ṣadaqātin",966],["فَإِذْ","maka jika","fa-idh",53],["لَمْ","tidak","lam",32],["تَفْعَلُوا۟","kalian kerjakan","tafʿalū",121],["وَتَابَ","dan menerima taubat","watāba",193],["ٱللَّهُ","Allah","l-lahu",1],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["فَأَقِيمُوا۟","maka dirikanlah","fa-aqīmū",221],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",132],["وَءَاتُوا۟","dan tunaikan","waātū",45],["ٱلزَّكَوٰةَ","zakat","l-zakata",356],["وَأَطِيعُوا۟","dan taatlah","wa-aṭīʿū",161],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ ۚ","dan rasul-Nya","warasūlahu",35],["وَٱللَّهُ","dan Allah","wal-lahu",1],["خَبِيرٌۢ","Maha Mengetahui","khabīrun",262],["بِمَا","dengan/terhadap apa-apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Apakah kamu takut akan (menjadi miskin) karena kamu memberikan sedekah sebelum (melakukan) pembicaraan dengan Rasul? Tetapi jika kamu tidak melakukannya dan Allah telah memberi ampun kepadamu, maka laksanakanlah salat, dan tunaikanlah zakat serta taatlah kepada Allah dan Rasul-Nya! Dan Allah Mahateliti atas apa yang kamu kerjakan."},{"n":14,"w":[["۞ أَلَمْ","tidakkah","alam",32],["تَرَ","kamu perhatikan","tara",46],["إِلَى","kepada","ilā",13],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["تَوَلَّوْا۟","(mereka) menjadikan pemimpin","tawallaw",144],["قَوْمًا","kaum","qawman",27],["غَضِبَ","memurkai","ghaḍiba",1186],["ٱللَّهُ","Allah","l-lahu",1],["عَلَيْهِم","atas mereka","ʿalayhim",8],["مَّا","tidak","mā",2],["هُم","mereka","hum",11],["مِّنكُمْ","dari kamu","minkum",0],["وَلَا","dan tidak","walā",4],["مِنْهُمْ","dari mereka","min'hum",0],["وَيَحْلِفُونَ","dan mereka bersumpah","wayaḥlifūna",724],["عَلَى","atas","ʿalā",8],["ٱلْكَذِبِ","kebohongan","l-kadhibi",346],["وَهُمْ","dan mereka","wahum",11],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Tidakkah engkau perhatikan orang-orang (munafik) yang menjadikan suatu kaum yang telah dimurkai Allah sebagai sahabat? Orang-orang itu bukan dari (kaum) kamu dan bukan dari (kaum) mereka. Dan mereka bersumpah atas kebohongan, sedang mereka mengetahuinya."},{"n":15,"w":[["أَعَدَّ","menyediakan","aʿadda",501],["ٱللَّهُ","Allah","l-lahu",1],["لَهُمْ","bagi mereka","lahum",11],["عَذَابًۭا","azab","ʿadhāban",36],["شَدِيدًا ۖ","sangat keras","shadīdan",214],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["سَآءَ","amat buruk","sāa",368],["مَا","apa","mā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Allah telah menyediakan azab yang sangat keras bagi mereka. Sungguh, betapa buruknya apa yang telah mereka kerjakan."},{"n":16,"w":[["ٱتَّخَذُوٓا۟","mereka menjadikan","ittakhadhū",94],["أَيْمَـٰنَهُمْ","sumpah-sumpah mereka","aymānahum",184],["جُنَّةًۭ","perisai","junnatan",2416],["فَصَدُّوا۟","lalu mereka menghalangi","faṣaddū",315],["عَن","dari","ʿan",21],["سَبِيلِ","jalan","sabīli",64],["ٱللَّهِ","Allah","l-lahi",1],["فَلَهُمْ","maka bagi mereka","falahum",11],["عَذَابٌۭ","azab/siksa","ʿadhābun",36],["مُّهِينٌۭ","hina","muhīnun",673]],"t":"Mereka menjadikan sumpah-sumpah mereka sebagai perisai, lalu mereka menghalang-halangi (manusia) dari jalan Allah; maka bagi mereka azab yang menghinakan."},{"n":17,"w":[["لَّن","tidak","lan",109],["تُغْنِىَ","berguna","tugh'niya",384],["عَنْهُمْ","dari mereka","ʿanhum",21],["أَمْوَٰلُهُمْ","harta benda mereka","amwāluhum",126],["وَلَآ","dan tidak","walā",4],["أَوْلَـٰدُهُم","anak-anak mereka","awlāduhum",217],["مِّنَ","dari","mina",0],["ٱللَّهِ","Allah","l-lahi",1],["شَيْـًٔا ۚ","sedikitpun","shayan",41],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["أَصْحَـٰبُ","penghuni","aṣḥābu",142],["ٱلنَّارِ ۖ","neraka","l-nāri",77],["هُمْ","mereka","hum",11],["فِيهَا","didalamnya","fīhā",3],["خَـٰلِدُونَ","kekal","khālidūna",157]],"t":"Harta benda dan anak-anak mereka tidak berguna sedikit pun (untuk menolong) mereka dari azab Allah. Mereka itulah penghuni neraka, mereka kekal di dalamnya."},{"n":18,"w":[["يَوْمَ","hari","yawma",25],["يَبْعَثُهُمُ","membangkitkan mereka","yabʿathuhumu",228],["ٱللَّهُ","Allah","l-lahu",1],["جَمِيعًۭا","semuanya","jamīʿan",225],["فَيَحْلِفُونَ","lalu mereka bersumpah","fayaḥlifūna",724],["لَهُۥ","kepada-Nya","lahu",17],["كَمَا","sebagaimana","kamā",2],["يَحْلِفُونَ","mereka bersumpah","yaḥlifūna",724],["لَكُمْ ۖ","bagi kalian","lakum",26],["وَيَحْسَبُونَ","dan mereka mengira","wayaḥsabūna",266],["أَنَّهُمْ","bahwasanya mereka","annahum",30],["عَلَىٰ","atas","ʿalā",8],["شَىْءٍ ۚ","sesuatu","shayin",41],["أَلَآ","ketahuilah","alā",300],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["هُمُ","mereka","humu",11],["ٱلْكَـٰذِبُونَ","orang-orang pendusta","l-kādhibūna",352]],"t":"(Ingatlah) pada hari (ketika) mereka semua dibangkitkan Allah, lalu mereka bersumpah kepada-Nya (bahwa mereka bukan orang musyrik) sebagaimana mereka bersumpah kepadamu; dan mereka menyangka bahwa mereka akan memperoleh sesuatu (manfaat). Ketahuilah, bahwa mereka orang-orang pendusta."},{"n":19,"w":[["ٱسْتَحْوَذَ","menguasai","is'taḥwadha",2852],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلشَّيْطَـٰنُ","syaitan","l-shayṭānu",120],["فَأَنسَىٰهُمْ","lalu menjadikan mereka lupa","fa-ansāhum",1042],["ذِكْرَ","mengingat","dhik'ra",147],["ٱللَّهِ ۚ","Allah","l-lahi",1],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["حِزْبُ","golongan","ḥiz'bu",511],["ٱلشَّيْطَـٰنِ ۚ","syaitan","l-shayṭāni",120],["أَلَآ","ketahuilah","alā",300],["إِنَّ","sesungguhnya","inna",5],["حِزْبَ","golongan","ḥiz'ba",511],["ٱلشَّيْطَـٰنِ","syaitan","l-shayṭāni",120],["هُمُ","mereka","humu",11],["ٱلْخَـٰسِرُونَ","lemah","l-khāsirūna",355]],"t":"Setan telah menguasai mereka, lalu menjadikan mereka lupa mengingat Allah; mereka itulah golongan setan. Ketahuilah, bahwa golongan setan itulah golongan yang merugi."},{"n":20,"w":[["إِنَّ","sesunguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُحَآدُّونَ","(mereka) menentang","yuḥāddūna",2805],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥٓ","dan rasul-Nya","warasūlahu",35],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["فِى","dalam","fī",3],["ٱلْأَذَلِّينَ","orang-orang yang hina","l-adhalīna",2155]],"t":"Sesungguhnya orang-orang yang menentang Allah dan Rasul-Nya, mereka termasuk orang-orang yang sangat hina."},{"n":21,"w":[["كَتَبَ","menulis/menetapkan","kataba",244],["ٱللَّهُ","Allah","l-lahu",1],["لَأَغْلِبَنَّ","pasti mengalahkan","la-aghlibanna",631],["أَنَا۠","Aku","anā",198],["وَرُسُلِىٓ ۚ","dan rasul-Ku","warusulī",35],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["قَوِىٌّ","Maha Kuat","qawiyyun",801],["عَزِيزٌۭ","Maha Perkasa","ʿazīzun",110]],"t":"Allah telah menetapkan, \"Aku dan rasul-rasul-Ku pasti menang.\" Sungguh, Allah Mahakuat, Mahaperkasa."},{"n":22,"w":[["لَّا","tidak","lā",4],["تَجِدُ","akan mendapati","tajidu",106],["قَوْمًۭا","suatu kaum","qawman",27],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["وَٱلْيَوْمِ","dan hari","wal-yawmi",25],["ٱلْـَٔاخِرِ","akhir","l-ākhiri",72],["يُوَآدُّونَ","mereka berkasih sayang","yuwāddūna",584],["مَنْ","siapa/orang","man",12],["حَآدَّ","ia menentang","ḥādda",2271],["ٱللَّهَ","Allah","l-laha",1],["وَرَسُولَهُۥ","dan rasul-Nya","warasūlahu",35],["وَلَوْ","walaupun","walaw",57],["كَانُوٓا۟","adalah mereka","kānū",9],["ءَابَآءَهُمْ","bapak-bapak mereka","ābāahum",189],["أَوْ","atau","aw",42],["أَبْنَآءَهُمْ","anak-anak mereka","abnāahum",194],["أَوْ","atau","aw",42],["إِخْوَٰنَهُمْ","saudara-saudara mereka","ikh'wānahum",151],["أَوْ","atau","aw",42],["عَشِيرَتَهُمْ ۚ","keluarga mereka","ʿashīratahum",1764],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["كَتَبَ","(Allah) menetapkan","kataba",244],["فِى","dalam","fī",3],["قُلُوبِهِمُ","hati mereka","qulūbihimu",86],["ٱلْإِيمَـٰنَ","keimanan","l-īmāna",257],["وَأَيَّدَهُم","dan Dia menguatkan mereka","wa-ayyadahum",882],["بِرُوحٍۢ","dengan roh pertolongan","birūḥin",497],["مِّنْهُ ۖ","dari pada-Nya","min'hu",0],["وَيُدْخِلُهُمْ","dan Dia memasukkan mereka","wayud'khiluhum",275],["جَنَّـٰتٍۢ","surga","jannātin",76],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِهَا","bawahnya","taḥtihā",235],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",222],["خَـٰلِدِينَ","mereka kekal","khālidīna",157],["فِيهَا ۚ","di dalamnya","fīhā",3],["رَضِىَ","meridai","raḍiya",312],["ٱللَّهُ","Allah","l-lahu",1],["عَنْهُمْ","dari mereka","ʿanhum",21],["وَرَضُوا۟","dan mereka rida","waraḍū",312],["عَنْهُ ۚ","dari pada-Nya","ʿanhu",21],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["حِزْبُ","golongan","ḥiz'bu",511],["ٱللَّهِ ۚ","Allah","l-lahi",1],["أَلَآ","ketahuilah","alā",300],["إِنَّ","sesungguhnya","inna",5],["حِزْبَ","golongan","ḥiz'ba",511],["ٱللَّهِ","Allah","l-lahi",1],["هُمُ","mereka","humu",11],["ٱلْمُفْلِحُونَ","orang-orang yang beruntung","l-muf'liḥūna",695]],"t":"Engkau (Muhammad) tidak akan mendapatkan suatu kaum yang beriman kepada Allah dan hari akhirat, saling berkasih sayang dengan orang-orang yang menentang Allah dan Rasul-Nya, sekalipun orang-orang itu bapaknya, anaknya, saudaranya atau keluarganya. Mereka itulah orang-orang yang dalam hatinya telah ditanamkan Allah keimanan dan Allah telah menguatkan mereka dengan pertolongan yang datang dari Dia. Lalu dimasukkan-Nya mereka ke dalam surga yang mengalir di bawahnya sungai-sungai, mereka kekal di dalamnya. Allah rida terhadap mereka dan mereka pun merasa puas terhadap (limpahan rahmat)-Nya. Merekalah golongan Allah. Ingatlah, sesungguhnya golongan Allah itulah yang beruntung."}]