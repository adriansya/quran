[{"n":1,"w":[["إِذَا","apabila","idhā",23],["ٱلسَّمَآءُ","langit","l-samāu",38],["ٱنفَطَرَتْ","terbelah","infaṭarat",4628]],"t":"Apabila langit terbelah,"},{"n":2,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["ٱلْكَوَاكِبُ","bintang-bintang","l-kawākibu",1357],["ٱنتَثَرَتْ","jatuh bertaburan","intatharat",4633]],"t":"dan apabila bintang-bintang jatuh berserakan,"},{"n":3,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["ٱلْبِحَارُ","lautan","l-biḥāru",286],["فُجِّرَتْ","dijadikan meluap","fujjirat",1173]],"t":"dan apabila lautan dijadikan meluap,"},{"n":4,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["ٱلْقُبُورُ","kuburan-kuburan","l-qubūru",1215],["بُعْثِرَتْ","di bongkar","buʿ'thirat",2317]],"t":"dan apabila kuburan-kuburan dibongkar,"},{"n":5,"w":[["عَلِمَتْ","mengetahui","ʿalimat",29],["نَفْسٌۭ","jiwa","nafsun",39],["مَّا","apa","mā",2],["قَدَّمَتْ","diusahakan","qaddamat",403],["وَأَخَّرَتْ","dan ditinggalkan","wa-akharat",615]],"t":"(maka) setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(nya)."},{"n":6,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",74],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["مَا","apa","mā",2],["غَرَّكَ","yang menipu kamu","gharraka",626],["بِرَبِّكَ","terhadap Tuhanmu","birabbika",10],["ٱلْكَرِيمِ","Mulia/Pemurah","l-karīmi",368]],"t":"Wahai manusia! Apakah yang telah memperdayakan kamu (berbuat durhaka) terhadap Tuhanmu Yang Maha Pengasih."},{"n":7,"w":[["ٱلَّذِى","yang","alladhī",7],["خَلَقَكَ","telah menciptakan kamu","khalaqaka",61],["فَسَوَّىٰكَ","lalu Dia menyempurnakan kamu","fasawwāka",669],["فَعَدَلَكَ","lalu Dia menjadikan kamu seimbang","faʿadalaka",650]],"t":"Yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)mu seimbang,"},{"n":8,"w":[["فِىٓ","dalam","fī",3],["أَىِّ","apa saja","ayyi",198],["صُورَةٍۢ","gambar/bentuk","ṣūratin",1805],["مَّا","apa","mā",2],["شَآءَ","yang Dia kehendaki","shāa",54],["رَكَّبَكَ","Dia menyusunmu","rakkabaka",4170]],"t":"dalam bentuk apa saja yang dikehendaki, Dia menyusun tubuhmu."},{"n":9,"w":[["كَلَّا","sekali-kali jangan","kallā",347],["بَلْ","tetap/bahkan","bal",96],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",63],["بِٱلدِّينِ","pada hari pembalasan","bil-dīni",120]],"t":"Sekali-kali jangan begitu! Bahkan kamu mendustakan hari pembalasan."},{"n":10,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["لَحَـٰفِظِينَ","sungguh ada penjaga","laḥāfiẓīna",616]],"t":"Dan sesungguhnya bagi kamu ada (malaikat-malaikat) yang mengawasi (pekerjaanmu),"},{"n":11,"w":[["كِرَامًۭا","yang mulia","kirāman",368],["كَـٰتِبِينَ","yang mencatat","kātibīna",1186]],"t":"yang mulia (di sisi Allah) dan yang mencatat (perbuatanmu),"},{"n":12,"w":[["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29],["مَا","apa","mā",2],["تَفْعَلُونَ","kamu kerjakan","tafʿalūna",126]],"t":"mereka mengetahui apa yang kamu kerjakan."},{"n":13,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْأَبْرَارَ","orang-orang yang baik","l-abrāra",462],["لَفِى","benar-benar dalam","lafī",3],["نَعِيمٍۢ","kesenangan/kenikmatan","naʿīmin",574]],"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,"},{"n":14,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلْفُجَّارَ","orang-orang durhaka","l-fujāra",1331],["لَفِى","dalam","lafī",3],["جَحِيمٍۢ","neraka","jaḥīmin",411]],"t":"dan sesungguhnya orang-orang yang durhaka benar-benar berada dalam neraka."},{"n":15,"w":[["يَصْلَوْنَهَا","mereka masuk kedalamnya","yaṣlawnahā",680],["يَوْمَ","hari","yawma",25],["ٱلدِّينِ","pembalasan","l-dīni",120]],"t":"Mereka masuk ke dalamnya pada hari pembalasan."},{"n":16,"w":[["وَمَا","dan tidaklah","wamā",2],["هُمْ","mereka","hum",11],["عَنْهَا","dari padanya","ʿanhā",21],["بِغَآئِبِينَ","dengan gaib/meloloskan diri","bighāibīna",1847]],"t":"Dan mereka tidak mungkin keluar dari neraka itu."},{"n":17,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu melihat","adrāka",560],["مَا","apa","mā",2],["يَوْمُ","hari","yawmu",25],["ٱلدِّينِ","pembalasan","l-dīni",120]],"t":"Dan tahukah kamu apakah hari pembalasan itu?"},{"n":18,"w":[["ثُمَّ","kemudian","thumma",34],["مَآ","apakah","mā",2],["أَدْرَىٰكَ","kamu melihat","adrāka",560],["مَا","apa","mā",2],["يَوْمُ","hari","yawmu",25],["ٱلدِّينِ","pembalasan","l-dīni",120]],"t":"Sekali lagi, tahukah kamu apakah hari pembalasan itu?"},{"n":19,"w":[["يَوْمَ","hari","yawma",25],["لَا","tidak","lā",4],["تَمْلِكُ","berdaya/berkuasa","tamliku",268],["نَفْسٌۭ","manusia","nafsun",39],["لِّنَفْسٍۢ","bagi diri/seseorang","linafsin",39],["شَيْـًۭٔا ۖ","sesuatu/sedikitpun","shayan",41],["وَٱلْأَمْرُ","dan urusan","wal-amru",66],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["لِّلَّهِ","bagi Allah","lillahi",1]],"t":"(Yaitu) pada hari (ketika) seseorang sama sekali tidak berdaya (menolong) orang lain. Dan segala urusan pada hari itu dalam kekuasaan Allah."}]