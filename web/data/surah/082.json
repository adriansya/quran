[{"n":1,"w":[["إِذَا","apabila","idhā",29],["ٱلسَّمَآءُ","langit","l-samāu",44],["ٱنفَطَرَتْ","terbelah","infaṭarat",4646]],"t":"Apabila langit terbelah,"},{"n":2,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["ٱلْكَوَاكِبُ","bintang-bintang","l-kawākibu",1375],["ٱنتَثَرَتْ","jatuh bertaburan","intatharat",4651]],"t":"dan apabila bintang-bintang jatuh berserakan,"},{"n":3,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["ٱلْبِحَارُ","lautan","l-biḥāru",300],["فُجِّرَتْ","dijadikan meluap","fujjirat",1191]],"t":"dan apabila lautan dijadikan meluap,"},{"n":4,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["ٱلْقُبُورُ","kuburan-kuburan","l-qubūru",1233],["بُعْثِرَتْ","di bongkar","buʿ'thirat",2335]],"t":"dan apabila kuburan-kuburan dibongkar,"},{"n":5,"w":[["عَلِمَتْ","mengetahui","ʿalimat",35],["نَفْسٌۭ","jiwa","nafsun",47],["مَّا","apa","mā",6],["قَدَّمَتْ","diusahakan","qaddamat",418],["وَأَخَّرَتْ","dan ditinggalkan","wa-akharat",630]],"t":"(maka) setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(nya)."},{"n":6,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["مَا","apa","mā",6],["غَرَّكَ","yang menipu kamu","gharraka",641],["بِرَبِّكَ","terhadap Tuhanmu","birabbika",15],["ٱلْكَرِيمِ","Mulia/Pemurah","l-karīmi",383]],"t":"Wahai manusia! Apakah yang telah memperdayakan kamu (berbuat durhaka) terhadap Tuhanmu Yang Maha Pengasih."},{"n":7,"w":[["ٱلَّذِى","yang","alladhī",45],["خَلَقَكَ","telah menciptakan kamu","khalaqaka",70],["فَسَوَّىٰكَ","lalu Dia menyempurnakan kamu","fasawwāka",684],["فَعَدَلَكَ","lalu Dia menjadikan kamu seimbang","faʿadalaka",665]],"t":"Yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)mu seimbang,"},{"n":8,"w":[["فِىٓ","dalam","fī",7],["أَىِّ","apa saja","ayyi",210],["صُورَةٍۢ","gambar/bentuk","ṣūratin",1823],["مَّا","apa","mā",6],["شَآءَ","yang Dia kehendaki","shāa",62],["رَكَّبَكَ","Dia menyusunmu","rakkabaka",4188]],"t":"dalam bentuk apa saja yang dikehendaki, Dia menyusun tubuhmu."},{"n":9,"w":[["كَلَّا","sekali-kali jangan","kallā",362],["بَلْ","tetap/bahkan","bal",105],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",72],["بِٱلدِّينِ","pada hari pembalasan","bil-dīni",130]],"t":"Sekali-kali jangan begitu! Bahkan kamu mendustakan hari pembalasan."},{"n":10,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",9],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["لَحَـٰفِظِينَ","sungguh ada penjaga","laḥāfiẓīna",631]],"t":"Dan sesungguhnya bagi kamu ada (malaikat-malaikat) yang mengawasi (pekerjaanmu),"},{"n":11,"w":[["كِرَامًۭا","yang mulia","kirāman",383],["كَـٰتِبِينَ","yang mencatat","kātibīna",1204]],"t":"yang mulia (di sisi Allah) dan yang mencatat (perbuatanmu),"},{"n":12,"w":[["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35],["مَا","apa","mā",6],["تَفْعَلُونَ","kamu kerjakan","tafʿalūna",136]],"t":"mereka mengetahui apa yang kamu kerjakan."},{"n":13,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْأَبْرَارَ","orang-orang yang baik","l-abrāra",477],["لَفِى","benar-benar dalam","lafī",7],["نَعِيمٍۢ","kesenangan/kenikmatan","naʿīmin",589]],"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,"},{"n":14,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",9],["ٱلْفُجَّارَ","orang-orang durhaka","l-fujāra",1349],["لَفِى","dalam","lafī",7],["جَحِيمٍۢ","neraka","jaḥīmin",426]],"t":"dan sesungguhnya orang-orang yang durhaka benar-benar berada dalam neraka."},{"n":15,"w":[["يَصْلَوْنَهَا","mereka masuk kedalamnya","yaṣlawnahā",695],["يَوْمَ","hari","yawma",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"Mereka masuk ke dalamnya pada hari pembalasan."},{"n":16,"w":[["وَمَا","dan tidaklah","wamā",6],["هُمْ","mereka","hum",16],["عَنْهَا","dari padanya","ʿanhā",27],["بِغَآئِبِينَ","dengan gaib/meloloskan diri","bighāibīna",1865]],"t":"Dan mereka tidak mungkin keluar dari neraka itu."},{"n":17,"w":[["وَمَآ","dan apakah","wamā",6],["أَدْرَىٰكَ","kamu melihat","adrāka",575],["مَا","apa","mā",6],["يَوْمُ","hari","yawmu",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"Dan tahukah kamu apakah hari pembalasan itu?"},{"n":18,"w":[["ثُمَّ","kemudian","thumma",41],["مَآ","apakah","mā",6],["أَدْرَىٰكَ","kamu melihat","adrāka",575],["مَا","apa","mā",6],["يَوْمُ","hari","yawmu",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"Sekali lagi, tahukah kamu apakah hari pembalasan itu?"},{"n":19,"w":[["يَوْمَ","hari","yawma",31],["لَا","tidak","lā",8],["تَمْلِكُ","berdaya/berkuasa","tamliku",282],["نَفْسٌۭ","manusia","nafsun",47],["لِّنَفْسٍۢ","bagi diri/seseorang","linafsin",47],["شَيْـًۭٔا ۖ","sesuatu/sedikitpun","shayan",49],["وَٱلْأَمْرُ","dan urusan","wal-amru",75],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلَّهِ","bagi Allah","lillahi",4]],"t":"(Yaitu) pada hari (ketika) seseorang sama sekali tidak berdaya (menolong) orang lain. Dan segala urusan pada hari itu dalam kekuasaan Allah."}]