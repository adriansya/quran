[{"n":1,"w":[["الٓر ۚ","Alif Lam Ra'","alif-lam-ra",1322],["كِتَـٰبٌ","kitab","kitābun",57],["أَنزَلْنَـٰهُ","Aku turunkan kepadanya","anzalnāhu",71],["إِلَيْكَ","kepadamu","ilayka",18],["لِتُخْرِجَ","keluar","litukh'rija",125],["ٱلنَّاسَ","manusia","l-nāsa",60],["مِنَ","dari","mina",1],["ٱلظُّلُمَـٰتِ","gelap","l-ẓulumāti",462],["إِلَى","ke","ilā",18],["ٱلنُّورِ","cahaya","l-nūri",288],["بِإِذْنِ","dengan izin","bi-idh'ni",316],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["إِلَىٰ","kepada","ilā",18],["صِرَٰطِ","jalan","ṣirāṭi",274],["ٱلْعَزِيزِ","Maha Kuasa","l-ʿazīzi",124],["ٱلْحَمِيدِ","Maha Terpuji","l-ḥamīdi",577]],"t":"Alif Lām Rā`. (Ini adalah) Kitab yang Kami turunkan kepadamu (Muhammad) agar engkau mengeluarkan manusia dari kegelapan kepada cahaya terang-benderang dengan izin Tuhan, (yaitu) menuju jalan Tuhan Yang Mahaperkasa, Maha Terpuji."},{"n":2,"w":[["ٱللَّهِ","Allah","al-lahi",4],["ٱلَّذِى","yang","alladhī",45],["لَهُۥ","bagiNya","lahu",21],["مَا","apa","mā",6],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَمَا","dan apa","wamā",6],["فِى","di","fī",7],["ٱلْأَرْضِ ۗ","bumi","l-arḍi",28],["وَوَيْلٌۭ","dan kecelakaan","wawaylun",311],["لِّلْكَـٰفِرِينَ","bagi orang-orang kafir","lil'kāfirīna",79],["مِنْ","dari","min",1],["عَذَابٍۢ","siksaan","ʿadhābin",43],["شَدِيدٍ","sangat pedih","shadīdin",225]],"t":"Allah yang memiliki apa yang ada di langit dan apa yang ada di bumi. Celakalah bagi orang yang ingkar kepada Tuhan karena siksaan yang sangat berat,"},{"n":3,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يَسْتَحِبُّونَ","lebih menyukai","yastaḥibbūna",1714],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["عَلَى","atas","ʿalā",11],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",82],["وَيَصُدُّونَ","dan mereka menghalang-halangi","wayaṣuddūna",332],["عَن","dari","ʿan",27],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["وَيَبْغُونَهَا","dan mereka menginginkannya","wayabghūnahā",439],["عِوَجًا ۚ","bengkok","ʿiwajan",902],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["فِى","dalam","fī",7],["ضَلَـٰلٍۭ","kesesatan","ḍalālin",325],["بَعِيدٍۢ","jauh","baʿīdin",438]],"t":"(yaitu) orang yang lebih menyukai kehidupan dunia daripada (kehidupan) akhirat, dan menghalang-halangi (manusia) dari jalan Allah dan menginginkan (jalan yang) bengkok. Mereka itu berada dalam kesesatan yang jauh."},{"n":4,"w":[["وَمَآ","dan tidak","wamā",6],["أَرْسَلْنَا","Kami mengutus","arsalnā",100],["مِن","dari","min",1],["رَّسُولٍ","seorang Rasul","rasūlin",42],["إِلَّا","melainkan","illā",20],["بِلِسَانِ","dengan lisan/bahasa","bilisāni",442],["قَوْمِهِۦ","kaumnya","qawmihi",33],["لِيُبَيِّنَ","agar ia menjelaskan","liyubayyina",346],["لَهُمْ ۖ","kepada mereka","lahum",16],["فَيُضِلُّ","maka/lalu menyesatkan","fayuḍillu",199],["ٱللَّهُ","Allah","l-lahu",4],["مَن","siapa","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيَهْدِى","dan Dia memberi petunjuk","wayahdī",89],["مَن","siapa","man",17],["يَشَآءُ ۚ","Dia kehendaki","yashāu",62],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",124],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",126]],"t":"Dan Kami tidak mengutus seorang rasul pun, melainkan dengan bahasa kaumnya, agar dia dapat memberi penjelasan kepada mereka. Maka Allah menyesatkan siapa yang Dia kehendaki, dan memberi petunjuk kepada siapa yang Dia kehendaki. Dia Yang Mahaperkasa, Mahabijaksana."},{"n":5,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",100],["مُوسَىٰ","Musa","mūsā",94],["بِـَٔايَـٰتِنَآ","dengan ayat-ayat Kami","biāyātinā",34],["أَنْ","agar","an",22],["أَخْرِجْ","keluarkanlah","akhrij",125],["قَوْمَكَ","kaummu","qawmaka",33],["مِنَ","dari","mina",1],["ٱلظُّلُمَـٰتِ","kegelapan","l-ẓulumāti",462],["إِلَى","kepada","ilā",18],["ٱلنُّورِ","cahaya terang","l-nūri",288],["وَذَكِّرْهُم","dan ingatkanlah mereka","wadhakkir'hum",549],["بِأَيَّىٰمِ","dengan hari-hari","bi-ayyāmi",31],["ٱللَّهِ ۚ","Allah","l-lahi",4],["إِنَّ","sesungguhnya","inna",9],["فِى","pada","fī",7],["ذَٰلِكَ","yang demikian","dhālika",26],["لَـَٔايَـٰتٍۢ","sungguh tanda-tanda","laāyātin",34],["لِّكُلِّ","bagi tiap-tiap","likulli",38],["صَبَّارٍۢ","orang yang sabar","ṣabbārin",1541],["شَكُورٍۢ","yang banyak bersyukur","shakūrin",823]],"t":"Dan sungguh, Kami telah mengutus Musa dengan membawa tanda-tanda (kekuasaan) Kami, (dan Kami perintahkan kepadanya), \"Keluarkanlah kaummu dari kegelapan kepada cahaya terang-benderang dan ingatkanlah mereka kepada hari-hari Allah.\" Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah) bagi setiap orang penyabar dan banyak bersyukur."},{"n":6,"w":[["وَإِذْ","dan ketika","wa-idh",61],["قَالَ","berkata","qāla",10],["مُوسَىٰ","Musa","mūsā",94],["لِقَوْمِهِ","kepada kaumnya","liqawmihi",33],["ٱذْكُرُوا۟","ingatlah","udh'kurū",144],["نِعْمَةَ","nikmat","niʿ'mata",250],["ٱللَّهِ","Allah","l-lahi",4],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["إِذْ","ketika","idh",61],["أَنجَىٰكُم","Dia menyelamatkan kamu","anjākum",461],["مِّنْ","dari","min",1],["ءَالِ","keluarga/pengikut","āli",423],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["يَسُومُونَكُمْ","mereka menimpakan kalian","yasūmūnakum",1661],["سُوٓءَ","seburuk-buruk","sūa",251],["ٱلْعَذَابِ","siksaan","l-ʿadhābi",43],["وَيُذَبِّحُونَ","dan mereka menyembelih","wayudhabbiḥūna",1724],["أَبْنَآءَكُمْ","anak-anak laki-laki kalian","abnāakum",90],["وَيَسْتَحْيُونَ","dan mereka membiarkan hidup","wayastaḥyūna",963],["نِسَآءَكُمْ ۚ","anak-anak perempuanmu","nisāakum",213],["وَفِى","dan pada","wafī",7],["ذَٰلِكُم","yang demikian itu","dhālikum",26],["بَلَآءٌۭ","cobaan","balāon",1183],["مِّن","dari","min",1],["رَّبِّكُمْ","Tuhan kalian","rabbikum",15],["عَظِيمٌۭ","yang besar","ʿaẓīmun",118]],"t":"Dan (ingatlah) ketika Musa berkata kepada kaumnya, \"Ingatlah nikmat Allah atasmu ketika Dia menyelamatkan kamu dari pengikut-pengikut Fir'aun; mereka menyiksa kamu dengan siksa yang pedih, dan menyembelih anak-anakmu yang laki-laki, dan membiarkan hidup anak-anak perempuanmu; pada yang demikian itu terdapat suatu cobaan yang besar dari Tuhanmu.\""},{"n":7,"w":[["وَإِذْ","ketika","wa-idh",61],["تَأَذَّنَ","memaklumkan","ta-adhana",2679],["رَبُّكُمْ","Tuhan kalian","rabbukum",15],["لَئِن","sesungguhnya jika","la-in",19],["شَكَرْتُمْ","kamu bersyukur","shakartum",267],["لَأَزِيدَنَّكُمْ ۖ","pasti Aku akan menambahkan kepadamu","la-azīdannakum",259],["وَلَئِن","dan sesungguhnya jika","wala-in",19],["كَفَرْتُمْ","kamu mengingkari","kafartum",48],["إِنَّ","sesungguhnya","inna",9],["عَذَابِى","azabKu","ʿadhābī",43],["لَشَدِيدٌۭ","sungguh sangat keras/pedih","lashadīdun",225]],"t":"Dan (ingatlah) ketika Tuhanmu memaklumkan, \"Sesungguhnya jika kamu bersyukur, niscaya Aku akan menambah (nikmat) kepadamu, tetapi jika kamu mengingkari (nikmat-Ku), maka pasti azab-Ku sangat berat.\""},{"n":8,"w":[["وَقَالَ","dan berkata","waqāla",10],["مُوسَىٰٓ","Musa","mūsā",94],["إِن","jika","in",19],["تَكْفُرُوٓا۟","kamu  mengingkari","takfurū",48],["أَنتُمْ","kamu","antum",96],["وَمَن","dan orang","waman",17],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["جَمِيعًۭا","semuanya","jamīʿan",236],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَغَنِىٌّ","Maha Kaya","laghaniyyun",453],["حَمِيدٌ","Maha Tetap","ḥamīdun",577]],"t":"Dan Musa berkata, \"Jika kamu dan orang yang ada di bumi semuanya mengingkari (nikmat Allah), maka sesungguhnya Allah Mahakaya, Maha Terpuji."},{"n":9,"w":[["أَلَمْ","apakah tidak/belum","alam",39],["يَأْتِكُمْ","datang kepadamu","yatikum",56],["نَبَؤُا۟","berita","naba-u",396],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["قَبْلِكُمْ","sebelum kalian","qablikum",59],["قَوْمِ","kaum","qawmi",33],["نُوحٍۢ","Nuh","nūḥin",287],["وَعَادٍۢ","dan 'Ad","waʿādin",449],["وَثَمُودَ ۛ","dan Samud","wathamūda",430],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["مِنۢ","dari","min",1],["بَعْدِهِمْ ۛ","sesudah mereka","baʿdihim",67],["لَا","tidak","lā",8],["يَعْلَمُهُمْ","mengetahui mereka","yaʿlamuhum",35],["إِلَّا","selain","illā",20],["ٱللَّهُ ۚ","Allah","l-lahu",4],["جَآءَتْهُمْ","telah datang kepada mereka","jāathum",51],["رُسُلُهُم","Rasul-Rasul mereka","rusuluhum",42],["بِٱلْبَيِّنَـٰتِ","dengan bukti-bukti nyata","bil-bayināti",185],["فَرَدُّوٓا۟","lalu mereka menutupkan","faraddū",342],["أَيْدِيَهُمْ","tangan mereka","aydiyahum",109],["فِىٓ","ke dalam","fī",7],["أَفْوَٰهِهِمْ","mulut mereka","afwāhihim",698],["وَقَالُوٓا۟","dan mereka berkata","waqālū",10],["إِنَّا","sesungguhnya kami","innā",9],["كَفَرْنَا","kami mengingkari","kafarnā",48],["بِمَآ","dengan/terhadap apa","bimā",6],["أُرْسِلْتُم","kamu disuruh/diutus","ur'sil'tum",100],["بِهِۦ","dengannya","bihi",21],["وَإِنَّا","dan sesungguhnya kami","wa-innā",9],["لَفِى","sungguh dalam","lafī",7],["شَكٍّۢ","keragu-raguan","shakkin",624],["مِّمَّا","terhadap apa","mimmā",1],["تَدْعُونَنَآ","kamu menyeru kami","tadʿūnanā",74],["إِلَيْهِ","kepadanya","ilayhi",18],["مُرِيبٍۢ","menggelisahkan","murībin",1101]],"t":"Apakah belum sampai kepadamu berita orang-orang sebelum kamu (yaitu) kaum Nuh, 'Ād, Samud dan orang-orang setelah mereka. Tidak ada yang mengetahui mereka selain Allah. Rasul-rasul telah datang kepada mereka membawa bukti-bukti (yang nyata), namun mereka menutupkan tangannya ke mulutnya (karena kebencian), dan berkata, \"Sesungguhnya kami tidak percaya akan (bukti bahwa) kamu diutus (kepada kami), dan kami benar-benar dalam keraguan yang menggelisahkan terhadap apa yang kamu serukan kepada kami.\""},{"n":10,"w":[["۞ قَالَتْ","berkata","qālat",10],["رُسُلُهُمْ","Rasul-Rasul mereka","rusuluhum",42],["أَفِى","apakah terhadap","afī",7],["ٱللَّهِ","Allah","l-lahi",4],["شَكٌّۭ","keragu-raguan","shakkun",624],["فَاطِرِ","Pencipta","fāṭiri",1189],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",28],["يَدْعُوكُمْ","Dia menyeru kamu","yadʿūkum",74],["لِيَغْفِرَ","untuk memberi ampunan","liyaghfira",197],["لَكُم","bagi kalian","lakum",32],["مِّن","dari","min",1],["ذُنُوبِكُمْ","dosa-dosamu","dhunūbikum",329],["وَيُؤَخِّرَكُمْ","dan Dia menangguhkan kamu","wayu-akhirakum",629],["إِلَىٰٓ","sampai","ilā",18],["أَجَلٍۢ","waktu","ajalin",238],["مُّسَمًّۭى ۚ","ditentukan","musamman",505],["قَالُوٓا۟","mereka berkata","qālū",10],["إِنْ","tidak lain","in",19],["أَنتُمْ","kamu","antum",96],["إِلَّا","hanyalah","illā",20],["بَشَرٌۭ","manusia","basharun",333],["مِّثْلُنَا","seperti kami","mith'lunā",168],["تُرِيدُونَ","kamu menghendaki","turīdūna",92],["أَن","akan","an",22],["تَصُدُّونَا","kamu menghalang-halangi kami","taṣuddūnā",332],["عَمَّا","dari apa","ʿammā",27],["كَانَ","adalah","kāna",12],["يَعْبُدُ","menyembah","yaʿbudu",108],["ءَابَآؤُنَا","nenek moyang kami","ābāunā",116],["فَأْتُونَا","karena itu datangkan kepada kami","fatūnā",56],["بِسُلْطَـٰنٍۢ","dengan bukti","bisul'ṭānin",338],["مُّبِينٍۢ","yang nyata","mubīnin",111]],"t":"Rasul-rasul mereka berkata, \"Apakah ada keraguan terhadap Allah, Pencipta langit dan bumi? Dia menyeru kamu (untuk beriman) agar Dia mengampuni sebagian dosa-dosamu dan menangguhkan (siksaan)mu sampai waktu yang ditentukan?\" Mereka berkata, \"Kamu hanyalah manusia seperti kami juga. Kamu ingin menghalangi kami (menyembah) apa yang dari dahulu disembah nenek moyang kami, karena itu datangkanlah kepada kami bukti yang nyata.\""},{"n":11,"w":[["قَالَتْ","berkata","qālat",10],["لَهُمْ","kepada mereka","lahum",16],["رُسُلُهُمْ","Rasul-Rasul  mereka","rusuluhum",42],["إِن","jika","in",19],["نَّحْنُ","kami","naḥnu",140],["إِلَّا","hanyalah","illā",20],["بَشَرٌۭ","manusia","basharun",333],["مِّثْلُكُمْ","seperti kamu","mith'lukum",168],["وَلَـٰكِنَّ","akan tetapi","walākinna",220],["ٱللَّهَ","Allah","l-laha",4],["يَمُنُّ","memberi karunia","yamunnu",610],["عَلَىٰ","atas/kepada","ʿalā",11],["مَن","siapa","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["مِنْ","dari/diantara","min",1],["عِبَادِهِۦ ۖ","hamba-hambaNya","ʿibādihi",99],["وَمَا","dan tidaklah","wamā",6],["كَانَ","adalah","kāna",12],["لَنَآ","bagi kami","lanā",135],["أَن","akan","an",22],["نَّأْتِيَكُم","mendatangkan kepadamu","natiyakum",56],["بِسُلْطَـٰنٍ","dengan bukti","bisul'ṭānin",338],["إِلَّا","melainkan","illā",20],["بِإِذْنِ","dengan izin","bi-idh'ni",316],["ٱللَّهِ ۚ","Allah","l-lahi",4],["وَعَلَى","dan atas/kepada","waʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["فَلْيَتَوَكَّلِ","maka hendaknya bertawakkal","falyatawakkali",309],["ٱلْمُؤْمِنُونَ","orang-orang yang beriman","l-mu'minūna",63]],"t":"Rasul-rasul mereka berkata kepada mereka, \"Kami hanyalah manusia seperti kamu, tetapi Allah memberi karunia kepada siapa yang Dia kehendaki di antara hamba-hamba-Nya. Tidak pantas bagi kami mendatangkan suatu bukti kepada kamu melainkan dengan izin Allah. Dan hanya kepada Allah saja hendaknya orang yang beriman itu bertawakal."},{"n":12,"w":[["وَمَا","dan mengapa","wamā",6],["لَنَآ","kami","lanā",135],["أَلَّا","tidak akan","allā",22],["نَتَوَكَّلَ","kami bertawakkal","natawakkala",309],["عَلَى","atas","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["وَقَدْ","dan/padahal sesungguhnya","waqad",30],["هَدَىٰنَا","Dia telah memberi petunjuk","hadānā",89],["سُبُلَنَا ۚ","jalan kami","subulanā",73],["وَلَنَصْبِرَنَّ","dan sungguh kami akan bersabar","walanaṣbiranna",215],["عَلَىٰ","atas","ʿalā",11],["مَآ","apa","mā",6],["ءَاذَيْتُمُونَا ۚ","kamu menyakiti kami","ādhaytumūnā",655],["وَعَلَى","dan atas/kepada","waʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["فَلْيَتَوَكَّلِ","hendaknya bertawakkal/berserah diri","falyatawakkali",309],["ٱلْمُتَوَكِّلُونَ","orang-orang yang bertawakkal","l-mutawakilūna",1621]],"t":"Dan mengapa kami tidak akan bertawakal kepada Allah, sedangkan Dia telah menunjukkan jalan kepada kami, dan kami sungguh, akan tetap bersabar terhadap gangguan yang kamu lakukan kepada kami. Dan hanya kepada Allah saja orang yang bertawakal itu berserah diri.\""},{"n":13,"w":[["وَقَالَ","dan berkata","waqāla",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لِرُسُلِهِمْ","kepada Rasul-Rasul mereka","lirusulihim",42],["لَنُخْرِجَنَّكُم","sungguh kami akan mengusir kamu","lanukh'rijannakum",125],["مِّنْ","dari","min",1],["أَرْضِنَآ","bumi/negeri kami","arḍinā",28],["أَوْ","atau","aw",50],["لَتَعُودُنَّ","kamu akan kembali","lataʿūdunna",556],["فِى","dalam/pada","fī",7],["مِلَّتِنَا ۖ","agama kami","millatinā",644],["فَأَوْحَىٰٓ","maka wahyukan","fa-awḥā",179],["إِلَيْهِمْ","kepada mereka","ilayhim",18],["رَبُّهُمْ","Tuhan mereka","rabbuhum",15],["لَنُهْلِكَنَّ","sungguh Kami akan membinasakan","lanuh'likanna",243],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97]],"t":"Dan orang-orang kafir berkata kepada rasul-rasul mereka, \"Kami pasti akan mengusir kamu dari negeri kami atau kamu benar-benar kembali kepada agama kami.\" Maka Tuhan mewahyukan kepada mereka, \"Kami pasti akan membinasakan orang yang zalim itu."},{"n":14,"w":[["وَلَنُسْكِنَنَّكُمُ","dan sungguh Kami akan menempatkan kamu","walanus'kinannakumu",1295],["ٱلْأَرْضَ","bumi/negeri","l-arḍa",28],["مِنۢ","dari","min",1],["بَعْدِهِمْ ۚ","sesudah mereka","baʿdihim",67],["ذَٰلِكَ","demikian itu","dhālika",26],["لِمَنْ","bagi orang","liman",17],["خَافَ","takut","khāfa",150],["مَقَامِى","hadiratKu","maqāmī",680],["وَخَافَ","dan takut","wakhāfa",150],["وَعِيدِ","ancamanKu","waʿīdi",1256]],"t":"Dan Kami pasti akan menempatkan kamu di negeri-negeri itu setelah mereka. Yang demikian itu (adalah untuk) orang-orang yang takut (menghadap) ke hadirat-Ku dan takut akan ancaman-Ku.\""},{"n":15,"w":[["وَٱسْتَفْتَحُوا۟","dan mereka mohon kemenangan","wa-is'taftaḥū",2102],["وَخَابَ","dan binasalah","wakhāba",1696],["كُلُّ","semua","kullu",38],["جَبَّارٍ","orang yang sewenang-wenang","jabbārin",850],["عَنِيدٍۢ","keras kepala","ʿanīdin",1517]],"t":"Dan mereka memohon diberi kemenangan dan binasalah semua orang yang berlaku sewenang-wenang lagi keras kepala,"},{"n":16,"w":[["مِّن","dari","min",1],["وَرَآئِهِۦ","belakangnya","warāihi",457],["جَهَنَّمُ","jahanam","jahannamu",162],["وَيُسْقَىٰ","dan dia akan diberi minum","wayus'qā",760],["مِن","dari/dengan","min",1],["مَّآءٍۢ","air","māin",204],["صَدِيدٍۢ","nanah","ṣadīdin",3252]],"t":"dihadapannya ada neraka Jahanam dan dia akan diberi minuman dengan air nanah,"},{"n":17,"w":[["يَتَجَرَّعُهُۥ","dia menghirupnya","yatajarraʿuhu",4372],["وَلَا","dan tidak","walā",8],["يَكَادُ","hampir","yakādu",368],["يُسِيغُهُۥ","dia menelannya","yusīghuhu",3014],["وَيَأْتِيهِ","dan datang kepadanya","wayatīhi",56],["ٱلْمَوْتُ","maut/kematian","l-mawtu",249],["مِن","dari","min",1],["كُلِّ","segenap","kulli",38],["مَكَانٍۢ","tempat/penjuru","makānin",417],["وَمَا","dan tidaklah","wamā",6],["هُوَ","dia","huwa",25],["بِمَيِّتٍۢ ۖ","dengan yang mati","bimayyitin",327],["وَمِن","dan dari","wamin",1],["وَرَآئِهِۦ","belakangnya","warāihi",457],["عَذَابٌ","azab","ʿadhābun",43],["غَلِيظٌۭ","keras/berat","ghalīẓun",920]],"t":"direguknya (air nanah itu) dan dia hampir tidak bisa menelannya dan datanglah (bahaya) maut kepadanya dari segenap penjuru, tetapi dia tidak juga mati; dan dihadapannya (masih ada) azab yang berat."},{"n":18,"w":[["مَّثَلُ","perumpamaan","mathalu",138],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["بِرَبِّهِمْ ۖ","dengan/kepada Tuhan mereka","birabbihim",15],["أَعْمَـٰلُهُمْ","amalan-amalan mereka","aʿmāluhum",184],["كَرَمَادٍ","seperti abu","karamādin",4188],["ٱشْتَدَّتْ","meniup keras","ish'taddat",4608],["بِهِ","dengannya","bihi",21],["ٱلرِّيحُ","angin","l-rīḥu",397],["فِى","pada","fī",7],["يَوْمٍ","hari","yawmin",31],["عَاصِفٍۢ ۖ","musim angin kencang","ʿāṣifin",1786],["لَّا","tidak","lā",8],["يَقْدِرُونَ","mereka dapat","yaqdirūna",444],["مِمَّا","dari pada","mimmā",1],["كَسَبُوا۟","mereka usahakan","kasabū",206],["عَلَىٰ","atas","ʿalā",11],["شَىْءٍۢ ۚ","sesuatu/sedikitpun","shayin",49],["ذَٰلِكَ","demikian itu","dhālika",26],["هُوَ","dia/adalah","huwa",25],["ٱلضَّلَـٰلُ","kesesatan","l-ḍalālu",325],["ٱلْبَعِيدُ","yang jauh","l-baʿīdu",438]],"t":"Perumpamaan orang yang ingkar kepada Tuhannya, perbuatan mereka seperti abu yang ditiup oleh angin keras pada suatu hari yang berangin kencang. Mereka tidak kuasa (mendatangkan manfaat) sama sekali dari apa yang telah mereka usahakan (di dunia). Yang demikian itu adalah kesesatan yang jauh."},{"n":19,"w":[["أَلَمْ","tidakkah","alam",39],["تَرَ","kamu perhatikan","tara",54],["أَنَّ","bahwa sesungguhnya","anna",36],["ٱللَّهَ","Allah","l-laha",4],["خَلَقَ","menciptakan","khalaqa",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["بِٱلْحَقِّ ۚ","dengan benar","bil-ḥaqi",58],["إِن","jika","in",19],["يَشَأْ","Dia  menghendaki","yasha",62],["يُذْهِبْكُمْ","Dia menghilangkan/membinasakan kamu","yudh'hib'kum",774],["وَيَأْتِ","dan dia mendatangkan/mengganti","wayati",56],["بِخَلْقٍۢ","dengan makhluk","bikhalqin",241],["جَدِيدٍۢ","yang baru","jadīdin",993]],"t":"Tidakkah kamu memperhatikan, bahwa sesungguhnya Allah telah menciptakan langit dan bumi dengan hak (benar)? Jika Dia menghendaki, niscaya Dia membinasakan kamu dan mendatangkan makhluk yang baru (untuk menggantikan kamu),"},{"n":20,"w":[["وَمَا","dan tidak","wamā",6],["ذَٰلِكَ","demikian itu","dhālika",26],["عَلَى","atas/bagi","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["بِعَزِيزٍۢ","dengan sukar/berat","biʿazīzin",124]],"t":"dan yang demikian itu tidak sukar bagi Allah."},{"n":21,"w":[["وَبَرَزُوا۟","dan mereka menghadap/menampakkan","wabarazū",1341],["لِلَّهِ","kepada Allah","lillahi",4],["جَمِيعًۭا","semuanya","jamīʿan",236],["فَقَالَ","maka/lalu berkata","faqāla",10],["ٱلضُّعَفَـٰٓؤُا۟","orang-orang yang lemah","l-ḍuʿafāu",972],["لِلَّذِينَ","kepada orang-orang yang","lilladhīna",13],["ٱسْتَكْبَرُوٓا۟","(mereka)sombong","is'takbarū",315],["إِنَّا","sesungguhnya kami","innā",9],["كُنَّا","adalah kami","kunnā",12],["لَكُمْ","bagi kalian","lakum",32],["تَبَعًۭا","pengikut","tabaʿan",2690],["فَهَلْ","maka apakah","fahal",128],["أَنتُم","kamu","antum",96],["مُّغْنُونَ","melepaskan","mugh'nūna",2555],["عَنَّا","dari kami","ʿannā",27],["مِنْ","dari","min",1],["عَذَابِ","azab","ʿadhābi",43],["ٱللَّهِ","Allah","l-lahi",4],["مِن","dari","min",1],["شَىْءٍۢ ۚ","sesuatu/sedikitpun","shayin",49],["قَالُوا۟","mereka berkata/menjawab","qālū",10],["لَوْ","seandainya","law",66],["هَدَىٰنَا","memberi petunjuk kepada kami","hadānā",89],["ٱللَّهُ","Allah","l-lahu",4],["لَهَدَيْنَـٰكُمْ ۖ","niscaya kami dapat memberi petunjuk padamu","lahadaynākum",89],["سَوَآءٌ","sama saja","sawāon",420],["عَلَيْنَآ","atas/bagi kami","ʿalaynā",11],["أَجَزِعْنَآ","kami mengeluh","ajaziʿ'nā",3577],["أَمْ","atau","am",93],["صَبَرْنَا","kami bersabar","ṣabarnā",215],["مَا","tidak ada","mā",6],["لَنَا","bagi kami","lanā",135],["مِن","dari","min",1],["مَّحِيصٍۢ","tempat berlari","maḥīṣin",1398]],"t":"Dan mereka semua (di padang Mahsyar) berkumpul untuk menghadap ke hadirat Allah, lalu orang yang lemah berkata kepada orang yang sombong, \"Sesungguhnya kami dahulu adalah pengikut-pengikutmu, maka dapatkah kamu menghindarkan kami dari azab Allah (walaupun) sedikit saja?\" Mereka menjawab, \"Sekiranya Allah memberi petunjuk kepada kami, niscaya kami dapat memberi petunjuk kepadamu. Sama saja bagi kita, apakah kita mengeluh atau bersabar. Kita tidak mempunyai tempat untuk melarikan diri.\""},{"n":22,"w":[["وَقَالَ","dan berkata","waqāla",10],["ٱلشَّيْطَـٰنُ","syaitan","l-shayṭānu",134],["لَمَّا","tatkala","lammā",81],["قُضِىَ","diputuskan","quḍiya",214],["ٱلْأَمْرُ","perkata/hukuman","l-amru",75],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["وَعَدَكُمْ","telah menjanjikan kepadamu","waʿadakum",190],["وَعْدَ","janji","waʿda",258],["ٱلْحَقِّ","benar","l-ḥaqi",58],["وَوَعَدتُّكُمْ","dan aku menjanjikan kepadamu","wawaʿadttukum",190],["فَأَخْلَفْتُكُمْ ۖ","lalu Aku menyalahi kepadamu","fa-akhlaftukum",662],["وَمَا","dan tidak","wamā",6],["كَانَ","ada","kāna",12],["لِىَ","bagiku","liya",158],["عَلَيْكُم","atas kalian","ʿalaykum",11],["مِّن","dari","min",1],["سُلْطَـٰنٍ","kekuasaan","sul'ṭānin",338],["إِلَّآ","melainkan","illā",20],["أَن","akan","an",22],["دَعَوْتُكُمْ","aku menyeru kamu","daʿawtukum",74],["فَٱسْتَجَبْتُمْ","lalu kamu memperkenankan","fa-is'tajabtum",409],["لِى ۖ","bagiku","lī",158],["فَلَا","maka jangan","falā",8],["تَلُومُونِى","kamu mencela aku","talūmūnī",1897],["وَلُومُوٓا۟","dan celalah","walūmū",1897],["أَنفُسَكُم ۖ","diri kalian sendiri","anfusakum",47],["مَّآ","tidaklah","mā",6],["أَنَا۠","aku","anā",194],["بِمُصْرِخِكُمْ","dengan menolong kamu","bimuṣ'rikhikum",2507],["وَمَآ","tidaklah","wamā",6],["أَنتُم","kamu","antum",96],["بِمُصْرِخِىَّ ۖ","dengan menolong aku","bimuṣ'rikhiyya",2507],["إِنِّى","sesungguhnya aku","innī",9],["كَفَرْتُ","aku ingkar","kafartu",48],["بِمَآ","dengan/terhadap apa","bimā",6],["أَشْرَكْتُمُونِ","kamu mempersekutukanku","ashraktumūni",182],["مِن","dari","min",1],["قَبْلُ ۗ","dahulu","qablu",59],["إِنَّ","sesungguhnya","inna",9],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97],["لَهُمْ","bagi mereka","lahum",16],["عَذَابٌ","azab/siksaan","ʿadhābun",43],["أَلِيمٌۭ","pedih","alīmun",178]],"t":"Dan setan berkata ketika perkara (hisab) telah diselesaikan, \"Sesungguhnya Allah telah menjanjikan kepadamu janji yang benar, dan aku pun telah menjanjikan kepadamu tetapi aku menyalahinya. Tidak ada kekuasaan bagiku terhadapmu, melainkan (sekedar) aku menyeru kamu lalu kamu mematuhi seruanku, oleh sebab itu janganlah kamu mencerca aku, tetapi cercalah dirimu sendiri. Aku tidak dapat menolongmu, dan kamu pun tidak dapat menolongku. Sesungguhnya aku tidak membenarkan perbuatanmu mempersekutukan aku (dengan Allah) sejak dahulu.\" Sungguh, orang yang zalim akan mendapat siksaan yang pedih."},{"n":23,"w":[["وَأُدْخِلَ","dan dimasukkan","wa-ud'khila",289],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","(mereka)beriman","āmanū",23],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",104],["جَنَّـٰتٍۢ","sorga","jannātin",86],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",233],["خَـٰلِدِينَ","mereka kekal","khālidīna",173],["فِيهَا","di dalamnya","fīhā",7],["بِإِذْنِ","dengan ijin","bi-idh'ni",316],["رَبِّهِمْ ۖ","Tuhan mereka","rabbihim",15],["تَحِيَّتُهُمْ","penghormatan mereka","taḥiyyatuhum",1250],["فِيهَا","didalamnya","fīhā",7],["سَلَـٰمٌ","salam/sejahtera","salāmun",294]],"t":"Dan orang yang beriman dan mengerjakan kebajikan dimasukkan ke dalam surga-surga yang mengalir di bawahnya sungai-sungai. Mereka kekal di dalamnya dengan seizin Tuhan mereka. Ucapan penghormatan mereka dalam (surga) itu ialah salām."},{"n":24,"w":[["أَلَمْ","tidakkah","alam",39],["تَرَ","kamu perhatikan","tara",54],["كَيْفَ","bagaimana","kayfa",148],["ضَرَبَ","membuat","ḍaraba",230],["ٱللَّهُ","Allah","l-lahu",4],["مَثَلًۭا","perumpamaan","mathalan",138],["كَلِمَةًۭ","kalimat","kalimatan",291],["طَيِّبَةًۭ","yang baik","ṭayyibatan",268],["كَشَجَرَةٍۢ","seperti pohon","kashajaratin",532],["طَيِّبَةٍ","yang baik","ṭayyibatin",268],["أَصْلُهَا","akarnya","aṣluhā",1744],["ثَابِتٌۭ","kokoh","thābitun",2722],["وَفَرْعُهَا","dan cabangnya","wafarʿuhā",3447],["فِى","di","fī",7],["ٱلسَّمَآءِ","langit","l-samāi",44]],"t":"Tidakkah kamu memperhatikan bagaimana Allah telah membuat perumpamaan kalimat yang baik seperti pohon yang baik, akarnya kuat dan cabangnya (menjulang) ke langit,"},{"n":25,"w":[["تُؤْتِىٓ","(pohon itu)memberikan","tu'tī",53],["أُكُلَهَا","makanannya/buahnya","ukulahā",1054],["كُلَّ","setiap","kulla",38],["حِينٍۭ","masa/musim","ḥīnin",345],["بِإِذْنِ","dengan ijin","bi-idh'ni",316],["رَبِّهَا ۗ","Tuhannya","rabbihā",15],["وَيَضْرِبُ","dan membuat","wayaḍribu",230],["ٱللَّهُ","Allah","l-lahu",4],["ٱلْأَمْثَالَ","perumpamaan-perumpamaan","l-amthāla",138],["لِلنَّاسِ","bagi manusia","lilnnāsi",60],["لَعَلَّهُمْ","agar mereka","laʿallahum",101],["يَتَذَكَّرُونَ","mereka ingat/mengambil pelajaran","yatadhakkarūna",245]],"t":"(pohon) itu menghasilkan buahnya pada setiap waktu dengan seizin Tuhannya. Dan Allah membuat perumpamaan itu untuk manusia agar mereka selalu ingat."},{"n":26,"w":[["وَمَثَلُ","dan perumpamaan","wamathalu",138],["كَلِمَةٍ","kalimat","kalimatin",291],["خَبِيثَةٍۢ","jelek","khabīthatin",1261],["كَشَجَرَةٍ","seperti pohon","kashajaratin",532],["خَبِيثَةٍ","jelek","khabīthatin",1261],["ٱجْتُثَّتْ","dicabut","uj'tuthat",4628],["مِن","dari","min",1],["فَوْقِ","atas permukaan","fawqi",301],["ٱلْأَرْضِ","bumi","l-arḍi",28],["مَا","tidak ada","mā",6],["لَهَا","baginya","lahā",106],["مِن","dari","min",1],["قَرَارٍۢ","ketetapan/tegak","qarārin",939]],"t":"Dan perumpamaan kalimat yang buruk seperti pohon yang buruk, yang telah dicabut akar-akarnya dari permukaan bumi; tidak dapat tetap (tegak) sedikit pun."},{"n":27,"w":[["يُثَبِّتُ","meneguhkan","yuthabbitu",877],["ٱللَّهُ","Allah","l-lahu",4],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["بِٱلْقَوْلِ","dengan ucapan","bil-qawli",129],["ٱلثَّابِتِ","tetap teguh","l-thābiti",2722],["فِى","dalam","fī",7],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["وَفِى","dan di","wafī",7],["ٱلْـَٔاخِرَةِ ۖ","akhirat","l-ākhirati",82],["وَيُضِلُّ","dan menyesatkan","wayuḍillu",199],["ٱللَّهُ","Allah","l-lahu",4],["ٱلظَّـٰلِمِينَ ۚ","orang-orang yang zalim","l-ẓālimīna",97],["وَيَفْعَلُ","dan berbuat","wayafʿalu",136],["ٱللَّهُ","Allah","l-lahu",4],["مَا","apa","mā",6],["يَشَآءُ","Dia kehendaki","yashāu",62]],"t":"Allah meneguhkan (iman) orang-orang yang beriman dengan ucapan yang teguh (dalam kehidupan) di dunia dan di akhirat; dan Allah menyesatkan orang-orang yang zalim dan Allah berbuat apa yang Dia kehendaki."},{"n":28,"w":[["۞ أَلَمْ","tidakkah","alam",39],["تَرَ","kamu perhatikan","tara",54],["إِلَى","kepada","ilā",18],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["بَدَّلُوا۟","mereka menukar","baddalū",463],["نِعْمَتَ","nikmat","niʿ'mata",250],["ٱللَّهِ","Allah","l-lahi",4],["كُفْرًۭا","kekafiran","kuf'ran",335],["وَأَحَلُّوا۟","dan mereka menempatkan","wa-aḥallū",512],["قَوْمَهُمْ","kaum mereka","qawmahum",33],["دَارَ","tempat/rumah","dāra",261],["ٱلْبَوَارِ","kebinasaan","l-bawāri",3371]],"t":"Tidakkah kamu memperhatikan orang-orang yang telah menukar nikmat Allah dengan ingkar kepada Allah dan menjatuhkan kaumnya ke lembah kebinasaan,"},{"n":29,"w":[["جَهَنَّمَ","neraka jahanam","jahannama",162],["يَصْلَوْنَهَا ۖ","mereka memasukinya","yaṣlawnahā",695],["وَبِئْسَ","dan seburuk-buruk","wabi'sa",307],["ٱلْقَرَارُ","tempat ketetapan/kediaman","l-qarāru",939]],"t":"yaitu neraka Jahanam; mereka masuk ke dalamnya; dan itulah seburuk-buruk tempat kediaman."},{"n":30,"w":[["وَجَعَلُوا۟","dan mereka menjadikan","wajaʿalū",40],["لِلَّهِ","bagi Allah","lillahi",4],["أَندَادًۭا","sekutu-sekutu","andādan",1229],["لِّيُضِلُّوا۟","supaya mereka menyesatkan","liyuḍillū",199],["عَن","dari","ʿan",27],["سَبِيلِهِۦ ۗ","jalanNya","sabīlihi",73],["قُلْ","katakanlah","qul",10],["تَمَتَّعُوا۟","bersenang-senanglah kamu","tamattaʿū",816],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["مَصِيرَكُمْ","tempat kembalimu","maṣīrakum",404],["إِلَى","kepada","ilā",18],["ٱلنَّارِ","neraka","l-nāri",87]],"t":"Dan mereka (orang kafir) itu telah menjadikan tandingan bagi Allah untuk menyesatkan (manusia) dari jalan-Nya. Katakanlah (Muhammad), \"Bersenang-senanglah kamu, karena sesungguhnya tempat kembalimu ke neraka.\""},{"n":31,"w":[["قُل","katakanlah","qul",10],["لِّعِبَادِىَ","kepada hamba-hambaKu","liʿibādiya",99],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["يُقِيمُوا۟","mereka mendirikan","yuqīmū",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["وَيُنفِقُوا۟","dan mereka nafkahkan","wayunfiqū",193],["مِمَّا","dari/sebagian apa","mimmā",1],["رَزَقْنَـٰهُمْ","Kami rezkikan kepada mereka","razaqnāhum",208],["سِرًّۭا","tersembunyi","sirran",815],["وَعَلَانِيَةًۭ","dan terang-terangan","waʿalāniyatan",1514],["مِّن","dari","min",1],["قَبْلِ","sebelum","qabli",59],["أَن","bahwa","an",22],["يَأْتِىَ","akan datang","yatiya",56],["يَوْمٌۭ","hari","yawmun",31],["لَّا","tidak","lā",8],["بَيْعٌۭ","jual-beli","bayʿun",1076],["فِيهِ","didalamnya","fīhi",7],["وَلَا","dan tidak","walā",8],["خِلَـٰلٌ","persahabatan","khilālun",1027]],"t":"Katakanlah (Muhammad) kepada hamba-hamba-Ku yang telah beriman, \"Hendaklah mereka melaksanakan salat, menginfakkan sebagian rezeki yang Kami berikan secara sembunyi atau terang-terangan sebelum datang hari, ketika tidak ada lagi jual beli dan persahabatan.\""},{"n":32,"w":[["ٱللَّهُ","Allah","al-lahu",4],["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","menciptakan","khalaqa",70],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["وَأَنزَلَ","dan Dia menurunkan","wa-anzala",71],["مِنَ","dari","mina",1],["ٱلسَّمَآءِ","langit","l-samāi",44],["مَآءًۭ","air/hujan","māan",204],["فَأَخْرَجَ","lalu Dia mengeluarkan","fa-akhraja",125],["بِهِۦ","dengannya","bihi",21],["مِنَ","dari","mina",1],["ٱلثَّمَرَٰتِ","buah-buahan","l-thamarāti",594],["رِزْقًۭا","rizki","riz'qan",231],["لَّكُمْ ۖ","bagi kalian","lakum",32],["وَسَخَّرَ","dan Dia menundukkan","wasakhara",489],["لَكُمُ","bagi kalian","lakumu",32],["ٱلْفُلْكَ","bahtera","l-ful'ka",465],["لِتَجْرِىَ","untuk berlayar/berjalan","litajriya",219],["فِى","di","fī",7],["ٱلْبَحْرِ","lautan","l-baḥri",300],["بِأَمْرِهِۦ ۖ","dengan perintahNya","bi-amrihi",75],["وَسَخَّرَ","dan Dia menundukan","wasakhara",489],["لَكُمُ","bagi kalian","lakumu",32],["ٱلْأَنْهَـٰرَ","sungai-sungai","l-anhāra",233]],"t":"Allah lah yang telah menciptakan langit dan bumi dan menurunkan air (hujan) dari langit, kemudian dengan (air hujan) itu Dia mengeluarkan berbagai buah-buahan sebagai rezeki untukmu; dan Dia telah menundukkan kapal bagimu agar berlayar di lautan dengan kehendak-Nya, dan Dia telah menundukkan sungai-sungai bagimu."},{"n":33,"w":[["وَسَخَّرَ","dan Dia menundukkan","wasakhara",489],["لَكُمُ","bagi kalian","lakumu",32],["ٱلشَّمْسَ","matahari","l-shamsa",358],["وَٱلْقَمَرَ","dan bulan","wal-qamara",419],["دَآئِبَيْنِ ۖ","keduanya tetap beredar","dāibayni",3383],["وَسَخَّرَ","dan Dia menundukkan","wasakhara",489],["لَكُمُ","bagi kalian","lakumu",32],["ٱلَّيْلَ","malam","al-layla",146],["وَٱلنَّهَارَ","dan siang","wal-nahāra",221]],"t":"Dan Dia telah menundukkan matahari dan bulan bagimu yang terus menerus beredar (dalam orbitnya); dan telah menundukkan malam dan siang bagimu."},{"n":34,"w":[["وَءَاتَىٰكُم","dan Dia memberikan kepadamu","waātākum",53],["مِّن","dari","min",1],["كُلِّ","segala","kulli",38],["مَا","apa","mā",6],["سَأَلْتُمُوهُ ۚ","kamu mohonkan kepadaNya","sa-altumūhu",119],["وَإِن","dan jika","wa-in",19],["تَعُدُّوا۟","kamu menghitung","taʿuddū",1060],["نِعْمَتَ","nikmat","niʿ'mata",250],["ٱللَّهِ","Allah","l-lahi",4],["لَا","tidak (dapat)","lā",8],["تُحْصُوهَآ ۗ","menghitungnya","tuḥ'ṣūhā",828],["إِنَّ","sesungguhnya","inna",9],["ٱلْإِنسَـٰنَ","manusia","l-insāna",181],["لَظَلُومٌۭ","sungguh sangat zalim","laẓalūmun",2324],["كَفَّارٌۭ","sangat ingkar","kaffārun",1372]],"t":"Dan Dia telah memberikan kepadamu segala apa yang kamu mohonkan kepada-Nya. Dan jika kamu menghitung nikmat Allah, niscaya kamu tidak dapat menghitungnya. Sungguh, manusia itu sangat zalim dan sangat mengingkari (nikmat Allah)."},{"n":35,"w":[["وَإِذْ","dan ketika","wa-idh",61],["قَالَ","berkata","qāla",10],["إِبْرَٰهِيمُ","Ibrahîm","ib'rāhīmu",192],["رَبِّ","ya Tuhanku","rabbi",15],["ٱجْعَلْ","jadikanlah","ij'ʿal",40],["هَـٰذَا","ini","hādhā",64],["ٱلْبَلَدَ","negeri","l-balada",672],["ءَامِنًۭا","aman","āminan",571],["وَٱجْنُبْنِى","dan jauhkan aku","wa-uj'nub'nī",3565],["وَبَنِىَّ","dan anak-anakku","wabaniyya",90],["أَن","bahwa","an",22],["نَّعْبُدَ","kami menyembah","naʿbuda",108],["ٱلْأَصْنَامَ","berhala","l-aṣnāma",1326]],"t":"Dan (ingatlah), ketika Ibrahim berdoa, \"Ya Tuhan, jadikanlah negeri ini (Mekkah), negeri yang aman, dan jauhkanlah aku beserta anak cucuku agar tidak menyembah berhala."},{"n":36,"w":[["رَبِّ","ya Tuhanku","rabbi",15],["إِنَّهُنَّ","sesungguhnya mereka","innahunna",9],["أَضْلَلْنَ","mereka telah menyesatkan","aḍlalna",199],["كَثِيرًۭا","kebanyakan","kathīran",172],["مِّنَ","dari","mina",1],["ٱلنَّاسِ ۖ","manusia","l-nāsi",60],["فَمَن","maka barangsiapa","faman",17],["تَبِعَنِى","mengikuti aku","tabiʿanī",950],["فَإِنَّهُۥ","maka sesungguhnya dia","fa-innahu",9],["مِنِّى ۖ","dariku","minnī",1],["وَمَنْ","dan barang siapa","waman",17],["عَصَانِى","mendurhakai aku","ʿaṣānī",411],["فَإِنَّكَ","maka sesungguhnya Engkau","fa-innaka",9],["غَفُورٌۭ","Maha Pengampun","ghafūrun",131],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",113]],"t":"Ya Tuhan, berhala-berhala itu telah menyesatkan banyak manusia. Barangsiapa mengikutiku, maka orang itu termasuk golonganku, dan barangsiapa mendurhakaiku, maka Engkau Maha Pengampun, Maha Penyayang."},{"n":37,"w":[["رَّبَّنَآ","ya Tuhan kami","rabbanā",15],["إِنِّىٓ","sesungguhnya aku","innī",9],["أَسْكَنتُ","aku menempatkan","askantu",1295],["مِن","dari","min",1],["ذُرِّيَّتِى","anak-cucuku/keturunanku","dhurriyyatī",365],["بِوَادٍ","di lembah","biwādin",1125],["غَيْرِ","tidak","ghayri",85],["ذِى","mempunyai","dhī",112],["زَرْعٍ","tanaman","zarʿin",882],["عِندَ","di sisi/di dekat","ʿinda",68],["بَيْتِكَ","rumah Engkau","baytika",196],["ٱلْمُحَرَّمِ","dihormati","l-muḥarami",1388],["رَبَّنَا","ya Tuhan kami","rabbanā",15],["لِيُقِيمُوا۟","agar mereka mendirikan","liyuqīmū",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["فَٱجْعَلْ","maka jadikanlah","fa-ij'ʿal",40],["أَفْـِٔدَةًۭ","hati","afidatan",607],["مِّنَ","dari","mina",1],["ٱلنَّاسِ","manusia","l-nāsi",60],["تَهْوِىٓ","cenderung","tahwī",992],["إِلَيْهِمْ","kepada mereka","ilayhim",18],["وَٱرْزُقْهُم","dan beri rezkilah mereka","wa-ur'zuq'hum",208],["مِّنَ","dari","mina",1],["ٱلثَّمَرَٰتِ","buah-buahan","l-thamarāti",594],["لَعَلَّهُمْ","agar mereka","laʿallahum",101],["يَشْكُرُونَ","mereka bersyukur","yashkurūna",267]],"t":"Ya Tuhan, sesungguhnya aku telah menempatkan sebagian keturunanku di lembah yang tidak mempunyai tanam-tanaman di dekat rumah Engkau (Baitullah) yang dihormati, ya Tuhan (yang demikian itu) agar mereka melaksanakan salat, maka jadikanlah hati sebagian manusia cenderung kepada mereka dan berilah mereka rezeki dari buah-buahan, mudah-mudahan mereka bersyukur."},{"n":38,"w":[["رَبَّنَآ","ya Tuhan kami","rabbanā",15],["إِنَّكَ","sesungguhnya Engkau","innaka",9],["تَعْلَمُ","Engkau ketahui","taʿlamu",35],["مَا","apa","mā",6],["نُخْفِى","kami sembunyikan","nukh'fī",534],["وَمَا","dan apa","wamā",6],["نُعْلِنُ ۗ","kami lahirkan","nuʿ'linu",724],["وَمَا","dan tidak","wamā",6],["يَخْفَىٰ","tersembunyi","yakhfā",1262],["عَلَى","atas","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["مِن","dari","min",1],["شَىْءٍۢ","sesuatu","shayin",49],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَلَا","dan tidak","walā",8],["فِى","di","fī",7],["ٱلسَّمَآءِ","langit","l-samāi",44]],"t":"Ya Tuhan kami, sesungguhnya Engkau mengetahui apa yang kami sembunyikan dan apa yang kami tampakkan; dan tidak ada sesuatu pun yang tersembunyi bagi Allah, baik yang ada di bumi maupun yang ada di langit."},{"n":39,"w":[["ٱلْحَمْدُ","segala puji","al-ḥamdu",286],["لِلَّهِ","Allah","lillahi",4],["ٱلَّذِى","yang","alladhī",45],["وَهَبَ","telah menganugerahkan","wahaba",490],["لِى","kepadaku","lī",158],["عَلَى","atas/di","ʿalā",11],["ٱلْكِبَرِ","masa tuaku","l-kibari",1208],["إِسْمَـٰعِيلَ","Ismail","is'māʿīla",723],["وَإِسْحَـٰقَ ۚ","dan Ishak","wa-is'ḥāqa",572],["إِنَّ","sesungguhnya","inna",9],["رَبِّى","Tuhanku","rabbī",15],["لَسَمِيعُ","sungguh Maha Mendengar","lasamīʿu",266],["ٱلدُّعَآءِ","doa","l-duʿāi",477]],"t":"Segala puji bagi Allah yang telah menganugerahkan kepadaku di hari tua(ku) Ismail dan Ishak. Sungguh, Tuhanku, benar-benar Maha Mendengar (memperkenankan) doa."},{"n":40,"w":[["رَبِّ","ya Tuhanku","rabbi",15],["ٱجْعَلْنِى","jadikanlah aku","ij'ʿalnī",40],["مُقِيمَ","orang yang mendirikan","muqīma",865],["ٱلصَّلَوٰةِ","sholat","l-ṣalati",147],["وَمِن","dan dari","wamin",1],["ذُرِّيَّتِى ۚ","anak-cucuku","dhurriyyatī",365],["رَبَّنَا","ya Tuhan kami","rabbanā",15],["وَتَقَبَّلْ","dan perkenankanlah","wataqabbal",876],["دُعَآءِ","doaku","duʿāi",477]],"t":"Ya Tuhanku, jadikanlah aku dan anak cucuku orang yang tetap melaksanakan salat, ya Tuhan kami, perkenankanlah doaku."},{"n":41,"w":[["رَبَّنَا","ya Tuhan kami","rabbanā",15],["ٱغْفِرْ","ampunilah","igh'fir",197],["لِى","aku","lī",158],["وَلِوَٰلِدَىَّ","dan kedua orang tuaku","waliwālidayya",879],["وَلِلْمُؤْمِنِينَ","dan kepada orang-orang mukmin","walil'mu'minīna",63],["يَوْمَ","hari","yawma",31],["يَقُومُ","wahai kaumku","yaqūmu",364],["ٱلْحِسَابُ","hisab/perhitungan","l-ḥisābu",319]],"t":"Ya Tuhan kami, ampunilah aku dan kedua ibu bapakku dan semua orang yang beriman pada hari diadakan perhitungan (hari Kiamat).\""},{"n":42,"w":[["وَلَا","dan jangan","walā",8],["تَحْسَبَنَّ","kamu mengira","taḥsabanna",280],["ٱللَّهَ","Allah","l-laha",4],["غَـٰفِلًا","lalai","ghāfilan",403],["عَمَّا","dari apa","ʿammā",27],["يَعْمَلُ","berbuat","yaʿmalu",52],["ٱلظَّـٰلِمُونَ ۚ","orang-orang yang zalim","l-ẓālimūna",97],["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["يُؤَخِّرُهُمْ","Dia memberi tangguh pada mereka","yu-akhiruhum",629],["لِيَوْمٍۢ","bagi/sampai hari","liyawmin",31],["تَشْخَصُ","terbuka/terbelalak","tashkhaṣu",2855],["فِيهِ","padanya/pada waktu itu","fīhi",7],["ٱلْأَبْصَـٰرُ","pandangan/mata","l-abṣāru",260]],"t":"Dan janganlah engkau mengira, bahwa Allah lengah dari apa yang diperbuat oleh orang yang zalim. Sesungguhnya Allah menangguhkan mereka sampai hari yang pada waktu itu mata (mereka) terbelalak,"},{"n":43,"w":[["مُهْطِعِينَ","mereka bergegas","muh'ṭiʿīna",1937],["مُقْنِعِى","tengadah/angkat muka","muq'niʿī",3857],["رُءُوسِهِمْ","kepala mereka","ruūsihim",566],["لَا","tidak","lā",8],["يَرْتَدُّ","berkedip","yartaddu",1035],["إِلَيْهِمْ","kepada mereka","ilayhim",18],["طَرْفُهُمْ ۖ","ujung/mata mereka","ṭarfuhum",1176],["وَأَفْـِٔدَتُهُمْ","dan hati mereka","wa-afidatuhum",607],["هَوَآءٌۭ","kosong","hawāon",796]],"t":"mereka datang tergesa-gesa (memenuhi panggilan) dengan mengangkat kepalanya, sedang mata mereka tidak berkedip dan hati mereka kosong."},{"n":44,"w":[["وَأَنذِرِ","dan berikanlah peringatan","wa-andhiri",279],["ٱلنَّاسَ","manusia","l-nāsa",60],["يَوْمَ","hari","yawma",31],["يَأْتِيهِمُ","datang kepada mereka","yatīhimu",56],["ٱلْعَذَابُ","azab","l-ʿadhābu",43],["فَيَقُولُ","maka berkata","fayaqūlu",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ظَلَمُوا۟","(mereka) zalim","ẓalamū",117],["رَبَّنَآ","ya Tuhan kami","rabbanā",15],["أَخِّرْنَآ","beri tangguhlah kami","akhir'nā",629],["إِلَىٰٓ","sampai","ilā",18],["أَجَلٍۢ","waktu","ajalin",238],["قَرِيبٍۢ","dekat","qarībin",429],["نُّجِبْ","kami akan mematuhi","nujib",970],["دَعْوَتَكَ","seruan Engkau","daʿwataka",1188],["وَنَتَّبِعِ","dan kami akan mengikuti","wanattabiʿi",95],["ٱلرُّسُلَ ۗ","Rasul-Rasul","l-rusula",42],["أَوَلَمْ","ataukah tidak","awalam",39],["تَكُونُوٓا۟","kalian menjadi","takūnū",12],["أَقْسَمْتُم","telah bersumpah","aqsamtum",515],["مِّن","dari","min",1],["قَبْلُ","dahulu","qablu",59],["مَا","apa","mā",6],["لَكُم","bagi kalian","lakum",32],["مِّن","dari","min",1],["زَوَالٍۢ","berubah/binasa","zawālin",4595]],"t":"Dan berikanlah peringatan (Muhammad) kepada manusia pada hari (ketika) azab datang kepada mereka, maka orang yang zalim berkata, \"Ya Tuhan kami, berilah kami kesempatan (kembali ke dunia) walaupun sebentar, niscaya kami akan mematuhi seruan Engkau dan akan mengikuti rasul-rasul.\" (Kepada mereka dikatakan), \"Bukankah dahulu (di dunia) kamu telah bersumpah bahwa sekali-kali kamu tidak akan binasa?"},{"n":45,"w":[["وَسَكَنتُمْ","dan kamu telah mendiami","wasakantum",650],["فِى","di/dalam","fī",7],["مَسَـٰكِنِ","kediaman","masākini",751],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ظَلَمُوٓا۟","(mereka)menganiaya","ẓalamū",117],["أَنفُسَهُمْ","diri mereka sendiri","anfusahum",47],["وَتَبَيَّنَ","dan telah jelas/nyata","watabayyana",568],["لَكُمْ","bagi kalian","lakum",32],["كَيْفَ","bagaimana","kayfa",148],["فَعَلْنَا","Kami telah berbuat","faʿalnā",136],["بِهِمْ","dengan/terhadap mereka","bihim",16],["وَضَرَبْنَا","dan Kami menjadikan","waḍarabnā",230],["لَكُمُ","bagi kalian","lakumu",32],["ٱلْأَمْثَالَ","perumpamaan","l-amthāla",138]],"t":"dan kamu telah tinggal di tempat orang yang menzalimi diri sendiri, dan telah nyata bagimu bagaimana Kami telah berbuat terhadap mereka dan telah Kami berikan kepadamu beberapa perumpamaan.\""},{"n":46,"w":[["وَقَدْ","dan sesungguhnya","waqad",30],["مَكَرُوا۟","mereka membuat tipu daya","makarū",482],["مَكْرَهُمْ","tipu daya mereka","makrahum",541],["وَعِندَ","dan disisi","waʿinda",68],["ٱللَّهِ","Allah","l-lahi",4],["مَكْرُهُمْ","tipu daya mereka","makruhum",541],["وَإِن","dan meskipun","wa-in",19],["كَانَ","adalah","kāna",12],["مَكْرُهُمْ","tipu daya mereka","makruhum",541],["لِتَزُولَ","untuk/dapat melenyapkan","litazūla",821],["مِنْهُ","dari padanya","min'hu",1],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",320]],"t":"Dan sungguh, mereka telah membuat tipu daya padahal Allah (mengetahui dan akan membalas) tipu daya mereka. Dan sesungguhnya tipu daya mereka tidak mampu melenyapkan gunung-gunung."},{"n":47,"w":[["فَلَا","maka janganlah","falā",8],["تَحْسَبَنَّ","sekali-kali kamu mengira","taḥsabanna",280],["ٱللَّهَ","Allah","l-laha",4],["مُخْلِفَ","menyalahi","mukh'lifa",3910],["وَعْدِهِۦ","janjiNya","waʿdihi",258],["رُسُلَهُۥٓ ۗ","Rasul-Rasul-Nya","rusulahu",42],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["عَزِيزٌۭ","Maha Perkasa","ʿazīzun",124],["ذُو","mempunyai","dhū",112],["ٱنتِقَامٍۢ","pembalasan","intiqāmin",1707]],"t":"Maka karena itu, jangan sekali-kali kamu mengira bahwa Allah mengingkari janji-Nya kepada rasul-rasul-Nya! Sungguh, Allah Mahaperkasa dan mempunyai pembalasan."},{"n":48,"w":[["يَوْمَ","pada hari","yawma",31],["تُبَدَّلُ","diganti","tubaddalu",463],["ٱلْأَرْضُ","bumi","l-arḍu",28],["غَيْرَ","selain","ghayra",85],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَٱلسَّمَـٰوَٰتُ ۖ","dan langit","wal-samāwātu",44],["وَبَرَزُوا۟","dan mereka menghadap","wabarazū",1341],["لِلَّهِ","Allah","lillahi",4],["ٱلْوَٰحِدِ","Maha Esa","l-wāḥidi",388],["ٱلْقَهَّارِ","Maha Perkasa","l-qahāri",1234]],"t":"(Yaitu) pada hari (ketika) bumi diganti dengan bumi yang lain dan (demikian pula) langit, dan mereka (manusia) berkumpul (di padang Mahsyar) menghadap Allah Yang Maha Esa, Mahaperkasa."},{"n":49,"w":[["وَتَرَى","dan kamu akan melihat","watarā",54],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",240],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["مُّقَرَّنِينَ","mereka bersama-sama","muqarranīna",1961],["فِى","dalam","fī",7],["ٱلْأَصْفَادِ","belenggu","l-aṣfādi",2297]],"t":"Dan pada hari itu engkau akan melihat orang yang berdosa bersama-sama diikat dengan belenggu."},{"n":50,"w":[["سَرَابِيلُهُم","pakaian mereka","sarābīluhum",2028],["مِّن","dari","min",1],["قَطِرَانٍۢ","kuningan yang panas","qaṭirānin",4112],["وَتَغْشَىٰ","dan menutupi","wataghshā",699],["وُجُوهَهُمُ","muka mereka","wujūhahumu",180],["ٱلنَّارُ","api neraka","l-nāru",87]],"t":"Pakaian mereka dari cairan aspal, dan wajah mereka ditutup oleh api neraka,"},{"n":51,"w":[["لِيَجْزِىَ","karena akan memberi balasan","liyajziya",175],["ٱللَّهُ","Allah","l-lahu",4],["كُلَّ","tiap-tiap","kulla",38],["نَفْسٍۢ","diri/orang","nafsin",47],["مَّا","apa","mā",6],["كَسَبَتْ ۚ","ia usahakan","kasabat",206],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["سَرِيعُ","sangat cepat","sarīʿu",874],["ٱلْحِسَابِ","perhitungan","l-ḥisābi",319]],"t":"agar Allah memberi balasan kepada setiap orang atas apa yang dia usahakan. Sungguh, Allah Mahacepat perhitungan-Nya."},{"n":52,"w":[["هَـٰذَا","ini","hādhā",64],["بَلَـٰغٌۭ","penyampaian/penjelasan","balāghun",638],["لِّلنَّاسِ","bagi manusia","lilnnāsi",60],["وَلِيُنذَرُوا۟","dan supaya diberi peringatan","waliyundharū",279],["بِهِۦ","dengannya","bihi",21],["وَلِيَعْلَمُوٓا۟","dan supaya mereka mengetahui","waliyaʿlamū",35],["أَنَّمَا","bahwasanya","annamā",36],["هُوَ","Dia","huwa",25],["إِلَـٰهٌۭ","Tuhan","ilāhun",84],["وَٰحِدٌۭ","Maha Esa","wāḥidun",388],["وَلِيَذَّكَّرَ","dan supaya mengambil pelajaran","waliyadhakkara",245],["أُو۟لُوا۟","orang-orang yang mempunyai","ulū",272],["ٱلْأَلْبَـٰبِ","akal","l-albābi",609]],"t":"Dan (Alquran) ini adalah penjelasan (yang sempurna) bagi manusia, agar mereka diberi peringatan dengannya, agar mereka mengetahui bahwa Dia adalah Tuhan Yang Maha Esa dan agar orang yang berakal mengambil pelajaran."}]