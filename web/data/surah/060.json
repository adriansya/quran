[{"n":1,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["لَا","janganlah","lā",8],["تَتَّخِذُوا۟","kamu mengambil/menjadikan","tattakhidhū",107],["عَدُوِّى","musuh-Ku","ʿaduwwī",248],["وَعَدُوَّكُمْ","dan musuhmu","waʿaduwwakum",248],["أَوْلِيَآءَ","penolong/sahabat","awliyāa",142],["تُلْقُونَ","kamu menemui/menyampaikan","tul'qūna",183],["إِلَيْهِم","kepada mereka","ilayhim",18],["بِٱلْمَوَدَّةِ","dengan kasih sayang","bil-mawadati",1010],["وَقَدْ","dan sesungguhnya","waqad",30],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["بِمَا","terhadap apa","bimā",6],["جَآءَكُم","datang kepadamu","jāakum",51],["مِّنَ","dari","mina",1],["ٱلْحَقِّ","kebenaran","l-ḥaqi",58],["يُخْرِجُونَ","mereka mengusir","yukh'rijūna",124],["ٱلرَّسُولَ","rasul","l-rasūla",42],["وَإِيَّاكُمْ ۙ","dan kamu","wa-iyyākum",446],["أَن","bahwa","an",22],["تُؤْمِنُوا۟","kamu beriman","tu'minū",23],["بِٱللَّهِ","kepada Allah","bil-lahi",4],["رَبِّكُمْ","Tuhan kalian","rabbikum",15],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["خَرَجْتُمْ","kamu keluar","kharajtum",237],["جِهَـٰدًۭا","berjihad/berjuang/bekerja keras","jihādan",1587],["فِى","pada","fī",7],["سَبِيلِى","jalan-Ku","sabīlī",73],["وَٱبْتِغَآءَ","dan mencari","wa-ib'tighāa",686],["مَرْضَاتِى ۚ","keridaan-Ku","marḍātī",1382],["تُسِرُّونَ","kamu merahasiakan","tusirrūna",554],["إِلَيْهِم","kepada mereka","ilayhim",18],["بِٱلْمَوَدَّةِ","dengan kasih sayang","bil-mawadati",1010],["وَأَنَا۠","dan Aku","wa-anā",194],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَآ","terhadap apa","bimā",6],["أَخْفَيْتُمْ","kamu sembunyikan","akhfaytum",535],["وَمَآ","dan apa","wamā",6],["أَعْلَنتُمْ ۚ","kamu nyatakan","aʿlantum",724],["وَمَن","dan barang siapa","waman",17],["يَفْعَلْهُ","melakukannya","yafʿalhu",136],["مِنكُمْ","diantara kamu","minkum",1],["فَقَدْ","maka sesungguhnya","faqad",30],["ضَلَّ","sesat","ḍalla",235],["سَوَآءَ","sama/lurus","sawāa",420],["ٱلسَّبِيلِ","jalan","l-sabīli",73]],"t":"Wahai orang-orang yang beriman! Janganlah kamu menjadikan musuh-Ku dan musuhmu sebagai teman-teman setia sehingga kamu sampaikan kepada mereka (berita-berita Muhammad), karena rasa kasih sayang; padahal mereka telah ingkar kepada kebenaran yang disampaikan kepadamu. Mereka mengusir Rasul dan kamu sendiri karena kamu beriman kepada Allah, Tuhanmu. Jika kamu benar-benar keluar untuk berjihad pada jalan-Ku dan mencari keridaan-Ku (janganlah kamu berbuat demikian). Kamu memberitahukan secara rahasia (berita-berita Muhammad) kepada mereka, karena rasa kasih sayang, dan Aku lebih mengetahui apa yang kamu sembunyikan dan apa yang kamu nyatakan. Dan barangsiapa di antara kamu yang melakukannya, maka sungguh dia telah tersesat dari jalan yang lurus."},{"n":2,"w":[["إِن","jika","in",19],["يَثْقَفُوكُمْ","mereka menangkap kamu","yathqafūkum",1252],["يَكُونُوا۟","mereka adalah","yakūnū",12],["لَكُمْ","bagi kalian","lakum",32],["أَعْدَآءًۭ","musuh","aʿdāan",248],["وَيَبْسُطُوٓا۟","dan mereka melepaskan","wayabsuṭū",604],["إِلَيْكُمْ","kepadamu","ilaykum",18],["أَيْدِيَهُمْ","tangan-tangan mereka","aydiyahum",110],["وَأَلْسِنَتَهُم","dan lidah mereka","wa-alsinatahum",442],["بِٱلسُّوٓءِ","dengan kejahatan (menyakiti)","bil-sūi",251],["وَوَدُّوا۟","dan mereka menginginkan","wawaddū",597],["لَوْ","sekiranya/supaya","law",66],["تَكْفُرُونَ","kalian kafir","takfurūna",48]],"t":"Jika mereka menangkapmu, niscaya mereka bertindak sebagai musuh bagimu lalu melepaskan tangan dan lidahnya kepadamu untuk menyakiti dan mereka ingin agar kamu (kembali) kafir."},{"n":3,"w":[["لَن","tidak","lan",122],["تَنفَعَكُمْ","memberi manfaat kepadamu","tanfaʿakum",378],["أَرْحَامُكُمْ","kerabat-kerabat kamu","arḥāmukum",758],["وَلَآ","dan tidak","walā",8],["أَوْلَـٰدُكُمْ ۚ","anak-anak kamu","awlādukum",228],["يَوْمَ","hari","yawma",31],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",188],["يَفْصِلُ","Dia memisahkan","yafṣilu",1350],["بَيْنَكُمْ ۚ","antara kamu","baynakum",55],["وَٱللَّهُ","dan Allah","wal-lahu",4],["بِمَا","terhadap apa","bimā",6],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",52],["بَصِيرٌۭ","Maha Melihat","baṣīrun",244]],"t":"Kaum kerabatmu dan anak-anakmu tidak akan bermanfaat bagimu pada hari Kiamat. Dia akan memisahkan antara kamu. Dan Allah Maha Melihat apa yang kamu kerjakan."},{"n":4,"w":[["قَدْ","sesungguhnya","qad",30],["كَانَتْ","telah ada","kānat",12],["لَكُمْ","bagi kalian","lakum",32],["أُسْوَةٌ","suri tauladan","us'watun",1777],["حَسَنَةٌۭ","yang baik","ḥasanatun",377],["فِىٓ","pada","fī",7],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",192],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["مَعَهُۥٓ","bersamanya","maʿahu",78],["إِذْ","apabila","idh",61],["قَالُوا۟","mereka mengatakan","qālū",10],["لِقَوْمِهِمْ","kepada kaumnya","liqawmihim",33],["إِنَّا","sesungguhnya","innā",9],["بُرَءَٰٓؤُا۟","berlepas diri","buraāu",743],["مِنكُمْ","dari kamu","minkum",1],["وَمِمَّا","dan dari apa","wamimmā",1],["تَعْبُدُونَ","kamu sembah","taʿbudūna",108],["مِن","dari","min",1],["دُونِ","selain","dūni",88],["ٱللَّهِ","Allah","l-lahi",4],["كَفَرْنَا","kami kafir/ingkar","kafarnā",48],["بِكُمْ","dengan/untuk kalian","bikum",32],["وَبَدَا","dan nyata","wabadā",790],["بَيْنَنَا","antara kami","baynanā",55],["وَبَيْنَكُمُ","dan antara kamu","wabaynakumu",55],["ٱلْعَدَٰوَةُ","permungsuhan","l-ʿadāwatu",1162],["وَٱلْبَغْضَآءُ","dan kebencian","wal-baghḍāu",1338],["أَبَدًا","selama-lamanya","abadan",400],["حَتَّىٰ","hingga","ḥattā",91],["تُؤْمِنُوا۟","kamu beriman","tu'minū",23],["بِٱللَّهِ","kepada Allah","bil-lahi",4],["وَحْدَهُۥٓ","sendiri-Nya","waḥdahu",1258],["إِلَّا","kecuali","illā",20],["قَوْلَ","perkataan","qawla",129],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",192],["لِأَبِيهِ","kepada bapaknya","li-abīhi",116],["لَأَسْتَغْفِرَنَّ","sungguh aku memohonkan ampun","la-astaghfiranna",314],["لَكَ","bagimu","laka",153],["وَمَآ","dan tidak","wamā",6],["أَمْلِكُ","aku memiliki/kuasa","amliku",282],["لَكَ","bagimu","laka",153],["مِنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["مِن","dari","min",1],["شَىْءٍۢ ۖ","sesuatu/sedikitpun","shayin",49],["رَّبَّنَا","ya Tuhan kami","rabbanā",15],["عَلَيْكَ","atas Engkau","ʿalayka",11],["تَوَكَّلْنَا","kami bertawakal","tawakkalnā",309],["وَإِلَيْكَ","dan kepada Engkau","wa-ilayka",18],["أَنَبْنَا","kami bertaubat","anabnā",777],["وَإِلَيْكَ","dan kepada Engkau","wa-ilayka",18],["ٱلْمَصِيرُ","kami kembali","l-maṣīru",404]],"t":"Sungguh, telah ada suri teladan yang baik bagimu pada Ibrahim dan orang-orang yang bersama dengannya, ketika mereka berkata kepada kaumnya, \"Sesungguhnya kami berlepas diri dari kamu dan dari apa yang kamu sembah selain Allah, kami mengingkari (kekafiran)mu dan telah nyata antara kami dan kamu ada permusuhan dan kebencian buat selama-lamanya sampai kamu beriman kepada Allah saja,\" kecuali perkataan Ibrahim kepada ayahnya, \"Sungguh, aku akan memohonkan ampunan bagimu, namun aku sama sekali tidak dapat menolak (siksaan) Allah terhadapmu.\" (Ibrahim berkata), \"Ya Tuhan kami, hanya kepada Engkau kami bertawakal dan hanya kepada Engkau kami bertobat dan hanya kepada Engkaulah kami kembali,"},{"n":5,"w":[["رَبَّنَا","ya Tuhan kami","rabbanā",15],["لَا","janganlah","lā",8],["تَجْعَلْنَا","kami Engkau jadikan kami","tajʿalnā",40],["فِتْنَةًۭ","percobaan","fit'natan",355],["لِّلَّذِينَ","bagi orang-orang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["وَٱغْفِرْ","dan ampunilah","wa-igh'fir",197],["لَنَا","bagi kami","lanā",135],["رَبَّنَآ ۖ","ya Tuhan kami","rabbanā",15],["إِنَّكَ","sesungguhnya Engkau","innaka",9],["أَنتَ","Engkau","anta",154],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",123],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",125]],"t":"Ya Tuhan kami, janganlah Engkau jadikan kami (sasaran) fitnah bagi orang-orang kafir. Dan ampunilah kami, ya Tuhan kami. Sesungguhnya Engkau Żat Yang Mahaperkasa, Mahabijaksana.\""},{"n":6,"w":[["لَقَدْ","sesungguhnya","laqad",30],["كَانَ","adalah","kāna",12],["لَكُمْ","bagi kalian","lakum",32],["فِيهِمْ","didalamnya","fīhim",7],["أُسْوَةٌ","suri teladan","us'watun",1777],["حَسَنَةٌۭ","yang baik","ḥasanatun",377],["لِّمَن","bagi siapa","liman",17],["كَانَ","adalah","kāna",12],["يَرْجُوا۟","mereka mengharap","yarjū",487],["ٱللَّهَ","Allah","l-laha",4],["وَٱلْيَوْمَ","dan hari","wal-yawma",31],["ٱلْـَٔاخِرَ ۚ","akhir","l-ākhira",82],["وَمَن","dan barang siapa","waman",17],["يَتَوَلَّ","berpaling","yatawalla",160],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["ٱلْغَنِىُّ","Maha Kaya","l-ghaniyu",453],["ٱلْحَمِيدُ","Maha Terpuji","l-ḥamīdu",578]],"t":"Sungguh, pada mereka itu (Ibrahim dan umatnya) terdapat suri teladan yang baik bagimu; (yaitu) bagi orang yang mengharap (pahala) Allah dan (keselamatan pada) hari kemudian, dan barangsiapa berpaling, maka sesungguhnya Allah, Dialah Yang Mahakaya, Maha Terpuji."},{"n":7,"w":[["۞ عَسَى","mudah-mudahan","ʿasā",381],["ٱللَّهُ","Allah","l-lahu",4],["أَن","bahwa","an",22],["يَجْعَلَ","menjadikan","yajʿala",40],["بَيْنَكُمْ","diantara kamu","baynakum",55],["وَبَيْنَ","dan antara","wabayna",55],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["عَادَيْتُم","kamu musuhi","ʿādaytum",3087],["مِّنْهُم","diantara mereka","min'hum",1],["مَّوَدَّةًۭ ۚ","kasih sayang","mawaddatan",1010],["وَٱللَّهُ","dan Allah","wal-lahu",4],["قَدِيرٌۭ ۚ","Maha Kuasa","qadīrun",275],["وَٱللَّهُ","dan Allah","wal-lahu",4],["غَفُورٌۭ","Maha Pengampun","ghafūrun",131],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",113]],"t":"Mudah-mudahan Allah menumbuhkan kasih sayang di antara kamu dengan orang-orang yang pernah kamu musuhi di antara mereka. Allah Mahakuasa. Dan Allah Maha Pengampun, Maha Penyayang."},{"n":8,"w":[["لَّا","tidak","lā",8],["يَنْهَىٰكُمُ","melarang kamu","yanhākumu",372],["ٱللَّهُ","Allah","l-lahu",4],["عَنِ","dari/terhadap","ʿani",27],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["لَمْ","tidak","lam",39],["يُقَـٰتِلُوكُمْ","memerangi kamu","yuqātilūkum",234],["فِى","dalam","fī",7],["ٱلدِّينِ","agama","l-dīni",130],["وَلَمْ","dan tidak","walam",39],["يُخْرِجُوكُم","mengusir/mengeluarkan kamu","yukh'rijūkum",124],["مِّن","dari","min",1],["دِيَـٰرِكُمْ","rumah/kampung halaman","diyārikum",261],["أَن","bahwa","an",22],["تَبَرُّوهُمْ","kamu berbuat baik kepada mereka","tabarrūhum",2349],["وَتُقْسِطُوٓا۟","dan kamu berlaku adil","watuq'siṭū",1762],["إِلَيْهِمْ ۚ","kepada mereka","ilayhim",18],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["يُحِبُّ","menyukai","yuḥibbu",200],["ٱلْمُقْسِطِينَ","orang-orang yang berlaku adil","l-muq'siṭīna",1944]],"t":"Allah tidak melarang kamu berbuat baik dan berlaku adil terhadap orang-orang yang tidak memerangimu dalam urusan agama dan tidak mengusir kamu dari kampung halamanmu. Sesungguhnya Allah mencintai orang-orang yang berlaku adil."},{"n":9,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["يَنْهَىٰكُمُ","melarang kamu","yanhākumu",372],["ٱللَّهُ","Allah","l-lahu",4],["عَنِ","dari","ʿani",27],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["قَـٰتَلُوكُمْ","(mereka) memerangi kamu","qātalūkum",234],["فِى","dalam","fī",7],["ٱلدِّينِ","agama","l-dīni",130],["وَأَخْرَجُوكُم","dan mengusir/mengeluarkan kamu","wa-akhrajūkum",124],["مِّن","dari","min",1],["دِيَـٰرِكُمْ","kampung halamanmu","diyārikum",261],["وَظَـٰهَرُوا۟","dan mereka membantu","waẓāharū",1177],["عَلَىٰٓ","atas/untuk","ʿalā",11],["إِخْرَاجِكُمْ","mengusir kamu","ikh'rājikum",1143],["أَن","bahwa","an",22],["تَوَلَّوْهُمْ ۚ","kamu menjadikan mereka sebagai kawan","tawallawhum",160],["وَمَن","dan barang siapa","waman",17],["يَتَوَلَّهُمْ","menjadikan mereka sebagai kawan","yatawallahum",160],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",65],["هُمُ","mereka","humu",16],["ٱلظَّـٰلِمُونَ","orang-orang yang zalim","l-ẓālimūna",97]],"t":"Sesungguhnya Allah hanya melarang kamu menjadikan mereka sebagai kawanmu orang-orang yang memerangi kamu dalam urusan agama dan mengusir kamu dari kampung halamanmu dan membantu (orang lain) untuk mengusirmu. Barangsiapa menjadikan mereka sebagai kawan, mereka itulah orang yang zalim."},{"n":10,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوٓا۟","beriman","āmanū",23],["إِذَا","apabila","idhā",29],["جَآءَكُمُ","datang kepadamu","jāakumu",51],["ٱلْمُؤْمِنَـٰتُ","orang perempuan beriman","l-mu'minātu",63],["مُهَـٰجِرَٰتٍۢ","berhijrah","muhājirātin",1007],["فَٱمْتَحِنُوهُنَّ ۖ","maka ujilah mereka","fa-im'taḥinūhunna",2806],["ٱللَّهُ","Allah","l-lahu",4],["أَعْلَمُ","mengetahui","aʿlamu",252],["بِإِيمَـٰنِهِنَّ ۖ","tentang keimanan mereka","biīmānihinna",271],["فَإِنْ","maka jika","fa-in",19],["عَلِمْتُمُوهُنَّ","mengetahui mereka","ʿalim'tumūhunna",35],["مُؤْمِنَـٰتٍۢ","wanita-wanita beriman","mu'minātin",63],["فَلَا","maka janganlah","falā",8],["تَرْجِعُوهُنَّ","kamu kembalikan mereka","tarjiʿūhunna",156],["إِلَى","kepada","ilā",18],["ٱلْكُفَّارِ ۖ","orang-orang kafir","l-kufāri",79],["لَا","tidak","lā",8],["هُنَّ","mereka (wanita beriman)","hunna",413],["حِلٌّۭ","halal","ḥillun",1320],["لَّهُمْ","bagi mereka","lahum",16],["وَلَا","dan tidak","walā",8],["هُمْ","mereka","hum",16],["يَحِلُّونَ","halal","yaḥillūna",668],["لَهُنَّ ۖ","bagi mereka","lahunna",413],["وَءَاتُوهُم","dan berikan kepada mereka","waātūhum",53],["مَّآ","apa-apa","mā",6],["أَنفَقُوا۟ ۚ","mereka belanjakan","anfaqū",193],["وَلَا","dan tidak","walā",8],["جُنَاحَ","berdosa","junāḥa",441],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["أَن","bahwa","an",22],["تَنكِحُوهُنَّ","kamu nikah dengan mereka","tankiḥūhunna",682],["إِذَآ","apabila","idhā",29],["ءَاتَيْتُمُوهُنَّ","kamu berikan kepada mereka","ātaytumūhunna",53],["أُجُورَهُنَّ ۚ","maskawin mereka","ujūrahunna",120],["وَلَا","dan jangan","walā",8],["تُمْسِكُوا۟","kamu tahan/pegang","tum'sikū",553],["بِعِصَمِ","dengan tali/ikatan","biʿiṣami",3136],["ٱلْكَوَافِرِ","wanita-wanita kafir","l-kawāfiri",79],["وَسْـَٔلُوا۟","dan mintalah","wasalū",118],["مَآ","apa","mā",6],["أَنفَقْتُمْ","kamu belanjakan","anfaqtum",193],["وَلْيَسْـَٔلُوا۟","dan agar mereka meminta","walyasalū",118],["مَآ","apa","mā",6],["أَنفَقُوا۟ ۚ","yang mereka belanjakan","anfaqū",193],["ذَٰلِكُمْ","demikian itu","dhālikum",26],["حُكْمُ","ketetapan/hukum","ḥuk'mu",382],["ٱللَّهِ ۖ","Allah","l-lahi",4],["يَحْكُمُ","menetapkan/memberi hukum","yaḥkumu",273],["بَيْنَكُمْ ۚ","diantara kamu","baynakum",55],["وَٱللَّهُ","dan Allah","wal-lahu",4],["عَلِيمٌ","Maha Mengetahui","ʿalīmun",77],["حَكِيمٌۭ","Maha Bijaksana","ḥakīmun",125]],"t":"Wahai orang-orang yang beriman! Apabila perempuan-perempuan mukmin datang berhijrah kepadamu, maka hendaklah kamu uji (keimanan) mereka. Allah lebih mengetahui tentang keimanan mereka; jika kamu telah mengetahui bahwa mereka (benar-benar) beriman maka janganlah kamu kembalikan mereka kepada orang-orang kafir (suami-suami mereka). Mereka tidak halal bagi orang-orang kafir itu dan orang-orang kafir itu tidak halal bagi mereka. Dan berikanlah kepada (suami) mereka mahar yang telah mereka berikan. Dan tidak ada dosa bagimu menikahi mereka apabila kamu bayarkan kepada mereka maharnya. Dan janganlah kamu tetap berpegang pada tali (pernikahan) dengan perempuan-perempuan kafir; dan hendaklah kamu minta kembali mahar yang telah kamu berikan; dan (jika suaminya tetap kafir) biarkan mereka meminta kembali mahar yang telah mereka bayarkan (kepada mantan istrinya yang telah beriman). Demikianlah hukum Allah yang ditetapkan-Nya di antara kamu. Dan Allah Maha Mengetahui, Mahabijaksana."},{"n":11,"w":[["وَإِن","dan jika","wa-in",19],["فَاتَكُمْ","berlalu/lari padamu","fātakum",1851],["شَىْءٌۭ","sesuatu","shayon",49],["مِّنْ","dari","min",1],["أَزْوَٰجِكُمْ","isteri-isterimu","azwājikum",166],["إِلَى","kepada","ilā",18],["ٱلْكُفَّارِ","orang-orang kafir","l-kufāri",79],["فَعَاقَبْتُمْ","lalu kamu mengalahkan","faʿāqabtum",1161],["فَـَٔاتُوا۟","maka berikanlah","faātū",53],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ذَهَبَتْ","pergi/lari","dhahabat",343],["أَزْوَٰجُهُم","isteri-isteri mereka","azwājuhum",166],["مِّثْلَ","seperti/sebesar","mith'la",168],["مَآ","apa","mā",6],["أَنفَقُوا۟ ۚ","mereka belanjakan","anfaqū",193],["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",76],["ٱللَّهَ","Allah","l-laha",4],["ٱلَّذِىٓ","yang","alladhī",45],["أَنتُم","kamu","antum",96],["بِهِۦ","kepada-Nya","bihi",21],["مُؤْمِنُونَ","orang-orang yang beriman","mu'minūna",63]],"t":"Dan jika ada sesuatu (pengembalian mahar) yang belum kamu selesaikan dari istri-istrimu yang lari kepada orang-orang kafir, lalu kamu dapat mengalahkan mereka maka berikanlah (dari harta rampasan) kepada orang-orang yang istrinya lari itu sebanyak mahar yang telah mereka berikan. Dan bertakwalah kamu kepada Allah yang kepada-Nya kamu beriman."},{"n":12,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلنَّبِىُّ","nabi","l-nabiyu",169],["إِذَا","apabila","idhā",29],["جَآءَكَ","datang kepadamu","jāaka",51],["ٱلْمُؤْمِنَـٰتُ","wanita-wanita beriman","l-mu'minātu",63],["يُبَايِعْنَكَ","berjanji setia","yubāyiʿ'naka",1181],["عَلَىٰٓ","atas","ʿalā",11],["أَن","bahwa","an",22],["لَّا","tidak","lā",8],["يُشْرِكْنَ","mempersekutukan","yush'rik'na",182],["بِٱللَّهِ","dengan Allah","bil-lahi",4],["شَيْـًۭٔا","sesuatu","shayan",49],["وَلَا","dan tidak","walā",8],["يَسْرِقْنَ","mereka mencuri","yasriq'na",1669],["وَلَا","dan tidak","walā",8],["يَزْنِينَ","berizina","yaznīna",2788],["وَلَا","dan tidak","walā",8],["يَقْتُلْنَ","membunuh","yaqtul'na",149],["أَوْلَـٰدَهُنَّ","anak-anak mereka","awlādahunna",228],["وَلَا","dan tidak","walā",8],["يَأْتِينَ","datangkan/berbuat","yatīna",56],["بِبُهْتَـٰنٍۢ","dengan dusta","bibuh'tānin",1187],["يَفْتَرِينَهُۥ","mereka ada-adakannya","yaftarīnahu",247],["بَيْنَ","antara","bayna",55],["أَيْدِيهِنَّ","tangan mereka","aydīhinna",110],["وَأَرْجُلِهِنَّ","dan kaki-kaki mereka","wa-arjulihinna",649],["وَلَا","dan tidak","walā",8],["يَعْصِينَكَ","mereka mendurhakaimu","yaʿṣīnaka",411],["فِى","dalam","fī",7],["مَعْرُوفٍۢ ۙ","kebaikan","maʿrūfin",323],["فَبَايِعْهُنَّ","maka terimalah janji setia mereka","fabāyiʿ'hunna",1181],["وَٱسْتَغْفِرْ","dan mohonkan ampun","wa-is'taghfir",314],["لَهُنَّ","bagi/untuk mereka","lahunna",413],["ٱللَّهَ ۖ","Allah","l-laha",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["غَفُورٌۭ","Maha Pengampun","ghafūrun",131],["رَّحِيمٌۭ","Maha Penyayang","raḥīmun",113]],"t":"Wahai Nabi! Apabila perempuan-perempuan mukmin datang kepadamu untuk mengadakan baiat (janji setia), bahwa mereka tidak akan mempersekutukan sesuatu apa pun dengan Allah; tidak akan mencuri, tidak akan berzina, tidak akan membunuh anak-anaknya, tidak akan berbuat dusta yang mereka ada-adakan antara tangan dan kaki mereka dan tidak akan mendurhakaimu dalam urusan yang baik, maka terimalah janji setia mereka dan mohonkanlah ampunan untuk mereka kepada Allah. Sungguh, Allah Maha Pengampun, Maha Penyayang."},{"n":13,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["لَا","jangan","lā",8],["تَتَوَلَّوْا۟","jadikan sabahat/pemimpin","tatawallaw",160],["قَوْمًا","kaum","qawman",33],["غَضِبَ","memurkai","ghaḍiba",1197],["ٱللَّهُ","Allah","l-lahu",4],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["قَدْ","sesungguhnya","qad",30],["يَئِسُوا۟","mereka putus asa","ya-isū",1031],["مِنَ","dari/terhadap","mina",1],["ٱلْـَٔاخِرَةِ","akhitat","l-ākhirati",82],["كَمَا","sebagaimana","kamā",6],["يَئِسَ","berputus asa","ya-isa",1031],["ٱلْكُفَّارُ","orang-orang kafir","l-kufāru",79],["مِنْ","dari","min",1],["أَصْحَـٰبِ","penghuni","aṣḥābi",132],["ٱلْقُبُورِ","kubur","l-qubūri",1233]],"t":"Wahai orang-orang yang beriman! Janganlah kamu jadikan orang-orang yang dimurkai Allah sebagai penolongmu, sungguh, mereka telah putus asa terhadap akhirat sebagaimana orang-orang kafir yang telah berada dalam kubur juga berputus asa."}]