[{"n":1,"w":[["سَبَّحَ","bertasbih","sabbaḥa",293],["لِلَّهِ","kepada Allah","lillahi",4],["مَا","apa","mā",6],["فِى","pada","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَمَا","dan apa","wamā",6],["فِى","pada","fī",7],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",28],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",124],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",126]],"t":"Apa yang ada di langit dan apa yang ada di bumi bertasbih kepada Allah; dan Dialah Yang Mahaperkasa, Mahabijaksana."},{"n":2,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["لِمَ","mengapa","lima",6],["تَقُولُونَ","kamu mengatakan","taqūlūna",10],["مَا","apa","mā",6],["لَا","tidak","lā",8],["تَفْعَلُونَ","kamu kerjakan","tafʿalūna",136]],"t":"Wahai orang-orang yang beriman! Mengapa kamu mengatakan sesuatu yang tidak kamu kerjakan?"},{"n":3,"w":[["كَبُرَ","besar","kabura",995],["مَقْتًا","kebencian","maqtan",1212],["عِندَ","disisi","ʿinda",68],["ٱللَّهِ","Allah","l-lahi",4],["أَن","bahwa","an",22],["تَقُولُوا۟","kamu mengatakan","taqūlū",10],["مَا","apa","mā",6],["لَا","tidak","lā",8],["تَفْعَلُونَ","kamu kerjakan","tafʿalūna",136]],"t":"(Itu) sangatlah dibenci di sisi Allah jika kamu mengatakan apa-apa yang tidak kamu kerjakan."},{"n":4,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["يُحِبُّ","mencintai","yuḥibbu",200],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يُقَـٰتِلُونَ","(mereka) berperang","yuqātilūna",234],["فِى","pada","fī",7],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",73],["صَفًّۭا","barisan","ṣaffan",1073],["كَأَنَّهُم","seakan-akan","ka-annahum",395],["بُنْيَـٰنٌۭ","bangunan","bun'yānun",1078],["مَّرْصُوصٌۭ","tersusun","marṣūṣun",3940]],"t":"Sesungguhnya Allah mencintai orang-orang yang berperang di jalan-Nya dalam barisan yang teratur, mereka seakan-akan seperti suatu bangunan yang tersusun kokoh."},{"n":5,"w":[["وَإِذْ","apabila","wa-idh",61],["قَالَ","berkata","qāla",10],["مُوسَىٰ","Musa","mūsā",94],["لِقَوْمِهِۦ","kepada kaumnya","liqawmihi",33],["يَـٰقَوْمِ","wahai kaumku","yāqawmi",33],["لِمَ","mengapa","lima",6],["تُؤْذُونَنِى","kamu menyakiti aku","tu'dhūnanī",654],["وَقَد","dan sesungguhnya","waqad",30],["تَّعْلَمُونَ","(kalian) mengetahui","taʿlamūna",35],["أَنِّى","sesungguhnya aku","annī",36],["رَسُولُ","rasul/utusan","rasūlu",42],["ٱللَّهِ","Allah","l-lahi",4],["إِلَيْكُمْ ۖ","kepadamu","ilaykum",18],["فَلَمَّا","maka tatkala","falammā",81],["زَاغُوٓا۟","mereka berpaling","zāghū",1267],["أَزَاغَ","memalingkan","azāgha",2208],["ٱللَّهُ","Allah","l-lahu",4],["قُلُوبَهُمْ ۚ","hati mereka","qulūbahum",98],["وَٱللَّهُ","dan Allah","wal-lahu",4],["لَا","tidak","lā",8],["يَهْدِى","menunjukkan","yahdī",89],["ٱلْقَوْمَ","kaum","l-qawma",33],["ٱلْفَـٰسِقِينَ","orang-orang yang fasik","l-fāsiqīna",334]],"t":"Dan (ingatlah) ketika Musa berkata kepada kaumnya, \"Wahai kaumku! Mengapa kamu menyakitiku, padahal kamu sungguh mengetahui bahwa sesungguhnya aku utusan Allah kepadamu?\" Maka ketika mereka berpaling (dari kebenaran), Allah memalingkan hati mereka. Dan Allah tidak memberi petunjuk kepada kaum yang fasik."},{"n":6,"w":[["وَإِذْ","dan apabila","wa-idh",61],["قَالَ","berkata","qāla",10],["عِيسَى","Isa","ʿīsā",436],["ٱبْنُ","binti/anak","ub'nu",90],["مَرْيَمَ","Maryam","maryama",356],["يَـٰبَنِىٓ","Wahai keturunan","yābanī",90],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",284],["إِنِّى","sesungguhnya aku","innī",9],["رَسُولُ","rasul/utusan","rasūlu",42],["ٱللَّهِ","Allah","l-lahi",4],["إِلَيْكُم","kepadamu","ilaykum",18],["مُّصَدِّقًۭا","yang membenarkan","muṣaddiqan",542],["لِّمَا","terhadap apa","limā",6],["بَيْنَ","antara","bayna",55],["يَدَىَّ","hadapanku/sebelumku","yadayya",110],["مِنَ","dari","mina",1],["ٱلتَّوْرَىٰةِ","Taurat","l-tawrāti",569],["وَمُبَشِّرًۢا","dan kabar gembira","wamubashiran",859],["بِرَسُولٍۢ","dengan seorang rasul","birasūlin",42],["يَأْتِى","akan datang","yatī",56],["مِنۢ","dari","min",1],["بَعْدِى","sesudahku","baʿdī",67],["ٱسْمُهُۥٓ","namanya","us'muhu",324],["أَحْمَدُ ۖ","Ahmad","aḥmadu",2938],["فَلَمَّا","maka tatkala","falammā",81],["جَآءَهُم","datang kepada mereka","jāahum",51],["بِٱلْبَيِّنَـٰتِ","dengan keterangan yang jelas","bil-bayināti",185],["قَالُوا۟","berkata mereka","qālū",10],["هَـٰذَا","ini","hādhā",64],["سِحْرٌۭ","sihir","siḥ'run",408],["مُّبِينٌۭ","yang nyata","mubīnun",112]],"t":"Dan (ingatlah) ketika Isa Putra Maryam berkata, \"Wahai Bani Israil! Sesungguhnya aku utusan Allah kepadamu, yang membenarkan kitab (yang turun) sebelumku, yaitu Taurat dan memberi kabar gembira dengan seorang rasul yang akan datang setelahku, yang namanya Ahmad (Muhammad).\" Namun ketika Rasul itu datang kepada mereka dengan membawa bukti-bukti yang nyata, mereka berkata, \"Ini adalah sihir yang nyata.\""},{"n":7,"w":[["وَمَنْ","dan siapa","waman",17],["أَظْلَمُ","lebih zalim","aẓlamu",598],["مِمَّنِ","dari pada orang","mimmani",1],["ٱفْتَرَىٰ","mengada-adakan","if'tarā",247],["عَلَى","atas/terhadap Allah","ʿalā",11],["ٱللَّهِ","Allah","l-lahi",4],["ٱلْكَذِبَ","dusta","l-kadhiba",361],["وَهُوَ","dan dia","wahuwa",25],["يُدْعَىٰٓ","di ajak","yud'ʿā",74],["إِلَى","atas","ilā",18],["ٱلْإِسْلَـٰمِ ۚ","Islam","l-is'lāmi",964],["وَٱللَّهُ","baginya","wal-lahu",4],["لَا","tidak","lā",8],["يَهْدِى","memberi petunjuk","yahdī",89],["ٱلْقَوْمَ","kaum","l-qawma",33],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97]],"t":"Dan siapakah yang lebih zalim daripada orang yang mengada-adakan kebohongan terhadap Allah padahal dia diajak kepada (agama) Islam? Dan Allah tidak memberi petunjuk kepada orang-orang yang zalim."},{"n":8,"w":[["يُرِيدُونَ","mereka ingin/menghendaki","yurīdūna",92],["لِيُطْفِـُٔوا۟","untuk memadamkan","liyuṭ'fiū",1744],["نُورَ","cahaya","nūra",288],["ٱللَّهِ","Allah","l-lahi",4],["بِأَفْوَٰهِهِمْ","dengan mulut-mulut mereka","bi-afwāhihim",697],["وَٱللَّهُ","dan Allah","wal-lahu",4],["مُتِمُّ","menyempurnakan","mutimmu",3897],["نُورِهِۦ","cahaya-Nya","nūrihi",288],["وَلَوْ","meskipun","walaw",66],["كَرِهَ","benci","kariha",586],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",79]],"t":"Mereka hendak memadamkan cahaya (agama) Allah dengan mulut (ucapan-ucapan) mereka, tetapi Allah tetap menyempurnakan cahaya-Nya meskipun orang-orang kafir membencinya."},{"n":9,"w":[["هُوَ","Dia","huwa",25],["ٱلَّذِىٓ","yang","alladhī",45],["أَرْسَلَ","mengutus","arsala",100],["رَسُولَهُۥ","utusan/rasul-Nya","rasūlahu",42],["بِٱلْهُدَىٰ","dengan petunjuk","bil-hudā",143],["وَدِينِ","dan agama","wadīni",130],["ٱلْحَقِّ","yang benar","l-ḥaqi",58],["لِيُظْهِرَهُۥ","untuk memenangkan","liyuẓ'hirahu",968],["عَلَى","atas","ʿalā",11],["ٱلدِّينِ","agama","l-dīni",130],["كُلِّهِۦ","semuanya/seluruhnya","kullihi",38],["وَلَوْ","meskipun","walaw",66],["كَرِهَ","benci","kariha",586],["ٱلْمُشْرِكُونَ","orang-orang musyrik","l-mush'rikūna",256]],"t":"Dialah yang mengutus Rasul-Nya dengan membawa petunjuk dan agama yang benar, untuk memenangkannya di atas segala agama meskipun orang-orang musyrik membencinya."},{"n":10,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["هَلْ","apakah","hal",128],["أَدُلُّكُمْ","aku tunjukkan kepadamu","adullukum",1080],["عَلَىٰ","atas","ʿalā",11],["تِجَـٰرَةٍۢ","perdagangan","tijāratin",952],["تُنجِيكُم","ia akan menyelamatkan kamu","tunjīkum",461],["مِّنْ","dari","min",1],["عَذَابٍ","azab","ʿadhābin",43],["أَلِيمٍۢ","pedih","alīmin",178]],"t":"Wahai orang-orang yang beriman! Maukah kamu Aku tunjukkan suatu perdagangan yang dapat menyelamatkan kamu dari azab yang pedih?"},{"n":11,"w":[["تُؤْمِنُونَ","kamu beriman","tu'minūna",23],["بِٱللَّهِ","kepada Allah","bil-lahi",4],["وَرَسُولِهِۦ","dan rasul-Nya","warasūlihi",42],["وَتُجَـٰهِدُونَ","dan kamu berjihad/berjuang","watujāhidūna",415],["فِى","pada","fī",7],["سَبِيلِ","jalan","sabīli",73],["ٱللَّهِ","Allah","l-lahi",4],["بِأَمْوَٰلِكُمْ","dengan harta kamu","bi-amwālikum",141],["وَأَنفُسِكُمْ ۚ","dan jiwa kamu","wa-anfusikum",47],["ذَٰلِكُمْ","demikian itu","dhālikum",26],["خَيْرٌۭ","lebih baik","khayrun",69],["لَّكُمْ","bagi kalian","lakum",32],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",35]],"t":"(Yaitu) kamu beriman kepada Allah dan Rasul-Nya dan berjihad di jalan Allah dengan harta dan jiwamu. Itulah yang lebih baik bagi kamu jika kamu mengetahui,"},{"n":12,"w":[["يَغْفِرْ","Dia (allah) mengampuni","yaghfir",197],["لَكُمْ","bagi kalian","lakum",32],["ذُنُوبَكُمْ","dosa-dosamu","dhunūbakum",329],["وَيُدْخِلْكُمْ","dan Dia memasukkan kamu","wayud'khil'kum",289],["جَنَّـٰتٍۢ","surga","jannātin",86],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",233],["وَمَسَـٰكِنَ","dan tempat-tempat tinggal","wamasākina",750],["طَيِّبَةًۭ","baik","ṭayyibatan",268],["فِى","pada","fī",7],["جَنَّـٰتِ","surga","jannāti",86],["عَدْنٍۢ ۚ","Adn","ʿadnin",780],["ذَٰلِكَ","demikian itu","dhālika",26],["ٱلْفَوْزُ","keuntungan","l-fawzu",540],["ٱلْعَظِيمُ","besar","l-ʿaẓīmu",109]],"t":"niscaya Allah mengampuni dosa-dosamu dan memasukkan kamu ke dalam surga yang mengalir di bawahnya sungai-sungai, dan ke tempat-tempat tinggal yang baik di dalam surga 'Ādn. Itulah kemenangan yang agung."},{"n":13,"w":[["وَأُخْرَىٰ","dan yang lain","wa-ukh'rā",187],["تُحِبُّونَهَا ۖ","kamu menyukainya","tuḥibbūnahā",200],["نَصْرٌۭ","pertolongan","naṣrun",483],["مِّنَ","dari","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["وَفَتْحٌۭ","dan kemenangan","wafatḥun",745],["قَرِيبٌۭ ۗ","dekat","qarībun",429],["وَبَشِّرِ","dan berilah kabar gembira","wabashiri",326],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",63]],"t":"Dan (ada lagi) karunia lain yang kamu sukai (yaitu) pertolongan dari Allah dan kemenangan yang dekat (waktunya). Dan sampaikanlah berita gembira kepada orang-orang mukmin."},{"n":14,"w":[["يَـٰٓأَيُّهَا","wahai","yāayyuhā",83],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["كُونُوٓا۟","adalah/jadilah kamu","kūnū",12],["أَنصَارَ","penolong-penolong","anṣāra",348],["ٱللَّهِ","Allah","l-lahi",4],["كَمَا","sebagaimana","kamā",6],["قَالَ","berkata","qāla",10],["عِيسَى","Isa","ʿīsā",436],["ٱبْنُ","anak","ub'nu",90],["مَرْيَمَ","Maryam","maryama",356],["لِلْحَوَارِيِّـۧنَ","kepada pengikut-pengikut setia","lil'ḥawāriyyīna",1316],["مَنْ","siapakah","man",17],["أَنصَارِىٓ","penolong-penolongku","anṣārī",348],["إِلَى","kepada","ilā",18],["ٱللَّهِ ۖ","Allah","l-lahi",4],["قَالَ","berkata","qāla",10],["ٱلْحَوَارِيُّونَ","pengikut-pengikut yang setia","l-ḥawāriyūna",1316],["نَحْنُ","kami","naḥnu",140],["أَنصَارُ","penolong-penolong","anṣāru",348],["ٱللَّهِ ۖ","Allah","l-lahi",4],["فَـَٔامَنَت","maka berimanlah","faāmanat",23],["طَّآئِفَةٌۭ","segolongan","ṭāifatun",451],["مِّنۢ","dari","min",1],["بَنِىٓ","bani","banī",90],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",284],["وَكَفَرَت","dan kafir","wakafarat",48],["طَّآئِفَةٌۭ ۖ","segolongan","ṭāifatun",451],["فَأَيَّدْنَا","maka Kami beri kekuatan","fa-ayyadnā",893],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["عَلَىٰ","atas","ʿalā",11],["عَدُوِّهِمْ","musuh-musuh mereka","ʿaduwwihim",248],["فَأَصْبَحُوا۟","maka jadilah mereka","fa-aṣbaḥū",398],["ظَـٰهِرِينَ","orang-orang yang menang","ẓāhirīna",842]],"t":"Wahai orang-orang yang beriman! Jadilah kamu penolong-penolong (agama) Allah sebagaimana Isa putra Maryam telah berkata kepada pengikut-pengikutnya yang setia, \"Siapakah yang akan menjadi penolong-penolongku (untuk menegakkan agama) Allah?\" Pengikut-pengikutnya yang setia itu berkata, \"Kamilah penolong-penolong (agama) Allah,\" lalu segolongan dari Bani Israil beriman dan segolongan (yang lain) kafir; lalu Kami berikan kekuatan kepada orang-orang yang beriman terhadap musuh-musuh mereka, sehingga mereka menjadi orang-orang yang menang."}]