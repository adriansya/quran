[{"n":1,"w":[["إِذَا","apabila","idhā",23],["زُلْزِلَتِ","digoncangkan","zul'zilati",2070],["ٱلْأَرْضُ","bumi","l-arḍu",22],["زِلْزَالَهَا","goncangan","zil'zālahā",2777]],"t":"Apabila bumi diguncangkan dengan guncangan yang dahsyat,"},{"n":2,"w":[["وَأَخْرَجَتِ","dan mengeluarkan","wa-akhrajati",114],["ٱلْأَرْضُ","bumi","l-arḍu",22],["أَثْقَالَهَا","beban beratnya","athqālahā",1235]],"t":"dan bumi telah mengeluarkan beban-beban berat (yang dikandung)nya,"},{"n":3,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["مَا","apa","mā",2],["لَهَا","ia","lahā",97]],"t":"dan manusia bertanya, \"Apa yang terjadi pada bumi ini?\""},{"n":4,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["تُحَدِّثُ","ia menceritakan","tuḥaddithu",1782],["أَخْبَارَهَا","beritanya","akhbārahā",1748]],"t":"Pada hari itu bumi menyampaikan beritanya,"},{"n":5,"w":[["بِأَنَّ","karena sesungguhnya","bi-anna",30],["رَبَّكَ","Tuhanmu","rabbaka",10],["أَوْحَىٰ","talah mewahyukan/memerintahkan","awḥā",168],["لَهَا","padanya","lahā",97]],"t":"karena sesungguhnya Tuhanmu telah memerintahkan (yang sedemikian itu) padanya."},{"n":6,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["يَصْدُرُ","keluar","yaṣduru",3240],["ٱلنَّاسُ","manusia","l-nāsu",52],["أَشْتَاتًۭا","bermacam-macam","ashtātan",2101],["لِّيُرَوْا۟","untuk mereka lihat","liyuraw",291],["أَعْمَـٰلَهُمْ","amal-amal mereka","aʿmālahum",173]],"t":"Pada hari itu manusia keluar dari kuburnya dalam keadaan berkelompok-kelompok, untuk diperlihatkan kepada mereka (balasan) semua amal perbuatannya."},{"n":7,"w":[["فَمَن","maka barang siapa","faman",12],["يَعْمَلْ","dia mengerjakan/beramal","yaʿmal",44],["مِثْقَالَ","seberat","mith'qāla",983],["ذَرَّةٍ","zarrah/atom","dharratin",1124],["خَيْرًۭا","kebaikan","khayran",60],["يَرَهُۥ","dia melihatnya","yarahu",46]],"t":"Maka barangsiapa mengerjakan kebaikan seberat zarah, niscaya dia akan melihat (balasan)nya."},{"n":8,"w":[["وَمَن","dan barang siapa","waman",1