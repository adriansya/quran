[{"n":1,"w":[["إِذَا","apabila","idhā",23],["زُلْزِلَتِ","digoncangkan","zul'zilati",2096],["ٱلْأَرْضُ","bumi","l-arḍu",22],["زِلْزَالَهَا","goncangan","zil'zālahā",2825]],"t":"Apabila bumi diguncangkan dengan guncangan yang dahsyat,"},{"n":2,"w":[["وَأَخْرَجَتِ","dan mengeluarkan","wa-akhrajati",111],["ٱلْأَرْضُ","bumi","l-arḍu",22],["أَثْقَالَهَا","beban beratnya","athqālahā",1239]],"t":"dan bumi telah mengeluarkan beban-beban berat (yang dikandung)nya,"},{"n":3,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلْإِنسَـٰنُ","manusia","l-insānu",167],["مَا","apa","mā",2],["لَهَا","ia","lahā",94]],"t":"dan manusia bertanya, \"Apa yang terjadi pada bumi ini?\""},{"n":4,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["تُحَدِّثُ","ia menceritakan","tuḥaddithu",2016],["أَخْبَارَهَا","beritanya","akhbārahā",1747]],"t":"Pada hari itu bumi menyampaikan beritanya,"},{"n":5,"w":[["بِأَنَّ","karena sesungguhnya","bi-anna",30],["رَبَّكَ","Tuhanmu","rabbaka",10],["أَوْحَىٰ","talah mewahyukan/memerintahkan","awḥā",165],["لَهَا","padanya","lahā",94]],"t":"karena sesungguhnya Tuhanmu telah memerintahkan (yang sedemikian itu) padanya."},{"n":6,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["يَصْدُرُ","keluar","yaṣduru",4627],["ٱلنَّاسُ","manusia","l-nāsu",52],["أَشْتَاتًۭا","bermacam-macam","ashtātan",2149],["لِّيُرَوْا۟","untuk mereka lihat","liyuraw",287],["أَعْمَـٰلَهُمْ","amal-amal mereka","aʿmālahum",170]],"t":"Pada hari itu manusia keluar dari kuburnya dalam keadaan berkelompok-kelompok, untuk diperlihatkan kepada mereka (balasan) semua amal perbuatannya."},{"n":7,"w":[["فَمَن","maka barang siapa","faman",12],["يَعْمَلْ","dia mengerjakan/beramal","yaʿmal",44],["مِثْقَالَ","seberat","mith'qāla",984],["ذَرَّةٍ","zarrah/atom","dharratin",1133],["خَيْرًۭا","kebaikan","khayran",62],["يَرَهُۥ","dia melihatnya","yarahu",46]],"t":"Maka barangsiapa mengerjakan kebaikan seberat zarah, niscaya dia akan melihat (balasan)nya."},{"n":8,"w":[["وَمَن","dan barang siapa","waman",1