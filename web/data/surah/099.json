[{"n":1,"w":[["إِذَا","apabila","idhā",29],["زُلْزِلَتِ","digoncangkan","zul'zilati",2086],["ٱلْأَرْضُ","bumi","l-arḍu",28],["زِلْزَالَهَا","goncangan","zil'zālahā",2789]],"t":"Apabila bumi diguncangkan dengan guncangan yang dahsyat,"},{"n":2,"w":[["وَأَخْرَجَتِ","dan mengeluarkan","wa-akhrajati",125],["ٱلْأَرْضُ","bumi","l-arḍu",28],["أَثْقَالَهَا","beban beratnya","athqālahā",1252]],"t":"dan bumi telah mengeluarkan beban-beban berat (yang dikandung)nya,"},{"n":3,"w":[["وَقَالَ","dan berkata","waqāla",10],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["مَا","apa","mā",6],["لَهَا","ia","lahā",106]],"t":"dan manusia bertanya, \"Apa yang terjadi pada bumi ini?\""},{"n":4,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["تُحَدِّثُ","ia menceritakan","tuḥaddithu",1805],["أَخْبَارَهَا","beritanya","akhbārahā",1771]],"t":"Pada hari itu bumi menyampaikan beritanya,"},{"n":5,"w":[["بِأَنَّ","karena sesungguhnya","bi-anna",36],["رَبَّكَ","Tuhanmu","rabbaka",15],["أَوْحَىٰ","talah mewahyukan/memerintahkan","awḥā",179],["لَهَا","padanya","lahā",106]],"t":"karena sesungguhnya Tuhanmu telah memerintahkan (yang sedemikian itu) padanya."},{"n":6,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["يَصْدُرُ","keluar","yaṣduru",3251],["ٱلنَّاسُ","manusia","l-nāsu",60],["أَشْتَاتًۭا","bermacam-macam","ashtātan",2116],["لِّيُرَوْا۟","untuk mereka lihat","liyuraw",305],["أَعْمَـٰلَهُمْ","amal-amal mereka","aʿmālahum",184]],"t":"Pada hari itu manusia keluar dari kuburnya dalam keadaan berkelompok-kelompok, untuk diperlihatkan kepada mereka (balasan) semua amal perbuatannya."},{"n":7,"w":[["فَمَن","maka barang siapa","faman",17],["يَعْمَلْ","dia mengerjakan/beramal","yaʿmal",52],["مِثْقَالَ","seberat","mith'qāla",1000],["ذَرَّةٍ","zarrah/atom","dharratin",1141],["خَيْرًۭا","kebaikan","khayran",69],["يَرَهُۥ","dia melihatnya","yarahu",54]],"t":"Maka barangsiapa mengerjakan kebaikan seberat zarah, niscaya dia akan melihat (balasan)nya."},{"n":8,"w":[["وَمَن","dan barang siapa","wama