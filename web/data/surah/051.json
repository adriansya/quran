[{"n":1,"w":[["وَٱلذَّٰرِيَـٰتِ","demi yang menerbangkan","wal-dhāriyāti",2894],["ذَرْوًۭا","dengan menerbangkan sekuat-kuatnya","dharwan",2891]],"t":"Demi (angin) yang menerbangkan debu,"},{"n":2,"w":[["فَٱلْحَـٰمِلَـٰتِ","maka yang mengandung","fal-ḥāmilāti",2273],["وِقْرًۭا","beban berat","wiq'ran",4511]],"t":"dan awan yang mengandung (hujan),"},{"n":3,"w":[["فَٱلْجَـٰرِيَـٰتِ","maka yang berlayar","fal-jāriyāti",3554],["يُسْرًۭا","dengan mudah","yus'ran",1130]],"t":"dan (kapal-kapal) yang berlayar dengan mudah,"},{"n":4,"w":[["فَٱلْمُقَسِّمَـٰتِ","maka yang membagi","fal-muqasimāti",3857],["أَمْرًا","pekara/urusan","amran",75]],"t":"dan (malaikat-malaikat) yang membagi-bagi urusan,"},{"n":5,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["تُوعَدُونَ","kamu dijanjikan","tūʿadūna",190],["لَصَادِقٌۭ","pasti benar","laṣādiqun",211]],"t":"sungguh, apa yang dijanjikan kepadamu pasti benar,"},{"n":6,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",9],["ٱلدِّينَ","pembalasan","l-dīna",130],["لَوَٰقِعٌۭ","pasti terjadi","lawāqiʿun",1255]],"t":"dan sungguh, (hari) pembalasan pasti terjadi."},{"n":7,"w":[["وَٱلسَّمَآءِ","demi langit","wal-samāi",44],["ذَاتِ","mempunyai","dhāti",112],["ٱلْحُبُكِ","jalan-jalan","l-ḥubuki",3209]],"t":"Demi langit yang mempunyai jalan-jalan,"},{"n":8,"w":[["إِنَّكُمْ","sesungguhnya kalian","innakum",9],["لَفِى","benar-benar dalam","lafī",7],["قَوْلٍۢ","perkataan","qawlin",129],["مُّخْتَلِفٍۢ","berbeda-beda","mukh'talifin",866]],"t":"sungguh, kamu benar-benar dalam keadaan berbeda-beda pendapat,"},{"n":9,"w":[["يُؤْفَكُ","dipalingkan","yu'faku",599],["عَنْهُ","darinya","ʿanhu",27],["مَنْ","orang yang","man",17],["أُفِكَ","dipalingkan","ufika",599]],"t":"dipalingkan darinya (Alquran dan Rasul) orang yang dipalingkan."},{"n":10,"w":[["قُتِلَ","dibunuh","qutila",149],["ٱلْخَرَّٰصُونَ","orang-orang yang banyak berdusta","l-kharāṣūna",4552]],"t":"Terkutuklah orang-orang yang banyak berdusta,"},{"n":11,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["هُمْ","mereka","hum",16],["فِى","dalam","fī",7],["غَمْرَةٍۢ","kebodohan","ghamratin",1868],["سَاهُونَ","orang-orang yang lalai","sāhūna",2645]],"t":"(yaitu) orang-orang yang terbenam dalam kebodohan dan kelalaian,"},{"n":12,"w":[["يَسْـَٔلُونَ","mereka bertanya","yasalūna",119],["أَيَّانَ","kapankah","ayyāna",1155],["يَوْمُ","hari","yawmu",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"mereka bertanya, \"Kapankah hari pembalasan itu?\""},{"n":13,"w":[["يَوْمَ","pada hari","yawma",31],["هُمْ","mereka","hum",16],["عَلَى","di atas","ʿalā",11],["ٱلنَّارِ","neraka","l-nāri",87],["يُفْتَنُونَ","mereka disiksa","yuf'tanūna",464]],"t":"(Hari pembalasan itu ialah) pada hari (ketika) mereka diazab di dalam api neraka."},{"n":14,"w":[["ذُوقُوا۟","rasakanlah","dhūqū",339],["فِتْنَتَكُمْ","siksaanmu","fit'natakum",355],["هَـٰذَا","ini","hādhā",64],["ٱلَّذِى","yang","alladhī",45],["كُنتُم","kalian adalah","kuntum",12],["بِهِۦ","dengannya","bihi",21],["تَسْتَعْجِلُونَ","kamu minta disegerakan","tastaʿjilūna",547]],"t":"(Dikatakan kepada mereka), \"Rasakanlah azabmu itu. Inilah azab yang dahulu kamu minta agar disegerakan.\""},{"n":15,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",257],["فِى","dalam","fī",7],["جَنَّـٰتٍۢ","surga","jannātin",86],["وَعُيُونٍ","dan mata air","waʿuyūnin",218]],"t":"Sesungguhnya orang-orang yang bertakwa berada di dalam taman-taman (surga) dan mata air,"},{"n":16,"w":[["ءَاخِذِينَ","mereka mengambil","ākhidhīna",1779],["مَآ","apa yang","mā",6],["ءَاتَىٰهُمْ","memberikan pada mereka","ātāhum",53],["رَبُّهُمْ ۚ","Tuhan mereka","rabbuhum",15],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["قَبْلَ","sebelum","qabla",59],["ذَٰلِكَ","demikian itu","dhālika",26],["مُحْسِنِينَ","orang-orang yang berbuat baik","muḥ'sinīna",321]],"t":"mereka mengambil apa yang diberikan Tuhan kepada mereka. Sesungguhnya mereka sebelum itu (di dunia) adalah orang-orang yang berbuat baik;"},{"n":17,"w":[["كَانُوا۟","adalah mereka","kānū",12],["قَلِيلًۭا","sedikit","qalīlan",186],["مِّنَ","dari/di waktu","mina",1],["ٱلَّيْلِ","malam","al-layli",146],["مَا","tidak","mā",6],["يَهْجَعُونَ","mereka tidur","yahjaʿūna",3526]],"t":"mereka sedikit sekali tidur pada waktu malam;"},{"n":18,"w":[["وَبِٱلْأَسْحَارِ","dan di waktu sahur","wabil-asḥāri",2014],["هُمْ","mereka","hum",16],["يَسْتَغْفِرُونَ","mereka mohon ampun","yastaghfirūna",314]],"t":"dan pada akhir malam mereka memohon ampunan (kepada Allah)."},{"n":19,"w":[["وَفِىٓ","dan dalam","wafī",7],["أَمْوَٰلِهِمْ","harta mereka","amwālihim",141],["حَقٌّۭ","hak","ḥaqqun",58],["لِّلسَّآئِلِ","untuk orang yang meminta","lilssāili",1115],["وَٱلْمَحْرُومِ","dan orang yang tidak meminta","wal-maḥrūmi",1601]],"t":"Dan pada harta benda mereka ada hak untuk orang miskin yang meminta, dan orang miskin yang tidak meminta."},{"n":20,"w":[["وَفِى","dan di","wafī",7],["ٱلْأَرْضِ","bumi itu","l-arḍi",28],["ءَايَـٰتٌۭ","tanda-tanda","āyātun",34],["لِّلْمُوقِنِينَ","bagi orang-orang yang yakin","lil'mūqinīna",1403]],"t":"Dan di bumi terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang yakin,"},{"n":21,"w":[["وَفِىٓ","dan pada","wafī",7],["أَنفُسِكُمْ ۚ","diri kalian sendiri","anfusikum",47],["أَفَلَا","maka apakah tidak","afalā",8],["تُبْصِرُونَ","kamu memperhatikan","tub'ṣirūna",390]],"t":"dan (juga) pada dirimu sendiri. Maka apakah kamu tidak memperhatikan?"},{"n":22,"w":[["وَفِى","dan di","wafī",7],["ٱلسَّمَآءِ","langit","l-samāi",44],["رِزْقُكُمْ","rezekimu","riz'qukum",231],["وَمَا","dan apa yang","wamā",6],["تُوعَدُونَ","dijanjikan padamu","tūʿadūna",190]],"t":"Dan di langit terdapat (sebab-sebab) rezekimu dan apa yang dijanjikan kepadamu."},{"n":23,"w":[["فَوَرَبِّ","demi Tuhan","fawarabbi",15],["ٱلسَّمَآءِ","langit","l-samāi",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["إِنَّهُۥ","sesungguhnya","innahu",9],["لَحَقٌّۭ","sungguh benar","laḥaqqun",58],["مِّثْلَ","seperti","mith'la",168],["مَآ","apa","mā",6],["أَنَّكُمْ","bahwasanya kamu","annakum",36],["تَنطِقُونَ","kamu ucapkan","tanṭiqūna",935]],"t":"Maka demi Tuhan langit dan bumi, sungguh, apa yang dijanjikan itu pasti terjadi seperti apa yang kamu ucapkan."},{"n":24,"w":[["هَلْ","apakah","hal",128],["أَتَىٰكَ","telah sampai kepadamu","atāka",56],["حَدِيثُ","cerita","ḥadīthu",402],["ضَيْفِ","tamu","ḍayfi",1300],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",192],["ٱلْمُكْرَمِينَ","orang-orang yang dimuliakan","l-muk'ramīna",1401]],"t":"Sudahkah sampai kepadamu (Muhammad) cerita tamu Ibrahim (malaikat-malaikat) yang dimuliakan?"},{"n":25,"w":[["إِذْ","ketika","idh",61],["دَخَلُوا۟","mereka masuk","dakhalū",165],["عَلَيْهِ","atasnya","ʿalayhi",11],["فَقَالُوا۟","lalu mereka berkata","faqālū",10],["سَلَـٰمًۭا ۖ","selamat","salāman",294],["قَالَ","berkata","qāla",10],["سَلَـٰمٌۭ","selamat","salāmun",294],["قَوْمٌۭ","kaum","qawmun",33],["مُّنكَرُونَ","orang-orang yang tidak dikenal","munkarūna",563]],"t":"(Ingatlah) ketika mereka masuk ke tempatnya lalu mengucapkan, \"Salāman (salam)\", Ibrahim menjawab, \"Salāmun (salam)\". (Mereka itu) orang-orang yang belum dikenalnya."},{"n":26,"w":[["فَرَاغَ","lalu dia pergi diam-diam","farāgha",1997],["إِلَىٰٓ","kepada","ilā",18],["أَهْلِهِۦ","keluarganya","ahlihi",102],["فَجَآءَ","lalu dia datang/membawa","fajāa",51],["بِعِجْلٍۢ","dengan anak sapi","biʿij'lin",834],["سَمِينٍۢ","gemuk","samīnin",2019]],"t":"Maka diam-diam dia (Ibrahim) pergi menemui keluarganya, kemudian dibawanya daging anak sapi gemuk (yang dibakar),"},{"n":27,"w":[["فَقَرَّبَهُۥٓ","lalu dihidangkannya","faqarrabahu",1415],["إِلَيْهِمْ","kepada mereka","ilayhim",18],["قَالَ","(Ibrahim)berkata","qāla",10],["أَلَا","mengapa tidak","alā",8],["تَأْكُلُونَ","kamu makan","takulūna",127]],"t":"lalu dihidangkannya kepada mereka (tetapi mereka tidak mau makan). Ibrahim berkata, \"Mengapa tidak kamu makan.\""},{"n":28,"w":[["فَأَوْجَسَ","maka dia merasa","fa-awjasa",1771],["مِنْهُمْ","dari mereka","min'hum",1],["خِيفَةًۭ ۖ","takut","khīfatan",1266],["قَالُوا۟","mereka berkata","qālū",10],["لَا","jangan","lā",8],["تَخَفْ ۖ","kamu takut","takhaf",150],["وَبَشَّرُوهُ","dan mereka memberi kabar gembira","wabasharūhu",326],["بِغُلَـٰمٍ","dengan seorang anak","bighulāmin",701],["عَلِيمٍۢ","pandai","ʿalīmin",77]],"t":"Maka dia (Ibrahim) merasa takut terhadap mereka. Mereka berkata, \"Janganlah kamu takut,\" dan mereka memberi kabar gembira kepadanya dengan (kelahiran) seorang anak yang alim (Ishak)."},{"n":29,"w":[["فَأَقْبَلَتِ","maka menghadap/datang","fa-aqbalati",892],["ٱمْرَأَتُهُۥ","isterinya","im'ra-atuhu",433],["فِى","dalam","fī",7],["صَرَّةٍۢ","teriakan","ṣarratin",3270],["فَصَكَّتْ","lalu ia menampar","faṣakkat",3262],["وَجْهَهَا","mukanya","wajhahā",180],["وَقَالَتْ","dan berkata","waqālat",10],["عَجُوزٌ","seorang perempuan tua","ʿajūzun",1513],["عَقِيمٌۭ","mandul","ʿaqīmun",1518]],"t":"Kemudian istrinya datang memekik (tercengang) lalu menepuk wajahnya sendiri seraya bekata, \"(Aku ini) seorang perempuan tua yang mandul.\""},{"n":30,"w":[["قَالُوا۟","mereka berkata","qālū",10],["كَذَٰلِكِ","demikianlah","kadhāliki",26],["قَالَ","berfirman","qāla",10],["رَبُّكِ ۖ","Tuhanmu","rabbuki",15],["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["هُوَ","Dia","huwa",25],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",126],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",77]],"t":"Mereka berkata, \"Demikianlah Tuhanmu berfirman. Sungguh, Dialah Yang Mahabijaksana, Maha Mengetahui.\""},{"n":31,"w":[["۞ قَالَ","(Ibrahim)berkata","qāla",10],["فَمَا","maka apakah","famā",6],["خَطْبُكُمْ","pembicaraanmu","khaṭbukum",1446],["أَيُّهَا","wahai","ayyuhā",83],["ٱلْمُرْسَلُونَ","para utusan","l-mur'salūna",341]],"t":"Dia (Ibrahim) berkata, \"Apakah urusanmu yang penting wahai para utusan?\""},{"n":32,"w":[["قَالُوٓا۟","mereka berkata","qālū",10],["إِنَّآ","sesungguhnya kami","innā",9],["أُرْسِلْنَآ","kami di utus","ur'sil'nā",100],["إِلَىٰ","kepada","ilā",18],["قَوْمٍۢ","kaum","qawmin",33],["مُّجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",240]],"t":"Mereka menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa (kaum Luṭ),"},{"n":33,"w":[["لِنُرْسِلَ","agar kami kirimkan","linur'sila",100],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["حِجَارَةًۭ","batu-batu","ḥijāratan",836],["مِّن","dari","min",1],["طِينٍۢ","tanah","ṭīnin",741]],"t":"agar kami menimpa mereka dengan batu-batu dari tanah (yang keras),"},{"n":34,"w":[["مُّسَوَّمَةً","yang ditandai","musawwamatan",1964],["عِندَ","di sisi","ʿinda",68],["رَبِّكَ","Tuhanmu","rabbika",15],["لِلْمُسْرِفِينَ","untuk orang-orang yang melampaui batas","lil'mus'rifīna",646]],"t":"yang ditandai dari Tuhanmu untuk (membinasakan) orang-orang yang melampaui batas.\""},{"n":35,"w":[["فَأَخْرَجْنَا","maka Kami keluarkan","fa-akhrajnā",125],["مَن","orang yang","man",17],["كَانَ","adalah","kāna",12],["فِيهَا","didalamnya","fīhā",7],["مِنَ","dari","mina",1],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",63]],"t":"Lalu Kami keluarkan orang-orang yang beriman yang berada di dalamnya (negeri kaum Luṭ)."},{"n":36,"w":[["فَمَا","maka tidak","famā",6],["وَجَدْنَا","kami dapati","wajadnā",120],["فِيهَا","didalamnya","fīhā",7],["غَيْرَ","selain","ghayra",85],["بَيْتٍۢ","sebuah rumah","baytin",196],["مِّنَ","dari","mina",1],["ٱلْمُسْلِمِينَ","orang-orang yang berserah diri","l-mus'limīna",292]],"t":"Maka Kami tidak mendapati di dalamnya (negeri itu), kecuali satu rumah dari orang-orang muslim (Luṭ)."},{"n":37,"w":[["وَتَرَكْنَا","dan kami tinggalkan","wataraknā",308],["فِيهَآ","didalamnya","fīhā",7],["ءَايَةًۭ","tanda-tanda","āyatan",34],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["يَخَافُونَ","mereka takut","yakhāfūna",150],["ٱلْعَذَابَ","azab","l-ʿadhāba",43],["ٱلْأَلِيمَ","pedih","l-alīma",178]],"t":"Dan Kami tinggalkan padanya (negeri itu) suatu tanda bagi orang-orang yang takut kepada azab yang pedih."},{"n":38,"w":[["وَفِى","dan pada","wafī",7],["مُوسَىٰٓ","Musa","mūsā",94],["إِذْ","ketika","idh",61],["أَرْسَلْنَـٰهُ","Kami mengutusnya","arsalnāhu",100],["إِلَىٰ","kepada","ilā",18],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/mu'jizat","bisul'ṭānin",338],["مُّبِينٍۢ","nyata","mubīnin",111]],"t":"Dan pada Musa (terdapat tanda-tanda kekuasaan Allah) ketika Kami mengutusnya kepada Fir'aun dengan membawa mukjizat yang nyata."},{"n":39,"w":[["فَتَوَلَّىٰ","maka dia berpaling","fatawallā",160],["بِرُكْنِهِۦ","dengan kekuatannya","biruk'nihi",2635],["وَقَالَ","dan dia berkata","waqāla",10],["سَـٰحِرٌ","seorang tukang sihir","sāḥirun",486],["أَوْ","atau","aw",50],["مَجْنُونٌۭ","seorang gila","majnūnun",801]],"t":"Tetapi dia (Fir'aun) bersama bala tentaranya berpaling dan berkata, \"Dia adalah seorang pesihir atau orang gila.\""},{"n":40,"w":[["فَأَخَذْنَـٰهُ","maka Kami ambil/siksa dia","fa-akhadhnāhu",103],["وَجُنُودَهُۥ","dan bala tentaranya","wajunūdahu",394],["فَنَبَذْنَـٰهُمْ","lalu Kami lemparkan mereka","fanabadhnāhum",868],["فِى","ke dalam","fī",7],["ٱلْيَمِّ","laut","l-yami",1029],["وَهُوَ","dan dia","wahuwa",25],["مُلِيمٌۭ","seorang tercela","mulīmun",2516]],"t":"Maka Kami siksa dia beserta bala tentaranya, lalu Kami lemparkan mereka ke dalam laut, dalam keadaan tercela."},{"n":41,"w":[["وَفِى","dan pada","wafī",7],["عَادٍ","'Ad","ʿādin",449],["إِذْ","ketika","idh",61],["أَرْسَلْنَا","Kami kirimkan","arsalnā",100],["عَلَيْهِمُ","atas mereka","ʿalayhimu",11],["ٱلرِّيحَ","angin","l-rīḥa",397],["ٱلْعَقِيمَ","membinasakan","l-ʿaqīma",1518]],"t":"Dan (juga) pada (kisah kaum) 'Ād, ketika Kami kirimkan kepada mereka angin yang membinasakan,"},{"n":42,"w":[["مَا","tidak","mā",6],["تَذَرُ","membiarkan","tadharu",276],["مِن","dari","min",1],["شَىْءٍ","sesuatu","shayin",49],["أَتَتْ","ia datang","atat",56],["عَلَيْهِ","atasnya","ʿalayhi",11],["إِلَّا","kecuali","illā",20],["جَعَلَتْهُ","ia jadikannya","jaʿalathu",40],["كَٱلرَّمِيمِ","seperti abu/hancur","kal-ramīmi",2630]],"t":"(angin itu) tidak membiarkan suatu apa pun yang dilandanya, bahkan dijadikannya seperti serbuk."},{"n":43,"w":[["وَفِى","dan pada","wafī",7],["ثَمُودَ","kaum Tsamud","thamūda",430],["إِذْ","ketika","idh",61],["قِيلَ","dikatakan","qīla",10],["لَهُمْ","kepada mereka","lahum",16],["تَمَتَّعُوا۟","bersenang-senanglah","tamattaʿū",816],["حَتَّىٰ","sehingga","ḥattā",91],["حِينٍۢ","suatu waktu","ḥīnin",345]],"t":"Dan pada (kisah kaum) Samud, ketika dikatakan kepada mereka, \"Bersenang-senanglah kamu sampai waktu yang ditentukan.\""},{"n":44,"w":[["فَعَتَوْا۟","maka mereka angkuh","faʿataw",1310],["عَنْ","dari","ʿan",27],["أَمْرِ","perintah","amri",75],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["فَأَخَذَتْهُمُ","maka menyambar","fa-akhadhathumu",103],["ٱلصَّـٰعِقَةُ","petir","l-ṣāʿiqatu",978],["وَهُمْ","sedang mereka","wahum",16],["يَنظُرُونَ","mereka melihat","yanẓurūna",139]],"t":"Lalu mereka berlaku angkuh terhadap perintah Tuhannya, maka mereka disambar petir sedang mereka melihatnya."},{"n":45,"w":[["فَمَا","maka tidak","famā",6],["ٱسْتَطَـٰعُوا۟","mereka kuasa","is'taṭāʿū",296],["مِن","dari","min",1],["قِيَامٍۢ","berdiri/bangun","qiyāmin",483],["وَمَا","dan tidak ada","wamā",6],["كَانُوا۟","adalah mereka","kānū",12],["مُنتَصِرِينَ","mendapat pertolongan","muntaṣirīna",1632]],"t":"Maka mereka tidak mampu bangun dan juga tidak mendapat pertolongan,"},{"n":46,"w":[["وَقَوْمَ","dan kaum","waqawma",33],["نُوحٍۢ","Nuh","nūḥin",287],["مِّن","dari","min",1],["قَبْلُ ۖ","sebelum itu","qablu",59],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["قَوْمًۭا","kaum","qawman",33],["فَـٰسِقِينَ","orang-orang yang fasik","fāsiqīna",334]],"t":"dan sebelum itu (telah Kami binasakan) kaum Nuh. Sungguh, mereka adalah kaum yang fasik."},{"n":47,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",44],["بَنَيْنَـٰهَا","Kami bangun ia","banaynāhā",792],["بِأَيْي۟دٍۢ","dengan kekuasaan","bi-aydin",2207],["وَإِنَّا","dan sesungguhnya Kami","wa-innā",9],["لَمُوسِعُونَ","benar-benar luas","lamūsiʿūna",2532]],"t":"Dan langit Kami bangun dengan kekuasaan (Kami), dan Kami benar-benar meluaskannya."},{"n":48,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["فَرَشْنَـٰهَا","Kami hamparkannya","farashnāhā",3442],["فَنِعْمَ","maka sebaik-baik","faniʿ'ma",565],["ٱلْمَـٰهِدُونَ","yang menghamparkan","l-māhidūna",3696]],"t":"Dan bumi telah Kami hamparkan; maka (Kami) sebaik-baik yang menghamparkan."},{"n":49,"w":[["وَمِن","dan dari","wamin",1],["كُلِّ","segala","kulli",38],["شَىْءٍ","sesuatu","shayin",49],["خَلَقْنَا","Kami ciptakan","khalaqnā",70],["زَوْجَيْنِ","berpasang-pasangan","zawjayni",166],["لَعَلَّكُمْ","agar kalian","laʿallakum",101],["تَذَكَّرُونَ","kamu ingat","tadhakkarūna",245]],"t":"Dan segala sesuatu Kami ciptakan berpasang-pasangan agar kamu mengingat (kebesaran Allah)."},{"n":50,"w":[["فَفِرُّوٓا۟","maka segeralah","fafirrū",1194],["إِلَى","kepada","ilā",18],["ٱللَّهِ ۖ","Allah","l-lahi",4],["إِنِّى","sesungguhnya aku","innī",9],["لَكُم","bagi kalian","lakum",32],["مِّنْهُ","daripada-Nya","min'hu",1],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",216],["مُّبِينٌۭ","nyata","mubīnun",111]],"t":"Maka segeralah kembali kepada (menaati) Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu."},{"n":51,"w":[["وَلَا","dan jangan","walā",8],["تَجْعَلُوا۟","kalian jadikan","tajʿalū",40],["مَعَ","beserta","maʿa",78],["ٱللَّهِ","Allah","l-lahi",4],["إِلَـٰهًا","Tuhan","ilāhan",84],["ءَاخَرَ ۖ","lain","ākhara",187],["إِنِّى","sesungguhnya aku","innī",9],["لَكُم","bagi kalian","lakum",32],["مِّنْهُ","darinya","min'hu",1],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",216],["مُّبِينٌۭ","nyata","mubīnun",111]],"t":"Dan janganlah kamu mengadakan tuhan yang lain selain Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu."},{"n":52,"w":[["كَذَٰلِكَ","demikianlah","kadhālika",26],["مَآ","tidak","mā",6],["أَتَى","datang","atā",56],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["قَبْلِهِم","sebelum mereka","qablihim",59],["مِّن","dari","min",1],["رَّسُولٍ","seorang rasul","rasūlin",42],["إِلَّا","kecuali","illā",20],["قَالُوا۟","mereka berkata","qālū",10],["سَاحِرٌ","seorang tukang sihir","sāḥirun",486],["أَوْ","atau","aw",50],["مَجْنُونٌ","seorang gila","majnūnun",801]],"t":"Demikianlah setiap kali seorang rasul yang datang kepada orang-orang yang sebelum mereka, mereka (kaumnya) pasti mengatakan, \"Dia itu pesihir atau orang gila.\""},{"n":53,"w":[["أَتَوَاصَوْا۟","apakah mereka saling berwasiat","atawāṣaw",1434],["بِهِۦ ۚ","tentang itu","bihi",21],["بَلْ","bahkan","bal",105],["هُمْ","mereka","hum",16],["قَوْمٌۭ","kaum","qawmun",33],["طَاغُونَ","melampaui batas","ṭāghūna",1175]],"t":"Apakah mereka saling berpesan tentang apa yang dikatakan itu. Sebenarnya mereka adalah kaum yang melampaui batas."},{"n":54,"w":[["فَتَوَلَّ","maka berpalinglah kamu","fatawalla",160],["عَنْهُمْ","dari mereka","ʿanhum",27],["فَمَآ","maka tidaklah","famā",6],["أَنتَ","kamu","anta",154],["بِمَلُومٍۢ","orang-orang yang tercela","bimalūmin",1381]],"t":"Maka berpalinglah engkau dari mereka, dan engkau sama sekali tidak tercela."},{"n":55,"w":[["وَذَكِّرْ","dan berilah peringatan","wadhakkir",549],["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱلذِّكْرَىٰ","peringatan itu","l-dhik'rā",458],["تَنفَعُ","memberi manfaat","tanfaʿu",378],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",63]],"t":"Dan tetaplah memberi peringatan, karena sesungguhnya peringatan itu bermanfaat bagi orang-orang mukmin."},{"n":56,"w":[["وَمَا","dan tidaklah","wamā",6],["خَلَقْتُ","Aku menciptakan","khalaqtu",70],["ٱلْجِنَّ","jin","l-jina",478],["وَٱلْإِنسَ","dan manusia","wal-insa",550],["إِلَّا","kecuali","illā",20],["لِيَعْبُدُونِ","supaya mereka menyembah-Ku","liyaʿbudūni",108]],"t":"Aku tidak menciptakan jin dan manusia melainkan agar mereka beribadah kepada-Ku."},{"n":57,"w":[["مَآ","tidak","mā",6],["أُرِيدُ","Aku menghendaki","urīdu",92],["مِنْهُم","dari mereka","min'hum",1],["مِّن","dari","min",1],["رِّزْقٍۢ","rezeki","riz'qin",231],["وَمَآ","dan tidak","wamā",6],["أُرِيدُ","Aku menghendaki","urīdu",92],["أَن","supaya","an",22],["يُطْعِمُونِ","mereka memberi Aku makan","yuṭ'ʿimūni",688]],"t":"Aku tidak menghendaki rezeki sedikit pun dari mereka dan Aku tidak menghendaki agar mereka memberi makan kepada-Ku."},{"n":58,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["هُوَ","Dia","huwa",25],["ٱلرَّزَّاقُ","Maha Pemberi rezeki","l-razāqu",4223],["ذُو","mempunyai","dhū",112],["ٱلْقُوَّةِ","kekuatan","l-quwati",386],["ٱلْمَتِينُ","teguh/kokoh","l-matīnu",1921]],"t":"Sungguh Allah, Dialah Pemberi rezeki yang mempunyai kekuatan lagi sangat kokoh."},{"n":59,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",9],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["ظَلَمُوا۟","zalim","ẓalamū",117],["ذَنُوبًۭا","bahagian(siksa)","dhanūban",2125],["مِّثْلَ","seperti","mith'la",168],["ذَنُوبِ","bahagian(siksa)","dhanūbi",2125],["أَصْحَـٰبِهِمْ","teman-teman mereka","aṣḥābihim",132],["فَلَا","maka jangan","falā",8],["يَسْتَعْجِلُونِ","mereka meminta disegerakan kepada-Ku","yastaʿjilūni",547]],"t":"Maka sungguh, untuk orang-orang yang zalim ada bagian (azab) seperti bagian teman-teman mereka (dahulu); maka janganlah mereka meminta kepada-Ku untuk menyegerakannya."},{"n":60,"w":[["فَوَيْلٌۭ","maka kecelakaanlah","fawaylun",311],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["مِن","dari","min",1],["يَوْمِهِمُ","pada hari mereka","yawmihimu",31],["ٱلَّذِى","yang","alladhī",45],["يُوعَدُونَ","mereka diancam","yūʿadūna",190]],"t":"Maka celakalah orang-orang yang kafir pada hari yang telah dijanjikan kepada mereka (hari Kiamat)."}]