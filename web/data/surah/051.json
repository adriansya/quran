[{"n":1,"w":[["وَٱلذَّٰرِيَـٰتِ","demi yang menerbangkan","wal-dhāriyāti",2919],["ذَرْوًۭا","dengan menerbangkan sekuat-kuatnya","dharwan",2915]],"t":"Demi (angin) yang menerbangkan debu,"},{"n":2,"w":[["فَٱلْحَـٰمِلَـٰتِ","maka yang mengandung","fal-ḥāmilāti",3176],["وِقْرًۭا","beban berat","wiq'ran",4558]],"t":"dan awan yang mengandung (hujan),"},{"n":3,"w":[["فَٱلْجَـٰرِيَـٰتِ","maka yang berlayar","fal-jāriyāti",3526],["يُسْرًۭا","dengan mudah","yus'ran",1120]],"t":"dan (kapal-kapal) yang berlayar dengan mudah,"},{"n":4,"w":[["فَٱلْمُقَسِّمَـٰتِ","maka yang membagi","fal-muqasimāti",3846],["أَمْرًا","pekara/urusan","amran",66]],"t":"dan (malaikat-malaikat) yang membagi-bagi urusan,"},{"n":5,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["تُوعَدُونَ","kamu dijanjikan","tūʿadūna",176],["لَصَادِقٌۭ","pasti benar","laṣādiqun",201]],"t":"sungguh, apa yang dijanjikan kepadamu pasti benar,"},{"n":6,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلدِّينَ","pembalasan","l-dīna",116],["لَوَٰقِعٌۭ","pasti terjadi","lawāqiʿun",1241]],"t":"dan sungguh, (hari) pembalasan pasti terjadi."},{"n":7,"w":[["وَٱلسَّمَآءِ","demi langit","wal-samāi",38],["ذَاتِ","mempunyai","dhāti",113],["ٱلْحُبُكِ","jalan-jalan","l-ḥubuki",3216]],"t":"Demi langit yang mempunyai jalan-jalan,"},{"n":8,"w":[["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["لَفِى","benar-benar dalam","lafī",3],["قَوْلٍۢ","perkataan","qawlin",117],["مُّخْتَلِفٍۢ","berbeda-beda","mukh'talifin",852]],"t":"sungguh, kamu benar-benar dalam keadaan berbeda-beda pendapat,"},{"n":9,"w":[["يُؤْفَكُ","dipalingkan","yu'faku",589],["عَنْهُ","darinya","ʿanhu",21],["مَنْ","orang yang","man",12],["أُفِكَ","dipalingkan","ufika",589]],"t":"dipalingkan darinya (Alquran dan Rasul) orang yang dipalingkan."},{"n":10,"w":[["قُتِلَ","dibunuh","qutila",135],["ٱلْخَرَّٰصُونَ","orang-orang yang banyak berdusta","l-kharāṣūna",4591]],"t":"Terkutuklah orang-orang yang banyak berdusta,"},{"n":11,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["هُمْ","mereka","hum",11],["فِى","dalam","fī",3],["غَمْرَةٍۢ","kebodohan","ghamratin",1845],["سَاهُونَ","orang-orang yang lalai","sāhūna",2619]],"t":"(yaitu) orang-orang yang terbenam dalam kebodohan dan kelalaian,"},{"n":12,"w":[["يَسْـَٔلُونَ","mereka bertanya","yasalūna",105],["أَيَّانَ","kapankah","ayyāna",1144],["يَوْمُ","hari","yawmu",25],["ٱلدِّينِ","pembalasan","l-dīni",116]],"t":"mereka bertanya, \"Kapankah hari pembalasan itu?\""},{"n":13,"w":[["يَوْمَ","pada hari","yawma",25],["هُمْ","mereka","hum",11],["عَلَى","di atas","ʿalā",8],["ٱلنَّارِ","neraka","l-nāri",77],["يُفْتَنُونَ","mereka disiksa","yuf'tanūna",454]],"t":"(Hari pembalasan itu ialah) pada hari (ketika) mereka diazab di dalam api neraka."},{"n":14,"w":[["ذُوقُوا۟","rasakanlah","dhūqū",322],["فِتْنَتَكُمْ","siksaanmu","fit'natakum",339],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang","alladhī",7],["كُنتُم","kalian adalah","kuntum",9],["بِهِۦ","dengannya","bihi",16],["تَسْتَعْجِلُونَ","kamu minta disegerakan","tastaʿjilūna",535]],"t":"(Dikatakan kepada mereka), \"Rasakanlah azabmu itu. Inilah azab yang dahulu kamu minta agar disegerakan.\""},{"n":15,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",244],["فِى","dalam","fī",3],["جَنَّـٰتٍۢ","surga","jannātin",76],["وَعُيُونٍ","dan mata air","waʿuyūnin",207]],"t":"Sesungguhnya orang-orang yang bertakwa berada di dalam taman-taman (surga) dan mata air,"},{"n":16,"w":[["ءَاخِذِينَ","mereka mengambil","ākhidhīna",1755],["مَآ","apa yang","mā",2],["ءَاتَىٰهُمْ","memberikan pada mereka","ātāhum",45],["رَبُّهُمْ ۚ","Tuhan mereka","rabbuhum",10],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["قَبْلَ","sebelum","qabla",51],["ذَٰلِكَ","demikian itu","dhālika",19],["مُحْسِنِينَ","orang-orang yang berbuat baik","muḥ'sinīna",308]],"t":"mereka mengambil apa yang diberikan Tuhan kepada mereka. Sesungguhnya mereka sebelum itu (di dunia) adalah orang-orang yang berbuat baik;"},{"n":17,"w":[["كَانُوا۟","adalah mereka","kānū",9],["قَلِيلًۭا","sedikit","qalīlan",173],["مِّنَ","dari/di waktu","mina",0],["ٱلَّيْلِ","malam","al-layli",132],["مَا","tidak","mā",2],["يَهْجَعُونَ","mereka tidur","yahjaʿūna",4649]],"t":"mereka sedikit sekali tidur pada waktu malam;"},{"n":18,"w":[["وَبِٱلْأَسْحَارِ","dan di waktu sahur","wabil-asḥāri",1984],["هُمْ","mereka","hum",11],["يَسْتَغْفِرُونَ","mereka mohon ampun","yastaghfirūna",296]],"t":"dan pada akhir malam mereka memohon ampunan (kepada Allah)."},{"n":19,"w":[["وَفِىٓ","dan dalam","wafī",3],["أَمْوَٰلِهِمْ","harta mereka","amwālihim",127],["حَقٌّۭ","hak","ḥaqqun",50],["لِّلسَّآئِلِ","untuk orang yang meminta","lilssāili",1101],["وَٱلْمَحْرُومِ","dan orang yang tidak meminta","wal-maḥrūmi",1574]],"t":"Dan pada harta benda mereka ada hak untuk orang miskin yang meminta, dan orang miskin yang tidak meminta."},{"n":20,"w":[["وَفِى","dan di","wafī",3],["ٱلْأَرْضِ","bumi itu","l-arḍi",22],["ءَايَـٰتٌۭ","tanda-tanda","āyātun",28],["لِّلْمُوقِنِينَ","bagi orang-orang yang yakin","lil'mūqinīna",1375]],"t":"Dan di bumi terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang yakin,"},{"n":21,"w":[["وَفِىٓ","dan pada","wafī",3],["أَنفُسِكُمْ ۚ","diri kalian sendiri","anfusikum",39],["أَفَلَا","maka apakah tidak","afalā",4],["تُبْصِرُونَ","kamu memperhatikan","tub'ṣirūna",370]],"t":"dan (juga) pada dirimu sendiri. Maka apakah kamu tidak memperhatikan?"},{"n":22,"w":[["وَفِى","dan di","wafī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["رِزْقُكُمْ","rezekimu","riz'qukum",219],["وَمَا","dan apa yang","wamā",2],["تُوعَدُونَ","dijanjikan padamu","tūʿadūna",176]],"t":"Dan di langit terdapat (sebab-sebab) rezekimu dan apa yang dijanjikan kepadamu."},{"n":23,"w":[["فَوَرَبِّ","demi Tuhan","fawarabbi",10],["ٱلسَّمَآءِ","langit","l-samāi",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["إِنَّهُۥ","sesungguhnya","innahu",5],["لَحَقٌّۭ","sungguh benar","laḥaqqun",50],["مِّثْلَ","seperti","mith'la",155],["مَآ","apa","mā",2],["أَنَّكُمْ","bahwasanya kamu","annakum",30],["تَنطِقُونَ","kamu ucapkan","tanṭiqūna",936]],"t":"Maka demi Tuhan langit dan bumi, sungguh, apa yang dijanjikan itu pasti terjadi seperti apa yang kamu ucapkan."},{"n":24,"w":[["هَلْ","apakah","hal",115],["أَتَىٰكَ","telah sampai kepadamu","atāka",48],["حَدِيثُ","cerita","ḥadīthu",385],["ضَيْفِ","tamu","ḍayfi",1288],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",178],["ٱلْمُكْرَمِينَ","orang-orang yang dimuliakan","l-muk'ramīna",1373]],"t":"Sudahkah sampai kepadamu (Muhammad) cerita tamu Ibrahim (malaikat-malaikat) yang dimuliakan?"},{"n":25,"w":[["إِذْ","ketika","idh",53],["دَخَلُوا۟","mereka masuk","dakhalū",151],["عَلَيْهِ","atasnya","ʿalayhi",8],["فَقَالُوا۟","lalu mereka berkata","faqālū",6],["سَلَـٰمًۭا ۖ","selamat","salāman",277],["قَالَ","berkata","qāla",6],["سَلَـٰمٌۭ","selamat","salāmun",277],["قَوْمٌۭ","kaum","qawmun",27],["مُّنكَرُونَ","orang-orang yang tidak dikenal","munkarūna",552]],"t":"(Ingatlah) ketika mereka masuk ke tempatnya lalu mengucapkan, \"Salāman (salam)\", Ibrahim menjawab, \"Salāmun (salam)\". (Mereka itu) orang-orang yang belum dikenalnya."},{"n":26,"w":[["فَرَاغَ","lalu dia pergi diam-diam","farāgha",1970],["إِلَىٰٓ","kepada","ilā",13],["أَهْلِهِۦ","keluarganya","ahlihi",91],["فَجَآءَ","lalu dia datang/membawa","fajāa",43],["بِعِجْلٍۢ","dengan anak sapi","biʿij'lin",820],["سَمِينٍۢ","gemuk","samīnin",1987]],"t":"Maka diam-diam dia (Ibrahim) pergi menemui keluarganya, kemudian dibawanya daging anak sapi gemuk (yang dibakar),"},{"n":27,"w":[["فَقَرَّبَهُۥٓ","lalu dihidangkannya","faqarrabahu",1387],["إِلَيْهِمْ","kepada mereka","ilayhim",13],["قَالَ","(Ibrahim)berkata","qāla",6],["أَلَا","mengapa tidak","alā",4],["تَأْكُلُونَ","kamu makan","takulūna",114]],"t":"lalu dihidangkannya kepada mereka (tetapi mereka tidak mau makan). Ibrahim berkata, \"Mengapa tidak kamu makan.\""},{"n":28,"w":[["فَأَوْجَسَ","maka dia merasa","fa-awjasa",1744],["مِنْهُمْ","dari mereka","min'hum",0],["خِيفَةًۭ ۖ","takut","khīfatan",1250],["قَالُوا۟","mereka berkata","qālū",6],["لَا","jangan","lā",4],["تَخَفْ ۖ","kamu takut","takhaf",136],["وَبَشَّرُوهُ","dan mereka memberi kabar gembira","wabasharūhu",307],["بِغُلَـٰمٍ","dengan seorang anak","bighulāmin",687],["عَلِيمٍۢ","pandai","ʿalīmin",68]],"t":"Maka dia (Ibrahim) merasa takut terhadap mereka. Mereka berkata, \"Janganlah kamu takut,\" dan mereka memberi kabar gembira kepadanya dengan (kelahiran) seorang anak yang alim (Ishak)."},{"n":29,"w":[["فَأَقْبَلَتِ","maka menghadap/datang","fa-aqbalati",876],["ٱمْرَأَتُهُۥ","isterinya","im'ra-atuhu",420],["فِى","dalam","fī",3],["صَرَّةٍۢ","teriakan","ṣarratin",3265],["فَصَكَّتْ","lalu ia menampar","faṣakkat",3258],["وَجْهَهَا","mukanya","wajhahā",166],["وَقَالَتْ","dan berkata","waqālat",6],["عَجُوزٌ","seorang perempuan tua","ʿajūzun",1496],["عَقِيمٌۭ","mandul","ʿaqīmun",1501]],"t":"Kemudian istrinya datang memekik (tercengang) lalu menepuk wajahnya sendiri seraya bekata, \"(Aku ini) seorang perempuan tua yang mandul.\""},{"n":30,"w":[["قَالُوا۟","mereka berkata","qālū",6],["كَذَٰلِكِ","demikianlah","kadhāliki",19],["قَالَ","berfirman","qāla",6],["رَبُّكِ ۖ","Tuhanmu","rabbuki",10],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",20],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",112],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Mereka berkata, \"Demikianlah Tuhanmu berfirman. Sungguh, Dialah Yang Mahabijaksana, Maha Mengetahui.\""},{"n":31,"w":[["۞ قَالَ","(Ibrahim)berkata","qāla",6],["فَمَا","maka apakah","famā",2],["خَطْبُكُمْ","pembicaraanmu","khaṭbukum",1418],["أَيُّهَا","wahai","ayyuhā",73],["ٱلْمُرْسَلُونَ","para utusan","l-mur'salūna",331]],"t":"Dia (Ibrahim) berkata, \"Apakah urusanmu yang penting wahai para utusan?\""},{"n":32,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّآ","sesungguhnya kami","innā",5],["أُرْسِلْنَآ","kami di utus","ur'sil'nā",88],["إِلَىٰ","kepada","ilā",13],["قَوْمٍۢ","kaum","qawmin",27],["مُّجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",228]],"t":"Mereka menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa (kaum Luṭ),"},{"n":33,"w":[["لِنُرْسِلَ","agar kami kirimkan","linur'sila",88],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["حِجَارَةًۭ","batu-batu","ḥijāratan",823],["مِّن","dari","min",0],["طِينٍۢ","tanah","ṭīnin",725]],"t":"agar kami menimpa mereka dengan batu-batu dari tanah (yang keras),"},{"n":34,"w":[["مُّسَوَّمَةً","yang ditandai","musawwamatan",1937],["عِندَ","di sisi","ʿinda",59],["رَبِّكَ","Tuhanmu","rabbika",10],["لِلْمُسْرِفِينَ","untuk orang-orang yang melampaui batas","lil'mus'rifīna",634]],"t":"yang ditandai dari Tuhanmu untuk (membinasakan) orang-orang yang melampaui batas.\""},{"n":35,"w":[["فَأَخْرَجْنَا","maka Kami keluarkan","fa-akhrajnā",111],["مَن","orang yang","man",12],["كَانَ","adalah","kāna",9],["فِيهَا","didalamnya","fīhā",3],["مِنَ","dari","mina",0],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",56]],"t":"Lalu Kami keluarkan orang-orang yang beriman yang berada di dalamnya (negeri kaum Luṭ)."},{"n":36,"w":[["فَمَا","maka tidak","famā",2],["وَجَدْنَا","kami dapati","wajadnā",106],["فِيهَا","didalamnya","fīhā",3],["غَيْرَ","selain","ghayra",75],["بَيْتٍۢ","sebuah rumah","baytin",182],["مِّنَ","dari","mina",0],["ٱلْمُسْلِمِينَ","orang-orang yang berserah diri","l-mus'limīna",303]],"t":"Maka Kami tidak mendapati di dalamnya (negeri itu), kecuali satu rumah dari orang-orang muslim (Luṭ)."},{"n":37,"w":[["وَتَرَكْنَا","dan kami tinggalkan","wataraknā",291],["فِيهَآ","didalamnya","fīhā",3],["ءَايَةًۭ","tanda-tanda","āyatan",28],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["يَخَافُونَ","mereka takut","yakhāfūna",136],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["ٱلْأَلِيمَ","pedih","l-alīma",164]],"t":"Dan Kami tinggalkan padanya (negeri itu) suatu tanda bagi orang-orang yang takut kepada azab yang pedih."},{"n":38,"w":[["وَفِى","dan pada","wafī",3],["مُوسَىٰٓ","Musa","mūsā",83],["إِذْ","ketika","idh",53],["أَرْسَلْنَـٰهُ","Kami mengutusnya","arsalnāhu",88],["إِلَىٰ","kepada","ilā",13],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",158],["بِسُلْطَـٰنٍۢ","dengan kekuasaan/mu'jizat","bisul'ṭānin",320],["مُّبِينٍۢ","nyata","mubīnin",100]],"t":"Dan pada Musa (terdapat tanda-tanda kekuasaan Allah) ketika Kami mengutusnya kepada Fir'aun dengan membawa mukjizat yang nyata."},{"n":39,"w":[["فَتَوَلَّىٰ","maka dia berpaling","fatawallā",146],["بِرُكْنِهِۦ","dengan kekuatannya","biruk'nihi",2610],["وَقَالَ","dan dia berkata","waqāla",6],["سَـٰحِرٌ","seorang tukang sihir","sāḥirun",474],["أَوْ","atau","aw",42],["مَجْنُونٌۭ","seorang gila","majnūnun",789]],"t":"Tetapi dia (Fir'aun) bersama bala tentaranya berpaling dan berkata, \"Dia adalah seorang pesihir atau orang gila.\""},{"n":40,"w":[["فَأَخَذْنَـٰهُ","maka Kami ambil/siksa dia","fa-akhadhnāhu",92],["وَجُنُودَهُۥ","dan bala tentaranya","wajunūdahu",374],["فَنَبَذْنَـٰهُمْ","lalu Kami lemparkan mereka","fanabadhnāhum",853],["فِى","ke dalam","fī",3],["ٱلْيَمِّ","laut","l-yami",1015],["وَهُوَ","dan dia","wahuwa",20],["مُلِيمٌۭ","seorang tercela","mulīmun",2494]],"t":"Maka Kami siksa dia beserta bala tentaranya, lalu Kami lemparkan mereka ke dalam laut, dalam keadaan tercela."},{"n":41,"w":[["وَفِى","dan pada","wafī",3],["عَادٍ","'Ad","ʿādin",436],["إِذْ","ketika","idh",53],["أَرْسَلْنَا","Kami kirimkan","arsalnā",88],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلرِّيحَ","angin","l-rīḥa",378],["ٱلْعَقِيمَ","membinasakan","l-ʿaqīma",1501]],"t":"Dan (juga) pada (kisah kaum) 'Ād, ketika Kami kirimkan kepada mereka angin yang membinasakan,"},{"n":42,"w":[["مَا","tidak","mā",2],["تَذَرُ","membiarkan","tadharu",262],["مِن","dari","min",0],["شَىْءٍ","sesuatu","shayin",41],["أَتَتْ","ia datang","atat",48],["عَلَيْهِ","atasnya","ʿalayhi",8],["إِلَّا","kecuali","illā",15],["جَعَلَتْهُ","ia jadikannya","jaʿalathu",33],["كَٱلرَّمِيمِ","seperti abu/hancur","kal-ramīmi",2606]],"t":"(angin itu) tidak membiarkan suatu apa pun yang dilandanya, bahkan dijadikannya seperti serbuk."},{"n":43,"w":[["وَفِى","dan pada","wafī",3],["ثَمُودَ","kaum Tsamud","thamūda",417],["إِذْ","ketika","idh",53],["قِيلَ","dikatakan","qīla",6],["لَهُمْ","kepada mereka","lahum",11],["تَمَتَّعُوا۟","bersenang-senanglah","tamattaʿū",802],["حَتَّىٰ","sehingga","ḥattā",80],["حِينٍۢ","suatu waktu","ḥīnin",328]],"t":"Dan pada (kisah kaum) Samud, ketika dikatakan kepada mereka, \"Bersenang-senanglah kamu sampai waktu yang ditentukan.\""},{"n":44,"w":[["فَعَتَوْا۟","maka mereka angkuh","faʿataw",1296],["عَنْ","dari","ʿan",21],["أَمْرِ","perintah","amri",66],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["فَأَخَذَتْهُمُ","maka menyambar","fa-akhadhathumu",92],["ٱلصَّـٰعِقَةُ","petir","l-ṣāʿiqatu",961],["وَهُمْ","sedang mereka","wahum",11],["يَنظُرُونَ","mereka melihat","yanẓurūna",125]],"t":"Lalu mereka berlaku angkuh terhadap perintah Tuhannya, maka mereka disambar petir sedang mereka melihatnya."},{"n":45,"w":[["فَمَا","maka tidak","famā",2],["ٱسْتَطَـٰعُوا۟","mereka kuasa","is'taṭāʿū",279],["مِن","dari","min",0],["قِيَامٍۢ","berdiri/bangun","qiyāmin",577],["وَمَا","dan tidak ada","wamā",2],["كَانُوا۟","adalah mereka","kānū",9],["مُنتَصِرِينَ","mendapat pertolongan","muntaṣirīna",1605]],"t":"Maka mereka tidak mampu bangun dan juga tidak mendapat pertolongan,"},{"n":46,"w":[["وَقَوْمَ","dan kaum","waqawma",27],["نُوحٍۢ","Nuh","nūḥin",272],["مِّن","dari","min",0],["قَبْلُ ۖ","sebelum itu","qablu",51],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["قَوْمًۭا","kaum","qawman",27],["فَـٰسِقِينَ","orang-orang yang fasik","fāsiqīna",316]],"t":"dan sebelum itu (telah Kami binasakan) kaum Nuh. Sungguh, mereka adalah kaum yang fasik."},{"n":47,"w":[["وَٱلسَّمَآءَ","dan langit","wal-samāa",38],["بَنَيْنَـٰهَا","Kami bangun ia","banaynāhā",779],["بِأَيْي۟دٍۢ","dengan kekuasaan","bi-aydin",2210],["وَإِنَّا","dan sesungguhnya Kami","wa-innā",5],["لَمُوسِعُونَ","benar-benar luas","lamūsiʿūna",2513]],"t":"Dan langit Kami bangun dengan kekuasaan (Kami), dan Kami benar-benar meluaskannya."},{"n":48,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["فَرَشْنَـٰهَا","Kami hamparkannya","farashnāhā",3429],["فَنِعْمَ","maka sebaik-baik","faniʿ'ma",554],["ٱلْمَـٰهِدُونَ","yang menghamparkan","l-māhidūna",3662]],"t":"Dan bumi telah Kami hamparkan; maka (Kami) sebaik-baik yang menghamparkan."},{"n":49,"w":[["وَمِن","dan dari","wamin",0],["كُلِّ","segala","kulli",31],["شَىْءٍ","sesuatu","shayin",41],["خَلَقْنَا","Kami ciptakan","khalaqnā",60],["زَوْجَيْنِ","berpasang-pasangan","zawjayni",152],["لَعَلَّكُمْ","agar kalian","laʿallakum",96],["تَذَكَّرُونَ","kamu ingat","tadhakkarūna",233]],"t":"Dan segala sesuatu Kami ciptakan berpasang-pasangan agar kamu mengingat (kebesaran Allah)."},{"n":50,"w":[["فَفِرُّوٓا۟","maka segeralah","fafirrū",1179],["إِلَى","kepada","ilā",13],["ٱللَّهِ ۖ","Allah","l-lahi",1],["إِنِّى","sesungguhnya aku","innī",5],["لَكُم","bagi kalian","lakum",26],["مِّنْهُ","daripada-Nya","min'hu",0],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206],["مُّبِينٌۭ","nyata","mubīnun",100]],"t":"Maka segeralah kembali kepada (menaati) Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu."},{"n":51,"w":[["وَلَا","dan jangan","walā",4],["تَجْعَلُوا۟","kalian jadikan","tajʿalū",33],["مَعَ","beserta","maʿa",69],["ٱللَّهِ","Allah","l-lahi",1],["إِلَـٰهًا","Tuhan","ilāhan",74],["ءَاخَرَ ۖ","lain","ākhara",172],["إِنِّى","sesungguhnya aku","innī",5],["لَكُم","bagi kalian","lakum",26],["مِّنْهُ","darinya","min'hu",0],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206],["مُّبِينٌۭ","nyata","mubīnun",100]],"t":"Dan janganlah kamu mengadakan tuhan yang lain selain Allah. Sungguh, aku seorang pemberi peringatan yang jelas dari Allah untukmu."},{"n":52,"w":[["كَذَٰلِكَ","demikianlah","kadhālika",19],["مَآ","tidak","mā",2],["أَتَى","datang","atā",48],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلِهِم","sebelum mereka","qablihim",51],["مِّن","dari","min",0],["رَّسُولٍ","seorang rasul","rasūlin",35],["إِلَّا","kecuali","illā",15],["قَالُوا۟","mereka berkata","qālū",6],["سَاحِرٌ","seorang tukang sihir","sāḥirun",474],["أَوْ","atau","aw",42],["مَجْنُونٌ","seorang gila","majnūnun",789]],"t":"Demikianlah setiap kali seorang rasul yang datang kepada orang-orang yang sebelum mereka, mereka (kaumnya) pasti mengatakan, \"Dia itu pesihir atau orang gila.\""},{"n":53,"w":[["أَتَوَاصَوْا۟","apakah mereka saling berwasiat","atawāṣaw",1406],["بِهِۦ ۚ","tentang itu","bihi",16],["بَلْ","bahkan","bal",93],["هُمْ","mereka","hum",11],["قَوْمٌۭ","kaum","qawmun",27],["طَاغُونَ","melampaui batas","ṭāghūna",1161]],"t":"Apakah mereka saling berpesan tentang apa yang dikatakan itu. Sebenarnya mereka adalah kaum yang melampaui batas."},{"n":54,"w":[["فَتَوَلَّ","maka berpalinglah kamu","fatawalla",146],["عَنْهُمْ","dari mereka","ʿanhum",21],["فَمَآ","maka tidaklah","famā",2],["أَنتَ","kamu","anta",139],["بِمَلُومٍۢ","orang-orang yang tercela","bimalūmin",1356]],"t":"Maka berpalinglah engkau dari mereka, dan engkau sama sekali tidak tercela."},{"n":55,"w":[["وَذَكِّرْ","dan berilah peringatan","wadhakkir",537],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلذِّكْرَىٰ","peringatan itu","l-dhik'rā",448],["تَنفَعُ","memberi manfaat","tanfaʿu",358],["ٱلْمُؤْمِنِينَ","orang-orang yang beriman","l-mu'minīna",56]],"t":"Dan tetaplah memberi peringatan, karena sesungguhnya peringatan itu bermanfaat bagi orang-orang mukmin."},{"n":56,"w":[["وَمَا","dan tidaklah","wamā",2],["خَلَقْتُ","Aku menciptakan","khalaqtu",60],["ٱلْجِنَّ","jin","l-jina",468],["وَٱلْإِنسَ","dan manusia","wal-insa",538],["إِلَّا","kecuali","illā",15],["لِيَعْبُدُونِ","supaya mereka menyembah-Ku","liyaʿbudūni",97]],"t":"Aku tidak menciptakan jin dan manusia melainkan agar mereka beribadah kepada-Ku."},{"n":57,"w":[["مَآ","tidak","mā",2],["أُرِيدُ","Aku menghendaki","urīdu",81],["مِنْهُم","dari mereka","min'hum",0],["مِّن","dari","min",0],["رِّزْقٍۢ","rezeki","riz'qin",219],["وَمَآ","dan tidak","wamā",2],["أُرِيدُ","Aku menghendaki","urīdu",81],["أَن","supaya","an",17],["يُطْعِمُونِ","mereka memberi Aku makan","yuṭ'ʿimūni",677]],"t":"Aku tidak menghendaki rezeki sedikit pun dari mereka dan Aku tidak menghendaki agar mereka memberi makan kepada-Ku."},{"n":58,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["هُوَ","Dia","huwa",20],["ٱلرَّزَّاقُ","Maha Pemberi rezeki","l-razāqu",4230],["ذُو","mempunyai","dhū",113],["ٱلْقُوَّةِ","kekuatan","l-quwati",366],["ٱلْمَتِينُ","teguh/kokoh","l-matīnu",1890]],"t":"Sungguh Allah, Dialah Pemberi rezeki yang mempunyai kekuatan lagi sangat kokoh."},{"n":59,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",5],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["ظَلَمُوا۟","zalim","ẓalamū",104],["ذَنُوبًۭا","bahagian(siksa)","dhanūban",2129],["مِّثْلَ","seperti","mith'la",155],["ذَنُوبِ","bahagian(siksa)","dhanūbi",2129],["أَصْحَـٰبِهِمْ","teman-teman mereka","aṣḥābihim",143],["فَلَا","maka jangan","falā",4],["يَسْتَعْجِلُونِ","mereka meminta disegerakan kepada-Ku","yastaʿjilūni",535]],"t":"Maka sungguh, untuk orang-orang yang zalim ada bagian (azab) seperti bagian teman-teman mereka (dahulu); maka janganlah mereka meminta kepada-Ku untuk menyegerakannya."},{"n":60,"w":[["فَوَيْلٌۭ","maka kecelakaanlah","fawaylun",293],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِن","dari","min",0],["يَوْمِهِمُ","pada hari mereka","yawmihimu",25],["ٱلَّذِى","yang","alladhī",7],["يُوعَدُونَ","mereka diancam","yūʿadūna",176]],"t":"Maka celakalah orang-orang yang kafir pada hari yang telah dijanjikan kepada mereka (hari Kiamat)."}]