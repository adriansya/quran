[{"n":1,"w":[["حمٓ","Haa Miim","hha-meem",1064]],"t":"Ḥā Mīm."},{"n":2,"w":[["وَٱلْكِتَـٰبِ","demi kitab","wal-kitābi",49],["ٱلْمُبِينِ","yang nyata","l-mubīni",99]],"t":"Demi Kitab (Alquran) yang jelas."},{"n":3,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["جَعَلْنَـٰهُ","Kami jadikannya","jaʿalnāhu",33],["قُرْءَٰنًا","Al Qur'an","qur'ānan",175],["عَرَبِيًّۭا","bahasa Arab","ʿarabiyyan",774],["لَّعَلَّكُمْ","agar kalian","laʿallakum",95],["تَعْقِلُونَ","kalian menggunakan akal","taʿqilūna",242]],"t":"Kami menjadikan Alquran dalam bahasa Arab agar kamu mengerti."},{"n":4,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia/Al Qur'an","wa-innahu",5],["فِىٓ","dalam","fī",3],["أُمِّ","induk","ummi",339],["ٱلْكِتَـٰبِ","Al kitab","l-kitābi",49],["لَدَيْنَا","di sisi Kami","ladaynā",517],["لَعَلِىٌّ","benar-benar tinggi","laʿaliyyun",772],["حَكِيمٌ","hikmah","ḥakīmun",112]],"t":"Dan sesungguhnya Alquran itu dalam ummul Kitāb (Lauḥ Maḥfūẓ) di sisi Kami, benar-benar (bernilai) tinggi dan penuh hikmah."},{"n":5,"w":[["أَفَنَضْرِبُ","apakah maka Kami jadikan","afanaḍribu",219],["عَنكُمُ","dari kalian","ʿankumu",21],["ٱلذِّكْرَ","pengajaran/Al Qur'an","l-dhik'ra",147],["صَفْحًا","hentikan","ṣafḥan",2298],["أَن","karena","an",16],["كُنتُمْ","kalian adalah","kuntum",9],["قَوْمًۭا","kaum","qawman",27],["مُّسْرِفِينَ","orang-orang yang melampaui batas","mus'rifīna",637]],"t":"Maka apakah Kami akan berhenti menurunkan ayat-ayat (sebagai peringatan) Alquran kepadamu, karena kamu kaum yang melampuai batas?"},{"n":6,"w":[["وَكَمْ","dan berapa banyak","wakam",490],["أَرْسَلْنَا","telah Kami turunkan","arsalnā",88],["مِن","dari","min",0],["نَّبِىٍّۢ","nabi-nabi","nabiyyin",154],["فِى","pada","fī",3],["ٱلْأَوَّلِينَ","ummat-ummat terdahulu","l-awalīna",136]],"t":"Dan betapa banyak nabi-nabi yang telah Kami utus kepada umat-umat yang terdahulu."},{"n":7,"w":[["وَمَا","dan tidak","wamā",2],["يَأْتِيهِم","datang kepada mereka","yatīhim",48],["مِّن","dari","min",0],["نَّبِىٍّ","seorang nabi","nabiyyin",154],["إِلَّا","kecuali","illā",15],["كَانُوا۟","mereka adalah","kānū",9],["بِهِۦ","kepadanya","bihi",17],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",500]],"t":"Dan setiap kali seorang nabi datang kepada mereka, mereka selalu memperolok-olokkannya."},{"n":8,"w":[["فَأَهْلَكْنَآ","maka Kami binasakan","fa-ahlaknā",232],["أَشَدَّ","sangat","ashadda",358],["مِنْهُم","dari mereka","min'hum",0],["بَطْشًۭا","kekuatan","baṭshan",1812],["وَمَضَىٰ","dan telah lewat","wamaḍā",1578],["مَثَلُ","perumpamaan","mathalu",123],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",136]],"t":"Karena itu, Kami binasakan orang-orang yang lebih besar kekuatannya di antara mereka dan telah berlalu contoh umat-umat terdahulu."},{"n":9,"w":[["وَلَئِن","dan jika","wala-in",14],["سَأَلْتَهُم","kamu bertanya kepada mereka","sa-altahum",105],["مَّنْ","siapakah","man",12],["خَلَقَ","yang menciptakan","khalaqa",60],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["لَيَقُولُنَّ","tentu mereka mengatakan","layaqūlunna",6],["خَلَقَهُنَّ","menciptakan mereka semua","khalaqahunna",60],["ٱلْعَزِيزُ","Maha perkasa","l-ʿazīzu",110],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Dan jika kamu tanyakan kepada mereka, \"Siapakah yang menciptakan langit dan bumi?\" pastilah mereka akan menjawab, \"Semuanya diciptakan oleh Yang Mahaperkasa, Maha Mengetahui.\""},{"n":10,"w":[["ٱلَّذِى","yang","alladhī",7],["جَعَلَ","menjadikan","jaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلْأَرْضَ","bumi","l-arḍa",22],["مَهْدًۭا","tempat menetap","mahdan",1359],["وَجَعَلَ","dan menjadikan","wajaʿala",33],["لَكُمْ","bagi kalian","lakum",26],["فِيهَا","diatasnya","fīhā",3],["سُبُلًۭا","jalan-jalan","subulan",64],["لَّعَلَّكُمْ","agar kalian","laʿallakum",95],["تَهْتَدُونَ","kalian mendapat petunjuk","tahtadūna",296]],"t":"Yang menjadikan bumi sebagai tempat menetap bagimu dan Dia menjadikan jalan-jalan di atas bumi untukmu agar kamu mendapat petunjuk."},{"n":11,"w":[["وَٱلَّذِى","dan yang","wa-alladhī",7],["نَزَّلَ","menurunkan","nazzala",197],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["مَآءًۢ","air","māan",192],["بِقَدَرٍۢ","menurut ukuran","biqadarin",800],["فَأَنشَرْنَا","lalu Kami hidupkan","fa-ansharnā",1743],["بِهِۦ","dengannya","bihi",17],["بَلْدَةًۭ","negeri","baldatan",1328],["مَّيْتًۭا ۚ","mati","maytan",1376],["كَذَٰلِكَ","seperti demikian","kadhālika",19],["تُخْرَجُونَ","kamu dikeluarkan","tukh'rajūna",111]],"t":"Dan yang menurunkan air dari langit menurut ukuran (yang diperlukan), lalu dengan air itu Kami hidupkan negeri yang mati (tandus). Seperti itulah kamu akan dikeluarkan (dari kubur)."},{"n":12,"w":[["وَٱلَّذِى","dan yang","wa-alladhī",7],["خَلَقَ","menciptakan","khalaqa",60],["ٱلْأَزْوَٰجَ","berpasangan","l-azwāja",150],["كُلَّهَا","semuanya","kullahā",31],["وَجَعَلَ","dan menjadikan","wajaʿala",33],["لَكُم","bagi kalian","lakum",26],["مِّنَ","dari","mina",0],["ٱلْفُلْكِ","bahtera","l-ful'ki",456],["وَٱلْأَنْعَـٰمِ","dan binatang ternak","wal-anʿāmi",348],["مَا","apa yang","mā",2],["تَرْكَبُونَ","kamu kendarai","tarkabūna",922]],"t":"Dan yang menciptakan semua berpasangan-pasangan dan menjadikan kapal untukmu dan hewan ternak yang kamu tunggangi,"},{"n":13,"w":[["لِتَسْتَوُۥا۟","supaya kamu sama(duduk)","litastawū",336],["عَلَىٰ","atas","ʿalā",8],["ظُهُورِهِۦ","punggungnya","ẓuhūrihi",628],["ثُمَّ","kemudian","thumma",34],["تَذْكُرُوا۟","kamu ingat","tadhkurū",129],["نِعْمَةَ","nikmat","niʿ'mata",238],["رَبِّكُمْ","Tuhan kalian","rabbikum",10],["إِذَا","apabila","idhā",23],["ٱسْتَوَيْتُمْ","kamu sama duduk","is'tawaytum",336],["عَلَيْهِ","atasnya","ʿalayhi",8],["وَتَقُولُوا۟","dan kamu mengucapkan","wataqūlū",6],["سُبْحَـٰنَ","Maha Suci Dia","sub'ḥāna",286],["ٱلَّذِى","yang","alladhī",7],["سَخَّرَ","menundukkan","sakhara",477],["لَنَا","untuk kami","lanā",172],["هَـٰذَا","ini","hādhā",37],["وَمَا","dan tidaklah","wamā",2],["كُنَّا","kami","kunnā",9],["لَهُۥ","baginya","lahu",17],["مُقْرِنِينَ","menguasai","muq'rinīna",3855]],"t":"agar kamu duduk di atas punggungnya kemudian kamu ingat nikmat Tuhanmu apabila kamu telah duduk di atasnya; dan agar kamu mengucapkan, \"Mahasuci (Allah) yang telah menundukkan semua ini bagi kami, padahal kami sebelumnya tidak mampu menguasainya,"},{"n":14,"w":[["وَإِنَّآ","dan sesungguhnya kami","wa-innā",5],["إِلَىٰ","kepada","ilā",13],["رَبِّنَا","Tuhan kami","rabbinā",10],["لَمُنقَلِبُونَ","benar-benar orang yang kembali","lamunqalibūna",1915]],"t":"dan sesungguhnya kami akan kembali kepada Tuhan kami.\""},{"n":15,"w":[["وَجَعَلُوا۟","dan mereka menjadikan","wajaʿalū",33],["لَهُۥ","baginya","lahu",17],["مِنْ","sebagian dari","min",0],["عِبَادِهِۦ","hamba-hamba-Nya","ʿibādihi",87],["جُزْءًا ۚ","bahagian","juz'an",1866],["إِنَّ","sesungguhnya","inna",5],["ٱلْإِنسَـٰنَ","manusia","l-insāna",165],["لَكَفُورٌۭ","benar-benar ingkar","lakafūrun",734],["مُّبِينٌ","nyata","mubīnun",99]],"t":"Dan mereka menjadikan sebagian dari hamba-hamba-Nya sebagai bagian dari-Nya. Sungguh, manusia itu pengingkar (nikmat Tuhan) yang nyata."},{"n":16,"w":[["أَمِ","atau","ami",82],["ٱتَّخَذَ","Dia mengambil","ittakhadha",94],["مِمَّا","dari apa","mimmā",0],["يَخْلُقُ","Dia ciptakan","yakhluqu",60],["بَنَاتٍۢ","anak perempuan","banātin",572],["وَأَصْفَىٰكُم","dan Dia pilih kamu","wa-aṣfākum",2168],["بِٱلْبَنِينَ","dengan anak laki-laki","bil-banīna",140]],"t":"Pantaskah Dia mengambil anak perempuan dari yang diciptakan-Nya dan memberikan anak laki-laki kepadamu?"},{"n":17,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["بُشِّرَ","diberi kabar gembira","bushira",308],["أَحَدُهُم","salah seorang di antara mereka","aḥaduhum",155],["بِمَا","dengan apa","bimā",2],["ضَرَبَ","menjadikan","ḍaraba",219],["لِلرَّحْمَـٰنِ","bagi Yang Maha Pengasih","lilrraḥmāni",213],["مَثَلًۭا","perumpamaan","mathalan",123],["ظَلَّ","jadilah","ẓalla",898],["وَجْهُهُۥ","mukanya","wajhuhu",164],["مُسْوَدًّۭا","hitam pekat","mus'waddan",2516],["وَهُوَ","dan dia","wahuwa",20],["كَظِيمٌ","menahan marah","kaẓīmun",1868]],"t":"Dan apabila salah seorang di antara mereka diberi kabar gembira dengan apa (kelahiran anak perempuan) yang dijadikan sebagai perumpamaan bagi (Allah) Yang Maha Pengasih, jadilah wajahnya hitam pekat karena menahan sedih (dan marah)."},{"n":18,"w":[["أَوَمَن","ataukah orang","awaman",12],["يُنَشَّؤُا۟","dibesarkan","yunasha-u",4745],["فِى","dalam","fī",3],["ٱلْحِلْيَةِ","perhiasan","l-ḥil'yati",1519],["وَهُوَ","dan dia","wahuwa",20],["فِى","dalam","fī",3],["ٱلْخِصَامِ","terang","l-khiṣāmi",1422],["غَيْرُ","tidak","ghayru",75],["مُبِينٍۢ","nyata","mubīnin",99]],"t":"Dan apakah patut (menjadi anak Allah) orang yang dibesarkan sebagai perhiasan sedang dia tidak mampu memberi alasan yang tegas dan jelas dalam pertengkaran."},{"n":19,"w":[["وَجَعَلُوا۟","dan mereka menjadikan","wajaʿalū",33],["ٱلْمَلَـٰٓئِكَةَ","malaikat-malaikat","l-malāikata",122],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["هُمْ","mereka itu","hum",11],["عِبَـٰدُ","hamba-hamba","ʿibādu",87],["ٱلرَّحْمَـٰنِ","Maha Pengasih","l-raḥmāni",213],["إِنَـٰثًا ۚ","orang-orang perempuan","ināthan",436],["أَشَهِدُوا۟","apakah mereka menyaksikan","ashahidū",264],["خَلْقَهُمْ ۚ","penciptaan mereka","khalqahum",230],["سَتُكْتَبُ","kelak akan ditulis","satuk'tabu",244],["شَهَـٰدَتُهُمْ","persaksian mereka","shahādatuhum",447],["وَيُسْـَٔلُونَ","dan mereka akan ditanya","wayus'alūna",105]],"t":"Dan mereka menjadikan malaikat-malaikat hamba-hamba (Allah) Yang Maha Pengasih itu sebagai jenis perempuan. Apakah mereka menyaksikan penciptaan (malaikat-malaikat itu)? Kelak akan dituliskan kesaksian mereka dan akan dimintakan pertanggungjawaban."},{"n":20,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["لَوْ","jika","law",57],["شَآءَ","menghendaki","shāa",54],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",213],["مَا","tidak","mā",2],["عَبَدْنَـٰهُم ۗ","kami menyembah mereka","ʿabadnāhum",96],["مَّا","tidak ada","mā",2],["لَهُم","bagi mereka","lahum",11],["بِذَٰلِكَ","demikian itu","bidhālika",19],["مِنْ","dari","min",0],["عِلْمٍ ۖ","pengetahuan","ʿil'min",108],["إِنْ","tidak lain","in",14],["هُمْ","mereka","hum",11],["إِلَّا","kecuali","illā",15],["يَخْرُصُونَ","mereka mengada-adakan kebohongan","yakhruṣūna",1682]],"t":"Dan mereka berkata, \"Sekiranya (Allah) Yang Mahapengasih menghendaki, tentulah kami tidak menyembah mereka (malaikat).\" Mereka tidak mempunyai ilmu sedikit pun tentang itu. Tidak lain mereka hanyalah menduga-duga belaka."},{"n":21,"w":[["أَمْ","atau","am",82],["ءَاتَيْنَـٰهُمْ","Kami berikan pada mereka","ātaynāhum",45],["كِتَـٰبًۭا","sebuah kitab","kitāban",49],["مِّن","dari","min",0],["قَبْلِهِۦ","sebelumnya","qablihi",51],["فَهُم","lalu mereka","fahum",11],["بِهِۦ","dengannya","bihi",17],["مُسْتَمْسِكُونَ","mereka berpegang","mus'tamsikūna",3879]],"t":"Atau apakah pernah Kami berikan suatu kitab kepada mereka sebelumnya, lalu mereka berpegang (pada kitab itu)?"},{"n":22,"w":[["بَلْ","bahkan","bal",93],["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya kami","innā",5],["وَجَدْنَآ","kami mendapati","wajadnā",106],["ءَابَآءَنَا","bapak-bapak kami","ābāanā",189],["عَلَىٰٓ","atas","ʿalā",8],["أُمَّةٍۢ","ummat","ummatin",188],["وَإِنَّا","dan sesungguhnya kami","wa-innā",5],["عَلَىٰٓ","atas","ʿalā",8],["ءَاثَـٰرِهِم","bekas-bekas mereka","āthārihim",652],["مُّهْتَدُونَ","orang-orang yang mendapat petunjuk","muh'tadūna",577]],"t":"Bahkan mereka berkata, \"Sesungguhnya kami mendapati nenek moyang kami menganut suatu agama, dan kami mendapat petunjuk untuk mengikuti jejak mereka.\""},{"n":23,"w":[["وَكَذَٰلِكَ","dan demikian itu","wakadhālika",19],["مَآ","tidak","mā",2],["أَرْسَلْنَا","Kami mengutus","arsalnā",88],["مِن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["فِى","dalam","fī",3],["قَرْيَةٍۢ","suatu negeri","qaryatin",212],["مِّن","dari","min",0],["نَّذِيرٍ","seorang pemberi peringatan","nadhīrin",207],["إِلَّا","kecuali","illā",15],["قَالَ","berkata","qāla",6],["مُتْرَفُوهَآ","orang-orang mewah hidupnya","mut'rafūhā",1373],["إِنَّا","sesungguhnya kami","innā",5],["وَجَدْنَآ","mendapati","wajadnā",106],["ءَابَآءَنَا","bapak-bapak kami","ābāanā",189],["عَلَىٰٓ","atas","ʿalā",8],["أُمَّةٍۢ","ummat","ummatin",188],["وَإِنَّا","dan sesungguhnya kami","wa-innā",5],["عَلَىٰٓ","atas","ʿalā",8],["ءَاثَـٰرِهِم","bekas-bekas mereka","āthārihim",652],["مُّقْتَدُونَ","orang-orang pengikut","muq'tadūna",4002]],"t":"Dan demikian juga ketika Kami mengutus seorang pemberi peringatan sebelum engkau (Muhammad) dalam suatu negeri, orang-orang yang hidup mewah (di negeri itu) selalu berkata, \"Sesungguhnya kami mendapati nenek moyang kami menganut suatu (agama) dan sesungguhnya kami sekedar pengikut jejak-jejak mereka.\""},{"n":24,"w":[["۞ قَـٰلَ","(Rasul) berkata","qāla",6],["أَوَلَوْ","apakah meskipun","awalaw",57],["جِئْتُكُم","aku datang","ji'tukum",43],["بِأَهْدَىٰ","dengan petunjuk","bi-ahdā",1041],["مِمَّا","dari pada apa","mimmā",0],["وَجَدتُّمْ","kamu dapati","wajadttum",106],["عَلَيْهِ","atasnya","ʿalayhi",8],["ءَابَآءَكُمْ ۖ","bapak-bapak kamu","ābāakum",189],["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya kami","innā",5],["بِمَآ","terhadap apa","bimā",2],["أُرْسِلْتُم","kamu di utus","ur'sil'tum",88],["بِهِۦ","dengannya","bihi",17],["كَـٰفِرُونَ","orang-orang yang ingkar","kāfirūna",90]],"t":"(Rasul itu) berkata, \"Apakah (kamu akan mengikutinya juga) sekalipun aku membawa untukmu (agama) yang lebih baik daripada apa yang kamu peroleh dari (agama) yang dianut nenek moyangmu.\" Mereka menjawab, \"Sesungguhnya kami mengingkari (agama) yang kamu diperintahkan untuk menyampaikannya.\""},{"n":25,"w":[["فَٱنتَقَمْنَا","maka Kami siksa","fa-intaqamnā",1264],["مِنْهُمْ ۖ","diantara mereka","min'hum",0],["فَٱنظُرْ","maka perhatikanlah","fa-unẓur",124],["كَيْفَ","bagaimana","kayfa",133],["كَانَ","adalah","kāna",9],["عَـٰقِبَةُ","akibat","ʿāqibatu",351],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",494]],"t":"Lalu Kami binasakan mereka, maka perhatikanlah bagaimana kesudahan orang-orang yang mendustakan (kebenaran)."},{"n":26,"w":[["وَإِذْ","dan ketika","wa-idh",53],["قَالَ","berkata","qāla",6],["إِبْرَٰهِيمُ","Ibrahim","ib'rāhīmu",178],["لِأَبِيهِ","kepada bapaknya","li-abīhi",255],["وَقَوْمِهِۦٓ","dan kaumnya","waqawmihi",27],["إِنَّنِى","sesungguhnya aku","innanī",5],["بَرَآءٌۭ","berlepas diri","barāon",3361],["مِّمَّا","dari apa","mimmā",0],["تَعْبُدُونَ","kamu sembah","taʿbudūna",96]],"t":"Dan (ingatlah) ketika Ibrahim berkata kepada ayahnya dan kaumnya, \"Sesungguhnya aku berlepas diri dari apa yang kamu sembah,"},{"n":27,"w":[["إِلَّا","kecuali","illā",15],["ٱلَّذِى","yang","alladhī",7],["فَطَرَنِى","menciptakan aku","faṭaranī",836],["فَإِنَّهُۥ","maka sesungguhnya Dia","fa-innahu",5],["سَيَهْدِينِ","akan memberi petunjuk kepadaku","sayahdīni",79]],"t":"kecuali (kamu menyembah) Allah yang menciptakanku; karena sungguh, Dia akan memberi petunjuk kepadaku.\""},{"n":28,"w":[["وَجَعَلَهَا","dan(Ibrahim) menjadikannya","wajaʿalahā",33],["كَلِمَةًۢ","kalimat","kalimatan",388],["بَاقِيَةًۭ","kekal","bāqiyatan",2327],["فِى","pada","fī",3],["عَقِبِهِۦ","keturunannya","ʿaqibihi",963],["لَعَلَّهُمْ","supaya mereka","laʿallahum",95],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",141]],"t":"Dan (Ibrahim) menjadikan (kalimat tauhid) itu kalimat yang kekal pada keturunannya agar mereka kembali (kepada kalimat tauhid itu)."},{"n":29,"w":[["بَلْ","bahkan","bal",93],["مَتَّعْتُ","Aku telah memberi kesenangan","mattaʿtu",555],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["وَءَابَآءَهُمْ","dan bapak-bapak mereka","waābāahum",189],["حَتَّىٰ","sehingga","ḥattā",80],["جَآءَهُمُ","datang kepada mereka","jāahumu",43],["ٱلْحَقُّ","kebenaran","l-ḥaqu",50],["وَرَسُولٌۭ","dan seorang rasul","warasūlun",35],["مُّبِينٌۭ","memberi penjelasan","mubīnun",99]],"t":"Bahkan Aku telah memberikan kenikmatan hidup kepada mereka dan nenek moyang mereka sampai kebenaran (Alquran) datang kepada mereka bersama seorang Rasul yang memberi penjelasan."},{"n":30,"w":[["وَلَمَّا","dan tatkala","walammā",71],["جَآءَهُمُ","datang kepada mereka","jāahumu",43],["ٱلْحَقُّ","kebenaran","l-ḥaqu",50],["قَالُوا۟","mereka berkata","qālū",6],["هَـٰذَا","ini","hādhā",37],["سِحْرٌۭ","sihir","siḥ'run",394],["وَإِنَّا","dan sesungguhnya kami","wa-innā",5],["بِهِۦ","dengannya","bihi",17],["كَـٰفِرُونَ","orang-orang yang ingkar","kāfirūna",90]],"t":"Tetapi ketika kebenaran (Alquran) itu datang kepada mereka, mereka berkata, \"Ini adalah sihir, dan sesungguhnya kami mengingkarinya.\""},{"n":31,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["لَوْلَا","mengapa tidak","lawlā",152],["نُزِّلَ","diturunkan","nuzzila",197],["هَـٰذَا","ini","hādhā",37],["ٱلْقُرْءَانُ","Al Qur'an","l-qur'ānu",175],["عَلَىٰ","atas","ʿalā",8],["رَجُلٍۢ","seorang laki-laki","rajulin",378],["مِّنَ","dari","mina",0],["ٱلْقَرْيَتَيْنِ","dua negeri","l-qaryatayni",212],["عَظِيمٍ","besar","ʿaẓīmin",97]],"t":"Dan mereka (juga) berkata, \"Mengapa Alquran ini tidak diturunkan kepada orang besar (kaya dan berpengaruh) dari salah satu dua negeri ini (Mekkah dan Taif)?\""},{"n":32,"w":[["أَهُمْ","mengapa mereka","ahum",11],["يَقْسِمُونَ","mereka membagi-bagi","yaqsimūna",2588],["رَحْمَتَ","rahmat","raḥmata",102],["رَبِّكَ ۚ","Tuhanmu","rabbika",10],["نَحْنُ","Kami","naḥnu",125],["قَسَمْنَا","Kami membagi-bagi","qasamnā",2588],["بَيْنَهُم","diantara mereka","baynahum",47],["مَّعِيشَتَهُمْ","penghidupan mereka","maʿīshatahum",1884],["فِى","dalam","fī",3],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",148],["ٱلدُّنْيَا ۚ","dunia","l-dun'yā",101],["وَرَفَعْنَا","dan Kami tinggikan","warafaʿnā",474],["بَعْضَهُمْ","sebagian mereka","baʿḍahum",70],["فَوْقَ","di atas","fawqa",285],["بَعْضٍۢ","sebagian","baʿḍin",70],["دَرَجَـٰتٍۢ","derajat","darajātin",550],["لِّيَتَّخِذَ","agar mengambil","liyattakhidha",94],["بَعْضُهُم","sebagian mereka","baʿḍuhum",70],["بَعْضًۭا","sebagian","baʿḍan",70],["سُخْرِيًّۭا ۗ","pekerjaan","sukh'riyyan",4307],["وَرَحْمَتُ","dan rahmat","waraḥmatu",102],["رَبِّكَ","Tuhanmu","rabbika",10],["خَيْرٌۭ","lebih baik","khayrun",62],["مِّمَّا","dari apa","mimmā",0],["يَجْمَعُونَ","mereka kumpulkan","yajmaʿūna",468]],"t":"Apakah mereka yang membagi-bagi rahmat Tuhanmu? Kamilah yang menentukan penghidupan mereka dalam kehidupan dunia, dan Kami telah meninggikan sebagian mereka atas sebagian yang lain beberapa derajat, agar sebagian mereka dapat memanfaatkan sebagian yang lain. Dan rahmat Tuhanmu lebih baik dari apa yang mereka kumpulkan."},{"n":33,"w":[["وَلَوْلَآ","dan jika tidak","walawlā",152],["أَن","bahwa","an",16],["يَكُونَ","adalah","yakūna",9],["ٱلنَّاسُ","manusia","l-nāsu",52],["أُمَّةًۭ","ummat","ummatan",188],["وَٰحِدَةًۭ","satu","wāḥidatan",360],["لَّجَعَلْنَا","tentu Kami jadikan","lajaʿalnā",33],["لِمَن","bagi orang","liman",12],["يَكْفُرُ","ingkar","yakfuru",40],["بِٱلرَّحْمَـٰنِ","kepada Yang Maha Pengasih","bil-raḥmāni",213],["لِبُيُوتِهِمْ","bagi rumah-rumah mereka","libuyūtihim",182],["سُقُفًۭا","atap","suqufan",1644],["مِّن","dari","min",0],["فِضَّةٍۢ","perak","fiḍḍatin",1184],["وَمَعَارِجَ","dan tangga","wamaʿārija",2449],["عَلَيْهَا","atasnya","ʿalayhā",8],["يَظْهَرُونَ","mereka menaiki","yaẓharūna",833]],"t":"Dan sekiranya bukan karena menghindarkan manusia menjadi umat yang satu (dalam kekafiran), pastilah sudah Kami buatkan bagi orang-orang yang kafir kepada (Allah) Yang Maha Pengasih, loteng-loteng rumah mereka dari perak, demikian pula tangga-tangga yang mereka naiki,"},{"n":34,"w":[["وَلِبُيُوتِهِمْ","dan bagi rumah-rumah mereka","walibuyūtihim",182],["أَبْوَٰبًۭا","pintu-pintu","abwāban",400],["وَسُرُرًا","dan ranjang/dipan","wasururan",1236],["عَلَيْهَا","atasnya","ʿalayhā",8],["يَتَّكِـُٔونَ","mereka bersandar","yattakiūna",4712]],"t":"dan (Kami buatkan pula) pintu-pintu (perak) bagi rumah-rumah mereka, dan (begitu pula) dipan-dipan tempat mereka bersandar,"},{"n":35,"w":[["وَزُخْرُفًۭا ۚ","dan perhiasan-perhiasan","wazukh'rufan",1694],["وَإِن","dan tidaklah","wa-in",14],["كُلُّ","semua","kullu",31],["ذَٰلِكَ","demikian itu","dhālika",19],["لَمَّا","melainkan","lammā",1878],["مَتَـٰعُ","kesenangan","matāʿu",331],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",148],["ٱلدُّنْيَا ۚ","dunia","l-dun'yā",101],["وَٱلْـَٔاخِرَةُ","dan akhirat","wal-ākhiratu",72],["عِندَ","di sisi","ʿinda",59],["رَبِّكَ","Tuhanmu","rabbika",10],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",245]],"t":"dan (Kami buatkan pula) perhiasan-perhiasan dari emas. Dan semuanya itu tidak lain hanyalah kesenangan kehidupan dunia, sedangkan kehidupan akhirat di sisi Tuhanmu disediakan bagi orang-orang yang bertakwa."},{"n":36,"w":[["وَمَن","dan barang siapa","waman",12],["يَعْشُ","berpaling","yaʿshu",4623],["عَن","dari","ʿan",21],["ذِكْرِ","mengingat","dhik'ri",147],["ٱلرَّحْمَـٰنِ","Maha Pengasih","l-raḥmāni",213],["نُقَيِّضْ","Kami tentukan","nuqayyiḍ",2589],["لَهُۥ","baginya","lahu",17],["شَيْطَـٰنًۭا","syaitan","shayṭānan",120],["فَهُوَ","maka ia/syaitan","fahuwa",20],["لَهُۥ","baginya","lahu",17],["قَرِينٌۭ","teman","qarīnun",1001]],"t":"Dan barangsiapa yang berpaling dari pengajaran Allah Yang Maha Pengasih (Alquran), Kami biarkan setan (menyesatkannya) dan menjadi teman karibnya."},{"n":37,"w":[["وَإِنَّهُمْ","dan sesungguhnya mereka","wa-innahum",5],["لَيَصُدُّونَهُمْ","benar-benar menghalangi mereka","layaṣuddūnahum",315],["عَنِ","dari","ʿani",21],["ٱلسَّبِيلِ","jalan","l-sabīli",64],["وَيَحْسَبُونَ","dan mereka mengira","wayaḥsabūna",266],["أَنَّهُم","bahwa sesungguhnya mereka","annahum",30],["مُّهْتَدُونَ","mendapat petunjuk","muh'tadūna",577]],"t":"Dan sungguh, mereka (setan-setan itu) benar-benar menghalang-halangi mereka dari jalan yang benar, sedang mereka menyangka bahwa mereka mendapat petunjuk."},{"n":38,"w":[["حَتَّىٰٓ","sehingga","ḥattā",80],["إِذَا","apabila","idhā",23],["جَآءَنَا","datang kepada Kami","jāanā",43],["قَالَ","dia berkata","qāla",6],["يَـٰلَيْتَ","seandainya","yālayta",670],["بَيْنِى","antara aku","baynī",47],["وَبَيْنَكَ","dan antara kamu","wabaynaka",47],["بُعْدَ","sejauh","buʿ'da",1070],["ٱلْمَشْرِقَيْنِ","dua masyrik/barat dan timur","l-mashriqayni",791],["فَبِئْسَ","maka sejahat-jahat","fabi'sa",290],["ٱلْقَرِينُ","teman","l-qarīnu",1001]],"t":"Sehingga apabila orang–orang yang berpaling itu datang kepada Kami (pada hari Kiamat) dia berkata, \"Wahai! Sekiranya (jarak) antara aku dan kamu seperti jarak antara timur dan barat! Memang (setan itu) teman yang paling jahat (bagi manusia).\""},{"n":39,"w":[["وَلَن","dan tidak","walan",109],["يَنفَعَكُمُ","memberi manfaat kepadamu","yanfaʿakumu",359],["ٱلْيَوْمَ","hari itu","l-yawma",25],["إِذ","apabila","idh",53],["ظَّلَمْتُمْ","kalian telah menganiaya","ẓalamtum",104],["أَنَّكُمْ","sesungguhnya kamu","annakum",30],["فِى","dalam","fī",3],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["مُشْتَرِكُونَ","orang-orang yang bersekutu","mush'tarikūna",2486]],"t":"Dan (harapanmu itu) sekali-kali tidak akan memberi manfaat kepadamu pada hari itu karena kamu telah menzalimi (dirimu sendiri). Sesungguhnya kamu pantas bersama-sama dalam azab itu."},{"n":40,"w":[["أَفَأَنتَ","apakah maka kamu","afa-anta",138],["تُسْمِعُ","dapat menjadikan mendengar","tus'miʿu",682],["ٱلصُّمَّ","orang yang tuli","l-ṣuma",714],["أَوْ","atau","aw",42],["تَهْدِى","kamu beri petunjuk","tahdī",79],["ٱلْعُمْىَ","orang yang buta","l-ʿum'ya",484],["وَمَن","dan orang","waman",12],["كَانَ","adalah","kāna",9],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",307],["مُّبِينٍۢ","nyata","mubīnin",99]],"t":"Maka apakah engkau (Muhammad) dapat menjadikan orang yang tuli bisa mendengar, atau (dapatkah) engkau memberi petunjuk kepada orang yang buta (hatinya), dan kepada orang yang tetap dalam kesesatan yang nyata?"},{"n":41,"w":[["فَإِمَّا","maka jika","fa-immā",450],["نَذْهَبَنَّ","sungguh Kami wafatkan","nadhhabanna",327],["بِكَ","dengan kamu","bika",137],["فَإِنَّا","maka sesungguhnya Kami","fa-innā",5],["مِنْهُم","dari mereka","min'hum",0],["مُّنتَقِمُونَ","orang-orang yang disiksa","muntaqimūna",1917]],"t":"Maka sungguh, sekiranya Kami mewafatkanmu (sebelum engkau mencapai kemenangan), maka sesungguhnya Kami akan tetap memberikan azab kepada mereka (di akhirat),"},{"n":42,"w":[["أَوْ","atau","aw",42],["نُرِيَنَّكَ","Kami perlihatkan kepadamu","nuriyannaka",288],["ٱلَّذِى","yang(azab)","alladhī",7],["وَعَدْنَـٰهُمْ","Kami ancamkan kepada kamu","waʿadnāhum",176],["فَإِنَّا","maka sesungguhnya Kami","fa-innā",5],["عَلَيْهِم","atas mereka","ʿalayhim",8],["مُّقْتَدِرُونَ","berkuasa","muq'tadirūna",1611]],"t":"atau Kami perlihatkan kepadamu (azab) yang telah Kami ancamkan kepada mereka. Maka sungguh, Kami berkuasa atas mereka."},{"n":43,"w":[["فَٱسْتَمْسِكْ","maka berpegang teguhlah kamu","fa-is'tamsik",2113],["بِٱلَّذِىٓ","kepada apa yang","bi-alladhī",7],["أُوحِىَ","diwahyukan","ūḥiya",163],["إِلَيْكَ ۖ","kepadamu","ilayka",13],["إِنَّكَ","sesungguhnya kamu","innaka",5],["عَلَىٰ","di atas","ʿalā",8],["صِرَٰطٍۢ","jalan","ṣirāṭin",260],["مُّسْتَقِيمٍۢ","lurus","mus'taqīmin",319]],"t":"Maka berpegang teguhlah engkau kepada (agama) yang telah diwahyukan kepadamu. Sungguh, engkau berada di jalan yang lurus."},{"n":44,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia","wa-innahu",5],["لَذِكْرٌۭ","benar-benar pengajaran","ladhik'run",147],["لَّكَ","bagimu","laka",137],["وَلِقَوْمِكَ ۖ","dan bagi kaummu","waliqawmika",27],["وَسَوْفَ","dan kelak","wasawfa",279],["تُسْـَٔلُونَ","kamu akan ditanya","tus'alūna",105]],"t":"Dan sungguh, Alquran itu benar-benar suatu peringatan bagimu dan bagi kaummu, dan kelak kamu akan diminta pertanggungjawaban."},{"n":45,"w":[["وَسْـَٔلْ","dan tanyakan","wasal",105],["مَنْ","orang(rasul-rasul)","man",12],["أَرْسَلْنَا","Kami utus","arsalnā",88],["مِن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["مِن","dari","min",0],["رُّسُلِنَآ","rasul-rasul Kami","rusulinā",35],["أَجَعَلْنَا","adakah Kami jadikan","ajaʿalnā",33],["مِن","dari","min",0],["دُونِ","selain","dūni",78],["ٱلرَّحْمَـٰنِ","Maha Pengasih","l-raḥmāni",213],["ءَالِهَةًۭ","tuhan-tuhan","ālihatan",74],["يُعْبَدُونَ","maka disembah","yuʿ'badūna",96]],"t":"Dan tanyakanlah (Muhammad) kepada rasul-rasul Kami yang telah Kami utus sebelum engkau, \"Apakah Kami menentukan tuhan-tuhan selain (Allah) Yang Maha Pengasih untuk disembah?\""},{"n":46,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",88],["مُوسَىٰ","Musa","mūsā",83],["بِـَٔايَـٰتِنَآ","dengan ayat-ayat Kami","biāyātinā",28],["إِلَىٰ","kepada","ilā",13],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",156],["وَمَلَإِي۟هِۦ","dan pemuka-pemukanya","wamala-ihi",366],["فَقَالَ","maka dia berkata","faqāla",6],["إِنِّى","sesungguhnya aku","innī",5],["رَسُولُ","utusan","rasūlu",35],["رَبِّ","Tuhan","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",158]],"t":"Dan sungguh, Kami telah mengutus Musa dengan membawa mukjizat-mukjizat Kami kepada Fir'aun dan pemuka-pemuka kaumnya. Maka dia (Musa) berkata, \"Sesungguhnya aku adalah utusan dari Tuhan seluruh alam.\""},{"n":47,"w":[["فَلَمَّا","maka tatkala","falammā",71],["جَآءَهُم","dia datang pada mereka","jāahum",43],["بِـَٔايَـٰتِنَآ","dengan ayat-ayat Kami","biāyātinā",28],["إِذَا","tiba-tiba","idhā",23],["هُم","mereka","hum",11],["مِّنْهَا","daripadanya","min'hā",0],["يَضْحَكُونَ","mereka mentertawakan","yaḍḥakūna",1048]],"t":"Maka ketika dia (Musa) datang kepada mereka membawa mukjizat-mukjizat Kami, seketika itu mereka menertawakannya."},{"n":48,"w":[["وَمَا","dan tidak","wamā",2],["نُرِيهِم","Kami perlihatkan pada mereka","nurīhim",288],["مِّنْ","dari","min",0],["ءَايَةٍ","suatu ayat","āyatin",28],["إِلَّا","kecuali","illā",15],["هِىَ","ia/ayat","hiya",190],["أَكْبَرُ","lebih besar","akbaru",435],["مِنْ","dari","min",0],["أُخْتِهَا ۖ","saudaranya","ukh'tihā",654],["وَأَخَذْنَـٰهُم","dan Kami timpakan kepada mereka","wa-akhadhnāhum",92],["بِٱلْعَذَابِ","dengan azab","bil-ʿadhābi",36],["لَعَلَّهُمْ","supaya mereka","laʿallahum",95],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",141]],"t":"Dan tidaklah Kami perlihatkan suatu mukjizat kepada mereka kecuali (mukjizat itu) lebih besar dari mukjizat-mukjizat (yang sebelumnya). Dan Kami timpakan kepada mereka azab agar mereka kembali (ke jalan yang benar)."},{"n":49,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["يَـٰٓأَيُّهَ","hai","yāayyuha",73],["ٱلسَّاحِرُ","ahli sihir","l-sāḥiru",475],["ٱدْعُ","berdo'alah kamu","ud'ʿu",65],["لَنَا","untuk kami","lanā",172],["رَبَّكَ","Tuhanmu","rabbaka",10],["بِمَا","dengan apa","bimā",2],["عَهِدَ","Dia janjikan","ʿahida",1157],["عِندَكَ","di sisimu","ʿindaka",59],["إِنَّنَا","sesungguhnya kami","innanā",5],["لَمُهْتَدُونَ","benar-benar mendapat petunjuk","lamuh'tadūna",577]],"t":"Dan mereka berkata, \"Wahai pesihir! berdoalah kepada Tuhanmu untuk (melepaskan) kami sesuai dengan apa yang telah dijanjikan-Nya kepadamu; sesungguhnya kami (jika doamu dikabulkan) akan menjadi orang yang mendapat petunjuk.\""},{"n":50,"w":[["فَلَمَّا","maka tatkala","falammā",71],["كَشَفْنَا","Kami hilangkan","kashafnā",665],["عَنْهُمُ","dari mereka","ʿanhumu",21],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["إِذَا","tiba-tiba","idhā",23],["هُمْ","mereka","hum",11],["يَنكُثُونَ","mereka memungkiri","yankuthūna",1220]],"t":"Maka ketika Kami hilangkan azab itu dari mereka, seketika itu (juga) mereka ingkar janji."},{"n":51,"w":[["وَنَادَىٰ","dan berseru","wanādā",270],["فِرْعَوْنُ","Fir'aun","fir'ʿawnu",156],["فِى","kepada","fī",3],["قَوْمِهِۦ","kaumnya","qawmihi",27],["قَالَ","dia berkata","qāla",6],["يَـٰقَوْمِ","wahai kaumku","yāqawmi",27],["أَلَيْسَ","bukankah","alaysa",119],["لِى","kepunyaanku","lī",179],["مُلْكُ","kerajaan","mul'ku",250],["مِصْرَ","Mesir","miṣ'ra",1364],["وَهَـٰذِهِ","dan ini","wahādhihi",37],["ٱلْأَنْهَـٰرُ","sungai-sungai","l-anhāru",222],["تَجْرِى","mengalir","tajrī",209],["مِن","dari","min",0],["تَحْتِىٓ ۖ","bawahku","taḥtī",235],["أَفَلَا","apakah maka tidak","afalā",4],["تُبْصِرُونَ","kamu melihat","tub'ṣirūna",371]],"t":"Dan Firaun berseru kepada kaumnya (seraya) berkata, \"Wahai kaumku! Bukankah kerajaan Mesir itu milikku dan (bukankah) sungai-sungai ini mengalir di bawahku; apakah kamu tidak melihat?"},{"n":52,"w":[["أَمْ","bukankah","am",82],["أَنَا۠","aku","anā",198],["خَيْرٌۭ","lebih baik","khayrun",62],["مِّنْ","dari","min",0],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang","alladhī",7],["هُوَ","ia","huwa",20],["مَهِينٌۭ","orang yang hina","mahīnun",1602],["وَلَا","dan tidak","walā",4],["يَكَادُ","hampir","yakādu",442],["يُبِينُ","ia menjelaskan","yubīnu",4735]],"t":"Bukankah aku lebih baik dari orang (Musa) yang hina ini dan yang hampir tidak dapat menjelaskan (perkataannya)?"},{"n":53,"w":[["فَلَوْلَآ","maka mengapa tidak","falawlā",152],["أُلْقِىَ","dilemparkan","ul'qiya",167],["عَلَيْهِ","kepadanya","ʿalayhi",8],["أَسْوِرَةٌۭ","gelang","aswiratun",1283],["مِّن","dari","min",0],["ذَهَبٍ","emas","dhahabin",952],["أَوْ","atau","aw",42],["جَآءَ","datang","jāa",43],["مَعَهُ","bersama ia","maʿahu",69],["ٱلْمَلَـٰٓئِكَةُ","malaikat","l-malāikatu",122],["مُقْتَرِنِينَ","menyertai","muq'tarinīna",3856]],"t":"Maka mengapa dia (Musa) tidak dipakaikan gelang dari emas, atau malaikat datang bersama-sama dia untuk mengiringkannya?\""},{"n":54,"w":[["فَٱسْتَخَفَّ","maka ia meremehkan","fa-is'takhaffa",2115],["قَوْمَهُۥ","kaumnya","qawmahu",27],["فَأَطَاعُوهُ ۚ","lalu mereka patuh kepadanya","fa-aṭāʿūhu",161],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["قَوْمًۭا","kaum","qawman",27],["فَـٰسِقِينَ","orang-orang yang fasik","fāsiqīna",317]],"t":"Maka (Firaun) dengan perkataan itu telah mempengaruhi kaumnya, sehingga mereka patuh kepadanya. Sungguh, mereka adalah kaum yang fasik."},{"n":55,"w":[["فَلَمَّآ","maka tatkala","falammā",71],["ءَاسَفُونَا","mereka membuat Kami murka","āsafūnā",2915],["ٱنتَقَمْنَا","Kami hukum","intaqamnā",1264],["مِنْهُمْ","dari mereka","min'hum",0],["فَأَغْرَقْنَـٰهُمْ","lalu Kami tenggelamkan mereka","fa-aghraqnāhum",567],["أَجْمَعِينَ","semua","ajmaʿīna",412]],"t":"Maka ketika mereka membuat Kami murka, Kami hukum mereka, lalu Kami tenggelamkan mereka semuanya (di laut),"},{"n":56,"w":[["فَجَعَلْنَـٰهُمْ","maka Kami jadikan mereka","fajaʿalnāhum",33],["سَلَفًۭا","terdahulu","salafan",4271],["وَمَثَلًۭا","dan perumpamaan","wamathalan",123],["لِّلْـَٔاخِرِينَ","bagi orang-orang yang kemudian","lil'ākhirīna",72]],"t":"maka Kami jadikan mereka sebagai (kaum) terdahulu, dan pelajaran bagi orang-orang yang kemudian."},{"n":57,"w":[["۞ وَلَمَّا","dan tatkala","walammā",71],["ضُرِبَ","dijadikan","ḍuriba",219],["ٱبْنُ","anak","ub'nu",194],["مَرْيَمَ","Maryam","maryama",341],["مَثَلًا","perumpamaan","mathalan",123],["إِذَا","tiba-tiba","idhā",23],["قَوْمُكَ","kaummu","qawmuka",27],["مِنْهُ","karenanya","min'hu",0],["يَصِدُّونَ","mereka gempar/bersorak","yaṣiddūna",315]],"t":"Dan ketika putra Maryam (Isa) dijadikan perumpamaan, tiba-tiba kaummu (Suku Quraisy) bersorak karenanya."},{"n":58,"w":[["وَقَالُوٓا۟","dan mereka berkata","waqālū",6],["ءَأَـٰلِهَتُنَا","apakah Tuhan kami","aālihatunā",74],["خَيْرٌ","lebih baik","khayrun",62],["أَمْ","atau","am",82],["هُوَ ۚ","dia","huwa",20],["مَا","tidak","mā",2],["ضَرَبُوهُ","mereka menjadikannya","ḍarabūhu",219],["لَكَ","bagimu","laka",137],["إِلَّا","kecuali","illā",15],["جَدَلًۢا ۚ","bantahan","jadalan",2402],["بَلْ","bahkan","bal",93],["هُمْ","mereka","hum",11],["قَوْمٌ","kaum","qawmun",27],["خَصِمُونَ","mereka bertengkar","khaṣimūna",4581]],"t":"Dan mereka berkata, \"Manakah yang lebih baik, tuhan-tuhan kami atau dia (Isa)?\" Mereka tidak memberikan (perumpamaan itu) kepadamu melainkan dengan maksud membantah saja; sebenarnya mereka adalah kaum yang suka bertengkar."},{"n":59,"w":[["إِنْ","tidak lain","in",14],["هُوَ","dia","huwa",20],["إِلَّا","kecuali","illā",15],["عَبْدٌ","seorang hamba","ʿabdun",87],["أَنْعَمْنَا","Kami beri nikmat","anʿamnā",566],["عَلَيْهِ","atasnya","ʿalayhi",8],["وَجَعَلْنَـٰهُ","dan Kami jadikan dia","wajaʿalnāhu",33],["مَثَلًۭا","perumpamaan","mathalan",123],["لِّبَنِىٓ","bagi Bani","libanī",140],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",271]],"t":"Dia (Isa) tidak lain hanyalah seorang hamba yang Kami berikan nikmat (kenabian) kepadanya, dan Kami jadikan dia sebagai contoh bagi Bani Israil."},{"n":60,"w":[["وَلَوْ","dan jika","walaw",57],["نَشَآءُ","Kami menghendaki","nashāu",54],["لَجَعَلْنَا","niscaya Kami jadikan","lajaʿalnā",33],["مِنكُم","dari kamu","minkum",0],["مَّلَـٰٓئِكَةًۭ","malaikat-malaikat","malāikatan",122],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["يَخْلُفُونَ","mereka menggantikan","yakhlufūna",1425]],"t":"Dan sekiranya Kami menghendaki, niscaya ada di antara kamu yang Kami jadikan malaikat-malaikat (yang turun temurun) sebagai pengganti kamu di bumi."},{"n":61,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia","wa-innahu",5],["لَعِلْمٌۭ","benar-benar pengetahuan","laʿil'mun",108],["لِّلسَّاعَةِ","tentang hari kiamat","lilssāʿati",251],["فَلَا","maka janganlah","falā",4],["تَمْتَرُنَّ","kamu ragu-ragu","tamtarunna",1438],["بِهَا","dengannya","bihā",103],["وَٱتَّبِعُونِ ۚ","dan ikutilah Aku","wa-ittabiʿūni",84],["هَـٰذَا","ini","hādhā",37],["صِرَٰطٌۭ","jalan","ṣirāṭun",260],["مُّسْتَقِيمٌۭ","lurus","mus'taqīmun",319]],"t":"Dan sungguh, dia (Isa) benar-benar menjadi pertanda akan datangnya hari Kiamat. Karena itu, janganlah kamu ragu-ragu tentang (Kiamat) itu dan ikutilah Aku. Inilah jalan yang lurus."},{"n":62,"w":[["وَلَا","dan jangan","walā",4],["يَصُدَّنَّكُمُ","memalingkan kamu","yaṣuddannakumu",315],["ٱلشَّيْطَـٰنُ ۖ","syaitan","l-shayṭānu",120],["إِنَّهُۥ","sesungguhnya dia","innahu",5],["لَكُمْ","bagi kalian","lakum",26],["عَدُوٌّۭ","musuh","ʿaduwwun",236],["مُّبِينٌۭ","nyata","mubīnun",99]],"t":"Dan janganlah kamu sekali-kali dipalingkan oleh setan; sungguh, setan itu musuh yang nyata bagimu."},{"n":63,"w":[["وَلَمَّا","dan tatkala","walammā",71],["جَآءَ","datang","jāa",43],["عِيسَىٰ","'Isa","ʿīsā",423],["بِٱلْبَيِّنَـٰتِ","dengan keterangan","bil-bayināti",169],["قَالَ","dia berkata","qāla",6],["قَدْ","sesungguhnya","qad",24],["جِئْتُكُم","aku datang kepadamu","ji'tukum",43],["بِٱلْحِكْمَةِ","dengan hikmah","bil-ḥik'mati",510],["وَلِأُبَيِّنَ","dan untuk aku jelaskan","wali-ubayyina",330],["لَكُم","bagi kalian","lakum",26],["بَعْضَ","sebagian","baʿḍa",70],["ٱلَّذِى","yang","alladhī",7],["تَخْتَلِفُونَ","kamu perselisihkan","takhtalifūna",337],["فِيهِ ۖ","didalamnya","fīhi",3],["فَٱتَّقُوا۟","maka bertakwalah","fa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["وَأَطِيعُونِ","dan taatilah aku","wa-aṭīʿūni",161]],"t":"Dan ketika Isa datang membawa keterangan, dia berkata, \"Sungguh, aku datang kepadamu dengan membawa hikmah, dan untuk menjelaskan kepadamu sebagian dari apa yang kamu perselisihkan; maka bertakwalah kepada Allah dan taatlah kepadaku."},{"n":64,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["هُوَ","Dia","huwa",20],["رَبِّى","Tuhanku","rabbī",10],["وَرَبُّكُمْ","dan Tuhanmu","warabbukum",10],["فَٱعْبُدُوهُ ۚ","maka sembahlah Dia","fa-uʿ'budūhu",96],["هَـٰذَا","ini","hādhā",37],["صِرَٰطٌۭ","jalan","ṣirāṭun",260],["مُّسْتَقِيمٌۭ","lurus","mus'taqīmun",319]],"t":"Sungguh, Allah, Dia Tuhanku dan Tuhanmu, maka sembahlah Dia. Ini adalah jalan yang lurus.\""},{"n":65,"w":[["فَٱخْتَلَفَ","maka berselisih","fa-ikh'talafa",337],["ٱلْأَحْزَابُ","beberapa golongan","l-aḥzābu",511],["مِنۢ","dari","min",0],["بَيْنِهِمْ ۖ","antara mereka","baynihim",47],["فَوَيْلٌۭ","maka kecelakaanlah","fawaylun",294],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["ظَلَمُوا۟","zalim","ẓalamū",104],["مِنْ","dari","min",0],["عَذَابِ","azab","ʿadhābi",36],["يَوْمٍ","hari","yawmin",25],["أَلِيمٍ","pedih","alīmin",162]],"t":"Tetapi golongan-golongan (yang ada) saling berselisih di antara mereka; maka celakalah orang-orang yang zalim karena azab pada hari yang pedih (Kiamat)."},{"n":66,"w":[["هَلْ","tidakkah","hal",115],["يَنظُرُونَ","mereka menunggu","yanẓurūna",124],["إِلَّا","kecuali","illā",15],["ٱلسَّاعَةَ","hari kiamat","l-sāʿata",251],["أَن","bahwa","an",16],["تَأْتِيَهُم","ia datang kepada mereka","tatiyahum",48],["بَغْتَةًۭ","dengan tiba-tiba","baghtatan",687],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يَشْعُرُونَ","mereka menyadari","yashʿurūna",433]],"t":"Apakah mereka hanya menunggu saja kedatangan hari Kiamat yang datang kepada mereka secara mendadak, sedang mereka tidak menyadarinya?"},{"n":67,"w":[["ٱلْأَخِلَّآءُ","sahabat-sahabat akrab","al-akhilāu",1669],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",177],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",70],["لِبَعْضٍ","bagi sebagian","libaʿḍin",70],["عَدُوٌّ","musuh","ʿaduwwun",236],["إِلَّا","kecuali","illā",15],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",245]],"t":"Teman-teman karib pada hari itu saling bermusuhan satu sama lain, kecuali mereka yang bertakwa."},{"n":68,"w":[["يَـٰعِبَادِ","hai hamba-hambaKu","yāʿibādi",87],["لَا","tidak ada","lā",4],["خَوْفٌ","ketakutan","khawfun",419],["عَلَيْكُمُ","atas kalian","ʿalaykumu",8],["ٱلْيَوْمَ","pada hari itu","l-yawma",25],["وَلَآ","dan tidak","walā",4],["أَنتُمْ","kamu","antum",85],["تَحْزَنُونَ","kamu bersedih","taḥzanūna",322]],"t":"\"Wahai hamba-hamba-Ku! Tidak ada ketakutan bagimu pada hari itu, dan tidak pula kamu bersedih hati."},{"n":69,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["بِـَٔايَـٰتِنَا","kepada ayat-ayat Kami","biāyātinā",28],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["مُسْلِمِينَ","orang-orang yang berserah diri","mus'limīna",304]],"t":"(Yaitu) orang-orang yang beriman kepada ayat-ayat Kami dan mereka berserah diri."},{"n":70,"w":[["ٱدْخُلُوا۟","masuklah","ud'khulū",149],["ٱلْجَنَّةَ","surga","l-janata",76],["أَنتُمْ","kamu","antum",85],["وَأَزْوَٰجُكُمْ","dan isteri-isterimu","wa-azwājukum",150],["تُحْبَرُونَ","kamu digembirakan","tuḥ'barūna",2808]],"t":"Masuklah kamu ke dalam surga, kamu dan pasanganmu akan digembirakan.\""},{"n":71,"w":[["يُطَافُ","dikelilingi","yuṭāfu",969],["عَلَيْهِم","kepada mereka","ʿalayhim",8],["بِصِحَافٍۢ","dengan piring-piring","biṣiḥāfin",3279],["مِّن","dari","min",0],["ذَهَبٍۢ","emas","dhahabin",952],["وَأَكْوَابٍۢ ۖ","dan piala-piala","wa-akwābin",1475],["وَفِيهَا","dan didalamnya(surga)","wafīhā",3],["مَا","apa yang","mā",2],["تَشْتَهِيهِ","diingininya","tashtahīhi",1024],["ٱلْأَنفُسُ","jiwa/hati","l-anfusu",39],["وَتَلَذُّ","dan sedap","wataladhu",4403],["ٱلْأَعْيُنُ ۖ","mata","l-aʿyunu",208],["وَأَنتُمْ","dan kalian","wa-antum",85],["فِيهَا","didalamnya","fīhā",3],["خَـٰلِدُونَ","mereka kekal","khālidūna",157]],"t":"Kepada mereka diedarkan piring-piring dan gelas-gelas dari emas, dan di dalam surga itu terdapat apa yang diingini oleh hati dan segala yang sedap (dipandang) mata. Dan kamu kekal di dalamnya."},{"n":72,"w":[["وَتِلْكَ","dan itulah","watil'ka",19],["ٱلْجَنَّةُ","surga","l-janatu",76],["ٱلَّتِىٓ","yang","allatī",7],["أُورِثْتُمُوهَا","diwariskan kepadanya","ūrith'tumūhā",718],["بِمَا","sebab","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Dan itulah surga yang diwariskan kepada kamu karena perbuatan yang telah kamu kerjakan."},{"n":73,"w":[["لَكُمْ","bagi kalian","lakum",26],["فِيهَا","didalamnya","fīhā",3],["فَـٰكِهَةٌۭ","buah-buahan","fākihatun",783],["كَثِيرَةٌۭ","banyak","kathīratun",789],["مِّنْهَا","daripadanya","min'hā",0],["تَأْكُلُونَ","kamu makan","takulūna",114]],"t":"Di dalam surga itu terdapat banyak buah-buahan untukmu yang sebagiannya kamu makan."},{"n":74,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",229],["فِى","dalam","fī",3],["عَذَابِ","azab","ʿadhābi",36],["جَهَنَّمَ","neraka jahanam","jahannama",146],["خَـٰلِدُونَ","mereka kekal","khālidūna",157]],"t":"Sungguh, orang-orang yang berdosa itu kekal di dalam azab neraka Jahanam."},{"n":75,"w":[["لَا","tidak","lā",4],["يُفَتَّرُ","diringankan","yufattaru",4738],["عَنْهُمْ","dari mereka","ʿanhum",21],["وَهُمْ","dan mereka","wahum",11],["فِيهِ","didalamnya","fīhi",3],["مُبْلِسُونَ","orang-orang yang berputus asa","mub'lisūna",1595]],"t":"Tidak diringankan (azab) itu dari mereka, dan mereka berputus asa di dalamnya."},{"n":76,"w":[["وَمَا","dan tidaklah","wamā",2],["ظَلَمْنَـٰهُمْ","Kami menganiaya mereka","ẓalamnāhum",104],["وَلَـٰكِن","tetapi","walākin",160],["كَانُوا۟","adalah mereka","kānū",9],["هُمُ","mereka","humu",11],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim/aniaya","l-ẓālimīna",89]],"t":"Dan tidaklah Kami menzalimi mereka, tetapi merekalah yang menzalimi diri mereka sendiri."},{"n":77,"w":[["وَنَادَوْا۟","dan mereka berseru","wanādaw",270],["يَـٰمَـٰلِكُ","hai Malik","yāmāliku",3670],["لِيَقْضِ","hendaklah mengakhiri","liyaqḍi",205],["عَلَيْنَا","atas kami","ʿalaynā",8],["رَبُّكَ ۖ","Tuhanmu","rabbuka",10],["قَالَ","ia berkata","qāla",6],["إِنَّكُم","sesungguhnya kalian","innakum",5],["مَّـٰكِثُونَ","orang-orang yang tetap tinggal","mākithūna",2528]],"t":"Dan mereka berseru, \"Wahai (Malaikat) Malik! Biarlah Tuhanmu mematikan kami saja.\" Dia menjawab, \"Sungguh, kamu akan tetap tinggal (di neraka ini).\""},{"n":78,"w":[["لَقَدْ","sesungguhnya","laqad",24],["جِئْنَـٰكُم","Kami datang kepadamu","ji'nākum",43],["بِٱلْحَقِّ","dengan kebenaran","bil-ḥaqi",50],["وَلَـٰكِنَّ","tetapi","walākinna",210],["أَكْثَرَكُمْ","kebanyakan kamu","aktharakum",139],["لِلْحَقِّ","pada kebenaran","lil'ḥaqqi",50],["كَـٰرِهُونَ","benci","kārihūna",1086]],"t":"Sungguh, Kami telah datang membawa kebenaran kepada kamu, tetapi kebanyakan di antara kamu benci pada kebenaran itu."},{"n":79,"w":[["أَمْ","bahkan","am",82],["أَبْرَمُوٓا۟","mereka menetapkan","abramū",2984],["أَمْرًۭا","suatu perkara","amran",66],["فَإِنَّا","maka sesungguhnya Kami","fa-innā",5],["مُبْرِمُونَ","menetapkan","mub'rimūna",3808]],"t":"Ataukah mereka telah merencanakan suatu tipu daya (jahat), maka sesungguhnya Kami telah berencana (mengatasi tipu daya mereka)."},{"n":80,"w":[["أَمْ","atau","am",82],["يَحْسَبُونَ","mereka mengira","yaḥsabūna",266],["أَنَّا","bahwasanya kami","annā",30],["لَا","tidak","lā",4],["نَسْمَعُ","mendengar","nasmaʿu",143],["سِرَّهُمْ","rahasia mereka","sirrahum",804],["وَنَجْوَىٰهُم ۚ","dan bisik-bisik mereka","wanajwāhum",798],["بَلَىٰ","ya/sebenarnya","balā",465],["وَرُسُلُنَا","dan utusan-utusan Kami","warusulunā",35],["لَدَيْهِمْ","di sisi mereka","ladayhim",517],["يَكْتُبُونَ","mereka tulis","yaktubūna",244]],"t":"Ataukah mereka mengira bahwa Kami tidak mendengar rahasia dan bisikan-bisikan mereka? Sebenarnya (Kami mendengar), dan utusan-utusan Kami (malaikat) selalu mencatat di sisi mereka."},{"n":81,"w":[["قُلْ","katakanlah","qul",6],["إِن","jika","in",14],["كَانَ","adalah","kāna",9],["لِلرَّحْمَـٰنِ","bagi Yang Maha Pengasih","lilrraḥmāni",213],["وَلَدٌۭ","seorang anak","waladun",217],["فَأَنَا۠","maka aku","fa-anā",198],["أَوَّلُ","pertama-tama","awwalu",136],["ٱلْعَـٰبِدِينَ","orang yang menyembah","l-ʿābidīna",769]],"t":"Katakanlah (Muhammad), \"Jika benar Tuhan Yang Maha Pengasih mempunyai anak, maka akulah orang yang mula-mula memuliakan (anak itu)."},{"n":82,"w":[["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",286],["رَبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["رَبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلْعَرْشِ","'Arsy","l-ʿarshi",373],["عَمَّا","dari apa","ʿammā",21],["يَصِفُونَ","mereka sifatkan","yaṣifūna",705]],"t":"Mahasuci Tuhan pemilik langit dan bumi, Tuhan pemilik Arasy, dari apa yang mereka sifatkan itu.\""},{"n":83,"w":[["فَذَرْهُمْ","maka biarkanlah mereka","fadharhum",263],["يَخُوضُوا۟","mereka sesat","yakhūḍū",935],["وَيَلْعَبُوا۟","dan mereka bermain-main","wayalʿabū",939],["حَتَّىٰ","sehingga","ḥattā",80],["يُلَـٰقُوا۟","mereka menemui","yulāqū",2084],["يَوْمَهُمُ","hari mereka","yawmahumu",25],["ٱلَّذِى","yang","alladhī",7],["يُوعَدُونَ","mereka dijanjikan","yūʿadūna",176]],"t":"Maka biarkanlah mereka tenggelam (dalam kesesatan) dan bermain-main sampai mereka menemui hari yang dijanjikan kepada mereka."},{"n":84,"w":[["وَهُوَ","dan Dia","wahuwa",20],["ٱلَّذِى","yang","alladhī",7],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["إِلَـٰهٌۭ","Tuhan","ilāhun",74],["وَفِى","dan di","wafī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["إِلَـٰهٌۭ ۚ","Tuhan","ilāhun",74],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",112],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Dan Dialah Tuhan (yang disembah) di langit dan Tuhan (yang disembah) di bumi, dan Dialah Yang Mahabijaksana, Maha Mengetahui."},{"n":85,"w":[["وَتَبَارَكَ","dan Maha Suci Engkau","watabāraka",930],["ٱلَّذِى","yang","alladhī",7],["لَهُۥ","bagi-Nya","lahu",17],["مُلْكُ","kerajaan","mul'ku",250],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa yang","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["وَعِندَهُۥ","dan di sisi-Nya","waʿindahu",59],["عِلْمُ","pengetahuan","ʿil'mu",108],["ٱلسَّاعَةِ","hari kiamat","l-sāʿati",251],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",141]],"t":"Dan Mahasuci (Allah) yang memiliki kerajaan langit dan bumi, dan apa yang ada di antara keduanya; dan di sisi-Nyalah ilmu tentang hari Kiamat, dan hanya kepada-Nyalah kamu dikembalikan."},{"n":86,"w":[["وَلَا","dan tidak","walā",4],["يَمْلِكُ","memiliki","yamliku",268],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَدْعُونَ","mereka sembah","yadʿūna",65],["مِن","dari","min",0],["دُونِهِ","selain","dūnihi",78],["ٱلشَّفَـٰعَةَ","pertolongan/syafa'at","l-shafāʿata",679],["إِلَّا","kecuali","illā",15],["مَن","orang","man",12],["شَهِدَ","dia menyaksikan/mengakui","shahida",264],["بِٱلْحَقِّ","dengan yang benar","bil-ḥaqi",50],["وَهُمْ","dan mereka","wahum",11],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Dan orang-orang yang menyeru kepada selain Allah tidak mendapat syafaat (pertolongan di akhirat); kecuali orang yang mengakui yang hak (tauhid) dan mereka meyakini."},{"n":87,"w":[["وَلَئِن","dan jika","wala-in",14],["سَأَلْتَهُم","kamu bertanya pada mereka","sa-altahum",105],["مَّنْ","siapa","man",12],["خَلَقَهُمْ","menciptakan mereka","khalaqahum",60],["لَيَقُولُنَّ","tentu mereka mengatakan","layaqūlunna",6],["ٱللَّهُ ۖ","Allah","l-lahu",1],["فَأَنَّىٰ","maka bagaimana","fa-annā",385],["يُؤْفَكُونَ","mereka dipalingkan","yu'fakūna",591]],"t":"Dan jika engkau bertanya kepada mereka, siapakah yang menciptakan mereka, niscaya mereka menjawab, Allah; jadi bagaimana mereka dapat dipalingkan (dari menyembah Allah),"},{"n":88,"w":[["وَقِيلِهِۦ","dan perkataannya","waqīlihi",1628],["يَـٰرَبِّ","wahai Tuhanku","yārabbi",10],["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["قَوْمٌۭ","kaum","qawmun",27],["لَّا","tidak","lā",4],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18]],"t":"dan (Allah mengetahui) ucapannya (Muhammad), \"Ya Tuhanku, sesungguhnya mereka itu adalah kaum yang tidak beriman.\""},{"n":89,"w":[["فَٱصْفَحْ","maka maafkanlah","fa-iṣ'faḥ",1256],["عَنْهُمْ","dari mereka","ʿanhum",21],["وَقُلْ","dan katakanlah","waqul",6],["سَلَـٰمٌۭ ۚ","selamat/sejahtera","salāmun",278],["فَسَوْفَ","maka kelak","fasawfa",279],["يَعْلَمُونَ","mereka akan mengetahui","yaʿlamūna",29]],"t":"Maka berpalinglah dari mereka dan katakanlah, \"Salam (selamat tinggal).\" Kelak mereka akan mengetahui (nasib mereka yang buruk)."}]