[{"n":1,"w":[["صٓ ۚ","shad","sad",3216],["وَٱلْقُرْءَانِ","demi Al Quran","wal-qur'āni",178],["ذِى","mempunyai","dhī",116],["ٱلذِّكْرِ","peringatan","l-dhik'ri",152]],"t":"1. Ṣād, demi Alquran yang mengandung peringatan."},{"n":2,"w":[["بَلِ","bahkan/tetapi","bali",96],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["فِى","dalam","fī",3],["عِزَّةٍۢ","kesombongan","ʿizzatin",771],["وَشِقَاقٍۢ","dan perpecahan","washiqāqin",1023]],"t":"2. Tetapi orang-orang yang kafir (berada) dalam kesombongan dan permusuhan."},{"n":3,"w":[["كَمْ","berapa banyak","kam",484],["أَهْلَكْنَا","Kami telah binasakan","ahlaknā",231],["مِن","dari","min",0],["قَبْلِهِم","sebelum mereka","qablihim",51],["مِّن","dari","min",0],["قَرْنٍۢ","kurun","qarnin",454],["فَنَادَوا۟","lalu mereka menyeru/meminta","fanādaw",269],["وَّلَاتَ","pertolongan","walāta",2431],["حِينَ","waktu","ḥīna",330],["مَنَاصٍۢ","kelepasan (melepaskan diri)","manāṣin",3720]],"t":"3. Betapa banyak umat sebelum mereka yang telah Kami binasakan, lalu mereka meminta tolong padahal (waktu itu) bukanlah saat untuk lari melepaskan diri."},{"n":4,"w":[["وَعَجِبُوٓا۟","dan mereka heran","waʿajibū",956],["أَن","karena","an",17],["جَآءَهُم","datang kepada mereka","jāahum",43],["مُّنذِرٌۭ","seorang pemberi peringatan","mundhirun",630],["مِّنْهُمْ ۖ","dari mereka","min'hum",0],["وَقَالَ","dan berkata","waqāla",6],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",70],["هَـٰذَا","ini","hādhā",37],["سَـٰحِرٌۭ","seorang ahli sihir","sāḥirun",472],["كَذَّابٌ","pendusta","kadhābun",1350]],"t":"Dan mereka heran karena mereka kedatangan seorang pemberi peringatan (rasul) dari kalangan mereka; dan orang-orang kafir berkata, \"Orang ini adalah pesihir yang banyak berdusta.\""},{"n":5,"w":[["أَجَعَلَ","apakah dia menjadikan","ajaʿala",33],["ٱلْـَٔالِهَةَ","tuhan-tuhan","l-ālihata",75],["إِلَـٰهًۭا","Tuhan","ilāhan",75],["وَٰحِدًا ۖ","satu/esa","wāḥidan",373],["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["لَشَىْءٌ","benar-benar sesuatu","lashayon",41],["عُجَابٌۭ","aneh/ganjil","ʿujābun",3134]],"t":"Apakah dia menjadikan tuhan-tuhan itu Tuhan yang satu saja? Sungguh, ini benar-benar sesuatu yang sangat mengherankan."},{"n":6,"w":[["وَٱنطَلَقَ","dan pergilah","wa-inṭalaqa",942],["ٱلْمَلَأُ","pembesar-pembesar","l-mala-u",370],["مِنْهُمْ","dari mereka","min'hum",0],["أَنِ","maka","ani",17],["ٱمْشُوا۟","berjalanlah kamu","im'shū",486],["وَٱصْبِرُوا۟","dan bersabarlah","wa-iṣ'birū",203],["عَلَىٰٓ","atas","ʿalā",8],["ءَالِهَتِكُمْ ۖ","tuhan-tuhan kamu","ālihatikum",75],["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["لَشَىْءٌۭ","benar-benar sesuatu","lashayon",41],["يُرَادُ","dikehendaki","yurādu",83]],"t":"Lalu pergilah pemimpin-pemimpin mereka (seraya berkata), \"Pergilah kamu dan tetaplah (menyembah) tuhan-tuhanmu, sesungguhnya ini benar-benar suatu hal yang dikehendaki."},{"n":7,"w":[["مَا","tidak","mā",2],["سَمِعْنَا","kami mendengar","samiʿ'nā",148],["بِهَـٰذَا","dengan/hal ini","bihādhā",37],["فِى","dalam","fī",3],["ٱلْمِلَّةِ","agama","l-milati",629],["ٱلْـَٔاخِرَةِ","yang akhir","l-ākhirati",73],["إِنْ","tidaklah","in",14],["هَـٰذَآ","ini","hādhā",37],["إِلَّا","kecuali","illā",15],["ٱخْتِلَـٰقٌ","diada-adakan","ikh'tilāqun",4687]],"t":"Kami tidak pernah mendengar hal ini dalam agama yang terakhir, ini (mengesakan Allah), tidak lain hanyalah (dusta) yang diada-adakan,"},{"n":8,"w":[["أَءُنزِلَ","apakah diturunkan","a-unzila",62],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",8],["ٱلذِّكْرُ","pengajaran/Al Quran","l-dhik'ru",152],["مِنۢ","dari","min",0],["بَيْنِنَا ۚ","antara kita","bayninā",47],["بَلْ","bahkan/sebenarnya","bal",96],["هُمْ","mereka","hum",11],["فِى","dalam","fī",3],["شَكٍّۢ","keragu-raguan","shakkin",610],["مِّن","dari","min",0],["ذِكْرِى ۖ","peringatan-Ku","dhik'rī",152],["بَل","bahkan/sebenarnya","bal",96],["لَّمَّا","belum","lammā",32],["يَذُوقُوا۟","mereka merasakan","yadhūqū",324],["عَذَابِ","azab-Ku","ʿadhābi",36]],"t":"mengapa Alquran itu diturunkan kepada Dia di antara kita?\" Sebenarnya mereka ragu-ragu terhadap Alquran-Ku, tetapi mereka belum merasakan azab(-Ku)."},{"n":9,"w":[["أَمْ","ataukah/apakah","am",84],["عِندَهُمْ","disisi mereka/mereka mempunyai","ʿindahum",59],["خَزَآئِنُ","perbendaharaan","khazāinu",1010],["رَحْمَةِ","rahmat","raḥmati",105],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",113],["ٱلْوَهَّابِ","Maha Pemberi","l-wahābi",2037]],"t":"Atau apakah mereka itu mempunyai perbendaharaan rahmat Tuhanmu Yang Mahaperkasa, Maha Pemberi?"},{"n":10,"w":[["أَمْ","ataukah/apakah","am",84],["لَهُم","bagi mereka","lahum",11],["مُّلْكُ","kerajaan","mul'ku",250],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا ۖ","diantara keduanya","baynahumā",47],["فَلْيَرْتَقُوا۟","maka hendaklah mereka menaiki","falyartaqū",4648],["فِى","pada","fī",3],["ٱلْأَسْبَـٰبِ","jalan/tangga-tangga","l-asbābi",927]],"t":"Atau apakah mereka mempunyai kerajaan langit dan bumi dan apa yang ada di antara keduanya? (Jika ada), maka biarlah mereka menaiki tangga-tangga (ke langit)."},{"n":11,"w":[["جُندٌۭ","bala tentara","jundun",379],["مَّا","apa","mā",2],["هُنَالِكَ","ada disana","hunālika",904],["مَهْزُومٌۭ","dibinasakan/dikalahkan","mahzūmun",3702],["مِّنَ","dari","mina",0],["ٱلْأَحْزَابِ","golongan yang berserikat","l-aḥzābi",506]],"t":"(Mereka itu) kelompok besar bala tentara yang berada di sana yang akan dikalahkan."},{"n":12,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["قَبْلَهُمْ","sebelum mereka","qablahum",51],["قَوْمُ","kaum","qawmu",27],["نُوحٍۢ","Nuh","nūḥin",273],["وَعَادٌۭ","dan 'Ad","waʿādun",434],["وَفِرْعَوْنُ","dan Fir'aun","wafir'ʿawnu",160],["ذُو","mempunyai","dhū",116],["ٱلْأَوْتَادِ","bala tentara","l-awtādi",2042]],"t":"Sebelum mereka itu, kaum Nuh, 'Ād dan Fir'aun yang mempunyai bala tentara yang banyak, juga telah mendustakan (rasul-rasul),"},{"n":13,"w":[["وَثَمُودُ","dan Samud","wathamūdu",415],["وَقَوْمُ","dan kaum","waqawmu",27],["لُوطٍۢ","Lut","lūṭin",401],["وَأَصْحَـٰبُ","dan penduduk","wa-aṣḥābu",122],["لْـَٔيْكَةِ ۚ","Aikah","al'aykati",1485],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["ٱلْأَحْزَابُ","golongan yang bersekutu","l-aḥzābu",506]],"t":"dan (begitu juga) Samud, kaum Luṭ dan penduduk Aikah. Mereka itulah golongan-golongan yang bersekutu (menentang rasul-rasul)."},{"n":14,"w":[["إِن","tidak lain","in",14],["كُلٌّ","semua itu","kullun",31],["إِلَّا","kecuali","illā",15],["كَذَّبَ","telah mendustakan","kadhaba",63],["ٱلرُّسُلَ","Rasul-rasul","l-rusula",35],["فَحَقَّ","maka pastilah","faḥaqqa",504],["عِقَابِ","azab-Ku","ʿiqābi",502]],"t":"Semua mereka itu mendustakan rasul-rasul, maka pantas mereka merasakan azab-Ku."},{"n":15,"w":[["وَمَا","dan tidak","wamā",2],["يَنظُرُ","menunggu","yanẓuru",129],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["إِلَّا","melainkan","illā",15],["صَيْحَةًۭ","suara keras/teriakan","ṣayḥatan",680],["وَٰحِدَةًۭ","satu kali","wāḥidatan",364],["مَّا","tidak","mā",2],["لَهَا","bagi mereka","lahā",97],["مِن","dari","min",0],["فَوَاقٍۢ","ulangan/tangguh","fawāqin",3449]],"t":"Dan sebenarnya yang mereka tunggu adalah satu teriakan saja, yang tidak ada selanya."},{"n":16,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["رَبَّنَا","ya Tuhan kami","rabbanā",10],["عَجِّل","segerakanlah","ʿajjil",1287],["لَّنَا","untuk kami","lanā",125],["قِطَّنَا","bahagian kami","qiṭṭanā",4132],["قَبْلَ","sebelum","qabla",51],["يَوْمِ","hari","yawmi",25],["ٱلْحِسَابِ","perhitungan","l-ḥisābi",304]],"t":"Dan mereka berkata, \"Ya Tuhan kami, segerakanlah azab yang diperuntukkan bagi kami sebelum hari perhitungan.\""},{"n":17,"w":[["ٱصْبِرْ","bersabarlah","iṣ'bir",203],["عَلَىٰ","atas","ʿalā",8],["مَا","apa","mā",2],["يَقُولُونَ","mereka katakan","yaqūlūna",6],["وَٱذْكُرْ","dan ingatlah","wa-udh'kur",134],["عَبْدَنَا","hamba Kami","ʿabdanā",90],["دَاوُۥدَ","Daud","dāwūda",590],["ذَا","mempunyai","dhā",443],["ٱلْأَيْدِ ۖ","tangan/kekuatan","l-aydi",2191],["إِنَّهُۥٓ","sesungguhnya dia","innahu",5],["أَوَّابٌ","seorang yang kembali","awwābun",1135]],"t":"Bersabarlah atas apa yang mereka katakan; dan ingatlah akan hamba Kami Dawud yang mempunyai kekuatan; sungguh dia sangat taat (kepada Allah)."},{"n":18,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["سَخَّرْنَا","Kami menundukkan","sakharnā",474],["ٱلْجِبَالَ","gunung-gunung","l-jibāla",305],["مَعَهُۥ","bersama dia","maʿahu",69],["يُسَبِّحْنَ","mereka bertasbih","yusabbiḥ'na",279],["بِٱلْعَشِىِّ","diwaktu petang","bil-ʿashiyi",816],["وَٱلْإِشْرَاقِ","dan pagi","wal-ish'rāqi",2881]],"t":"Sungguh, Kamilah yang menundukkan gunung-gunung untuk bertasbih bersama dia (Dawud) pada waktu petang dan pagi,"},{"n":19,"w":[["وَٱلطَّيْرَ","dan burung-burung","wal-ṭayra",524],["مَحْشُورَةًۭ ۖ","keadaan berkumpul","maḥshūratan",3674],["كُلٌّۭ","masing-masing/semuanya","kullun",31],["لَّهُۥٓ","kepada-Nya","lahu",16],["أَوَّابٌۭ","kembali/bertaubat","awwābun",1135]],"t":"dan (Kami tundukkan pula) burung-burung dalam keadaan terkumpul. Masing-masing sangat taat (kepada Allah)."},{"n":20,"w":[["وَشَدَدْنَا","dan Kami kuatkan","washadadnā",1122],["مُلْكَهُۥ","kerajaannya","mul'kahu",250],["وَءَاتَيْنَـٰهُ","dan Kami berikan kepadanya","waātaynāhu",45],["ٱلْحِكْمَةَ","kebijaksanaan","l-ḥik'mata",505],["وَفَصْلَ","dan memutus","wafaṣla",898],["ٱلْخِطَابِ","perkara","l-khiṭābi",2061]],"t":"Dan Kami kuatkan kerajaannya dan Kami berikan hikmah kepadanya serta kebijaksanaan dalam memutuskan perkara."},{"n":21,"w":[["۞ وَهَلْ","dan apakah","wahal",118],["أَتَىٰكَ","telah datang kepadamu","atāka",48],["نَبَؤُا۟","berita","naba-u",381],["ٱلْخَصْمِ","orang yang bermusuhan","l-khaṣmi",2053],["إِذْ","ketika","idh",53],["تَسَوَّرُوا۟","mereka melompati pagar","tasawwarū",4400],["ٱلْمِحْرَابَ","mihrab/kamar","l-miḥ'rāba",1364]],"t":"Dan apakah telah sampai kepadamu berita orang-orang yang berselisih ketika mereka memanjat dinding mihrab?"},{"n":22,"w":[["إِذْ","ketika","idh",53],["دَخَلُوا۟","mereka masuk","dakhalū",154],["عَلَىٰ","atas","ʿalā",8],["دَاوُۥدَ","Daud","dāwūda",590],["فَفَزِعَ","maka dia terkejut","fafaziʿa",1836],["مِنْهُمْ ۖ","dari mereka","min'hum",0],["قَالُوا۟","mereka berkata","qālū",6],["لَا","tidak","lā",4],["تَخَفْ ۖ","kamu takut","takhaf",140],["خَصْمَانِ","dua orang bermusuhan","khaṣmāni",2053],["بَغَىٰ","berbuat zalim","baghā",424],["بَعْضُنَا","sebagian kami","baʿḍunā",71],["عَلَىٰ","atas","ʿalā",8],["بَعْضٍۢ","sebagian yang lain","baʿḍin",71],["فَٱحْكُم","maka berilah keputusan","fa-uḥ'kum",259],["بَيْنَنَا","di antara kami","baynanā",47],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَلَا","dan tidak","walā",4],["تُشْطِطْ","melewati batas/menyimpang","tush'ṭiṭ",2904],["وَٱهْدِنَآ","dan tunjukilah kami","wa-ih'dinā",80],["إِلَىٰ","kepada","ilā",13],["سَوَآءِ","sama/lurus","sawāi",405],["ٱلصِّرَٰطِ","jalan","l-ṣirāṭi",260]],"t":"ketika mereka masuk menemui Dawud lalu dia terkejut karena (kedatangan) mereka. Mereka berkata, \"Janganlah takut! (Kami) berdua sedang berselisih, sebagian dari kami berbuat zalim kepada yang lain; maka berilah keputusan di antara kami secara adil dan janganlah menyimpang dari kebenaran serta tunjukilah kami ke jalan yang lurus."},{"n":23,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَآ","ini","hādhā",37],["أَخِى","saudaraku","akhī",142],["لَهُۥ","baginya (mempunyai)","lahu",16],["تِسْعٌۭ","sembilan puluh","tis'ʿun",1414],["وَتِسْعُونَ","sembilan","watis'ʿūna",1414],["نَعْجَةًۭ","kambing betina","naʿjatan",1614],["وَلِىَ","dan bagiku","waliya",147],["نَعْجَةٌۭ","kambing betina","naʿjatun",1614],["وَٰحِدَةٌۭ","satu/seekor","wāḥidatun",364],["فَقَالَ","maka dia berkata","faqāla",6],["أَكْفِلْنِيهَا","serahkan ia (kambing itu) kepadaku","akfil'nīhā",2969],["وَعَزَّنِى","dan dia mengalahkan aku","waʿazzanī",3120],["فِى","dalam","fī",3],["ٱلْخِطَابِ","perkara/perdebatan","l-khiṭābi",2061]],"t":"Sesungguhnya saudaraku ini mempunyai sembilan puluh sembilan ekor kambing betina dan aku mempunyai seekor saja, lalu dia berkata, \"Serahkanlah (kambingmu) itu kepadaku! Dan dia mengalahkan aku dalam perdebatan.\""},{"n":24,"w":[["قَالَ","(Daud) berkata","qāla",6],["لَقَدْ","sesungguhnya","laqad",24],["ظَلَمَكَ","dia berbuat zalim kepadamu","ẓalamaka",107],["بِسُؤَالِ","dengan meminta","bisuāli",4285],["نَعْجَتِكَ","kambingmu","naʿjatika",1614],["إِلَىٰ","kepada","ilā",13],["نِعَاجِهِۦ ۖ","kambingnya","niʿājihi",1614],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["كَثِيرًۭا","kebanyakan","kathīran",161],["مِّنَ","dari","mina",0],["ٱلْخُلَطَآءِ","bercampur/sepergaulan","l-khulaṭāi",4538],["لَيَبْغِى","sungguh berbuat zalim","layabghī",424],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",71],["عَلَىٰ","atas","ʿalā",8],["بَعْضٍ","sebagian yang lain","baʿḍin",71],["إِلَّا","kecuali","illā",15],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka berbuat/beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",95],["وَقَلِيلٌۭ","dan sedikit","waqalīlun",175],["مَّا","apa","mā",2],["هُمْ ۗ","mereka","hum",11],["وَظَنَّ","dan mengira","waẓanna",252],["دَاوُۥدُ","Daud","dāwūdu",590],["أَنَّمَا","bahwasannya","annamā",30],["فَتَنَّـٰهُ","Kami mengujinya","fatannāhu",450],["فَٱسْتَغْفَرَ","maka dia minta ampun","fa-is'taghfara",299],["رَبَّهُۥ","Tuhannya","rabbahu",10],["وَخَرَّ","dan dia menyungkur","wakharra",749],["رَاكِعًۭا","tunduk","rākiʿan",997],["وَأَنَابَ ۩","dan dia kembali/taubat","wa-anāba",761]],"t":"Dia (Dawud) berkata, \"Sungguh, dia telah berbuat zalim kepadamu dengan meminta kambingmu itu untuk (ditambahkan) kepada kambingnya. Memang banyak di antara orang-orang yang bersekutu itu berbuat zalim kepada yang lain, kecuali orang-orang yang beriman dan mengerjakan kebajikan; dan hanya sedikitlah mereka yang begitu.\" Dan Dawud menduga bahwa Kami mengujinya; maka dia memohon ampunan kepada Tuhannya lalu menyungkur sujud dan bertobat."},{"n":25,"w":[["فَغَفَرْنَا","maka Kami mengampuni","faghafarnā",185],["لَهُۥ","baginya","lahu",16],["ذَٰلِكَ ۖ","demikian/itu","dhālika",19],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَهُۥ","baginya (dia mempunyai)","lahu",16],["عِندَنَا","disisi Kami","ʿindanā",59],["لَزُلْفَىٰ","sungguh dekat","lazul'fā",1678],["وَحُسْنَ","dan amat baik","waḥus'na",677],["مَـَٔابٍۢ","tempat kembali","maābin",910]],"t":"Lalu Kami mengampuni (kesalahannya) itu. Dan sungguh, dia mempunyai kedudukan yang benar-benar dekat di sisi Kami dan tempat kembali yang baik."},{"n":26,"w":[["يَـٰدَاوُۥدُ","hai Daud","yādāwūdu",590],["إِنَّا","sesungguhnya","innā",5],["جَعَلْنَـٰكَ","Kami menjadikan kamu","jaʿalnāka",33],["خَلِيفَةًۭ","khalifah/penguasa","khalīfatan",938],["فِى","dimuka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["فَٱحْكُم","maka berilah keputusan","fa-uḥ'kum",259],["بَيْنَ","diantara","bayna",47],["ٱلنَّاسِ","manusia","l-nāsi",52],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَلَا","dan tidak","walā",4],["تَتَّبِعِ","kamu mengikuti","tattabiʿi",86],["ٱلْهَوَىٰ","hawa nafsu","l-hawā",781],["فَيُضِلَّكَ","maka akan menyesatkan kamu","fayuḍillaka",187],["عَن","dari","ʿan",21],["سَبِيلِ","jalan","sabīli",64],["ٱللَّهِ ۚ","Allah","l-lahi",1],["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَضِلُّونَ","(mereka) tersesat","yaḍillūna",223],["عَن","dari","ʿan",21],["سَبِيلِ","jalan","sabīli",64],["ٱللَّهِ","Allah","l-lahi",1],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌۢ","sangat/keras","shadīdun",213],["بِمَا","dengan apa/sebab","bimā",2],["نَسُوا۟","mereka melupakan","nasū",334],["يَوْمَ","pada hari","yawma",25],["ٱلْحِسَابِ","perhitungan","l-ḥisābi",304]],"t":"(Allah berfirman), \"Wahai Dawud! Sesungguhnya engkau Kami jadikan khalifah (penguasa) di bumi, maka berilah keputusan (perkara) di antara manusia dengan adil dan janganlah engkau mengikuti hawa nafsu, karena akan menyesatkan engkau dari jalan Allah. Sungguh, orang-orang yang sesat dari jalan Allah akan mendapat azab yang berat, karena mereka melupakan hari perhitungan.\""},{"n":27,"w":[["وَمَا","dan tidaklah","wamā",2],["خَلَقْنَا","Kami jadikan","khalaqnā",61],["ٱلسَّمَآءَ","langit","l-samāa",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","diantara keduanya","baynahumā",47],["بَـٰطِلًۭا ۚ","batil/palsu/sia-sia","bāṭilan",410],["ذَٰلِكَ","demikianlah","dhālika",19],["ظَنُّ","prasangkaan","ẓannu",483],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟ ۚ","kafir/ingkar","kafarū",40],["فَوَيْلٌۭ","maka celakalah","fawaylun",296],["لِّلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["مِنَ","dari","mina",0],["ٱلنَّارِ","api/neraka","l-nāri",78]],"t":"Dan Kami tidak menciptakan langit dan bumi dan apa yang ada di antara keduanya dengan sia-sia. Itu anggapan orang-orang kafir, maka celakalah orang-orang yang kafir itu karena mereka akan masuk neraka."},{"n":28,"w":[["أَمْ","atau","am",84],["نَجْعَلُ","Kami jadikan","najʿalu",33],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","shaleh","l-ṣāliḥāti",95],["كَٱلْمُفْسِدِينَ","seperti orang-orang yang berbuat kerusakan","kal-muf'sidīna",488],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["أَمْ","atau","am",84],["نَجْعَلُ","Kami jadikan","najʿalu",33],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",245],["كَٱلْفُجَّارِ","seperti orang-orang yang durhaka","kal-fujāri",1331]],"t":"Pantaskah Kami memperlakukan orang-orang yang beriman dan mengerjakan kebajikan sama dengan orang-orang yang berbuat kerusakan di bumi? Atau pantaskah Kami mengangggap orang-orang yang bertakwa sama dengan orang-orang yang jahat?"},{"n":29,"w":[["كِتَـٰبٌ","Kitab","kitābun",49],["أَنزَلْنَـٰهُ","Kami turunkannya","anzalnāhu",62],["إِلَيْكَ","kepadamu","ilayka",13],["مُبَـٰرَكٌۭ","penuh keberkatan","mubārakun",987],["لِّيَدَّبَّرُوٓا۟","supaya mereka memperhatikan","liyaddabbarū",1656],["ءَايَـٰتِهِۦ","ayat-ayatnya","āyātihi",28],["وَلِيَتَذَكَّرَ","dan supaya mendapat pelajaran","waliyatadhakkara",233],["أُو۟لُوا۟","orang-orang yang mempunyai","ulū",258],["ٱلْأَلْبَـٰبِ","hati/pikiran","l-albābi",595]],"t":"Kitab (Alquran) yang Kami turunkan kepadamu penuh berkah agar mereka menghayati ayat-ayatnya dan agar orang-orang yang berakal sehat mendapat pelajaran."},{"n":30,"w":[["وَوَهَبْنَا","dan Kami karuniakan","wawahabnā",475],["لِدَاوُۥدَ","kepada Daud","lidāwūda",590],["سُلَيْمَـٰنَ ۚ","Sulaiman","sulaymāna",575],["نِعْمَ","sebaik-baiknya","niʿ'ma",551],["ٱلْعَبْدُ ۖ","hamba","l-ʿabdu",90],["إِنَّهُۥٓ","sesungguhnya dia","innahu",5],["أَوَّابٌ","orang yang suka kembali","awwābun",1135]],"t":"Dan kepada Dawud Kami karuniakan (anak bernama) Sulaiman; dia adalah sebaik-baik hamba. Sungguh, dia sangat taat (kepada Allah)."},{"n":31,"w":[["إِذْ","ketika","idh",53],["عُرِضَ","dipertunjukkan","ʿuriḍa",767],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",8],["بِٱلْعَشِىِّ","pada waktu sore","bil-ʿashiyi",816],["ٱلصَّـٰفِنَـٰتُ","yang diam waktu berhenti","l-ṣāfinātu",3273],["ٱلْجِيَادُ","yang cepat berlari","l-jiyādu",3564]],"t":"(Ingatlah) ketika suatu sore dipertunjukkan kepadanya (kuda-kuda) yang jinak, (tetapi) sangat cepat larinya,"},{"n":32,"w":[["فَقَالَ","maka dia berkata","faqāla",6],["إِنِّىٓ","sesungguhnya aku","innī",5],["أَحْبَبْتُ","aku menyukai","aḥbabtu",188],["حُبَّ","kesenangan","ḥubba",887],["ٱلْخَيْرِ","yang baik","l-khayri",60],["عَن","dari","ʿan",21],["ذِكْرِ","ingat","dhik'ri",152],["رَبِّى","Tuhanku","rabbī",10],["حَتَّىٰ","sehingga","ḥattā",82],["تَوَارَتْ","tersembunyi/tertutup","tawārat",2697],["بِٱلْحِجَابِ","dengan tabir/dinding","bil-ḥijābi",1053]],"t":"maka dia berkata, \"Sesungguhnya aku menyukai segala yang baik (kuda), yang membuat aku ingat akan (kebesaran) Tuhanku, sampai matahari terbenam.\""},{"n":33,"w":[["رُدُّوهَا","bawalah kembali","ruddūhā",327],["عَلَىَّ ۖ","kepadaku","ʿalayya",8],["فَطَفِقَ","lalu dia mulai berbuat","faṭafiqa",1804],["مَسْحًۢا","mengusap-usap","masḥan",3744],["بِٱلسُّوقِ","dengan kaki","bil-sūqi",1652],["وَٱلْأَعْنَاقِ","dan leher","wal-aʿnāqi",885]],"t":"\"Bawalah semua kuda itu kembali kepadaku.\" Lalu dia mengusap-usap kaki dan leher kuda itu."},{"n":34,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["فَتَنَّا","Kami telah menguji","fatannā",450],["سُلَيْمَـٰنَ","Sulaiman","sulaymāna",575],["وَأَلْقَيْنَا","dan Kami jatuhkan/letakkan","wa-alqaynā",172],["عَلَىٰ","atas","ʿalā",8],["كُرْسِيِّهِۦ","kursinya","kur'siyyihi",2427],["جَسَدًۭا","jasad","jasadan",1563],["ثُمَّ","kemudian","thumma",34],["أَنَابَ","dia kembali","anāba",761]],"t":"Dan sungguh, Kami telah menguji Sulaiman dan Kami jadikan (dia) tergeletak di atas kursinya sebagai tubuh (yang lemah karena sakit), kemudian dia bertobat."},{"n":35,"w":[["قَالَ","dia berkata","qāla",6],["رَبِّ","ya Tuhanku","rabbi",10],["ٱغْفِرْ","ampunilah","igh'fir",185],["لِى","aku","lī",147],["وَهَبْ","dan anugerahkanlah","wahab",475],["لِى","aku","lī",147],["مُلْكًۭا","kerajaan","mul'kan",250],["لَّا","tidak","lā",4],["يَنۢبَغِى","patut","yanbaghī",1251],["لِأَحَدٍۢ","bagi seorang","li-aḥadin",159],["مِّنۢ","dari","min",0],["بَعْدِىٓ ۖ","sesudahku","baʿdī",58],["إِنَّكَ","sesungguhnya Engkau","innaka",5],["أَنتَ","Engkau","anta",144],["ٱلْوَهَّابُ","Maha Pemberi","l-wahābu",2037]],"t":"Dia berkata, \"Ya Tuhanku, ampunilah aku dan anugerahkanlah kepadaku kerajaan yang tidak dimiliki oleh siapa pun setelahku. Sungguh, Engkaulah Yang Maha Pemberi.\""},{"n":36,"w":[["فَسَخَّرْنَا","maka Kami tundukkan","fasakharnā",474],["لَهُ","baginya","lahu",16],["ٱلرِّيحَ","angin","l-rīḥa",382],["تَجْرِى","mengalir berhembus","tajrī",207],["بِأَمْرِهِۦ","menurut perintahnya","bi-amrihi",66],["رُخَآءً","baik/lembut","rukhāan",4207],["حَيْثُ","kemana saja","ḥaythu",378],["أَصَابَ","ia tuju/kehendaki","aṣāba",189]],"t":"Kemudian Kami tundukkan kepadanya angin yang berhembus dengan baik menurut perintahnya ke mana saja yang dikehendakinya,"},{"n":37,"w":[["وَٱلشَّيَـٰطِينَ","dan syaitan-syaitan","wal-shayāṭīna",124],["كُلَّ","semuanya","kulla",31],["بَنَّآءٍۢ","ahli bangunan","bannāin",3348],["وَغَوَّاصٍۢ","dan penyelam","waghawwāṣin",3493]],"t":"dan (Kami tundukkan pula kepadanya) setan-setan, semuanya ahli bangunan dan penyelam,"},{"n":38,"w":[["وَءَاخَرِينَ","dan yang lain","waākharīna",176],["مُقَرَّنِينَ","yang terikat","muqarranīna",1943],["فِى","dalam","fī",3],["ٱلْأَصْفَادِ","belenggu","l-aṣfādi",2282]],"t":"dan (setan) lain yang terikat dalam belenggu."},{"n":39,"w":[["هَـٰذَا","ini","hādhā",37],["عَطَآؤُنَا","anugerah Kami","ʿaṭāunā",1283],["فَٱمْنُنْ","maka berikanlah","fa-um'nun",596],["أَوْ","atau","aw",42],["أَمْسِكْ","tahanlah","amsik",538],["بِغَيْرِ","dengan tidak","bighayri",76],["حِسَابٍۢ","perhitungan","ḥisābin",304]],"t":"Inilah anugerah Kami; maka berikanlah (kepada orang lain) atau tahanlah (untuk dirimu sendiri) tanpa perhitungan."},{"n":40,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَهُۥ","baginya (dia mempunyai)","lahu",16],["عِندَنَا","disisi Kami","ʿindanā",59],["لَزُلْفَىٰ","sungguh dekat","lazul'fā",1678],["وَحُسْنَ","dan amat baik","waḥus'na",677],["مَـَٔابٍۢ","tempat kembali","maābin",910]],"t":"Dan sungguh, dia mempunyai kedudukan yang dekat pada sisi Kami dan tempat kembali yang baik."},{"n":41,"w":[["وَٱذْكُرْ","dan ingatlah","wa-udh'kur",134],["عَبْدَنَآ","hamba Kami","ʿabdanā",90],["أَيُّوبَ","Ayyub","ayyūba",1486],["إِذْ","tatkala","idh",53],["نَادَىٰ","dia menyeru","nādā",269],["رَبَّهُۥٓ","Tuhannya","rabbahu",10],["أَنِّى","sesungguhnya aku","annī",30],["مَسَّنِىَ","menimpaku/mengganggu aku","massaniya",215],["ٱلشَّيْطَـٰنُ","syaitan","l-shayṭānu",124],["بِنُصْبٍۢ","dengan kesusahan/kepayahan","binuṣ'bin",4061],["وَعَذَابٍ","dan siksaan","waʿadhābin",36]],"t":"Dan ingatlah akan hamba Kami Ayyub ketika dia menyeru Tuhannya, \"Sesungguhnya aku diganggu setan dengan penderitaan dan bencana.\""},{"n":42,"w":[["ٱرْكُضْ","hentakkanlah","ur'kuḍ",1990],["بِرِجْلِكَ ۖ","dengan kakimu","birij'lika",634],["هَـٰذَا","ini","hādhā",37],["مُغْتَسَلٌۢ","(untuk) mandi","mugh'tasalun",3826],["بَارِدٌۭ","sejuk","bāridun",2315],["وَشَرَابٌۭ","dan minum","washarābun",753]],"t":"(Allah berfirman), \"Hentakkanlah kakimu; inilah air yang sejuk untuk mandi dan untuk minum.\""},{"n":43,"w":[["وَوَهَبْنَا","dan Kami anugerahkan","wawahabnā",475],["لَهُۥٓ","kepadanya","lahu",16],["أَهْلَهُۥ","keluarganya","ahlahu",93],["وَمِثْلَهُم","dan serupa/sebanyak itu","wamith'lahum",157],["مَّعَهُمْ","beserta mereka","maʿahum",69],["رَحْمَةًۭ","rahmat","raḥmatan",105],["مِّنَّا","dari Kami","minnā",0],["وَذِكْرَىٰ","dan pelajaran/peringatan","wadhik'rā",444],["لِأُو۟لِى","bagi orang yang mempunyai","li-ulī",258],["ٱلْأَلْبَـٰبِ","pikiran","l-albābi",595]],"t":"Dan Kami anugerahi dia (dengan mengumpulkan kembali) keluarganya dan Kami lipat gandakan jumlah mereka, sebagai rahmat dari Kami dan pelajaran bagi orang-orang yang berpikiran sehat."},{"n":44,"w":[["وَخُذْ","dan ambillah","wakhudh",94],["بِيَدِكَ","dengan tanganmu","biyadika",101],["ضِغْثًۭا","ranting/seikat rumput","ḍigh'than",1758],["فَٱضْرِب","maka pukullah","fa-iḍ'rib",218],["بِّهِۦ","dengannya","bihi",16],["وَلَا","dan jangan","walā",4],["تَحْنَثْ ۗ","kamu melanggar","taḥnath",3176],["إِنَّا","sesungguhnya Kami","innā",5],["وَجَدْنَـٰهُ","Kami dapati dia","wajadnāhu",109],["صَابِرًۭا ۚ","seorang yang sabar","ṣābiran",460],["نِّعْمَ","sebaik-baik","niʿ'ma",551],["ٱلْعَبْدُ ۖ","hamba","l-ʿabdu",90],["إِنَّهُۥٓ","sesungguhnya dia","innahu",5],["أَوَّابٌۭ","orang yang kembali/bertaubat","awwābun",1135]],"t":"Dan ambillah seikat (rumput) dengan tanganmu, lalu pukullah dengan itu dan janganlah engkau melanggar sumpah. Sesungguhnya Kami dapati dia (Ayyub) seorang yang sabar. Dialah sebaik-baik hamba. Sungguh, dia sangat taat (kepada Allah)."},{"n":45,"w":[["وَٱذْكُرْ","dan ingatlah","wa-udh'kur",134],["عِبَـٰدَنَآ","hamba-hamba Kami","ʿibādanā",90],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",181],["وَإِسْحَـٰقَ","dan Ishaq","wa-is'ḥāqa",558],["وَيَعْقُوبَ","dan Ya'qub","wayaʿqūba",607],["أُو۟لِى","mempunyai","ulī",258],["ٱلْأَيْدِى","tangan/perbuatan","l-aydī",101],["وَٱلْأَبْصَـٰرِ","dan pandangan/ilmu","wal-abṣāri",248]],"t":"Dan ingatlah hamba-hamba Kami: Ibrahim, Ishak dan Yakub yang mempunyai kekuatan-kekuatan yang besar dan ilmu-ilmu (yang tinggi)."},{"n":46,"w":[["إِنَّآ","sesungguhnya Kami","innā",5],["أَخْلَصْنَـٰهُم","Kami mensucikan mereka","akhlaṣnāhum",2188],["بِخَالِصَةٍۢ","dengan suci/bersih","bikhāliṣatin",1111],["ذِكْرَى","ingat/mengingat","dhik'rā",444],["ٱلدَّارِ","rumah/kampung","l-dāri",249]],"t":"Sungguh, Kami telah menyucikan mereka dengan (menganugerahkan) akhlak yang tinggi kepadanya yaitu selalu mengingatkan (manusia) kepada negeri akhirat."},{"n":47,"w":[["وَإِنَّهُمْ","dan sesungguhnya mereka","wa-innahum",5],["عِندَنَا","pada sisi Kami","ʿindanā",59],["لَمِنَ","benar-benar termasuk","lamina",0],["ٱلْمُصْطَفَيْنَ","orang-orang pilihan","l-muṣ'ṭafayna",3802],["ٱلْأَخْيَارِ","terpilih","l-akhyāri",60]],"t":"Dan sungguh, di sisi Kami mereka termasuk orang-orang pilihan yang paling baik."},{"n":48,"w":[["وَٱذْكُرْ","dan ingatlah","wa-udh'kur",134],["إِسْمَـٰعِيلَ","Ismail","is'māʿīla",707],["وَٱلْيَسَعَ","dan Ilyas","wal-yasaʿa",2791],["وَذَا","dan","wadhā",443],["ٱلْكِفْلِ ۖ","Zulkifli","l-kif'li",1573],["وَكُلٌّۭ","dan semuanya","wakullun",31],["مِّنَ","dari/termasuk","mina",0],["ٱلْأَخْيَارِ","orang-orang yang terpilih","l-akhyāri",60]],"t":"Dan ingatlah Ismail, Ilyasa' dan Zulkifli. Semuanya termasuk orang-orang yang terbaik."},{"n":49,"w":[["هَـٰذَا","ini","hādhā",37],["ذِكْرٌۭ ۚ","peringatan/pelajaran","dhik'run",152],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",245],["لَحُسْنَ","benar-benar baik","laḥus'na",677],["مَـَٔابٍۢ","tempat kembali","maābin",910]],"t":"Ini adalah kehormatan (bagi mereka). Dan sungguh, bagi orang-orang yang bertakwa (disediakan) tempat kembali yang terbaik,"},{"n":50,"w":[["جَنَّـٰتِ","sorga","jannāti",77],["عَدْنٍۢ","'Adn","ʿadnin",765],["مُّفَتَّحَةًۭ","terbuka","mufattaḥatan",3965],["لَّهُمُ","bagi mereka","lahumu",11],["ٱلْأَبْوَٰبُ","pintu-pintu","l-abwābu",399]],"t":"(yaitu) surga 'Adn yang pintu-pintunya terbuka bagi mereka,"},{"n":51,"w":[["مُتَّكِـِٔينَ","mereka bersandar","muttakiīna",991],["فِيهَا","di dalamnya","fīhā",3],["يَدْعُونَ","mereka meminta","yadʿūna",65],["فِيهَا","di dalamnya (sorga)","fīhā",3],["بِفَـٰكِهَةٍۢ","dengan buah-buahan","bifākihatin",777],["كَثِيرَةٍۢ","banyak","kathīratin",161],["وَشَرَابٍۢ","dan minuman","washarābin",753]],"t":"di dalamnya mereka bersandar (di atas dipan-dipan) sambil meminta buah-buahan yang banyak dan minuman (di surga itu)."},{"n":52,"w":[["۞ وَعِندَهُمْ","dan disisi mereka","waʿindahum",59],["قَـٰصِرَٰتُ","tidak liar","qāṣirātu",1966],["ٱلطَّرْفِ","maka/pandangan","l-ṭarfi",1158],["أَتْرَابٌ","sebaya","atrābun",2030]],"t":"dan di samping mereka (ada bidadari-bidadari) yang redup pandangannya dan sebaya umurnya."},{"n":53,"w":[["هَـٰذَا","ini","hādhā",37],["مَا","apa","mā",2],["تُوعَدُونَ","yang kamu dijanjikan","tūʿadūna",179],["لِيَوْمِ","pada hari","liyawmi",25],["ٱلْحِسَابِ","perhitungan","l-ḥisābi",304]],"t":"Inilah apa yang dijanjikan kepadamu pada hari perhitungan."},{"n":54,"w":[["إِنَّ","sesungguhnya","inna",5],["هَـٰذَا","ini","hādhā",37],["لَرِزْقُنَا","benar-benar rizki Kami","lariz'qunā",219],["مَا","tidak","mā",2],["لَهُۥ","baginya","lahu",16],["مِن","dari","min",0],["نَّفَادٍ","habis","nafādin",4077]],"t":"Sungguh, inilah rezeki dari Kami yang tidak ada habis-habisnya."},{"n":55,"w":[["هَـٰذَا ۚ","ini","hādhā",37],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لِلطَّـٰغِينَ","bagi orang-orang yang durhaka","lilṭṭāghīna",1157],["لَشَرَّ","benar-benar buruk","lasharra",365],["مَـَٔابٍۢ","tempat kembali","maābin",910]],"t":"Beginilah (keadaan mereka). Dan sungguh, bagi orang-orang yang durhaka pasti (disediakan) tempat kembali yang buruk,"},{"n":56,"w":[["جَهَنَّمَ","neraka jahannam","jahannama",151],["يَصْلَوْنَهَا","mereka memasukinya","yaṣlawnahā",679],["فَبِئْسَ","maka alangkah buruk","fabi'sa",293],["ٱلْمِهَادُ","tempat tinggal","l-mihādu",1081]],"t":"(yaitu) neraka Jahanam yang mereka masuki; maka itulah seburuk-buruk tempat tinggal."},{"n":57,"w":[["هَـٰذَا","ini","hādhā",37],["فَلْيَذُوقُوهُ","maka mereka merasakannya","falyadhūqūhu",324],["حَمِيمٌۭ","air sangat panas","ḥamīmun",503],["وَغَسَّاقٌۭ","dan air sangat dingin","waghassāqun",2376]],"t":"Inilah (azab neraka), maka biarlah mereka merasakannya, (minuman mereka) air yang sangat panas dan air yang sangat dingin,"},{"n":58,"w":[["وَءَاخَرُ","dan yang lain","waākharu",176],["مِن","dari","min",0],["شَكْلِهِۦٓ","bentuknya/serupa","shaklihi",2832],["أَزْوَٰجٌ","berpasangan/bermacam-macam","azwājun",155]],"t":"dan berbagai macam (azab) yang lain yang serupa itu."},{"n":59,"w":[["هَـٰذَا","ini","hādhā",37],["فَوْجٌۭ","golongan","fawjun",1335],["مُّقْتَحِمٌۭ","masuk berdesak-desak","muq'taḥimun",3982],["مَّعَكُمْ ۖ","beserta kamu","maʿakum",69],["لَا","tidak","lā",4],["مَرْحَبًۢا","ucapan selamat datang","marḥaban",2472],["بِهِمْ ۚ","kepada mereka","bihim",11],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["صَالُوا۟","mereka masuk","ṣālū",1797],["ٱلنَّارِ","api/neraka","l-nāri",78]],"t":"(Dikatakan kepada mereka), \"Ini rombongan besar (pengikut-pengikutmu) yang masuk berdesak-desak bersama kamu (ke neraka).\" Tidak ada ucapan selamat datang bagi mereka karena sesungguhnya mereka akan masuk neraka (kata pemimpin-pemimpin mereka)."},{"n":60,"w":[["قَالُوا۟","mereka berkata","qālū",6],["بَلْ","bahkan/sebenarnya","bal",96],["أَنتُمْ","kamu","antum",87],["لَا","tidak","lā",4],["مَرْحَبًۢا","ucapan selamat datang","marḥaban",2472],["بِكُمْ ۖ","dengan/untuk kalian","bikum",26],["أَنتُمْ","kamu","antum",87],["قَدَّمْتُمُوهُ","kamu menyediakannya/membawanya","qaddamtumūhu",403],["لَنَا ۖ","bagi kami","lanā",125],["فَبِئْسَ","maka amat buruk","fabi'sa",293],["ٱلْقَرَارُ","tempat menetap/tinggal","l-qarāru",920]],"t":"(Para pengikut mereka menjawab), \"Sebenarnya kamulah yang (lebih pantas) tidak menerima ucapan selamat datang, karena kamulah yang menjerumuskan kami ke dalam azab, maka itulah seburuk-buruk tempat menetap.\""},{"n":61,"w":[["قَالُوا۟","mereka berkata","qālū",6],["رَبَّنَا","ya Tuhan kami","rabbanā",10],["مَن","barang siapa","man",12],["قَدَّمَ","menyediakan/membawa","qaddama",403],["لَنَا","pada kami","lanā",125],["هَـٰذَا","ini","hādhā",37],["فَزِدْهُ","maka tambahkan kepadanya","fazid'hu",247],["عَذَابًۭا","azab","ʿadhāban",36],["ضِعْفًۭا","berlipat ganda","ḍiʿ'fan",763],["فِى","di dalam","fī",3],["ٱلنَّارِ","neraka","l-nāri",78]],"t":"Mereka berkata (lagi), \"Ya Tuhan kami, barangsiapa menjerumuskan kami ke dalam (azab) ini, maka tambahkanlah azab kepadanya dua kali lipat di dalam neraka.\""},{"n":62,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مَا","mengapa","mā",2],["لَنَا","bagi kami","lanā",125],["لَا","tidak","lā",4],["نَرَىٰ","kami melihat","narā",46],["رِجَالًۭا","orang laki-laki/orang-orang","rijālan",211],["كُنَّا","adalah kami","kunnā",9],["نَعُدُّهُم","kami menganggap mereka","naʿudduhum",1042],["مِّنَ","dari","mina",0],["ٱلْأَشْرَارِ","orang-orang jahat","l-ashrāri",365]],"t":"Dan (orang-orang durhaka) berkata, \"Mengapa kami tidak melihat orang-orang yang dahulu (di dunia) kami anggap sebagai orang-orang yang jahat (hina)."},{"n":63,"w":[["أَتَّخَذْنَـٰهُمْ","apakah kami menjadikan mereka","attakhadhnāhum",98],["سِخْرِيًّا","ejekan/olok-olokan","sikh'riyyan",2658],["أَمْ","atau","am",84],["زَاغَتْ","suram/tidak melihat","zāghat",1250],["عَنْهُمُ","dari mereka","ʿanhumu",21],["ٱلْأَبْصَـٰرُ","penglihatan","l-abṣāru",248]],"t":"Dahulu kami menjadikan mereka olok-olokan, ataukah karena penglihatan kami yang tidak melihat mereka?\""},{"n":64,"w":[["إِنَّ","sesungguhnya","inna",5],["ذَٰلِكَ","demikian itu","dhālika",19],["لَحَقٌّۭ","pasti benar/terjadi","laḥaqqun",50],["تَخَاصُمُ","pertengkaran","takhāṣumu",4413],["أَهْلِ","penghuni","ahli",93],["ٱلنَّارِ","api/neraka","l-nāri",78]],"t":"Sungguh, yang demikian benar-benar terjadi, (yaitu) pertengkaran di antara penghuni neraka."},{"n":65,"w":[["قُلْ","katakanlah","qul",6],["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَنَا۠","aku","anā",183],["مُنذِرٌۭ ۖ","seorang pemberi peringatan","mundhirun",630],["وَمَا","dan tidak","wamā",2],["مِنْ","dari","min",0],["إِلَـٰهٍ","Tuhan","ilāhin",75],["إِلَّا","kecuali","illā",15],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْوَٰحِدُ","yang satu/esa","l-wāḥidu",373],["ٱلْقَهَّارُ","Maha Mengalahkan/Perkasa","l-qahāru",1216]],"t":"Katakanlah (Muhammad), \"Sesungguhnya aku hanya seorang pemberi peringatan, tidak ada tuhan selain Allah Yang Maha Esa, Mahaperkasa,"},{"n":66,"w":[["رَبُّ","Tuhan","rabbu",10],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَا","yang diantara keduanya","baynahumā",47],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",113],["ٱلْغَفَّـٰرُ","Maha Pengampun","l-ghafāru",1338]],"t":"(yaitu) Tuhan langit dan bumi dan apa yang ada di antara keduanya, Yang Mahaperkasa, Maha Pengampun.\""},{"n":67,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","ia/itu","huwa",20],["نَبَؤٌا۟","berita","naba-on",381],["عَظِيمٌ","besar","ʿaẓīmun",100]],"t":"Katakanlah, \"Itu (Alquran) adalah berita besar,"},{"n":68,"w":[["أَنتُمْ","kamu","antum",87],["عَنْهُ","dari padanya","ʿanhu",21],["مُعْرِضُونَ","orang yang berpaling","muʿ'riḍūna",529]],"t":"yang kamu berpaling darinya."},{"n":69,"w":[["مَا","tidak","mā",2],["كَانَ","ada","kāna",9],["لِىَ","bagiku","liya",147],["مِنْ","dari","min",0],["عِلْمٍۭ","pengetahuan","ʿil'min",111],["بِٱلْمَلَإِ","dengan pemimpin/golongan","bil-mala-i",370],["ٱلْأَعْلَىٰٓ","tertinggi","l-aʿlā",760],["إِذْ","ketika","idh",53],["يَخْتَصِمُونَ","mereka bertengkar/berbantah-bantahan","yakhtaṣimūna",1019]],"t":"Aku tidak mempunyai pengetahuan sedikit pun tentang al-malaul a'lā (malaikat) ketika mereka berbantah-bantahan."},{"n":70,"w":[["إِن","tidak","in",14],["يُوحَىٰٓ","diwahyukan","yūḥā",168],["إِلَىَّ","kepadaku","ilayya",13],["إِلَّآ","kecuali/melainkan","illā",15],["أَنَّمَآ","bahwa sesungguhnya hanyalah","annamā",30],["أَنَا۠","aku","anā",183],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",204],["مُّبِينٌ","nyata","mubīnun",102]],"t":"Yang diwahyukan kepadaku, bahwa aku hanyalah seorang pemberi peringatan yang nyata.\""},{"n":71,"w":[["إِذْ","ketika","idh",53],["قَالَ","berfirman","qāla",6],["رَبُّكَ","Tuhanmu","rabbuka",10],["لِلْمَلَـٰٓئِكَةِ","kepada para malaikat","lil'malāikati",127],["إِنِّى","sesungguhnya aku","innī",5],["خَـٰلِقٌۢ","menciptakan","khāliqun",748],["بَشَرًۭا","manusia","basharan",318],["مِّن","dari","min",0],["طِينٍۢ","tanah","ṭīnin",725]],"t":"(Ingatlah) ketika Tuhanmu berfirman kepada malaikat, \"Sesungguhnya Aku akan menciptakan manusia dari tanah."},{"n":72,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["سَوَّيْتُهُۥ","telah Kusempurnakan kejadiannya","sawwaytuhu",668],["وَنَفَخْتُ","dan kutiupkan","wanafakhtu",530],["فِيهِ","ke dalamnya","fīhi",3],["مِن","dari","min",0],["رُّوحِى","roh-Ku","rūḥī",492],["فَقَعُوا۟","maka tunduklah kamu","faqaʿū",746],["لَهُۥ","kepadanya","lahu",16],["سَـٰجِدِينَ","bersujud","sājidīna",455]],"t":"Kemudian apabila telah Aku sempurnakan kejadiannya dan Aku tiupkan roh (ciptaan)-Ku kepadanya; maka tunduklah kamu dengan bersujud kepadanya.\""},{"n":73,"w":[["فَسَجَدَ","maka bersujud","fasajada",335],["ٱلْمَلَـٰٓئِكَةُ","Malaikat","l-malāikatu",127],["كُلُّهُمْ","semua mereka","kulluhum",31],["أَجْمَعُونَ","semuanya","ajmaʿūna",409]],"t":"Lalu para malaikat itu bersujud semuanya,"},{"n":74,"w":[["إِلَّآ","kecuali","illā",15],["إِبْلِيسَ","iblis","ib'līsa",757],["ٱسْتَكْبَرَ","ia menyombongkan diri","is'takbara",300],["وَكَانَ","dan adalah ia","wakāna",9],["مِنَ","dari","mina",0],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",70]],"t":"kecuali iblis; ia menyombongkan diri dan ia termasuk golongan yang kafir."},{"n":75,"w":[["قَالَ","(Allah) berfirman","qāla",6],["يَـٰٓإِبْلِيسُ","hai iblis","yāib'līsu",757],["مَا","apa","mā",2],["مَنَعَكَ","yang mencegah kamu","manaʿaka",734],["أَن","untuk","an",17],["تَسْجُدَ","kamu bersujud","tasjuda",335],["لِمَا","pada apa","limā",2],["خَلَقْتُ","Kuciptakan","khalaqtu",61],["بِيَدَىَّ ۖ","dengan tangan-Ku","biyadayya",101],["أَسْتَكْبَرْتَ","apakah kamu menyombongkan diri","astakbarta",300],["أَمْ","atau","am",84],["كُنتَ","adalah kamu","kunta",9],["مِنَ","dari/termasuk","mina",0],["ٱلْعَالِينَ","orang-orang yang lebih tinggi","l-ʿālīna",1765]],"t":"(Allah) berfirman, \"Wahai iblis, apakah yang menghalangi kamu sujud kepada yang telah Aku ciptakan dengan kedua tangan-Ku. Apakah kamu menyombongkan diri atau kamu (merasa) termasuk golongan yang (lebih) tinggi?\""},{"n":76,"w":[["قَالَ","(iblis) berkata","qāla",6],["أَنَا۠","aku","anā",183],["خَيْرٌۭ","lebih baik","khayrun",60],["مِّنْهُ ۖ","dari padanya","min'hu",0],["خَلَقْتَنِى","Engkau ciptakan aku","khalaqtanī",61],["مِن","dari","min",0],["نَّارٍۢ","api","nārin",78],["وَخَلَقْتَهُۥ","dan Engkau ciptakan dia","wakhalaqtahu",61],["مِن","dari","min",0],["طِينٍۢ","tanah","ṭīnin",725]],"t":"(Iblis) berkata, \"Aku lebih baik darinya, karena Engkau ciptakan aku dari api, sedangkan dia Engkau ciptakan dari tanah.\""},{"n":77,"w":[["قَالَ","(Allah) berfirman","qāla",6],["فَٱخْرُجْ","maka keluarlah kamu","fa-ukh'ruj",225],["مِنْهَا","dari padanya (sorga)","min'hā",0],["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["رَجِيمٌۭ","terkutuk","rajīmun",1220]],"t":"(Allah) berfirman, \"Kalau begitu keluarlah kamu dari surga! Sesungguhnya kamu adalah makhluk yang terkutuk."},{"n":78,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["عَلَيْكَ","atasmu","ʿalayka",8],["لَعْنَتِىٓ","kutukan-Ku","laʿnatī",661],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلدِّينِ","pembalasan","l-dīni",119]],"t":"Dan sungguh, kutukan-Ku tetap atasmu sampai hari pembalasan.\""},{"n":79,"w":[["قَالَ","(iblis) berkata","qāla",6],["رَبِّ","ya Tuhanku","rabbi",10],["فَأَنظِرْنِىٓ","maka beri tangguhlah aku","fa-anẓir'nī",711],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["يُبْعَثُونَ","mereka dibangkitkan","yub'ʿathūna",227]],"t":"(Iblis) berkata, \"Ya Tuhanku, tangguhkanlah aku sampai pada hari mereka dibangkitkan.\""},{"n":80,"w":[["قَالَ","(Allah) berfirman","qāla",6],["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["مِنَ","dari/termasuk","mina",0],["ٱلْمُنظَرِينَ","orang-orang yang diberi tangguh","l-munẓarīna",1200]],"t":"(Allah) berfirman, \"Maka sesungguhnya kamu termasuk golongan yang diberi penangguhan,"},{"n":81,"w":[["إِلَىٰ","sampai","ilā",13],["يَوْمِ","pada hari","yawmi",25],["ٱلْوَقْتِ","waktu","l-waqti",2041],["ٱلْمَعْلُومِ","tertentu/ditentukan","l-maʿlūmi",691]],"t":"sampai pada hari yang telah ditentukan waktunya (hari Kiamat).\""},{"n":82,"w":[["قَالَ","(iblis) berkata","qāla",6],["فَبِعِزَّتِكَ","maka demi kemuliaan Engkau","fabiʿizzatika",771],["لَأُغْوِيَنَّهُمْ","sungguh aku akan aku sesatkan mereka","la-ugh'wiyannahum",952],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"(Iblis) menjawab, \"Demi kemuliaan-Mu, pasti aku akan menyesatkan mereka semuanya,"},{"n":83,"w":[["إِلَّا","kecuali","illā",15],["عِبَادَكَ","hamba-hamba-Mu","ʿibādaka",90],["مِنْهُمُ","diantara mereka","min'humu",0],["ٱلْمُخْلَصِينَ","orang-orang yang mukhlis/disucikan","l-mukh'laṣīna",913]],"t":"kecuali hamba-hamba-Mu yang terpilih di antara mereka.\""},{"n":84,"w":[["قَالَ","(Allah) berfirman","qāla",6],["فَٱلْحَقُّ","maka yang benar","fal-ḥaqu",50],["وَٱلْحَقَّ","dan yang benar/kebenaran","wal-ḥaqa",50],["أَقُولُ","Aku katakan","aqūlu",6]],"t":"(Allah) berfirman, \"Maka yang benar (adalah sumpahku), dan hanya kebenaran itulah yang Aku katakan."},{"n":85,"w":[["لَأَمْلَأَنَّ","sungguh akan Aku penuhi","la-amla-anna",1193],["جَهَنَّمَ","neraka jahannam","jahannama",151],["مِنكَ","dari kamu","minka",0],["وَمِمَّن","dan dari orang-orang","wamimman",0],["تَبِعَكَ","mengikuti kamu","tabiʿaka",931],["مِنْهُمْ","diantara mereka","min'hum",0],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"Sungguh, Aku akan memenuhi neraka Jahanam dengan kamu dan dengan orang-orang yang mengikutimu di antara mereka semuanya.\""},{"n":86,"w":[["قُلْ","katakanlah","qul",6],["مَآ","tidak","mā",2],["أَسْـَٔلُكُمْ","aku meminta kepadamu","asalukum",108],["عَلَيْهِ","atasnya","ʿalayhi",8],["مِنْ","dari","min",0],["أَجْرٍۢ","upah","ajrin",110],["وَمَآ","dan tidaklah/bukanlah","wamā",2],["أَنَا۠","aku","anā",183],["مِنَ","dari","mina",0],["ٱلْمُتَكَلِّفِينَ","orang-orang yang memaksa/mengada-adakan","l-mutakalifīna",3882]],"t":"Katakanlah (Muhammad), \"Aku tidak meminta imbalan sedikit pun kepadamu atasnya (dakwahku); dan aku bukanlah termasuk orang yang mengada-ada."},{"n":87,"w":[["إِنْ","tidak lain","in",14],["هُوَ","dia","huwa",20],["إِلَّا","kecuali","illā",15],["ذِكْرٌۭ","peringatan/pengajaran","dhik'run",152],["لِّلْعَـٰلَمِينَ","bagi semesta alam","lil'ʿālamīna",163]],"t":"(Alquran) ini tidak lain hanyalah peringatan bagi seluruh alam."},{"n":88,"w":[["وَلَتَعْلَمُنَّ","dan sungguh kamu akan mengetahui","walataʿlamunna",29],["نَبَأَهُۥ","beritanya","naba-ahu",381],["بَعْدَ","sesudah","baʿda",58],["حِينٍۭ","waktu","ḥīnin",330]],"t":"Dan sungguh, kamu akan mengetahui (kebenaran) beritanya Alquran setelah beberapa waktu lagi.\""}]