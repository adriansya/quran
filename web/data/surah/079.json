[{"n":1,"w":[["وَٱلنَّـٰزِعَـٰتِ","demi yang mencabut","wal-nāziʿāti",4097],["غَرْقًۭا","dengan keras","gharqan",3479]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan keras."},{"n":2,"w":[["وَٱلنَّـٰشِطَـٰتِ","dan yang mencabut","wal-nāshiṭāti",4095],["نَشْطًۭا","perlahan-lahan","nashṭan",4017]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut."},{"n":3,"w":[["وَٱلسَّـٰبِحَـٰتِ","dan yang turun","wal-sābiḥāti",4305],["سَبْحًۭا","cepat","sabḥan",2621]],"t":"Demi (malaikat) yang turun dari langit dengan cepat,"},{"n":4,"w":[["فَٱلسَّـٰبِقَـٰتِ","dan yang mendahului","fal-sābiqāti",4306],["سَبْقًۭا","dengan kencang","sabqan",4257]],"t":"dan (malaikat) yang mendahului dengan kencang,"},{"n":5,"w":[["فَٱلْمُدَبِّرَٰتِ","dan yang mengatur","fal-mudabirāti",3802],["أَمْرًۭا","urusan","amran",66]],"t":"dan (malaikat) yang mengatur urusan (dunia)."},{"n":6,"w":[["يَوْمَ","hari","yawma",25],["تَرْجُفُ","bergoncang","tarjufu",2680],["ٱلرَّاجِفَةُ","goncangan","l-rājifatu",4223]],"t":"(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,"},{"n":7,"w":[["تَتْبَعُهَا","mengikutinya","tatbaʿuhā",927],["ٱلرَّادِفَةُ","yang mengiringi","l-rādifatu",4221]],"t":"(tiupan pertama) itu diiringi oleh tiupan kedua."},{"n":8,"w":[["قُلُوبٌۭ","hati-hati","qulūbun",86],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["وَاجِفَةٌ","berdebar/sangat takut","wājifatun",4520]],"t":"Hati manusia pada waktu itu merasa sangat takut,"},{"n":9,"w":[["أَبْصَـٰرُهَا","pandangannya","abṣāruhā",247],["خَـٰشِعَةٌۭ","takut/tertunduk","khāshiʿatun",674]],"t":"pandangannya tunduk."},{"n":10,"w":[["يَقُولُونَ","mereka berkata","yaqūlūna",6],["أَءِنَّا","apakah sesungguhnya kami","a-innā",5],["لَمَرْدُودُونَ","sungguh akan dikembalikan","lamardūdūna",2463],["فِى","dalam","fī",3],["ٱلْحَافِرَةِ","keadaan semula","l-ḥāfirati",3163]],"t":"(orang-orang kafir) berkata, \"Apakah kita benar-benar akan dikembalikan kepada kehidupan yang semula?"},{"n":11,"w":[["أَءِذَا","apakah apabila","a-idhā",23],["كُنَّا","kami adalah/menjadi","kunnā",9],["عِظَـٰمًۭا","tulang belulang","ʿiẓāman",98],["نَّخِرَةًۭ","hancur","nakhiratan",4107]],"t":"Apakah (akan dibangkitkan juga) apabila kita telah menjadi tulang belulang yang hancur?\""},{"n":12,"w":[["قَالُوا۟","mereka berkata","qālū",6],["تِلْكَ","itu","til'ka",19],["إِذًۭا","jika demikian","idhan",356],["كَرَّةٌ","pengembalian","karratun",1192],["خَاسِرَةٌۭ","kerugian","khāsiratun",4570]],"t":"Mereka berkata, \"Kalau demikian, itu adalah suatu pengembalian yang merugikan.\""},{"n":13,"w":[["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",5],["هِىَ","ia/pengembalian","hiya",190],["زَجْرَةٌۭ","teriakan","zajratun",2823],["وَٰحِدَةٌۭ","satu/satu kali","wāḥidatun",359]],"t":"Maka pengembalian itu hanyalah dengan sekali tiupan saja."},{"n":14,"w":[["فَإِذَا","maka tiba-tiba","fa-idhā",645],["هُم","mereka","hum",11],["بِٱلسَّاهِرَةِ","di permukaan bumi","bil-sāhirati",4302]],"t":"Maka seketika itu mereka hidup kembali di bumi (yang baru)."},{"n":15,"w":[["هَلْ","apakah","hal",115],["أَتَىٰكَ","telah sampai kepadamu","atāka",48],["حَدِيثُ","cerita","ḥadīthu",385],["مُوسَىٰٓ","Musa","mūsā",83]],"t":"Sudahkah sampai kepadamu (Muhammad) kisah Musa?"},{"n":16,"w":[["إِذْ","tatkala","idh",53],["نَادَىٰهُ","memanggilnya","nādāhu",269],["رَبُّهُۥ","Tuhannya","rabbuhu",10],["بِٱلْوَادِ","di lembah","bil-wādi",1112],["ٱلْمُقَدَّسِ","suci","l-muqadasi",2500],["طُوًى","Tuwa","ṭuwan",2312]],"t":"Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;"},{"n":17,"w":[["ٱذْهَبْ","pergilah kamu","idh'hab",326],["إِلَىٰ","kepada","ilā",13],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",158],["إِنَّهُۥ","sesungguhnya dia","innahu",5],["طَغَىٰ","melampui batas","ṭaghā",724]],"t":"pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,"},{"n":18,"w":[["فَقُلْ","maka katakanlah","faqul",6],["هَل","apakah/maukah","hal",115],["لَّكَ","bagimu","laka",138],["إِلَىٰٓ","kepada (untuk)","ilā",13],["أَن","untuk","an",17],["تَزَكَّىٰ","kamu membersihkan diri","tazakkā",1003]],"t":"Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),"},{"n":19,"w":[["وَأَهْدِيَكَ","dan aku tunjukkan/pimpin kamu","wa-ahdiyaka",79],["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["فَتَخْشَىٰ","maka (supaya) kamu takut","fatakhshā",294]],"t":"dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\""},{"n":20,"w":[["فَأَرَىٰهُ","maka dia memperlihatkan padanya","fa-arāhu",46],["ٱلْـَٔايَةَ","ayat-ayat/mu'jizat","l-āyata",28],["ٱلْكُبْرَىٰ","yang besar","l-kub'rā",1084]],"t":"Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar."},{"n":21,"w":[["فَكَذَّبَ","maka dia mendustakan","fakadhaba",63],["وَعَصَىٰ","dan dia mendurhakai","waʿaṣā",396]],"t":"Tetapi dia (Fir'aun) mendustakan dan mendurhakai."},{"n":22,"w":[["ثُمَّ","kemudian","thumma",34],["أَدْبَرَ","dia berpaling","adbara",1465],["يَسْعَىٰ","dia berusaha/berjalan","yasʿā",518]],"t":"Kemudian dia berpaling seraya berusaha menantang (Musa)."},{"n":23,"w":[["فَحَشَرَ","maka dia mengumpulkan","faḥashara",313],["فَنَادَىٰ","lalu dia berseru","fanādā",269]],"t":"Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya)."},{"n":24,"w":[["فَقَالَ","maka dia berkata","faqāla",6],["أَنَا۠","aku","anā",180],["رَبُّكُمُ","Tuhan kalian","rabbukumu",10],["ٱلْأَعْلَىٰ","paling tinggi","l-aʿlā",874]],"t":"(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\""},{"n":25,"w":[["فَأَخَذَهُ","maka mengambil/menyiksanya","fa-akhadhahu",92],["ٱللَّهُ","Allah","l-lahu",1],["نَكَالَ","siksa","nakāla",1943],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",72],["وَٱلْأُولَىٰٓ","dan dunia","wal-ūlā",137]],"t":"Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia."},{"n":26,"w":[["إِنَّ","sesungguhnya","inna",5],["فِى","di dalam","fī",3],["ذَٰلِكَ","itu","dhālika",19],["لَعِبْرَةًۭ","benar-benar pelajaran","laʿib'ratan",1155],["لِّمَن","bagi orang","liman",12],["يَخْشَىٰٓ","takut","yakhshā",294]],"t":"Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah)."},{"n":27,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",85],["أَشَدُّ","sangat","ashaddu",357],["خَلْقًا","penciptaan","khalqan",229],["أَمِ","atau","ami",82],["ٱلسَّمَآءُ ۚ","langit","l-samāu",38],["بَنَىٰهَا","Dia telah membinanya","banāhā",779]],"t":"Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?"},{"n":28,"w":[["رَفَعَ","Dia meninggikan","rafaʿa",473],["سَمْكَهَا","bangunannya","samkahā",4267],["فَسَوَّىٰهَا","lalu Dia sempurnakannya","fasawwāhā",697]],"t":"Dia telah meninggikan bangunannya lalu menyempurnakannya,"},{"n":29,"w":[["وَأَغْطَشَ","dan Dia jadikan gelap","wa-aghṭasha",2987],["لَيْلَهَا","malamnya","laylahā",132],["وَأَخْرَجَ","dan Dia keluarkan/jadikan","wa-akhraja",111],["ضُحَىٰهَا","paginya/siangnya","ḍuḥāhā",1148]],"t":"dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang)."},{"n":30,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["بَعْدَ","sesudah","baʿda",58],["ذَٰلِكَ","demikian itu","dhālika",19],["دَحَىٰهَآ","Dia haparkannya","daḥāhā",3382]],"t":"Dan setelah itu bumi Dia hamparkan."},{"n":31,"w":[["أَخْرَجَ","Dia keluarkan","akhraja",111],["مِنْهَا","dari padanya","min'hā",0],["مَآءَهَا","airnya","māahā",192],["وَمَرْعَىٰهَا","dan padang rumput/tumbuh-tumbuhannya","wamarʿāhā",2461]],"t":"Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya."},{"n":32,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",302],["أَرْسَىٰهَا","Dia pancangkannya","arsāhā",3033]],"t":"Dan gunung-gunung Dia pancangkan dengan kokoh."},{"n":33,"w":[["مَتَـٰعًۭا","kesenangan","matāʿan",330],["لَّكُمْ","bagi kalian","lakum",26],["وَلِأَنْعَـٰمِكُمْ","dan untuk binatang ternakmu","wali-anʿāmikum",347]],"t":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu."},{"n":34,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["جَآءَتِ","telah datang","jāati",43],["ٱلطَّآمَّةُ","keributan/malapetaka","l-ṭāmatu",3312],["ٱلْكُبْرَىٰ","besar","l-kub'rā",1084]],"t":"Maka apabila malapetaka besar (hari Kiamat) telah datang,"},{"n":35,"w":[["يَوْمَ","hari","yawma",25],["يَتَذَكَّرُ","teringat","yatadhakkaru",233],["ٱلْإِنسَـٰنُ","manusia","l-insānu",167],["مَا","apa","mā",2],["سَعَىٰ","ia telah kerjakan","saʿā",518]],"t":"yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,"},{"n":36,"w":[["وَبُرِّزَتِ","dan diperlihatkan","waburrizati",2347],["ٱلْجَحِيمُ","neraka","l-jaḥīmu",413],["لِمَن","bagi/kepada orang","liman",12],["يَرَىٰ","ia melihat","yarā",46]],"t":"dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat."},{"n":37,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["مَن","siapa","man",12],["طَغَىٰ","melampui batas","ṭaghā",724]],"t":"Maka adapun orang yang melampaui batas,"},{"n":38,"w":[["وَءَاثَرَ","dan ia senang/mengutamakan","waāthara",1287],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",150],["ٱلدُّنْيَا","dunia","l-dun'yā",102]],"t":"dan lebih mengutamakan kehidupan dunia,"},{"n":39,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلْجَحِيمَ","neraka","l-jaḥīma",413],["هِىَ","ia/neraka","hiya",190],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",469]],"t":"maka sungguh, nerakalah tempat tinggalnya."},{"n":40,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["مَنْ","siapa","man",12],["خَافَ","ia takut","khāfa",136],["مَقَامَ","kedudukan/kebesaran","maqāma",669],["رَبِّهِۦ","Tuhannya","rabbihi",10],["وَنَهَى","dan ia menahan","wanahā",353],["ٱلنَّفْسَ","jiwa/diri","l-nafsa",39],["عَنِ","dari","ʿani",21],["ٱلْهَوَىٰ","keinginan/hawa nafsu","l-hawā",783]],"t":"Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,"},{"n":41,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلْجَنَّةَ","sorga","l-janata",76],["هِىَ","ia","hiya",190],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",469]],"t":"maka sungguh, surgalah tempat tinggal-(nya)."},{"n":42,"w":[["يَسْـَٔلُونَكَ","mereka akan bertanya kepadamu","yasalūnaka",105],["عَنِ","dari","ʿani",21],["ٱلسَّاعَةِ","waktu/kiamat","l-sāʿati",250],["أَيَّانَ","kepada/bila","ayyāna",1144],["مُرْسَىٰهَا","kedatangannya/terjadinya","mur'sāhā",1915]],"t":"Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\""},{"n":43,"w":[["فِيمَ","dalam apa/mengapa","fīma",3],["أَنتَ","kamu","anta",139],["مِن","dari","min",0],["ذِكْرَىٰهَآ","mengingat/menyebut","dhik'rāhā",448]],"t":"Untuk apa engkau perlu menyebutkannya (waktunya)?"},{"n":44,"w":[["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["مُنتَهَىٰهَآ","kesudahannya","muntahāhā",1911]],"t":"Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya)."},{"n":45,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَنتَ","kamu","anta",139],["مُنذِرُ","pemberi peringatan","mundhiru",633],["مَن","dari","man",12],["يَخْشَىٰهَا","ia takut kepadanya","yakhshāhā",294]],"t":"Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat)."},{"n":46,"w":[["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",375],["يَوْمَ","hari","yawma",25],["يَرَوْنَهَا","mereka melihatnya","yarawnahā",46],["لَمْ","tidak","lam",32],["يَلْبَثُوٓا۟","mereka tinggal","yalbathū",364],["إِلَّا","kecuali","illā",15],["عَشِيَّةً","di waktu sore","ʿashiyyatan",3087],["أَوْ","atau","aw",42],["ضُحَىٰهَا","pagi harinya","ḍuḥāhā",1148]],"t":"Pada hari ketika mereka melihat hari Kiamat itu (karena suasananya hebat), mereka merasa seakan-akan hanya (sebentar saja) tinggal (di dunia) pada waktu sore atau pagi hari."}]