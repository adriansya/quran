[{"n":1,"w":[["وَٱلنَّـٰزِعَـٰتِ","demi yang mencabut","wal-nāziʿāti",4084],["غَرْقًۭا","dengan keras","gharqan",3499]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan keras."},{"n":2,"w":[["وَٱلنَّـٰشِطَـٰتِ","dan yang mencabut","wal-nāshiṭāti",4082],["نَشْطًۭا","perlahan-lahan","nashṭan",4011]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut."},{"n":3,"w":[["وَٱلسَّـٰبِحَـٰتِ","dan yang turun","wal-sābiḥāti",4306],["سَبْحًۭا","cepat","sabḥan",2649]],"t":"Demi (malaikat) yang turun dari langit dengan cepat,"},{"n":4,"w":[["فَٱلسَّـٰبِقَـٰتِ","dan yang mendahului","fal-sābiqāti",1016],["سَبْقًۭا","dengan kencang","sabqan",4257]],"t":"dan (malaikat) yang mendahului dengan kencang,"},{"n":5,"w":[["فَٱلْمُدَبِّرَٰتِ","dan yang mengatur","fal-mudabirāti",3823],["أَمْرًۭا","urusan","amran",75]],"t":"dan (malaikat) yang mengatur urusan (dunia)."},{"n":6,"w":[["يَوْمَ","hari","yawma",31],["تَرْجُفُ","bergoncang","tarjufu",2628],["ٱلرَّاجِفَةُ","goncangan","l-rājifatu",4216]],"t":"(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,"},{"n":7,"w":[["تَتْبَعُهَا","mengikutinya","tatbaʿuhā",950],["ٱلرَّادِفَةُ","yang mengiringi","l-rādifatu",4215]],"t":"(tiupan pertama) itu diiringi oleh tiupan kedua."},{"n":8,"w":[["قُلُوبٌۭ","hati-hati","qulūbun",98],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["وَاجِفَةٌ","berdebar/sangat takut","wājifatun",4463]],"t":"Hati manusia pada waktu itu merasa sangat takut,"},{"n":9,"w":[["أَبْصَـٰرُهَا","pandangannya","abṣāruhā",260],["خَـٰشِعَةٌۭ","takut/tertunduk","khāshiʿatun",685]],"t":"pandangannya tunduk."},{"n":10,"w":[["يَقُولُونَ","mereka berkata","yaqūlūna",10],["أَءِنَّا","apakah sesungguhnya kami","a-innā",9],["لَمَرْدُودُونَ","sungguh akan dikembalikan","lamardūdūna",2486],["فِى","dalam","fī",7],["ٱلْحَافِرَةِ","keadaan semula","l-ḥāfirati",3159]],"t":"(orang-orang kafir) berkata, \"Apakah kita benar-benar akan dikembalikan kepada kehidupan yang semula?"},{"n":11,"w":[["أَءِذَا","apakah apabila","a-idhā",29],["كُنَّا","kami adalah/menjadi","kunnā",12],["عِظَـٰمًۭا","tulang belulang","ʿiẓāman",630],["نَّخِرَةًۭ","hancur","nakhiratan",4090]],"t":"Apakah (akan dibangkitkan juga) apabila kita telah menjadi tulang belulang yang hancur?\""},{"n":12,"w":[["قَالُوا۟","mereka berkata","qālū",10],["تِلْكَ","itu","til'ka",310],["إِذًۭا","jika demikian","idhan",375],["كَرَّةٌ","pengembalian","karratun",1207],["خَاسِرَةٌۭ","kerugian","khāsiratun",4527]],"t":"Mereka berkata, \"Kalau demikian, itu adalah suatu pengembalian yang merugikan.\""},{"n":13,"w":[["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",9],["هِىَ","ia/pengembalian","hiya",203],["زَجْرَةٌۭ","teriakan","zajratun",2785],["وَٰحِدَةٌۭ","satu/satu kali","wāḥidatun",379]],"t":"Maka pengembalian itu hanyalah dengan sekali tiupan saja."},{"n":14,"w":[["فَإِذَا","maka tiba-tiba","fa-idhā",657],["هُم","mereka","hum",16],["بِٱلسَّاهِرَةِ","di permukaan bumi","bil-sāhirati",4305]],"t":"Maka seketika itu mereka hidup kembali di bumi (yang baru)."},{"n":15,"w":[["هَلْ","apakah","hal",128],["أَتَىٰكَ","telah sampai kepadamu","atāka",56],["حَدِيثُ","cerita","ḥadīthu",402],["مُوسَىٰٓ","Musa","mūsā",94]],"t":"Sudahkah sampai kepadamu (Muhammad) kisah Musa?"},{"n":16,"w":[["إِذْ","tatkala","idh",61],["نَادَىٰهُ","memanggilnya","nādāhu",283],["رَبُّهُۥ","Tuhannya","rabbuhu",15],["بِٱلْوَادِ","di lembah","bil-wādi",1125],["ٱلْمُقَدَّسِ","suci","l-muqadasi",1943],["طُوًى","Tuwa","ṭuwan",2319]],"t":"Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;"},{"n":17,"w":[["ٱذْهَبْ","pergilah kamu","idh'hab",343],["إِلَىٰ","kepada","ilā",18],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",171],["إِنَّهُۥ","sesungguhnya dia","innahu",9],["طَغَىٰ","melampui batas","ṭaghā",740]],"t":"pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,"},{"n":18,"w":[["فَقُلْ","maka katakanlah","faqul",10],["هَل","apakah/maukah","hal",128],["لَّكَ","bagimu","laka",153],["إِلَىٰٓ","kepada (untuk)","ilā",18],["أَن","untuk","an",22],["تَزَكَّىٰ","kamu membersihkan diri","tazakkā",1020]],"t":"Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),"},{"n":19,"w":[["وَأَهْدِيَكَ","dan aku tunjukkan/pimpin kamu","wa-ahdiyaka",89],["إِلَىٰ","kepada","ilā",18],["رَبِّكَ","Tuhanmu","rabbika",15],["فَتَخْشَىٰ","maka (supaya) kamu takut","fatakhshā",312]],"t":"dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\""},{"n":20,"w":[["فَأَرَىٰهُ","maka dia memperlihatkan padanya","fa-arāhu",54],["ٱلْـَٔايَةَ","ayat-ayat/mu'jizat","l-āyata",34],["ٱلْكُبْرَىٰ","yang besar","l-kub'rā",1096]],"t":"Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar."},{"n":21,"w":[["فَكَذَّبَ","maka dia mendustakan","fakadhaba",72],["وَعَصَىٰ","dan dia mendurhakai","waʿaṣā",411]],"t":"Tetapi dia (Fir'aun) mendustakan dan mendurhakai."},{"n":22,"w":[["ثُمَّ","kemudian","thumma",41],["أَدْبَرَ","dia berpaling","adbara",1486],["يَسْعَىٰ","dia berusaha/berjalan","yasʿā",529]],"t":"Kemudian dia berpaling seraya berusaha menantang (Musa)."},{"n":23,"w":[["فَحَشَرَ","maka dia mengumpulkan","faḥashara",330],["فَنَادَىٰ","lalu dia berseru","fanādā",283]],"t":"Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya)."},{"n":24,"w":[["فَقَالَ","maka dia berkata","faqāla",10],["أَنَا۠","aku","anā",194],["رَبُّكُمُ","Tuhan kalian","rabbukumu",15],["ٱلْأَعْلَىٰ","paling tinggi","l-aʿlā",776]],"t":"(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\""},{"n":25,"w":[["فَأَخَذَهُ","maka mengambil/menyiksanya","fa-akhadhahu",103],["ٱللَّهُ","Allah","l-lahu",4],["نَكَالَ","siksa","nakāla",1972],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",82],["وَٱلْأُولَىٰٓ","dan dunia","wal-ūlā",151]],"t":"Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia."},{"n":26,"w":[["إِنَّ","sesungguhnya","inna",9],["فِى","di dalam","fī",7],["ذَٰلِكَ","itu","dhālika",26],["لَعِبْرَةًۭ","benar-benar pelajaran","laʿib'ratan",1166],["لِّمَن","bagi orang","liman",17],["يَخْشَىٰٓ","takut","yakhshā",312]],"t":"Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah)."},{"n":27,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",96],["أَشَدُّ","sangat","ashaddu",376],["خَلْقًا","penciptaan","khalqan",241],["أَمِ","atau","ami",93],["ٱلسَّمَآءُ ۚ","langit","l-samāu",44],["بَنَىٰهَا","Dia telah membinanya","banāhā",792]],"t":"Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?"},{"n":28,"w":[["رَفَعَ","Dia meninggikan","rafaʿa",484],["سَمْكَهَا","bangunannya","samkahā",4274],["فَسَوَّىٰهَا","lalu Dia sempurnakannya","fasawwāhā",684]],"t":"Dia telah meninggikan bangunannya lalu menyempurnakannya,"},{"n":29,"w":[["وَأَغْطَشَ","dan Dia jadikan gelap","wa-aghṭasha",2970],["لَيْلَهَا","malamnya","laylahā",146],["وَأَخْرَجَ","dan Dia keluarkan/jadikan","wa-akhraja",125],["ضُحَىٰهَا","paginya/siangnya","ḍuḥāhā",1159]],"t":"dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang)."},{"n":30,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",28],["بَعْدَ","sesudah","baʿda",67],["ذَٰلِكَ","demikian itu","dhālika",26],["دَحَىٰهَآ","Dia haparkannya","daḥāhā",3392]],"t":"Dan setelah itu bumi Dia hamparkan."},{"n":31,"w":[["أَخْرَجَ","Dia keluarkan","akhraja",125],["مِنْهَا","dari padanya","min'hā",1],["مَآءَهَا","airnya","māahā",204],["وَمَرْعَىٰهَا","dan padang rumput/tumbuh-tumbuhannya","wamarʿāhā",2484]],"t":"Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya."},{"n":32,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",320],["أَرْسَىٰهَا","Dia pancangkannya","arsāhā",3014]],"t":"Dan gunung-gunung Dia pancangkan dengan kokoh."},{"n":33,"w":[["مَتَـٰعًۭا","kesenangan","matāʿan",347],["لَّكُمْ","bagi kalian","lakum",32],["وَلِأَنْعَـٰمِكُمْ","dan untuk binatang ternakmu","wali-anʿāmikum",363]],"t":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu."},{"n":34,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["جَآءَتِ","telah datang","jāati",51],["ٱلطَّآمَّةُ","keributan/malapetaka","l-ṭāmatu",3315],["ٱلْكُبْرَىٰ","besar","l-kub'rā",1096]],"t":"Maka apabila malapetaka besar (hari Kiamat) telah datang,"},{"n":35,"w":[["يَوْمَ","hari","yawma",31],["يَتَذَكَّرُ","teringat","yatadhakkaru",245],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["مَا","apa","mā",6],["سَعَىٰ","ia telah kerjakan","saʿā",529]],"t":"yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,"},{"n":36,"w":[["وَبُرِّزَتِ","dan diperlihatkan","waburrizati",2350],["ٱلْجَحِيمُ","neraka","l-jaḥīmu",426],["لِمَن","bagi/kepada orang","liman",17],["يَرَىٰ","ia melihat","yarā",54]],"t":"dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat."},{"n":37,"w":[["فَأَمَّا","maka adapun","fa-ammā",229],["مَن","siapa","man",17],["طَغَىٰ","melampui batas","ṭaghā",740]],"t":"Maka adapun orang yang melampaui batas,"},{"n":38,"w":[["وَءَاثَرَ","dan ia senang/mengutamakan","waāthara",1283],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114]],"t":"dan lebih mengutamakan kehidupan dunia,"},{"n":39,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱلْجَحِيمَ","neraka","l-jaḥīma",426],["هِىَ","ia/neraka","hiya",203],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",480]],"t":"maka sungguh, nerakalah tempat tinggalnya."},{"n":40,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["مَنْ","siapa","man",17],["خَافَ","ia takut","khāfa",150],["مَقَامَ","kedudukan/kebesaran","maqāma",680],["رَبِّهِۦ","Tuhannya","rabbihi",15],["وَنَهَى","dan ia menahan","wanahā",372],["ٱلنَّفْسَ","jiwa/diri","l-nafsa",47],["عَنِ","dari","ʿani",27],["ٱلْهَوَىٰ","keinginan/hawa nafsu","l-hawā",796]],"t":"Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,"},{"n":41,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",9],["ٱلْجَنَّةَ","sorga","l-janata",86],["هِىَ","ia","hiya",203],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",480]],"t":"maka sungguh, surgalah tempat tinggal-(nya)."},{"n":42,"w":[["يَسْـَٔلُونَكَ","mereka akan bertanya kepadamu","yasalūnaka",119],["عَنِ","dari","ʿani",27],["ٱلسَّاعَةِ","waktu/kiamat","l-sāʿati",263],["أَيَّانَ","kepada/bila","ayyāna",1155],["مُرْسَىٰهَا","kedatangannya/terjadinya","mur'sāhā",1945]],"t":"Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\""},{"n":43,"w":[["فِيمَ","dalam apa/mengapa","fīma",7],["أَنتَ","kamu","anta",154],["مِن","dari","min",1],["ذِكْرَىٰهَآ","mengingat/menyebut","dhik'rāhā",458]],"t":"Untuk apa engkau perlu menyebutkannya (waktunya)?"},{"n":44,"w":[["إِلَىٰ","kepada","ilā",18],["رَبِّكَ","Tuhanmu","rabbika",15],["مُنتَهَىٰهَآ","kesudahannya","muntahāhā",1941]],"t":"Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya)."},{"n":45,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",9],["أَنتَ","kamu","anta",154],["مُنذِرُ","pemberi peringatan","mundhiru",645],["مَن","dari","man",17],["يَخْشَىٰهَا","ia takut kepadanya","yakhshāhā",312]],"t":"Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat)."},{"n":46,"w":[["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["يَوْمَ","hari","yawma",31],["يَرَوْنَهَا","mereka melihatnya","yarawnahā",54],["لَمْ","tidak","lam",39],["يَلْبَثُوٓا۟","mereka tinggal","yalbathū",384],["إِلَّا","kecuali","illā",20],["عَشِيَّةً","di waktu sore","ʿashiyyatan",3078],["أَوْ","atau","aw",50],["ضُحَىٰهَا","pagi harinya","ḍuḥāhā",1159]],"t":"Pada hari ketika mereka melihat hari Kiamat itu (karena suasananya hebat), mereka merasa seakan-akan hanya (sebentar saja) tinggal (di dunia) pada waktu sore atau pagi hari."}]