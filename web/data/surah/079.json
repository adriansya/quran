[{"n":1,"w":[["وَٱلنَّـٰزِعَـٰتِ","demi yang mencabut","wal-nāziʿāti",4073],["غَرْقًۭا","dengan keras","gharqan",3488]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan keras."},{"n":2,"w":[["وَٱلنَّـٰشِطَـٰتِ","dan yang mencabut","wal-nāshiṭāti",4071],["نَشْطًۭا","perlahan-lahan","nashṭan",4000]],"t":"Demi (malaikat) yang mencabut (nyawa) dengan lemah lembut."},{"n":3,"w":[["وَٱلسَّـٰبِحَـٰتِ","dan yang turun","wal-sābiḥāti",4295],["سَبْحًۭا","cepat","sabḥan",2637]],"t":"Demi (malaikat) yang turun dari langit dengan cepat,"},{"n":4,"w":[["فَٱلسَّـٰبِقَـٰتِ","dan yang mendahului","fal-sābiqāti",1005],["سَبْقًۭا","dengan kencang","sabqan",4246]],"t":"dan (malaikat) yang mendahului dengan kencang,"},{"n":5,"w":[["فَٱلْمُدَبِّرَٰتِ","dan yang mengatur","fal-mudabirāti",3812],["أَمْرًۭا","urusan","amran",67]],"t":"dan (malaikat) yang mengatur urusan (dunia)."},{"n":6,"w":[["يَوْمَ","hari","yawma",25],["تَرْجُفُ","bergoncang","tarjufu",2616],["ٱلرَّاجِفَةُ","goncangan","l-rājifatu",4205]],"t":"(Sungguh, kamu akan dibangkitkan) pada hari ketika tiupan pertama mengguncangkan alam,"},{"n":7,"w":[["تَتْبَعُهَا","mengikutinya","tatbaʿuhā",938],["ٱلرَّادِفَةُ","yang mengiringi","l-rādifatu",4204]],"t":"(tiupan pertama) itu diiringi oleh tiupan kedua."},{"n":8,"w":[["قُلُوبٌۭ","hati-hati","qulūbun",90],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["وَاجِفَةٌ","berdebar/sangat takut","wājifatun",4452]],"t":"Hati manusia pada waktu itu merasa sangat takut,"},{"n":9,"w":[["أَبْصَـٰرُهَا","pandangannya","abṣāruhā",250],["خَـٰشِعَةٌۭ","takut/tertunduk","khāshiʿatun",675]],"t":"pandangannya tunduk."},{"n":10,"w":[["يَقُولُونَ","mereka berkata","yaqūlūna",6],["أَءِنَّا","apakah sesungguhnya kami","a-innā",5],["لَمَرْدُودُونَ","sungguh akan dikembalikan","lamardūdūna",2474],["فِى","dalam","fī",3],["ٱلْحَافِرَةِ","keadaan semula","l-ḥāfirati",3148]],"t":"(orang-orang kafir) berkata, \"Apakah kita benar-benar akan dikembalikan kepada kehidupan yang semula?"},{"n":11,"w":[["أَءِذَا","apakah apabila","a-idhā",23],["كُنَّا","kami adalah/menjadi","kunnā",8],["عِظَـٰمًۭا","tulang belulang","ʿiẓāman",101],["نَّخِرَةًۭ","hancur","nakhiratan",4079]],"t":"Apakah (akan dibangkitkan juga) apabila kita telah menjadi tulang belulang yang hancur?\""},{"n":12,"w":[["قَالُوا۟","mereka berkata","qālū",6],["تِلْكَ","itu","til'ka",300],["إِذًۭا","jika demikian","idhan",365],["كَرَّةٌ","pengembalian","karratun",1195],["خَاسِرَةٌۭ","kerugian","khāsiratun",4516]],"t":"Mereka berkata, \"Kalau demikian, itu adalah suatu pengembalian yang merugikan.\""},{"n":13,"w":[["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",5],["هِىَ","ia/pengembalian","hiya",193],["زَجْرَةٌۭ","teriakan","zajratun",2773],["وَٰحِدَةٌۭ","satu/satu kali","wāḥidatun",369]],"t":"Maka pengembalian itu hanyalah dengan sekali tiupan saja."},{"n":14,"w":[["فَإِذَا","maka tiba-tiba","fa-idhā",647],["هُم","mereka","hum",11],["بِٱلسَّاهِرَةِ","di permukaan bumi","bil-sāhirati",4294]],"t":"Maka seketika itu mereka hidup kembali di bumi (yang baru)."},{"n":15,"w":[["هَلْ","apakah","hal",119],["أَتَىٰكَ","telah sampai kepadamu","atāka",48],["حَدِيثُ","cerita","ḥadīthu",392],["مُوسَىٰٓ","Musa","mūsā",86]],"t":"Sudahkah sampai kepadamu (Muhammad) kisah Musa?"},{"n":16,"w":[["إِذْ","tatkala","idh",53],["نَادَىٰهُ","memanggilnya","nādāhu",273],["رَبُّهُۥ","Tuhannya","rabbuhu",10],["بِٱلْوَادِ","di lembah","bil-wādi",1113],["ٱلْمُقَدَّسِ","suci","l-muqadasi",1931],["طُوًى","Tuwa","ṭuwan",2308]],"t":"Ketika Tuhan memanggilnya (Musa) di lembah suci yaitu Lembah Tuwa;"},{"n":17,"w":[["ٱذْهَبْ","pergilah kamu","idh'hab",333],["إِلَىٰ","kepada","ilā",13],["فِرْعَوْنَ","Fir'aun","fir'ʿawna",161],["إِنَّهُۥ","sesungguhnya dia","innahu",5],["طَغَىٰ","melampui batas","ṭaghā",730]],"t":"pergilah engkau kepada Fir'aun! Sesungguhnya dia telah melampaui batas,"},{"n":18,"w":[["فَقُلْ","maka katakanlah","faqul",6],["هَل","apakah/maukah","hal",119],["لَّكَ","bagimu","laka",144],["إِلَىٰٓ","kepada (untuk)","ilā",13],["أَن","untuk","an",17],["تَزَكَّىٰ","kamu membersihkan diri","tazakkā",1008]],"t":"Maka katakanlah (kepada Fir'aun), \"Adakah keinginanmu untuk membersihkan diri (dari kesesatan),"},{"n":19,"w":[["وَأَهْدِيَكَ","dan aku tunjukkan/pimpin kamu","wa-ahdiyaka",81],["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["فَتَخْشَىٰ","maka (supaya) kamu takut","fatakhshā",302]],"t":"dan engkau akan kubimbing ke jalan Tuhanmu agar engkau takut kepada-Nya?\""},{"n":20,"w":[["فَأَرَىٰهُ","maka dia memperlihatkan padanya","fa-arāhu",46],["ٱلْـَٔايَةَ","ayat-ayat/mu'jizat","l-āyata",28],["ٱلْكُبْرَىٰ","yang besar","l-kub'rā",1084]],"t":"Lalu (Musa) memperlihatkan kepadanya mukjizat yang besar."},{"n":21,"w":[["فَكَذَّبَ","maka dia mendustakan","fakadhaba",64],["وَعَصَىٰ","dan dia mendurhakai","waʿaṣā",401]],"t":"Tetapi dia (Fir'aun) mendustakan dan mendurhakai."},{"n":22,"w":[["ثُمَّ","kemudian","thumma",34],["أَدْبَرَ","dia berpaling","adbara",1474],["يَسْعَىٰ","dia berusaha/berjalan","yasʿā",520]],"t":"Kemudian dia berpaling seraya berusaha menantang (Musa)."},{"n":23,"w":[["فَحَشَرَ","maka dia mengumpulkan","faḥashara",320],["فَنَادَىٰ","lalu dia berseru","fanādā",273]],"t":"Kemudian dia mengumpulkan (pembesar-pembesarnya) lalu berseru (memanggil kaumnya)."},{"n":24,"w":[["فَقَالَ","maka dia berkata","faqāla",6],["أَنَا۠","aku","anā",184],["رَبُّكُمُ","Tuhan kalian","rabbukumu",10],["ٱلْأَعْلَىٰ","paling tinggi","l-aʿlā",766]],"t":"(Seraya) berkata, \"Akulah tuhanmu yang paling tinggi.\""},{"n":25,"w":[["فَأَخَذَهُ","maka mengambil/menyiksanya","fa-akhadhahu",95],["ٱللَّهُ","Allah","l-lahu",1],["نَكَالَ","siksa","nakāla",1960],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",74],["وَٱلْأُولَىٰٓ","dan dunia","wal-ūlā",142]],"t":"Maka Allah menghukumnya dengan azab di akhirat dan siksaan di dunia."},{"n":26,"w":[["إِنَّ","sesungguhnya","inna",5],["فِى","di dalam","fī",3],["ذَٰلِكَ","itu","dhālika",20],["لَعِبْرَةًۭ","benar-benar pelajaran","laʿib'ratan",1154],["لِّمَن","bagi orang","liman",12],["يَخْشَىٰٓ","takut","yakhshā",302]],"t":"Sungguh, pada yang demikian itu terdapat pelajaran bagi orang yang takut (kepada Allah)."},{"n":27,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",88],["أَشَدُّ","sangat","ashaddu",366],["خَلْقًا","penciptaan","khalqan",231],["أَمِ","atau","ami",85],["ٱلسَّمَآءُ ۚ","langit","l-samāu",37],["بَنَىٰهَا","Dia telah membinanya","banāhā",782]],"t":"Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?"},{"n":28,"w":[["رَفَعَ","Dia meninggikan","rafaʿa",476],["سَمْكَهَا","bangunannya","samkahā",4263],["فَسَوَّىٰهَا","lalu Dia sempurnakannya","fasawwāhā",674]],"t":"Dia telah meninggikan bangunannya lalu menyempurnakannya,"},{"n":29,"w":[["وَأَغْطَشَ","dan Dia jadikan gelap","wa-aghṭasha",2959],["لَيْلَهَا","malamnya","laylahā",137],["وَأَخْرَجَ","dan Dia keluarkan/jadikan","wa-akhraja",115],["ضُحَىٰهَا","paginya/siangnya","ḍuḥāhā",1147]],"t":"dan Dia menjadikan malamnya (gelap gulita), dan menjadikan siangnya (terang benderang)."},{"n":30,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["بَعْدَ","sesudah","baʿda",59],["ذَٰلِكَ","demikian itu","dhālika",20],["دَحَىٰهَآ","Dia haparkannya","daḥāhā",3381]],"t":"Dan setelah itu bumi Dia hamparkan."},{"n":31,"w":[["أَخْرَجَ","Dia keluarkan","akhraja",115],["مِنْهَا","dari padanya","min'hā",0],["مَآءَهَا","airnya","māahā",194],["وَمَرْعَىٰهَا","dan padang rumput/tumbuh-tumbuhannya","wamarʿāhā",2472]],"t":"Darinya Dia pancarkan mata air, dan (ditumbuhkan) tumbuh-tumbuhannya."},{"n":32,"w":[["وَٱلْجِبَالَ","dan gunung-gunung","wal-jibāla",310],["أَرْسَىٰهَا","Dia pancangkannya","arsāhā",3003]],"t":"Dan gunung-gunung Dia pancangkan dengan kokoh."},{"n":33,"w":[["مَتَـٰعًۭا","kesenangan","matāʿan",337],["لَّكُمْ","bagi kalian","lakum",26],["وَلِأَنْعَـٰمِكُمْ","dan untuk binatang ternakmu","wali-anʿāmikum",353]],"t":"(Semua itu) untuk kesenanganmu dan untuk hewan-hewan ternakmu."},{"n":34,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["جَآءَتِ","telah datang","jāati",43],["ٱلطَّآمَّةُ","keributan/malapetaka","l-ṭāmatu",3304],["ٱلْكُبْرَىٰ","besar","l-kub'rā",1084]],"t":"Maka apabila malapetaka besar (hari Kiamat) telah datang,"},{"n":35,"w":[["يَوْمَ","hari","yawma",25],["يَتَذَكَّرُ","teringat","yatadhakkaru",235],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["مَا","apa","mā",2],["سَعَىٰ","ia telah kerjakan","saʿā",520]],"t":"yaitu pada hari (ketika) manusia teringat akan apa yang telah dikerjakannya,"},{"n":36,"w":[["وَبُرِّزَتِ","dan diperlihatkan","waburrizati",2339],["ٱلْجَحِيمُ","neraka","l-jaḥīmu",416],["لِمَن","bagi/kepada orang","liman",12],["يَرَىٰ","ia melihat","yarā",46]],"t":"dan neraka diperlihatkan dengan jelas kepada setiap orang yang melihat."},{"n":37,"w":[["فَأَمَّا","maka adapun","fa-ammā",219],["مَن","siapa","man",12],["طَغَىٰ","melampui batas","ṭaghā",730]],"t":"Maka adapun orang yang melampaui batas,"},{"n":38,"w":[["وَءَاثَرَ","dan ia senang/mengutamakan","waāthara",1271],["ٱلْحَيَوٰةَ","kehidupan","l-ḥayata",154],["ٱلدُّنْيَا","dunia","l-dun'yā",105]],"t":"dan lebih mengutamakan kehidupan dunia,"},{"n":39,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلْجَحِيمَ","neraka","l-jaḥīma",416],["هِىَ","ia/neraka","hiya",193],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",472]],"t":"maka sungguh, nerakalah tempat tinggalnya."},{"n":40,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["مَنْ","siapa","man",12],["خَافَ","ia takut","khāfa",141],["مَقَامَ","kedudukan/kebesaran","maqāma",670],["رَبِّهِۦ","Tuhannya","rabbihi",10],["وَنَهَى","dan ia menahan","wanahā",362],["ٱلنَّفْسَ","jiwa/diri","l-nafsa",39],["عَنِ","dari","ʿani",21],["ٱلْهَوَىٰ","keinginan/hawa nafsu","l-hawā",786]],"t":"Dan adapun orang-orang yang takut kepada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,"},{"n":41,"w":[["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلْجَنَّةَ","sorga","l-janata",78],["هِىَ","ia","hiya",193],["ٱلْمَأْوَىٰ","tempat tinggal","l-mawā",472]],"t":"maka sungguh, surgalah tempat tinggal-(nya)."},{"n":42,"w":[["يَسْـَٔلُونَكَ","mereka akan bertanya kepadamu","yasalūnaka",109],["عَنِ","dari","ʿani",21],["ٱلسَّاعَةِ","waktu/kiamat","l-sāʿati",253],["أَيَّانَ","kepada/bila","ayyāna",1143],["مُرْسَىٰهَا","kedatangannya/terjadinya","mur'sāhā",1933]],"t":"Mereka (orang-orang kafir) bertanya kepadamu (Muhammad) tentang hari Kiamat, \"Kapankah terjadinya?\""},{"n":43,"w":[["فِيمَ","dalam apa/mengapa","fīma",3],["أَنتَ","kamu","anta",145],["مِن","dari","min",0],["ذِكْرَىٰهَآ","mengingat/menyebut","dhik'rāhā",449]],"t":"Untuk apa engkau perlu menyebutkannya (waktunya)?"},{"n":44,"w":[["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["مُنتَهَىٰهَآ","kesudahannya","muntahāhā",1929]],"t":"Kepada Tuhanmulah (dikembalikan) kesudahannya (ketentuan waktunya)."},{"n":45,"w":[["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَنتَ","kamu","anta",145],["مُنذِرُ","pemberi peringatan","mundhiru",635],["مَن","dari","man",12],["يَخْشَىٰهَا","ia takut kepadanya","yakhshāhā",302]],"t":"Engkau (Muhammad) hanyalah pemberi peringatan bagi siapa yang takut kepadanya (hari Kiamat)."},{"n":46,"w":[["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",385],["يَوْمَ","hari","yawma",25],["يَرَوْنَهَا","mereka melihatnya","yarawnahā",46],["لَمْ","tidak","lam",32],["يَلْبَثُوٓا۟","mereka tinggal","yalbathū",374],["إِلَّا","kecuali","illā",15],["عَشِيَّةً","di waktu sore","ʿashiyyatan",3067],["أَوْ","atau","aw",42],["ضُحَىٰهَا","pagi harinya","ḍuḥāhā",1147]],"t":"Pada hari ketika mereka melihat hari Kiamat itu (karena suasananya hebat), mereka merasa seakan-akan hanya (sebentar saja) tinggal (di dunia) pada waktu sore atau pagi hari."}]