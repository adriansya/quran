[{"n":1,"w":[["الٓمٓ","Alif laam Miim","alif-lam-meem",1155]],"t":"Alif Lām Mīm"},{"n":2,"w":[["تَنزِيلُ","turunnya","tanzīlu",636],["ٱلْكِتَـٰبِ","kitab (Al Qur'an)","l-kitābi",49],["لَا","tidak ada","lā",4],["رَيْبَ","keraguan","rayba",553],["فِيهِ","di dalamnya","fīhi",3],["مِن","dari","min",0],["رَّبِّ","Tuhan","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",163]],"t":"Turunnya Alquran itu tidak ada keraguan padanya, (yaitu) dari Tuhan seluruh alam."},{"n":3,"w":[["أَمْ","ataukah/apakah","am",84],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["ٱفْتَرَىٰهُ ۚ","ia mengada-adakannya","if'tarāhu",235],["بَلْ","bahkan","bal",96],["هُوَ","ia/itu(Al Qur'an)","huwa",20],["ٱلْحَقُّ","benar","l-ḥaqu",50],["مِن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["لِتُنذِرَ","supaya kamu memberi peringatan","litundhira",265],["قَوْمًۭا","kaum","qawman",27],["مَّآ","belum","mā",2],["أَتَىٰهُم","datang kepada mereka","atāhum",48],["مِّن","dari","min",0],["نَّذِيرٍۢ","seorang pemberi peringatan","nadhīrin",204],["مِّن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["لَعَلَّهُمْ","agar mereka","laʿallahum",92],["يَهْتَدُونَ","mereka mendapat petunjuk","yahtadūna",298]],"t":"Tetapi mengapa mereka (orang kafir) mengatakan, \"Dia (Muhammad) telah mengada-adakannya.\" Tidak, Alquran itu kebenaran (yang datang) dari Tuhanmu, agar engkau memberi peringatan kepada kaum yang belum pernah didatangi orang yang memberi peringatan sebelum engkau; agar mereka mendapat petunjuk."},{"n":4,"w":[["ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",61],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa yang","wamā",2],["بَيْنَهُمَا","antara keduanya","baynahumā",47],["فِى","dalam","fī",3],["سِتَّةِ","enam","sittati",1102],["أَيَّامٍۢ","masa","ayyāmin",25],["ثُمَّ","kemudian","thumma",34],["ٱسْتَوَىٰ","Dia menuju","is'tawā",336],["عَلَى","di atas","ʿalā",8],["ٱلْعَرْشِ ۖ","'Arsy","l-ʿarshi",377],["مَا","tidak ada","mā",2],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["دُونِهِۦ","selain-Nya","dūnihi",79],["مِن","dari","min",0],["وَلِىٍّۢ","seorang penolong","waliyyin",132],["وَلَا","dan tidak ada","walā",4],["شَفِيعٍ ۚ","seorang pemberi syafa'at","shafīʿin",807],["أَفَلَا","apakah maka tidak","afalā",4],["تَتَذَكَّرُونَ","kamu memperhatikan","tatadhakkarūna",233]],"t":"Allah yang menciptakan langit dan bumi dan apa yang ada di antara keduanya dalam enam masa, kemudian Dia bersemayam di atas Arasy. Bagimu tidak ada seorang pun penolong maupun pemberi syafaat selain Dia. Maka apakah kamu tidak memperhatikan?"},{"n":5,"w":[["يُدَبِّرُ","Dia mengatur","yudabbiru",1549],["ٱلْأَمْرَ","urusan","l-amra",66],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["إِلَى","sampai","ilā",13],["ٱلْأَرْضِ","bumi","l-arḍi",22],["ثُمَّ","kemudian","thumma",34],["يَعْرُجُ","ia naik","yaʿruju",1291],["إِلَيْهِ","kepada-Nya","ilayhi",13],["فِى","dalam","fī",3],["يَوْمٍۢ","satu hari","yawmin",25],["كَانَ","adalah","kāna",9],["مِقْدَارُهُۥٓ","ukurannya","miq'dāruhu",1910],["أَلْفَ","seribu","alfa",644],["سَنَةٍۢ","tahun","sanatin",531],["مِّمَّا","dari apa(menurut)","mimmā",0],["تَعُدُّونَ","perhitunganmu","taʿuddūna",1042]],"t":"Dia mengatur segala urusan dari langit ke bumi, kemudian (urusan) itu naik kepada-Nya dalam satu hari yang kadarnya (lamanya) adalah seribu tahun menurut perhitunganmu."},{"n":6,"w":[["ذَٰلِكَ","demikian itu","dhālika",19],["عَـٰلِمُ","yang mengetahui","ʿālimu",543],["ٱلْغَيْبِ","yang gaib","l-ghaybi",242],["وَٱلشَّهَـٰدَةِ","dan yang nyata","wal-shahādati",407],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",113],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",103]],"t":"Yang demikian itu, ialah Tuhan yang mengetahui yang gaib dan yang nyata, Yang Mahaperkasa, Maha Penyayang,"},{"n":7,"w":[["ٱلَّذِىٓ","yang","alladhī",7],["أَحْسَنَ","Dia membuat bagus","aḥsana",481],["كُلَّ","setiap","kulla",31],["شَىْءٍ","sesuatu","shayin",41],["خَلَقَهُۥ ۖ","Dia menciptakannya","khalaqahu",61],["وَبَدَأَ","dan Dia memulai","wabada-a",727],["خَلْقَ","ciptaan","khalqa",229],["ٱلْإِنسَـٰنِ","manusia","l-insāni",170],["مِن","dari","min",0],["طِينٍۢ","tanah","ṭīnin",726]],"t":"Yang memperindah segala sesuatu yang Dia ciptakan dan yang memulai penciptaan manusia dari tanah,"},{"n":8,"w":[["ثُمَّ","kemudian","thumma",34],["جَعَلَ","Dia menjadikan","jaʿala",33],["نَسْلَهُۥ","keturunannya","naslahu",2564],["مِن","dari","min",0],["سُلَـٰلَةٍۢ","sari pati","sulālatin",2656],["مِّن","dari","min",0],["مَّآءٍۢ","air","māin",192],["مَّهِينٍۢ","yang hina","mahīnin",1606]],"t":"kemudian Dia menjadikan keturunannya dari saripati air yang hina (air mani)."},{"n":9,"w":[["ثُمَّ","kemudian","thumma",34],["سَوَّىٰهُ","Dia menyempurnakannya","sawwāhu",669],["وَنَفَخَ","dan Dia meniupkan","wanafakha",530],["فِيهِ","kedalamnya","fīhi",3],["مِن","dari","min",0],["رُّوحِهِۦ ۖ","ruh-Nya","rūḥihi",493],["وَجَعَلَ","dan Dia menjadikan","wajaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلسَّمْعَ","pendengaran","l-samʿa",474],["وَٱلْأَبْصَـٰرَ","dan penglihatan","wal-abṣāra",248],["وَٱلْأَفْـِٔدَةَ ۚ","dan hati","wal-afidata",593],["قَلِيلًۭا","sedikit sekali","qalīlan",175],["مَّا","apa","mā",2],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",254]],"t":"Kemudian Dia menyempurnakannya dan meniupkan roh (ciptaan)-Nya ke dalam (tubuh)nya dan Dia menjadikan pendengaran, penglihatan dan hati bagimu, (tetapi) sedikit sekali dari kamu yang bersyukur."},{"n":10,"w":[["وَقَالُوٓا۟","dan mereka berkata","waqālū",6],["أَءِذَا","apakah bila","a-idhā",23],["ضَلَلْنَا","kami telah sesat","ḍalalnā",223],["فِى","dalam","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["أَءِنَّا","apakah sesungguhnya kami","a-innā",5],["لَفِى","sungguh dalam","lafī",3],["خَلْقٍۢ","ciptaan","khalqin",229],["جَدِيدٍۭ ۚ","baru","jadīdin",976],["بَلْ","bahkan","bal",96],["هُم","mereka","hum",11],["بِلِقَآءِ","dengan pertemuan","biliqāi",439],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["كَـٰفِرُونَ","mereka ingkar","kāfirūna",70]],"t":"Dan mereka berkata, \"Apakah apabila kami telah lenyap (hancur) di dalam tanah, kami akan berada dalam ciptaan yang baru?\" Bahkan mereka mengingkari pertemuan dengan Tuhannya."},{"n":11,"w":[["۞ قُلْ","katakanlah","qul",6],["يَتَوَفَّىٰكُم","akan mewafatkan kamu","yatawaffākum",440],["مَّلَكُ","malaikat","malaku",127],["ٱلْمَوْتِ","maut","l-mawti",237],["ٱلَّذِى","yang","alladhī",7],["وُكِّلَ","diserahi","wukkila",2719],["بِكُمْ","dengan/untuk kalian","bikum",26],["ثُمَّ","kemudian","thumma",34],["إِلَىٰ","kepada","ilā",13],["رَبِّكُمْ","Tuhan kalian","rabbikum",10],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",146]],"t":"Katakanlah, \"Malaikat maut yang diserahi untuk (mencabut nyawa) mu akan mematikan kamu, kemudian kepada Tuhanmu, kamu akan dikembalikan.\""},{"n":12,"w":[["وَلَوْ","dan sekiranya","walaw",57],["تَرَىٰٓ","kamu melihat","tarā",46],["إِذِ","ketika","idhi",53],["ٱلْمُجْرِمُونَ","orang-orang ynag berdosa","l-muj'rimūna",228],["نَاكِسُوا۟","mereka menundukkan","nākisū",4000],["رُءُوسِهِمْ","kepala mereka","ruūsihim",552],["عِندَ","di sisi","ʿinda",59],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["رَبَّنَآ","ya Tuhan kami","rabbanā",10],["أَبْصَرْنَا","kami telah melihat","abṣarnā",375],["وَسَمِعْنَا","dan kami telah mendengar","wasamiʿ'nā",148],["فَٱرْجِعْنَا","maka kembalikanlah kami","fa-ir'jiʿ'nā",146],["نَعْمَلْ","kami akan mengerjakan","naʿmal",44],["صَـٰلِحًا","amal shaleh","ṣāliḥan",95],["إِنَّا","sesungguhnya kami","innā",5],["مُوقِنُونَ","orang-orang yang yakin","mūqinūna",1385]],"t":"Dan (alangkah ngerinya), jika sekiranya kamu melihat orang-orang yang berdosa itu menundukkan kepalanya di hadapan Tuhannya, (mereka berkata), \"Ya Tuhan kami, kami telah melihat dan mendengar, maka kembalikanlah kami (ke dunia), niscaya kami akan mengerjakan kebajikan. Sungguh, kami adalah orang-orang yang yakin.\""},{"n":13,"w":[["وَلَوْ","dan jika","walaw",57],["شِئْنَا","Kami menghendaki","shi'nā",54],["لَـَٔاتَيْنَا","niscaya Kami memberikan","laātaynā",45],["كُلَّ","setiap","kulla",31],["نَفْسٍ","jiwa","nafsin",39],["هُدَىٰهَا","petunjuknya","hudāhā",133],["وَلَـٰكِنْ","akan tetapi","walākin",165],["حَقَّ","telah pasti","ḥaqqa",505],["ٱلْقَوْلُ","ketetapan","l-qawlu",119],["مِنِّى","dari-Ku","minnī",0],["لَأَمْلَأَنَّ","sungguh akan Aku penuhi","la-amla-anna",1193],["جَهَنَّمَ","neraka jahanam","jahannama",151],["مِنَ","dari","mina",0],["ٱلْجِنَّةِ","jin","l-jinati",835],["وَٱلنَّاسِ","dan manusia","wal-nāsi",52],["أَجْمَعِينَ","semuanya/bersama-sama","ajmaʿīna",409]],"t":"Dan jika Kami menghendaki niscaya Kami berikan kepada setiap jiwa petunjuk (bagi)nya, tetapi telah ditetapkan perkataan (ketetapan) dari-Ku, \"Pasti akan Aku penuhi neraka Jahanam dengan jin dan manusia bersama-sama."},{"n":14,"w":[["فَذُوقُوا۟","maka rasakanlah","fadhūqū",324],["بِمَا","dengan apa","bimā",2],["نَسِيتُمْ","kamu telah melupakan","nasītum",334],["لِقَآءَ","pertemuan","liqāa",439],["يَوْمِكُمْ","harimu","yawmikum",25],["هَـٰذَآ","ini","hādhā",37],["إِنَّا","sesungguhnya Kami","innā",5],["نَسِينَـٰكُمْ ۖ","Kami melupakan kamu","nasīnākum",334],["وَذُوقُوا۟","dan rasakanlah","wadhūqū",324],["عَذَابَ","azab","ʿadhāba",36],["ٱلْخُلْدِ","kekal","l-khul'di",1249],["بِمَا","dengan apa/sebab","bimā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Maka rasakanlah olehmu (azab ini) disebabkan kamu melalaikan pertemuan dengan harimu ini (hari Kiamat), sesungguhnya Kami pun melalaikan kamu dan rasakanlah azab yang kekal, atas apa yang telah kamu kerjakan.\""},{"n":15,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["يُؤْمِنُ","beriman","yu'minu",18],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["إِذَا","apabila","idhā",23],["ذُكِّرُوا۟","mereka diperingatkan","dhukkirū",535],["بِهَا","dengannya","bihā",97],["خَرُّوا۟","mereka menyungkur","kharrū",750],["سُجَّدًۭا","sujud","sujjadan",455],["وَسَبَّحُوا۟","dan mereka bertasbih","wasabbaḥū",279],["بِحَمْدِ","dengan memuji","biḥamdi",272],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يَسْتَكْبِرُونَ ۩","mereka menyombongkan diri","yastakbirūna",300]],"t":"Orang-orang yang beriman dengan ayat-ayat Kami, hanyalah orang-orang yang apabila diperingatkan dengannya (ayat-ayat Kami), mereka menyungkur sujud dan bertasbih serta memuji Tuhannya, dan mereka tidak menyombongkan diri."},{"n":16,"w":[["تَتَجَافَىٰ","menjauhkan","tatajāfā",4352],["جُنُوبُهُمْ","lambung mereka","junūbuhum",977],["عَنِ","dari","ʿani",21],["ٱلْمَضَاجِعِ","tempat berbaring/tidur","l-maḍājiʿi",1894],["يَدْعُونَ","mereka berdo'a","yadʿūna",65],["رَبَّهُمْ","Tuhan mereka","rabbahum",10],["خَوْفًۭا","rasa takut","khawfan",416],["وَطَمَعًۭا","dan berharap","waṭamaʿan",1532],["وَمِمَّا","dan dari apa/rezeki","wamimmā",0],["رَزَقْنَـٰهُمْ","Kami berikan rezeki mereka","razaqnāhum",196],["يُنفِقُونَ","mereka menafkahkan","yunfiqūna",182]],"t":"Lambung mereka jauh dari tempat tidurnya, mereka berdoa kepada Tuhannya dengan rasa takut dan penuh harap, dan mereka menginfakkan sebagian dari rezeki yang Kami berikan kepada mereka."},{"n":17,"w":[["فَلَا","maka tidak","falā",4],["تَعْلَمُ","mengetahui","taʿlamu",29],["نَفْسٌۭ","seseorang","nafsun",39],["مَّآ","apa yang","mā",2],["أُخْفِىَ","disembunyikan","ukh'fiya",520],["لَهُم","untuk mereka","lahum",11],["مِّن","dari","min",0],["قُرَّةِ","menyejukkan","qurrati",1977],["أَعْيُنٍۢ","pandangan mata","aʿyunin",206],["جَزَآءًۢ","pembalasan","jazāan",276],["بِمَا","terhadap apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Maka tidak seorang pun mengetahui apa yang disembunyikan untuk mereka yaitu (bermacam-macam nikmat) yang menyenangkan hati sebagai balasan terhadap apa yang mereka kerjakan."},{"n":18,"w":[["أَفَمَن","apakah maka orang","afaman",12],["كَانَ","adalah dia","kāna",9],["مُؤْمِنًۭا","orang yang beriman","mu'minan",55],["كَمَن","seperti orang","kaman",12],["كَانَ","adalah dia","kāna",9],["فَاسِقًۭا ۚ","orang yang fasik","fāsiqan",319],["لَّا","tidak","lā",4],["يَسْتَوُۥنَ","mereka sama","yastawūna",336]],"t":"Maka apakah orang yang beriman seperti orang yang fasik (kafir)? Mereka tidak sama."},{"n":19,"w":[["أَمَّا","adapun","ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","mereka beriman","āmanū",18],["وَعَمِلُوا۟","dan beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","shaleh","l-ṣāliḥāti",95],["فَلَهُمْ","maka bagi mereka","falahum",11],["جَنَّـٰتُ","surga","jannātu",77],["ٱلْمَأْوَىٰ","tempat kediaman","l-mawā",467],["نُزُلًۢا","diturunkan/pembalasan","nuzulan",994],["بِمَا","terhadap apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Adapun orang-orang yang beriman dan mengerjakan kebajikan, maka mereka akan mendapat surga-surga tempat kediaman, sebagai pahala atas apa yang telah mereka kerjakan."},{"n":20,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["فَسَقُوا۟","fasik","fasaqū",832],["فَمَأْوَىٰهُمُ","maka tempat kediaman mereka","famawāhumu",467],["ٱلنَّارُ ۖ","api/neraka","l-nāru",78],["كُلَّمَآ","setiap kali","kullamā",627],["أَرَادُوٓا۟","mereka hendak","arādū",83],["أَن","bahwa","an",17],["يَخْرُجُوا۟","mereka akan keluar","yakhrujū",225],["مِنْهَآ","darinya","min'hā",0],["أُعِيدُوا۟","mereka dikembalikan","uʿīdū",537],["فِيهَا","didalamnya","fīhā",3],["وَقِيلَ","dan dikatakan","waqīla",6],["لَهُمْ","kepada mereka","lahum",11],["ذُوقُوا۟","rasakanlah","dhūqū",324],["عَذَابَ","azab","ʿadhāba",36],["ٱلنَّارِ","api/neraka","l-nāri",78],["ٱلَّذِى","yang","alladhī",7],["كُنتُم","kalian adalah","kuntum",9],["بِهِۦ","kepadanya","bihi",16],["تُكَذِّبُونَ","kamu dustakan","tukadhibūna",63]],"t":"Dan adapun orang-orang yang fasik (kafir), maka tempat kediaman mereka adalah neraka. Setiap kali mereka hendak keluar darinya, mereka dikembalikan (lagi) ke dalamnya dan dikatakan kepada mereka, \"Rasakanlah azab neraka yang dahulu kamu dustakan.\""},{"n":21,"w":[["وَلَنُذِيقَنَّهُم","dan sungguh Kami rasakan kepada mereka","walanudhīqannahum",458],["مِّنَ","dari sebagian","mina",0],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["ٱلْأَدْنَىٰ","dekat","l-adnā",711],["دُونَ","bukan","dūna",79],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["ٱلْأَكْبَرِ","besar","l-akbari",432],["لَعَلَّهُمْ","agar mereka","laʿallahum",92],["يَرْجِعُونَ","mereka kembali","yarjiʿūna",146]],"t":"Dan pasti Kami timpakan kepada mereka sebagian siksa yang dekat (di dunia) sebelum azab yang lebih besar (di akhirat); agar mereka kembali (ke jalan yang benar)."},{"n":22,"w":[["وَمَنْ","dan barang siapa","waman",12],["أَظْلَمُ","lebih zalim","aẓlamu",584],["مِمَّن","dari pada orang","mimman",0],["ذُكِّرَ","diperingatkan","dhukkira",535],["بِـَٔايَـٰتِ","dengan ayat-ayat","biāyāti",28],["رَبِّهِۦ","Tuhannya","rabbihi",10],["ثُمَّ","kemudian","thumma",34],["أَعْرَضَ","dia berpaling","aʿraḍa",351],["عَنْهَآ ۚ","dari padanya","ʿanhā",21],["إِنَّا","sesungguhnya Kami","innā",5],["مِنَ","dari","mina",0],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",228],["مُنتَقِمُونَ","yang menyiksa","muntaqimūna",1924]],"t":"Dan siapakah yang lebih zalim daripada orang yang telah diperingatkan dengan ayat-ayat Tuhannya, kemudian dia berpaling darinya? Sungguh, Kami akan memberikan balasan kepada orang-orang yang berdosa."},{"n":23,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["ءَاتَيْنَا","Kami telah berikan","ātaynā",45],["مُوسَى","Musa","mūsā",85],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",49],["فَلَا","maka jangan","falā",4],["تَكُن","kamu adalah","takun",9],["فِى","dalam","fī",3],["مِرْيَةٍۢ","keragu-raguan","mir'yatin",1369],["مِّن","dari","min",0],["لِّقَآئِهِۦ ۖ","menemuinya","liqāihi",439],["وَجَعَلْنَـٰهُ","dan Kami menjadikannya","wajaʿalnāhu",33],["هُدًۭى","petunjuk","hudan",133],["لِّبَنِىٓ","bagi Bani","libanī",81],["إِسْرَٰٓءِيلَ","Israil","is'rāīla",270]],"t":"Dan sungguh, telah Kami anugerahkan Kitab (Taurat) kepada Musa, maka janganlah engkau (Muhammad) ragu-ragu menerimanya (Alquran) dan Kami jadikan Kitab (Taurat) itu petunjuk bagi Bani Israil."},{"n":24,"w":[["وَجَعَلْنَا","dan Kami jadikan","wajaʿalnā",33],["مِنْهُمْ","diantara mereka","min'hum",0],["أَئِمَّةًۭ","pemimpin-pemimpin","a-immatan",706],["يَهْدُونَ","mereka memberikan petunjuk","yahdūna",80],["بِأَمْرِنَا","dengan perintah Kami","bi-amrinā",66],["لَمَّا","ketika","lammā",72],["صَبَرُوا۟ ۖ","mereka sabar","ṣabarū",203],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["بِـَٔايَـٰتِنَا","dengan ayat-ayat Kami","biāyātinā",28],["يُوقِنُونَ","mereka meyakini","yūqinūna",715]],"t":"Dan Kami jadikan diantara mereka itu pemimpin-pemimpin yang memberi petunjuk dengan perintah Kami selama mereka sabar. Mereka meyakini ayat-ayat Kami."},{"n":25,"w":[["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["يَفْصِلُ","memberikan keputusan","yafṣilu",1332],["بَيْنَهُمْ","diantara mereka","baynahum",47],["يَوْمَ","hari","yawma",25],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",177],["فِيمَا","tentang apa","fīmā",3],["كَانُوا۟","adalah mereka","kānū",9],["فِيهِ","didalamnya","fīhi",3],["يَخْتَلِفُونَ","mereka perselisihkan","yakhtalifūna",337]],"t":"Sungguh Tuhanmu, Dia yang memberikan keputusan di antara mereka pada hari Kiamat tentang apa yang dahulu mereka perselisihkan padanya."},{"n":26,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَهْدِ","menjadi petunjuk","yahdi",80],["لَهُمْ","bagi mereka","lahum",11],["كَمْ","berapa banyak","kam",485],["أَهْلَكْنَا","telah Kami binasakan","ahlaknā",231],["مِن","dari","min",0],["قَبْلِهِم","sebelum mereka","qablihim",51],["مِّنَ","dari","mina",0],["ٱلْقُرُونِ","ummat-ummat","l-qurūni",454],["يَمْشُونَ","mereka berjalan","yamshūna",487],["فِى","dalam","fī",3],["مَسَـٰكِنِهِمْ ۚ","tempat-tempat kediaman mereka","masākinihim",736],["إِنَّ","sesungguhnya","inna",5],["فِى","pada yang","fī",3],["ذَٰلِكَ","demikian itu","dhālika",19],["لَـَٔايَـٰتٍ ۖ","benar-benar tanda-tanda","laāyātin",28],["أَفَلَا","maka apakah tidak","afalā",4],["يَسْمَعُونَ","mereka mendengar","yasmaʿūna",148]],"t":"Dan tidakkah menjadi petunjuk bagi mereka, betapa banyak umat-umat sebelum mereka yang telah Kami binasakan, sedangkan mereka sendiri berjalan di tempat-tempat kediaman mereka. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah). Apakah mereka tidak mendengarkan (memperhatikan)?"},{"n":27,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["أَنَّا","bahwasanya Kami","annā",30],["نَسُوقُ","Kami mencurahkan","nasūqu",1098],["ٱلْمَآءَ","air","l-māa",192],["إِلَى","ke","ilā",13],["ٱلْأَرْضِ","bumi","l-arḍi",22],["ٱلْجُرُزِ","tandus","l-juruzi",2407],["فَنُخْرِجُ","lalu Kami keluarkan","fanukh'riju",114],["بِهِۦ","dengannya","bihi",16],["زَرْعًۭا","tanaman-tanaman","zarʿan",866],["تَأْكُلُ","memakan","takulu",117],["مِنْهُ","dari padanya","min'hu",0],["أَنْعَـٰمُهُمْ","binatang ternak mereka","anʿāmuhum",348],["وَأَنفُسُهُمْ ۖ","dan mereka sendiri","wa-anfusuhum",39],["أَفَلَا","maka apakah tidak","afalā",4],["يُبْصِرُونَ","mereka memperhatikan","yub'ṣirūna",375]],"t":"Dan tidakkah mereka memperhatikan, bahwa Kami mengarahkan (awan yang mengandung) air ke bumi yang tandus, lalu Kami tumbuhkan (dengan air hujan itu) tanam-tanaman sehingga hewan-hewan ternak mereka dan mereka sendiri dapat makan darinya. Maka mengapa mereka tidak memperhatikan?"},{"n":28,"w":[["وَيَقُولُونَ","maka mereka berkata","wayaqūlūna",6],["مَتَىٰ","kapan","matā",912],["هَـٰذَا","ini","hādhā",37],["ٱلْفَتْحُ","kemenangan","l-fatḥu",731],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",199]],"t":"Dan mereka bertanya, \"Kapankah kemenangan itu (datang) jika engkau orang yang benar?\""},{"n":29,"w":[["قُلْ","katakanlah","qul",6],["يَوْمَ","pada hari","yawma",25],["ٱلْفَتْحِ","kemenangan","l-fatḥi",731],["لَا","tidak","lā",4],["يَنفَعُ","berguna","yanfaʿu",363],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوٓا۟","kafir/ingkar","kafarū",40],["إِيمَـٰنُهُمْ","iman mereka","īmānuhum",257],["وَلَا","dan tidaklah","walā",4],["هُمْ","mereka","hum",11],["يُنظَرُونَ","mereka diberi tangguh","yunẓarūna",712]],"t":"Katakanlah, \"Pada hari kemenangan itu, tidak berguna lagi bagi orang-orang kafir keimanan mereka dan mereka tidak diberi penangguhan.\""},{"n":30,"w":[["فَأَعْرِضْ","maka berpalinglah","fa-aʿriḍ",351],["عَنْهُمْ","dari mereka","ʿanhum",21],["وَٱنتَظِرْ","dan tunggulah","wa-intaẓir",1016],["إِنَّهُم","sesungguhnya mereka","innahum",5],["مُّنتَظِرُونَ","orang-orang yang menunggu","muntaẓirūna",1201]],"t":"Maka berpalinglah engkau dari mereka dan tunggulah, sesungguhnya mereka (juga) menunggu."}]