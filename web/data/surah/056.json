hutang","lamugh'ramūna",3816]],"t":"(sambil berkata), \"Sungguh, kami benar-benar menderita kerugian,"},{"n":67,"w":[["بَلْ","bahkan","bal",96],["نَحْنُ","kami","naḥnu",130],["مَحْرُومُونَ","orang yang tidak berusaha","maḥrūmūna",1583]],"t":"bahkan kami tidak mendapat hasil apa pun.\""},{"n":68,"w":[["أَفَرَءَيْتُمُ","maka apakah kamu memperhatikan","afara-aytumu",46],["ٱلْمَآءَ","air","l-māa",192],["ٱلَّذِى","yang","alladhī",7],["تَشْرَبُونَ","kamu minum","tashrabūna",611]],"t":"Pernahkah kamu memperhatikan air yang kamu minum?"},{"n":69,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",87],["أَنزَلْتُمُوهُ","kamu menurunkannya","anzaltumūhu",62],["مِنَ","dari","mina",0],["ٱلْمُزْنِ","mendung/awan","l-muz'ni",3898],["أَمْ","atau","am",84],["نَحْنُ","Kami","naḥnu",130],["ٱلْمُنزِلُونَ","yang menurunkan","l-munzilūna",1376]],"t":"Kamukah yang menurunkannya dari awan ataukah Kami yang menurunkan?"},{"n":70,"w":[["لَوْ","jika","law",57],["نَشَآءُ","Kami menghendaki","nashāu",54],["جَعَلْنَـٰهُ","Kami jadikannya","jaʿalnāhu",33],["أُجَاجًۭا","asin","ujājan",1758],["فَلَوْلَا","maka mengapa tidak","falawlā",156],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",254]],"t":"Sekiranya Kami menghendaki, niscaya Kami menjadikannya asin, mengapa kamu tidak bersyukur?"},{"n":71,"w":[["أَفَرَءَيْتُمُ","maka apakah kamu memperhatikan","afara-aytumu",46],["ٱلنَّارَ","api","l-nāra",78],["ٱلَّتِى","yang","allatī",7],["تُورُونَ","kamu nyalakan","tūrūna",3022]],"t":"Maka pernahkah kamu memperhatikan tentang api yang kamu nyalakan (dengan kayu)?"},{"n":72,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",87],["أَنشَأْتُمْ","kamu menumbuhkan","anshatum",500],["شَجَرَتَهَآ","kayunya","shajaratahā",518],["أَمْ","atau","am",84],["نَحْنُ","Kami","naḥnu",130],["ٱلْمُنشِـُٔونَ","yang menumbuhkannya","l-munshiūna",3828]],"t":"Kamukah yang menumbuhkan kayu itu ataukah Kami yang menumbuhkan?"},{"n":73,"w":[["نَحْنُ","Kami","naḥnu",130],["جَعَلْنَـٰهَا","Kami menjadikannya","jaʿalnāhā",33],["تَذْكِرَةًۭ","peringatan/pengajaran","tadhkiratan",930],["وَمَتَـٰعًۭا","dan kesenangan/bahan yang berguna","wamatāʿan",332],["لِّلْمُقْوِينَ","bagi orang-orang yang musafir","lil'muq'wīna",3845]],"t":"Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir."},{"n":74,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",279],["بِٱسْمِ","dengan nama","bi-is'mi",309],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",100]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar."},{"n":75,"w":[["۞ فَلَآ","maka tidak","falā",4],["أُقْسِمُ","aku bersumpah","uq'simu",501],["بِمَوَٰقِعِ","dengan tempat turun","bimawāqiʿi",3748],["ٱلنُّجُومِ","bintang-bintang","l-nujūmi",694]],"t":"Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang."},{"n":76,"w":[["وَإِنَّهُۥ","sesungguhnya ia","wa-innahu",5],["لَقَسَمٌۭ","sungguh sumpah","laqasamun",2582],["لَّوْ","jika","law",57],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29],["عَظِيمٌ","besar","ʿaẓīmun",100]],"t":"Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,"},{"n":77,"w":[["إِنَّهُۥ","sesungguhnya ia","innahu",5],["لَقُرْءَانٌۭ","sungguh Al Qur'an","laqur'ānun",178],["كَرِيمٌۭ","yang mulia","karīmun",368]],"t":"dan (ini) sesungguhnya Alquran yang sangat mulia,"},{"n":78,"w":[["فِى","pada","fī",3],["كِتَـٰبٍۢ","kitab","kitābin",49],["مَّكْنُونٍۢ","terpelihara baik","maknūnin",1609]],"t":"dalam Kitab yang terpelihara (Lauḥ Maḥfūẓ),"},{"n":79,"w":[["لَّا","tidak","lā",4],["يَمَسُّهُۥٓ","menyentuhnya","yamassuhu",215],["إِلَّا","kecuali","illā",15],["ٱلْمُطَهَّرُونَ","orang-orang yang disucikan","l-muṭaharūna",3795]],"t":"tidak ada yang menyentuhnya selain hamba-hamba yang disucikan."},{"n":80,"w":[["تَنزِيلٌۭ","penurunan/diturunkan","tanzīlun",636],["مِّن","dari","min",0],["رَّبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",163]],"t":"Diturunkan dari Tuhan seluruh alam."},{"n":81,"w":[["أَفَبِهَـٰذَا","maka apakah