ūqīna",2476]],"t":"Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,"},{"n":61,"w":[["عَلَىٰٓ","atas","ʿalā",7],["أَن","bahwa","an",17],["نُّبَدِّلَ","menggantikan","nubaddila",454],["أَمْثَـٰلَكُمْ","yang serupa kamu","amthālakum",129],["وَنُنشِئَكُمْ","dan menciptakan kamu","wanunshi-akum",505],["فِى","pada","fī",3],["مَا","apa","mā",2],["لَا","tidak","lā",4],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29]],"t":"untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui."},{"n":62,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["عَلِمْتُمُ","kamu telah mengetahui","ʿalim'tumu",29],["ٱلنَّشْأَةَ","penciptaan","l-nashata",1966],["ٱلْأُولَىٰ","pertama","l-ūlā",142],["فَلَوْلَا","maka mengapa tidak","falawlā",157],["تَذَكَّرُونَ","kamu ingat/mengambil pelajaran","tadhakkarūna",235]],"t":"Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?"},{"n":63,"w":[["أَفَرَءَيْتُم","maka apakah kamu perhatikan","afara-aytum",46],["مَّا","apa","mā",2],["تَحْرُثُونَ","kamu tanam","taḥruthūna",3181]],"t":"Pernahkah kamu perhatikan benih yang kamu tanam?"},{"n":64,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",88],["تَزْرَعُونَهُۥٓ","kamu menanamnya","tazraʿūnahu",2777],["أَمْ","atau","am",85],["نَحْنُ","Kami","naḥnu",131],["ٱلزَّٰرِعُونَ","penanam(nya)","l-zāriʿūna",2770]],"t":"Kamukah yang menumbuhkannya ataukah Kami yang menumbuhkan?"},{"n":65,"w":[["لَوْ","jika","law",58],["نَشَآءُ","Kami menghendaki","nashāu",54],["لَجَعَلْنَـٰهُ","niscaya Kami jadikan dia","lajaʿalnāhu",33],["حُطَـٰمًۭا","hancur/kering","ḥuṭāman",1807],["فَظَلْتُمْ","maka jadilah kamu","faẓaltum",900],["تَفَكَّهُونَ","kamu meratap/menyesal","tafakkahūna",4345]],"t":"Sekiranya Kami kehendaki, niscaya Kami hancurkan sampai lumat; maka kamu akan heran tercengang,"},{"n":66,"w":[["إِنَّا","sesungguhnya kami","innā",5],["لَمُغْرَمُونَ","sungguh yang menanggu