adalah","kāna",9],["مِنَ","dari","mina",0],["ٱلْمُقَرَّبِينَ","orang yang didekatkan","l-muqarabīna",994]],"t":"Jika dia (orang yang mati) itu termasuk yang didekatkan (kepada Allah),"},{"n":89,"w":[["فَرَوْحٌۭ","maka kesenangan/ketentraman","farawḥun",1986],["وَرَيْحَانٌۭ","dan kepuasan","warayḥānun",2621],["وَجَنَّتُ","dan surga","wajannatu",76],["نَعِيمٍۢ","kenikmatan","naʿīmin",578]],"t":"maka dia memperoleh ketenteraman dan rezeki serta surga (yang penuh) kenikmatan."},{"n":90,"w":[["وَأَمَّآ","dan adapun","wa-ammā",218],["إِن","bahwa","in",14],["كَانَ","adalah","kāna",9],["مِنْ","dari","min",0],["أَصْحَـٰبِ","kaum/golongan","aṣḥābi",142],["ٱلْيَمِينِ","kanan","l-yamīni",184]],"t":"Dan jika dia termasuk golongan kanan,"},{"n":91,"w":[["فَسَلَـٰمٌۭ","maka keselamatan","fasalāmun",278],["لَّكَ","bagimu","laka",137],["مِنْ","dari","min",0],["أَصْحَـٰبِ","kaum/golongan","aṣḥābi",142],["ٱلْيَمِينِ","kanan","l-yamīni",184]],"t":"maka, \"Salam bagimu (wahai) dari golongan kanan!\" (sambut malaikat)."},{"n":92,"w":[["وَأَمَّآ","dan adapun","wa-ammā",218],["إِن","jika","in",14],["كَانَ","dia adalah","kāna",9],["مِنَ","dari","mina",0],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",494],["ٱلضَّآلِّينَ","orang-orang yang sesat","l-ḍālīna",655]],"t":"Namun jika dia termasuk golongan yang mendustakan dan sesat,"},{"n":93,"w":[["فَنُزُلٌۭ","maka hidangan","fanuzulun",998],["مِّنْ","dari","min",0],["حَمِيمٍۢ","air panas mendidih","ḥamīmin",508]],"t":"maka dia disambut siraman air yang mendidih,"},{"n":94,"w":[["وَتَصْلِيَةُ","dan dimasukkan","wataṣliyatu",4362],["جَحِيمٍ","neraka","jaḥīmin",414]],"t":"dan dibakar di dalam neraka."},{"n":95,"w":[["إِنَّ","sesungguhnya ia","inna",5],["هَـٰذَا","ini","hādhā",37],["لَهُوَ","sungguh ia","lahuwa",20],["حَقُّ","hak/benar","ḥaqqu",50],["ٱلْيَقِينِ","keyakinan","l-yaqīni",1021]],"t":"Sungguh, inilah keyakinan yang benar."},{"n":96,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",277],["بِٱسْمِ","dengan nama","bi-i