ka terus-menerus mengerjakan dosa yang besar,"},{"n":47,"w":[["وَكَانُوا۟","dan adalah mereka","wakānū",9],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["أَئِذَا","apakah apabila","a-idhā",23],["مِتْنَا","kami telah mati","mit'nā",307],["وَكُنَّا","dan kami adalah/menjadi","wakunnā",9],["تُرَابًۭا","tanah","turāban",579],["وَعِظَـٰمًا","dan tulang-belulang","waʿiẓāman",100],["أَءِنَّا","apakah sesungguhnya kami","a-innā",5],["لَمَبْعُوثُونَ","sungguh akan dibangkitkan","lamabʿūthūna",915]],"t":"dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?"},{"n":48,"w":[["أَوَءَابَآؤُنَا","nenek moyang kita?","awaābāunā",106],["ٱلْأَوَّلُونَ","terdahulu","l-awalūna",141]],"t":"Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\""},{"n":49,"w":[["قُلْ","katakanlah","qul",6],["إِنَّ","sesungguhnya","inna",5],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",141],["وَٱلْـَٔاخِرِينَ","dan orang-orang yang kemudian","wal-ākhirīna",73]],"t":"Katakanlah, \"(Ya), sesungguhnya orang-orang yang terdahulu dan yang kemudian,"},{"n":50,"w":[["لَمَجْمُوعُونَ","sungguh mereka dikumpulkan","lamajmūʿūna",2523],["إِلَىٰ","atas","ilā",13],["مِيقَـٰتِ","waktu-waktu tertentu","mīqāti",984],["يَوْمٍۢ","hari","yawmin",25],["مَّعْلُومٍۢ","diketahui/ditentukan","maʿlūmin",692]],"t":"pasti semua akan dikumpulkan pada waktu tertentu, pada hari yang sudah dimaklumi."},{"n":51,"w":[["ثُمَّ","kemudian","thumma",34],["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["أَيُّهَا","hai","ayyuhā",74],["ٱلضَّآلُّونَ","orang-orang yang sesat","l-ḍālūna",649],["ٱلْمُكَذِّبُونَ","orang-orang pendusta","l-mukadhibūna",490]],"t":"Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!"},{"n":52,"w":[["لَـَٔاكِلُونَ","pasti memakan","laākilūna",1704],["مِن","dari","min",0],["شَجَرٍۢ","pohon","shajarin",1022],["مِّن","dari","min",0],["زَقُّومٍۢ","zaqqum","zaqqūmin",2070]],"t":"pasti akan memakan pohon zaq