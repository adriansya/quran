atan/pengajaran","tadhkiratan",929],["وَمَتَـٰعًۭا","dan kesenangan/bahan yang berguna","wamatāʿan",331],["لِّلْمُقْوِينَ","bagi orang-orang yang musafir","lil'muq'wīna",3859]],"t":"Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir."},{"n":74,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",277],["بِٱسْمِ","dengan nama","bi-is'mi",306],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",97]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar."},{"n":75,"w":[["۞ فَلَآ","maka tidak","falā",4],["أُقْسِمُ","aku bersumpah","uq'simu",505],["بِمَوَٰقِعِ","dengan tempat turun","bimawāqiʿi",3744],["ٱلنُّجُومِ","bintang-bintang","l-nujūmi",697]],"t":"Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang."},{"n":76,"w":[["وَإِنَّهُۥ","sesungguhnya ia","wa-innahu",5],["لَقَسَمٌۭ","sungguh sumpah","laqasamun",2587],["لَّوْ","jika","law",57],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",29],["عَظِيمٌ","besar","ʿaẓīmun",97]],"t":"Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,"},{"n":77,"w":[["إِنَّهُۥ","sesungguhnya ia","innahu",5],["لَقُرْءَانٌۭ","sungguh Al Qur'an","laqur'ānun",175],["كَرِيمٌۭ","yang mulia","karīmun",364]],"t":"dan (ini) sesungguhnya Alquran yang sangat mulia,"},{"n":78,"w":[["فِى","pada","fī",3],["كِتَـٰبٍۢ","kitab","kitābin",49],["مَّكْنُونٍۢ","terpelihara baik","maknūnin",1605]],"t":"dalam Kitab yang terpelihara (Lauḥ Maḥfūẓ),"},{"n":79,"w":[["لَّا","tidak","lā",4],["يَمَسُّهُۥٓ","menyentuhnya","yamassuhu",216],["إِلَّا","kecuali","illā",15],["ٱلْمُطَهَّرُونَ","orang-orang yang disucikan","l-muṭaharūna",3798]],"t":"tidak ada yang menyentuhnya selain hamba-hamba yang disucikan."},{"n":80,"w":[["تَنزِيلٌۭ","penurunan/diturunkan","tanzīlun",642],["مِّن","dari","min",0],["رَّبِّ","Tuhan/Pemelihara","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",158]],"t":"Diturunkan dari Tuhan seluruh alam."},{"n":81,"w":[["أَفَبِهَـٰذَا","maka apakah d