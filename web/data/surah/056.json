an) sebaya umurnya,"},{"n":38,"w":[["لِّأَصْحَـٰبِ","untuk kaum/golongan","li-aṣḥābi",132],["ٱلْيَمِينِ","kanan","l-yamīni",198]],"t":"untuk golongan kanan,"},{"n":39,"w":[["ثُلَّةٌۭ","rombongan/golongan besar","thullatun",2048],["مِّنَ","dari","mina",1],["ٱلْأَوَّلِينَ","orang-orang pertama/terdahulu","l-awalīna",151]],"t":"segolongan besar dari orang-orang yang terdahulu,"},{"n":40,"w":[["وَثُلَّةٌۭ","rombongan/golongan besar","wathullatun",2048],["مِّنَ","dari","mina",1],["ٱلْـَٔاخِرِينَ","orang-orang kemudian","l-ākhirīna",82]],"t":"dan segolongan besar pula dari orang yang kemudian."},{"n":41,"w":[["وَأَصْحَـٰبُ","dan kaum/golongan","wa-aṣḥābu",132],["ٱلشِّمَالِ","kiri","l-shimāli",824],["مَآ","apa/siapa","mā",6],["أَصْحَـٰبُ","kaum/golongan","aṣḥābu",132],["ٱلشِّمَالِ","kiri","l-shimāli",824]],"t":"Dan golongan kiri, alangkah sengsaranya golongan kiri itu."},{"n":42,"w":[["فِى","pada","fī",7],["سَمُومٍۢ","angin amat panas","samūmin",2020],["وَحَمِيمٍۢ","dan air yang sangat mendidih","waḥamīmin",519]],"t":"(Mereka) dalam siksaan angin yang sangat panas dan air yang mendidih,"},{"n":43,"w":[["وَظِلٍّۢ","dan naungan","waẓillin",671],["مِّن","dari","min",1],["يَحْمُومٍۢ","asap hitam","yaḥmūmin",4572]],"t":"dan naungan asap yang hitam,"},{"n":44,"w":[["لَّا","tidak","lā",8],["بَارِدٍۢ","sejuk","bāridin",2331],["وَلَا","dan tidak","walā",8],["كَرِيمٍ","enak/menyenangkan","karīmin",383]],"t":"tidak sejuk dan tidak menyenangkan."},{"n":45,"w":[["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["كَانُوا۟","adalah mereka","kānū",12],["قَبْلَ","sebelum","qabla",59],["ذَٰلِكَ","demikian/itu","dhālika",26],["مُتْرَفِينَ","dalam kesenangan/kemewahan","mut'rafīna",1396]],"t":"Sesungguhnya mereka sebelum itu (dahulu) hidup bermewah-mewah,"},{"n":46,"w":[["وَكَانُوا۟","dan adalah mereka","wakānū",12],["يُصِرُّونَ","mereka tetap/terus-menerus","yuṣirrūna",1482],["عَلَى","atas","ʿalā",11],["ٱلْحِنثِ","pelanggaran/dosa","l-ḥinthi",3212],["ٱلْعَظِيمِ","yang besar","l-ʿaẓīmi",109]],"t":"dan mereka terus-menerus mengerjakan dosa yang besar,"},{"n":47,"w":[["وَكَانُوا۟","dan adalah mereka","wakānū",12],["يَقُولُونَ","mereka mengatakan","yaqūlūna",10],["أَئِذَا","apakah apabila","a-idhā",29],["مِتْنَا","kami telah mati","mit'nā",322],["وَكُنَّا","dan kami adalah/menjadi","wakunnā",12],["تُرَابًۭا","tanah","turāban",594],["وَعِظَـٰمًا","dan tulang-belulang","waʿiẓāman",109],["أَءِنَّا","apakah sesungguhnya kami","a-innā",9],["لَمَبْعُوثُونَ","sungguh akan dibangkitkan","lamabʿūthūna",933]],"t":"dan mereka berkata, \"Apabila kami sudah mati, menjadi tanah dan tulang-belulang, apakah kami benar-benar akan dibangkitkan kembali?"},{"n":48,"w":[["أَوَءَابَآؤُنَا","nenek moyang kita?","awaābāunā",116],["ٱلْأَوَّلُونَ","terdahulu","l-awalūna",151]],"t":"Apakah nenek moyang kami yang terdahulu (dibangkitkan pula)?\""},{"n":49,"w":[["قُلْ","katakanlah","qul",10],["إِنَّ","sesungguhnya","inna",9],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",151],["وَٱلْـَٔاخِرِينَ","dan orang-orang yang kemudian","wal-ākhirīna",82]],"t":"Katakanlah, \"(Ya), sesungguhnya orang-orang yang terdahulu dan yang kemudian,"},{"n":50,"w":[["لَمَجْمُوعُونَ","sungguh mereka dikumpulkan","lamajmūʿūna",2541],["إِلَىٰ","atas","ilā",18],["مِيقَـٰتِ","waktu-waktu tertentu","mīqāti",1002],["يَوْمٍۢ","hari","yawmin",31],["مَّعْلُومٍۢ","diketahui/ditentukan","maʿlūmin",707]],"t":"pasti semua akan dikumpulkan pada waktu tertentu, pada hari yang sudah dimaklumi."},{"n":51,"w":[["ثُمَّ","kemudian","thumma",41],["إِنَّكُمْ","sesungguhnya kalian","innakum",9],["أَيُّهَا","hai","ayyuhā",83],["ٱلضَّآلُّونَ","orang-orang yang sesat","l-ḍālūna",664],["ٱلْمُكَذِّبُونَ","orang-orang pendusta","l-mukadhibūna",505]],"t":"Kemudian sesungguhnya kamu, wahai orang-orang yang sesat lagi mendustakan!"},{"n":52,"w":[["لَـَٔاكِلُونَ","pasti memakan","laākilūna",1722],["مِن","dari","min",1],["شَجَرٍۢ","pohon","shajarin",1040],["مِّن","dari","min",1],["زَقُّومٍۢ","zaqqum","zaqqūmin",2088]],"t":"pasti akan memakan pohon zaqqum,"},{"n":53,"w":[["فَمَالِـُٔونَ","maka menjadi penuh","famāliūna",2458],["مِنْهَا","dari padanya","min'hā",1],["ٱلْبُطُونَ","perut-perut","l-buṭūna",581]],"t":"Maka akan penuh perutmu dengannya."},{"n":54,"w":[["فَشَـٰرِبُونَ","maka akan meminum","fashāribūna",1281],["عَلَيْهِ","atasnya","ʿalayhi",11],["مِنَ","dari","mina",1],["ٱلْحَمِيمِ","air panas yang mendidih","l-ḥamīmi",519]],"t":"Setelah itu kamu akan memimun air yang sangat panas."},{"n":55,"w":[["فَشَـٰرِبُونَ","maka akan meminum","fashāribūna",1281],["شُرْبَ","minuman","shur'ba",2868],["ٱلْهِيمِ","unta","l-hīmi",3538]],"t":"Maka kamu minum seperti unta (yang sangat haus) minum."},{"n":56,"w":[["هَـٰذَا","inilah","hādhā",64],["نُزُلُهُمْ","pemberian/hidangan mereka","nuzuluhum",1012],["يَوْمَ","hari","yawma",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"Itulah hidangan untuk mereka pada hari pembalasan.\""},{"n":57,"w":[["نَحْنُ","Kami","naḥnu",140],["خَلَقْنَـٰكُمْ","Kami menciptakan kamu","khalaqnākum",70],["فَلَوْلَا","maka mengapa tidak","falawlā",167],["تُصَدِّقُونَ","kamu membenarkan","tuṣaddiqūna",838]],"t":"Kami telah menciptakan kamu, mengapa kamu tidak membenarkan (hari berbangkit)?"},{"n":58,"w":[["أَفَرَءَيْتُم","maka apakah kamu perhatikan","afara-aytum",54],["مَّا","apa","mā",6],["تُمْنُونَ","kamu tumpahkan/pancarkan","tum'nūna",1757]],"t":"Maka adakah kamu perhatikan, tentang (benih manusia) yang kamu pancarkan."},{"n":59,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",96],["تَخْلُقُونَهُۥٓ","kamu menciptakannya","takhluqūnahu",70],["أَمْ","atau","am",93],["نَحْنُ","Kami","naḥnu",140],["ٱلْخَـٰلِقُونَ","yang menciptakannya","l-khāliqūna",764]],"t":"Kamukah yang menciptakannya, ataukah Kami penciptanya?"},{"n":60,"w":[["نَحْنُ","Kami","naḥnu",140],["قَدَّرْنَا","Kami telah menentukan","qaddarnā",614],["بَيْنَكُمُ","diantara kamu","baynakumu",55],["ٱلْمَوْتَ","kematian","l-mawta",249],["وَمَا","dan tidaklah","wamā",6],["نَحْنُ","Kami","naḥnu",140],["بِمَسْبُوقِينَ","dengan dikalahkan","bimasbūqīna",2488]],"t":"Kami telah menentukan kematian masing-masing kamu dan Kami tidak lemah,"},{"n":61,"w":[["عَلَىٰٓ","atas","ʿalā",11],["أَن","bahwa","an",22],["نُّبَدِّلَ","menggantikan","nubaddila",464],["أَمْثَـٰلَكُمْ","yang serupa kamu","amthālakum",138],["وَنُنشِئَكُمْ","dan menciptakan kamu","wanunshi-akum",515],["فِى","pada","fī",7],["مَا","apa","mā",6],["لَا","tidak","lā",8],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",35]],"t":"untuk menggantikan kamu dengan orang-orang yang seperti kamu (di dunia) dan membangkitkan kamu kelak (di akhirat) dalam keadaan yang tidak kamu ketahui."},{"n":62,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["عَلِمْتُمُ","kamu telah mengetahui","ʿalim'tumu",35],["ٱلنَّشْأَةَ","penciptaan","l-nashata",1978],["ٱلْأُولَىٰ","pertama","l-ūlā",151],["فَلَوْلَا","maka mengapa tidak","falawlā",167],["تَذَكَّرُونَ","kamu ingat/mengambil pelajaran","tadhakkarūna",245]],"t":"Dan sungguh, kamu telah tahu penciptaan yang pertama, mengapa kamu tidak mengambil pelajaran?"},{"n":63,"w":[["أَفَرَءَيْتُم","maka apakah kamu perhatikan","afara-aytum",54],["مَّا","apa","mā",6],["تَحْرُثُونَ","kamu tanam","taḥruthūna",3193]],"t":"Pernahkah kamu perhatikan benih yang kamu tanam?"},{"n":64,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",96],["تَزْرَعُونَهُۥٓ","kamu menanamnya","tazraʿūnahu",2789],["أَمْ","atau","am",93],["نَحْنُ","Kami","naḥnu",140],["ٱلزَّٰرِعُونَ","penanam(nya)","l-zāriʿūna",2782]],"t":"Kamukah yang menumbuhkannya ataukah Kami yang menumbuhkan?"},{"n":65,"w":[["لَوْ","jika","law",66],["نَشَآءُ","Kami menghendaki","nashāu",62],["لَجَعَلْنَـٰهُ","niscaya Kami jadikan dia","lajaʿalnāhu",40],["حُطَـٰمًۭا","hancur/kering","ḥuṭāman",1819],["فَظَلْتُمْ","maka jadilah kamu","faẓaltum",912],["تَفَكَّهُونَ","kamu meratap/menyesal","tafakkahūna",4357]],"t":"Sekiranya Kami kehendaki, niscaya Kami hancurkan sampai lumat; maka kamu akan heran tercengang,"},{"n":66,"w":[["إِنَّا","sesungguhnya kami","innā",9],["لَمُغْرَمُونَ","sungguh yang menanggung hutang","lamugh'ramūna",3834]],"t":"(sambil berkata), \"Sungguh, kami benar-benar menderita kerugian,"},{"n":67,"w":[["بَلْ","bahkan","bal",105],["نَحْنُ","kami","naḥnu",140],["مَحْرُومُونَ","orang yang tidak berusaha","maḥrūmūna",1601]],"t":"bahkan kami tidak mendapat hasil apa pun.\""},{"n":68,"w":[["أَفَرَءَيْتُمُ","maka apakah kamu memperhatikan","afara-aytumu",54],["ٱلْمَآءَ","air","l-māa",204],["ٱلَّذِى","yang","alladhī",45],["تَشْرَبُونَ","kamu minum","tashrabūna",626]],"t":"Pernahkah kamu memperhatikan air yang kamu minum?"},{"n":69,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",96],["أَنزَلْتُمُوهُ","kamu menurunkannya","anzaltumūhu",71],["مِنَ","dari","mina",1],["ٱلْمُزْنِ","mendung/awan","l-muz'ni",3916],["أَمْ","atau","am",93],["نَحْنُ","Kami","naḥnu",140],["ٱلْمُنزِلُونَ","yang menurunkan","l-munzilūna",1394]],"t":"Kamukah yang menurunkannya dari awan ataukah Kami yang menurunkan?"},{"n":70,"w":[["لَوْ","jika","law",66],["نَشَآءُ","Kami menghendaki","nashāu",62],["جَعَلْنَـٰهُ","Kami jadikannya","jaʿalnāhu",40],["أُجَاجًۭا","asin","ujājan",1776],["فَلَوْلَا","maka mengapa tidak","falawlā",167],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",267]],"t":"Sekiranya Kami menghendaki, niscaya Kami menjadikannya asin, mengapa kamu tidak bersyukur?"},{"n":71,"w":[["أَفَرَءَيْتُمُ","maka apakah kamu memperhatikan","afara-aytumu",54],["ٱلنَّارَ","api","l-nāra",87],["ٱلَّتِى","yang","allatī",195],["تُورُونَ","kamu nyalakan","tūrūna",3040]],"t":"Maka pernahkah kamu memperhatikan tentang api yang kamu nyalakan (dengan kayu)?"},{"n":72,"w":[["ءَأَنتُمْ","apakah kamu","a-antum",96],["أَنشَأْتُمْ","kamu menumbuhkan","anshatum",515],["شَجَرَتَهَآ","kayunya","shajaratahā",533],["أَمْ","atau","am",93],["نَحْنُ","Kami","naḥnu",140],["ٱلْمُنشِـُٔونَ","yang menumbuhkannya","l-munshiūna",3846]],"t":"Kamukah yang menumbuhkan kayu itu ataukah Kami yang menumbuhkan?"},{"n":73,"w":[["نَحْنُ","Kami","naḥnu",140],["جَعَلْنَـٰهَا","Kami menjadikannya","jaʿalnāhā",40],["تَذْكِرَةًۭ","peringatan/pengajaran","tadhkiratan",948],["وَمَتَـٰعًۭا","dan kesenangan/bahan yang berguna","wamatāʿan",347],["لِّلْمُقْوِينَ","bagi orang-orang yang musafir","lil'muq'wīna",3863]],"t":"Kami menjadikannya (api itu) untuk peringatan dan bahan yang berguna bagi musafir."},{"n":74,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",293],["بِٱسْمِ","dengan nama","bi-is'mi",324],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",109]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar."},{"n":75,"w":[["۞ فَلَآ","maka tidak","falā",8],["أُقْسِمُ","aku bersumpah","uq'simu",516],["بِمَوَٰقِعِ","dengan tempat turun","bimawāqiʿi",3766],["ٱلنُّجُومِ","bintang-bintang","l-nujūmi",709]],"t":"Lalu Aku bersumpah dengan tempat beredarnya bintang-bintang."},{"n":76,"w":[["وَإِنَّهُۥ","sesungguhnya ia","wa-innahu",9],["لَقَسَمٌۭ","sungguh sumpah","laqasamun",2600],["لَّوْ","jika","law",66],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",35],["عَظِيمٌ","besar","ʿaẓīmun",109]],"t":"Dan sesungguhnya itu benar-benar sumpah yang besar sekiranya kamu mengetahui,"},{"n":77,"w":[["إِنَّهُۥ","sesungguhnya ia","innahu",9],["لَقُرْءَانٌۭ","sungguh Al Qur'an","laqur'ānun",189],["كَرِيمٌۭ","yang mulia","karīmun",383]],"t":"dan (ini) sesungguhnya Alquran yang sangat mulia,"},{"n":78,"w":[["فِى","pada","fī",7],["كِتَـٰبٍۢ","kitab","kitābin",57],["مَّكْنُونٍۢ","terpelihara baik","maknūnin",1627]],"t":"dalam Kitab yang terpelihara (Lauḥ Maḥfūẓ),"},{"n":79,"w":[["لَّا","tidak","lā",8],["يَمَسُّهُۥٓ","menyentuhnya","yamassuhu",227],["إِلَّا","kecuali","illā",20],["ٱلْمُطَهَّرُونَ","orang-orang yang disucikan","l-muṭaharūna",3813]],"t":"tidak ada yang menyentuhnya selain hamba-hamba yang disucikan."},{"n":80,"w":[["تَنزِيلٌۭ","penurunan/diturunkan","tanzīlun",651],["مِّن","dari","min",1],["رَّبِّ","Tuhan/Pemelihara","rabbi",15],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",174]],"t":"Diturunkan dari Tuhan seluruh alam."},{"n":81,"w":[["أَفَبِهَـٰذَا","maka apakah dengan ini","afabihādhā",64],["ٱلْحَدِيثِ","pembicaraan","l-ḥadīthi",402],["أَنتُم","kamu","antum",96],["مُّدْهِنُونَ","berpaling/menganggap remeh","mud'hinūna",3972]],"t":"Apakah kamu menganggap remeh berita ini (Alquran)?"},{"n":82,"w":[["وَتَجْعَلُونَ","dan kamu menjadikan","watajʿalūna",40],["رِزْقَكُمْ","rezki kamu","riz'qakum",231],["أَنَّكُمْ","sesungguhnya kamu","annakum",36],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",72]],"t":"dan kamu menjadikan rezeki yang kamu terima (dari Allah) justru untuk mendustakan(-Nya)."},{"n":83,"w":[["فَلَوْلَآ","mengapa tidak","falawlā",167],["إِذَا","tatkala","idhā",29],["بَلَغَتِ","telah sampai","balaghati",306],["ٱلْحُلْقُومَ","kerongkongan","l-ḥul'qūma",3219]],"t":"Maka kalau begitu mengapa (tidak mencegah) ketika (nyawa) telah sampai di kerongkongan,"},{"n":84,"w":[["وَأَنتُمْ","dan kalian","wa-antum",96],["حِينَئِذٍۢ","ketika itu","ḥīna-idhin",345],["تَنظُرُونَ","kalian melihat","tanẓurūna",139]],"t":"dan kamu ketika itu melihat,"},{"n":85,"w":[["وَنَحْنُ","dan Kami","wanaḥnu",140],["أَقْرَبُ","lebih dekat","aqrabu",534],["إِلَيْهِ","kepadanya","ilayhi",18],["مِنكُمْ","dari pada kamu","minkum",1],["وَلَـٰكِن","tetapi","walākin",176],["لَّا","tidak","lā",8],["تُبْصِرُونَ","melihat","tub'ṣirūna",390]],"t":"dan Kami lebih dekat kepadanya daripada kamu, tetapi kamu tidak melihat,"},{"n":86,"w":[["فَلَوْلَآ","maka mengapa tidak","falawlā",167],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["غَيْرَ","bukan/tidak","ghayra",85],["مَدِينِينَ","menyerah pada kekuasaan/dikuasai","madīnīna",2469]],"t":"maka mengapa jika kamu memang tidak dikuasai (oleh Allah),"},{"n":87,"w":[["تَرْجِعُونَهَآ","kamu mengembalikan","tarjiʿūnahā",156],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",211]],"t":"kamu tidak mengembalikannya (nyawa itu) jika kamu orang yang benar?"},{"n":88,"w":[["فَأَمَّآ","maka adapun","fa-ammā",229],["إِن","jika","in",19],["كَانَ","adalah","kāna",12],["مِنَ","dari","mina",1],["ٱلْمُقَرَّبِينَ","orang yang didekatkan","l-muqarabīna",1008]],"t":"Jika dia (orang yang mati) itu termasuk yang didekatkan (kepada Allah),"},{"n":89,"w":[["فَرَوْحٌۭ","maka kesenangan/ketentraman","farawḥun",2011],["وَرَيْحَانٌۭ","dan kepuasan","warayḥānun",2641],["وَجَنَّتُ","dan surga","wajannatu",86],["نَعِيمٍۢ","kenikmatan","naʿīmin",589]],"t":"maka dia memperoleh ketenteraman dan rezeki serta surga (yang penuh) kenikmatan."},{"n":90,"w":[["وَأَمَّآ","dan adapun","wa-ammā",229],["إِن","bahwa","in",19],["كَانَ","adalah","kāna",12],["مِنْ","dari","min",1],["أَصْحَـٰبِ","kaum/golongan","aṣḥābi",132],["ٱلْيَمِينِ","kanan","l-yamīni",198]],"t":"Dan jika dia termasuk golongan kanan,"},{"n":91,"w":[["فَسَلَـٰمٌۭ","maka keselamatan","fasalāmun",294],["لَّكَ","bagimu","laka",153],["مِنْ","dari","min",1],["أَصْحَـٰبِ","kaum/golongan","aṣḥābi",132],["ٱلْيَمِينِ","kanan","l-yamīni",198]],"t":"maka, \"Salam bagimu (wahai) dari golongan kanan!\" (sambut malaikat)."},{"n":92,"w":[["وَأَمَّآ","dan adapun","wa-ammā",229],["إِن","jika","in",19],["كَانَ","dia adalah","kāna",12],["مِنَ","dari","mina",1],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",505],["ٱلضَّآلِّينَ","orang-orang yang sesat","l-ḍālīna",664]],"t":"Namun jika dia termasuk golongan yang mendustakan dan sesat,"},{"n":93,"w":[["فَنُزُلٌۭ","maka hidangan","fanuzulun",1012],["مِّنْ","dari","min",1],["حَمِيمٍۢ","air panas mendidih","ḥamīmin",519]],"t":"maka dia disambut siraman air yang mendidih,"},{"n":94,"w":[["وَتَصْلِيَةُ","dan dimasukkan","wataṣliyatu",4336],["جَحِيمٍ","neraka","jaḥīmin",426]],"t":"dan dibakar di dalam neraka."},{"n":95,"w":[["إِنَّ","sesungguhnya ia","inna",9],["هَـٰذَا","ini","hādhā",64],["لَهُوَ","sungguh ia","lahuwa",25],["حَقُّ","hak/benar","ḥaqqu",58],["ٱلْيَقِينِ","keyakinan","l-yaqīni",1030]],"t":"Sungguh, inilah keyakinan yang benar."},{"n":96,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",293],["بِٱسْمِ","dengan nama","bi-is'mi",324],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلْعَظِيمِ","Maha Besar/Maha Agung","l-ʿaẓīmi",109]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahabesar."}]