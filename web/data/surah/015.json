[{"n":1,"w":[["الٓر ۚ","Alif Laam Raa","alif-lam-ra",1304],["تِلْكَ","itu","til'ka",19],["ءَايَـٰتُ","ayat-ayat","āyātu",28],["ٱلْكِتَـٰبِ","Al Kitab","l-kitābi",49],["وَقُرْءَانٍۢ","dan Al Qur'an","waqur'ānin",178],["مُّبِينٍۢ","yang nyata","mubīnin",102]],"t":"Alif Lām Rā`. (Surah) ini adalah (sebagian dari) ayat-ayat Kitab (yang sempurna) yaitu (ayat-ayat) Alquran yang memberi penjelasan."},{"n":2,"w":[["رُّبَمَا","kadang-kadang","rubamā",4211],["يَوَدُّ","menginginkan","yawaddu",582],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَوْ","seandainya","law",57],["كَانُوا۟","adalah mereka","kānū",9],["مُسْلِمِينَ","orang-orang muslim","mus'limīna",278]],"t":"Orang kafir itu kadang-kadang (nanti di akhirat) menginginkan, sekiranya mereka dahulu (di dunia) menjadi orang muslim."},{"n":3,"w":[["ذَرْهُمْ","biarkanlah mereka","dharhum",262],["يَأْكُلُوا۟","mereka makan","yakulū",117],["وَيَتَمَتَّعُوا۟","dan mereka bersenang-senang","wayatamattaʿū",801],["وَيُلْهِهِمُ","dan melalaikan mereka","wayul'hihimu",1476],["ٱلْأَمَلُ ۖ","angan-angan","l-amalu",2157],["فَسَوْفَ","maka kelak","fasawfa",281],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Biarkanlah mereka (di dunia ini) makan dan bersenang-senang dan dilalaikan oleh angan-angan (kosong) mereka, kelak mereka akan mengetahui (akibat perbuatannya)."},{"n":4,"w":[["وَمَآ","dan tidak","wamā",2],["أَهْلَكْنَا","Kami binasakan","ahlaknā",231],["مِن","dari","min",0],["قَرْيَةٍ","suatu negeri","qaryatin",210],["إِلَّا","melainkan","illā",15],["وَلَهَا","baginya","walahā",97],["كِتَابٌۭ","kitab/ketentuan","kitābun",49],["مَّعْلُومٌۭ","ditetapkan","maʿlūmun",692]],"t":"Dan Kami tidak membinasakan suatu negeri, melainkan sudah ada ketentuan yang di tetapkan baginya."},{"n":5,"w":[["مَّا","tidak","mā",2],["تَسْبِقُ","mendahului","tasbiqu",516],["مِنْ","dari","min",0],["أُمَّةٍ","suatu ummat","ummatin",190],["أَجَلَهَا","ajalnya","ajalahā",226],["وَمَا","dan tidak","wamā",2],["يَسْتَـْٔخِرُونَ","mengundurkan","yastakhirūna",1253]],"t":"Tidak ada suatu umat pun yang dapat mendahului ajalnya, dan tidak (pula) dapat meminta penundaan(nya)."},{"n":6,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["يَـٰٓأَيُّهَا","hai","yāayyuhā",74],["ٱلَّذِى","orang yang","alladhī",7],["نُزِّلَ","diturunkan","nuzzila",195],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",8],["ٱلذِّكْرُ","peringatan (Al Qur'an)","l-dhik'ru",152],["إِنَّكَ","sesungguhnya kamu","innaka",5],["لَمَجْنُونٌۭ","sungguh orang gila","lamajnūnun",786]],"t":"Dan mereka berkata, \"Wahai orang yang kepadanya diturunkan Alquran, sesungguhnya engkau (Muhammad) benar-benar orang yang gila."},{"n":7,"w":[["لَّوْ","mengapa","law",57],["مَا","tidak","mā",2],["تَأْتِينَا","kamu datangkan kepada kami","tatīnā",48],["بِٱلْمَلَـٰٓئِكَةِ","dengan malaikat","bil-malāikati",127],["إِن","jika","in",14],["كُنتَ","kamu adalah","kunta",9],["مِنَ","dari","mina",0],["ٱلصَّـٰدِقِينَ","orang-orang yang benar","l-ṣādiqīna",199]],"t":"Mengapa engkau tidak mendatangkan malaikat kepada kami, jika engkau termasuk orang yang benar?\""},{"n":8,"w":[["مَا","tidak","mā",2],["نُنَزِّلُ","Kami turunkan","nunazzilu",195],["ٱلْمَلَـٰٓئِكَةَ","malaikat","l-malāikata",127],["إِلَّا","melainkan","illā",15],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["وَمَا","dan tidak","wamā",2],["كَانُوٓا۟","adalah mereka","kānū",9],["إِذًۭا","tiba-tiba/ketika itu","idhan",360],["مُّنظَرِينَ","orang-orang yang diberi tangguh","munẓarīna",1200]],"t":"Kami tidak menurunkan malaikat melainkan dengan kebenaran (untuk membawa azab) dan mereka ketika itu tidak diberi penangguhan."},{"n":9,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["نَحْنُ","Kami","naḥnu",130],["نَزَّلْنَا","Kami menurunkan","nazzalnā",195],["ٱلذِّكْرَ","peringatan","l-dhik'ra",152],["وَإِنَّا","dan sesungguhnya Kami","wa-innā",5],["لَهُۥ","baginya/kepadanya","lahu",16],["لَحَـٰفِظُونَ","penjaga/pemelihara","laḥāfiẓūna",616]],"t":"Sesungguhnya Kamilah yang menurunkan Alquran, dan pasti Kami (pula) yang memeliharanya."},{"n":10,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",91],["مِن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["فِى","didalam/pada","fī",3],["شِيَعِ","bangsa/umat-umat","shiyaʿi",755],["ٱلْأَوَّلِينَ","orang-orang yang terdahulu","l-awalīna",141]],"t":"Dan sungguh, Kami telah mengutus (beberapa rasul) sebelum engkau (Muhammad) kepada umat-umat terdahulu."},{"n":11,"w":[["وَمَا","dan tidak","wamā",2],["يَأْتِيهِم","datang kepada mereka","yatīhim",48],["مِّن","dari","min",0],["رَّسُولٍ","seorang Rasul","rasūlin",35],["إِلَّا","melainkan","illā",15],["كَانُوا۟","adalah mereka","kānū",9],["بِهِۦ","dengannya/kepadanya","bihi",16],["يَسْتَهْزِءُونَ","mereka memperolok-olok","yastahziūna",495]],"t":"Dan setiap kali seorang rasul datang kepada mereka, mereka selalu memperolok-olokannya."},{"n":12,"w":[["كَذَٰلِكَ","demikianlah","kadhālika",19],["نَسْلُكُهُۥ","Kami memasukkannya","naslukuhu",744],["فِى","kedalam","fī",3],["قُلُوبِ","hati","qulūbi",89],["ٱلْمُجْرِمِينَ","orang-orang yang berdosa","l-muj'rimīna",228]],"t":"Demikianlah, Kami memasukkannya (olok-olok itu) ke dalam hati orang yang berdosa,"},{"n":13,"w":[["لَا","tidak","lā",4],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18],["بِهِۦ ۖ","dengannya/kepadanya","bihi",16],["وَقَدْ","dan sesungguhnya","waqad",24],["خَلَتْ","telah berlalu","khalat",430],["سُنَّةُ","ketentuan","sunnatu",604],["ٱلْأَوَّلِينَ","orang-orang dahulu","l-awalīna",141]],"t":"mereka tidak beriman kepadanya (Alquran) padahal telah berlalu sunnatullah terhadap orang-orang terdahulu."},{"n":14,"w":[["وَلَوْ","dan seandainya","walaw",57],["فَتَحْنَا","Kami bukakan","fataḥnā",592],["عَلَيْهِم","atas mereka","ʿalayhim",8],["بَابًۭا","pintu-pintu","bāban",399],["مِّنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["فَظَلُّوا۟","maka mereka terus","faẓallū",894],["فِيهِ","kedalamnya","fīhi",3],["يَعْرُجُونَ","mereka naik","yaʿrujūna",1291]],"t":"Dan kalau Kami bukakan kepada mereka salah satu pintu langit, lalu mereka terus menerus naik ke atasnya,"},{"n":15,"w":[["لَقَالُوٓا۟","tentu mereka berkata","laqālū",6],["إِنَّمَا","sesungguhnya","innamā",5],["سُكِّرَتْ","dikaburkan","sukkirat",4251],["أَبْصَـٰرُنَا","penglihatan kami","abṣārunā",248],["بَلْ","bahkan","bal",96],["نَحْنُ","kami","naḥnu",130],["قَوْمٌۭ","kaum","qawmun",27],["مَّسْحُورُونَ","orang-orang yang tersihir","masḥūrūna",1610]],"t":"tentulah mereka berkata, \"Sesungguhnya pandangan kamilah yang dikaburkan, bahkan kami adalah orang yang terkena sihir.\""},{"n":16,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["جَعَلْنَا","Kami telah menjadikan","jaʿalnā",33],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["بُرُوجًۭا","gugusan bintang","burūjan",1542],["وَزَيَّنَّـٰهَا","dan Kami menghiasinya","wazayyannāhā",417],["لِلنَّـٰظِرِينَ","bagi orang-orang yang memandang","lilnnāẓirīna",1387]],"t":"Dan sungguh, Kami telah menciptakan gugusan bintang di langit dan menjadikannya terasa indah bagi orang yang memandang(nya),"},{"n":17,"w":[["وَحَفِظْنَـٰهَا","dan Kami menjaganya","waḥafiẓ'nāhā",1051],["مِن","dari","min",0],["كُلِّ","tiap-tiap","kulli",31],["شَيْطَـٰنٍۢ","syaitan","shayṭānin",124],["رَّجِيمٍ","yang terkutuk","rajīmin",1220]],"t":"dan Kami menjaganya dari setiap (gangguan) setan yang terkutuk,"},{"n":18,"w":[["إِلَّا","melainkan","illā",15],["مَنِ","orang/siapa","mani",12],["ٱسْتَرَقَ","mencuri","is'taraqa",4658],["ٱلسَّمْعَ","pendengaran","l-samʿa",473],["فَأَتْبَعَهُۥ","lalu mengikuti/mengejarnya","fa-atbaʿahu",614],["شِهَابٌۭ","nyala api","shihābun",1457],["مُّبِينٌۭ","yang nyata","mubīnun",102]],"t":"kecuali (setan) yang mencuri-curi (berita) yang dapat didengar (dari malaikat) lalu dikejar oleh semburan api yang terang."},{"n":19,"w":[["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["مَدَدْنَـٰهَا","Kami bentangkannya","madadnāhā",688],["وَأَلْقَيْنَا","dan Kami letakkan","wa-alqaynā",172],["فِيهَا","didalamnya/padanya","fīhā",3],["رَوَٰسِىَ","gunung-gunung","rawāsiya",854],["وَأَنۢبَتْنَا","dan Kami tumbuhkan","wa-anbatnā",586],["فِيهَا","didalamnya/padanya","fīhā",3],["مِن","dari","min",0],["كُلِّ","tiap-tiap/segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["مَّوْزُونٍۢ","menurut ukuran","mawzūnin",3937]],"t":"Dan Kami telah menghamparkan bumi dan Kami pancangkan padanya gunung-gunung serta Kami tumbuhkan di sana segala sesuatu menurut ukuran."},{"n":20,"w":[["وَجَعَلْنَا","dan Kami telah menjadikan","wajaʿalnā",33],["لَكُمْ","bagi kalian","lakum",26],["فِيهَا","didalamnya/padanya","fīhā",3],["مَعَـٰيِشَ","keperluan hidup","maʿāyisha",1360],["وَمَن","dan orang (makhluk)","waman",12],["لَّسْتُمْ","bukan kamu","lastum",123],["لَهُۥ","baginya/kepadanya","lahu",16],["بِرَٰزِقِينَ","dengan pemberian rezki","birāziqīna",1223]],"t":"Dan Kami telah menjadikan padanya sumber-sumber kehidupan untuk keperluanmu, dan (Kami ciptakan pula) makhluk-makhluk yang bukan kamu pemberi rezekinya."},{"n":21,"w":[["وَإِن","dan tidak","wa-in",14],["مِّن","dari","min",0],["شَىْءٍ","sesuatu","shayin",41],["إِلَّا","melainkan","illā",15],["عِندَنَا","disisi Kami","ʿindanā",59],["خَزَآئِنُهُۥ","perbendaharaannya","khazāinuhu",1010],["وَمَا","dan tidak","wamā",2],["نُنَزِّلُهُۥٓ","Kami turunkannya","nunazziluhu",195],["إِلَّا","melainkan","illā",15],["بِقَدَرٍۢ","dengan ukuran","biqadarin",795],["مَّعْلُومٍۢ","tertentu","maʿlūmin",692]],"t":"Dan tidak ada sesuatu pun, melainkan pada sisi Kamilah khazanahnya; Kami tidak menurunkannya melainkan dengan ukuran tertentu."},{"n":22,"w":[["وَأَرْسَلْنَا","dan Kami telah utus/meniup","wa-arsalnā",91],["ٱلرِّيَـٰحَ","angin","l-riyāḥa",382],["لَوَٰقِحَ","untuk mengawinkan","lawāqiḥa",3614],["فَأَنزَلْنَا","lalu Kami turunkan","fa-anzalnā",62],["مِنَ","dari","mina",0],["ٱلسَّمَآءِ","langit","l-samāi",38],["مَآءًۭ","air","māan",192],["فَأَسْقَيْنَـٰكُمُوهُ","lalu Kami beri minum kamu dengannya","fa-asqaynākumūhu",954],["وَمَآ","dan tidak","wamā",2],["أَنتُمْ","kamu","antum",87],["لَهُۥ","baginya","lahu",16],["بِخَـٰزِنِينَ","dengan perbendaharaan/penyimpan","bikhāzinīna",1426]],"t":"Dan Kami telah meniupkan angin untuk mengawinkan dan Kami turunkan hujan dari langit, lalu Kami beri minum kamu dengan (air) itu, dan bukanlah kamu yang menyimpannya."},{"n":23,"w":[["وَإِنَّا","dan sesungguhnya Kami","wa-innā",5],["لَنَحْنُ","sungguh Kami","lanaḥnu",130],["نُحْىِۦ","Kami menghidupkan","nuḥ'yī",230],["وَنُمِيتُ","dan Kami mematikan","wanumītu",481],["وَنَحْنُ","dan Kami","wanaḥnu",130],["ٱلْوَٰرِثُونَ","yang mewarisi","l-wārithūna",1108]],"t":"Dan sungguh, Kamilah yang menghidupkan dan mematikan dan Kami (pulalah) yang mewarisi."},{"n":24,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["عَلِمْنَا","Kami mengetahui","ʿalim'nā",29],["ٱلْمُسْتَقْدِمِينَ","orang-orang terdahulu","l-mus'taqdimīna",3862],["مِنكُمْ","diantara kamu","minkum",0],["وَلَقَدْ","dan sesungguhnya","walaqad",24],["عَلِمْنَا","Kami mengetahui","ʿalim'nā",29],["ٱلْمُسْتَـْٔخِرِينَ","orang-orang kemudian","l-mus'takhirīna",3857]],"t":"Dan sungguh, Kami mengetahui orang yang terdahulu sebelum kamu dan Kami mengetahui pula orang yang terkemudian."},{"n":25,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["يَحْشُرُهُمْ ۚ","akan mengumpulkan mereka","yaḥshuruhum",315],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["حَكِيمٌ","Maha Bijaksana","ḥakīmun",115],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",68]],"t":"Dan sesungguhnya Tuhanmu, Dialah yang akan mengumpulkan mereka. Sungguh, Dia Mahabijaksana, Maha Mengetahui."},{"n":26,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["خَلَقْنَا","Kami telah menciptakan","khalaqnā",61],["ٱلْإِنسَـٰنَ","manusia","l-insāna",170],["مِن","dari","min",0],["صَلْصَـٰلٍۢ","tanah liat yang kering","ṣalṣālin",1525],["مِّنْ","dari","min",0],["حَمَإٍۢ","lumpur hitam","ḥama-in",1790],["مَّسْنُونٍۢ","berbentuk","masnūnin",1938]],"t":"Dan sungguh, Kami telah menciptakan manusia (Adam) dari tanah liat kering dari lumpur hitam yang diberi bentuk."},{"n":27,"w":[["وَٱلْجَآنَّ","dan jin","wal-jāna",1070],["خَلَقْنَـٰهُ","Kami telah menciptakannya","khalaqnāhu",61],["مِن","dari","min",0],["قَبْلُ","sebelum","qablu",51],["مِن","dari","min",0],["نَّارِ","api","nāri",78],["ٱلسَّمُومِ","sangat panas","l-samūmi",2002]],"t":"Dan Kami telah menciptakan jin sebelum (Adam) dari api yang sangat panas."},{"n":28,"w":[["وَإِذْ","dan tatkala","wa-idh",53],["قَالَ","berfirman","qāla",6],["رَبُّكَ","Tuhanmu","rabbuka",10],["لِلْمَلَـٰٓئِكَةِ","kepada para malaikat","lil'malāikati",127],["إِنِّى","sesungguhnya Aku","innī",5],["خَـٰلِقٌۢ","yang menciptakan","khāliqun",749],["بَشَرًۭا","manusia","basharan",318],["مِّن","dari","min",0],["صَلْصَـٰلٍۢ","tanah liat yang kering","ṣalṣālin",1525],["مِّنْ","dari","min",0],["حَمَإٍۢ","lumpur hitam","ḥama-in",1790],["مَّسْنُونٍۢ","yang berbentuk","masnūnin",1938]],"t":"Dan (ingatlah), ketika Tuhanmu berfirman kepada para malaikat, \"Sungguh, Aku akan menciptakan seorang manusia dari tanah liat kering dari lumpur hitam yang diberi bentuk."},{"n":29,"w":[["فَإِذَا","maka tatkala","fa-idhā",23],["سَوَّيْتُهُۥ","Aku telah menyempurnakan","sawwaytuhu",669],["وَنَفَخْتُ","dan Aku tiupkan","wanafakhtu",530],["فِيهِ","kedalamnya","fīhi",3],["مِن","dari","min",0],["رُّوحِى","ruh-Ku","rūḥī",492],["فَقَعُوا۟","maka tunduklah kamu","faqaʿū",747],["لَهُۥ","kepadanya","lahu",16],["سَـٰجِدِينَ","orang-orang yang bersujud","sājidīna",455]],"t":"Maka apabila Aku telah menyempurnakan (kejadian)nya, dan Aku telah meniupkan roh (ciptaan)-Ku ke dalamnya, maka tunduklah kamu kepadanya dengan bersujud."},{"n":30,"w":[["فَسَجَدَ","maka sujudlah","fasajada",335],["ٱلْمَلَـٰٓئِكَةُ","para malaikat","l-malāikatu",127],["كُلُّهُمْ","semuanya","kulluhum",31],["أَجْمَعُونَ","seluruhnya","ajmaʿūna",409]],"t":"Maka bersujudlah para malaikat itu semuanya bersama-sama,"},{"n":31,"w":[["إِلَّآ","kecuali","illā",15],["إِبْلِيسَ","iblis","ib'līsa",758],["أَبَىٰٓ","ia enggan","abā",674],["أَن","bahwa","an",17],["يَكُونَ","mereka adalah","yakūna",9],["مَعَ","bersama-sama","maʿa",69],["ٱلسَّـٰجِدِينَ","orang-orang yang bersujud","l-sājidīna",455]],"t":"kecuali Iblis. Ia enggan ikut bersama-sama para (malaikat) yang sujud itu."},{"n":32,"w":[["قَالَ","(Allah) berfirman","qāla",6],["يَـٰٓإِبْلِيسُ","hai iblis","yāib'līsu",758],["مَا","apa","mā",2],["لَكَ","sebab kamu","laka",143],["أَلَّا","bahwa tidak","allā",17],["تَكُونَ","adalah kamu","takūna",9],["مَعَ","bersama-sama","maʿa",69],["ٱلسَّـٰجِدِينَ","orang-orang yang bersujud","l-sājidīna",455]],"t":"Dia (Allah) berfirman, \"Wahai Iblis! Apa sebabnya kamu (tidak ikut) sujud bersama mereka?\""},{"n":33,"w":[["قَالَ","(iblis) berkata","qāla",6],["لَمْ","tidak ada","lam",32],["أَكُن","aku adalah","akun",9],["لِّأَسْجُدَ","untuk bersujud","li-asjuda",335],["لِبَشَرٍ","kepada manusia","libasharin",318],["خَلَقْتَهُۥ","Engkau telah menciptakannya","khalaqtahu",61],["مِن","dari","min",0],["صَلْصَـٰلٍۢ","tanah liat yang kering","ṣalṣālin",1525],["مِّنْ","dari","min",0],["حَمَإٍۢ","lumpur hitam","ḥama-in",1790],["مَّسْنُونٍۢ","yang berbentuk","masnūnin",1938]],"t":"Ia (Iblis) berkata, \"Aku sekali-kali tidak akan sujud kepada manusia yang Engkau telah menciptakannya dari tanah liat kering dari lumpur hitam yang diberi bentuk.\""},{"n":34,"w":[["قَالَ","(Allah) berfirman","qāla",6],["فَٱخْرُجْ","maka keluarlah kamu","fa-ukh'ruj",225],["مِنْهَا","daripadanya/surga","min'hā",0],["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["رَجِيمٌۭ","terkutuk","rajīmun",1220]],"t":"Dia (Allah) berfirman, \"(Kalau begitu) keluarlah dari surga, karena sesungguhnya kamu terkutuk,"},{"n":35,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["عَلَيْكَ","atasmu","ʿalayka",8],["ٱللَّعْنَةَ","kutukan","l-laʿnata",662],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلدِّينِ","pembalasan/kiamat","l-dīni",120]],"t":"dan sesungguhnya kutukan itu tetap menimpamu sampai hari Kiamat.\""},{"n":36,"w":[["قَالَ","(iblis) berkata","qāla",6],["رَبِّ","ya Tuhanku","rabbi",10],["فَأَنظِرْنِىٓ","maka beri tangguhlah aku","fa-anẓir'nī",712],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["يُبْعَثُونَ","mereka dibangkitkan","yub'ʿathūna",227]],"t":"Ia (Iblis) berkata, \"Ya Tuhanku, (kalau begitu) maka berilah penangguhan kepadaku sampai hari (manusia) dibangkitkan.\""},{"n":37,"w":[["قَالَ","(Allah) berfirman","qāla",6],["فَإِنَّكَ","maka sesungguhnya kamu","fa-innaka",5],["مِنَ","dari/termasuk","mina",0],["ٱلْمُنظَرِينَ","orang-orang yang diberi tangguh","l-munẓarīna",1200]],"t":"Allah berfirman, \"(Baiklah) maka sesungguhnya kamu termasuk yang diberi penangguhan,"},{"n":38,"w":[["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْوَقْتِ","waktu","l-waqti",2040],["ٱلْمَعْلُومِ","ditentukan","l-maʿlūmi",692]],"t":"sampai hari yang telah ditentukan (Kiamat).\""},{"n":39,"w":[["قَالَ","(iblis) berkata","qāla",6],["رَبِّ","ya Tuhanku","rabbi",10],["بِمَآ","dengan apa/sebab","bimā",2],["أَغْوَيْتَنِى","Engkau telah sesatkan aku","aghwaytanī",952],["لَأُزَيِّنَنَّ","sungguh aku akan menghiasi","la-uzayyinanna",417],["لَهُمْ","kepada mereka","lahum",11],["فِى","di","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَأُغْوِيَنَّهُمْ","dan sungguh aku akan menyesatkan mereka","wala-ugh'wiyannahum",952],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"Ia (Iblis) berkata, \"Tuhanku, oleh karena Engkau telah memutuskan bahwa aku sesat, aku pasti akan jadikan (kejahatan) tampak indah bagi mereka di bumi, dan aku akan menyesatkan mereka semuanya,"},{"n":40,"w":[["إِلَّا","kecuali","illā",15],["عِبَادَكَ","hamba-hambamu","ʿibādaka",90],["مِنْهُمُ","diantara mereka","min'humu",0],["ٱلْمُخْلَصِينَ","orang-orang yang ikhlas","l-mukh'laṣīna",914]],"t":"kecuali hamba-hamba-Mu yang terpilih di antara mereka.\""},{"n":41,"w":[["قَالَ","(Allah) berfirman","qāla",6],["هَـٰذَا","ini","hādhā",37],["صِرَٰطٌ","jalan","ṣirāṭun",260],["عَلَىَّ","atasKu/kepadaKu","ʿalayya",8],["مُسْتَقِيمٌ","yang lurus","mus'taqīmun",321]],"t":"Dia (Allah) berfirman, \"Ini adalah jalan yang lurus (menuju) kepada-Ku.\""},{"n":42,"w":[["إِنَّ","sesungguhnya","inna",5],["عِبَادِى","hamba-hambaKu","ʿibādī",90],["لَيْسَ","tidak","laysa",123],["لَكَ","bagimu","laka",143],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["سُلْطَـٰنٌ","kekuasaan","sul'ṭānun",323],["إِلَّا","kecuali","illā",15],["مَنِ","orang","mani",12],["ٱتَّبَعَكَ","mengikuti kamu","ittabaʿaka",86],["مِنَ","dari","mina",0],["ٱلْغَاوِينَ","orang-orang yang sesat","l-ghāwīna",1180]],"t":"Sesungguhnya kamu (Iblis) tidak kuasa atas hamba-hamba-Ku, kecuali mereka yang mengikutimu, yaitu orang yang sesat."},{"n":43,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["جَهَنَّمَ","jahanam","jahannama",151],["لَمَوْعِدُهُمْ","sungguh dijanjikan kepada mereka","lamawʿiduhum",738],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"Dan sungguh, Jahanam itu benar-benar (tempat) yang telah dijanjikan untuk mereka (pengikut setan) semuanya,"},{"n":44,"w":[["لَهَا","baginya","lahā",97],["سَبْعَةُ","tujuh","sabʿatu",1645],["أَبْوَٰبٍۢ","pintu-pintu","abwābin",399],["لِّكُلِّ","bagi tiap-tiap","likulli",31],["بَابٍۢ","pintu","bābin",399],["مِّنْهُمْ","dari mereka","min'hum",0],["جُزْءٌۭ","golongan","juz'on",1870],["مَّقْسُومٌ","bagian/tertentu","maqsūmun",3921]],"t":"(Jahanam) itu mempunyai tujuh pintu. Setiap pintu (telah ditetapkan) untuk golongan tertentu dari mereka."},{"n":45,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْمُتَّقِينَ","orang-orang yang bertakwa","l-mutaqīna",245],["فِى","didalam","fī",3],["جَنَّـٰتٍۢ","surga","jannātin",77],["وَعُيُونٍ","dan mata air","waʿuyūnin",206]],"t":"Sesungguhnya orang yang bertakwa itu berada dalam surga-surga (taman-taman) dan (di dekat) mata air (yang mengalir)."},{"n":46,"w":[["ٱدْخُلُوهَا","masuklah kedalamnya","ud'khulūhā",154],["بِسَلَـٰمٍ","dengan sejahtera","bisalāmin",280],["ءَامِنِينَ","aman","āminīna",557]],"t":"(Allah berfirman), \"Masuklah ke dalamnya dengan sejahtera dan aman.\""},{"n":47,"w":[["وَنَزَعْنَا","dan Kami cabut/hilangkan","wanazaʿnā",851],["مَا","apa","mā",2],["فِى","didalam","fī",3],["صُدُورِهِم","dada/hati mereka","ṣudūrihim",267],["مِّنْ","dari","min",0],["غِلٍّ","rasa dengki","ghillin",903],["إِخْوَٰنًا","bersaudara","ikh'wānan",142],["عَلَىٰ","diatas","ʿalā",8],["سُرُرٍۢ","dipan","sururin",1227],["مُّتَقَـٰبِلِينَ","mereka berhadap-hadapan","mutaqābilīna",1616]],"t":"Dan Kami lenyapkan segala rasa dendam yang ada dalam hati mereka; mereka merasa bersaudara, duduk berhadap-hadapan di atas dipan-dipan."},{"n":48,"w":[["لَا","tidak","lā",4],["يَمَسُّهُمْ","menimpa mereka","yamassuhum",215],["فِيهَا","didalamnya","fīhā",3],["نَصَبٌۭ","kelelahan","naṣabun",1622],["وَمَا","dan tidak","wamā",2],["هُم","mereka","hum",11],["مِّنْهَا","daripadanya","min'hā",0],["بِمُخْرَجِينَ","dengan dikeluarkan","bimukh'rajīna",1379]],"t":"Mereka tidak merasa lelah di dalamnya dan mereka tidak akan dikeluarkan darinya."},{"n":49,"w":[["۞ نَبِّئْ","beritakanlah","nabbi",256],["عِبَادِىٓ","hamba-hambaKu","ʿibādī",90],["أَنِّىٓ","bahwasanya Aku","annī",30],["أَنَا","Aku","anā",183],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",121],["ٱلرَّحِيمُ","Maha Penyayang","l-raḥīmu",103]],"t":"Kabarkanlah kepada hamba-hamba-Ku, bahwa Akulah Yang Maha Pengampun, Maha Penyayang,"},{"n":50,"w":[["وَأَنَّ","Dan bahwa","wa-anna",30],["عَذَابِى","azabKu","ʿadhābī",36],["هُوَ","ia/adalah","huwa",20],["ٱلْعَذَابُ","azab","l-ʿadhābu",36],["ٱلْأَلِيمُ","sangat pedih","l-alīmu",167]],"t":"dan sesungguhnya azab-Ku adalah azab yang sangat pedih."},{"n":51,"w":[["وَنَبِّئْهُمْ","dan beritakanlah kepada mereka","wanabbi'hum",256],["عَن","tentang","ʿan",21],["ضَيْفِ","tamu","ḍayfi",1282],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",181]],"t":"Dan kabarkanlah (Muhammad) kepada mereka tentang tamu Ibrahim (malaikat)."},{"n":52,"w":[["إِذْ","ketika","idh",53],["دَخَلُوا۟","mereka masuk","dakhalū",154],["عَلَيْهِ","atasnya/ketempatnya","ʿalayhi",8],["فَقَالُوا۟","lalu mereka mengucapkan","faqālū",6],["سَلَـٰمًۭا","salam","salāman",280],["قَالَ","(Ibrahim) berkata","qāla",6],["إِنَّا","sesungguhnya kami","innā",5],["مِنكُمْ","dari kamu/kepadamu","minkum",0],["وَجِلُونَ","khawatir/takut","wajilūna",4468]],"t":"Ketika mereka masuk ke tempatnya, lalu mereka mengucapkan, \"Salām.\" Dia (Ibrahim) berkata, \"kami benar-benar merasa takut kepadamu.\""},{"n":53,"w":[["قَالُوا۟","mereka berkata","qālū",6],["لَا","jangan","lā",4],["تَوْجَلْ","kamu merasa takut","tawjal",2037],["إِنَّا","sesungguhnya kami","innā",5],["نُبَشِّرُكَ","kami memberi kabar gembira kepadamu","nubashiruka",311],["بِغُلَـٰمٍ","dengan seorang anak laki-laki","bighulāmin",686],["عَلِيمٍۢ","berilmu/pandai","ʿalīmin",68]],"t":"(Mereka) berkata, \"Janganlah engkau merasa takut, sesungguhnya kami memberi kabar gembira kepadamu dengan (kelahiran seorang) anak laki-laki (yang akan menjadi) orang yang pandai (Ishak).\""},{"n":54,"w":[["قَالَ","(Ibrahim) berkata","qāla",6],["أَبَشَّرْتُمُونِى","apakah kamu memberi kabar gembira kepadaku","abashartumūnī",311],["عَلَىٰٓ","atas","ʿalā",8],["أَن","bahwa","an",17],["مَّسَّنِىَ","terjadi diriku","massaniya",215],["ٱلْكِبَرُ","besar/tua","l-kibaru",1190],["فَبِمَ","maka dengan apa/bagaimana","fabima",2],["تُبَشِّرُونَ","kamu kabarkan","tubashirūna",311]],"t":"Dia (Ibrahim) berkata, \"Benarkah kamu memberi kabar gembira kepadaku padahal usiaku telah lanjut, lalu (dengan cara) bagaimana kamu memberi (kabar gembira) tersebut?\""},{"n":55,"w":[["قَالُوا۟","(mereka) berkata","qālū",6],["بَشَّرْنَـٰكَ","kami membei kabar gembira kepadamu","basharnāka",311],["بِٱلْحَقِّ","dengan benar","bil-ḥaqi",50],["فَلَا","maka janganlah","falā",4],["تَكُن","adalah kamu","takun",9],["مِّنَ","dari/termasuk","mina",0],["ٱلْقَـٰنِطِينَ","orang-orang yang berputus asa","l-qāniṭīna",4097]],"t":"(Mereka) menjawab, \"Kami menyampaikan kabar gembira kepadamu dengan benar, maka janganlah engkau termasuk orang yang berputus asa!\""},{"n":56,"w":[["قَالَ","(Ibrahim) berkata","qāla",6],["وَمَن","dan siapa/orang","waman",12],["يَقْنَطُ","ia berputus asa","yaqnaṭu",1631],["مِن","dari","min",0],["رَّحْمَةِ","rahmat","raḥmati",105],["رَبِّهِۦٓ","Tuhannya","rabbihi",10],["إِلَّا","kecuali","illā",15],["ٱلضَّآلُّونَ","orang-orang yang sesat","l-ḍālūna",649]],"t":"Dia (Ibrahim) berkata, \"Tidak ada yang berputus asa dari rahmat Tuhannya, kecuali orang yang sesat.\""},{"n":57,"w":[["قَالَ","(Ibrahim) berkata","qāla",6],["فَمَا","maka apakah","famā",2],["خَطْبُكُمْ","keadaan/urusanmu","khaṭbukum",1428],["أَيُّهَا","wahai","ayyuhā",74],["ٱلْمُرْسَلُونَ","para utusan","l-mur'salūna",326]],"t":"Dia (Ibrahim) berkata, \"Apakah perkara pentingmu, wahai para utusan?\""},{"n":58,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّآ","sesungguhnya kami","innā",5],["أُرْسِلْنَآ","kami diutus","ur'sil'nā",91],["إِلَىٰ","kepada","ilā",13],["قَوْمٍۢ","kaum","qawmin",27],["مُّجْرِمِينَ","orang-orang yang berdosa","muj'rimīna",228]],"t":"(Mereka) menjawab, \"Sesungguhnya kami diutus kepada kaum yang berdosa,"},{"n":59,"w":[["إِلَّآ","kecuali","illā",15],["ءَالَ","keluarga","āla",408],["لُوطٍ","Luth","lūṭin",401],["إِنَّا","sesungguhnya kami","innā",5],["لَمُنَجُّوهُمْ","sungguh kami akan selamatkan mereka","lamunajjūhum",2503],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"kecuali para pengikut Luṭ. Sesungguhnya kami pasti menyelamatkan mereka semuanya,"},{"n":60,"w":[["إِلَّا","kecuali","illā",15],["ٱمْرَأَتَهُۥ","isterinya","im'ra-atahu",418],["قَدَّرْنَآ ۙ","Kami telah menentukan","qaddarnā",599],["إِنَّهَا","sesungguhnya ia","innahā",5],["لَمِنَ","sungguh dari/termasuk","lamina",0],["ٱلْغَـٰبِرِينَ","orang-orang yang tertinggal","l-ghābirīna",1066]],"t":"kecuali istrinya, kami telah menentukan, bahwa dia termasuk orang yang tertinggal (bersama orang kafir lainnya).\""},{"n":61,"w":[["فَلَمَّا","maka tatkala","falammā",72],["جَآءَ","datang","jāa",43],["ءَالَ","keluarga","āla",408],["لُوطٍ","Luth","lūṭin",401],["ٱلْمُرْسَلُونَ","para utusan","l-mur'salūna",326]],"t":"Maka ketika utusan itu datang kepada para pengikut Luṭ,"},{"n":62,"w":[["قَالَ","mereka berkata","qāla",6],["إِنَّكُمْ","sesungguhnya kalian","innakum",5],["قَوْمٌۭ","kaum","qawmun",27],["مُّنكَرُونَ","orang-orang yang tidak dikenal/asing","munkarūna",549]],"t":"dia (Luṭ) berkata, \"Sesungguhnya kamu orang yang tidak kami kenal.\""},{"n":63,"w":[["قَالُوا۟","mereka berkata","qālū",6],["بَلْ","bahkan/sebenarnya","bal",96],["جِئْنَـٰكَ","kami datang kepadamu","ji'nāka",43],["بِمَا","dengan apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["فِيهِ","didalamnya/padanya","fīhi",3],["يَمْتَرُونَ","mereka adakan/dustakan","yamtarūna",1445]],"t":"(Para utusan) menjawab, \"Sebenarnya kami ini datang kepadamu membawa azab yang selalu mereka dustakan."},{"n":64,"w":[["وَأَتَيْنَـٰكَ","dan kami datang kepadamu","wa-ataynāka",48],["بِٱلْحَقِّ","dengan kebenaran","bil-ḥaqi",50],["وَإِنَّا","dan sesungguhnya kami","wa-innā",5],["لَصَـٰدِقُونَ","sungguh orang-orang yang benar","laṣādiqūna",199]],"t":"Dan kami datang kepadamu membawa kebenaran dan sungguh, kami orang yang benar."},{"n":65,"w":[["فَأَسْرِ","maka berjalanlah/pergilah","fa-asri",1133],["بِأَهْلِكَ","dengan keluargamu","bi-ahlika",93],["بِقِطْعٍۢ","dengan sepotong/bagian","biqiṭ'ʿin",2586],["مِّنَ","dari","mina",0],["ٱلَّيْلِ","malam","al-layli",136],["وَٱتَّبِعْ","dan ikutilah","wa-ittabiʿ",86],["أَدْبَـٰرَهُمْ","belakang mereka","adbārahum",546],["وَلَا","dan jangan","walā",4],["يَلْتَفِتْ","berpaling/menoleh","yaltafit",2785],["مِنكُمْ","diantara kamu","minkum",0],["أَحَدٌۭ","seorang","aḥadun",159],["وَٱمْضُوا۟","dan teruskanlah","wa-im'ḍū",1581],["حَيْثُ","sebagaimana","ḥaythu",378],["تُؤْمَرُونَ","kamu diperintahkan","tu'marūna",150]],"t":"Maka pergilah kamu pada akhir malam beserta keluargamu, dan ikutilah mereka dari belakang! Jangan ada di antara kamu yang menoleh ke belakang dan teruskanlah perjalanan ke tempat yang diperintahkan kepadamu.\""},{"n":66,"w":[["وَقَضَيْنَآ","dan telah Kami selesaikan","waqaḍaynā",202],["إِلَيْهِ","kepadanya","ilayhi",13],["ذَٰلِكَ","itu","dhālika",19],["ٱلْأَمْرَ","perkara/urusan","l-amra",66],["أَنَّ","bahwasanya","anna",30],["دَابِرَ","akar-akar","dābira",1546],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["مَقْطُوعٌۭ","dipotong/ditumpas","maqṭūʿun",2463],["مُّصْبِحِينَ","diwaktu subuh","muṣ'biḥīna",1371]],"t":"Dan telah Kami tetapkan kepadanya (Luṭ) keputusan itu, bahwa akhirnya mereka akan ditumpas habis pada waktu subuh."},{"n":67,"w":[["وَجَآءَ","dan datang","wajāa",43],["أَهْلُ","penduduk","ahlu",93],["ٱلْمَدِينَةِ","kota itu","l-madīnati",573],["يَسْتَبْشِرُونَ","mereka bergembira","yastabshirūna",1119]],"t":"Dan datanglah penduduk kota itu (ke rumah Luṭ) dengan gembira (karena kedatangan tamu itu)."},{"n":68,"w":[["قَالَ","(Luth) berkata","qāla",6],["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu","hāulāi",37],["ضَيْفِى","tamuku","ḍayfī",1282],["فَلَا","maka jangan","falā",4],["تَفْضَحُونِ","kamu memalukan aku","tafḍaḥūni",3405]],"t":"Dia (Luṭ) berkata, \"Sesungguhnya mereka adalah tamuku; maka jangan kamu mempermalukan aku,"},{"n":69,"w":[["وَٱتَّقُوا۟","dan bertakwalah","wa-ittaqū",67],["ٱللَّهَ","Allah","l-laha",1],["وَلَا","dan jangan","walā",4],["تُخْزُونِ","hinakan aku","tukh'zūni",714]],"t":"dan bertakwalah kepada Allah dan janganlah kamu membuat aku terhina!\""},{"n":70,"w":[["قَالُوٓا۟","mereka berkata","qālū",6],["أَوَلَمْ","ataukah tidak","awalam",32],["نَنْهَكَ","kami melarangmu","nanhaka",357],["عَنِ","dari","ʿani",21],["ٱلْعَـٰلَمِينَ","alam semesta","l-ʿālamīna",163]],"t":"(Mereka) berkata, \"Bukankah kami telah melarangmu dari (melindungi) manusia?\""},{"n":71,"w":[["قَالَ","(Luth) berkata","qāla",6],["هَـٰٓؤُلَآءِ","mereka ini","hāulāi",37],["بَنَاتِىٓ","puteri-puteriku","banātī",567],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["فَـٰعِلِينَ","orang-orang yang melakukan","fāʿilīna",898]],"t":"Dia (Luṭ) berkata, \"Mereka itulah putri-putri (negeri)ku (nikahlah dengan mereka), jika kamu hendak berbuat.\""},{"n":72,"w":[["لَعَمْرُكَ","demi umurmu","laʿamruka",3094],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["لَفِى","sungguh dalam","lafī",3],["سَكْرَتِهِمْ","kemabukan mereka","sakratihim",2637],["يَعْمَهُونَ","mereka bingung","yaʿmahūna",1044]],"t":"(Allah berfirman), \"Demi umurmu (Muhammad), sungguh, mereka terombang-ambing dalam kemabukan (kesesatan).\""},{"n":73,"w":[["فَأَخَذَتْهُمُ","maka menimpa/membinasakan mereka","fa-akhadhathumu",94],["ٱلصَّيْحَةُ","suara keras","l-ṣayḥatu",681],["مُشْرِقِينَ","pada waktu matahari terbit","mush'riqīna",2534]],"t":"Maka mereka dibinasakan oleh suara keras yang mengguntur, ketika matahari akan terbit,"},{"n":74,"w":[["فَجَعَلْنَا","maka Kami jadikan","fajaʿalnā",33],["عَـٰلِيَهَا","bagian atasnya","ʿāliyahā",1142],["سَافِلَهَا","bagian bawahnya","sāfilahā",1995],["وَأَمْطَرْنَا","dan Kami hujani","wa-amṭarnā",1032],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["حِجَارَةًۭ","batu-batu","ḥijāratan",821],["مِّن","dari","min",0],["سِجِّيلٍ","tanah yang keras","sijjīlin",2008]],"t":"maka Kami jungkirbalikan (negeri itu) dan Kami hujani mereka dengan batu dari tanah yang keras."},{"n":75,"w":[["إِنَّ","sesungguhnya","inna",5],["فِى","didalam","fī",3],["ذَٰلِكَ","demikian","dhālika",19],["لَـَٔايَـٰتٍۢ","sungguh tanda-tanda","laāyātin",28],["لِّلْمُتَوَسِّمِينَ","bagi orang-orang yang berfikir","lil'mutawassimīna",3880]],"t":"Sungguh, pada yang demikian itu benar-benar terdapat tanda-tanda (kekuasaan Allah) bagi orang yang memperhatikan tanda-tanda,"},{"n":76,"w":[["وَإِنَّهَا","dan sesungguhnya ia/kota itu","wa-innahā",5],["لَبِسَبِيلٍۢ","sungguh di jalan","labisabīlin",64],["مُّقِيمٍ","yang tetap","muqīmin",849]],"t":"dan sungguh, (negeri) itu benar-benar terletak di jalan yang masih tetap (dilalui manusia)."},{"n":77,"w":[["إِنَّ","sesungguhnya","inna",5],["فِى","didalam/pada","fī",3],["ذَٰلِكَ","demikian","dhālika",19],["لَـَٔايَةًۭ","sungguh tanda-tanda","laāyatan",28],["لِّلْمُؤْمِنِينَ","bagi orang-orang yang beriman","lil'mu'minīna",55]],"t":"Sungguh, pada yang demikian itu benar-benar terdapat tanda (kekuasaan Allah) bagi orang yang beriman."},{"n":78,"w":[["وَإِن","dan sesungguhnya","wa-in",14],["كَانَ","adalah","kāna",9],["أَصْحَـٰبُ","penduduk","aṣḥābu",122],["ٱلْأَيْكَةِ","Aikah","l-aykati",1488],["لَظَـٰلِمِينَ","sungguh orang-orang yang zalim","laẓālimīna",88]],"t":"Dan sesungguhnya penduduk Aikah itu benar-benar kaum yang zalim,"},{"n":79,"w":[["فَٱنتَقَمْنَا","maka Kami siksa/binasakan","fa-intaqamnā",1252],["مِنْهُمْ","dari mereka","min'hum",0],["وَإِنَّهُمَا","dan sesungguhnya keduanya (kota)","wa-innahumā",5],["لَبِإِمَامٍۢ","sungguh dijalan","labi-imāmin",706],["مُّبِينٍۢ","nyata","mubīnin",102]],"t":"maka Kami membinasakan mereka. Dan sesungguhnya kedua (negeri) itu terletak di satu jalur jalan raya."},{"n":80,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["كَذَّبَ","telah mendustakan","kadhaba",63],["أَصْحَـٰبُ","penduduk","aṣḥābu",122],["ٱلْحِجْرِ","Hijir","l-ḥij'ri",1300],["ٱلْمُرْسَلِينَ","para Rasul","l-mur'salīna",326]],"t":"Dan sesungguhnya penduduk negeri Hijr benar-benar telah mendustakan para rasul (mereka),"},{"n":81,"w":[["وَءَاتَيْنَـٰهُمْ","dan Kami telah mendatangkan kepada mereka","waātaynāhum",45],["ءَايَـٰتِنَا","tanda-tanda Kami","āyātinā",28],["فَكَانُوا۟","maka/tetapi mereka adalah","fakānū",9],["عَنْهَا","daripadanya","ʿanhā",21],["مُعْرِضِينَ","orang-orang yang berpaling","muʿ'riḍīna",529]],"t":"dan Kami telah mendatangkan kepada mereka tanda-tanda (kekuasaan) Kami, tetapi mereka selalu berpaling darinya,"},{"n":82,"w":[["وَكَانُوا۟","dan adalah mereka","wakānū",9],["يَنْحِتُونَ","mereka memahat","yanḥitūna",1621],["مِنَ","dari","mina",0],["ٱلْجِبَالِ","gunung-gunung","l-jibāli",305],["بُيُوتًا","rumah-rumah","buyūtan",184],["ءَامِنِينَ","aman","āminīna",557]],"t":"dan mereka memahat rumah-rumah dari gunung batu, (yang didiami) dengan rasa aman."},{"n":83,"w":[["فَأَخَذَتْهُمُ","maka menimpa/membinasakan mereka","fa-akhadhathumu",94],["ٱلصَّيْحَةُ","suara keras","l-ṣayḥatu",681],["مُصْبِحِينَ","diwaktu pagi","muṣ'biḥīna",1371]],"t":"Kemudian mereka dibinasakan oleh suara keras yang mengguntur pada pagi hari,"},{"n":84,"w":[["فَمَآ","maka tidak","famā",2],["أَغْنَىٰ","mencukupi/berguna","aghnā",271],["عَنْهُم","dari mereka","ʿanhum",21],["مَّا","apa","mā",2],["كَانُوا۟","mereka adalah","kānū",9],["يَكْسِبُونَ","mereka usahakan","yaksibūna",194]],"t":"sehingga tidak berguna bagi mereka, apa yang telah mereka usahakan."},{"n":85,"w":[["وَمَا","dan tidak","wamā",2],["خَلَقْنَا","Kami menciptakan","khalaqnā",61],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضَ","dan bumi","wal-arḍa",22],["وَمَا","dan apa","wamā",2],["بَيْنَهُمَآ","diantara keduanya","baynahumā",47],["إِلَّا","melainkan","illā",15],["بِٱلْحَقِّ ۗ","dengan kebenaran","bil-ḥaqi",50],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلسَّاعَةَ","hari kiamat","l-sāʿata",251],["لَـَٔاتِيَةٌۭ ۖ","pasti akan datang","laātiyatun",879],["فَٱصْفَحِ","maka maafkanlah","fa-iṣ'faḥi",1156],["ٱلصَّفْحَ","maaf","l-ṣafḥa",2281],["ٱلْجَمِيلَ","yang baik","l-jamīla",1072]],"t":"Dan Kami tidak menciptakan langit dan bumi serta apa yang ada di antara keduanya, melainkan dengan kebenaran. Dan sungguh, Kiamat pasti akan datang, maka maafkanlah (mereka) dengan cara yang baik."},{"n":86,"w":[["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["ٱلْخَلَّـٰقُ","Maha Pencipta","l-khalāqu",2747],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Sungguh, Tuhanmu, Dialah Yang Maha Pencipta, Maha Mengetahui."},{"n":87,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["ءَاتَيْنَـٰكَ","Kami telah memberikan padamu","ātaynāka",45],["سَبْعًۭا","tujuh","sabʿan",456],["مِّنَ","dari","mina",0],["ٱلْمَثَانِى","dua-dua/berulang-ulang","l-mathānī",1366],["وَٱلْقُرْءَانَ","dan Al Quran","wal-qur'āna",178],["ٱلْعَظِيمَ","agung","l-ʿaẓīma",100]],"t":"Dan sungguh, Kami telah memberikan kepadamu tujuh (ayat) yang (dibaca) berulang-ulang dan Alquran yang agung."},{"n":88,"w":[["لَا","jangan","lā",4],["تَمُدَّنَّ","kamu panjangkan/tunjukkan","tamuddanna",688],["عَيْنَيْكَ","kedua matamu/pandanganmu","ʿaynayka",206],["إِلَىٰ","kepada","ilā",13],["مَا","apa","mā",2],["مَتَّعْنَا","Kami beri kesenangan","mattaʿnā",548],["بِهِۦٓ","dengannya","bihi",16],["أَزْوَٰجًۭا","pasangan/golongan","azwājan",155],["مِّنْهُمْ","diantara mereka","min'hum",0],["وَلَا","dan jangan","walā",4],["تَحْزَنْ","kamu sedih hati","taḥzan",316],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["وَٱخْفِضْ","dan rendahkanlah","wa-ikh'fiḍ",2055],["جَنَاحَكَ","sayapmu/dirimu","janāḥaka",1073],["لِلْمُؤْمِنِينَ","terhadap orang-orang yang beriman","lil'mu'minīna",55]],"t":"Jangan sekali-kali engkau (Muhammad) tujukan pandanganmu kepada kenikmatan hidup yang telah Kami berikan kepada beberapa golongan di antara mereka (orang kafir), dan jangan engkau bersedih hati terhadap mereka dan berendah hatilah engkau terhadap orang yang beriman."},{"n":89,"w":[["وَقُلْ","dan katakan","waqul",6],["إِنِّىٓ","sesungguhnya","innī",5],["أَنَا","aku","anā",183],["ٱلنَّذِيرُ","pemberi peringatan","l-nadhīru",204],["ٱلْمُبِينُ","nyata","l-mubīnu",102]],"t":"Dan katakanlah (Muhammad), \"Sesungguhnya aku adalah pemberi peringatan yang jelas.\""},{"n":90,"w":[["كَمَآ","sebagaimana","kamā",2],["أَنزَلْنَا","Kami telah menurunkan","anzalnā",62],["عَلَى","atas","ʿalā",8],["ٱلْمُقْتَسِمِينَ","orang-orang yang membagi-bagi","l-muq'tasimīna",3844]],"t":"Sebagaimana (Kami telah memberi peringatan), Kami telah menurunkan (azab) kepada orang yang memilah-milah (Kitab Allah),"},{"n":91,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["جَعَلُوا۟","(mereka) menjadikan","jaʿalū",33],["ٱلْقُرْءَانَ","Al Quran","l-qur'āna",178],["عِضِينَ","terbagi-bagi","ʿiḍīna",3118]],"t":"(Yaitu) orang-orang yang telah menjadikan Alquran itu terbagi-bagi."},{"n":92,"w":[["فَوَرَبِّكَ","demi Tuhanmu","fawarabbika",10],["لَنَسْـَٔلَنَّهُمْ","sungguh Kami akan menanyai mereka","lanasalannahum",108],["أَجْمَعِينَ","semuanya","ajmaʿīna",409]],"t":"Maka demi Tuhanmu, Kami pasti akan menanyai mereka semua,"},{"n":93,"w":[["عَمَّا","tentang apa","ʿammā",21],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"tentang apa yang telah mereka kerjakan dahulu."},{"n":94,"w":[["فَٱصْدَعْ","maka terus-teranglah","fa-iṣ'daʿ",3234],["بِمَا","dengan/segala apa","bimā",2],["تُؤْمَرُ","kamu diperintah","tu'maru",150],["وَأَعْرِضْ","dan berpaling","wa-aʿriḍ",351],["عَنِ","dari","ʿani",21],["ٱلْمُشْرِكِينَ","orang-orang musyrik","l-mush'rikīna",244]],"t":"Maka sampaikanlah (Muhammad) secara terang-terangan segala apa yang diperintahkan (kepadamu) dan berpalinglah dari orang yang musyrik."},{"n":95,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["كَفَيْنَـٰكَ","Kami memelihara kamu","kafaynāka",355],["ٱلْمُسْتَهْزِءِينَ","orang-orang yang memperolok-olok","l-mus'tahziīna",2511]],"t":"Sesungguhnya Kami memelihara engkau (Muhammad) dari (kejahatan) orang yang memperolok-olokkan (engkau),"},{"n":96,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَجْعَلُونَ","(mereka) menjadikan","yajʿalūna",33],["مَعَ","beserta/disamping","maʿa",69],["ٱللَّهِ","Allah","l-lahi",1],["إِلَـٰهًا","Tuhan","ilāhan",75],["ءَاخَرَ ۚ","lain","ākhara",176],["فَسَوْفَ","maka kelak","fasawfa",281],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"(yaitu) orang yang menganggap adanya tuhan selain Allah; mereka kelak akan mengetahui (akibatnya)."},{"n":97,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["نَعْلَمُ","Kami mengetahui","naʿlamu",29],["أَنَّكَ","bahwasanya kamu","annaka",30],["يَضِيقُ","menjadi sempit/sesak","yaḍīqu",1037],["صَدْرُكَ","dadamu","ṣadruka",267],["بِمَا","dengan apa/sebab","bimā",2],["يَقُولُونَ","mereka katakan","yaqūlūna",6]],"t":"Dan sungguh, Kami mengetahui bahwa dadamu menjadi sempit disebabkan apa yang mereka ucapkan,"},{"n":98,"w":[["فَسَبِّحْ","maka bertasbihlah kamu","fasabbiḥ",279],["بِحَمْدِ","dengan memuji","biḥamdi",272],["رَبِّكَ","Tuhanmu","rabbika",10],["وَكُن","dan jadilah kamu","wakun",9],["مِّنَ","dari/termasuk","mina",0],["ٱلسَّـٰجِدِينَ","orang-orang yang bersujud","l-sājidīna",455]],"t":"maka bertasbihlah dengan memuji Tuhanmu dan jadilah engkau di antara orang yang bersujud (salat),"},{"n":99,"w":[["وَٱعْبُدْ","dan sembahlah","wa-uʿ'bud",99],["رَبَّكَ","Tuhanmu","rabbaka",10],["حَتَّىٰ","sehingga","ḥattā",82],["يَأْتِيَكَ","datang kepadamu","yatiyaka",48],["ٱلْيَقِينُ","keyakinan","l-yaqīnu",1012]],"t":"dan sembahlah Tuhanmu sampai yakin (ajal) datang kepadamu."}]