[{"n":1,"w":[["إِنَّآ","sesungguhnya Kami","innā",9],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",100],["نُوحًا","Nuh","nūḥan",287],["إِلَىٰ","kepada","ilā",18],["قَوْمِهِۦٓ","kaumnya","qawmihi",33],["أَنْ","bahwa","an",22],["أَنذِرْ","berilah peringatan","andhir",279],["قَوْمَكَ","kaummu","qawmaka",33],["مِن","dari","min",1],["قَبْلِ","sebelum","qabli",59],["أَن","bahwa","an",22],["يَأْتِيَهُمْ","akan datang kepada mereka","yatiyahum",56],["عَذَابٌ","azab","ʿadhābun",43],["أَلِيمٌۭ","pedih","alīmun",178]],"t":"Sesungguhnya Kami telah mengutus Nuh kepada kaumnya (dengan perintah), \"Berilah kaummu peringatan sebelum datang kepadanya azab yang pedih.\""},{"n":2,"w":[["قَالَ","dia (Nuh) berkata","qāla",10],["يَـٰقَوْمِ","wahai kaumku","yāqawmi",33],["إِنِّى","sesungguhnya aku","innī",9],["لَكُمْ","bagi kalian","lakum",32],["نَذِيرٌۭ","pemberi peringatan","nadhīrun",216],["مُّبِينٌ","jelas/menjelaskan","mubīnun",111]],"t":"Dia (Nuh) berkata, \"Wahai kaumku! Sesungguhnya aku ini seorang pemberi peringatan yang menjelaskan kepada kamu,"},{"n":3,"w":[["أَنِ","hendaklah","ani",22],["ٱعْبُدُوا۟","kamu menyembah","uʿ'budū",108],["ٱللَّهَ","Allah","l-laha",4],["وَٱتَّقُوهُ","dan bertakwalah kepada-Nya","wa-ittaqūhu",76],["وَأَطِيعُونِ","dan taatilah aku","wa-aṭīʿūni",177]],"t":"(yaitu) sembahlah Allah, bertakwalah kepada-Nya dan taatlah kepadaku,"},{"n":4,"w":[["يَغْفِرْ","mengampuni","yaghfir",197],["لَكُم","bagi kalian","lakum",32],["مِّن","dari","min",1],["ذُنُوبِكُمْ","dosa-dosamu","dhunūbikum",329],["وَيُؤَخِّرْكُمْ","dan Dia menangguhkan kamu","wayu-akhir'kum",629],["إِلَىٰٓ","sampai","ilā",18],["أَجَلٍۢ","waktu","ajalin",238],["مُّسَمًّى ۚ","tertentu","musamman",504],["إِنَّ","sesungguhnya","inna",9],["أَجَلَ","waktu/ketentuan","ajala",238],["ٱللَّهِ","Allah","l-lahi",4],["إِذَا","apabila","idhā",29],["جَآءَ","bila telah datang","jāa",51],["لَا","tidak","lā",8],["يُؤَخَّرُ ۖ","ditangguhkan","yu-akharu",629],["لَوْ","jika","law",66],["كُنتُمْ","kalian adalah","kuntum",12],["تَعْلَمُونَ","(kalian) mengetahui","taʿlamūna",35]],"t":"niscaya Dia mengampuni sebagian dosa-dosamu dan menangguhkan kamu (memanjangkan umurmu) sampai pada batas waktu yang ditentukan. Sungguh, ketetapan Allah itu apabila telah datang tidak dapat ditunda, seandainya kamu mengetahui.\""},{"n":5,"w":[["قَالَ","(Nuh) berkata","qāla",10],["رَبِّ","ya Tuhanku","rabbi",15],["إِنِّى","sesungguhnya Aku","innī",9],["دَعَوْتُ","aku telah menyeru","daʿawtu",74],["قَوْمِى","kaumku","qawmī",33],["لَيْلًۭا","malam","laylan",146],["وَنَهَارًۭا","dan siang","wanahāran",221]],"t":"Dia (Nuh) berkata, \"Ya Tuhanku, sesungguhnya aku telah menyeru kaumku siang dan malam,"},{"n":6,"w":[["فَلَمْ","maka tidak","falam",39],["يَزِدْهُمْ","menambah mereka","yazid'hum",259],["دُعَآءِىٓ","seruanku","duʿāī",523],["إِلَّا","kecuali","illā",20],["فِرَارًۭا","lari","firāran",1572]],"t":"tetapi seruanku itu tidak menambah (iman) mereka, justru mereka lari (dari kebenaran)."},{"n":7,"w":[["وَإِنِّى","dan sesungguhnya aku","wa-innī",9],["كُلَّمَا","setiap kali","kullamā",642],["دَعَوْتُهُمْ","aku menyeru mereka","daʿawtuhum",74],["لِتَغْفِرَ","agar Engkau mengampuni","litaghfira",197],["لَهُمْ","kepada mereka","lahum",16],["جَعَلُوٓا۟","mereka menjadikan (memasukkan)","jaʿalū",40],["أَصَـٰبِعَهُمْ","jari-jari mereka","aṣābiʿahum",2130],["فِىٓ","dalam","fī",7],["ءَاذَانِهِمْ","telinga mereka","ādhānihim",555],["وَٱسْتَغْشَوْا۟","dan mereka menutup","wa-is'taghshaw",2814],["ثِيَابَهُمْ","baju mereka","thiyābahum",1022],["وَأَصَرُّوا۟","dan mereka berkekalan/tetap","wa-aṣarrū",1482],["وَٱسْتَكْبَرُوا۟","dan mereka menyombongkan diri","wa-is'takbarū",315],["ٱسْتِكْبَارًۭا","sangat sombong","is'tik'bāran",2821]],"t":"Dan sesungguhnya aku setiap kali menyeru mereka (untuk beriman) agar Engkau mengampuni mereka, mereka memasukkan anak jarinya ke telinganya dan menutupkan bajunya (ke wajahnya) dan mereka tetap (mengingkari) dan sangat menyombongkan diri."},{"n":8,"w":[["ثُمَّ","kemudian","thumma",41],["إِنِّى","sesungguhnya aku","innī",9],["دَعَوْتُهُمْ","aku telah menyeru mereka","daʿawtuhum",74],["جِهَارًۭا","terang-terangan","jihāran",3581]],"t":"Lalu sesungguhnya aku menyeru mereka dengan cara terang-terangan."},{"n":9,"w":[["ثُمَّ","kemudian","thumma",41],["إِنِّىٓ","sesungguhnya aku","innī",9],["أَعْلَنتُ","aku telah nyatakan/terang-terangan","aʿlantu",724],["لَهُمْ","kepada mereka","lahum",16],["وَأَسْرَرْتُ","dan aku merahasiakan","wa-asrartu",553],["لَهُمْ","kepada mereka","lahum",16],["إِسْرَارًۭا","rahasia/diam-diam","is'rāran",2141]],"t":"Kemudian aku menyeru mereka secara terbuka dan dengan diam-diam,"},{"n":10,"w":[["فَقُلْتُ","maka aku katakan","faqul'tu",10],["ٱسْتَغْفِرُوا۟","mohonlah ampun","is'taghfirū",314],["رَبَّكُمْ","Tuhan kalian","rabbakum",15],["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["كَانَ","adalah dia","kāna",12],["غَفَّارًۭا","Maha Pengampun","ghaffāran",1357]],"t":"maka aku berkata (kepada mereka), \"Mohonlah ampunan kepada Tuhanmu, Sungguh, Dia Maha Pengampun,"},{"n":11,"w":[["يُرْسِلِ","Dia akan mengirimkan","yur'sili",100],["ٱلسَّمَآءَ","langit (hujan)","l-samāa",44],["عَلَيْكُم","atas kalian","ʿalaykum",11],["مِّدْرَارًۭا","lebat","mid'rāran",1958]],"t":"niscaya Dia akan menurunkan hujan yang lebat dari langit kepadamu,"},{"n":12,"w":[["وَيُمْدِدْكُم","dan Dia memanjangkan/memberimu","wayum'did'kum",829],["بِأَمْوَٰلٍۢ","dengan harta","bi-amwālin",141],["وَبَنِينَ","dan anak-anak","wabanīna",90],["وَيَجْعَل","dan dia menjadikan","wayajʿal",40],["لَّكُمْ","bagi kalian","lakum",32],["جَنَّـٰتٍۢ","kebun-kebun","jannātin",86],["وَيَجْعَل","dan Dia menjadikan","wayajʿal",40],["لَّكُمْ","bagi kalian","lakum",32],["أَنْهَـٰرًۭا","sungai-sungai","anhāran",233]],"t":"dan Dia memperbanyak harta dan anak-anakmu, dan mengadakan kebun-kebun untukmu dan mengadakan sungai-sungai untukmu.\""},{"n":13,"w":[["مَّا","mengapa","mā",6],["لَكُمْ","bagi kalian","lakum",32],["لَا","tidak","lā",8],["تَرْجُونَ","kamu mengharapkan","tarjūna",485],["لِلَّهِ","bagi Allah","lillahi",4],["وَقَارًۭا","kebesaran","waqāran",4491]],"t":"Mengapa kamu tidak takut akan kebesaran Allah?"},{"n":14,"w":[["وَقَدْ","dan sesungguhnya","waqad",30],["خَلَقَكُمْ","menciptakan kalian","khalaqakum",70],["أَطْوَارًا","beberapa tingkatan","aṭwāran",3309]],"t":"Dan sungguh, Dia telah menciptakan kamu dalam beberapa fase (kejadian)."},{"n":15,"w":[["أَلَمْ","tidaklah","alam",39],["تَرَوْا۟","kamu perhatikan","taraw",54],["كَيْفَ","bagaimana","kayfa",148],["خَلَقَ","telah menciptakan","khalaqa",70],["ٱللَّهُ","Allah","l-lahu",4],["سَبْعَ","tujuh","sabʿa",470],["سَمَـٰوَٰتٍۢ","langit","samāwātin",44],["طِبَاقًۭا","bertingkat-tingkat","ṭibāqan",1548]],"t":"Tidakkah kamu memperhatikan bagaimana Allah telah menciptakan tujuh langit berlapis-lapis?"},{"n":16,"w":[["وَجَعَلَ","dan Dia telah menjadikan","wajaʿala",40],["ٱلْقَمَرَ","bulan","l-qamara",419],["فِيهِنَّ","padanya","fīhinna",7],["نُورًۭا","cahaya","nūran",288],["وَجَعَلَ","dan Dia telah menjadikan","wajaʿala",40],["ٱلشَّمْسَ","matahari","l-shamsa",358],["سِرَاجًۭا","pelita","sirājan",1673]],"t":"Dan di sana Dia menciptakan bulan yang bercahaya dan menjadikan matahari sebagai pelita (yang cemerlang)?"},{"n":17,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",4],["أَنۢبَتَكُم","menumbuhkan kamu","anbatakum",600],["مِّنَ","dari","mina",1],["ٱلْأَرْضِ","bumi","l-arḍi",28],["نَبَاتًۭا","pertumbuhan","nabātan",936]],"t":"Dan Allah menumbuhkan kamu dari tanah, tumbuh (berangsur-angsur),"},{"n":18,"w":[["ثُمَّ","kemudian","thumma",41],["يُعِيدُكُمْ","Dia mengembalikan kamu","yuʿīdukum",551],["فِيهَا","kedalamnya","fīhā",7],["وَيُخْرِجُكُمْ","dan Dia mengeluarkan kamu","wayukh'rijukum",125],["إِخْرَاجًۭا","pengeluaran","ikh'rājan",1143]],"t":"kemudian Dia akan mengembalikan kamu ke dalamnya (tanah) dan mengeluarkan kamu (pada hari Kiamat) dengan pasti."},{"n":19,"w":[["وَٱللَّهُ","dan Allah","wal-lahu",4],["جَعَلَ","menjadikan","jaʿala",40],["لَكُمُ","bagi kalian","lakumu",32],["ٱلْأَرْضَ","bumi","l-arḍa",28],["بِسَاطًۭا","hamparan","bisāṭan",3377]],"t":"Dan Allah menjadikan bumi untukmu sebagai hamparan,"},{"n":20,"w":[["لِّتَسْلُكُوا۟","supaya kamu melalui","litaslukū",759],["مِنْهَا","dari padanya","min'hā",1],["سُبُلًۭا","jalan-jalan","subulan",73],["فِجَاجًۭا","luas","fijājan",1854]],"t":"agar kamu dapat pergi kian kemari di jalan-jalan yang luas."},{"n":21,"w":[["قَالَ","berkata","qāla",10],["نُوحٌۭ","Nuh","nūḥun",287],["رَّبِّ","ya Tuhanku","rabbi",15],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["عَصَوْنِى","mereka mendurhakai aku","ʿaṣawnī",411],["وَٱتَّبَعُوا۟","dan mereka mengikuti","wa-ittabaʿū",95],["مَن","orang","man",17],["لَّمْ","tidak","lam",39],["يَزِدْهُ","menambah kepadanya","yazid'hu",259],["مَالُهُۥ","hartanya","māluhu",141],["وَوَلَدُهُۥٓ","dan anak-anaknya","wawaladuhu",228],["إِلَّا","kecuali","illā",20],["خَسَارًۭا","kerugian","khasāran",2076]],"t":"Nuh berkata, \"Ya Tuhanku, sesungguhnya mereka durhaka kepadaku, dan mereka mengikuti orang-orang yang harta dan anak-anaknya hanya menambah kerugian baginya,"},{"n":22,"w":[["وَمَكَرُوا۟","dan mereka membuat tipu daya","wamakarū",481],["مَكْرًۭا","tipu daya","makran",541],["كُبَّارًۭا","yang besar","kubbāran",3625]],"t":"dan mereka melakukan tipu daya yang sangat besar.\""},{"n":23,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",10],["لَا","jangan sekali-kali","lā",8],["تَذَرُنَّ","kamu meninggalkan","tadharunna",276],["ءَالِهَتَكُمْ","tuhan-tuhan kamu","ālihatakum",84],["وَلَا","dan janganlah sekali-kali","walā",8],["تَذَرُنَّ","kamu tinggalkan","tadharunna",276],["وَدًّۭا","wadd","waddan",4479],["وَلَا","dan jangan","walā",8],["سُوَاعًۭا","suwa'","suwāʿan",4301],["وَلَا","dan jangan","walā",8],["يَغُوثَ","yagus","yaghūtha",4574],["وَيَعُوقَ","dan ya'uq","wayaʿūqa",4571],["وَنَسْرًۭا","dan nasr","wanasran",4057]],"t":"Dan mereka berkata, \"Jangan sekali-kali kamu meninggalkan (penyembahan) tuhan-tuhan kamu dan jangan pula sekali-kali kamu meninggalkan (penyembahan) Wadd, dan jangan pula Suwā', Yagūṡ, Ya'ūq dan Nasr.\""},{"n":24,"w":[["وَقَدْ","dan sesungguhnya","waqad",30],["أَضَلُّوا۟","mereka telah menyesatkan","aḍallū",199],["كَثِيرًۭا ۖ","kebanyakan","kathīran",172],["وَلَا","dan jangan","walā",8],["تَزِدِ","Engkau tambahkan","tazidi",259],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97],["إِلَّا","kecuali","illā",20],["ضَلَـٰلًۭا","kesesatan","ḍalālan",325]],"t":"Dan sungguh, mereka telah menyesatkan orang banyak; dan janganlah Engkau tambahkan bagi orang-orang yang zalim itu selain kesesatan."},{"n":25,"w":[["مِّمَّا","dari apa/disebabkan","mimmā",1],["خَطِيٓـَٔـٰتِهِمْ","kesalahan-kesalahan mereka","khaṭīātihim",880],["أُغْرِقُوا۟","mereka ditenggelamkan","ugh'riqū",575],["فَأُدْخِلُوا۟","lalu mereka dimasukkan","fa-ud'khilū",289],["نَارًۭا","api/neraka","nāran",87],["فَلَمْ","maka","falam",39],["يَجِدُوا۟","mereka tidak mendapatkan","yajidū",120],["لَهُم","bagi mereka","lahum",16],["مِّن","dari","min",1],["دُونِ","selain","dūni",88],["ٱللَّهِ","Allah","l-lahi",4],["أَنصَارًۭا","penolong","anṣāran",348]],"t":"Disebabkan kesalahan-kesalahan mereka, mereka ditenggelamkan lalu dimasukkan ke neraka, maka mereka tidak mendapat penolong selain Allah."},{"n":26,"w":[["وَقَالَ","dan berkata","waqāla",10],["نُوحٌۭ","Nuh","nūḥun",287],["رَّبِّ","ya Tuhanku","rabbi",15],["لَا","jangan","lā",8],["تَذَرْ","Engkau tinggalkan/biarkan","tadhar",276],["عَلَى","diatas","ʿalā",11],["ٱلْأَرْضِ","bumi","l-arḍi",28],["مِنَ","dari","mina",1],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79],["دَيَّارًا","menetap","dayyāran",3402]],"t":"Dan Nuh berkata, \"Ya Tuhanku, janganlah Engkau biarkan seorang pun di antara orang-orang kafir itu tinggal di atas bumi."},{"n":27,"w":[["إِنَّكَ","sesungguhnya","innaka",9],["إِن","jika","in",19],["تَذَرْهُمْ","Engkau biarkan mereka","tadharhum",276],["يُضِلُّوا۟","mereka akan menyesatkan","yuḍillū",199],["عِبَادَكَ","hamba-hamba-Mu","ʿibādaka",99],["وَلَا","dan tidak","walā",8],["يَلِدُوٓا۟","mereka melahirkan","yalidū",954],["إِلَّا","kecuali","illā",20],["فَاجِرًۭا","durhaka","fājiran",1349],["كَفَّارًۭا","sangat kufur","kaffāran",1372]],"t":"Sesungguhnya jika Engkau biarkan mereka tinggal, niscaya mereka akan menyesatkan hamba-hamba-Mu, dan mereka hanya akan melahirkan anak-anak yang jahat dan tidak tahu bersyukur."},{"n":28,"w":[["رَّبِّ","ya Tuhanku","rabbi",15],["ٱغْفِرْ","ampunilah","igh'fir",197],["لِى","aku","lī",158],["وَلِوَٰلِدَىَّ","dan bagi kedua orang tuaku","waliwālidayya",879],["وَلِمَن","dan bagi orang","waliman",17],["دَخَلَ","ia masuk","dakhala",165],["بَيْتِىَ","rumahku","baytiya",196],["مُؤْمِنًۭا","dengan beriman","mu'minan",63],["وَلِلْمُؤْمِنِينَ","dan bagi orang-orang laki-laki yang beriman","walil'mu'minīna",63],["وَٱلْمُؤْمِنَـٰتِ","dan orang-orang perempuan yang beriman","wal-mu'mināti",63],["وَلَا","dan jangan","walā",8],["تَزِدِ","Engkau tambahkan","tazidi",259],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",97],["إِلَّا","kecuali","illā",20],["تَبَارًۢا","kebinasaan","tabāran",4340]],"t":"Ya Tuhanku, ampunilah aku, ibu bapakku, dan siapa pun yang memasuki rumahku dengan beriman dan semua orang yang beriman laki-laki dan perempuan. Dan janganlah Engkau tambahkan bagi orang-orang yang zalim itu selain kehancuran.\""}]