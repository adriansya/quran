[{"n":1,"w":[["وَيْلٌۭ","kecelakaan","waylun",311],["لِّلْمُطَفِّفِينَ","bagi orang-orang yang curang","lil'muṭaffifīna",3811]],"t":"Celakalah bagi orang-orang yang curang (dalam menakar dan menimbang)!"},{"n":2,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["إِذَا","apabila","idhā",29],["ٱكْتَالُوا۟","mereka menerima takaran","ik'tālū",2800],["عَلَى","atas","ʿalā",11],["ٱلنَّاسِ","manusia (orang lain)","l-nāsi",60],["يَسْتَوْفُونَ","mereka minta dipenuhi","yastawfūna",4680]],"t":"(yaitu) orang-orang yang apabila menerima takaran dari orang lain mereka minta dicukupkan,"},{"n":3,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["كَالُوهُمْ","mereka menakar","kālūhum",2426],["أَو","atau","aw",50],["وَّزَنُوهُمْ","mereka menimbang","wazanūhum",2061],["يُخْسِرُونَ","mengurangi","yukh'sirūna",2205]],"t":"dan apabila mereka menakar atau menimbang (untuk orang lain), mereka mengurangi."},{"n":4,"w":[["أَلَا","tidakkah","alā",8],["يَظُنُّ","mereka menyangka","yaẓunnu",264],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["أَنَّهُم","bahwa sesungguhnya mereka","annahum",36],["مَّبْعُوثُونَ","orang-orang yang dibangkitkan","mabʿūthūna",932]],"t":"Tidakkah mereka itu mengira, bahwa sesungguhnya mereka akan dibangkitkan,"},{"n":5,"w":[["لِيَوْمٍ","pada hari","liyawmin",31],["عَظِيمٍۢ","yang besar","ʿaẓīmin",109]],"t":"pada suatu hari yang besar,"},{"n":6,"w":[["يَوْمَ","hari","yawma",31],["يَقُومُ","wahai kaumku","yaqūmu",364],["ٱلنَّاسُ","manusia","l-nāsu",60],["لِرَبِّ","kapada Tuhan/Pemelihara","lirabbi",15],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",174]],"t":"(yaitu) pada hari (ketika) semua orang bangkit menghadap Tuhan seluruh alam."},{"n":7,"w":[["كَلَّآ","sekali-kali jangan begitu","kallā",362],["إِنَّ","sesungguhnya","inna",9],["كِتَـٰبَ","catatan","kitāba",57],["ٱلْفُجَّارِ","orang-orang durhaka","l-fujāri",1348],["لَفِى","dalam","lafī",7],["سِجِّينٍۢ","sijjin","sijjīnin",2667]],"t":"Sekali-kali jangan begitu! Sesungguhnya catatan orang yang durhaka benar-benar tersimpan dalam Sijjīn."},{"n":8,"w":[["وَمَآ","dan apakah","wamā",6],["أَدْرَىٰكَ","kamu tahu","adrāka",574],["مَا","apa","mā",6],["سِجِّينٌۭ","sijjin","sijjīnun",2667]],"t":"Dan tahukah engkau apakah Sijjīn itu?"},{"n":9,"w":[["كِتَـٰبٌۭ","kitab/catatan","kitābun",57],["مَّرْقُومٌۭ","tertulis","marqūmun",2547]],"t":"(Yaitu) Kitab yang berisi catatan (amal)."},{"n":10,"w":[["وَيْلٌۭ","dan kecelakaan","waylun",311],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",504]],"t":"Celakalah pada hari itu, bagi orang-orang yang mendustakan!"},{"n":11,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يُكَذِّبُونَ","(mereka) mendustakan","yukadhibūna",72],["بِيَوْمِ","dengan hari","biyawmi",31],["ٱلدِّينِ","pembalasan","l-dīni",130]],"t":"(yaitu) orang-orang yang mendustakannya (hari pembalasan)."},{"n":12,"w":[["وَمَا","dan tidak","wamā",6],["يُكَذِّبُ","mendustakan","yukadhibu",72],["بِهِۦٓ","dengannya","bihi",21],["إِلَّا","kecuali","illā",20],["كُلُّ","setiap","kullu",38],["مُعْتَدٍ","orang yang melampui batas","muʿ'tadin",930],["أَثِيمٍ","orang yang berbuat dosa","athīmin",1052]],"t":"Dan tidak ada yang mendustakannya (hari pembalasan) kecuali setiap orang yang melampaui batas dan berdosa,"},{"n":13,"w":[["إِذَا","apabila","idhā",29],["تُتْلَىٰ","dibacakan","tut'lā",209],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",11],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",34],["قَالَ","ia berkata","qāla",10],["أَسَـٰطِيرُ","dongen-dongen","asāṭīru",894],["ٱلْأَوَّلِينَ","orang-orang dahulu","l-awalīna",151]],"t":"yang apabila dibacakan kepadanya ayat-ayat Kami, dia berkata, \"Itu adalah dongeng orang-orang dahulu.\""},{"n":14,"w":[["كَلَّا ۖ","sekali-kali jangan/tidak","kallā",362],["بَلْ ۜ","bahkan","bal",105],["رَانَ","menutup","rāna",4159],["عَلَىٰ","atas","ʿalā",11],["قُلُوبِهِم","hati mereka","qulūbihim",98],["مَّا","apa","mā",6],["كَانُوا۟","adalah mereka","kānū",12],["يَكْسِبُونَ","mereka usahakan","yaksibūna",206]],"t":"Sekali-kali tidak! Bahkan apa yang mereka kerjakan itu telah menutupi hati mereka."},{"n":15,"w":[["كَلَّآ","sekali-kali jangan/tidak","kallā",362],["إِنَّهُمْ","sesungguhnya","innahum",9],["عَن","dari","ʿan",27],["رَّبِّهِمْ","Tuhan mereka","rabbihim",15],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["لَّمَحْجُوبُونَ","benar-benar tertutup","lamaḥjūbūna",3686]],"t":"Sekali-kali tidak! Sesungguhnya mereka pada hari itu benar-benar terhalang dari (melihat) Tuhannya."},{"n":16,"w":[["ثُمَّ","kemudian","thumma",41],["إِنَّهُمْ","sesungguhnya mereka","innahum",9],["لَصَالُوا۟","benar-benar mereka masuk","laṣālū",1820],["ٱلْجَحِيمِ","neraka","l-jaḥīmi",426]],"t":"Kemudian, sesungguhnya mereka benar-benar masuk neraka."},{"n":17,"w":[["ثُمَّ","kemudian","thumma",41],["يُقَالُ","dikatakan","yuqālu",10],["هَـٰذَا","ini","hādhā",64],["ٱلَّذِى","yang (azab)","alladhī",45],["كُنتُم","kalian adalah","kuntum",12],["بِهِۦ","dengannya/padanya","bihi",21],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",72]],"t":"Kemudian, dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu dustakan.\""},{"n":18,"w":[["كَلَّآ","sekali-kali jangan/tidak","kallā",362],["إِنَّ","sesungguhnya","inna",9],["كِتَـٰبَ","kitab/catatan","kitāba",57],["ٱلْأَبْرَارِ","orang-orang yang baik","l-abrāri",476],["لَفِى","benar-benar dalam","lafī",7],["عِلِّيِّينَ","illiyyin","ʿilliyyīna",2252]],"t":"Sekali-kali tidak! Sesungguhnya catatan orang-orang yang berbakti benar-benar tersimpan dalam 'Illiyyīn."},{"n":19,"w":[["وَمَآ","dan apakah","wamā",6],["أَدْرَىٰكَ","kamu tahu","adrāka",574],["مَا","apa","mā",6],["عِلِّيُّونَ","illiyyin","ʿilliyyūna",2252]],"t":"Dan tahukah engkau apakah 'Illiyyīn itu?"},{"n":20,"w":[["كِتَـٰبٌۭ","catatan/kitab","kitābun",57],["مَّرْقُومٌۭ","tertulis","marqūmun",2547]],"t":"(Yaitu) Kitab yang berisi catatan (amal),"},{"n":21,"w":[["يَشْهَدُهُ","menyaksikannya","yashhaduhu",278],["ٱلْمُقَرَّبُونَ","(mailaikat) yang didekatkan","l-muqarabūna",1007]],"t":"yang disaksikan oleh (malaikat-malaikat) yang didekatkan (kepada Allah)."},{"n":22,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلْأَبْرَارَ","orang-orang yang baik","l-abrāra",476],["لَفِى","benar-benar dalam","lafī",7],["نَعِيمٍ","kenikmatan/kesenangan","naʿīmin",588]],"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,"},{"n":23,"w":[["عَلَى","atas","ʿalā",11],["ٱلْأَرَآئِكِ","dipan","l-arāiki",1292],["يَنظُرُونَ","mereka melihat/memandang","yanẓurūna",139]],"t":"mereka (duduk) di atas dipan-dipan melepas pandangan."},{"n":24,"w":[["تَعْرِفُ","kamu mengenal/melihat","taʿrifu",516],["فِى","dalam","fī",7],["وُجُوهِهِمْ","wajah mereka","wujūhihim",180],["نَضْرَةَ","bersinar/bercahaya","naḍrata",2568],["ٱلنَّعِيمِ","kesenangan/kenikmatan","l-naʿīmi",588]],"t":"Kamu dapat mengetahui dari wajah mereka kesenangan hidup yang penuh kenikmatan."},{"n":25,"w":[["يُسْقَوْنَ","mereka diberi minuman","yus'qawna",971],["مِن","dari","min",1],["رَّحِيقٍۢ","minuman yang terpilih","raḥīqin",4216],["مَّخْتُومٍ","dicap/dilak","makhtūmin",3956]],"t":"Mereka diberi minum dari khamar murni (tidak memabukkan) yang (tempatnya) masih dilak (disegel),"},{"n":26,"w":[["خِتَـٰمُهُۥ","capnya/laknya","khitāmuhu",4561],["مِسْكٌۭ ۚ","kasturi","mis'kun",3785],["وَفِى","dan untuk","wafī",7],["ذَٰلِكَ","itu adalah","dhālika",26],["فَلْيَتَنَافَسِ","maka hendaklah berlomba-lomba","falyatanāfasi",4390],["ٱلْمُتَنَـٰفِسُونَ","orang-orang yang berlomba","l-mutanāfisūna",3892]],"t":"laknya dari kasturi. Dan untuk yang demikian itu hendaknya orang berlomba-lomba."},{"n":27,"w":[["وَمِزَاجُهُۥ","dan campurannya","wamizājuhu",1928],["مِن","dari","min",1],["تَسْنِيمٍ","tasnim","tasnīmin",4409]],"t":"Dan campurannya dari tasnīm,"},{"n":28,"w":[["عَيْنًۭا","mata air","ʿaynan",218],["يَشْرَبُ","meminum","yashrabu",625],["بِهَا","dengannya/padanya","bihā",106],["ٱلْمُقَرَّبُونَ","orang-orang yang didekatkan","l-muqarabūna",1007]],"t":"(yaitu) mata air yang diminum oleh mereka yang dekat (kepada Allah)."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["أَجْرَمُوا۟","(mereka) berdosa","ajramū",1288],["كَانُوا۟","adalah mereka","kānū",12],["مِنَ","dari","mina",1],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["يَضْحَكُونَ","menertawakan","yaḍḥakūna",1055]],"t":"Sesungguhnya orang-orang yang berdosa, adalah mereka yang dahulu menertawakan orang-orang yang beriman."},{"n":30,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["مَرُّوا۟","(orang-orang beriman) lewat","marrū",857],["بِهِمْ","pada mereka","bihim",16],["يَتَغَامَزُونَ","mereka saling mengedipkan mata","yataghāmazūna",4365]],"t":"Dan apabila mereka (orang-orang yang beriman) melintas di hadapan mereka, mereka saling mengedip-ngedipkan matanya,"},{"n":31,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["ٱنقَلَبُوٓا۟","(orang-orang berdosa) kembali","inqalabū",597],["إِلَىٰٓ","kepada","ilā",18],["أَهْلِهِمُ","keluarganya/kaumnya","ahlihimu",102],["ٱنقَلَبُوا۟","mereka kembali","inqalabū",597],["فَكِهِينَ","riang gembira","fakihīna",3434]],"t":"dan apabila kembali kepada kaumnya, mereka kembali dengan gembira ria."},{"n":32,"w":[["وَإِذَا","dan apabila","wa-idhā",29],["رَأَوْهُمْ","mereka melihat","ra-awhum",54],["قَالُوٓا۟","mereka berkata","qālū",10],["إِنَّ","sesungguhnya","inna",9],["هَـٰٓؤُلَآءِ","mereka itu (orang-orang beriman)","hāulāi",269],["لَضَآلُّونَ","orang-orang sesat","laḍāllūna",663]],"t":"Dan apabila mereka melihat (orang-orang mukmin), mereka mengatakan, \"Sesungguhnya mereka benar-benar orang-orang sesat,\""},{"n":33,"w":[["وَمَآ","dan tidak","wamā",6],["أُرْسِلُوا۟","dikirim","ur'silū",100],["عَلَيْهِمْ","atasnya","ʿalayhim",11],["حَـٰفِظِينَ","penjaga-penjaga","ḥāfiẓīna",630]],"t":"padahal (orang-orang yang berdosa itu), mereka tidak diutus sebagai penjaga (orang-orang mukmin)."},{"n":34,"w":[["فَٱلْيَوْمَ","maka pada hari","fal-yawma",31],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["مِنَ","dari","mina",1],["ٱلْكُفَّارِ","orang-orang kafir","l-kufāri",79],["يَضْحَكُونَ","menertawakan mereka","yaḍḥakūna",1055]],"t":"Maka pada hari ini, orang-orang yang beriman yang menertawakan orang-orang kafir,"},{"n":35,"w":[["عَلَى","atas","ʿalā",11],["ٱلْأَرَآئِكِ","dipan","l-arāiki",1292],["يَنظُرُونَ","mereka memandang/melihat","yanẓurūna",139]],"t":"mereka (duduk) di atas dipan-dipan melepas pandangan."},{"n":36,"w":[["هَلْ","apakah","hal",128],["ثُوِّبَ","diberi ganjaran/balasan","thuwwiba",4453],["ٱلْكُفَّارُ","orang-orang kafir","l-kufāru",79],["مَا","apa","mā",6],["كَانُوا۟","adalah mereka","kānū",12],["يَفْعَلُونَ","mereka kerjakan","yafʿalūna",136]],"t":"Apakah orang-orang kafir itu diberi balasan (hukuman) terhadap apa yang telah mereka perbuat?"}]