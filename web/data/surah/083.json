[{"n":1,"w":[["وَيْلٌۭ","kecelakaan","waylun",294],["لِّلْمُطَفِّفِينَ","bagi orang-orang yang curang","lil'muṭaffifīna",3797]],"t":"Celakalah bagi orang-orang yang curang (dalam menakar dan menimbang)!"},{"n":2,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["إِذَا","apabila","idhā",23],["ٱكْتَالُوا۟","mereka menerima takaran","ik'tālū",2843],["عَلَى","atas","ʿalā",8],["ٱلنَّاسِ","manusia (orang lain)","l-nāsi",52],["يَسْتَوْفُونَ","mereka minta dipenuhi","yastawfūna",4687]],"t":"(yaitu) orang-orang yang apabila menerima takaran dari orang lain mereka minta dicukupkan,"},{"n":3,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["كَالُوهُمْ","mereka menakar","kālūhum",2419],["أَو","atau","aw",42],["وَّزَنُوهُمْ","mereka menimbang","wazanūhum",2036],["يُخْسِرُونَ","mengurangi","yukh'sirūna",2825]],"t":"dan apabila mereka menakar atau menimbang (untuk orang lain), mereka mengurangi."},{"n":4,"w":[["أَلَا","tidakkah","alā",4],["يَظُنُّ","mereka menyangka","yaẓunnu",252],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["أَنَّهُم","bahwa sesungguhnya mereka","annahum",30],["مَّبْعُوثُونَ","orang-orang yang dibangkitkan","mabʿūthūna",917]],"t":"Tidakkah mereka itu mengira, bahwa sesungguhnya mereka akan dibangkitkan,"},{"n":5,"w":[["لِيَوْمٍ","pada hari","liyawmin",25],["عَظِيمٍۢ","yang besar","ʿaẓīmin",97]],"t":"pada suatu hari yang besar,"},{"n":6,"w":[["يَوْمَ","hari","yawma",25],["يَقُومُ","wahai kaumku","yaqūmu",349],["ٱلنَّاسُ","manusia","l-nāsu",52],["لِرَبِّ","kapada Tuhan/Pemelihara","lirabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",158]],"t":"(yaitu) pada hari (ketika) semua orang bangkit menghadap Tuhan seluruh alam."},{"n":7,"w":[["كَلَّآ","sekali-kali jangan begitu","kallā",347],["إِنَّ","sesungguhnya","inna",5],["كِتَـٰبَ","catatan","kitāba",49],["ٱلْفُجَّارِ","orang-orang durhaka","l-fujāri",1554],["لَفِى","dalam","lafī",3],["سِجِّينٍۢ","sijjin","sijjīnin",2644]],"t":"Sekali-kali jangan begitu! Sesungguhnya catatan orang yang durhaka benar-benar tersimpan dalam Sijjīn."},{"n":8,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu tahu","adrāka",564],["مَا","apa","mā",2],["سِجِّينٌۭ","sijjin","sijjīnun",2644]],"t":"Dan tahukah engkau apakah Sijjīn itu?"},{"n":9,"w":[["كِتَـٰبٌۭ","kitab/catatan","kitābun",49],["مَّرْقُومٌۭ","tertulis","marqūmun",2537]],"t":"(Yaitu) Kitab yang berisi catatan (amal)."},{"n":10,"w":[["وَيْلٌۭ","dan kecelakaan","waylun",294],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لِّلْمُكَذِّبِينَ","bagi orang-orang yang mendustakan","lil'mukadhibīna",494]],"t":"Celakalah pada hari itu, bagi orang-orang yang mendustakan!"},{"n":11,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُكَذِّبُونَ","(mereka) mendustakan","yukadhibūna",63],["بِيَوْمِ","dengan hari","biyawmi",25],["ٱلدِّينِ","pembalasan","l-dīni",116]],"t":"(yaitu) orang-orang yang mendustakannya (hari pembalasan)."},{"n":12,"w":[["وَمَا","dan tidak","wamā",2],["يُكَذِّبُ","mendustakan","yukadhibu",63],["بِهِۦٓ","dengannya","bihi",171],["إِلَّا","kecuali","illā",15],["كُلُّ","setiap","kullu",31],["مُعْتَدٍ","orang yang melampui batas","muʿ'tadin",1907],["أَثِيمٍ","orang yang berbuat dosa","athīmin",1044]],"t":"Dan tidak ada yang mendustakannya (hari pembalasan) kecuali setiap orang yang melampaui batas dan berdosa,"},{"n":13,"w":[["إِذَا","apabila","idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",200],["عَلَيْهِ","atasnya/kepadanya","ʿalayhi",8],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["قَالَ","ia berkata","qāla",6],["أَسَـٰطِيرُ","dongen-dongen","asāṭīru",881],["ٱلْأَوَّلِينَ","orang-orang dahulu","l-awalīna",136]],"t":"yang apabila dibacakan kepadanya ayat-ayat Kami, dia berkata, \"Itu adalah dongeng orang-orang dahulu.\""},{"n":14,"w":[["كَلَّا ۖ","sekali-kali jangan/tidak","kallā",347],["بَلْ ۜ","bahkan","bal",93],["رَانَ","menutup","rāna",4172],["عَلَىٰ","atas","ʿalā",8],["قُلُوبِهِم","hati mereka","qulūbihim",86],["مَّا","apa","mā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَكْسِبُونَ","mereka usahakan","yaksibūna",196]],"t":"Sekali-kali tidak! Bahkan apa yang mereka kerjakan itu telah menutupi hati mereka."},{"n":15,"w":[["كَلَّآ","sekali-kali jangan/tidak","kallā",347],["إِنَّهُمْ","sesungguhnya","innahum",5],["عَن","dari","ʿan",21],["رَّبِّهِمْ","Tuhan mereka","rabbihim",10],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["لَّمَحْجُوبُونَ","benar-benar tertutup","lamaḥjūbūna",3659]],"t":"Sekali-kali tidak! Sesungguhnya mereka pada hari itu benar-benar terhalang dari (melihat) Tuhannya."},{"n":16,"w":[["ثُمَّ","kemudian","thumma",34],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["لَصَالُوا۟","benar-benar mereka masuk","laṣālū",2292],["ٱلْجَحِيمِ","neraka","l-jaḥīmi",414]],"t":"Kemudian, sesungguhnya mereka benar-benar masuk neraka."},{"n":17,"w":[["ثُمَّ","kemudian","thumma",34],["يُقَالُ","dikatakan","yuqālu",6],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang (azab)","alladhī",7],["كُنتُم","kalian adalah","kuntum",9],["بِهِۦ","dengannya/padanya","bihi",17],["تُكَذِّبُونَ","kamu mendustakan","tukadhibūna",63]],"t":"Kemudian, dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu dustakan.\""},{"n":18,"w":[["كَلَّآ","sekali-kali jangan/tidak","kallā",347],["إِنَّ","sesungguhnya","inna",5],["كِتَـٰبَ","kitab/catatan","kitāba",49],["ٱلْأَبْرَارِ","orang-orang yang baik","l-abrāri",466],["لَفِى","benar-benar dalam","lafī",3],["عِلِّيِّينَ","illiyyin","ʿilliyyīna",2258]],"t":"Sekali-kali tidak! Sesungguhnya catatan orang-orang yang berbakti benar-benar tersimpan dalam 'Illiyyīn."},{"n":19,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu tahu","adrāka",564],["مَا","apa","mā",2],["عِلِّيُّونَ","illiyyin","ʿilliyyūna",2258]],"t":"Dan tahukah engkau apakah 'Illiyyīn itu?"},{"n":20,"w":[["كِتَـٰبٌۭ","catatan/kitab","kitābun",49],["مَّرْقُومٌۭ","tertulis","marqūmun",2537]],"t":"(Yaitu) Kitab yang berisi catatan (amal),"},{"n":21,"w":[["يَشْهَدُهُ","menyaksikannya","yashhaduhu",264],["ٱلْمُقَرَّبُونَ","(mailaikat) yang didekatkan","l-muqarabūna",994]],"t":"yang disaksikan oleh (malaikat-malaikat) yang didekatkan (kepada Allah)."},{"n":22,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلْأَبْرَارَ","orang-orang yang baik","l-abrāra",466],["لَفِى","benar-benar dalam","lafī",3],["نَعِيمٍ","kenikmatan/kesenangan","naʿīmin",578]],"t":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan,"},{"n":23,"w":[["عَلَى","atas","ʿalā",8],["ٱلْأَرَآئِكِ","dipan","l-arāiki",1280],["يَنظُرُونَ","mereka melihat/memandang","yanẓurūna",124]],"t":"mereka (duduk) di atas dipan-dipan melepas pandangan."},{"n":24,"w":[["تَعْرِفُ","kamu mengenal/melihat","taʿrifu",506],["فِى","dalam","fī",3],["وُجُوهِهِمْ","wajah mereka","wujūhihim",164],["نَضْرَةَ","bersinar/bercahaya","naḍrata",2558],["ٱلنَّعِيمِ","kesenangan/kenikmatan","l-naʿīmi",578]],"t":"Kamu dapat mengetahui dari wajah mereka kesenangan hidup yang penuh kenikmatan."},{"n":25,"w":[["يُسْقَوْنَ","mereka diberi minuman","yus'qawna",959],["مِن","dari","min",0],["رَّحِيقٍۢ","minuman yang terpilih","raḥīqin",4231],["مَّخْتُومٍ","dicap/dilak","makhtūmin",3963]],"t":"Mereka diberi minum dari khamar murni (tidak memabukkan) yang (tempatnya) masih dilak (disegel),"},{"n":26,"w":[["خِتَـٰمُهُۥ","capnya/laknya","khitāmuhu",4603],["مِسْكٌۭ ۚ","kasturi","mis'kun",3765],["وَفِى","dan untuk","wafī",3],["ذَٰلِكَ","itu adalah","dhālika",19],["فَلْيَتَنَافَسِ","maka hendaklah berlomba-lomba","falyatanāfasi",4702],["ٱلْمُتَنَـٰفِسُونَ","orang-orang yang berlomba","l-mutanāfisūna",3895]],"t":"laknya dari kasturi. Dan untuk yang demikian itu hendaknya orang berlomba-lomba."},{"n":27,"w":[["وَمِزَاجُهُۥ","dan campurannya","wamizājuhu",1902],["مِن","dari","min",0],["تَسْنِيمٍ","tasnim","tasnīmin",4435]],"t":"Dan campurannya dari tasnīm,"},{"n":28,"w":[["عَيْنًۭا","mata air","ʿaynan",208],["يَشْرَبُ","meminum","yashrabu",615],["بِهَا","dengannya/padanya","bihā",103],["ٱلْمُقَرَّبُونَ","orang-orang yang didekatkan","l-muqarabūna",994]],"t":"(yaitu) mata air yang diminum oleh mereka yang dekat (kepada Allah)."},{"n":29,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أَجْرَمُوا۟","(mereka) berdosa","ajramū",1277],["كَانُوا۟","adalah mereka","kānū",9],["مِنَ","dari","mina",0],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["يَضْحَكُونَ","menertawakan","yaḍḥakūna",1048]],"t":"Sesungguhnya orang-orang yang berdosa, adalah mereka yang dahulu menertawakan orang-orang yang beriman."},{"n":30,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["مَرُّوا۟","(orang-orang beriman) lewat","marrū",848],["بِهِمْ","pada mereka","bihim",11],["يَتَغَامَزُونَ","mereka saling mengedipkan mata","yataghāmazūna",4695]],"t":"Dan apabila mereka (orang-orang yang beriman) melintas di hadapan mereka, mereka saling mengedip-ngedipkan matanya,"},{"n":31,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["ٱنقَلَبُوٓا۟","(orang-orang berdosa) kembali","inqalabū",586],["إِلَىٰٓ","kepada","ilā",13],["أَهْلِهِمُ","keluarganya/kaumnya","ahlihimu",91],["ٱنقَلَبُوا۟","mereka kembali","inqalabū",586],["فَكِهِينَ","riang gembira","fakihīna",3431]],"t":"dan apabila kembali kepada kaumnya, mereka kembali dengan gembira ria."},{"n":32,"w":[["وَإِذَا","dan apabila","wa-idhā",23],["رَأَوْهُمْ","mereka melihat","ra-awhum",46],["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّ","sesungguhnya","inna",5],["هَـٰٓؤُلَآءِ","mereka itu (orang-orang beriman)","hāulāi",37],["لَضَآلُّونَ","orang-orang sesat","laḍāllūna",655]],"t":"Dan apabila mereka melihat (orang-orang mukmin), mereka mengatakan, \"Sesungguhnya mereka benar-benar orang-orang sesat,\""},{"n":33,"w":[["وَمَآ","dan tidak","wamā",2],["أُرْسِلُوا۟","dikirim","ur'silū",88],["عَلَيْهِمْ","atasnya","ʿalayhim",8],["حَـٰفِظِينَ","penjaga-penjaga","ḥāfiẓīna",683]],"t":"padahal (orang-orang yang berdosa itu), mereka tidak diutus sebagai penjaga (orang-orang mukmin)."},{"n":34,"w":[["فَٱلْيَوْمَ","maka pada hari","fal-yawma",25],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["مِنَ","dari","mina",0],["ٱلْكُفَّارِ","orang-orang kafir","l-kufāri",403],["يَضْحَكُونَ","menertawakan mereka","yaḍḥakūna",1048]],"t":"Maka pada hari ini, orang-orang yang beriman yang menertawakan orang-orang kafir,"},{"n":35,"w":[["عَلَى","atas","ʿalā",8],["ٱلْأَرَآئِكِ","dipan","l-arāiki",1280],["يَنظُرُونَ","mereka memandang/melihat","yanẓurūna",124]],"t":"mereka (duduk) di atas dipan-dipan melepas pandangan."},{"n":36,"w":[["هَلْ","apakah","hal",115],["ثُوِّبَ","diberi ganjaran/balasan","thuwwiba",4521],["ٱلْكُفَّارُ","orang-orang kafir","l-kufāru",403],["مَا","apa","mā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَفْعَلُونَ","mereka kerjakan","yafʿalūna",121]],"t":"Apakah orang-orang kafir itu diberi balasan (hukuman) terhadap apa yang telah mereka perbuat?"}]