,"w":[["وَجُمِعَ","dan dikumpulkan","wajumiʿa",469],["ٱلشَّمْسُ","matahari","l-shamsu",348],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",409]],"t":"lalu matahari dan bulan dikumpulkan,"},{"n":10,"w":[["يَقُولُ","berkata","yaqūlu",6],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["يَوْمَئِذٍ","pada hari itu","yawma-idhin",181],["أَيْنَ","dimana/kemana","ayna",526],["ٱلْمَفَرُّ","tempat lari","l-mafaru",3691]],"t":"pada hari itu manusia berkata, \"Ke mana tempat pelarian?\""},{"n":11,"w":[["كَلَّا","sekali-kali tidak","kallā",352],["لَا","tidak","lā",4],["وَزَرَ","tempat lari/berlindung","wazara",4496]],"t":"Tidak! Tidak ada tempat berlindung!"},{"n":12,"w":[["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["يَوْمَئِذٍ","pada hari itu","yawma-idhin",181],["ٱلْمُسْتَقَرُّ","tempat menetap/kembali","l-mus'taqaru",850]],"t":"Hanya kepada Tuhanmu tempat kembali pada hari itu."},{"n":13,"w":[["يُنَبَّؤُا۟","diberitahukan","yunabba-u",260],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",181],["بِمَا","tentang apa","bimā",2],["قَدَّمَ","dia kerjakan/dahulukan","qaddama",408],["وَأَخَّرَ","dia akhirkan/lalaikan","wa-akhara",620]],"t":"Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya."},{"n":14,"w":[["بَلِ","bahkan","bali",97],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["عَلَىٰ","atas","ʿalā",7],["نَفْسِهِۦ","dirinya","nafsihi",39],["بَصِيرَةٌۭ","melihat terang (menjadi saksi)","baṣīratun",1063]],"t":"Bahkan manusia menjadi saksi atas dirinya sendiri,"},{"n":15,"w":[["وَلَوْ","walaupun/meskipun","walaw",58],["أَلْقَىٰ","dia lemparkan/kemukakan","alqā",173],["مَعَاذِيرَهُۥ","uzurnya/alasan-alasannya","maʿādhīrahu",1588]],"t":"dan meskipun dia mengemukakan alasan-alasannya."},{"n":16,"w":[["لَا","jangan","lā",4],["تُحَرِّكْ","kamu gerakkan","tuḥarrik",3186],["بِهِۦ","dengannya/padanya","bihi",16],["لِسَانَكَ","lisanmu/lidahmu","lisānaka",432],["لِتَعْجَلَ","karena kamu hendak bersegera","