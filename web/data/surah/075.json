,"w":[["وَجُمِعَ","dan dikumpulkan","wajumiʿa",464],["ٱلشَّمْسُ","matahari","l-shamsu",343],["وَٱلْقَمَرُ","dan bulan","wal-qamaru",404]],"t":"lalu matahari dan bulan dikumpulkan,"},{"n":10,"w":[["يَقُولُ","berkata","yaqūlu",6],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["يَوْمَئِذٍ","pada hari itu","yawma-idhin",180],["أَيْنَ","dimana/kemana","ayna",521],["ٱلْمَفَرُّ","tempat lari","l-mafaru",3685]],"t":"pada hari itu manusia berkata, \"Ke mana tempat pelarian?\""},{"n":11,"w":[["كَلَّا","sekali-kali tidak","kallā",347],["لَا","tidak","lā",4],["وَزَرَ","tempat lari/berlindung","wazara",4490]],"t":"Tidak! Tidak ada tempat berlindung!"},{"n":12,"w":[["إِلَىٰ","kepada","ilā",13],["رَبِّكَ","Tuhanmu","rabbika",10],["يَوْمَئِذٍ","pada hari itu","yawma-idhin",180],["ٱلْمُسْتَقَرُّ","tempat menetap/kembali","l-mus'taqaru",845]],"t":"Hanya kepada Tuhanmu tempat kembali pada hari itu."},{"n":13,"w":[["يُنَبَّؤُا۟","diberitahukan","yunabba-u",256],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",180],["بِمَا","tentang apa","bimā",2],["قَدَّمَ","dia kerjakan/dahulukan","qaddama",403],["وَأَخَّرَ","dia akhirkan/lalaikan","wa-akhara",615]],"t":"Pada hari itu diberitakan kepada manusia apa yang telah dikerjakannya dan apa yang dilalaikannya."},{"n":14,"w":[["بَلِ","bahkan","bali",96],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["عَلَىٰ","atas","ʿalā",8],["نَفْسِهِۦ","dirinya","nafsihi",39],["بَصِيرَةٌۭ","melihat terang (menjadi saksi)","baṣīratun",1057]],"t":"Bahkan manusia menjadi saksi atas dirinya sendiri,"},{"n":15,"w":[["وَلَوْ","walaupun/meskipun","walaw",57],["أَلْقَىٰ","dia lemparkan/kemukakan","alqā",172],["مَعَاذِيرَهُۥ","uzurnya/alasan-alasannya","maʿādhīrahu",1582]],"t":"dan meskipun dia mengemukakan alasan-alasannya."},{"n":16,"w":[["لَا","jangan","lā",4],["تُحَرِّكْ","kamu gerakkan","tuḥarrik",3180],["بِهِۦ","dengannya/padanya","bihi",16],["لِسَانَكَ","lisanmu/lidahmu","lisānaka",427],["لِتَعْجَلَ","karena kamu hendak bersegera","