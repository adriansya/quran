",94],["يَتَمَطَّىٰٓ","dengan sombong","yatamaṭṭā",4372]],"t":"kemudian dia pergi kepada keluarganya dengan sombong."},{"n":34,"w":[["أَوْلَىٰ","lebih utama/kecelakaan","awlā",768],["لَكَ","bagimu","laka",144],["فَأَوْلَىٰ","maka lebih utama/kecelakaan","fa-awlā",768]],"t":"Celakalah kamu! Maka celakalah!"},{"n":35,"w":[["ثُمَّ","kemudian","thumma",34],["أَوْلَىٰ","lebih utama/kecelakaan","awlā",768],["لَكَ","bagimu","laka",144],["فَأَوْلَىٰٓ","maka lebih utama/kecelakaan","fa-awlā",768]],"t":"sekali lagi, celakalah kamu (manusia)! Maka celakalah!"},{"n":36,"w":[["أَيَحْسَبُ","apakah mengira","ayaḥsabu",270],["ٱلْإِنسَـٰنُ","manusia","l-insānu",171],["أَن","bahwa","an",17],["يُتْرَكَ","ia ditinggalkan","yut'raka",298],["سُدًى","begitu saja","sudan",4283]],"t":"Apakah manusia mengira, dia akan dibiarkan begitu saja (tanpa pertanggung-jawaban)?"},{"n":37,"w":[["أَلَمْ","bukankah","alam",32],["يَكُ","ia adalah","yaku",8],["نُطْفَةًۭ","setetes","nuṭ'fatan",744],["مِّن","dari","min",0],["مَّنِىٍّۢ","air mani","maniyyin",3921],["يُمْنَىٰ","ditumpahkan","yum'nā",1745]],"t":"Bukankah dia mulanya hanya setetes mani yang ditumpahkan (ke dalam rahim),"},{"n":38,"w":[["ثُمَّ","kemudian","thumma",34],["كَانَ","adalah dia","kāna",8],["عَلَقَةًۭ","segumpal darah","ʿalaqatan",1294],["فَخَلَقَ","lalu Dia ciptakan","fakhalaqa",62],["فَسَوَّىٰ","lalu Dia sempurnakan","fasawwā",674]],"t":"kemudian (mani itu) menjadi sesuatu yang melekat, lalu Allah menciptakannya dan menyempurnakannya,"},{"n":39,"w":[["فَجَعَلَ","maka/lalu Dia jadikan","fajaʿala",33],["مِنْهُ","daripadanya","min'hu",0],["ٱلزَّوْجَيْنِ","dua jodoh/pasang","l-zawjayni",156],["ٱلذَّكَرَ","laki-laki","l-dhakara",539],["وَٱلْأُنثَىٰٓ","dan perempuan","wal-unthā",438]],"t":"lalu Dia menjadikan darinya sepasang laki-laki dan perempuan."},{"n":40,"w":[["أَلَيْسَ","tidakkah","alaysa",124],["ذَٰلِكَ","demikian itu","dhālika",20],["بِقَـٰدِرٍ","berkuasa","biqādirin",673],["عَلَىٰٓ","atas","ʿalā",7],["أَن","bahwa","an",17],["يُحْـِۧىَ","menghidupkan","yuḥ'yiya",232],["ٱلْمَوْتَىٰ","orang mati","l-mawtā",317]],"t":"Bukankah (Allah yang berbuat) demikian berkuasa (pula) menghidupkan orang mati?"}]