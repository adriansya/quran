ra","litaʿjala",1304],["بِهِۦٓ","dengannya/padanya","bihi",21]],"t":"Jangan engkau (Muhammad) gerakkan lidahmu (untuk membaca Alquran) karena hendak cepat-cepat (menguasai)nya."},{"n":17,"w":[["إِنَّ","sesungguhnya","inna",9],["عَلَيْنَا","atas Kami","ʿalaynā",11],["جَمْعَهُۥ","mengumpulkannya","jamʿahu",702],["وَقُرْءَانَهُۥ","dan membacakannya","waqur'ānahu",189]],"t":"Sesungguhnya Kami yang akan mengumpulkannya (di dadamu) dan membacakannya."},{"n":18,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["قَرَأْنَـٰهُ","Kami telah membacakannya","qaranāhu",615],["فَٱتَّبِعْ","maka ikutilah","fa-ittabiʿ",95],["قُرْءَانَهُۥ","bacaannya","qur'ānahu",189]],"t":"Apabila Kami telah selesai membacakannya maka ikutilah bacaannya itu."},{"n":19,"w":[["ثُمَّ","kemudian","thumma",41],["إِنَّ","sesungguhnya","inna",9],["عَلَيْنَا","atas Kami","ʿalaynā",11],["بَيَانَهُۥ","penjelasannya","bayānahu",1842]],"t":"Kemudian sesungguhnya Kami yang akan menjelaskannya."},{"n":20,"w":[["كَلَّا","tidak sekali-kali","kallā",362],["بَلْ","bahkan/tetapi","bal",105],["تُحِبُّونَ","kamu mencintai","tuḥibbūna",200],["ٱلْعَاجِلَةَ","yang cepat","l-ʿājilata",1788]],"t":"Tidak! Bahkan Kamu mencintai kehidupan dunia,"},{"n":21,"w":[["وَتَذَرُونَ","dan kamu meninggalkan","watadharūna",276],["ٱلْـَٔاخِرَةَ","akhirat","l-ākhirata",82]],"t":"dan mengabaikan (kehidupan) akhirat."},{"n":22,"w":[["وُجُوهٌۭ","wajah-wajah","wujūhun",180],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["نَّاضِرَةٌ","berseri-seri","nāḍiratun",4072]],"t":"Wajah-wajah (orang mukmin) pada hari itu berseri-seri."},{"n":23,"w":[["إِلَىٰ","kepada","ilā",18],["رَبِّهَا","Tuhannya","rabbihā",15],["نَاظِرَةٌۭ","melihat","nāẓiratun",2564]],"t":"Memandang Tuhannya."},{"n":24,"w":[["وَوُجُوهٌۭ","dan wajah-wajah","wawujūhun",180],["يَوْمَئِذٍۭ","pada hari itu","yawma-idhin",191],["بَاسِرَةٌۭ","masam/muram","bāsiratun",3337]],"t":"Dan wajah-wajah (orang kafir) pada hari itu muram,"},{"n":25,"w":[["تَظُنُّ","ia mengira","taẓunnu",264],["أَن",