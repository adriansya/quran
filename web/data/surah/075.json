[{"n":1,"w":[["لَآ","benar-benar","lā",8],["أُقْسِمُ","aku bersumpah","uq'simu",516],["بِيَوْمِ","dengan hari","biyawmi",31],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",188]],"t":"Aku bersumpah dengan hari Kiamat,"},{"n":2,"w":[["وَلَآ","dan benar-benar","walā",8],["أُقْسِمُ","aku bersumpah","uq'simu",516],["بِٱلنَّفْسِ","dengan jiwa","bil-nafsi",47],["ٱللَّوَّامَةِ","mencela/menyesali","l-lawāmati",3658]],"t":"dan aku bersumpah demi jiwa yang selalu menyesali (dirinya sendiri)."},{"n":3,"w":[["أَيَحْسَبُ","apakah mengira","ayaḥsabu",280],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["أَلَّن","bahwa tidak","allan",22],["نَّجْمَعَ","Kami mengumpulkan","najmaʿa",479],["عِظَامَهُۥ","tulang-belulangnya","ʿiẓāmahu",109]],"t":"Apakah manusia mengira, bahwa Kami tidak akan mengumpulkan (kembali) tulang belulangnya?"},{"n":4,"w":[["بَلَىٰ","yang benar/bahkan","balā",476],["قَـٰدِرِينَ","berkuasa","qādirīna",683],["عَلَىٰٓ","atas","ʿalā",11],["أَن","dari","an",22],["نُّسَوِّىَ","Kami menyempurnakan","nusawwiya",684],["بَنَانَهُۥ","jari-jemarinya","banānahu",2345]],"t":"(Bahkan) Kami mampu menyusun (kembali) jari jemarinya dengan sempurna."},{"n":5,"w":[["بَلْ","bahkan","bal",105],["يُرِيدُ","menghendaki","yurīdu",92],["ٱلْإِنسَـٰنُ","manusia","l-insānu",181],["لِيَفْجُرَ","untuk membuat durhaka","liyafjura",2372],["أَمَامَهُۥ","di hadapannya/di masa depan","amāmahu",2991]],"t":"Tetapi manusia hendak membuat maksiat terus menerus."},{"n":6,"w":[["يَسْـَٔلُ","ia bertanya","yasalu",118],["أَيَّانَ","bilakah","ayyāna",1155],["يَوْمُ","hari","yawmu",31],["ٱلْقِيَـٰمَةِ","kiamat","l-qiyāmati",188]],"t":"Dia bertanya, \"Kapankah hari Kiamat itu?\""},{"n":7,"w":[["فَإِذَا","maka tatkala","fa-idhā",29],["بَرِقَ","bingung/takut","bariqa",3365],["ٱلْبَصَرُ","pandangan/mata","l-baṣaru",260]],"t":"Maka apabila mata terbelalak (ketakutan),"},{"n":8,"w":[["وَخَسَفَ","dan gelap/hilang cahaya","wakhasafa",1026],["ٱلْقَمَرُ","bulan","l-qamaru",419]],"t":"dan bulan pun telah hilang cahayanya,"},{"n"