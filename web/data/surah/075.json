i",91],["يَتَمَطَّىٰٓ","dengan sombong","yatamaṭṭā",4701]],"t":"kemudian dia pergi kepada keluarganya dengan sombong."},{"n":34,"w":[["أَوْلَىٰ","lebih utama/kecelakaan","awlā",767],["لَكَ","bagimu","laka",137],["فَأَوْلَىٰ","maka lebih utama/kecelakaan","fa-awlā",767]],"t":"Celakalah kamu! Maka celakalah!"},{"n":35,"w":[["ثُمَّ","kemudian","thumma",34],["أَوْلَىٰ","lebih utama/kecelakaan","awlā",767],["لَكَ","bagimu","laka",137],["فَأَوْلَىٰٓ","maka lebih utama/kecelakaan","fa-awlā",767]],"t":"sekali lagi, celakalah kamu (manusia)! Maka celakalah!"},{"n":36,"w":[["أَيَحْسَبُ","apakah mengira","ayaḥsabu",266],["ٱلْإِنسَـٰنُ","manusia","l-insānu",165],["أَن","bahwa","an",16],["يُتْرَكَ","ia ditinggalkan","yut'raka",292],["سُدًى","begitu saja","sudan",4295]],"t":"Apakah manusia mengira, dia akan dibiarkan begitu saja (tanpa pertanggung-jawaban)?"},{"n":37,"w":[["أَلَمْ","bukankah","alam",32],["يَكُ","ia adalah","yaku",9],["نُطْفَةًۭ","setetes","nuṭ'fatan",740],["مِّن","dari","min",0],["مَّنِىٍّۢ","air mani","maniyyin",3937],["يُمْنَىٰ","ditumpahkan","yum'nā",2087]],"t":"Bukankah dia mulanya hanya setetes mani yang ditumpahkan (ke dalam rahim),"},{"n":38,"w":[["ثُمَّ","kemudian","thumma",34],["كَانَ","adalah dia","kāna",9],["عَلَقَةًۭ","segumpal darah","ʿalaqatan",1298],["فَخَلَقَ","lalu Dia ciptakan","fakhalaqa",60],["فَسَوَّىٰ","lalu Dia sempurnakan","fasawwā",700]],"t":"kemudian (mani itu) menjadi sesuatu yang melekat, lalu Allah menciptakannya dan menyempurnakannya,"},{"n":39,"w":[["فَجَعَلَ","maka/lalu Dia jadikan","fajaʿala",33],["مِنْهُ","daripadanya","min'hu",0],["ٱلزَّوْجَيْنِ","dua jodoh/pasang","l-zawjayni",150],["ٱلذَّكَرَ","laki-laki","l-dhakara",537],["وَٱلْأُنثَىٰٓ","dan perempuan","wal-unthā",436]],"t":"lalu Dia menjadikan darinya sepasang laki-laki dan perempuan."},{"n":40,"w":[["أَلَيْسَ","tidakkah","alaysa",119],["ذَٰلِكَ","demikian itu","dhālika",19],["بِقَـٰدِرٍ","berkuasa","biqādirin",675],["عَلَىٰٓ","atas","ʿalā",8],["أَن","bahwa","an",16],["يُحْـِۧىَ","menghidupkan","yuḥ'yiya",231],["ٱلْمَوْتَىٰ","orang mati","l-mawtā",311]],"t":"Bukankah (Allah yang berbuat) demikian berkuasa (pula) menghidupkan orang mati?"}]