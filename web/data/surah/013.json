[{"n":1,"w":[["الٓمٓر ۚ","Alif Lam Mim Ra","alif-lam-meem-ra",3226],["تِلْكَ","ini","til'ka",310],["ءَايَـٰتُ","ayat-ayat","āyātu",34],["ٱلْكِتَـٰبِ ۗ","kitab","l-kitābi",57],["وَٱلَّذِىٓ","dan yang","wa-alladhī",45],["أُنزِلَ","diturunkan","unzila",71],["إِلَيْكَ","kepadamu","ilayka",18],["مِن","dari","min",1],["رَّبِّكَ","Tuhanmu","rabbika",15],["ٱلْحَقُّ","benar","l-ḥaqu",58],["وَلَـٰكِنَّ","akan tetapi","walākinna",220],["أَكْثَرَ","kebanyakan","akthara",155],["ٱلنَّاسِ","manusia","l-nāsi",60],["لَا","tidak","lā",8],["يُؤْمِنُونَ","mereka beriman","yu'minūna",23]],"t":"Alif Lām Mīm Rā`. Ini adalah ayat-ayat Kitab (Alquran). Dan (Kitab) yang diturunkan kepadamu (Muhammad) dari Tuhanmu itu adalah benar; tetapi kebanyakan manusia tidak beriman (kepadanya)."},{"n":2,"w":[["ٱللَّهُ","Allah","al-lahu",4],["ٱلَّذِى","yang","alladhī",45],["رَفَعَ","meninggikan","rafaʿa",486],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["بِغَيْرِ","dengan tidak/tanpa","bighayri",85],["عَمَدٍۢ","tiang","ʿamadin",1793],["تَرَوْنَهَا ۖ","kamu melihatnya","tarawnahā",54],["ثُمَّ","kemudian","thumma",41],["ٱسْتَوَىٰ","Dia menuju","is'tawā",351],["عَلَى","diatas","ʿalā",11],["ٱلْعَرْشِ ۖ","'Arasy","l-ʿarshi",392],["وَسَخَّرَ","dan Dia menundukkan","wasakhara",490],["ٱلشَّمْسَ","matahari","l-shamsa",358],["وَٱلْقَمَرَ ۖ","dan bulan","wal-qamara",419],["كُلٌّۭ","masing-masing","kullun",38],["يَجْرِى","beredar","yajrī",219],["لِأَجَلٍۢ","hingga waktu","li-ajalin",238],["مُّسَمًّۭى ۚ","ditentukan","musamman",506],["يُدَبِّرُ","Dia mengatur","yudabbiru",1567],["ٱلْأَمْرَ","urusan","l-amra",75],["يُفَصِّلُ","Dia menjelaskan","yufaṣṣilu",584],["ٱلْـَٔايَـٰتِ","tanda-tanda","l-āyāti",34],["لَعَلَّكُم","agar kalian","laʿallakum",101],["بِلِقَآءِ","dengan pertemuan","biliqāi",454],["رَبِّكُمْ","Tuhan kalian","rabbikum",15],["تُوقِنُونَ","kamu meyakini","tūqinūna",730]],"t":"Allah yang meninggikan langit tanpa tiang (sebagaimana) yang kamu lihat, kemudian Dia bersemayam di atas Arasy. Dia menundukkan matahari dan bulan; masing-masing beredar menurut waktu yang telah ditentukan. Dia mengatur urusan (makhluk-Nya), dan menjelaskan tanda-tanda (kebesaran-Nya), agar kamu yakin akan pertemuan dengan Tuhanmu."},{"n":3,"w":[["وَهُوَ","dan Dia","wahuwa",25],["ٱلَّذِى","yang","alladhī",45],["مَدَّ","membentangkan","madda",703],["ٱلْأَرْضَ","bumi","l-arḍa",28],["وَجَعَلَ","dan Dia menjadikan","wajaʿala",40],["فِيهَا","padanya","fīhā",7],["رَوَٰسِىَ","gunung-gunung","rawāsiya",870],["وَأَنْهَـٰرًۭا ۖ","dan sungai-sungai","wa-anhāran",233],["وَمِن","dan dari","wamin",1],["كُلِّ","semua/setiap","kulli",38],["ٱلثَّمَرَٰتِ","buah-buahan","l-thamarāti",595],["جَعَلَ","Dia menjadikan","jaʿala",40],["فِيهَا","padanya","fīhā",7],["زَوْجَيْنِ","berpasang-pasangan","zawjayni",166],["ٱثْنَيْنِ ۖ","dua","ith'nayni",719],["يُغْشِى","Dia menutupkan","yugh'shī",1487],["ٱلَّيْلَ","malam","al-layla",146],["ٱلنَّهَارَ ۚ","siang","l-nahāra",221],["إِنَّ","sesungguhnya","inna",9],["فِى","pada","fī",7],["ذَٰلِكَ","yang demikian","dhālika",26],["لَـَٔايَـٰتٍۢ","sungguh tanda-tanda","laāyātin",34],["لِّقَوْمٍۢ","bagi kamu","liqawmin",33],["يَتَفَكَّرُونَ","mereka memikirkan","yatafakkarūna",592]],"t":"Dan Dia yang menghamparkan bumi dan menjadikan gunung-gunung dan sungai-sungai di atasnya. Dan padanya Dia menjadikan semua buah-buahan berpasang-pasangan; Dia menutupkan malam kepada siang. Sungguh, pada yang demikian itu terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang berpikir."},{"n":4,"w":[["وَفِى","dan di","wafī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["قِطَعٌۭ","bagian-bagian","qiṭaʿun",2604],["مُّتَجَـٰوِرَٰتٌۭ","berdampingan","mutajāwirātun",4006],["وَجَنَّـٰتٌۭ","dan kebun-kebun","wajannātun",86],["مِّنْ","dari","min",1],["أَعْنَـٰبٍۢ","anggur","aʿnābin",786],["وَزَرْعٌۭ","dan tanaman-tanaman","wazarʿun",882],["وَنَخِيلٌۭ","dan pohon Kurma","wanakhīlun",565],["صِنْوَانٌۭ","bercabang","ṣin'wānun",2306],["وَغَيْرُ","dan tidak","waghayru",85],["صِنْوَانٍۢ","bercabang","ṣin'wānin",2306],["يُسْقَىٰ","disirami","yus'qā",760],["بِمَآءٍۢ","dengan air","bimāin",204],["وَٰحِدٍۢ","satu(sama)","wāḥidin",388],["وَنُفَضِّلُ","dan Kami melebihkan","wanufaḍḍilu",583],["بَعْضَهَا","sebagian","baʿḍahā",80],["عَلَىٰ","atas","ʿalā",11],["بَعْضٍۢ","sebagian yang lain","baʿḍin",80],["فِى","dalam/tentang","fī",7],["ٱلْأُكُلِ ۚ","rasa","l-ukuli",1054],["إِنَّ","sesungguhnya","inna",9],["فِى","pada","fī",7],["ذَٰلِكَ","yang demikian","dhālika",26],["لَـَٔايَـٰتٍۢ","sungguh tanda-tanda","laāyātin",34],["لِّقَوْمٍۢ","bagi kaum","liqawmin",33],["يَعْقِلُونَ","mereka berfikir","yaʿqilūna",253]],"t":"Dan di bumi terdapat bagian-bagian yang berdampingan, kebun-kebun anggur, tanaman-tanaman, pohon kurma yang bercabang, dan yang tidak bercabang; disirami dengan air yang sama, tetapi Kami lebihkan tanaman yang satu dari yang lainnya dalam hal rasanya. Sungguh, pada yang demikian itu terdapat tanda-tanda (kebesaran Allah) bagi orang-orang yang berakal."},{"n":5,"w":[["۞ وَإِن","dan jika","wa-in",19],["تَعْجَبْ","kamu herankan","taʿjab",974],["فَعَجَبٌۭ","maka yang mengherankan","faʿajabun",1303],["قَوْلُهُمْ","ucapan/perkataan mereka","qawluhum",129],["أَءِذَا","apakah apabila","a-idhā",29],["كُنَّا","adalah kami","kunnā",12],["تُرَٰبًا","tanah","turāban",594],["أَءِنَّا","apakah sesungguhnya kami","a-innā",9],["لَفِى","sungguh dalam","lafī",7],["خَلْقٍۢ","makhluk/ciptaan","khalqin",241],["جَدِيدٍ ۗ","baru","jadīdin",994],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["بِرَبِّهِمْ ۖ","dengan/kepada Tuhan mereka","birabbihim",15],["وَأُو۟لَـٰٓئِكَ","dan mereka itu","wa-ulāika",65],["ٱلْأَغْلَـٰلُ","belenggu","l-aghlālu",921],["فِىٓ","pada","fī",7],["أَعْنَاقِهِمْ ۖ","leher mereka","aʿnāqihim",903],["وَأُو۟لَـٰٓئِكَ","dan mereka itu","wa-ulāika",65],["أَصْحَـٰبُ","penghuni","aṣḥābu",132],["ٱلنَّارِ ۖ","api/neraka","l-nāri",87],["هُمْ","mereka","hum",16],["فِيهَا","didalamnya","fīhā",7],["خَـٰلِدُونَ","kekal","khālidūna",173]],"t":"Dan jika engkau merasa heran, maka yang mengherankan adalah ucapan mereka, \" Apabila kami telah menjadi tanah, apakah kami akan (dikembalikan) menjadi makhluk yang baru?\" Mereka itulah yang ingkar kepada Tuhannya; dan mereka itulah (yang dilekatkan) belenggu di lehernya. Mereka adalah penghuni neraka, mereka kekal di dalamnya."},{"n":6,"w":[["وَيَسْتَعْجِلُونَكَ","dan mereka minta disegerakan kepadamu","wayastaʿjilūnaka",548],["بِٱلسَّيِّئَةِ","dengan keburukan/siksa","bil-sayi-ati",217],["قَبْلَ","sebelum","qabla",59],["ٱلْحَسَنَةِ","kebaikan","l-ḥasanati",377],["وَقَدْ","dan/padahal sungguh","waqad",30],["خَلَتْ","telah lewat/terjadi","khalat",445],["مِن","dari","min",1],["قَبْلِهِمُ","sebelum mereka","qablihimu",59],["ٱلْمَثُلَـٰتُ ۗ","beberapa contoh","l-mathulātu",3901],["وَإِنَّ","dan sesungguhnya","wa-inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["لَذُو","sungguh mempunyai","ladhū",126],["مَغْفِرَةٍۢ","ampunan","maghfiratin",406],["لِّلنَّاسِ","bagi manusia","lilnnāsi",60],["عَلَىٰ","atas","ʿalā",11],["ظُلْمِهِمْ ۖ","kezaliman mereka","ẓul'mihim",523],["وَإِنَّ","dan sesungguhnya","wa-inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["لَشَدِيدُ","sungguh sangat berat","lashadīdu",225],["ٱلْعِقَابِ","siksaan","l-ʿiqābi",518]],"t":"Dan mereka meminta kepadamu agar dipercepat (datangnya) siksaan, sebelum (mereka meminta) kebaikan, padahal telah terjadi bermacam-macam contoh siksaan sebelum mereka. Sungguh, Tuhanmu benar-benar memiliki ampunan bagi manusia atas kezaliman mereka, dan sungguh, Tuhanmu sangat keras siksaan-Nya."},{"n":7,"w":[["وَيَقُولُ","dan berkata","wayaqūlu",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لَوْلَآ","mengapa tidak","lawlā",167],["أُنزِلَ","diturunkan","unzila",71],["عَلَيْهِ","kepadanya","ʿalayhi",11],["ءَايَةٌۭ","suatu tanda","āyatun",34],["مِّن","dari","min",1],["رَّبِّهِۦٓ ۗ","Tuhannya","rabbihi",15],["إِنَّمَآ","sesungguhnya hanyalah","innamā",9],["أَنتَ","kamu","anta",154],["مُنذِرٌۭ ۖ","pemberi peringatan","mundhirun",645],["وَلِكُلِّ","dan bagi tiap-tiap","walikulli",38],["قَوْمٍ","kaum","qawmin",33],["هَادٍ","orang yang memberi petunjuk","hādin",1085]],"t":"Dan orang-orang kafir berkata, \"Mengapa tidak diturunkan kepadanya (Muhammad) suatu tanda (mukjizat) dari Tuhannya?\" Sesungguhnya engkau hanyalah seorang pemberi peringatan; dan bagi setiap kaum ada orang yang memberi petunjuk."},{"n":8,"w":[["ٱللَّهُ","Allah","al-lahu",4],["يَعْلَمُ","Dia mengetahui","yaʿlamu",35],["مَا","apa","mā",6],["تَحْمِلُ","yang dikandung","taḥmilu",299],["كُلُّ","tiap-tiap","kullu",38],["أُنثَىٰ","perempuan","unthā",448],["وَمَا","dan apa","wamā",6],["تَغِيضُ","kurang sempurna","taghīḍu",2381],["ٱلْأَرْحَامُ","kandungan rahim","l-arḥāmu",758],["وَمَا","dan apa","wamā",6],["تَزْدَادُ ۖ","bertambah","tazdādu",1038],["وَكُلُّ","dan tiap-tiap/segala","wakullu",38],["شَىْءٍ","sesuatu","shayin",49],["عِندَهُۥ","pada sisiNya","ʿindahu",68],["بِمِقْدَارٍ","dengan ukuran","bimiq'dārin",1928]],"t":"Allah mengetahui apa yang dikandung oleh setiap perempuan, apa yang kurang sempurna dan apa yang bertambah dalam rahim. Dan segala sesuatu ada ukuran di sisi-Nya."},{"n":9,"w":[["عَـٰلِمُ","yang mengetahui","ʿālimu",558],["ٱلْغَيْبِ","yang gaib","l-ghaybi",254],["وَٱلشَّهَـٰدَةِ","dan yang nampak","wal-shahādati",422],["ٱلْكَبِيرُ","Maha Besar","l-kabīru",302],["ٱلْمُتَعَالِ","Maha Tinggi","l-mutaʿāli",3884]],"t":"(Allah) Yang mengetahui semua yang gaib dan yang nyata; Yang Mahabesar, Mahatinggi."},{"n":10,"w":[["سَوَآءٌۭ","sama saja","sawāon",420],["مِّنكُم","diantaramu","minkum",1],["مَّنْ","siapa yang","man",17],["أَسَرَّ","merahasiakan","asarra",554],["ٱلْقَوْلَ","perkataan/ucapan","l-qawla",129],["وَمَن","dan siapa","waman",17],["جَهَرَ","nampakkan/terus terang","jahara",1365],["بِهِۦ","dengannya","bihi",21],["وَمَنْ","dan siapa","waman",17],["هُوَ","dia","huwa",25],["مُسْتَخْفٍۭ","bersembunyi","mus'takhfin",3881],["بِٱلَّيْلِ","di malam hari","bi-al-layli",146],["وَسَارِبٌۢ","dan berjalan","wasāribun",4242],["بِٱلنَّهَارِ","disiang hari","bil-nahāri",221]],"t":"Sama saja (bagi Allah), siapa di antaramu yang merahasiakan ucapannya dan siapa yang berterus terang dengannya; dan siapa yang bersembunyi pada malam hari dan yang berjalan pada siang hari."},{"n":11,"w":[["لَهُۥ","baginya(seseorang)","lahu",21],["مُعَقِّبَـٰتٌۭ","pengiring","muʿaqqibātun",2504],["مِّنۢ","dari","min",1],["بَيْنِ","antara","bayni",55],["يَدَيْهِ","dua tangannya/depannya","yadayhi",110],["وَمِنْ","dan dari","wamin",1],["خَلْفِهِۦ","belakangnya","khalfihi",492],["يَحْفَظُونَهُۥ","mereka menjaganya","yaḥfaẓūnahu",1069],["مِنْ","dari/atas","min",1],["أَمْرِ","perintah","amri",75],["ٱللَّهِ ۗ","Allah","l-lahi",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَا","tidak","lā",8],["يُغَيِّرُ","merobah","yughayyiru",1577],["مَا","apa/keadaan","mā",6],["بِقَوْمٍ","dengan suatu kaum","biqawmin",33],["حَتَّىٰ","sehingga","ḥattā",91],["يُغَيِّرُوا۟","mereka merobah","yughayyirū",1577],["مَا","apa/keadaan","mā",6],["بِأَنفُسِهِمْ ۗ","dengan diri mereka sendiri","bi-anfusihim",47],["وَإِذَآ","dan jika","wa-idhā",29],["أَرَادَ","menghendaki","arāda",92],["ٱللَّهُ","Allah","l-lahu",4],["بِقَوْمٍۢ","dengan suatu kaum","biqawmin",33],["سُوٓءًۭا","keburukan","sūan",251],["فَلَا","maka tidak","falā",8],["مَرَدَّ","menolak","maradda",1214],["لَهُۥ ۚ","baginya","lahu",21],["وَمَا","dan tidak ada","wamā",6],["لَهُم","bagi mereka","lahum",16],["مِّن","dari","min",1],["دُونِهِۦ","selain Dia","dūnihi",88],["مِن","dari","min",1],["وَالٍ","pelindung","wālin",4464]],"t":"Baginya (manusia) ada malaikat-malaikat yang selalu menjaganya bergiliran, dari depan dan belakangnya. Mereka menjaganya atas perintah Allah. Sesungguhnya Allah tidak mengubah keadaan suatu kaum sebelum mereka mengubah keadaan diri mereka sendiri. Dan apabila Allah menghendaki keburukan terhadap suatu kaum, maka tak ada yang dapat menolaknya dan tidak ada pelindung bagi mereka selain Dia."},{"n":12,"w":[["هُوَ","Dia-lah","huwa",25],["ٱلَّذِى","yang","alladhī",45],["يُرِيكُمُ","memperlihatkan kepadamu","yurīkumu",305],["ٱلْبَرْقَ","kilat","l-barqa",1342],["خَوْفًۭا","ketakutan","khawfan",431],["وَطَمَعًۭا","dan harapan","waṭamaʿan",1550],["وَيُنشِئُ","dan Dia mengadakan","wayunshi-u",515],["ٱلسَّحَابَ","awan","l-saḥāba",945],["ٱلثِّقَالَ","tebal/mendung","l-thiqāla",1438]],"t":"Dialah yang memperlihatkan kilat kepadamu yang menimbulkan ketakutan dan harapan, dan Dia menjadikan awan mendung."},{"n":13,"w":[["وَيُسَبِّحُ","dan bertasbih","wayusabbiḥu",293],["ٱلرَّعْدُ","guruh","l-raʿdu",2619],["بِحَمْدِهِۦ","dengan memujiNya","biḥamdihi",286],["وَٱلْمَلَـٰٓئِكَةُ","dan Malaikat","wal-malāikatu",137],["مِنْ","dari/karena","min",1],["خِيفَتِهِۦ","takut kepadaNya","khīfatihi",1266],["وَيُرْسِلُ","dan Dia melepaskan","wayur'silu",100],["ٱلصَّوَٰعِقَ","halilintar","l-ṣawāʿiqa",979],["فَيُصِيبُ","maka/lalu mengenai","fayuṣību",201],["بِهَا","dengannya","bihā",106],["مَن","siapa","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَهُمْ","dan/namun mereka","wahum",16],["يُجَـٰدِلُونَ","mereka berbantah-bantah","yujādilūna",440],["فِى","tentang","fī",7],["ٱللَّهِ","Allah","l-lahi",4],["وَهُوَ","dan Dia","wahuwa",25],["شَدِيدُ","amat/Maha Keras","shadīdu",225],["ٱلْمِحَالِ","siksa","l-miḥāli",3778]],"t":"Dan guruh bertasbih memuji-Nya, (demikian pula) para malaikat karena takut kepada-Nya, dan Allah melepaskan halilintar, lalu menimpakannya kepada siapa yang Dia kehendaki, sementara mereka berbantah-bantahan tentang Allah, dan Dia Mahakeras siksaan-Nya."},{"n":14,"w":[["لَهُۥ","bagi Dia Allah","lahu",21],["دَعْوَةُ","doa/permintaan","daʿwatu",1188],["ٱلْحَقِّ ۖ","benar","l-ḥaqi",58],["وَٱلَّذِينَ","dan berhala-berhala","wa-alladhīna",13],["يَدْعُونَ","mereka menyembah","yadʿūna",74],["مِن","dari","min",1],["دُونِهِۦ","selain Dia/Allah","dūnihi",88],["لَا","tidak","lā",8],["يَسْتَجِيبُونَ","mereka dapat memperkenankan","yastajībūna",409],["لَهُم","bagi mereka","lahum",16],["بِشَىْءٍ","dengan sesuatu","bishayin",49],["إِلَّا","melainkan","illā",20],["كَبَـٰسِطِ","seperti orang yang membuka","kabāsiṭi",1558],["كَفَّيْهِ","kedua telapak tangannya","kaffayhi",2431],["إِلَى","kedalam","ilā",18],["ٱلْمَآءِ","air","l-māi",204],["لِيَبْلُغَ","supaya sampai","liyablugha",306],["فَاهُ","mulutnya","fāhu",698],["وَمَا","dan/padahal tidaklah","wamā",6],["هُوَ","ia","huwa",25],["بِبَـٰلِغِهِۦ ۚ","sampai kepadanya/mulutnya","bibālighihi",915],["وَمَا","dan tidaklah","wamā",6],["دُعَآءُ","doa","duʿāu",478],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79],["إِلَّا","kecuali/hanyalah","illā",20],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan/sia-sia","ḍalālin",325]],"t":"Hanya kepada Allah doa yang benar. Berhala-berhala yang mereka sembah selain Allah tidak dapat mengabulkan apa pun bagi mereka, tidak ubahnya seperti orang yang membukakan kedua telapak tangannya ke dalam air agar (air) sampai ke mulutnya. Padahal air itu tidak akan sampai ke mulutnya. Dan doa orang-orang kafir itu, hanyalah sia-sia belaka."},{"n":15,"w":[["وَلِلَّهِ","dan kepada Allah","walillahi",4],["يَسْجُدُ","bersujud","yasjudu",350],["مَن","siap/apa","man",17],["فِى","di","fī",7],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["طَوْعًۭا","taat/atas kemauan sendiri","ṭawʿan",1552],["وَكَرْهًۭا","dan terpaksa","wakarhan",1374],["وَظِلَـٰلُهُم","dan bayang-bayang mereka","waẓilāluhum",671],["بِٱلْغُدُوِّ","diwaktu pagi","bil-ghuduwi",1359],["وَٱلْـَٔاصَالِ ۩","dan petang","wal-āṣāli",1045]],"t":"Dan semua sujud kepada Allah baik yang di langit maupun yang di bumi, baik dengan kemauan sendiri maupun terpaksa (dan sujud pula) bayang-bayang mereka, pada waktu pagi dan petang hari."},{"n":16,"w":[["قُلْ","katakanlah","qul",10],["مَن","siapa","man",17],["رَّبُّ","Tuhan","rabbu",15],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",44],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",28],["قُلِ","katakanlah","quli",10],["ٱللَّهُ ۚ","Allah","l-lahu",4],["قُلْ","katakanlah","qul",10],["أَفَٱتَّخَذْتُم","patutkah kamu mengambil","afa-ittakhadhtum",107],["مِّن","dari","min",1],["دُونِهِۦٓ","selain Dia/Allah","dūnihi",88],["أَوْلِيَآءَ","pelindung-pelindung","awliyāa",142],["لَا","tidak","lā",8],["يَمْلِكُونَ","mereka mnguasai","yamlikūna",282],["لِأَنفُسِهِمْ","bagi diri mereka sendiri","li-anfusihim",47],["نَفْعًۭا","kemanfaatan","nafʿan",807],["وَلَا","dan tidak","walā",8],["ضَرًّۭا ۚ","kemudaratan","ḍarran",831],["قُلْ","katakanlah","qul",10],["هَلْ","apakah","hal",128],["يَسْتَوِى","sama","yastawī",351],["ٱلْأَعْمَىٰ","orang buta","l-aʿmā",495],["وَٱلْبَصِيرُ","dan orang yang dapat melihat","wal-baṣīru",244],["أَمْ","atau","am",93],["هَلْ","apakah","hal",128],["تَسْتَوِى","sama","tastawī",351],["ٱلظُّلُمَـٰتُ","gelap gulita","l-ẓulumātu",463],["وَٱلنُّورُ ۗ","dan cahaya/terang benderang","wal-nūru",288],["أَمْ","atau","am",93],["جَعَلُوا۟","mereka menjadikan","jaʿalū",40],["لِلَّهِ","bagi Allah","lillahi",4],["شُرَكَآءَ","beberapa sekutu","shurakāa",304],["خَلَقُوا۟","mereka menciptakan","khalaqū",70],["كَخَلْقِهِۦ","seperti ciptaanNya","kakhalqihi",241],["فَتَشَـٰبَهَ","maka/lalu serupa","fatashābaha",1677],["ٱلْخَلْقُ","ciptaan","l-khalqu",241],["عَلَيْهِمْ ۚ","atas mereka","ʿalayhim",11],["قُلِ","katakanlah","quli",10],["ٱللَّهُ","Allah","l-lahu",4],["خَـٰلِقُ","pencipta","khāliqu",764],["كُلِّ","segala","kulli",38],["شَىْءٍۢ","sesuatu","shayin",49],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْوَٰحِدُ","Maha Esa","l-wāḥidu",388],["ٱلْقَهَّـٰرُ","Maha Perkasa","l-qahāru",1234]],"t":"Katakanlah (Muhammad), \"Siapakah Tuhan langit dan bumi?\" katakanlah, \"Allah.\" Katakanlah, \"Pantaskah kamu mengambil pelindung-pelindung selain Allah, padahal mereka tidak kuasa mendatangkan manfaat maupun menolak mudarat bagi dirinya sendiri?\" Katakanlah, \"Samakah orang yang buta dengan yang dapat melihat? Atau samakah yang gelap dengan yang terang? Apakah mereka menjadikan sekutu-sekutu bagi Allah yang dapat menciptakan seperti ciptaan-Nya sehingga kedua ciptaan itu serupa menurut pandangan mereka?\" Katakanlah, \"Allah adalah Pencipta segala sesuatu dan Dia Tuhan Yang Maha Esa, Mahaperkasa.\""},{"n":17,"w":[["أَنزَلَ","(Allah)telah menurunkan","anzala",71],["مِنَ","dari","mina",1],["ٱلسَّمَآءِ","langit","l-samāi",44],["مَآءًۭ","air","māan",204],["فَسَالَتْ","maka mengalirlah ia","fasālat",4239],["أَوْدِيَةٌۢ","lembah-lembah","awdiyatun",2050],["بِقَدَرِهَا","dengan/menurut ukurannya","biqadarihā",810],["فَٱحْتَمَلَ","maka membawa","fa-iḥ'tamala",2090],["ٱلسَّيْلُ","arus","l-saylu",2663],["زَبَدًۭا","buih","zabadan",2084],["رَّابِيًۭا ۚ","mengembang","rābiyan",2637],["وَمِمَّا","dan dari apa","wamimmā",1],["يُوقِدُونَ","mereka bakar/lembur","yūqidūna",1299],["عَلَيْهِ","atasnya","ʿalayhi",11],["فِى","dalam","fī",7],["ٱلنَّارِ","api","l-nāri",87],["ٱبْتِغَآءَ","mencari/membuat","ib'tighāa",686],["حِلْيَةٍ","perhiasan","ḥil'yatin",1319],["أَوْ","atau","aw",50],["مَتَـٰعٍۢ","kesenangan/alat-alat","matāʿin",347],["زَبَدٌۭ","buih","zabadun",2084],["مِّثْلُهُۥ ۚ","sepertinya(buih arus)","mith'luhu",168],["كَذَٰلِكَ","demikianlah","kadhālika",26],["يَضْرِبُ","membuat","yaḍribu",230],["ٱللَّهُ","Allah","l-lahu",4],["ٱلْحَقَّ","benar","l-ḥaqa",58],["وَٱلْبَـٰطِلَ ۚ","dan bathil","wal-bāṭila",425],["فَأَمَّا","maka adapun","fa-ammā",229],["ٱلزَّبَدُ","buih","l-zabadu",2084],["فَيَذْهَبُ","maka akan hilang","fayadhhabu",343],["جُفَآءًۭ ۖ","tak berharga","jufāan",3587],["وَأَمَّا","dan adapun","wa-ammā",229],["مَا","apa","mā",6],["يَنفَعُ","memberi manfaat","yanfaʿu",378],["ٱلنَّاسَ","manusia","l-nāsa",60],["فَيَمْكُثُ","maka ia tetap","fayamkuthu",1603],["فِى","di","fī",7],["ٱلْأَرْضِ ۚ","bumi","l-arḍi",28],["كَذَٰلِكَ","demikianlah","kadhālika",26],["يَضْرِبُ","membuat","yaḍribu",230],["ٱللَّهُ","Allah","l-lahu",4],["ٱلْأَمْثَالَ","perumpamaan-perumpamaan","l-amthāla",138]],"t":"Allah telah menurunkan air (hujan) dari langit, maka mengalirlah ia (air) di lembah-lembah menurut ukurannya, maka arus itu membawa buih yang mengambang. Dan dari apa (logam) yang mereka lebur dalam api untuk membuat perhiasan atau alat-alat, ada (pula) buihnya seperti (buih arus) itu. Demikianlah Allah membuat perumpamaan (tentang) yang benar dan yang batil. Adapun buih, akan hilang sebagai sesuatu yang tidak ada gunanya; tetapi yang bermanfaat bagi manusia, akan tetap ada di bumi. Demikianlah Allah membuat perumpamaan."},{"n":18,"w":[["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["ٱسْتَجَابُوا۟","mereka memenuhi seruan","is'tajābū",409],["لِرَبِّهِمُ","bagi Tuhan mereka","lirabbihimu",15],["ٱلْحُسْنَىٰ ۚ","pembalasan yang baik","l-ḥus'nā",580],["وَٱلَّذِينَ","dan orang-orang","wa-alladhīna",13],["لَمْ","tidak","lam",39],["يَسْتَجِيبُوا۟","mereka memenuhi panggilan","yastajībū",409],["لَهُۥ","bagiNya","lahu",21],["لَوْ","jikalau","law",66],["أَنَّ","bahwasanya/bahwa","anna",36],["لَهُم","bagi mereka","lahum",16],["مَّا","apa","mā",6],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["جَمِيعًۭا","semuanya","jamīʿan",236],["وَمِثْلَهُۥ","dan seperti/sebanyak","wamith'lahu",168],["مَعَهُۥ","besertanya","maʿahu",78],["لَٱفْتَدَوْا۟","niscaya mereka menebus","la-if'tadaw",1134],["بِهِۦٓ ۚ","dengannya","bihi",21],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["لَهُمْ","bagi mereka","lahum",16],["سُوٓءُ","seburuk-buruk","sūu",251],["ٱلْحِسَابِ","hisab/perhitungan","l-ḥisābi",319],["وَمَأْوَىٰهُمْ","dan tempat kediaman mereka","wamawāhum",482],["جَهَنَّمُ ۖ","jahanam","jahannamu",162],["وَبِئْسَ","dan seburuk-buruk","wabi'sa",307],["ٱلْمِهَادُ","tempat kembali","l-mihādu",1099]],"t":"Bagi orang-orang yang memenuhi seruan Tuhan, mereka (disediakan) balasan yang baik. Dan orang-orang yang tidak memenuhi seruan-Nya, sekiranya mereka memiliki semua yang ada di bumi dan (ditambah) sebanyak itu lagi, niscaya mereka akan menebus dirinya dengan itu. Orang-orang itu mendapat hisab (perhitungan) yang buruk dan tempat kediaman mereka Jahanam, dan itulah seburuk-buruk tempat kediaman."},{"n":19,"w":[["۞ أَفَمَن","apakah orang","afaman",17],["يَعْلَمُ","mengetahui","yaʿlamu",35],["أَنَّمَآ","bahwasanya","annamā",9],["أُنزِلَ","diturunkan","unzila",71],["إِلَيْكَ","kepadamu","ilayka",18],["مِن","dari","min",1],["رَّبِّكَ","Tuhanmu","rabbika",15],["ٱلْحَقُّ","benar","l-ḥaqu",58],["كَمَنْ","seperti orang","kaman",17],["هُوَ","dia","huwa",25],["أَعْمَىٰٓ ۚ","buta","aʿmā",495],["إِنَّمَا","sesungguhnya hanyalah","innamā",9],["يَتَذَكَّرُ","mengambil pelajaran","yatadhakkaru",245],["أُو۟لُوا۟","yang mempunyai","ulū",272],["ٱلْأَلْبَـٰبِ","akal/berakal","l-albābi",610]],"t":"Maka apakah orang yang mengetahui bahwa apa yang diturunkan Tuhan kepadamu adalah kebenaran, sama dengan orang yang buta? Hanya orang berakal saja yang dapat mengambil pelajaran,"},{"n":20,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يُوفُونَ","(mereka)memenuhi","yūfūna",555],["بِعَهْدِ","dengan janji","biʿahdi",391],["ٱللَّهِ","Allah","l-lahi",4],["وَلَا","dan tidak","walā",8],["يَنقُضُونَ","mereka merusak","yanquḍūna",1227],["ٱلْمِيثَـٰقَ","perjanjian","l-mīthāqa",443]],"t":"(yaitu) orang yang memenuhi janji Allah dan tidak melanggar perjanjian,"},{"n":21,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["يَصِلُونَ","(mereka)menghubungkan","yaṣilūna",878],["مَآ","apa","mā",6],["أَمَرَ","memerintahkan","amara",161],["ٱللَّهُ","Allah","l-lahu",4],["بِهِۦٓ","dengannya","bihi",21],["أَن","supaya","an",22],["يُوصَلَ","dihubungkan","yūṣala",878],["وَيَخْشَوْنَ","dan mereka takut","wayakhshawna",312],["رَبَّهُمْ","Tuhan mereka","rabbahum",15],["وَيَخَافُونَ","dan mereka takut","wayakhāfūna",150],["سُوٓءَ","seburuk-buruk","sūa",251],["ٱلْحِسَابِ","hisab/perhitungan","l-ḥisābi",319]],"t":"dan orang-orang yang menghubungkan apa yang diperintahkan Allah agar dihubungkan, dan mereka takut kepada Tuhannya dan takut kepada hisab yang buruk."},{"n":22,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["صَبَرُوا۟","(mereka)bersabar","ṣabarū",215],["ٱبْتِغَآءَ","mencari","ib'tighāa",686],["وَجْهِ","wajah/keridhaan","wajhi",180],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["وَأَقَامُوا۟","dan mereka mendirikan","wa-aqāmū",232],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",147],["وَأَنفَقُوا۟","dan mereka menafkahkan","wa-anfaqū",193],["مِمَّا","dari sebagian apa","mimmā",1],["رَزَقْنَـٰهُمْ","Kami beri rezki mereka","razaqnāhum",208],["سِرًّۭا","sembunyi","sirran",815],["وَعَلَانِيَةًۭ","dan terang-terangan","waʿalāniyatan",1514],["وَيَدْرَءُونَ","dan mereka menolak","wayadraūna",1568],["بِٱلْحَسَنَةِ","dengan kebaikan","bil-ḥasanati",377],["ٱلسَّيِّئَةَ","kejahatan","l-sayi-ata",217],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["لَهُمْ","bagi mereka","lahum",16],["عُقْبَى","kesudahan","ʿuq'bā",1167],["ٱلدَّارِ","tempat","l-dāri",261]],"t":"Dan orang yang sabar karena mengharap keridaan Tuhannya, melaksanakan salat, dan menginfakkan sebagian rezeki yang Kami berikan kepada mereka, secara sembunyi atau terang-terangan serta menolak kejahatan dengan kebaikan; orang itulah yang mendapat tempat kesudahan (yang baik),"},{"n":23,"w":[["جَنَّـٰتُ","sorga","jannātu",86],["عَدْنٍۢ","'Aden","ʿadnin",781],["يَدْخُلُونَهَا","masuk kedalamnya","yadkhulūnahā",165],["وَمَن","dan orang","waman",17],["صَلَحَ","berbuat baik/saleh","ṣalaḥa",2301],["مِنْ","dari","min",1],["ءَابَآئِهِمْ","bapak-bapak mereka","ābāihim",116],["وَأَزْوَٰجِهِمْ","dan isteri-isteri mereka","wa-azwājihim",166],["وَذُرِّيَّـٰتِهِمْ ۖ","dan anak cucu mereka","wadhurriyyātihim",365],["وَٱلْمَلَـٰٓئِكَةُ","dan para malaikat","wal-malāikatu",137],["يَدْخُلُونَ","mereka masuk","yadkhulūna",165],["عَلَيْهِم","atas mereka","ʿalayhim",11],["مِّن","dari","min",1],["كُلِّ","tiap-tiap/semua","kulli",38],["بَابٍۢ","pintu-pintu","bābin",414]],"t":"(yaitu) surga-surga 'Ādn, mereka masuk ke dalamnya bersama dengan orang yang saleh dari nenek moyangnya, pasangan-pasangannya dan anak cucunya, sedangkan para malaikat masuk ke tempat-tempat mereka dari semua pintu;"},{"n":24,"w":[["سَلَـٰمٌ","keselamatan","salāmun",294],["عَلَيْكُم","atas kalian","ʿalaykum",11],["بِمَا","dengan apa/sebab","bimā",6],["صَبَرْتُمْ ۚ","kesabaranmu","ṣabartum",215],["فَنِعْمَ","maka alangkah nikmatnya/baiknya","faniʿ'ma",566],["عُقْبَى","kesudahan","ʿuq'bā",1167],["ٱلدَّارِ","tempat","l-dāri",261]],"t":"(sambil mengucapkan), \"Selamat sejahtera atasmu karena kesabaranmu.\" Maka alangkah nikmatnya tempat kesudahan itu."},{"n":25,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["يَنقُضُونَ","(mereka)merusak","yanquḍūna",1227],["عَهْدَ","janji","ʿahda",391],["ٱللَّهِ","Allah","l-lahi",4],["مِنۢ","dari","min",1],["بَعْدِ","sesudah","baʿdi",67],["مِيثَـٰقِهِۦ","diikrarkan dengan teguh","mīthāqihi",443],["وَيَقْطَعُونَ","dan mereka memutuskan","wayaqṭaʿūna",756],["مَآ","apa","mā",6],["أَمَرَ","yang diperintahkan","amara",161],["ٱللَّهُ","Allah","l-lahu",4],["بِهِۦٓ","dengannya","bihi",21],["أَن","supaya","an",22],["يُوصَلَ","dihubungkan","yūṣala",878],["وَيُفْسِدُونَ","dan mereka membuat kerusakan","wayuf'sidūna",628],["فِى","di","fī",7],["ٱلْأَرْضِ ۙ","bumi","l-arḍi",28],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",65],["لَهُمُ","bagi  mereka","lahumu",16],["ٱللَّعْنَةُ","kutukan","l-laʿnatu",677],["وَلَهُمْ","dan bagi mereka","walahum",16],["سُوٓءُ","seburuk-buruk","sūu",251],["ٱلدَّارِ","tempat/kediaman","l-dāri",261]],"t":"Dan orang-orang yang melanggar janji Allah setelah diikrarkannya, dan memutuskan apa yang Allah perintahkan agar disambung dan berbuat kerusakan di bumi; mereka itu memperoleh kutukan dan tempat kediaman yang buruk (Jahanam)."},{"n":26,"w":[["ٱللَّهُ","Allah","al-lahu",4],["يَبْسُطُ","melapangkan/meluaskan","yabsuṭu",604],["ٱلرِّزْقَ","rezki","l-riz'qa",231],["لِمَن","bagi siapa","liman",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيَقْدِرُ ۚ","dan Dia menyempitkan","wayaqdiru",444],["وَفَرِحُوا۟","dan mereka bergembira","wafariḥū",606],["بِٱلْحَيَوٰةِ","dengan kehidupan","bil-ḥayati",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["وَمَا","dan/padahal","wamā",6],["ٱلْحَيَوٰةُ","kehidupan","l-ḥayatu",164],["ٱلدُّنْيَا","dunia","l-dun'yā",114],["فِى","dalam","fī",7],["ٱلْـَٔاخِرَةِ","kehidupan akhirat","l-ākhirati",82],["إِلَّا","hanyalah","illā",20],["مَتَـٰعٌۭ","kesenangan","matāʿun",347]],"t":"Allah melapangkan rezeki bagi siapa yang Dia kehendaki dan membatasi (bagi siapa yang Dia kehendaki). Mereka bergembira dengan kehidupan dunia, padahal kehidupan dunia hanyalah kesenangan (yang sedikit) dibanding kehidupan akhirat."},{"n":27,"w":[["وَيَقُولُ","dan berkata","wayaqūlu",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لَوْلَآ","mengapa tidak","lawlā",167],["أُنزِلَ","diturunkan","unzila",71],["عَلَيْهِ","atasnya","ʿalayhi",11],["ءَايَةٌۭ","suatu ayat","āyatun",34],["مِّن","dari","min",1],["رَّبِّهِۦ ۗ","Tuhannya","rabbihi",15],["قُلْ","katakanlah","qul",10],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["يُضِلُّ","Dia menyesatkan","yuḍillu",199],["مَن","siapa","man",17],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيَهْدِىٓ","dan Dia memberi petunjuk","wayahdī",89],["إِلَيْهِ","kepadaNya","ilayhi",18],["مَنْ","siapa","man",17],["أَنَابَ","berbuat/kembali","anāba",777]],"t":"Dan orang-orang kafir berkata, \"Mengapa tidak diturunkan kepadanya (Muhammad) tanda (mukjizat) dari Tuhannya?\" Katakanlah (Muhammad), \"Sesungguhnya Allah menyesatkan siapa yang Dia kehendaki dan memberi petunjuk orang yang bertobat kepada-Nya,\""},{"n":28,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","(mereka)beriman","āmanū",23],["وَتَطْمَئِنُّ","dan menjadi tenteram","wataṭma-innu",959],["قُلُوبُهُم","hati mereka","qulūbuhum",98],["بِذِكْرِ","dengan mengingat","bidhik'ri",163],["ٱللَّهِ ۗ","Allah","l-lahi",4],["أَلَا","ingatlah","alā",317],["بِذِكْرِ","dengan mengingat","bidhik'ri",163],["ٱللَّهِ","Allah","l-lahi",4],["تَطْمَئِنُّ","menjadi tenteram","taṭma-innu",959],["ٱلْقُلُوبُ","hati","l-qulūbu",98]],"t":"(yaitu) orang-orang yang beriman dan hati mereka menjadi tenteram dengan mengingat Allah. Ingatlah, hanya dengan mengingat Allah hati menjadi tenteram."},{"n":29,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوا۟","beriman","āmanū",23],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",52],["ٱلصَّـٰلِحَـٰتِ","kebajikan/saleh","l-ṣāliḥāti",104],["طُوبَىٰ","kebahagiaan","ṭūbā",3313],["لَهُمْ","bagi mereka","lahum",16],["وَحُسْنُ","dan baik","waḥus'nu",693],["مَـَٔابٍۢ","tempat kembali","maābin",929]],"t":"Orang-orang yang beriman dan mengerjakan kebajikan, mereka mendapat kebahagiaan dan tempat kembali yang baik."},{"n":30,"w":[["كَذَٰلِكَ","demikianlah","kadhālika",26],["أَرْسَلْنَـٰكَ","Kami telah mengutus kamu","arsalnāka",100],["فِىٓ","pada","fī",7],["أُمَّةٍۢ","suatu umat","ummatin",202],["قَدْ","sungguh","qad",30],["خَلَتْ","telah berlalu","khalat",445],["مِن","dari","min",1],["قَبْلِهَآ","sebelumnya","qablihā",59],["أُمَمٌۭ","beberapa umat","umamun",202],["لِّتَتْلُوَا۟","supaya kamu membacakan","litatluwā",209],["عَلَيْهِمُ","atas mereka","ʿalayhimu",11],["ٱلَّذِىٓ","yang","alladhī",45],["أَوْحَيْنَآ","Kami wahyukan","awḥaynā",179],["إِلَيْكَ","kepadamu","ilayka",18],["وَهُمْ","dan/padahal mereka","wahum",16],["يَكْفُرُونَ","mereka kafir","yakfurūna",48],["بِٱلرَّحْمَـٰنِ ۚ","dengan yang Maha Pengasih","bil-raḥmāni",224],["قُلْ","katakanlah","qul",10],["هُوَ","Dia","huwa",25],["رَبِّى","Tuhanku","rabbī",15],["لَآ","tidak ada","lā",8],["إِلَـٰهَ","Tuhan","ilāha",84],["إِلَّا","selain","illā",20],["هُوَ","Dia","huwa",25],["عَلَيْهِ","kepadaNya","ʿalayhi",11],["تَوَكَّلْتُ","aku bertawakkal","tawakkaltu",309],["وَإِلَيْهِ","dan kepadaNya","wa-ilayhi",18],["مَتَابِ","bertaubat","matābi",2492]],"t":"Demikianlah, Kami telah mengutus engkau (Muhammad) kepada suatu umat yang sungguh sebelumnya telah berlalu beberapa umat, agar engkau bacakan kepada mereka (Alquran) yang Kami wahyukan kepadamu, padahal mereka ingkar kepada Tuhan Yang Maha Pengasih. Katakanlah, \"Dia Tuhanku, tidak ada tuhan selain Dia; hanya kepada-Nya aku bertawakal dan hanya kepada-Nya aku bertobat.\""},{"n":31,"w":[["وَلَوْ","dan jika","walaw",66],["أَنَّ","sekiranya","anna",36],["قُرْءَانًۭا","suatu bacaan","qur'ānan",189],["سُيِّرَتْ","digoncangkan","suyyirat",1425],["بِهِ","dengannya","bihi",21],["ٱلْجِبَالُ","gunung-gunung","l-jibālu",320],["أَوْ","atau","aw",50],["قُطِّعَتْ","dipotong/terbelah","quṭṭiʿat",757],["بِهِ","dengannya","bihi",21],["ٱلْأَرْضُ","bumi","l-arḍu",28],["أَوْ","atau","aw",50],["كُلِّمَ","dapat berbicara","kullima",526],["بِهِ","dengannya","bihi",21],["ٱلْمَوْتَىٰ ۗ","orang-orang yang  mati","l-mawtā",327],["بَل","bahkan","bal",105],["لِّلَّهِ","kepunyaan Allah","lillahi",4],["ٱلْأَمْرُ","perkara/urusan","l-amru",75],["جَمِيعًا ۗ","semuanya","jamīʿan",236],["أَفَلَمْ","tidakkah","afalam",39],["يَا۟يْـَٔسِ","mengetahui","yāy'asi",1031],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ءَامَنُوٓا۟","(mereka)beriman","āmanū",23],["أَن","bahwa","an",22],["لَّوْ","seandainya","law",66],["يَشَآءُ","menghendaki","yashāu",62],["ٱللَّهُ","Allah","l-lahu",4],["لَهَدَى","tentu Dia memberi petunjuk","lahadā",89],["ٱلنَّاسَ","manusia","l-nāsa",60],["جَمِيعًۭا ۗ","semuanya","jamīʿan",236],["وَلَا","dan tidaklah","walā",8],["يَزَالُ","senantiasa","yazālu",821],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["تُصِيبُهُم","menimpa mereka","tuṣībuhum",201],["بِمَا","dengan sebab","bimā",6],["صَنَعُوا۟","mereka perbuat","ṣanaʿū",636],["قَارِعَةٌ","bencana","qāriʿatun",1412],["أَوْ","atau","aw",50],["تَحُلُّ","(ia)terjadi","taḥullu",668],["قَرِيبًۭا","dekat","qarīban",429],["مِّن","dari","min",1],["دَارِهِمْ","tempat kediaman mereka","dārihim",261],["حَتَّىٰ","sehingga","ḥattā",91],["يَأْتِىَ","datang","yatiya",56],["وَعْدُ","janji","waʿdu",258],["ٱللَّهِ ۚ","Allah","l-lahi",4],["إِنَّ","sesungguhnya","inna",9],["ٱللَّهَ","Allah","l-laha",4],["لَا","tidak","lā",8],["يُخْلِفُ","menyalahi","yukh'lifu",662],["ٱلْمِيعَادَ","janji","l-mīʿāda",1222]],"t":"Dan sekiranya ada suatu bacaan (Kitab Suci) yang dengan itu gunung-gunung dapat digoncangkan, atau bumi jadi terbelah, atau orang yang sudah mati dapat berbicara, (itulah Alquran). Sebenarnya segala urusan itu milik Allah. Maka tidakkah orang-orang yang beriman mengetahui bahwa sekiranya Allah menghendaki (semua manusia beriman), tentu Allah memberi petunjuk kepada manusia semuanya. Dan orang-orang kafir senantiasa ditimpa bencana disebabkan perbuatan mereka sendiri atau bencana itu terjadi dekat tempat kediaman mereka, sampai datang janji Allah (penaklukan Mekkah). Sungguh, Allah tidak menyalahi janji."},{"n":32,"w":[["وَلَقَدِ","dan sesungguhnya","walaqadi",30],["ٱسْتُهْزِئَ","telah memperolok-olok","us'tuh'zi-a",511],["بِرُسُلٍۢ","beberapa Rasul","birusulin",42],["مِّن","dari","min",1],["قَبْلِكَ","sebelum kamu","qablika",59],["فَأَمْلَيْتُ","maka Aku memberi tangguh","fa-amlaytu",891],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["ثُمَّ","kemudian","thumma",41],["أَخَذْتُهُمْ ۖ","Aku binasakan mereka","akhadhtuhum",103],["فَكَيْفَ","maka bagaimana","fakayfa",148],["كَانَ","adalah","kāna",12],["عِقَابِ","siksaanKu","ʿiqābi",518]],"t":"Dan sesungguhnya beberapa rasul sebelum engkau (Muhammad) telah diperolok-olokan, maka Aku beri tenggang waktu kepada orang-orang kafir itu, kemudian Aku binasakan mereka. Maka alangkah hebatnya siksaan-Ku itu!"},{"n":33,"w":[["أَفَمَنْ","apakah yang","afaman",17],["هُوَ","Dia","huwa",25],["قَآئِمٌ","tegak/menjaga","qāimun",485],["عَلَىٰ","atas/terhadap","ʿalā",11],["كُلِّ","setiap","kulli",38],["نَفْسٍۭ","diri","nafsin",47],["بِمَا","dengan apa","bimā",6],["كَسَبَتْ ۗ","ia perbuat","kasabat",206],["وَجَعَلُوا۟","dan mereka menjadikan","wajaʿalū",40],["لِلَّهِ","bagi Allah","lillahi",4],["شُرَكَآءَ","beberapa sekutu","shurakāa",304],["قُلْ","katakanlah","qul",10],["سَمُّوهُمْ ۚ","sebutkanlah mereka","sammūhum",1018],["أَمْ","atau apakah","am",93],["تُنَبِّـُٔونَهُۥ","kamu memberitahukan kepadaNya","tunabbiūnahu",270],["بِمَا","dengan apa","bimā",6],["لَا","tidak","lā",8],["يَعْلَمُ","diketahui","yaʿlamu",35],["فِى","di","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["أَم","ataukah","am",93],["بِظَـٰهِرٍۢ","dengan yang lahir","biẓāhirin",843],["مِّنَ","dari","mina",1],["ٱلْقَوْلِ ۗ","perkataan","l-qawli",129],["بَلْ","bahkan","bal",105],["زُيِّنَ","dijadikan memandang baik","zuyyina",432],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["مَكْرُهُمْ","tipu daya mereka","makruhum",542],["وَصُدُّوا۟","dan mereka dihalangi","waṣuddū",3256],["عَنِ","dari","ʿani",27],["ٱلسَّبِيلِ ۗ","jalan","l-sabīli",73],["وَمَن","dan barang siapa","waman",17],["يُضْلِلِ","menyesatkan","yuḍ'lili",199],["ٱللَّهُ","Allah","l-lahu",4],["فَمَا","maka tidak","famā",6],["لَهُۥ","baginya","lahu",21],["مِنْ","dari","min",1],["هَادٍۢ","memberi petunjuk","hādin",1085]],"t":"Maka apakah Tuhan yang menjaga setiap jiwa terhadap apa yang diperbuatnya (sama dengan yang lain)? Mereka menjadikan sekutu-sekutu bagi Allah. Katakanlah, \"Sebutkanlah sifat-sifat mereka itu!\" Atau apakah kamu hendak memberitahukan kepada Allah apa yang tidak diketahui-Nya di bumi, atau (mengatakan tentang hal itu) sekedar perkataan pada lahirnya saja. Sebenarnya bagi orang kafir, tipu daya mereka itu dijadikan terasa indah, dan mereka dihalangi dari jalan (yang benar). Dan barang siapa disesatkan Allah, maka tidak ada seorang pun yang memberi petunjuk baginya."},{"n":34,"w":[["لَّهُمْ","bagi mereka","lahum",16],["عَذَابٌۭ","azab","ʿadhābun",43],["فِى","dalam","fī",7],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",164],["ٱلدُّنْيَا ۖ","dunia","l-dun'yā",114],["وَلَعَذَابُ","dan sesungguhnya azab","walaʿadhābu",43],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",82],["أَشَقُّ ۖ","lebih berat","ashaqqu",2918],["وَمَا","dan tak ada","wamā",6],["لَهُم","bagi mereka","lahum",16],["مِّنَ","dari/terhadap","mina",1],["ٱللَّهِ","Allah","l-lahi",4],["مِن","dari","min",1],["وَاقٍۢ","seorang pelindung","wāqin",2051]],"t":"Mereka mendapat siksaan dalam kehidupan dunia, dan azab akhirat pasti lebih keras. Tidak ada seorang pun yang melindungi mereka dari (azab) Allah."},{"n":35,"w":[["۞ مَّثَلُ","perumpamaan","mathalu",138],["ٱلْجَنَّةِ","sorga","l-janati",86],["ٱلَّتِى","yang","allatī",195],["وُعِدَ","dijanjikan","wuʿida",190],["ٱلْمُتَّقُونَ ۖ","orang-orang yang takwa","l-mutaqūna",257],["تَجْرِى","mengalir","tajrī",219],["مِن","dari","min",1],["تَحْتِهَا","bawahnya","taḥtihā",246],["ٱلْأَنْهَـٰرُ ۖ","sungai-sungai","l-anhāru",233],["أُكُلُهَا","buahnya","ukuluhā",1054],["دَآئِمٌۭ","kekal","dāimun",2357],["وَظِلُّهَا ۚ","dan naungannya","waẓilluhā",671],["تِلْكَ","itulah","til'ka",310],["عُقْبَى","tempat kesudahan","ʿuq'bā",1167],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["ٱتَّقَوا۟ ۖ","(mereka)bertakwa","ittaqaw",76],["وَّعُقْبَى","dan tempat kesudahan","waʿuq'bā",1167],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79],["ٱلنَّارُ","neraka","l-nāru",87]],"t":"Perumpamaan surga yang dijanjikan kepada orang yang bertakwa (ialah seperti taman), mengalir di bawahnya sungai-sungai; senantiasa berbuah dan teduh. Itulah tempat kesudahan bagi orang yang bertakwa; sedangkan tempat kesudahan bagi orang yang ingkar kepada Tuhan ialah neraka."},{"n":36,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",13],["ءَاتَيْنَـٰهُمُ","Kami berikan kepada mereka","ātaynāhumu",53],["ٱلْكِتَـٰبَ","Kitab","l-kitāba",57],["يَفْرَحُونَ","mereka bergembira","yafraḥūna",606],["بِمَآ","dengan apa","bimā",6],["أُنزِلَ","diturunkan","unzila",71],["إِلَيْكَ ۖ","kepadamu","ilayka",18],["وَمِنَ","dan dari/diantara","wamina",1],["ٱلْأَحْزَابِ","golongan","l-aḥzābi",522],["مَن","orang","man",17],["يُنكِرُ","mengingkari","yunkiru",1760],["بَعْضَهُۥ ۚ","sebagiannya","baʿḍahu",80],["قُلْ","katakanlah","qul",10],["إِنَّمَآ","sesungguhnya hanyalah","innamā",9],["أُمِرْتُ","aku diperintah","umir'tu",161],["أَنْ","untuk","an",22],["أَعْبُدَ","aku menyembah","aʿbuda",108],["ٱللَّهَ","Allah","l-laha",4],["وَلَآ","dan tidak","walā",8],["أُشْرِكَ","aku mempersekutukan","ush'rika",182],["بِهِۦٓ ۚ","dengan Dia","bihi",21],["إِلَيْهِ","kepadaNya","ilayhi",18],["أَدْعُوا۟","aku menyeru","adʿū",74],["وَإِلَيْهِ","dan kepadaNya","wa-ilayhi",18],["مَـَٔابِ","tempat kembali","maābi",929]],"t":"Dan orang yang telah Kami berikan kitab kepada mereka bergembira dengan apa (Kitab) yang diturunkan kepadamu (Muhammad), dan ada di antara golongan (Yahudi dan Nasrani), yang mengingkari sebagiannya. Katakanlah, \"Aku hanya diperintah untuk menyembah Allah dan tidak mempersekutukan-Nya. Hanya kepada-Nya aku seru (manusia) dan hanya kepada-Nya aku kembali.\""},{"n":37,"w":[["وَكَذَٰلِكَ","dan demikianlah","wakadhālika",26],["أَنزَلْنَـٰهُ","Kami telah menurunkannya","anzalnāhu",71],["حُكْمًا","hukum/peraturan","ḥuk'man",382],["عَرَبِيًّۭا ۚ","bahasa Arab","ʿarabiyyan",784],["وَلَئِنِ","dan seandainya","wala-ini",19],["ٱتَّبَعْتَ","kamu mengikuti","ittabaʿta",95],["أَهْوَآءَهُم","hawa nafsu mereka","ahwāahum",586],["بَعْدَ مَا","sesudah","baʿdamā",67],["جَآءَكَ","apa","jāaka",51],["مِنَ","datang kepadamu","mina",1],["ٱلْعِلْمِ","dari","l-ʿil'mi",121],["مَا","pengetahuan","mā",6],["لَكَ","tidak ada","laka",153],["مِنَ","bagimu","mina",1],["ٱللَّهِ","dari","l-lahi",4],["مِن","Allah","min",1],["وَلِىٍّۢ","dari","waliyyin",142],["وَلَا","seorang pelindung","walā",8],["وَاقٍۢ","dan tidak","wāqin",2051]],"t":"Dan demikianlah Kami telah menurunkannya (Alquran) sebagai peraturan (yang benar) dalam bahasa Arab. Sekiranya engkau mengikuti keinginan mereka setelah datang pengetahuan kepadamu, maka tidak ada yang melindungi dan yang menolong engkau dari (siksaan) Allah."},{"n":38,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["أَرْسَلْنَا","Kami telah mengutus","arsalnā",100],["رُسُلًۭا","beberapa Rasul","rusulan",42],["مِّن","dari","min",1],["قَبْلِكَ","sebelum kamu","qablika",59],["وَجَعَلْنَا","dan Kami jadikan/berikan","wajaʿalnā",40],["لَهُمْ","kepada mereka","lahum",16],["أَزْوَٰجًۭا","isteri-isteri","azwājan",166],["وَذُرِّيَّةًۭ ۚ","dan keturunan","wadhurriyyatan",365],["وَمَا","dan tidak","wamā",6],["كَانَ","ada","kāna",12],["لِرَسُولٍ","bagi seorang Rasul","lirasūlin",42],["أَن","akan","an",22],["يَأْتِىَ","mendatangkan","yatiya",56],["بِـَٔايَةٍ","dengan suatu ayat","biāyatin",34],["إِلَّا","melainkan","illā",20],["بِإِذْنِ","dengan izin","bi-idh'ni",316],["ٱللَّهِ ۗ","Allah","l-lahi",4],["لِكُلِّ","bagi tiap-tiap","likulli",38],["أَجَلٍۢ","masa","ajalin",238],["كِتَابٌۭ","Kitab","kitābun",57]],"t":"Dan sungguh, Kami telah mengutus beberapa rasul sebelum engkau (Muhammad) dan Kami berikan kepada mereka istri-istri dan keturunan. Tidak ada hak bagi seorang rasul mendatangkan sesuatu bukti (mukjizat) melainkan dengan izin Allah. Untuk setiap masa ada Kitab (tertentu)."},{"n":39,"w":[["يَمْحُوا۟","menghapus","yamḥū",1914],["ٱللَّهُ","Allah","l-lahu",4],["مَا","apa","mā",6],["يَشَآءُ","Dia kehendaki","yashāu",62],["وَيُثْبِتُ ۖ","dan Dia menetapkan","wayuth'bitu",2194],["وَعِندَهُۥٓ","dan disisinya","waʿindahu",68],["أُمُّ","Ummul","ummu",354],["ٱلْكِتَـٰبِ","Kitab","l-kitābi",57]],"t":"Allah menghapus dan menetapkan apa yang Dia kehendaki. Dan di sisi-Nya terdapat Ummul-Kitāb (Lauḥ Maḥfūẓ)."},{"n":40,"w":[["وَإِن","dan jika","wa-in",19],["مَّا","apa","mā",6],["نُرِيَنَّكَ","Kami perlihatkan kepadamu","nuriyannaka",305],["بَعْضَ","sebagian","baʿḍa",80],["ٱلَّذِى","yang","alladhī",45],["نَعِدُهُمْ","Kami ancamkan kepada mereka","naʿiduhum",190],["أَوْ","atau","aw",50],["نَتَوَفَّيَنَّكَ","Kami wafatkan kamu","natawaffayannaka",455],["فَإِنَّمَا","maka sesungguhnya hanyalah","fa-innamā",9],["عَلَيْكَ","atasmu/kewajiban","ʿalayka",11],["ٱلْبَلَـٰغُ","menyampaikan","l-balāghu",638],["وَعَلَيْنَا","dan atas Kami","waʿalaynā",11],["ٱلْحِسَابُ","menghisab","l-ḥisābu",319]],"t":"Dan sungguh jika Kami perlihatkan kepadamu (Muhammad) sebagian (siksaan) yang Kami ancamkan kepada mereka atau Kami wafatkan engkau, maka sesungguhnya tugasmu hanya menyampaikan saja, dan Kamilah yang memperhitungkan (amal mereka)."},{"n":41,"w":[["أَوَلَمْ","ataukah tidak / bukan","awalam",39],["يَرَوْا۟","mereka melihat","yaraw",54],["أَنَّا","bahwasanya Kami","annā",36],["نَأْتِى","Kami mendatangi","natī",56],["ٱلْأَرْضَ","bumi/daerah","l-arḍa",28],["نَنقُصُهَا","Kami menguranginya","nanquṣuhā",1107],["مِنْ","dari","min",1],["أَطْرَافِهَا ۚ","tepi-tepinya","aṭrāfihā",1333],["وَٱللَّهُ","dan Allah","wal-lahu",4],["يَحْكُمُ","menetapkan","yaḥkumu",273],["لَا","tidak","lā",8],["مُعَقِّبَ","dapat menolak","muʿaqqiba",2504],["لِحُكْمِهِۦ ۚ","bagi ketetapan hukumNya","liḥuk'mihi",382],["وَهُوَ","dan Dia","wahuwa",25],["سَرِيعُ","Maha Cepat","sarīʿu",874],["ٱلْحِسَابِ","perhitungan","l-ḥisābi",319]],"t":"Dan apakah mereka tidak melihat bahwa Kami mendatangi daerah-daerah (orang yang ingkar kepada Allah), lalu Kami kurangi (daerah-daerah) itu (sedikit demi sedikit) dari tepi-tepinya? Dan Allah menetapkan hukum (menurut kehendak-Nya), tidak ada yang dapat menolak ketetapan-Nya; Dia Mahacepat perhitungan-Nya."},{"n":42,"w":[["وَقَدْ","dan sungguh","waqad",30],["مَكَرَ","telah mengadakan tipu daya","makara",483],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["قَبْلِهِمْ","sebelum mereka","qablihim",59],["فَلِلَّهِ","maka bagi Allah","falillahi",4],["ٱلْمَكْرُ","tipu daya","l-makru",542],["جَمِيعًۭا ۖ","semuanya","jamīʿan",236],["يَعْلَمُ","Dia mengetahui","yaʿlamu",35],["مَا","apa yang","mā",6],["تَكْسِبُ","diusahakan","taksibu",206],["كُلُّ","setiap","kullu",38],["نَفْسٍۢ ۗ","diri","nafsin",47],["وَسَيَعْلَمُ","dan akan mengetahui","wasayaʿlamu",35],["ٱلْكُفَّـٰرُ","orang-orang","l-kufāru",79],["لِمَنْ","untuk siapa","liman",17],["عُقْبَى","kesudahan","ʿuq'bā",1167],["ٱلدَّارِ","tempat","l-dāri",261]],"t":"Dan sungguh orang sebelum mereka (kafir Mekkah) telah mengadakan tipu daya, tetapi semua tipu daya itu dalam kekuasaan Allah. Dia mengetahui apa yang diusahakan oleh setiap orang, dan orang yang ingkar kepada Tuhan akan mengetahui untuk siapa tempat kesudahan (yang baik)."},{"n":43,"w":[["وَيَقُولُ","dan berkata","wayaqūlu",10],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لَسْتَ","kamu bukan","lasta",133],["مُرْسَلًۭا ۚ","dijadikan seorang Rasul","mur'salan",341],["قُلْ","katakanlah","qul",10],["كَفَىٰ","cukuplah","kafā",370],["بِٱللَّهِ","dengan Allah","bil-lahi",4],["شَهِيدًۢا","menjadi saksi","shahīdan",226],["بَيْنِى","antara aku","baynī",55],["وَبَيْنَكُمْ","dan antara kamu","wabaynakum",55],["وَمَنْ","dan orang","waman",17],["عِندَهُۥ","disisinya/mempunyai","ʿindahu",68],["عِلْمُ","ilmu","ʿil'mu",121],["ٱلْكِتَـٰبِ","Al Kitab","l-kitābi",57]],"t":"Dan orang-orang kafir berkata, \"Engkau (Muhammad) bukanlah seorang Rasul.\" Katakanlah, \"Cukuplah Allah dan orang yang menguasai ilmu Al-Kitab menjadi saksi antara aku dan kamu.\""}]