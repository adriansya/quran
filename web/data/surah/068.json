[{"n":1,"w":[["نٓ ۚ","Nun","noon",3231],["وَٱلْقَلَمِ","demi qalam","wal-qalami",1648],["وَمَا","dan apa","wamā",6],["يَسْطُرُونَ","mereka tulis","yasṭurūna",4250]],"t":"Nūn. Demi pena dan apa yang mereka tuliskan,"},{"n":2,"w":[["مَآ","tidakkah","mā",6],["أَنتَ","kamu","anta",154],["بِنِعْمَةِ","dengan ni'mat","biniʿ'mati",250],["رَبِّكَ","Tuhanmu","rabbika",15],["بِمَجْنُونٍۢ","orang gila","bimajnūnin",801]],"t":"dengan karunia Tuhanmu engkau (Muhammad) bukanlah orang gila."},{"n":3,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",9],["لَكَ","bagimu","laka",153],["لَأَجْرًا","benar-benar pahala","la-ajran",121],["غَيْرَ","bukan/tidak","ghayra",85],["مَمْنُونٍۢ","terputus-putus","mamnūnin",1605]],"t":"Dan sesungguhnya engkau pasti mendapat pahala yang besar yang tidak putus-putusnya."},{"n":4,"w":[["وَإِنَّكَ","dan sesungguhnya kamu","wa-innaka",9],["لَعَلَىٰ","benar-benar di atas","laʿalā",11],["خُلُقٍ","budi pekerti","khuluqin",2775],["عَظِيمٍۢ","luhur/agung","ʿaẓīmin",118]],"t":"Dan sesungguhnya engkau benar-benar, berbudi pekerti yang luhur."},{"n":5,"w":[["فَسَتُبْصِرُ","maka kelak kamu akan melihat","fasatub'ṣiru",390],["وَيُبْصِرُونَ","dan mereka akan melihat","wayub'ṣirūna",390]],"t":"Maka kelak engkau akan melihat dan mereka (orang-orang kafir) pun akan melihat,"},{"n":6,"w":[["بِأَييِّكُمُ","siapa diantara kamu","bi-ayyikumu",210],["ٱلْمَفْتُونُ","yang di uji/gila","l-maftūnu",3703]],"t":"siapa diantara kamu yang gila?"},{"n":7,"w":[["إِنَّ","sesungguhnya","inna",9],["رَبَّكَ","Tuhanmu","rabbaka",15],["هُوَ","Dia","huwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِمَن","pada siapa","biman",17],["ضَلَّ","ia sesat","ḍalla",235],["عَن","dari","ʿan",27],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",73],["وَهُوَ","dan Dia","wahuwa",25],["أَعْلَمُ","lebih mengetahui","aʿlamu",252],["بِٱلْمُهْتَدِينَ","terhadap orang-orang yang mendapat petunjuk","bil-muh'tadīna",527]],"t":"Sungguh, Tuhanmu, Dialah yang paling mengetahui siapa yang sesat dari jalan-Nya; dan Dialah yang paling mengetahui siapa orang yang mendapat petunjuk."},{"n":8,"w":[["فَلَا","maka jangan","falā",8],["تُطِعِ","kamu taati","tuṭiʿi",177],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",504]],"t":"Maka janganlah engkau patuhi orang-orang yang mendustakan (ayat-ayat Allah)."},{"n":9,"w":[["وَدُّوا۟","mereka menginginkan","waddū",596],["لَوْ","sekiranya/supaya","law",66],["تُدْهِنُ","kamu bersikap lemah lembut","tud'hinu",2162],["فَيُدْهِنُونَ","maka mereka akan bersikap lemah lembut","fayud'hinūna",2162]],"t":"Mereka menginginkan agar engkau bersikap lunak maka mereka bersikap lunak (pula)."},{"n":10,"w":[["وَلَا","dan jangan","walā",8],["تُطِعْ","kamu taati","tuṭiʿ",177],["كُلَّ","setiap","kulla",38],["حَلَّافٍۢ","banyak bersumpah","ḥallāfin",3180],["مَّهِينٍ","yang hina","mahīnin",1624]],"t":"Dan janganlah engkau patuhi setiap orang yang suka bersumpah dan suka menghina,"},{"n":11,"w":[["هَمَّازٍۢ","pencela","hammāzin",3530],["مَّشَّآءٍۭ","berjalan","mashāin",3919],["بِنَمِيمٍۢ","dengan fitnah","binamīmin",4048]],"t":"suka mencela, yang kian ke mari menyebarkan fitnah,"},{"n":12,"w":[["مَّنَّاعٍۢ","menghalangi","mannāʿin",2544],["لِّلْخَيْرِ","bagi kebaikan","lil'khayri",69],["مُعْتَدٍ","melampaui batas","muʿ'tadin",931],["أَثِيمٍ","dosa","athīmin",1053]],"t":"yang merintangi segala yang baik, yang melampaui batas dan banyak dosa,"},{"n":13,"w":[["عُتُلٍّۭ","kaku kasar","ʿutullin",3150],["بَعْدَ","sesudah","baʿda",67],["ذَٰلِكَ","demikian itu","dhālika",26],["زَنِيمٍ","terkenal jahat","zanīmin",4592]],"t":"yang bertabiat kasar, selain itu juga terkenal kejahatannya,"},{"n":14,"w":[["أَن","karena","an",22],["كَانَ","dia adalah","kāna",12],["ذَا","mempunyai","dhā",112],["مَالٍۢ","harta","mālin",141],["وَبَنِينَ","dan anak-anak","wabanīna",90]],"t":"karena dia kaya dan banyak anak."},{"n":15,"w":[["إِذَا","apabila","idhā",29],["تُتْلَىٰ","dibacakan","tut'lā",209],["عَلَيْهِ","kepadanya","ʿalayhi",11],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",34],["قَالَ","dia berkata","qāla",10],["أَسَـٰطِيرُ","dongeng-dongeng","asāṭīru",895],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",151]],"t":"Apabila ayat-ayat Kami dibacakan kepadanya, dia berkata, \"(Ini adalah) dongeng-dongeng orang dahulu.\""},{"n":16,"w":[["سَنَسِمُهُۥ","kelak akan Kami beri tanda dia","sanasimuhu",4501],["عَلَى","atas","ʿalā",11],["ٱلْخُرْطُومِ","belalai","l-khur'ṭūmi",4568]],"t":"Kelak dia akan Kami beri tanda pada belalai(nya)."},{"n":17,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["بَلَوْنَـٰهُمْ","Kami telah menguji mereka","balawnāhum",523],["كَمَا","sebagaimana","kamā",6],["بَلَوْنَآ","Kami telah menguji","balawnā",523],["أَصْحَـٰبَ","penghuni/pemilik","aṣḥāba",132],["ٱلْجَنَّةِ","surga","l-janati",86],["إِذْ","ketika","idh",61],["أَقْسَمُوا۟","mereka bersumpah","aqsamū",515],["لَيَصْرِمُنَّهَا","sungguh mereka akan mematikannya","layaṣrimunnahā",3265],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1389]],"t":"Sungguh, Kami telah menguji mereka (orang musyrik Mekkah) sebagaimana Kami telah menguji pemilik-pemilik kebun, ketika mereka bersumpah pasti akan memetik (hasil)nya pada pagi hari,"},{"n":18,"w":[["وَلَا","dan tidak","walā",8],["يَسْتَثْنُونَ","mereka menyisihkan","yastathnūna",4679]],"t":"tetapi mereka tidak mengecualikan (dengan mengucapkan, \"Insya Allah\")."},{"n":19,"w":[["فَطَافَ","maka mengepung","faṭāfa",981],["عَلَيْهَا","atasnya (kebun itu)","ʿalayhā",11],["طَآئِفٌۭ","kepungan (malapetaka)","ṭāifun",1547],["مِّن","dari","min",1],["رَّبِّكَ","Tuhanmu","rabbika",15],["وَهُمْ","dan mereka","wahum",16],["نَآئِمُونَ","orang-orang yang tidur","nāimūna",2564]],"t":"Lalu kebun itu ditimpa bencana (yang datang) dari Tuhanmu ketika mereka sedang tidur."},{"n":20,"w":[["فَأَصْبَحَتْ","maka jadilah ia/kebun itu","fa-aṣbaḥat",398],["كَٱلصَّرِيمِ","seperti sudah di potong/petik","kal-ṣarīmi",3289]],"t":"Maka jadilah kebun itu hitam seperti malam yang gelap gulita,"},{"n":21,"w":[["فَتَنَادَوْا۟","maka mereka panggil memanggil","fatanādaw",4389],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1389]],"t":"lalu pada pagi hari mereka saling memanggil."},{"n":22,"w":[["أَنِ","sesungguhnya","ani",22],["ٱغْدُوا۟","pergi diwaktu pagi","igh'dū",1867],["عَلَىٰ","atas","ʿalā",11],["حَرْثِكُمْ","kebunmu","ḥarthikum",692],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["صَـٰرِمِينَ","orang-orang yang memotong/memetik","ṣārimīna",3245]],"t":"\"Pergilah pagi-pagi ke kebunmu jika kamu hendak memetik hasil.\""},{"n":23,"w":[["فَٱنطَلَقُوا۟","maka mereka berjalan/pergi","fa-inṭalaqū",961],["وَهُمْ","dan mereka","wahum",16],["يَتَخَـٰفَتُونَ","mereka saling berbisik","yatakhāfatūna",2711]],"t":"Maka mereka pun berangkat sambil berbisik-bisik."},{"n":24,"w":[["أَن","bahwa","an",22],["لَّا","jangan","lā",8],["يَدْخُلَنَّهَا","sekali-kali memasukinya","yadkhulannahā",165],["ٱلْيَوْمَ","hari ini","l-yawma",31],["عَلَيْكُم","atas kalian","ʿalaykum",11],["مِّسْكِينٌۭ","seorang miskin","mis'kīnun",467]],"t":"\"Pada hari ini jangan sampai ada orang miskin masuk ke dalam kebunmu.\""},{"n":25,"w":[["وَغَدَوْا۟","dan mereka pergi pagi-pagi","waghadaw",1867],["عَلَىٰ","atas","ʿalā",11],["حَرْدٍۢ","mencegah/menghalangi","ḥardin",3194],["قَـٰدِرِينَ","orang-orang yang mampu","qādirīna",683]],"t":"Dan berangkatlah mereka di pagi hari dengan niat menghalangi (orang-orang miskin) padahal mereka mampu (menolongnya)."},{"n":26,"w":[["فَلَمَّا","maka tatkala","falammā",81],["رَأَوْهَا","mereka melihatnya","ra-awhā",54],["قَالُوٓا۟","mereka berkata","qālū",10],["إِنَّا","sesungguhnya Kami","innā",9],["لَضَآلُّونَ","benar-benar orang-orang yang sesat","laḍāllūna",664]],"t":"Maka ketika mereka melihat kebun itu, mereka berkata, \"Sungguh, kita ini benar-benar orang-orang yang sesat,"},{"n":27,"w":[["بَلْ","bahkan","bal",105],["نَحْنُ","kami","naḥnu",140],["مَحْرُومُونَ","orang-orang yang menghalangi","maḥrūmūna",1601]],"t":"bahkan kita tak memperoleh apa pun.\""},{"n":28,"w":[["قَالَ","berkata","qāla",10],["أَوْسَطُهُمْ","paling baik antara mereka","awsaṭuhum",2199],["أَلَمْ","tidakkah","alam",39],["أَقُل","aku katakan","aqul",10],["لَّكُمْ","bagi kalian","lakum",32],["لَوْلَا","mengapa tidak","lawlā",167],["تُسَبِّحُونَ","kamu bertasbih","tusabbiḥūna",293]],"t":"Berkatalah seorang yang paling bijak di antara mereka, \"Bukankah aku telah mengatakan kepadamu, mengapa kamu tidak bertasbih (kepada Tuhanmu).\""},{"n":29,"w":[["قَالُوا۟","mereka berkata","qālū",10],["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",303],["رَبِّنَآ","Tuhan Kami","rabbinā",15],["إِنَّا","sesungguhnya Kami","innā",9],["كُنَّا","adalah Kami","kunnā",12],["ظَـٰلِمِينَ","orang-orang yang zalim","ẓālimīna",97]],"t":"Mereka mengucapkan, \"Mahasuci Tuhan kami, sungguh, kami adalah orang-orang yang zalim.\""},{"n":30,"w":[["فَأَقْبَلَ","maka berhadapan","fa-aqbala",892],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",80],["عَلَىٰ","atas","ʿalā",11],["بَعْضٍۢ","sebagian","baʿḍin",80],["يَتَلَـٰوَمُونَ","mereka saling cela mencela","yatalāwamūna",4377]],"t":"Lalu mereka saling berhadapan dan saling menyalahkan."},{"n":31,"w":[["قَالُوا۟","mereka berkata","qālū",10],["يَـٰوَيْلَنَآ","betapa celakanya kami","yāwaylanā",311],["إِنَّا","sesungguhnya kami","innā",9],["كُنَّا","adalah kami","kunnā",12],["طَـٰغِينَ","orang-orang yang melampaui batas","ṭāghīna",1175]],"t":"Mereka berkata, \"Celaka kita! Sesungguhnya kita orang-orang yang melampaui batas."},{"n":32,"w":[["عَسَىٰ","mudah-mudahan","ʿasā",381],["رَبُّنَآ","Tuhan kami","rabbunā",15],["أَن","akan","an",22],["يُبْدِلَنَا","mengganti kami","yub'dilanā",1747],["خَيْرًۭا","lebih baik","khayran",69],["مِّنْهَآ","daripadanya","min'hā",1],["إِنَّآ","sesungguhnya kami","innā",9],["إِلَىٰ","kepada","ilā",18],["رَبِّنَا","Tuhan kami","rabbinā",15],["رَٰغِبُونَ","orang-orang yang mengharap","rāghibūna",1998]],"t":"Mudah-mudahan Tuhan memberikan ganti kepada kita dengan (kebun) yang lebih baik daripada yang ini, sungguh, kita mengharapkan ampunan dari Tuhan kita."},{"n":33,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",26],["ٱلْعَذَابُ ۖ","siksaan/azab","l-ʿadhābu",43],["وَلَعَذَابُ","dan sungguh siksaan/azab","walaʿadhābu",43],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",82],["أَكْبَرُ ۚ","lebih besar","akbaru",447],["لَوْ","jika","law",66],["كَانُوا۟","adalah mereka","kānū",12],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Seperti itulah azab (di dunia). Dan sungguh, azab akhirat lebih besar sekiranya mereka mengetahui."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",9],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",257],["عِندَ","di sisi","ʿinda",68],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["جَنَّـٰتِ","surga","jannāti",86],["ٱلنَّعِيمِ","kenikmatan","l-naʿīmi",588]],"t":"Sungguh, bagi orang-orang yang bertakwa (disediakan) surga yang penuh kenikmatan di sisi Tuhannya."},{"n":35,"w":[["أَفَنَجْعَلُ","maka apakah Kami menjadikan","afanajʿalu",40],["ٱلْمُسْلِمِينَ","orang-orang Islam","l-mus'limīna",292],["كَٱلْمُجْرِمِينَ","seperti orang-orang berdosa","kal-muj'rimīna",240]],"t":"Apakah patut Kami memperlakukan orang-orang Islam itu seperti orang-orang yang berdosa (orang kafir)?"},{"n":36,"w":[["مَا","mengapa","mā",6],["لَكُمْ","bagi kalian","lakum",32],["كَيْفَ","bagaimana","kayfa",148],["تَحْكُمُونَ","kamu mengambil keputusan","taḥkumūna",273]],"t":"Mengapa kamu (berbuat demikian)? Bagaimana kamu mengambil keputusan?"},{"n":37,"w":[["أَمْ","atau","am",93],["لَكُمْ","bagi kalian","lakum",32],["كِتَـٰبٌۭ","kitab","kitābun",57],["فِيهِ","di dalamnya","fīhi",7],["تَدْرُسُونَ","kamu mempelajari","tadrusūna",1347]],"t":"Atau apakah kamu mempunyai kitab (yang diturunkan Allah) yang kamu pelajari?"},{"n":38,"w":[["إِنَّ","sesungguhnya","inna",9],["لَكُمْ","bagi kalian","lakum",32],["فِيهِ","di dalamnya","fīhi",7],["لَمَا","untuk apa-apa","lamā",6],["تَخَيَّرُونَ","kamu memilih","takhayyarūna",2712]],"t":"sesungguhnya kamu dapat memilih apa saja yang ada di dalamnya."},{"n":39,"w":[["أَمْ","atau","am",93],["لَكُمْ","bagi kalian","lakum",32],["أَيْمَـٰنٌ","sumpah/perjanjian","aymānun",198],["عَلَيْنَا","atas Kami","ʿalaynā",11],["بَـٰلِغَةٌ","teguh","bālighatun",915],["إِلَىٰ","sampai","ilā",18],["يَوْمِ","hari","yawmi",31],["ٱلْقِيَـٰمَةِ ۙ","kiamat","l-qiyāmati",188],["إِنَّ","sesungguhnya","inna",9],["لَكُمْ","bagi kalian","lakum",32],["لَمَا","terhadap apa","lamā",6],["تَحْكُمُونَ","kamu putuskan","taḥkumūna",273]],"t":"Atau apakah kamu memperoleh (janji-janji yang diperkuat dengan) sumpah dari Kami, yang tetap berlaku sampai hari Kiamat; bahwa kamu dapat mengambil keputusan (sekehendakmu)?"},{"n":40,"w":[["سَلْهُمْ","tanyakan pada mereka","salhum",119],["أَيُّهُم","siapa di antara mereka","ayyuhum",210],["بِذَٰلِكَ","terhadap demikian itu","bidhālika",26],["زَعِيمٌ","bertanggung jawab","zaʿīmun",2782]],"t":"Tanyakanlah kepada mereka, \"Siapakah di antara mereka yang bertanggung jawab terhadap (keputusan yang diambil itu)?\""},{"n":41,"w":[["أَمْ","atau","am",93],["لَهُمْ","bagi mereka","lahum",16],["شُرَكَآءُ","sekutu-sekutu","shurakāu",304],["فَلْيَأْتُوا۟","maka hendaklah mereka mendatangkan","falyatū",56],["بِشُرَكَآئِهِمْ","dengan sekutu-sekutu mereka","bishurakāihim",304],["إِن","jika","in",19],["كَانُوا۟","mereka adalah","kānū",12],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",211]],"t":"Atau apakah mereka mempunyai sekutu-sekutu? Kalau begitu hendaklah mereka mendatangkan sekutu-sekutunya jika mereka orang-orang yang benar."},{"n":42,"w":[["يَوْمَ","pada hari","yawma",31],["يُكْشَفُ","di buka/di singkap","yuk'shafu",675],["عَن","dari","ʿan",27],["سَاقٍۢ","betis","sāqin",1662],["وَيُدْعَوْنَ","dan mereka di seru/di panggil","wayud'ʿawna",74],["إِلَى","kepada/untuk","ilā",18],["ٱلسُّجُودِ","bersujud","l-sujūdi",1249],["فَلَا","maka tidak","falā",8],["يَسْتَطِيعُونَ","mereka mampu/kuasa","yastaṭīʿūna",296]],"t":"(Ingatlah) pada hari ketika betis disingkapkan dan mereka diseru untuk bersujud; maka mereka tidak mampu,"},{"n":43,"w":[["خَـٰشِعَةً","tertunduk","khāshiʿatan",685],["أَبْصَـٰرُهُمْ","pandangan mereka","abṣāruhum",260],["تَرْهَقُهُمْ","menimpa mereka","tarhaquhum",1417],["ذِلَّةٌۭ ۖ","kehinaan","dhillatun",1042],["وَقَدْ","dan sesungguhnya","waqad",30],["كَانُوا۟","adalah mereka","kānū",12],["يُدْعَوْنَ","mereka di seru/di panggil","yud'ʿawna",74],["إِلَى","kepada/untuk","ilā",18],["ٱلسُّجُودِ","bersujud","l-sujūdi",1249],["وَهُمْ","dan/sedang mereka","wahum",16],["سَـٰلِمُونَ","orang-orang sejahtera","sālimūna",4252]],"t":"pandangan mereka tertunduk ke bawah, diliputi kehinaan. Dan sungguh, dahulu (di dunia) mereka telah diseru untuk bersujud waktu mereka sehat (tetapi mereka tidak melakukan)."},{"n":44,"w":[["فَذَرْنِى","maka biarkan Aku","fadharnī",276],["وَمَن","dan orang","waman",17],["يُكَذِّبُ","ia mendustakan","yukadhibu",72],["بِهَـٰذَا","dengan ini","bihādhā",64],["ٱلْحَدِيثِ ۖ","cerita/perkataan","l-ḥadīthi",402],["سَنَسْتَدْرِجُهُم","kelak Kami menarik mereka berangsur-angsur","sanastadrijuhum",2812],["مِّنْ","dari","min",1],["حَيْثُ","sekira/secara","ḥaythu",393],["لَا","tidak","lā",8],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",35]],"t":"Maka serahkanlah kepada-Ku (urusannya) dan orang-orang yang mendustakan perkataan ini (Alquran). Kelak akan Kami hukum mereka berangsur-angsur dari arah yang tidak mereka ketahui,"},{"n":45,"w":[["وَأُمْلِى","dan Aku beri waktu/tangguh","wa-um'lī",891],["لَهُمْ ۚ","kepada mereka","lahum",16],["إِنَّ","sesungguhnya","inna",9],["كَيْدِى","tipu daya-KU/rencana-Ku","kaydī",427],["مَتِينٌ","teguh","matīnun",1921]],"t":"dan Aku memberi tenggang waktu kepada mereka. Sungguh, rencana-Ku sangat teguh."},{"n":46,"w":[["أَمْ","atau","am",93],["تَسْـَٔلُهُمْ","kamu meminta mereka","tasaluhum",119],["أَجْرًۭا","upah","ajran",121],["فَهُم","lalu mereka","fahum",16],["مِّن","dari","min",1],["مَّغْرَمٍۢ","hutang","maghramin",1954],["مُّثْقَلُونَ","orang-orang yang dibebani","muth'qalūna",2560]],"t":"Ataukah engkau (Muhammad) meminta imbalan kepada mereka, sehingga mereka dibebani dengan hutang?"},{"n":47,"w":[["أَمْ","atau","am",93],["عِندَهُمُ","di sisi mereka","ʿindahumu",68],["ٱلْغَيْبُ","yang gaib","l-ghaybu",254],["فَهُمْ","lalu mereka","fahum",16],["يَكْتُبُونَ","mereka menulis","yaktubūna",255]],"t":"Ataukah mereka mengetahui yang gaib, lalu mereka menuliskannya?"},{"n":48,"w":[["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",215],["لِحُكْمِ","terhadap ketetapan","liḥuk'mi",382],["رَبِّكَ","Tuhanmu","rabbika",15],["وَلَا","dan jangan","walā",8],["تَكُن","kamu jadi","takun",12],["كَصَاحِبِ","seperti teman/orang","kaṣāḥibi",132],["ٱلْحُوتِ","ikan","l-ḥūti",1321],["إِذْ","ketika","idh",61],["نَادَىٰ","ia menyeru/berdo'a","nādā",283],["وَهُوَ","dan ia","wahuwa",25],["مَكْظُومٌۭ","amat marah","makẓūmun",3719]],"t":"Maka bersabarlah engkau (Muhammad) terhadap ketetapan Tuhanmu, dan janganlah engkau seperti (Yunus) orang yang berada dalam (perut) ikan ketika dia berdoa dengan hati sedih."},{"n":49,"w":[["لَّوْلَآ","kalau tidak","lawlā",167],["أَن","karena","an",22],["تَدَٰرَكَهُۥ","mendapatkannya/ia","tadārakahu",2095],["نِعْمَةٌۭ","nikmat","niʿ'matun",250],["مِّن","dari","min",1],["رَّبِّهِۦ","Tuhannya","rabbihi",15],["لَنُبِذَ","tentu ia dicampakkan","lanubidha",868],["بِٱلْعَرَآءِ","tanah tandus/kosong","bil-ʿarāi",2243],["وَهُوَ","dan ia","wahuwa",25],["مَذْمُومٌۭ","tercela","madhmūmun",1908]],"t":"Sekiranya dia tidak segera mendapat nikmat dari Tuhannya, pastilah dia dicampakkan ke tanah tandus dalam keadaan tercela."},{"n":50,"w":[["فَٱجْتَبَـٰهُ","lalu memilihnya","fa-ij'tabāhu",883],["رَبُّهُۥ","Tuhannya","rabbuhu",15],["فَجَعَلَهُۥ","maka Dia menjadikannya","fajaʿalahu",40],["مِنَ","dari/termasuk","mina",1],["ٱلصَّـٰلِحِينَ","orang-orang yang saleh","l-ṣāliḥīna",104]],"t":"Lalu Tuhannya memilihnya dan menjadikannya termasuk orang yang saleh."},{"n":51,"w":[["وَإِن","dan sesungguhnya","wa-in",19],["يَكَادُ","hampir","yakādu",368],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["لَيُزْلِقُونَكَ","benar-benar akan menggelincirkan kamu","layuz'liqūnaka",3049],["بِأَبْصَـٰرِهِمْ","dengan pandangan mereka","bi-abṣārihim",260],["لَمَّا","tatkala","lammā",81],["سَمِعُوا۟","mereka mendengar","samiʿū",159],["ٱلذِّكْرَ","peringatan/Al Qur'an","l-dhik'ra",163],["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",10],["إِنَّهُۥ","sesungguhnya","innahu",9],["لَمَجْنُونٌۭ","benar-benar orang gila","lamajnūnun",801]],"t":"Dan sungguh, orang-orang kafir itu hampir-hampir menggelincirkanmu dengan pandangan mata mereka, ketika mereka mendengar Alquran dan mereka berkata, \"Dia (Muhammad) itu benar-benar orang gila.\""},{"n":52,"w":[["وَمَا","dan tidaklah","wamā",6],["هُوَ","ia","huwa",25],["إِلَّا","kecuali","illā",20],["ذِكْرٌۭ","peringatan/pelajaran","dhik'run",163],["لِّلْعَـٰلَمِينَ","bagi alam semesta","lil'ʿālamīna",174]],"t":"Padahal Alquran itu tidak lain adalah peringatan bagi seluruh alam."}]