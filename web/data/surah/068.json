[{"n":1,"w":[["نٓ ۚ","Nun","noon",3236],["وَٱلْقَلَمِ","demi qalam","wal-qalami",1619],["وَمَا","dan apa","wamā",2],["يَسْطُرُونَ","mereka tulis","yasṭurūna",4668]],"t":"Nūn. Demi pena dan apa yang mereka tuliskan,"},{"n":2,"w":[["مَآ","tidakkah","mā",2],["أَنتَ","kamu","anta",139],["بِنِعْمَةِ","dengan ni'mat","biniʿ'mati",237],["رَبِّكَ","Tuhanmu","rabbika",10],["بِمَجْنُونٍۢ","orang gila","bimajnūnin",789]],"t":"dengan karunia Tuhanmu engkau (Muhammad) bukanlah orang gila."},{"n":3,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَكَ","bagimu","laka",138],["لَأَجْرًا","benar-benar pahala","la-ajran",107],["غَيْرَ","bukan/tidak","ghayra",75],["مَمْنُونٍۢ","terputus-putus","mamnūnin",1578]],"t":"Dan sesungguhnya engkau pasti mendapat pahala yang besar yang tidak putus-putusnya."},{"n":4,"w":[["وَإِنَّكَ","dan sesungguhnya kamu","wa-innaka",5],["لَعَلَىٰ","benar-benar di atas","laʿalā",8],["خُلُقٍ","budi pekerti","khuluqin",2750],["عَظِيمٍۢ","luhur/agung","ʿaẓīmin",98]],"t":"Dan sesungguhnya engkau benar-benar, berbudi pekerti yang luhur."},{"n":5,"w":[["فَسَتُبْصِرُ","maka kelak kamu akan melihat","fasatub'ṣiru",370],["وَيُبْصِرُونَ","dan mereka akan melihat","wayub'ṣirūna",370]],"t":"Maka kelak engkau akan melihat dan mereka (orang-orang kafir) pun akan melihat,"},{"n":6,"w":[["بِأَييِّكُمُ","siapa diantara kamu","bi-ayyikumu",200],["ٱلْمَفْتُونُ","yang di uji/gila","l-maftūnu",3672]],"t":"siapa diantara kamu yang gila?"},{"n":7,"w":[["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِمَن","pada siapa","biman",12],["ضَلَّ","ia sesat","ḍalla",223],["عَن","dari","ʿan",21],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",64],["وَهُوَ","dan Dia","wahuwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",240],["بِٱلْمُهْتَدِينَ","terhadap orang-orang yang mendapat petunjuk","bil-muh'tadīna",575]],"t":"Sungguh, Tuhanmu, Dialah yang paling mengetahui siapa yang sesat dari jalan-Nya; dan Dialah yang paling mengetahui siapa orang yang mendapat petunjuk."},{"n":8,"w":[["فَلَا","maka jangan","falā",4],["تُطِعِ","kamu taati","tuṭiʿi",163],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",493]],"t":"Maka janganlah engkau patuhi orang-orang yang mendustakan (ayat-ayat Allah)."},{"n":9,"w":[["وَدُّوا۟","mereka menginginkan","waddū",582],["لَوْ","sekiranya/supaya","law",57],["تُدْهِنُ","kamu bersikap lemah lembut","tud'hinu",2806],["فَيُدْهِنُونَ","maka mereka akan bersikap lemah lembut","fayud'hinūna",2806]],"t":"Mereka menginginkan agar engkau bersikap lunak maka mereka bersikap lunak (pula)."},{"n":10,"w":[["وَلَا","dan jangan","walā",4],["تُطِعْ","kamu taati","tuṭiʿ",163],["كُلَّ","setiap","kulla",31],["حَلَّافٍۢ","banyak bersumpah","ḥallāfin",3184],["مَّهِينٍ","yang hina","mahīnin",1597]],"t":"Dan janganlah engkau patuhi setiap orang yang suka bersumpah dan suka menghina,"},{"n":11,"w":[["هَمَّازٍۢ","pencela","hammāzin",3508],["مَّشَّآءٍۭ","berjalan","mashāin",3914],["بِنَمِيمٍۢ","dengan fitnah","binamīmin",4049]],"t":"suka mencela, yang kian ke mari menyebarkan fitnah,"},{"n":12,"w":[["مَّنَّاعٍۢ","menghalangi","mannāʿin",2528],["لِّلْخَيْرِ","bagi kebaikan","lil'khayri",62],["مُعْتَدٍ","melampaui batas","muʿ'tadin",1902],["أَثِيمٍ","dosa","athīmin",1040]],"t":"yang merintangi segala yang baik, yang melampaui batas dan banyak dosa,"},{"n":13,"w":[["عُتُلٍّۭ","kaku kasar","ʿutullin",3156],["بَعْدَ","sesudah","baʿda",58],["ذَٰلِكَ","demikian itu","dhālika",19],["زَنِيمٍ","terkenal jahat","zanīmin",4770]],"t":"yang bertabiat kasar, selain itu juga terkenal kejahatannya,"},{"n":14,"w":[["أَن","karena","an",17],["كَانَ","dia adalah","kāna",9],["ذَا","mempunyai","dhā",447],["مَالٍۢ","harta","mālin",127],["وَبَنِينَ","dan anak-anak","wabanīna",141]],"t":"karena dia kaya dan banyak anak."},{"n":15,"w":[["إِذَا","apabila","idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",199],["عَلَيْهِ","kepadanya","ʿalayhi",8],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["قَالَ","dia berkata","qāla",6],["أَسَـٰطِيرُ","dongeng-dongeng","asāṭīru",878],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",137]],"t":"Apabila ayat-ayat Kami dibacakan kepadanya, dia berkata, \"(Ini adalah) dongeng-dongeng orang dahulu.\""},{"n":16,"w":[["سَنَسِمُهُۥ","kelak akan Kami beri tanda dia","sanasimuhu",4057],["عَلَى","atas","ʿalā",8],["ٱلْخُرْطُومِ","belalai","l-khur'ṭūmi",4609]],"t":"Kelak dia akan Kami beri tanda pada belalai(nya)."},{"n":17,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["بَلَوْنَـٰهُمْ","Kami telah menguji mereka","balawnāhum",513],["كَمَا","sebagaimana","kamā",2],["بَلَوْنَآ","Kami telah menguji","balawnā",513],["أَصْحَـٰبَ","penghuni/pemilik","aṣḥāba",143],["ٱلْجَنَّةِ","surga","l-janati",76],["إِذْ","ketika","idh",53],["أَقْسَمُوا۟","mereka bersumpah","aqsamū",504],["لَيَصْرِمُنَّهَا","sungguh mereka akan mematikannya","layaṣrimunnahā",4628],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1361]],"t":"Sungguh, Kami telah menguji mereka (orang musyrik Mekkah) sebagaimana Kami telah menguji pemilik-pemilik kebun, ketika mereka bersumpah pasti akan memetik (hasil)nya pada pagi hari,"},{"n":18,"w":[["وَلَا","dan tidak","walā",4],["يَسْتَثْنُونَ","mereka menyisihkan","yastathnūna",4679]],"t":"tetapi mereka tidak mengecualikan (dengan mengucapkan, \"Insya Allah\")."},{"n":19,"w":[["فَطَافَ","maka mengepung","faṭāfa",965],["عَلَيْهَا","atasnya (kebun itu)","ʿalayhā",8],["طَآئِفٌۭ","kepungan (malapetaka)","ṭāifun",1525],["مِّن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["وَهُمْ","dan mereka","wahum",11],["نَآئِمُونَ","orang-orang yang tidur","nāimūna",2548]],"t":"Lalu kebun itu ditimpa bencana (yang datang) dari Tuhanmu ketika mereka sedang tidur."},{"n":20,"w":[["فَأَصْبَحَتْ","maka jadilah ia/kebun itu","fa-aṣbaḥat",380],["كَٱلصَّرِيمِ","seperti sudah di potong/petik","kal-ṣarīmi",3294]],"t":"Maka jadilah kebun itu hitam seperti malam yang gelap gulita,"},{"n":21,"w":[["فَتَنَادَوْا۟","maka mereka panggil memanggil","fatanādaw",4410],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1361]],"t":"lalu pada pagi hari mereka saling memanggil."},{"n":22,"w":[["أَنِ","sesungguhnya","ani",17],["ٱغْدُوا۟","pergi diwaktu pagi","igh'dū",1844],["عَلَىٰ","atas","ʿalā",8],["حَرْثِكُمْ","kebunmu","ḥarthikum",681],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰرِمِينَ","orang-orang yang memotong/memetik","ṣārimīna",3248]],"t":"\"Pergilah pagi-pagi ke kebunmu jika kamu hendak memetik hasil.\""},{"n":23,"w":[["فَٱنطَلَقُوا۟","maka mereka berjalan/pergi","fa-inṭalaqū",945],["وَهُمْ","dan mereka","wahum",11],["يَتَخَـٰفَتُونَ","mereka saling berbisik","yatakhāfatūna",2787]],"t":"Maka mereka pun berangkat sambil berbisik-bisik."},{"n":24,"w":[["أَن","bahwa","an",17],["لَّا","jangan","lā",4],["يَدْخُلَنَّهَا","sekali-kali memasukinya","yadkhulannahā",151],["ٱلْيَوْمَ","hari ini","l-yawma",25],["عَلَيْكُم","atas kalian","ʿalaykum",8],["مِّسْكِينٌۭ","seorang miskin","mis'kīnun",457]],"t":"\"Pada hari ini jangan sampai ada orang miskin masuk ke dalam kebunmu.\""},{"n":25,"w":[["وَغَدَوْا۟","dan mereka pergi pagi-pagi","waghadaw",1844],["عَلَىٰ","atas","ʿalā",8],["حَرْدٍۢ","mencegah/menghalangi","ḥardin",3194],["قَـٰدِرِينَ","orang-orang yang mampu","qādirīna",672]],"t":"Dan berangkatlah mereka di pagi hari dengan niat menghalangi (orang-orang miskin) padahal mereka mampu (menolongnya)."},{"n":26,"w":[["فَلَمَّا","maka tatkala","falammā",71],["رَأَوْهَا","mereka melihatnya","ra-awhā",46],["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya Kami","innā",5],["لَضَآلُّونَ","benar-benar orang-orang yang sesat","laḍāllūna",652]],"t":"Maka ketika mereka melihat kebun itu, mereka berkata, \"Sungguh, kita ini benar-benar orang-orang yang sesat,"},{"n":27,"w":[["بَلْ","bahkan","bal",93],["نَحْنُ","kami","naḥnu",126],["مَحْرُومُونَ","orang-orang yang menghalangi","maḥrūmūna",1574]],"t":"bahkan kita tak memperoleh apa pun.\""},{"n":28,"w":[["قَالَ","berkata","qāla",6],["أَوْسَطُهُمْ","paling baik antara mereka","awsaṭuhum",2202],["أَلَمْ","tidakkah","alam",32],["أَقُل","aku katakan","aqul",6],["لَّكُمْ","bagi kalian","lakum",26],["لَوْلَا","mengapa tidak","lawlā",154],["تُسَبِّحُونَ","kamu bertasbih","tusabbiḥūna",276]],"t":"Berkatalah seorang yang paling bijak di antara mereka, \"Bukankah aku telah mengatakan kepadamu, mengapa kamu tidak bertasbih (kepada Tuhanmu).\""},{"n":29,"w":[["قَالُوا۟","mereka berkata","qālū",6],["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",285],["رَبِّنَآ","Tuhan Kami","rabbinā",10],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",9],["ظَـٰلِمِينَ","orang-orang yang zalim","ẓālimīna",89]],"t":"Mereka mengucapkan, \"Mahasuci Tuhan kami, sungguh, kami adalah orang-orang yang zalim.\""},{"n":30,"w":[["فَأَقْبَلَ","maka berhadapan","fa-aqbala",876],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",70],["عَلَىٰ","atas","ʿalā",8],["بَعْضٍۢ","sebagian","baʿḍin",70],["يَتَلَـٰوَمُونَ","mereka saling cela mencela","yatalāwamūna",4693]],"t":"Lalu mereka saling berhadapan dan saling menyalahkan."},{"n":31,"w":[["قَالُوا۟","mereka berkata","qālū",6],["يَـٰوَيْلَنَآ","betapa celakanya kami","yāwaylanā",293],["إِنَّا","sesungguhnya kami","innā",5],["كُنَّا","adalah kami","kunnā",9],["طَـٰغِينَ","orang-orang yang melampaui batas","ṭāghīna",1161]],"t":"Mereka berkata, \"Celaka kita! Sesungguhnya kita orang-orang yang melampaui batas."},{"n":32,"w":[["عَسَىٰ","mudah-mudahan","ʿasā",361],["رَبُّنَآ","Tuhan kami","rabbunā",10],["أَن","akan","an",17],["يُبْدِلَنَا","mengganti kami","yub'dilanā",2077],["خَيْرًۭا","lebih baik","khayran",62],["مِّنْهَآ","daripadanya","min'hā",0],["إِنَّآ","sesungguhnya kami","innā",5],["إِلَىٰ","kepada","ilā",13],["رَبِّنَا","Tuhan kami","rabbinā",10],["رَٰغِبُونَ","orang-orang yang mengharap","rāghibūna",1971]],"t":"Mudah-mudahan Tuhan memberikan ganti kepada kita dengan (kebun) yang lebih baik daripada yang ini, sungguh, kita mengharapkan ampunan dari Tuhan kita."},{"n":33,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",19],["ٱلْعَذَابُ ۖ","siksaan/azab","l-ʿadhābu",36],["وَلَعَذَابُ","dan sungguh siksaan/azab","walaʿadhābu",36],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",72],["أَكْبَرُ ۚ","lebih besar","akbaru",434],["لَوْ","jika","law",57],["كَانُوا۟","adalah mereka","kānū",9],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Seperti itulah azab (di dunia). Dan sungguh, azab akhirat lebih besar sekiranya mereka mengetahui."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",5],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",244],["عِندَ","di sisi","ʿinda",59],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["جَنَّـٰتِ","surga","jannāti",76],["ٱلنَّعِيمِ","kenikmatan","l-naʿīmi",576]],"t":"Sungguh, bagi orang-orang yang bertakwa (disediakan) surga yang penuh kenikmatan di sisi Tuhannya."},{"n":35,"w":[["أَفَنَجْعَلُ","maka apakah Kami menjadikan","afanajʿalu",33],["ٱلْمُسْلِمِينَ","orang-orang Islam","l-mus'limīna",303],["كَٱلْمُجْرِمِينَ","seperti orang-orang berdosa","kal-muj'rimīna",228]],"t":"Apakah patut Kami memperlakukan orang-orang Islam itu seperti orang-orang yang berdosa (orang kafir)?"},{"n":36,"w":[["مَا","mengapa","mā",2],["لَكُمْ","bagi kalian","lakum",26],["كَيْفَ","bagaimana","kayfa",134],["تَحْكُمُونَ","kamu mengambil keputusan","taḥkumūna",258]],"t":"Mengapa kamu (berbuat demikian)? Bagaimana kamu mengambil keputusan?"},{"n":37,"w":[["أَمْ","atau","am",82],["لَكُمْ","bagi kalian","lakum",26],["كِتَـٰبٌۭ","kitab","kitābun",49],["فِيهِ","di dalamnya","fīhi",3],["تَدْرُسُونَ","kamu mempelajari","tadrusūna",1329]],"t":"Atau apakah kamu mempunyai kitab (yang diturunkan Allah) yang kamu pelajari?"},{"n":38,"w":[["إِنَّ","sesungguhnya","inna",5],["لَكُمْ","bagi kalian","lakum",26],["فِيهِ","di dalamnya","fīhi",3],["لَمَا","untuk apa-apa","lamā",2],["تَخَيَّرُونَ","kamu memilih","takhayyarūna",2788]],"t":"sesungguhnya kamu dapat memilih apa saja yang ada di dalamnya."},{"n":39,"w":[["أَمْ","atau","am",82],["لَكُمْ","bagi kalian","lakum",26],["أَيْمَـٰنٌ","sumpah/perjanjian","aymānun",184],["عَلَيْنَا","atas Kami","ʿalaynā",8],["بَـٰلِغَةٌ","teguh","bālighatun",1808],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْقِيَـٰمَةِ ۙ","kiamat","l-qiyāmati",174],["إِنَّ","sesungguhnya","inna",5],["لَكُمْ","bagi kalian","lakum",26],["لَمَا","terhadap apa","lamā",2],["تَحْكُمُونَ","kamu putuskan","taḥkumūna",258]],"t":"Atau apakah kamu memperoleh (janji-janji yang diperkuat dengan) sumpah dari Kami, yang tetap berlaku sampai hari Kiamat; bahwa kamu dapat mengambil keputusan (sekehendakmu)?"},{"n":40,"w":[["سَلْهُمْ","tanyakan pada mereka","salhum",105],["أَيُّهُم","siapa di antara mereka","ayyuhum",200],["بِذَٰلِكَ","terhadap demikian itu","bidhālika",19],["زَعِيمٌ","bertanggung jawab","zaʿīmun",2821]],"t":"Tanyakanlah kepada mereka, \"Siapakah di antara mereka yang bertanggung jawab terhadap (keputusan yang diambil itu)?\""},{"n":41,"w":[["أَمْ","atau","am",82],["لَهُمْ","bagi mereka","lahum",11],["شُرَكَآءُ","sekutu-sekutu","shurakāu",286],["فَلْيَأْتُوا۟","maka hendaklah mereka mendatangkan","falyatū",48],["بِشُرَكَآئِهِمْ","dengan sekutu-sekutu mereka","bishurakāihim",286],["إِن","jika","in",14],["كَانُوا۟","mereka adalah","kānū",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Atau apakah mereka mempunyai sekutu-sekutu? Kalau begitu hendaklah mereka mendatangkan sekutu-sekutunya jika mereka orang-orang yang benar."},{"n":42,"w":[["يَوْمَ","pada hari","yawma",25],["يُكْشَفُ","di buka/di singkap","yuk'shafu",662],["عَن","dari","ʿan",21],["سَاقٍۢ","betis","sāqin",1633],["وَيُدْعَوْنَ","dan mereka di seru/di panggil","wayud'ʿawna",65],["إِلَى","kepada/untuk","ilā",13],["ٱلسُّجُودِ","bersujud","l-sujūdi",1235],["فَلَا","maka tidak","falā",4],["يَسْتَطِيعُونَ","mereka mampu/kuasa","yastaṭīʿūna",279]],"t":"(Ingatlah) pada hari ketika betis disingkapkan dan mereka diseru untuk bersujud; maka mereka tidak mampu,"},{"n":43,"w":[["خَـٰشِعَةً","tertunduk","khāshiʿatan",674],["أَبْصَـٰرُهُمْ","pandangan mereka","abṣāruhum",247],["تَرْهَقُهُمْ","menimpa mereka","tarhaquhum",1434],["ذِلَّةٌۭ ۖ","kehinaan","dhillatun",1029],["وَقَدْ","dan sesungguhnya","waqad",24],["كَانُوا۟","adalah mereka","kānū",9],["يُدْعَوْنَ","mereka di seru/di panggil","yud'ʿawna",65],["إِلَى","kepada/untuk","ilā",13],["ٱلسُّجُودِ","bersujud","l-sujūdi",1235],["وَهُمْ","dan/sedang mereka","wahum",11],["سَـٰلِمُونَ","orang-orang sejahtera","sālimūna",4254]],"t":"pandangan mereka tertunduk ke bawah, diliputi kehinaan. Dan sungguh, dahulu (di dunia) mereka telah diseru untuk bersujud waktu mereka sehat (tetapi mereka tidak melakukan)."},{"n":44,"w":[["فَذَرْنِى","maka biarkan Aku","fadharnī",262],["وَمَن","dan orang","waman",12],["يُكَذِّبُ","ia mendustakan","yukadhibu",63],["بِهَـٰذَا","dengan ini","bihādhā",37],["ٱلْحَدِيثِ ۖ","cerita/perkataan","l-ḥadīthi",385],["سَنَسْتَدْرِجُهُم","kelak Kami menarik mereka berangsur-angsur","sanastadrijuhum",2562],["مِّنْ","dari","min",0],["حَيْثُ","sekira/secara","ḥaythu",373],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Maka serahkanlah kepada-Ku (urusannya) dan orang-orang yang mendustakan perkataan ini (Alquran). Kelak akan Kami hukum mereka berangsur-angsur dari arah yang tidak mereka ketahui,"},{"n":45,"w":[["وَأُمْلِى","dan Aku beri waktu/tangguh","wa-um'lī",875],["لَهُمْ ۚ","kepada mereka","lahum",11],["إِنَّ","sesungguhnya","inna",5],["كَيْدِى","tipu daya-KU/rencana-Ku","kaydī",414],["مَتِينٌ","teguh","matīnun",1890]],"t":"dan Aku memberi tenggang waktu kepada mereka. Sungguh, rencana-Ku sangat teguh."},{"n":46,"w":[["أَمْ","atau","am",82],["تَسْـَٔلُهُمْ","kamu meminta mereka","tasaluhum",105],["أَجْرًۭا","upah","ajran",107],["فَهُم","lalu mereka","fahum",11],["مِّن","dari","min",0],["مَّغْرَمٍۢ","hutang","maghramin",1922],["مُّثْقَلُونَ","orang-orang yang dibebani","muth'qalūna",2545]],"t":"Ataukah engkau (Muhammad) meminta imbalan kepada mereka, sehingga mereka dibebani dengan hutang?"},{"n":47,"w":[["أَمْ","atau","am",82],["عِندَهُمُ","di sisi mereka","ʿindahumu",59],["ٱلْغَيْبُ","yang gaib","l-ghaybu",242],["فَهُمْ","lalu mereka","fahum",11],["يَكْتُبُونَ","mereka menulis","yaktubūna",243]],"t":"Ataukah mereka mengetahui yang gaib, lalu mereka menuliskannya?"},{"n":48,"w":[["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",205],["لِحُكْمِ","terhadap ketetapan","liḥuk'mi",362],["رَبِّكَ","Tuhanmu","rabbika",10],["وَلَا","dan jangan","walā",4],["تَكُن","kamu jadi","takun",9],["كَصَاحِبِ","seperti teman/orang","kaṣāḥibi",824],["ٱلْحُوتِ","ikan","l-ḥūti",1307],["إِذْ","ketika","idh",53],["نَادَىٰ","ia menyeru/berdo'a","nādā",269],["وَهُوَ","dan ia","wahuwa",20],["مَكْظُومٌۭ","amat marah","makẓūmun",3687]],"t":"Maka bersabarlah engkau (Muhammad) terhadap ketetapan Tuhanmu, dan janganlah engkau seperti (Yunus) orang yang berada dalam (perut) ikan ketika dia berdoa dengan hati sedih."},{"n":49,"w":[["لَّوْلَآ","kalau tidak","lawlā",154],["أَن","karena","an",17],["تَدَٰرَكَهُۥ","mendapatkannya/ia","tadārakahu",2102],["نِعْمَةٌۭ","nikmat","niʿ'matun",237],["مِّن","dari","min",0],["رَّبِّهِۦ","Tuhannya","rabbihi",10],["لَنُبِذَ","tentu ia dicampakkan","lanubidha",853],["بِٱلْعَرَآءِ","tanah tandus/kosong","bil-ʿarāi",2243],["وَهُوَ","dan ia","wahuwa",20],["مَذْمُومٌۭ","tercela","madhmūmun",1877]],"t":"Sekiranya dia tidak segera mendapat nikmat dari Tuhannya, pastilah dia dicampakkan ke tanah tandus dalam keadaan tercela."},{"n":50,"w":[["فَٱجْتَبَـٰهُ","lalu memilihnya","fa-ij'tabāhu",868],["رَبُّهُۥ","Tuhannya","rabbuhu",10],["فَجَعَلَهُۥ","maka Dia menjadikannya","fajaʿalahu",33],["مِنَ","dari/termasuk","mina",0],["ٱلصَّـٰلِحِينَ","orang-orang yang saleh","l-ṣāliḥīna",181]],"t":"Lalu Tuhannya memilihnya dan menjadikannya termasuk orang yang saleh."},{"n":51,"w":[["وَإِن","dan sesungguhnya","wa-in",14],["يَكَادُ","hampir","yakādu",441],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَيُزْلِقُونَكَ","benar-benar akan menggelincirkan kamu","layuz'liqūnaka",4758],["بِأَبْصَـٰرِهِمْ","dengan pandangan mereka","bi-abṣārihim",247],["لَمَّا","tatkala","lammā",71],["سَمِعُوا۟","mereka mendengar","samiʿū",145],["ٱلذِّكْرَ","peringatan/Al Qur'an","l-dhik'ra",149],["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["إِنَّهُۥ","sesungguhnya","innahu",5],["لَمَجْنُونٌۭ","benar-benar orang gila","lamajnūnun",789]],"t":"Dan sungguh, orang-orang kafir itu hampir-hampir menggelincirkanmu dengan pandangan mata mereka, ketika mereka mendengar Alquran dan mereka berkata, \"Dia (Muhammad) itu benar-benar orang gila.\""},{"n":52,"w":[["وَمَا","dan tidaklah","wamā",2],["هُوَ","ia","huwa",20],["إِلَّا","kecuali","illā",15],["ذِكْرٌۭ","peringatan/pelajaran","dhik'run",149],["لِّلْعَـٰلَمِينَ","bagi alam semesta","lil'ʿālamīna",160]],"t":"Padahal Alquran itu tidak lain adalah peringatan bagi seluruh alam."}]