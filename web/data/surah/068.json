[{"n":1,"w":[["نٓ ۚ","Nun","noon",3242],["وَٱلْقَلَمِ","demi qalam","wal-qalami",1624],["وَمَا","dan apa","wamā",2],["يَسْطُرُونَ","mereka tulis","yasṭurūna",4675]],"t":"Nūn. Demi pena dan apa yang mereka tuliskan,"},{"n":2,"w":[["مَآ","tidakkah","mā",2],["أَنتَ","kamu","anta",138],["بِنِعْمَةِ","dengan ni'mat","biniʿ'mati",238],["رَبِّكَ","Tuhanmu","rabbika",10],["بِمَجْنُونٍۢ","orang gila","bimajnūnin",792]],"t":"dengan karunia Tuhanmu engkau (Muhammad) bukanlah orang gila."},{"n":3,"w":[["وَإِنَّ","dan sesungguhnya","wa-inna",5],["لَكَ","bagimu","laka",137],["لَأَجْرًا","benar-benar pahala","la-ajran",107],["غَيْرَ","bukan/tidak","ghayra",75],["مَمْنُونٍۢ","terputus-putus","mamnūnin",1583]],"t":"Dan sesungguhnya engkau pasti mendapat pahala yang besar yang tidak putus-putusnya."},{"n":4,"w":[["وَإِنَّكَ","dan sesungguhnya kamu","wa-innaka",5],["لَعَلَىٰ","benar-benar di atas","laʿalā",8],["خُلُقٍ","budi pekerti","khuluqin",2756],["عَظِيمٍۢ","luhur/agung","ʿaẓīmin",97]],"t":"Dan sesungguhnya engkau benar-benar, berbudi pekerti yang luhur."},{"n":5,"w":[["فَسَتُبْصِرُ","maka kelak kamu akan melihat","fasatub'ṣiru",371],["وَيُبْصِرُونَ","dan mereka akan melihat","wayub'ṣirūna",371]],"t":"Maka kelak engkau akan melihat dan mereka (orang-orang kafir) pun akan melihat,"},{"n":6,"w":[["بِأَييِّكُمُ","siapa diantara kamu","bi-ayyikumu",201],["ٱلْمَفْتُونُ","yang di uji/gila","l-maftūnu",3679]],"t":"siapa diantara kamu yang gila?"},{"n":7,"w":[["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["هُوَ","Dia","huwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",241],["بِمَن","pada siapa","biman",12],["ضَلَّ","ia sesat","ḍalla",224],["عَن","dari","ʿan",21],["سَبِيلِهِۦ","jalan-Nya","sabīlihi",64],["وَهُوَ","dan Dia","wahuwa",20],["أَعْلَمُ","lebih mengetahui","aʿlamu",241],["بِٱلْمُهْتَدِينَ","terhadap orang-orang yang mendapat petunjuk","bil-muh'tadīna",577]],"t":"Sungguh, Tuhanmu, Dialah yang paling mengetahui siapa yang sesat dari jalan-Nya; dan Dialah yang paling mengetahui siapa orang yang mendapat petunjuk."},{"n":8,"w":[["فَلَا","maka jangan","falā",4],["تُطِعِ","kamu taati","tuṭiʿi",161],["ٱلْمُكَذِّبِينَ","orang-orang yang mendustakan","l-mukadhibīna",494]],"t":"Maka janganlah engkau patuhi orang-orang yang mendustakan (ayat-ayat Allah)."},{"n":9,"w":[["وَدُّوا۟","mereka menginginkan","waddū",584],["لَوْ","sekiranya/supaya","law",57],["تُدْهِنُ","kamu bersikap lemah lembut","tud'hinu",2812],["فَيُدْهِنُونَ","maka mereka akan bersikap lemah lembut","fayud'hinūna",2812]],"t":"Mereka menginginkan agar engkau bersikap lunak maka mereka bersikap lunak (pula)."},{"n":10,"w":[["وَلَا","dan jangan","walā",4],["تُطِعْ","kamu taati","tuṭiʿ",161],["كُلَّ","setiap","kulla",31],["حَلَّافٍۢ","banyak bersumpah","ḥallāfin",3190],["مَّهِينٍ","yang hina","mahīnin",1602]],"t":"Dan janganlah engkau patuhi setiap orang yang suka bersumpah dan suka menghina,"},{"n":11,"w":[["هَمَّازٍۢ","pencela","hammāzin",3515],["مَّشَّآءٍۭ","berjalan","mashāin",3921],["بِنَمِيمٍۢ","dengan fitnah","binamīmin",4056]],"t":"suka mencela, yang kian ke mari menyebarkan fitnah,"},{"n":12,"w":[["مَّنَّاعٍۢ","menghalangi","mannāʿin",2534],["لِّلْخَيْرِ","bagi kebaikan","lil'khayri",62],["مُعْتَدٍ","melampaui batas","muʿ'tadin",1907],["أَثِيمٍ","dosa","athīmin",1044]],"t":"yang merintangi segala yang baik, yang melampaui batas dan banyak dosa,"},{"n":13,"w":[["عُتُلٍّۭ","kaku kasar","ʿutullin",3162],["بَعْدَ","sesudah","baʿda",58],["ذَٰلِكَ","demikian itu","dhālika",19],["زَنِيمٍ","terkenal jahat","zanīmin",4777]],"t":"yang bertabiat kasar, selain itu juga terkenal kejahatannya,"},{"n":14,"w":[["أَن","karena","an",16],["كَانَ","dia adalah","kāna",9],["ذَا","mempunyai","dhā",448],["مَالٍۢ","harta","mālin",126],["وَبَنِينَ","dan anak-anak","wabanīna",140]],"t":"karena dia kaya dan banyak anak."},{"n":15,"w":[["إِذَا","apabila","idhā",23],["تُتْلَىٰ","dibacakan","tut'lā",200],["عَلَيْهِ","kepadanya","ʿalayhi",8],["ءَايَـٰتُنَا","ayat-ayat Kami","āyātunā",28],["قَالَ","dia berkata","qāla",6],["أَسَـٰطِيرُ","dongeng-dongeng","asāṭīru",881],["ٱلْأَوَّلِينَ","orang-orang terdahulu","l-awalīna",136]],"t":"Apabila ayat-ayat Kami dibacakan kepadanya, dia berkata, \"(Ini adalah) dongeng-dongeng orang dahulu.\""},{"n":16,"w":[["سَنَسِمُهُۥ","kelak akan Kami beri tanda dia","sanasimuhu",4064],["عَلَى","atas","ʿalā",8],["ٱلْخُرْطُومِ","belalai","l-khur'ṭūmi",4616]],"t":"Kelak dia akan Kami beri tanda pada belalai(nya)."},{"n":17,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["بَلَوْنَـٰهُمْ","Kami telah menguji mereka","balawnāhum",514],["كَمَا","sebagaimana","kamā",2],["بَلَوْنَآ","Kami telah menguji","balawnā",514],["أَصْحَـٰبَ","penghuni/pemilik","aṣḥāba",142],["ٱلْجَنَّةِ","surga","l-janati",76],["إِذْ","ketika","idh",53],["أَقْسَمُوا۟","mereka bersumpah","aqsamū",505],["لَيَصْرِمُنَّهَا","sungguh mereka akan mematikannya","layaṣrimunnahā",4635],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1366]],"t":"Sungguh, Kami telah menguji mereka (orang musyrik Mekkah) sebagaimana Kami telah menguji pemilik-pemilik kebun, ketika mereka bersumpah pasti akan memetik (hasil)nya pada pagi hari,"},{"n":18,"w":[["وَلَا","dan tidak","walā",4],["يَسْتَثْنُونَ","mereka menyisihkan","yastathnūna",4686]],"t":"tetapi mereka tidak mengecualikan (dengan mengucapkan, \"Insya Allah\")."},{"n":19,"w":[["فَطَافَ","maka mengepung","faṭāfa",969],["عَلَيْهَا","atasnya (kebun itu)","ʿalayhā",8],["طَآئِفٌۭ","kepungan (malapetaka)","ṭāifun",1530],["مِّن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["وَهُمْ","dan mereka","wahum",11],["نَآئِمُونَ","orang-orang yang tidur","nāimūna",2554]],"t":"Lalu kebun itu ditimpa bencana (yang datang) dari Tuhanmu ketika mereka sedang tidur."},{"n":20,"w":[["فَأَصْبَحَتْ","maka jadilah ia/kebun itu","fa-aṣbaḥat",381],["كَٱلصَّرِيمِ","seperti sudah di potong/petik","kal-ṣarīmi",3301]],"t":"Maka jadilah kebun itu hitam seperti malam yang gelap gulita,"},{"n":21,"w":[["فَتَنَادَوْا۟","maka mereka panggil memanggil","fatanādaw",4417],["مُصْبِحِينَ","di pagi hari","muṣ'biḥīna",1366]],"t":"lalu pada pagi hari mereka saling memanggil."},{"n":22,"w":[["أَنِ","sesungguhnya","ani",16],["ٱغْدُوا۟","pergi diwaktu pagi","igh'dū",1849],["عَلَىٰ","atas","ʿalā",8],["حَرْثِكُمْ","kebunmu","ḥarthikum",684],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰرِمِينَ","orang-orang yang memotong/memetik","ṣārimīna",3255]],"t":"\"Pergilah pagi-pagi ke kebunmu jika kamu hendak memetik hasil.\""},{"n":23,"w":[["فَٱنطَلَقُوا۟","maka mereka berjalan/pergi","fa-inṭalaqū",949],["وَهُمْ","dan mereka","wahum",11],["يَتَخَـٰفَتُونَ","mereka saling berbisik","yatakhāfatūna",2793]],"t":"Maka mereka pun berangkat sambil berbisik-bisik."},{"n":24,"w":[["أَن","bahwa","an",16],["لَّا","jangan","lā",4],["يَدْخُلَنَّهَا","sekali-kali memasukinya","yadkhulannahā",149],["ٱلْيَوْمَ","hari ini","l-yawma",25],["عَلَيْكُم","atas kalian","ʿalaykum",8],["مِّسْكِينٌۭ","seorang miskin","mis'kīnun",458]],"t":"\"Pada hari ini jangan sampai ada orang miskin masuk ke dalam kebunmu.\""},{"n":25,"w":[["وَغَدَوْا۟","dan mereka pergi pagi-pagi","waghadaw",1849],["عَلَىٰ","atas","ʿalā",8],["حَرْدٍۢ","mencegah/menghalangi","ḥardin",3200],["قَـٰدِرِينَ","orang-orang yang mampu","qādirīna",675]],"t":"Dan berangkatlah mereka di pagi hari dengan niat menghalangi (orang-orang miskin) padahal mereka mampu (menolongnya)."},{"n":26,"w":[["فَلَمَّا","maka tatkala","falammā",71],["رَأَوْهَا","mereka melihatnya","ra-awhā",46],["قَالُوٓا۟","mereka berkata","qālū",6],["إِنَّا","sesungguhnya Kami","innā",5],["لَضَآلُّونَ","benar-benar orang-orang yang sesat","laḍāllūna",655]],"t":"Maka ketika mereka melihat kebun itu, mereka berkata, \"Sungguh, kita ini benar-benar orang-orang yang sesat,"},{"n":27,"w":[["بَلْ","bahkan","bal",93],["نَحْنُ","kami","naḥnu",125],["مَحْرُومُونَ","orang-orang yang menghalangi","maḥrūmūna",1579]],"t":"bahkan kita tak memperoleh apa pun.\""},{"n":28,"w":[["قَالَ","berkata","qāla",6],["أَوْسَطُهُمْ","paling baik antara mereka","awsaṭuhum",2207],["أَلَمْ","tidakkah","alam",32],["أَقُل","aku katakan","aqul",6],["لَّكُمْ","bagi kalian","lakum",26],["لَوْلَا","mengapa tidak","lawlā",152],["تُسَبِّحُونَ","kamu bertasbih","tusabbiḥūna",277]],"t":"Berkatalah seorang yang paling bijak di antara mereka, \"Bukankah aku telah mengatakan kepadamu, mengapa kamu tidak bertasbih (kepada Tuhanmu).\""},{"n":29,"w":[["قَالُوا۟","mereka berkata","qālū",6],["سُبْحَـٰنَ","Maha Suci","sub'ḥāna",286],["رَبِّنَآ","Tuhan Kami","rabbinā",10],["إِنَّا","sesungguhnya Kami","innā",5],["كُنَّا","adalah Kami","kunnā",9],["ظَـٰلِمِينَ","orang-orang yang zalim","ẓālimīna",89]],"t":"Mereka mengucapkan, \"Mahasuci Tuhan kami, sungguh, kami adalah orang-orang yang zalim.\""},{"n":30,"w":[["فَأَقْبَلَ","maka berhadapan","fa-aqbala",879],["بَعْضُهُمْ","sebagian mereka","baʿḍuhum",70],["عَلَىٰ","atas","ʿalā",8],["بَعْضٍۢ","sebagian","baʿḍin",70],["يَتَلَـٰوَمُونَ","mereka saling cela mencela","yatalāwamūna",4700]],"t":"Lalu mereka saling berhadapan dan saling menyalahkan."},{"n":31,"w":[["قَالُوا۟","mereka berkata","qālū",6],["يَـٰوَيْلَنَآ","betapa celakanya kami","yāwaylanā",294],["إِنَّا","sesungguhnya kami","innā",5],["كُنَّا","adalah kami","kunnā",9],["طَـٰغِينَ","orang-orang yang melampaui batas","ṭāghīna",1165]],"t":"Mereka berkata, \"Celaka kita! Sesungguhnya kita orang-orang yang melampaui batas."},{"n":32,"w":[["عَسَىٰ","mudah-mudahan","ʿasā",362],["رَبُّنَآ","Tuhan kami","rabbunā",10],["أَن","akan","an",16],["يُبْدِلَنَا","mengganti kami","yub'dilanā",2082],["خَيْرًۭا","lebih baik","khayran",62],["مِّنْهَآ","daripadanya","min'hā",0],["إِنَّآ","sesungguhnya kami","innā",5],["إِلَىٰ","kepada","ilā",13],["رَبِّنَا","Tuhan kami","rabbinā",10],["رَٰغِبُونَ","orang-orang yang mengharap","rāghibūna",1976]],"t":"Mudah-mudahan Tuhan memberikan ganti kepada kita dengan (kebun) yang lebih baik daripada yang ini, sungguh, kita mengharapkan ampunan dari Tuhan kita."},{"n":33,"w":[["كَذَٰلِكَ","seperti demikian","kadhālika",19],["ٱلْعَذَابُ ۖ","siksaan/azab","l-ʿadhābu",36],["وَلَعَذَابُ","dan sungguh siksaan/azab","walaʿadhābu",36],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",72],["أَكْبَرُ ۚ","lebih besar","akbaru",435],["لَوْ","jika","law",57],["كَانُوا۟","adalah mereka","kānū",9],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Seperti itulah azab (di dunia). Dan sungguh, azab akhirat lebih besar sekiranya mereka mengetahui."},{"n":34,"w":[["إِنَّ","sesungguhnya","inna",5],["لِلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",245],["عِندَ","di sisi","ʿinda",59],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["جَنَّـٰتِ","surga","jannāti",76],["ٱلنَّعِيمِ","kenikmatan","l-naʿīmi",578]],"t":"Sungguh, bagi orang-orang yang bertakwa (disediakan) surga yang penuh kenikmatan di sisi Tuhannya."},{"n":35,"w":[["أَفَنَجْعَلُ","maka apakah Kami menjadikan","afanajʿalu",33],["ٱلْمُسْلِمِينَ","orang-orang Islam","l-mus'limīna",304],["كَٱلْمُجْرِمِينَ","seperti orang-orang berdosa","kal-muj'rimīna",229]],"t":"Apakah patut Kami memperlakukan orang-orang Islam itu seperti orang-orang yang berdosa (orang kafir)?"},{"n":36,"w":[["مَا","mengapa","mā",2],["لَكُمْ","bagi kalian","lakum",26],["كَيْفَ","bagaimana","kayfa",133],["تَحْكُمُونَ","kamu mengambil keputusan","taḥkumūna",259]],"t":"Mengapa kamu (berbuat demikian)? Bagaimana kamu mengambil keputusan?"},{"n":37,"w":[["أَمْ","atau","am",82],["لَكُمْ","bagi kalian","lakum",26],["كِتَـٰبٌۭ","kitab","kitābun",49],["فِيهِ","di dalamnya","fīhi",3],["تَدْرُسُونَ","kamu mempelajari","tadrusūna",1334]],"t":"Atau apakah kamu mempunyai kitab (yang diturunkan Allah) yang kamu pelajari?"},{"n":38,"w":[["إِنَّ","sesungguhnya","inna",5],["لَكُمْ","bagi kalian","lakum",26],["فِيهِ","di dalamnya","fīhi",3],["لَمَا","untuk apa-apa","lamā",2],["تَخَيَّرُونَ","kamu memilih","takhayyarūna",2794]],"t":"sesungguhnya kamu dapat memilih apa saja yang ada di dalamnya."},{"n":39,"w":[["أَمْ","atau","am",82],["لَكُمْ","bagi kalian","lakum",26],["أَيْمَـٰنٌ","sumpah/perjanjian","aymānun",184],["عَلَيْنَا","atas Kami","ʿalaynā",8],["بَـٰلِغَةٌ","teguh","bālighatun",1813],["إِلَىٰ","sampai","ilā",13],["يَوْمِ","hari","yawmi",25],["ٱلْقِيَـٰمَةِ ۙ","kiamat","l-qiyāmati",174],["إِنَّ","sesungguhnya","inna",5],["لَكُمْ","bagi kalian","lakum",26],["لَمَا","terhadap apa","lamā",2],["تَحْكُمُونَ","kamu putuskan","taḥkumūna",259]],"t":"Atau apakah kamu memperoleh (janji-janji yang diperkuat dengan) sumpah dari Kami, yang tetap berlaku sampai hari Kiamat; bahwa kamu dapat mengambil keputusan (sekehendakmu)?"},{"n":40,"w":[["سَلْهُمْ","tanyakan pada mereka","salhum",105],["أَيُّهُم","siapa di antara mereka","ayyuhum",201],["بِذَٰلِكَ","terhadap demikian itu","bidhālika",19],["زَعِيمٌ","bertanggung jawab","zaʿīmun",2827]],"t":"Tanyakanlah kepada mereka, \"Siapakah di antara mereka yang bertanggung jawab terhadap (keputusan yang diambil itu)?\""},{"n":41,"w":[["أَمْ","atau","am",82],["لَهُمْ","bagi mereka","lahum",11],["شُرَكَآءُ","sekutu-sekutu","shurakāu",287],["فَلْيَأْتُوا۟","maka hendaklah mereka mendatangkan","falyatū",48],["بِشُرَكَآئِهِمْ","dengan sekutu-sekutu mereka","bishurakāihim",287],["إِن","jika","in",14],["كَانُوا۟","mereka adalah","kānū",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",202]],"t":"Atau apakah mereka mempunyai sekutu-sekutu? Kalau begitu hendaklah mereka mendatangkan sekutu-sekutunya jika mereka orang-orang yang benar."},{"n":42,"w":[["يَوْمَ","pada hari","yawma",25],["يُكْشَفُ","di buka/di singkap","yuk'shafu",665],["عَن","dari","ʿan",21],["سَاقٍۢ","betis","sāqin",1638],["وَيُدْعَوْنَ","dan mereka di seru/di panggil","wayud'ʿawna",65],["إِلَى","kepada/untuk","ilā",13],["ٱلسُّجُودِ","bersujud","l-sujūdi",1239],["فَلَا","maka tidak","falā",4],["يَسْتَطِيعُونَ","mereka mampu/kuasa","yastaṭīʿūna",280]],"t":"(Ingatlah) pada hari ketika betis disingkapkan dan mereka diseru untuk bersujud; maka mereka tidak mampu,"},{"n":43,"w":[["خَـٰشِعَةً","tertunduk","khāshiʿatan",677],["أَبْصَـٰرُهُمْ","pandangan mereka","abṣāruhum",248],["تَرْهَقُهُمْ","menimpa mereka","tarhaquhum",1439],["ذِلَّةٌۭ ۖ","kehinaan","dhillatun",1033],["وَقَدْ","dan sesungguhnya","waqad",24],["كَانُوا۟","adalah mereka","kānū",9],["يُدْعَوْنَ","mereka di seru/di panggil","yud'ʿawna",65],["إِلَى","kepada/untuk","ilā",13],["ٱلسُّجُودِ","bersujud","l-sujūdi",1239],["وَهُمْ","dan/sedang mereka","wahum",11],["سَـٰلِمُونَ","orang-orang sejahtera","sālimūna",4261]],"t":"pandangan mereka tertunduk ke bawah, diliputi kehinaan. Dan sungguh, dahulu (di dunia) mereka telah diseru untuk bersujud waktu mereka sehat (tetapi mereka tidak melakukan)."},{"n":44,"w":[["فَذَرْنِى","maka biarkan Aku","fadharnī",263],["وَمَن","dan orang","waman",12],["يُكَذِّبُ","ia mendustakan","yukadhibu",63],["بِهَـٰذَا","dengan ini","bihādhā",37],["ٱلْحَدِيثِ ۖ","cerita/perkataan","l-ḥadīthi",386],["سَنَسْتَدْرِجُهُم","kelak Kami menarik mereka berangsur-angsur","sanastadrijuhum",2568],["مِّنْ","dari","min",0],["حَيْثُ","sekira/secara","ḥaythu",374],["لَا","tidak","lā",4],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Maka serahkanlah kepada-Ku (urusannya) dan orang-orang yang mendustakan perkataan ini (Alquran). Kelak akan Kami hukum mereka berangsur-angsur dari arah yang tidak mereka ketahui,"},{"n":45,"w":[["وَأُمْلِى","dan Aku beri waktu/tangguh","wa-um'lī",878],["لَهُمْ ۚ","kepada mereka","lahum",11],["إِنَّ","sesungguhnya","inna",5],["كَيْدِى","tipu daya-KU/rencana-Ku","kaydī",415],["مَتِينٌ","teguh","matīnun",1895]],"t":"dan Aku memberi tenggang waktu kepada mereka. Sungguh, rencana-Ku sangat teguh."},{"n":46,"w":[["أَمْ","atau","am",82],["تَسْـَٔلُهُمْ","kamu meminta mereka","tasaluhum",105],["أَجْرًۭا","upah","ajran",107],["فَهُم","lalu mereka","fahum",11],["مِّن","dari","min",0],["مَّغْرَمٍۢ","hutang","maghramin",1927],["مُّثْقَلُونَ","orang-orang yang dibebani","muth'qalūna",2551]],"t":"Ataukah engkau (Muhammad) meminta imbalan kepada mereka, sehingga mereka dibebani dengan hutang?"},{"n":47,"w":[["أَمْ","atau","am",82],["عِندَهُمُ","di sisi mereka","ʿindahumu",59],["ٱلْغَيْبُ","yang gaib","l-ghaybu",243],["فَهُمْ","lalu mereka","fahum",11],["يَكْتُبُونَ","mereka menulis","yaktubūna",244]],"t":"Ataukah mereka mengetahui yang gaib, lalu mereka menuliskannya?"},{"n":48,"w":[["فَٱصْبِرْ","maka bersabarlah","fa-iṣ'bir",206],["لِحُكْمِ","terhadap ketetapan","liḥuk'mi",363],["رَبِّكَ","Tuhanmu","rabbika",10],["وَلَا","dan jangan","walā",4],["تَكُن","kamu jadi","takun",9],["كَصَاحِبِ","seperti teman/orang","kaṣāḥibi",827],["ٱلْحُوتِ","ikan","l-ḥūti",1311],["إِذْ","ketika","idh",53],["نَادَىٰ","ia menyeru/berdo'a","nādā",270],["وَهُوَ","dan ia","wahuwa",20],["مَكْظُومٌۭ","amat marah","makẓūmun",3694]],"t":"Maka bersabarlah engkau (Muhammad) terhadap ketetapan Tuhanmu, dan janganlah engkau seperti (Yunus) orang yang berada dalam (perut) ikan ketika dia berdoa dengan hati sedih."},{"n":49,"w":[["لَّوْلَآ","kalau tidak","lawlā",152],["أَن","karena","an",16],["تَدَٰرَكَهُۥ","mendapatkannya/ia","tadārakahu",2107],["نِعْمَةٌۭ","nikmat","niʿ'matun",238],["مِّن","dari","min",0],["رَّبِّهِۦ","Tuhannya","rabbihi",10],["لَنُبِذَ","tentu ia dicampakkan","lanubidha",856],["بِٱلْعَرَآءِ","tanah tandus/kosong","bil-ʿarāi",2248],["وَهُوَ","dan ia","wahuwa",20],["مَذْمُومٌۭ","tercela","madhmūmun",1882]],"t":"Sekiranya dia tidak segera mendapat nikmat dari Tuhannya, pastilah dia dicampakkan ke tanah tandus dalam keadaan tercela."},{"n":50,"w":[["فَٱجْتَبَـٰهُ","lalu memilihnya","fa-ij'tabāhu",871],["رَبُّهُۥ","Tuhannya","rabbuhu",10],["فَجَعَلَهُۥ","maka Dia menjadikannya","fajaʿalahu",33],["مِنَ","dari/termasuk","mina",0],["ٱلصَّـٰلِحِينَ","orang-orang yang saleh","l-ṣāliḥīna",181]],"t":"Lalu Tuhannya memilihnya dan menjadikannya termasuk orang yang saleh."},{"n":51,"w":[["وَإِن","dan sesungguhnya","wa-in",14],["يَكَادُ","hampir","yakādu",442],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَيُزْلِقُونَكَ","benar-benar akan menggelincirkan kamu","layuz'liqūnaka",4765],["بِأَبْصَـٰرِهِمْ","dengan pandangan mereka","bi-abṣārihim",248],["لَمَّا","tatkala","lammā",71],["سَمِعُوا۟","mereka mendengar","samiʿū",143],["ٱلذِّكْرَ","peringatan/Al Qur'an","l-dhik'ra",147],["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["إِنَّهُۥ","sesungguhnya","innahu",5],["لَمَجْنُونٌۭ","benar-benar orang gila","lamajnūnun",792]],"t":"Dan sungguh, orang-orang kafir itu hampir-hampir menggelincirkanmu dengan pandangan mata mereka, ketika mereka mendengar Alquran dan mereka berkata, \"Dia (Muhammad) itu benar-benar orang gila.\""},{"n":52,"w":[["وَمَا","dan tidaklah","wamā",2],["هُوَ","ia","huwa",20],["إِلَّا","kecuali","illā",15],["ذِكْرٌۭ","peringatan/pelajaran","dhik'run",147],["لِّلْعَـٰلَمِينَ","bagi alam semesta","lil'ʿālamīna",158]],"t":"Padahal Alquran itu tidak lain adalah peringatan bagi seluruh alam."}]