[{"n":1,"w":[["حمٓ","Haa Miim","hha-meem",1060]],"t":"Ḥā Mīm."},{"n":2,"w":[["عٓسٓقٓ","'Ain Siin Qaaf","ain-seen-qaf",3231]],"t":"Aīn Sīn Qāf."},{"n":3,"w":[["كَذَٰلِكَ","demikianlah","kadhālika",19],["يُوحِىٓ","Dia mewahyukan","yūḥī",165],["إِلَيْكَ","kepadamu","ilayka",13],["وَإِلَى","dan kepada","wa-ilā",13],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلِكَ","sebelum kamu","qablika",51],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",110],["ٱلْحَكِيمُ","Maha Bijaksana","l-ḥakīmu",112]],"t":"Demikianlah Allah Yang Mahaperkasa, Mahabijaksana mewahyukan kepadamu (Muhammad) dan kepada orang-orang yang sebelummu."},{"n":4,"w":[["لَهُۥ","kepunyaan-Nya","lahu",16],["مَا","apa","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan apa","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",22],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَلِىُّ","Maha Tinggi","l-ʿaliyu",769],["ٱلْعَظِيمُ","Maha Besar","l-ʿaẓīmu",98]],"t":"Milik-Nyalah apa yang ada di langit dan apa yang ada di bumi. Dan Dialah Yang Mahaagung, Mahabesar."},{"n":5,"w":[["تَكَادُ","hampir","takādu",441],["ٱلسَّمَـٰوَٰتُ","langit(jamak)","l-samāwātu",38],["يَتَفَطَّرْنَ","pecah/terbelah","yatafaṭṭarna",833],["مِن","dari","min",0],["فَوْقِهِنَّ ۚ","atasnya","fawqihinna",284],["وَٱلْمَلَـٰٓئِكَةُ","dan malaikat","wal-malāikatu",123],["يُسَبِّحُونَ","mereka bertasbih","yusabbiḥūna",276],["بِحَمْدِ","dengan memuji","biḥamdi",271],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["وَيَسْتَغْفِرُونَ","dan mereka memohonkan ampun","wayastaghfirūna",296],["لِمَن","bagi orang","liman",12],["فِى","di","fī",3],["ٱلْأَرْضِ ۗ","bumi","l-arḍi",22],["أَلَآ","ingatlah","alā",299],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["هُوَ","Dia","huwa",20],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",118],["ٱلرَّحِيمُ","Maha penyayang","l-raḥīmu",101]],"t":"Hampir saja langit itu pecah dari sebelah atasnya (karena kebesaran Allah) dan malaikat-malaikat bertasbih memuji Tuhannya dan memohonkan ampunan untuk orang yang ada di bumi. Ingatlah, sesungguhnya Allah Dialah Yang Maha Pengampun, Maha Penyayang."},{"n":6,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["ٱتَّخَذُوا۟","mengambil","ittakhadhū",95],["مِن","dari","min",0],["دُونِهِۦٓ","selain Dia","dūnihi",78],["أَوْلِيَآءَ","pelindung-pelindung","awliyāa",128],["ٱللَّهُ","Allah","l-lahu",1],["حَفِيظٌ","Penjaga","ḥafīẓun",720],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["وَمَآ","dan tidaklah","wamā",2],["أَنتَ","kamu","anta",139],["عَلَيْهِم","atas mereka","ʿalayhim",8],["بِوَكِيلٍۢ","pengawal/pengurus","biwakīlin",444]],"t":"Dan orang-orang yang mengambil pelindung-pelindung selain-Nya, Allah mengawasi (perbuatan) mereka; adapun engkau (Muhammad) bukanlah orang yang diserahi mengawasi mereka."},{"n":7,"w":[["وَكَذَٰلِكَ","dan demikian","wakadhālika",19],["أَوْحَيْنَآ","Kami wahyukan","awḥaynā",165],["إِلَيْكَ","kepadamu","ilayka",13],["قُرْءَانًا","Al Qur'an","qur'ānan",175],["عَرَبِيًّۭا","bahasa Arab","ʿarabiyyan",771],["لِّتُنذِرَ","supaya kamu memberi peringatan","litundhira",264],["أُمَّ","ibu","umma",338],["ٱلْقُرَىٰ","kota","l-qurā",211],["وَمَنْ","dan orang yang","waman",12],["حَوْلَهَا","sekelilingnya","ḥawlahā",567],["وَتُنذِرَ","dan kamu memberi peringatan","watundhira",264],["يَوْمَ","pada hari","yawma",25],["ٱلْجَمْعِ","berkumpul","l-jamʿi",688],["لَا","tidak ada","lā",4],["رَيْبَ","keraguan","rayba",556],["فِيهِ ۚ","didalamnya","fīhi",3],["فَرِيقٌۭ","segolongan","farīqun",344],["فِى","dalam","fī",3],["ٱلْجَنَّةِ","surga","l-janati",76],["وَفَرِيقٌۭ","dan segolongan","wafarīqun",344],["فِى","dalam","fī",3],["ٱلسَّعِيرِ","neraka","l-saʿīri",605]],"t":"Dan demikianlah Kami wahyukan Alquran kepadamu dalam bahasa Arab, agar engkau memberi peringatan kepada penduduk ibukota (Mekkah) dan penduduk (negeri-negeri) di sekelilingnya serta memberi peringatan tentang hari berkumpul (Kiamat) yang tidak diragukan adanya. Segolongan masuk surga dan segolongan masuk neraka."},{"n":8,"w":[["وَلَوْ","dan jika","walaw",57],["شَآءَ","menghendaki","shāa",54],["ٱللَّهُ","Allah","l-lahu",1],["لَجَعَلَهُمْ","tentu Dia menjadikan mereka","lajaʿalahum",33],["أُمَّةًۭ","ummat","ummatan",188],["وَٰحِدَةًۭ","satu","wāḥidatan",359],["وَلَـٰكِن","akan tetapi","walākin",162],["يُدْخِلُ","Dia memasukkan","yud'khilu",274],["مَن","orang yang","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["فِى","ke dalam","fī",3],["رَحْمَتِهِۦ ۚ","rahmat-Nya","raḥmatihi",103],["وَٱلظَّـٰلِمُونَ","dan orang-orang yang zalim","wal-ẓālimūna",89],["مَا","tidaklah","mā",2],["لَهُم","bagi mereka","lahum",11],["مِّن","dari","min",0],["وَلِىٍّۢ","seorang pelindung","waliyyin",128],["وَلَا","dan tidak","walā",4],["نَصِيرٍ","seorang penolong","naṣīrin",332]],"t":"Dan sekiranya Allah menghendaki, niscaya Dia jadikan mereka satu umat, tetapi Dia memasukkan orang-orang yang Dia kehendaki ke dalam rahmat-Nya. Dan orang-orang yang zalim tidak ada bagi mereka pelindung dan penolong."},{"n":9,"w":[["أَمِ","atau","ami",82],["ٱتَّخَذُوا۟","mereka mengambil","ittakhadhū",95],["مِن","dari","min",0],["دُونِهِۦٓ","selain Dia","dūnihi",78],["أَوْلِيَآءَ ۖ","pelindung-pelindung","awliyāa",128],["فَٱللَّهُ","maka Allah","fal-lahu",1],["هُوَ","Dia","huwa",20],["ٱلْوَلِىُّ","pelindung","l-waliyu",128],["وَهُوَ","dan Dia","wahuwa",20],["يُحْىِ","menghidupkan","yuḥ'yī",230],["ٱلْمَوْتَىٰ","orang-orang yang mati","l-mawtā",310],["وَهُوَ","dan Dia","wahuwa",20],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌۭ","Maha kuasa","qadīrun",260]],"t":"Atau mereka mengambil pelindung-pelindung selain Dia? Padahal Allah, Dialah pelindung (yang sebenarnya). Dan Dia menghidupkan orang yang mati, dan Dia Mahakuasa atas segala sesuatu."},{"n":10,"w":[["وَمَا","dan apa yang","wamā",2],["ٱخْتَلَفْتُمْ","kamu perselisihkan","ikh'talaftum",336],["فِيهِ","didalamnya","fīhi",3],["مِن","dari","min",0],["شَىْءٍۢ","sesuatu","shayin",41],["فَحُكْمُهُۥٓ","maka hukumnya","faḥuk'muhu",362],["إِلَى","kepada","ilā",13],["ٱللَّهِ ۚ","Allah","l-lahi",1],["ذَٰلِكُمُ","demikian itu","dhālikumu",19],["ٱللَّهُ","Allah","l-lahu",1],["رَبِّى","Tuhanku","rabbī",10],["عَلَيْهِ","atas-Nya","ʿalayhi",8],["تَوَكَّلْتُ","aku bertawakkal","tawakkaltu",292],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["أُنِيبُ","aku kembali","unību",763]],"t":"Dan apa pun yang kamu perselisihkan padanya tentang sesuatu, keputusannya (terserah) kepada Allah. (Yang memiliki sifat-sifat demikian) itulah Allah Tuhanku. Kepada-Nya aku bertawakal dan kepada-Nya aku kembali."},{"n":11,"w":[["فَاطِرُ","pencipta","fāṭiru",1175],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["جَعَلَ","Dia menjadikan","jaʿala",33],["لَكُم","bagi kalian","lakum",26],["مِّنْ","dari","min",0],["أَنفُسِكُمْ","diri kalian sendiri","anfusikum",39],["أَزْوَٰجًۭا","berpasang-pasangan","azwājan",152],["وَمِنَ","dan dari","wamina",0],["ٱلْأَنْعَـٰمِ","binatang ternak","l-anʿāmi",347],["أَزْوَٰجًۭا ۖ","berpasang-pasangan","azwājan",152],["يَذْرَؤُكُمْ","Dia menjadikan kamu berkembang","yadhra-ukum",1132],["فِيهِ ۚ","padanya","fīhi",3],["لَيْسَ","tidak ada","laysa",119],["كَمِثْلِهِۦ","serupa dengan Dia","kamith'lihi",155],["شَىْءٌۭ ۖ","sesuatu","shayon",41],["وَهُوَ","dan Dia","wahuwa",20],["ٱلسَّمِيعُ","Maha Mendengar","l-samīʿu",252],["ٱلْبَصِيرُ","Maha Melihat","l-baṣīru",232]],"t":"(Allah) Pencipta langit dan bumi. Dia menjadikan bagi kamu pasangan-pasangan dari jenis kamu sendiri, dan dari jenis hewan ternak pasangan-pasangan (juga). Dijadikan-Nya kamu berkembang biak dengan jalan itu. Tidak ada sesuatu pun yang serupa dengan Dia. Dan Dia Yang Maha Mendengar, Maha Melihat."},{"n":12,"w":[["لَهُۥ","bagi-Nya","lahu",16],["مَقَالِيدُ","perbendaharaan","maqālīdu",2458],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۖ","dan bumi","wal-arḍi",22],["يَبْسُطُ","Dia lapangkan","yabsuṭu",592],["ٱلرِّزْقَ","rezeki","l-riz'qa",219],["لِمَن","bagi siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَقْدِرُ ۚ","dan Dia sempitkan","wayaqdiru",430],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍ","sesuatu","shayin",41],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",68]],"t":"Milik-Nyalah perbendaharaan langit dan bumi; Dia melapangkan rezeki dan membatasinya bagi siapa yang Dia kehendaki. Sungguh, Dia Maha Mengetahui segala sesuatu."},{"n":13,"w":[["۞ شَرَعَ","Dia mensyari'atkan","sharaʿa",2121],["لَكُم","bagi kalian","lakum",26],["مِّنَ","dari pada","mina",0],["ٱلدِّينِ","agama","l-dīni",116],["مَا","apa yang","mā",2],["وَصَّىٰ","diwasiatkan","waṣṣā",804],["بِهِۦ","dengannya","bihi",16],["نُوحًۭا","Nuh","nūḥan",272],["وَٱلَّذِىٓ","dan yang","wa-alladhī",7],["أَوْحَيْنَآ","Kami wahyukan","awḥaynā",165],["إِلَيْكَ","kepadamu","ilayka",13],["وَمَا","dan apa","wamā",2],["وَصَّيْنَا","yang Kami wasiatkan","waṣṣaynā",804],["بِهِۦٓ","dengannya","bihi",16],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",178],["وَمُوسَىٰ","dan Musa","wamūsā",83],["وَعِيسَىٰٓ ۖ","dan 'Isa","waʿīsā",422],["أَنْ","hendaklah","an",17],["أَقِيمُوا۟","kamu tegakkan","aqīmū",220],["ٱلدِّينَ","agama","l-dīna",116],["وَلَا","dan jangan","walā",4],["تَتَفَرَّقُوا۟","kamu berpecah belah","tatafarraqū",1002],["فِيهِ ۚ","didalamnya","fīhi",3],["كَبُرَ","amat berat","kabura",978],["عَلَى","atas","ʿalā",8],["ٱلْمُشْرِكِينَ","orang-orang yang musyrik","l-mush'rikīna",268],["مَا","apa (agama) yang","mā",2],["تَدْعُوهُمْ","kamu seru mereka","tadʿūhum",65],["إِلَيْهِ ۚ","kepadanya","ilayhi",13],["ٱللَّهُ","Allah","l-lahu",1],["يَجْتَبِىٓ","Dia memilih","yajtabī",868],["إِلَيْهِ","kepadanya","ilayhi",13],["مَن","siapa yang","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["وَيَهْدِىٓ","dan Dia memberi petunjuk","wayahdī",79],["إِلَيْهِ","kepadanya","ilayhi",13],["مَن","siapa","man",12],["يُنِيبُ","ia kembali","yunību",763]],"t":"Dia (Allah) telah mensyariatkan kepadamu agama yang telah diwasiatkan-Nya kepada Nuh dan apa yang telah Kami wahyukan kepadamu (Muhammad) dan apa yang telah Kami wasiatkan kepada Ibrahim, Musa dan Isa, yaitu tegakkanlah agama (keimanan dan ketakwaan) dan janganlah kamu berpecah belah di dalamnya. Sangat berat bagi orang-orang musyrik (untuk mengikuti) agama yang kamu serukan kepada mereka. Allah memilih orang yang Dia kehendaki kepada agama tauhid dan memberi petunjuk kepada (agama)-Nya bagi orang yang kembali (kepada-Nya)."},{"n":14,"w":[["وَمَا","dan tidak","wamā",2],["تَفَرَّقُوٓا۟","mereka berpecah belah","tafarraqū",1002],["إِلَّا","kecuali","illā",15],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["مَا","apa yang","mā",2],["جَآءَهُمُ","datang kepada mereka","jāahumu",43],["ٱلْعِلْمُ","pengetahuan","l-ʿil'mu",108],["بَغْيًۢا","kedengkian","baghyan",778],["بَيْنَهُمْ ۚ","diantara mereka","baynahum",47],["وَلَوْلَا","dan kalau tidak","walawlā",154],["كَلِمَةٌۭ","kalimat/ketetapan","kalimatun",387],["سَبَقَتْ","telah lewat/lalu","sabaqat",519],["مِن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["إِلَىٰٓ","sampai pada","ilā",13],["أَجَلٍۢ","waktu","ajalin",226],["مُّسَمًّۭى","ditentukan","musamman",494],["لَّقُضِىَ","pasti diputuskan","laquḍiya",204],["بَيْنَهُمْ ۚ","diantara mereka","baynahum",47],["وَإِنَّ","dan sesunguhnya","wa-inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["أُورِثُوا۟","mereka diwarisi","ūrithū",715],["ٱلْكِتَـٰبَ","kitab","l-kitāba",49],["مِنۢ","dari","min",0],["بَعْدِهِمْ","sesudah mereka","baʿdihim",58],["لَفِى","benar-benar dalam","lafī",3],["شَكٍّۢ","keragu-raguan","shakkin",613],["مِّنْهُ","daripadanya","min'hu",0],["مُرِيبٍۢ","kebimbangan","murībin",1089]],"t":"Dan mereka (Ahli Kitab) tidak berpecah belah kecuali setelah datang kepada mereka ilmu (kebenaran yang disampaikan oleh para nabi), karena kedengkian antara sesama mereka. Jika tidaklah karena suatu ketetapan yang telah ada dahulunya dari Tuhanmu (untuk menangguhkan azab) sampai batas waktu yang ditentukan, pastilah hukuman bagi mereka telah dilaksanakan. Dan sesungguhnya orang-orang yang mewarisi Kitab (Taurat dan Injil) setelah mereka (pada zaman Muhammad), benar-benar berada dalam keraguan yang mendalam tentang Kitab (Alquran) itu."},{"n":15,"w":[["فَلِذَٰلِكَ","maka karena itu","falidhālika",19],["فَٱدْعُ ۖ","serulah","fa-ud'ʿu",65],["وَٱسْتَقِمْ","dan tetaplah","wa-is'taqim",869],["كَمَآ","sebagaimana","kamā",2],["أُمِرْتَ ۖ","kamu diperintah","umir'ta",147],["وَلَا","dan janganlah","walā",4],["تَتَّبِعْ","kamu mengikuti","tattabiʿ",84],["أَهْوَآءَهُمْ ۖ","hawa nafsu mereka","ahwāahum",563],["وَقُلْ","dan katakan","waqul",6],["ءَامَنتُ","aku beriman","āmantu",18],["بِمَآ","dengan apa yang","bimā",2],["أَنزَلَ","menurunkan","anzala",61],["ٱللَّهُ","Allah","l-lahu",1],["مِن","dari","min",0],["كِتَـٰبٍۢ ۖ","kitab","kitābin",49],["وَأُمِرْتُ","dan aku diperintah","wa-umir'tu",147],["لِأَعْدِلَ","untuk berbuat adil","li-aʿdila",653],["بَيْنَكُمُ ۖ","diantara kamu","baynakumu",47],["ٱللَّهُ","Allah","l-lahu",1],["رَبُّنَا","Tuhan kami","rabbunā",10],["وَرَبُّكُمْ ۖ","dan Tuhan kamu","warabbukum",10],["لَنَآ","bagi kami","lanā",121],["أَعْمَـٰلُنَا","amal-amal kami","aʿmālunā",170],["وَلَكُمْ","dan bagi kamu","walakum",26],["أَعْمَـٰلُكُمْ ۖ","amal-pamal kamu","aʿmālukum",170],["لَا","tidak ada","lā",4],["حُجَّةَ","pertengkaran","ḥujjata",1059],["بَيْنَنَا","diantara kami","baynanā",47],["وَبَيْنَكُمُ ۖ","dan diantara kamu","wabaynakumu",47],["ٱللَّهُ","Allah","l-lahu",1],["يَجْمَعُ","Dia akan mengumpulkan","yajmaʿu",467],["بَيْنَنَا ۖ","diantara kami","baynanā",47],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",388]],"t":"Karena itu, serulah (mereka beriman) dan tetaplah (beriman dan berdakwah) sebagaimana diperintahkan kepadamu (Muhammad) dan janganlah mengikuti keinginan mereka dan katakanlah, \"Aku beriman kepada Kitab yang diturunkan Allah dan aku diperintahkan agar berlaku adil di antara kamu. Allah Tuhan kami dan Tuhan kamu. Bagi kami perbuatan kami dan bagi kamu perbuatan kamu. Tidak (perlu) ada pertengkaran antara kami dan kamu, Allah mengumpulkan antara kita dan kepada-Nyalah (kita) kembali.\""},{"n":16,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["يُحَآجُّونَ","mereka membantah","yuḥājjūna",718],["فِى","pada","fī",3],["ٱللَّهِ","Allah","l-lahi",1],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["مَا","apa(agama)","mā",2],["ٱسْتُجِيبَ","diterima","us'tujība",394],["لَهُۥ","padanya","lahu",16],["حُجَّتُهُمْ","bantahan mereka","ḥujjatuhum",1059],["دَاحِضَةٌ","batil/sia-sia","dāḥiḍatun",3376],["عِندَ","di sisi","ʿinda",59],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["وَعَلَيْهِمْ","dan atas mereka","waʿalayhim",8],["غَضَبٌۭ","kemurkaan","ghaḍabun",661],["وَلَهُمْ","dan bagi mereka","walahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌ","sangat keras","shadīdun",213]],"t":"Dan orang-orang yang berbantah-bantah tentang (agama) Allah setelah (agama itu) diterima, perbantahan mereka itu sia-sia di sisi Tuhan mereka. Mereka mendapat kemurkaan (Allah) dan mereka mendapat azab yang sangat keras."},{"n":17,"w":[["ٱللَّهُ","Allah","al-lahu",1],["ٱلَّذِىٓ","yang","alladhī",7],["أَنزَلَ","menurunkan","anzala",61],["ٱلْكِتَـٰبَ","kitab","l-kitāba",49],["بِٱلْحَقِّ","dengan kebenaran","bil-ḥaqi",50],["وَٱلْمِيزَانَ ۗ","dan neraca","wal-mīzāna",600],["وَمَا","dan tidaklah","wamā",2],["يُدْرِيكَ","kamu mengetahui","yud'rīka",562],["لَعَلَّ","barangkali","laʿalla",96],["ٱلسَّاعَةَ","kiamat","l-sāʿata",250],["قَرِيبٌۭ","dekat","qarībun",416]],"t":"Allah yang menurunkan kitab (Alquran) dengan (membawa) kebenaran dan neraca (keadilan). Dan tahukah kamu, boleh jadi hari Kiamat itu sudah dekat?"},{"n":18,"w":[["يَسْتَعْجِلُ","minta disegerakan","yastaʿjilu",535],["بِهَا","dengannya(kiamat)","bihā",94],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","tidak","lā",4],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18],["بِهَا ۖ","dengannya","bihā",94],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["ءَامَنُوا۟","mereka beriman","āmanū",18],["مُشْفِقُونَ","merasa takut","mush'fiqūna",986],["مِنْهَا","daripadanya","min'hā",0],["وَيَعْلَمُونَ","dan mereka mengetahui","wayaʿlamūna",29],["أَنَّهَا","bahwasanya ia(kiamat)","annahā",30],["ٱلْحَقُّ ۗ","benar","l-ḥaqu",50],["أَلَآ","ingatlah","alā",299],["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُمَارُونَ","mereka membantah","yumārūna",1648],["فِى","pada","fī",3],["ٱلسَّاعَةِ","hari kiamat","l-sāʿati",250],["لَفِى","benar-benar dalam","lafī",3],["ضَلَـٰلٍۭ","kesesatan","ḍalālin",306],["بَعِيدٍ","jauh","baʿīdin",424]],"t":"Orang-orang yang tidak percaya adanya hari Kiamat meminta agar hari itu segera terjadi, dan orang-orang yang beriman merasa takut kepadanya dan mereka yakin bahwa Kiamat itu adalah benar (akan terjadi). Ketahuilah bahwa sesungguhnya orang-orang yang membantah tentang terjadinya Kiamat itu benar-benar telah tersesat jauh."},{"n":19,"w":[["ٱللَّهُ","Allah","al-lahu",1],["لَطِيفٌۢ","Maha Lembut","laṭīfun",1085],["بِعِبَادِهِۦ","terhadap hamba-hamba-Nya","biʿibādihi",87],["يَرْزُقُ","Dia memberi rezeki","yarzuqu",198],["مَن","siapa","man",12],["يَشَآءُ ۖ","Dia kehendaki","yashāu",54],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْقَوِىُّ","Maha Kuat","l-qawiyu",798],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",110]],"t":"Allah Mahalembut terhadap hamba-hamba-Nya; Dia memberi rezeki kepada siapa yang Dia kehendaki, dan Dia Mahakuat, Mahaperkasa."},{"n":20,"w":[["مَن","barang siapa","man",12],["كَانَ","adalah","kāna",9],["يُرِيدُ","menghendaki","yurīdu",81],["حَرْثَ","keuntungan","ḥartha",681],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",72],["نَزِدْ","Kami tambahkan","nazid",246],["لَهُۥ","baginya","lahu",16],["فِى","pada","fī",3],["حَرْثِهِۦ ۖ","keuntungan itu","ḥarthihi",681],["وَمَن","dan barang siapa","waman",12],["كَانَ","adalah","kāna",9],["يُرِيدُ","menghendaki","yurīdu",81],["حَرْثَ","keuntungan","ḥartha",681],["ٱلدُّنْيَا","dunia","l-dun'yā",102],["نُؤْتِهِۦ","Kami berikan kepadanya","nu'tihi",45],["مِنْهَا","daripadanya(keuntungan itu)","min'hā",0],["وَمَا","tidak ada","wamā",2],["لَهُۥ","baginya","lahu",16],["فِى","di","fī",3],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",72],["مِن","dari","min",0],["نَّصِيبٍ","bahagian","naṣībin",495]],"t":"Barangsiapa menghendaki keuntungan di akhirat akan Kami tambahkan keuntungan itu baginya, dan barangsiapa menghendaki keuntungan di dunia Kami berikan kepadanya sebagian darinya (keuntungan dunia), tetapi dia tidak akan mendapat bagian di akhirat."},{"n":21,"w":[["أَمْ","atau","am",82],["لَهُمْ","mereka mempunyai","lahum",11],["شُرَكَـٰٓؤُا۟","sekutu-sekutu","shurakāu",286],["شَرَعُوا۟","mereka mensyari'atkan","sharaʿū",2121],["لَهُم","bagi mereka","lahum",11],["مِّنَ","daripada","mina",0],["ٱلدِّينِ","agama","l-dīni",116],["مَا","apa-apa","mā",2],["لَمْ","tidak","lam",32],["يَأْذَنۢ","mengizinkan","yadhan",450],["بِهِ","dengannya","bihi",16],["ٱللَّهُ ۚ","Allah","l-lahu",1],["وَلَوْلَا","dan jika tidak","walawlā",154],["كَلِمَةُ","kalimat/ketetapan","kalimatu",387],["ٱلْفَصْلِ","putusan","l-faṣli",897],["لَقُضِىَ","niscaya diputuskan","laquḍiya",204],["بَيْنَهُمْ ۗ","diantara mereka","baynahum",47],["وَإِنَّ","dan sesungguhnya","wa-inna",5],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",164]],"t":"Apakah mereka mempunyai sesembahan selain Allah yang menetapkan aturan agama bagi mereka yang tidak diizinkan (diridai) Allah? Dan sekiranya tidak ada ketetapan yang menunda (hukuman dari Allah) tentulah hukuman di antara mereka telah dilaksanakan. Dan sungguh, orang-orang zalim itu akan mendapatkan azab yang sangat pedih."},{"n":22,"w":[["تَرَى","kamu akan melihat","tarā",46],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89],["مُشْفِقِينَ","mereka ketakutan","mush'fiqīna",986],["مِمَّا","karena apa(kejahatan)","mimmā",0],["كَسَبُوا۟","mereka kerjakan","kasabū",196],["وَهُوَ","dan ia/balasannya","wahuwa",20],["وَاقِعٌۢ","menimpa","wāqiʿun",1241],["بِهِمْ ۗ","pada mereka","bihim",11],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebaikan","l-ṣāliḥāti",195],["فِى","dalam","fī",3],["رَوْضَاتِ","taman-taman","rawḍāti",4195],["ٱلْجَنَّاتِ ۖ","surga","l-janāti",76],["لَهُم","bagi mereka","lahum",11],["مَّا","apa yang","mā",2],["يَشَآءُونَ","mereka kehendaki","yashāūna",54],["عِندَ","di sisi","ʿinda",59],["رَبِّهِمْ ۚ","Tuhan mereka","rabbihim",10],["ذَٰلِكَ","demikian itu","dhālika",19],["هُوَ","ia","huwa",20],["ٱلْفَضْلُ","karunia","l-faḍlu",131],["ٱلْكَبِيرُ","besar","l-kabīru",290]],"t":"Kamu akan melihat orang-orang zalim itu sangat ketakutan karena (kejahatan-kejahatan) yang telah mereka lakukan, dan (azab) menimpa mereka. Dan orang-orang yang beriman dan mengerjakan kebajikan (berada) di dalam taman-taman surga, mereka memperoleh apa yang mereka kehendaki di sisi Tuhan. Yang demikian itu adalah karunia yang besar."},{"n":23,"w":[["ذَٰلِكَ","demikian itu","dhālika",19],["ٱلَّذِى","yang","alladhī",7],["يُبَشِّرُ","menggembirakan","yubashiru",307],["ٱللَّهُ","Allah","l-lahu",1],["عِبَادَهُ","hamba-hamba-Nya","ʿibādahu",87],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan mereka beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ ۗ","kebaikan","l-ṣāliḥāti",195],["قُل","katakanlah","qul",6],["لَّآ","tidak","lā",4],["أَسْـَٔلُكُمْ","aku minta kepadamu","asalukum",105],["عَلَيْهِ","atasnya","ʿalayhi",8],["أَجْرًا","upah","ajran",107],["إِلَّا","kecuali","illā",15],["ٱلْمَوَدَّةَ","kasih sayang","l-mawadata",992],["فِى","dalam","fī",3],["ٱلْقُرْبَىٰ ۗ","kekeluargaan","l-qur'bā",603],["وَمَن","dan barang siapa","waman",12],["يَقْتَرِفْ","mengerjakan","yaqtarif",1694],["حَسَنَةًۭ","kebaikan","ḥasanatan",386],["نَّزِدْ","Kami tambahkan","nazid",246],["لَهُۥ","baginya","lahu",16],["فِيهَا","padanya","fīhā",3],["حُسْنًا ۚ","kebaikan","ḥus'nan",682],["إِنَّ","sesungguhnya","inna",5],["ٱللَّهَ","Allah","l-laha",1],["غَفُورٌۭ","Maha Pengampun","ghafūrun",118],["شَكُورٌ","Maha mensyukuri","shakūrun",810]],"t":"Itulah (karunia) yang diberitahukan Allah untuk menggembirakan hamba-hamba-Nya yang beriman dan mengerjakan kebajikan. Katakanlah (Muhammad), \"Aku tidak meminta kepadamu sesuatu imbalan pun atas seruanku kecuali kasih sayang dalam kekeluargaan.\" Dan barangsiapa mengerjakan kebaikan akan Kami tambahkan kebaikan baginya. Sungguh, Allah Maha Pengampun, Maha Mensyukuri."},{"n":24,"w":[["أَمْ","atau","am",82],["يَقُولُونَ","mereka mengatakan","yaqūlūna",6],["ٱفْتَرَىٰ","dia mengada-adakan","if'tarā",239],["عَلَى","terhadap","ʿalā",8],["ٱللَّهِ","Allah","l-lahi",1],["كَذِبًۭا ۖ","dusta","kadhiban",345],["فَإِن","maka jika","fa-in",14],["يَشَإِ","menghendaki","yasha-i",54],["ٱللَّهُ","Allah","l-lahu",1],["يَخْتِمْ","Dia menutup","yakhtim",1421],["عَلَىٰ","atas","ʿalā",8],["قَلْبِكَ ۗ","hatimu","qalbika",86],["وَيَمْحُ","dan menghapuskan","wayamḥu",1882],["ٱللَّهُ","Allah","l-lahu",1],["ٱلْبَـٰطِلَ","bathil","l-bāṭila",412],["وَيُحِقُّ","dan Dia membenarkan","wayuḥiqqu",1681],["ٱلْحَقَّ","benar","l-ḥaqa",50],["بِكَلِمَـٰتِهِۦٓ ۚ","dengan kalimat-kalimat-Nya","bikalimātihi",664],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِيمٌۢ","Maha Mengetahui","ʿalīmun",68],["بِذَاتِ","dengan yang ada","bidhāti",113],["ٱلصُّدُورِ","dada","l-ṣudūri",266]],"t":"Ataukah mereka mengatakan, \"Dia (Muhammad) telah mengada-adakan kebohongan tentang Allah.\" Sekiranya Allah menghendaki niscaya Dia kunci hatimu. Dan Allah menghapus yang batil dan membenarkan yang benar dengan firman-Nya (Alquran). Sungguh, Dia Maha Mengetahui segala isi hati."},{"n":25,"w":[["وَهُوَ","dan Dia","wahuwa",20],["ٱلَّذِى","yang","alladhī",7],["يَقْبَلُ","menerima","yaqbalu",937],["ٱلتَّوْبَةَ","taubat","l-tawbata",1111],["عَنْ","dari","ʿan",21],["عِبَادِهِۦ","hamba-hamba-Nya","ʿibādihi",87],["وَيَعْفُوا۟","dan Dia memaafkan","wayaʿfū",397],["عَنِ","dari","ʿani",21],["ٱلسَّيِّـَٔاتِ","kesalahan-kesalahan","l-sayiāti",325],["وَيَعْلَمُ","dan Dia mengetahui","wayaʿlamu",29],["مَا","apa yang","mā",2],["تَفْعَلُونَ","kamu kerjakan","tafʿalūna",122]],"t":"Dan Dialah yang menerima tobat dari hamba-hamba-Nya dan memaafkan kesalahan-kesalahan dan mengetahui apa yang kamu kerjakan,"},{"n":26,"w":[["وَيَسْتَجِيبُ","dan Dia memperkenankan","wayastajību",394],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan beramal","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","kebaikan","l-ṣāliḥāti",195],["وَيَزِيدُهُم","dan Dia menambah mereka","wayazīduhum",246],["مِّن","dari","min",0],["فَضْلِهِۦ ۚ","karunia-Nya","faḍlihi",131],["وَٱلْكَـٰفِرُونَ","dan orang-orang kafir","wal-kāfirūna",90],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌۭ","azab","ʿadhābun",36],["شَدِيدٌۭ","sangat keras","shadīdun",213]],"t":"dan Dia memperkenankan (doa) orang-orang yang beriman dan mengerjakan kebajikan serta menambah (pahala) kepada mereka dari karunia-Nya. Orang-orang yang ingkar akan mendapat azab yang sangat keras."},{"n":27,"w":[["۞ وَلَوْ","dan jika","walaw",57],["بَسَطَ","melapangkan","basaṭa",592],["ٱللَّهُ","Allah","l-lahu",1],["ٱلرِّزْقَ","rezeki","l-riz'qa",219],["لِعِبَادِهِۦ","bagi hamba-hamba-Nya","liʿibādihi",87],["لَبَغَوْا۟","tentu mereka akan melampaui batas","labaghaw",425],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَلَـٰكِن","tetapi","walākin",162],["يُنَزِّلُ","Dia menurunkan","yunazzilu",197],["بِقَدَرٍۢ","dengan ketentuan/ukuran","biqadarin",797],["مَّا","apa yang","mā",2],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["إِنَّهُۥ","sesungguhnya","innahu",5],["بِعِبَادِهِۦ","terhadap hamba-hamba-Nya","biʿibādihi",87],["خَبِيرٌۢ","Maha Mengetahui","khabīrun",261],["بَصِيرٌۭ","Maha Melihat","baṣīrun",232]],"t":"Dan sekiranya Allah melapangkan rezeki kepada hamba-hamba-Nya niscaya mereka akan berbuat melampaui batas di bumi, tetapi Dia menurunkan dengan ukuran yang Dia kehendaki. Sungguh, Dia Mahateliti terhadap (keadaan) hamba-hamba-Nya, Maha Melihat."},{"n":28,"w":[["وَهُوَ","dan Dia","wahuwa",20],["ٱلَّذِى","yang","alladhī",7],["يُنَزِّلُ","menurunkan","yunazzilu",197],["ٱلْغَيْثَ","hujan","l-ghaytha",1849],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["مَا","apa","mā",2],["قَنَطُوا۟","mereka berputus asa","qanaṭū",1620],["وَيَنشُرُ","dan Dia menyebarkan","wayanshuru",1947],["رَحْمَتَهُۥ ۚ","rahmat-Nya","raḥmatahu",103],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْوَلِىُّ","Maha Pelindung","l-waliyu",128],["ٱلْحَمِيدُ","Maha Terpuji","l-ḥamīdu",566]],"t":"Dan Dialah yang menurunkan hujan setelah mereka berputus asa dan menyebarkan rahmat-Nya. Dan Dialah Maha Pelindung, Maha Terpuji."},{"n":29,"w":[["وَمِنْ","dan diantara","wamin",0],["ءَايَـٰتِهِۦ","tanda-tanda-Nya","āyātihi",28],["خَلْقُ","ciptaan","khalqu",229],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ","dan bumi","wal-arḍi",22],["وَمَا","dan apa yang","wamā",2],["بَثَّ","bertebaran","batha",1326],["فِيهِمَا","pada keduanya","fīhimā",3],["مِن","dari","min",0],["دَآبَّةٍۢ ۚ","makhluk melata","dābbatin",547],["وَهُوَ","dan Dia","wahuwa",20],["عَلَىٰ","atas","ʿalā",8],["جَمْعِهِمْ","mengumpulkan mereka","jamʿihim",688],["إِذَا","apabila","idhā",23],["يَشَآءُ","Dia menghendaki","yashāu",54],["قَدِيرٌۭ","Maha Kuasa","qadīrun",260]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya adalah penciptaan langit dan bumi dan makhluk-makhluk melata yang Dia sebarkan pada keduanya. Dan Dia Mahakuasa mengumpulkan semuanya apabila Dia kehendaki."},{"n":30,"w":[["وَمَآ","dan apa yang","wamā",2],["أَصَـٰبَكُم","menimpa kamu","aṣābakum",187],["مِّن","dari suatu","min",0],["مُّصِيبَةٍۢ","musibah","muṣībatin",850],["فَبِمَا","maka disebabkan","fabimā",2],["كَسَبَتْ","perbuatan","kasabat",196],["أَيْدِيكُمْ","tangan-tanganmu","aydīkum",99],["وَيَعْفُوا۟","dan Dia memaafkan","wayaʿfū",397],["عَن","dari","ʿan",21],["كَثِيرٍۢ","kebanyakan","kathīrin",191]],"t":"Dan musibah apapun yang menimpa kamu adalah karena perbuatan tanganmu sendiri, dan Allah memaafkan banyak (dari kesalahan-kesalahanmu)."},{"n":31,"w":[["وَمَآ","dan tidaklah","wamā",2],["أَنتُم","kamu","antum",85],["بِمُعْجِزِينَ","dengan melepaskan","bimuʿ'jizīna",734],["فِى","di","fī",3],["ٱلْأَرْضِ ۖ","bumi","l-arḍi",22],["وَمَا","dan tidak ada","wamā",2],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["دُونِ","selain","dūni",78],["ٱللَّهِ","Allah","l-lahi",1],["مِن","dari","min",0],["وَلِىٍّۢ","seorang pelindung","waliyyin",128],["وَلَا","dan tidak","walā",4],["نَصِيرٍۢ","seorang penolong","naṣīrin",332]],"t":"Dan Kamu tidak dapat melepaskan diri (dari siksaan Allah) di bumi, dan kamu tidak memperoleh pelindung atau penolong selain Allah."},{"n":32,"w":[["وَمِنْ","dan dari","wamin",0],["ءَايَـٰتِهِ","tanda-tanda-Nya","āyātihi",28],["ٱلْجَوَارِ","kapal-kapal","l-jawāri",1857],["فِى","di","fī",3],["ٱلْبَحْرِ","laut","l-baḥri",283],["كَٱلْأَعْلَـٰمِ","seperti gunung-gunung","kal-aʿlāmi",2155]],"t":"Dan di antara tanda-tanda (kebesaran)-Nya ialah kapal-kapal (yang berlayar) di laut seperti gunung-gunung."},{"n":33,"w":[["إِن","jika","in",14],["يَشَأْ","Dia menghendaki","yasha",54],["يُسْكِنِ","Dia menenangkan","yus'kini",1281],["ٱلرِّيحَ","angin","l-rīḥa",378],["فَيَظْلَلْنَ","maka jadilah ia kapal-kapal)","fayaẓlalna",894],["رَوَاكِدَ","terhenti","rawākida",4194],["عَلَىٰ","atas","ʿalā",8],["ظَهْرِهِۦٓ ۚ","permukaan","ẓahrihi",625],["إِنَّ","sesungguhnya","inna",5],["فِى","pada yang","fī",3],["ذَٰلِكَ","demikian itu","dhālika",19],["لَـَٔايَـٰتٍۢ","benar-benar tanda-tanda","laāyātin",28],["لِّكُلِّ","bagi setiap","likulli",31],["صَبَّارٍۢ","orang yang bersabar","ṣabbārin",1520],["شَكُورٍ","orang yang bersyukur","shakūrin",810]],"t":"Jika Dia menghendaki, Dia akan menghentikan angin, sehingga jadilah (kapal-kapal) itu terhenti di permukaan laut. Sungguh, pada yang demikian itu terdapat tanda-tanda (kekuasaan Allah) bagi orang yang selalu bersabar dan banyak bersyukur,"},{"n":34,"w":[["أَوْ","atau","aw",42],["يُوبِقْهُنَّ","Dia membinasakannya","yūbiq'hunna",4752],["بِمَا","dengan sebab","bimā",2],["كَسَبُوا۟","perbuatan mereka","kasabū",196],["وَيَعْفُ","dan Dia memberi maaf","wayaʿfu",397],["عَن","dari","ʿan",21],["كَثِيرٍۢ","kebanyakan","kathīrin",191]],"t":"atau (Dia akan) menghancurkan kapal-kapal itu karena perbuatan (dosa) mereka, dan Dia memaafkan banyak (dari mereka),"},{"n":35,"w":[["وَيَعْلَمَ","dan mengetahui","wayaʿlama",29],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُجَـٰدِلُونَ","mereka membantah","yujādilūna",426],["فِىٓ","pada","fī",3],["ءَايَـٰتِنَا","ayat-ayat Kami","āyātinā",28],["مَا","tidak ada","mā",2],["لَهُم","bagi mereka","lahum",11],["مِّن","dari","min",0],["مَّحِيصٍۢ","tempat lari","maḥīṣin",1370]],"t":"dan agar orang-orang yang membantah tanda-tanda (kekuasaan) Kami mengetahui bahwa mereka tidak akan memperoleh jalan ke luar (dari siksaan)."},{"n":36,"w":[["فَمَآ","maka apa yang","famā",2],["أُوتِيتُم","diberikan kepadamu","ūtītum",45],["مِّن","dari","min",0],["شَىْءٍۢ","sesuatu","shayin",41],["فَمَتَـٰعُ","maka kesenangan","famatāʿu",330],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",150],["ٱلدُّنْيَا ۖ","dunia","l-dun'yā",102],["وَمَا","dan apa yang","wamā",2],["عِندَ","di sisi","ʿinda",59],["ٱللَّهِ","Allah","l-lahi",1],["خَيْرٌۭ","lebih baik","khayrun",62],["وَأَبْقَىٰ","dan lebih kekal","wa-abqā",1035],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَلَىٰ","dan kepada","waʿalā",8],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["يَتَوَكَّلُونَ","mereka bertawakkal","yatawakkalūna",292]],"t":"Apa pun (kenikmatan) yang diberikan kepadamu, maka itu adalah kesenangan hidup di dunia. Sedangkan apa (kenikmatan) yang ada di sisi Allah lebih baik dan lebih kekal bagi orang-orang yang beriman, dan hanya kepada Tuhan mereka bertawakal,"},{"n":37,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["يَجْتَنِبُونَ","mereka menjauhi","yajtanibūna",944],["كَبَـٰٓئِرَ","besar","kabāira",1083],["ٱلْإِثْمِ","dosa","l-ith'mi",327],["وَٱلْفَوَٰحِشَ","dan perbuatan keji","wal-fawāḥisha",573],["وَإِذَا","dan apabila","wa-idhā",23],["مَا","apa-apa","mā",2],["غَضِبُوا۟","marah","ghaḍibū",1182],["هُمْ","mereka","hum",11],["يَغْفِرُونَ","mereka mengampuni","yaghfirūna",183]],"t":"dan juga (bagi) orang-orang yang menjauhi dosa-dosa besar dan perbuatan-perbuatan keji, dan apabila mereka marah segera memberi maaf,"},{"n":38,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["ٱسْتَجَابُوا۟","mereka memperkenankan","is'tajābū",394],["لِرَبِّهِمْ","kepada Tuhan mereka","lirabbihim",10],["وَأَقَامُوا۟","dan mereka mendirikan","wa-aqāmū",220],["ٱلصَّلَوٰةَ","sholat","l-ṣalata",133],["وَأَمْرُهُمْ","dan urusan mereka","wa-amruhum",66],["شُورَىٰ","musyawarah","shūrā",2896],["بَيْنَهُمْ","diantara mereka","baynahum",47],["وَمِمَّا","dan sebagian apa","wamimmā",0],["رَزَقْنَـٰهُمْ","Kami beri rezeki mereka","razaqnāhum",198],["يُنفِقُونَ","mereka menafkahkan","yunfiqūna",179]],"t":"dan (bagi) orang-orang yang menerima (mematuhi) seruan Tuhan dan melaksanakan salat, sedang urusan mereka (diputuskan) dengan musyawarah antara mereka; dan mereka menginfakkan sebagian dari rezeki yang Kami berikan kepada mereka,"},{"n":39,"w":[["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["إِذَآ","apabila","idhā",23],["أَصَابَهُمُ","menimpa mereka","aṣābahumu",187],["ٱلْبَغْىُ","kezaliman","l-baghyu",778],["هُمْ","mereka","hum",11],["يَنتَصِرُونَ","mereka membela diri","yantaṣirūna",1127]],"t":"dan (bagi) orang-orang yang apabila mereka diperlakukan dengan zalim, mereka membela diri."},{"n":40,"w":[["وَجَزَٰٓؤُا۟","dan balasan","wajazāu",275],["سَيِّئَةٍۢ","kejahatan","sayyi-atin",477],["سَيِّئَةٌۭ","kejahatan","sayyi-atun",477],["مِّثْلُهَا ۖ","serupa dengannya","mith'luhā",155],["فَمَنْ","maka barang siapa","faman",12],["عَفَا","memaafkan","ʿafā",397],["وَأَصْلَحَ","dan berbuat baik","wa-aṣlaḥa",381],["فَأَجْرُهُۥ","maka pahalanya","fa-ajruhu",107],["عَلَى","atas","ʿalā",8],["ٱللَّهِ ۚ","Allah","l-lahi",1],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["لَا","tidak","lā",4],["يُحِبُّ","menyukai","yuḥibbu",186],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89]],"t":"Dan balasan suatu kejahatan adalah kejahatan yang setimpal, tetapi barangsiapa memaafkan dan berbuat baik (kepada orang yang berbuat jahat) maka pahalanya dari Allah. Sungguh, Dia tidak menyukai orang-orang zalim."},{"n":41,"w":[["وَلَمَنِ","dan sungguh orang-orang","walamani",12],["ٱنتَصَرَ","menolong/membela diri","intaṣara",1127],["بَعْدَ","sesudah","baʿda",58],["ظُلْمِهِۦ","teraniayanya","ẓul'mihi",512],["فَأُو۟لَـٰٓئِكَ","maka mereka itu","fa-ulāika",55],["مَا","tidak ada","mā",2],["عَلَيْهِم","atas mereka","ʿalayhim",8],["مِّن","dari","min",0],["سَبِيلٍ","jalan","sabīlin",64]],"t":"Tetapi orang-orang yang membela diri setelah dizalimi, tidak ada alasan untuk menyalahkan mereka."},{"n":42,"w":[["إِنَّمَا","sesungguhnya hanyalah","innamā",5],["ٱلسَّبِيلُ","jalan","l-sabīlu",64],["عَلَى","atas","ʿalā",8],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَظْلِمُونَ","zalim","yaẓlimūna",104],["ٱلنَّاسَ","manusia","l-nāsa",52],["وَيَبْغُونَ","dan mereka melampaui batas","wayabghūna",425],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["بِغَيْرِ","dengan tanpa","bighayri",75],["ٱلْحَقِّ ۚ","kebenaran","l-ḥaqi",50],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",55],["لَهُمْ","bagi mereka","lahum",11],["عَذَابٌ","azab","ʿadhābun",36],["أَلِيمٌۭ","pedih","alīmun",164]],"t":"Sesungguhnya kesalahan hanya ada pada orang-orang yang berbuat zalim kepada manusia dan melampaui batas di bumi tanpa (mengindahkan) kebenaran. Mereka itu mendapat siksaan yang pedih."},{"n":43,"w":[["وَلَمَن","dan sungguh orang","walaman",12],["صَبَرَ","dia sabar","ṣabara",205],["وَغَفَرَ","dan dia memaafkan","waghafara",183],["إِنَّ","sesungguhnya","inna",5],["ذَٰلِكَ","demikian itu","dhālika",19],["لَمِنْ","benar-benar termasuk","lamin",0],["عَزْمِ","teguh hati","ʿazmi",1297],["ٱلْأُمُورِ","urusan","l-umūri",66]],"t":"Tetapi barangsiapa bersabar dan memaafkan, sungguh yang demikian itu termasuk perbuatan yang mulia."},{"n":44,"w":[["وَمَن","dan barang siapa","waman",12],["يُضْلِلِ","menyesatkan","yuḍ'lili",185],["ٱللَّهُ","Allah","l-lahu",1],["فَمَا","maka tidak ada","famā",2],["لَهُۥ","baginya","lahu",16],["مِن","dari","min",0],["وَلِىٍّۢ","seorang pelindung","waliyyin",128],["مِّنۢ","dari","min",0],["بَعْدِهِۦ ۗ","sesudah itu","baʿdihi",58],["وَتَرَى","dan kamu akan melihat","watarā",46],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89],["لَمَّا","ketika","lammā",71],["رَأَوُا۟","mereka melihat","ra-awū",46],["ٱلْعَذَابَ","azab","l-ʿadhāba",36],["يَقُولُونَ","mereka berkata","yaqūlūna",6],["هَلْ","apakah","hal",115],["إِلَىٰ","untuk","ilā",13],["مَرَدٍّۢ","kembali","maraddin",1199],["مِّن","dari","min",0],["سَبِيلٍۢ","jalan","sabīlin",64]],"t":"Dan barangsiapa dibiarkan sesat oleh Allah, maka tidak ada baginya pelindung setelah itu. Kamu akan melihat orang-orang zalim ketika mereka melihat azab berkata, \"Adakah kiranya jalan untuk kembali (ke dunia)?\""},{"n":45,"w":[["وَتَرَىٰهُمْ","dan kamu akan melihat","watarāhum",46],["يُعْرَضُونَ","mereka dihadapkan","yuʿ'raḍūna",770],["عَلَيْهَا","atasnya(neraka)","ʿalayhā",8],["خَـٰشِعِينَ","keadaan tunduk","khāshiʿīna",674],["مِنَ","dari pada","mina",0],["ٱلذُّلِّ","rendah/hina","l-dhuli",1713],["يَنظُرُونَ","mereka melihat","yanẓurūna",125],["مِن","dari","min",0],["طَرْفٍ","pandangan mata","ṭarfin",1162],["خَفِىٍّۢ ۗ","tersembunyi","khafiyyin",2736],["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوٓا۟","beriman","āmanū",18],["إِنَّ","sesungguhnya","inna",5],["ٱلْخَـٰسِرِينَ","orang-orang yang merugi","l-khāsirīna",354],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["خَسِرُوٓا۟","mereka merugi","khasirū",609],["أَنفُسَهُمْ","diri mereka","anfusahum",39],["وَأَهْلِيهِمْ","dan keluarga mereka","wa-ahlīhim",91],["يَوْمَ","pada hari","yawma",25],["ٱلْقِيَـٰمَةِ ۗ","kiamat","l-qiyāmati",174],["أَلَآ","ingatlah","alā",299],["إِنَّ","sesungguhnya","inna",5],["ٱلظَّـٰلِمِينَ","orang-orang yang zalim","l-ẓālimīna",89],["فِى","dalam","fī",3],["عَذَابٍۢ","azab","ʿadhābin",36],["مُّقِيمٍۢ","kekal","muqīmin",851]],"t":"Dan kamu akan melihat mereka dihadapkan ke neraka dalam keadaan tertunduk karena (merasa) hina, mereka melihat dengan pandangan yang lesu. Dan orang-orang yang beriman berkata, \"Sesungguhnya orang-orang yang rugi ialah orang-orang yang merugikan diri mereka sendiri dan keluarganya pada hari Kiamat.\" Ingatlah, sesungguhnya orang-orang zalim itu berada dalam azab yang kekal."},{"n":46,"w":[["وَمَا","dan tidak","wamā",2],["كَانَ","adalah","kāna",9],["لَهُم","bagi mereka","lahum",11],["مِّنْ","dari","min",0],["أَوْلِيَآءَ","pelindung-pelindung","awliyāa",128],["يَنصُرُونَهُم","menolong mereka","yanṣurūnahum",202],["مِّن","dari","min",0],["دُونِ","selain","dūni",78],["ٱللَّهِ ۗ","Allah","l-lahi",1],["وَمَن","dan barang siapa","waman",12],["يُضْلِلِ","menyesatkan","yuḍ'lili",185],["ٱللَّهُ","Allah","l-lahu",1],["فَمَا","maka tidak ada","famā",2],["لَهُۥ","baginya","lahu",16],["مِن","dari","min",0],["سَبِيلٍ","jalan","sabīlin",64]],"t":"Dan mereka tidak akan mempunyai pelindung yang dapat menolong mereka selain Allah. Barang siapa dibiarkan sesat oleh Allah tidak akan ada jalan keluar baginya (untuk mendapat petunjuk)."},{"n":47,"w":[["ٱسْتَجِيبُوا۟","perkenankanlah","is'tajībū",394],["لِرَبِّكُم","bagi Tuhanmu","lirabbikum",10],["مِّن","dari","min",0],["قَبْلِ","sebelum","qabli",51],["أَن","bahwa","an",17],["يَأْتِىَ","akan datang","yatiya",48],["يَوْمٌۭ","suatu hari","yawmun",25],["لَّا","tidak","lā",4],["مَرَدَّ","di tolak","maradda",1199],["لَهُۥ","padanya","lahu",16],["مِنَ","dari","mina",0],["ٱللَّهِ ۚ","Allah","l-lahi",1],["مَا","tidak ada","mā",2],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["مَّلْجَإٍۢ","tempat berlindung","malja-in",1923],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",177],["وَمَا","dan tidak ada","wamā",2],["لَكُم","bagi kalian","lakum",26],["مِّن","dari","min",0],["نَّكِيرٍۢ","mengingkari","nakīrin",4103]],"t":"Patuhilah seruan Tuhanmu sebelum datang dari Allah suatu hari yang tidak dapat ditolak (atas perintah dari Allah). Pada hari itu kamu tidak memperoleh tempat berlindung dan tidak (pula) dapat mengingkari (dosa-dosamu)."},{"n":48,"w":[["فَإِنْ","maka jika","fa-in",14],["أَعْرَضُوا۟","mereka berpaling","aʿraḍū",349],["فَمَآ","maka tidak","famā",2],["أَرْسَلْنَـٰكَ","Kami mengutus kamu","arsalnāka",88],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["حَفِيظًا ۖ","penjaga","ḥafīẓan",720],["إِنْ","tidaklah","in",14],["عَلَيْكَ","atasmu","ʿalayka",8],["إِلَّا","kecuali","illā",15],["ٱلْبَلَـٰغُ ۗ","penyampaian","l-balāghu",626],["وَإِنَّآ","dan sesungguhnya Kami","wa-innā",5],["إِذَآ","apabila","idhā",23],["أَذَقْنَا","Kami merasakan","adhaqnā",462],["ٱلْإِنسَـٰنَ","manusia","l-insāna",167],["مِنَّا","dari Kami","minnā",0],["رَحْمَةًۭ","rahmat","raḥmatan",103],["فَرِحَ","dia gembira","fariḥa",594],["بِهَا ۖ","karenanya","bihā",94],["وَإِن","dan jika","wa-in",14],["تُصِبْهُمْ","menimpa mereka","tuṣib'hum",187],["سَيِّئَةٌۢ","kesusahan","sayyi-atun",477],["بِمَا","dengan sebab","bimā",2],["قَدَّمَتْ","perbuatan","qaddamat",406],["أَيْدِيهِمْ","tangan-tangan mereka","aydīhim",99],["فَإِنَّ","maka sesungguhnya","fa-inna",5],["ٱلْإِنسَـٰنَ","manusia","l-insāna",167],["كَفُورٌۭ","sangat ingkar","kafūrun",731]],"t":"Jika mereka berpaling, maka (ingatlah) Kami tidak mengutus engkau sebagai pengawas bagi mereka. Kewajibanmu tidak lain hanyalah menyampaikan (risalah). Dan sungguh, apabila Kami merasakan kepada manusia suatu rahmat dari Kami, dia menyambutnya dengan gembira; tetapi jika mereka ditimpa kesusahan karena perbuatan tangan mereka sendiri (niscaya mereka ingkar), sungguh, manusia itu sangat ingkar (kepada nikmat)."},{"n":49,"w":[["لِّلَّهِ","bagi Allah","lillahi",1],["مُلْكُ","kerajaan","mul'ku",249],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَٱلْأَرْضِ ۚ","dan bumi","wal-arḍi",22],["يَخْلُقُ","Dia menciptakan","yakhluqu",60],["مَا","apa yang","mā",2],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["يَهَبُ","Dia memberi","yahabu",478],["لِمَن","kepada siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["إِنَـٰثًۭا","anak perempuan","ināthan",435],["وَيَهَبُ","dan Dia memberi","wayahabu",478],["لِمَن","kepada siapa","liman",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["ٱلذُّكُورَ","anak laki-laki","l-dhukūra",536]],"t":"Milik Allah lah kerajaan langit dan bumi; Dia menciptakan apa yang Dia kehendaki, memberikan anak perempuan kepada siapa yang Dia kehendaki, dan memberikan anak laki-laki kepada siapa yang Dia kehendaki,"},{"n":50,"w":[["أَوْ","atau","aw",42],["يُزَوِّجُهُمْ","Dia menjodohkan mereka","yuzawwijuhum",1439],["ذُكْرَانًۭا","laki-laki","dhuk'rānan",536],["وَإِنَـٰثًۭا ۖ","dan perempuan","wa-ināthan",435],["وَيَجْعَلُ","dan Dia menjadikan","wayajʿalu",33],["مَن","siapa","man",12],["يَشَآءُ","Dia kehendaki","yashāu",54],["عَقِيمًا ۚ","mandul","ʿaqīman",1501],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِيمٌۭ","Maha Mengetahui","ʿalīmun",68],["قَدِيرٌۭ","Maha Kuasa","qadīrun",260]],"t":"atau Dia menganugerahkan jenis laki-laki dan perempuan, dan menjadikan mandul siapa yang Dia kehendaki. Dia Maha Mengetahui, Mahakuasa."},{"n":51,"w":[["۞ وَمَا","dan tidak","wamā",2],["كَانَ","ada","kāna",9],["لِبَشَرٍ","bagi seorang manusia","libasharin",315],["أَن","bahwa","an",17],["يُكَلِّمَهُ","berkata dengannya","yukallimahu",515],["ٱللَّهُ","Allah","l-lahu",1],["إِلَّا","kecuali","illā",15],["وَحْيًا","wahyu","waḥyan",1243],["أَوْ","atau","aw",42],["مِن","dari","min",0],["وَرَآئِ","belakang","warāi",445],["حِجَابٍ","tabir","ḥijābin",1058],["أَوْ","atau","aw",42],["يُرْسِلَ","mengutus","yur'sila",88],["رَسُولًۭا","utusan","rasūlan",35],["فَيُوحِىَ","lalu diwahyukan","fayūḥiya",165],["بِإِذْنِهِۦ","dengan idzin-Nya","bi-idh'nihi",298],["مَا","apa yang","mā",2],["يَشَآءُ ۚ","Dia kehendaki","yashāu",54],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِىٌّ","Maha Tinggi","ʿaliyyun",769],["حَكِيمٌۭ","Maha Bijaksana","ḥakīmun",112]],"t":"Dan tidaklah patut bagi seorang manusia bahwa Allah akan berbicara kepadanya kecuali dengan perantaraan wahyu atau dari belakang tabir atau dengan mengutus utusan (malaikat) lalu diwahyukan kepadanya dengan izin-Nya apa yang Dia kehendaki. Sungguh, Dia Mahatinggi, Mahabijaksana."},{"n":52,"w":[["وَكَذَٰلِكَ","dan demikianlah","wakadhālika",19],["أَوْحَيْنَآ","Kami wahyukan","awḥaynā",165],["إِلَيْكَ","kepadamu","ilayka",13],["رُوحًۭا","roh/Al Qur'an","rūḥan",496],["مِّنْ","dari","min",0],["أَمْرِنَا ۚ","urusan Kami","amrinā",66],["مَا","tidaklah","mā",2],["كُنتَ","kamu adalah","kunta",9],["تَدْرِى","kamu mengetahui","tadrī",744],["مَا","apakah","mā",2],["ٱلْكِتَـٰبُ","Al kitab","l-kitābu",49],["وَلَا","dan tidak","walā",4],["ٱلْإِيمَـٰنُ","iman","l-īmānu",256],["وَلَـٰكِن","akan tetapi","walākin",162],["جَعَلْنَـٰهُ","Kami jadikannya","jaʿalnāhu",33],["نُورًۭا","cahaya","nūran",273],["نَّهْدِى","Kami beri petunjuk","nahdī",79],["بِهِۦ","dengannya","bihi",16],["مَن","siapa","man",12],["نَّشَآءُ","Kami kehendaki","nashāu",54],["مِنْ","dari","min",0],["عِبَادِنَا ۚ","hamba-hamba Kami","ʿibādinā",87],["وَإِنَّكَ","dan sesungguhnya kamu","wa-innaka",5],["لَتَهْدِىٓ","benar-benar kamu memberi petunjuk","latahdī",79],["إِلَىٰ","kepada","ilā",13],["صِرَٰطٍۢ","jalan","ṣirāṭin",259],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",318]],"t":"Dan demikianlah Kami wahyukan kepadamu (Muhammad) rūh (Alquran) dengan perintah Kami. Sebelumnya engkau tidaklah mengetahui apakah Kitab (Alquran) dan apakah iman itu, tetapi Kami jadikan Alquran itu cahaya, dengan itu Kami memberi petunjuk pada siapa yang Kami kehendaki di antara hamba-hamba Kami. Dan sungguh, engkau benar-benar membimbing (manusia) ke jalan yang lurus,"},{"n":53,"w":[["صِرَٰطِ","jalan","ṣirāṭi",259],["ٱللَّهِ","Allah","l-lahi",1],["ٱلَّذِى","yang","alladhī",7],["لَهُۥ","kepunyaan-Nya","lahu",16],["مَا","segala apa yang","mā",2],["فِى","di","fī",3],["ٱلسَّمَـٰوَٰتِ","langit(jamak)","l-samāwāti",38],["وَمَا","dan segala apa yang","wamā",2],["فِى","di","fī",3],["ٱلْأَرْضِ ۗ","bumi","l-arḍi",22],["أَلَآ","ingatlah","alā",299],["إِلَى","kepada","ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["تَصِيرُ","kembali","taṣīru",4353],["ٱلْأُمُورُ","segala urusan","l-umūru",66]],"t":"(Yaitu) jalan Allah yang milik-Nyalah apa yang ada di langit dan apa yang ada di bumi. Ingatlah, segala urusan kembali kepada Allah."}]