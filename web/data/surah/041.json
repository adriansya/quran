[{"n":1,"w":[["حمٓ","Haa miim","hha-meem",1054]],"t":"Ḥā Mīm."},{"n":2,"w":[["تَنزِيلٌۭ","diturunkan","tanzīlun",636],["مِّنَ","dari","mina",0],["ٱلرَّحْمَـٰنِ","Maha Pengasih","l-raḥmāni",212],["ٱلرَّحِيمِ","Maha Penyayang","l-raḥīmi",103]],"t":"(Alquran ini) diturunkah dari Tuhan Yang Maha Pengasih, Maha Penyayang."},{"n":3,"w":[["كِتَـٰبٌۭ","kitab","kitābun",49],["فُصِّلَتْ","dijelaskan","fuṣṣilat",569],["ءَايَـٰتُهُۥ","ayat-ayatnya","āyātuhu",28],["قُرْءَانًا","bacaan","qur'ānan",178],["عَرَبِيًّۭا","bahasa Arab","ʿarabiyyan",769],["لِّقَوْمٍۢ","bagi kaum","liqawmin",27],["يَعْلَمُونَ","mereka mengetahui","yaʿlamūna",29]],"t":"Kitab yang ayat-ayatnya djelaskan, bacaan dalam bahasa Arab, untuk kaum yang mengetahui,"},{"n":4,"w":[["بَشِيرًۭا","berita gembira","bashīran",896],["وَنَذِيرًۭا","dan peringatan","wanadhīran",204],["فَأَعْرَضَ","tetapi berpaling","fa-aʿraḍa",351],["أَكْثَرُهُمْ","kebanyakan mereka","aktharuhum",145],["فَهُمْ","maka mereka","fahum",11],["لَا","tidak","lā",4],["يَسْمَعُونَ","mereka mendengarkan","yasmaʿūna",148]],"t":"yang membawa berita gembira dan peringatan, tetapi kebanyakan mereka berpaling (darinya) serta tidak mendengarkan."},{"n":5,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["قُلُوبُنَا","hati kami","qulūbunā",89],["فِىٓ","dalam","fī",3],["أَكِنَّةٍۢ","tutupan","akinnatin",1472],["مِّمَّا","dari apa","mimmā",0],["تَدْعُونَآ","kamu menyeru kami","tadʿūnā",65],["إِلَيْهِ","kepadanya","ilayhi",13],["وَفِىٓ","dan dalam","wafī",3],["ءَاذَانِنَا","telinga kami","ādhāninā",541],["وَقْرٌۭ","sumbat","waqrun",1241],["وَمِنۢ","dan dari","wamin",0],["بَيْنِنَا","antara kami","bayninā",47],["وَبَيْنِكَ","dan antara kamu","wabaynika",47],["حِجَابٌۭ","dinding","ḥijābun",1053],["فَٱعْمَلْ","maka bekerjalah","fa-iʿ'mal",44],["إِنَّنَا","sesungguhnya kami","innanā",5],["عَـٰمِلُونَ","orang-orang yang bekerja","ʿāmilūna",676]],"t":"Dan mereka berkata, \"Hati kami sudah tertutup dari apa yang engkau seru kami kepadanya dan telinga kami sudah tersumbat, dan di antara kami dan engkau ada dinding, karena itu lakukanlah (sesuai kehendakmu), sesungguhnya kami akan melakukan (sesuai kehendak kami).\""},{"n":6,"w":[["قُلْ","katakanlah","qul",6],["إِنَّمَآ","sesungguhnya hanyalah","innamā",5],["أَنَا۠","aku","anā",183],["بَشَرٌۭ","seorang manusia","basharun",318],["مِّثْلُكُمْ","seperti kamu","mith'lukum",157],["يُوحَىٰٓ","diwahyukan","yūḥā",168],["إِلَىَّ","kepadaku","ilayya",13],["أَنَّمَآ","bahwasanya","annamā",30],["إِلَـٰهُكُمْ","Tuhanmu","ilāhukum",75],["إِلَـٰهٌۭ","Tuhan","ilāhun",75],["وَٰحِدٌۭ","Maha Esa","wāḥidun",373],["فَٱسْتَقِيمُوٓا۟","maka tetaplah","fa-is'taqīmū",868],["إِلَيْهِ","kepada-Nya","ilayhi",13],["وَٱسْتَغْفِرُوهُ ۗ","dan mohonlah ampunan kepada-Nya","wa-is'taghfirūhu",299],["وَوَيْلٌۭ","dan kecelakaanlah","wawaylun",296],["لِّلْمُشْرِكِينَ","bagi orang-orang yang mempersekutukan","lil'mush'rikīna",244]],"t":"Katakanlah (Muhammad), \"Aku ini hanyalah seorang manusia seperti kamu, yang diwahyukan kepadaku bahwa Tuhan kamu adalah Tuhan Yang Maha Esa, karena itu tetaplah kamu (beribadah) kepada-Nya dan mohonlah ampunan kepada-Nya. Dan celakalah bagi orang-orang yang mempersekutukan-(Nya),"},{"n":7,"w":[["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["لَا","tidak","lā",4],["يُؤْتُونَ","menunaikan","yu'tūna",45],["ٱلزَّكَوٰةَ","zakat","l-zakata",359],["وَهُم","dan mereka","wahum",11],["بِٱلْـَٔاخِرَةِ","dengan akhirat","bil-ākhirati",73],["هُمْ","mereka","hum",11],["كَـٰفِرُونَ","kafir","kāfirūna",70]],"t":"(yaitu) orang-orang yang tidak menunaikan zakat dan mereka ingkar terhadap kehidupan akhirat."},{"n":8,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَعَمِلُوا۟","dan berbuat","waʿamilū",44],["ٱلصَّـٰلِحَـٰتِ","baik","l-ṣāliḥāti",95],["لَهُمْ","bagi mereka","lahum",11],["أَجْرٌ","pahala","ajrun",110],["غَيْرُ","tidak","ghayru",76],["مَمْنُونٍۢ","terputus-putus","mamnūnin",1587]],"t":"Sesungguhnya orang-orang yang beriman dan mengerjakan kebajikan, mereka mendapat pahala yang tidak ada putus-putusnya.\""},{"n":9,"w":[["۞ قُلْ","katakanlah","qul",6],["أَئِنَّكُمْ","apakah sesungguhnya kamu","a-innakum",5],["لَتَكْفُرُونَ","sungguh kamu kafir","latakfurūna",40],["بِٱلَّذِى","dengan yang","bi-alladhī",7],["خَلَقَ","menciptakan","khalaqa",61],["ٱلْأَرْضَ","bumi","l-arḍa",22],["فِى","dalam","fī",3],["يَوْمَيْنِ","dua masa/hari","yawmayni",25],["وَتَجْعَلُونَ","dan kamu menjadikan","watajʿalūna",33],["لَهُۥٓ","bagi-Nya","lahu",16],["أَندَادًۭا ۚ","sekutu-sekutu","andādan",1211],["ذَٰلِكَ","demikian itu","dhālika",19],["رَبُّ","Tuhan","rabbu",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",163]],"t":"Katakanlah, \"Pantaskah kamu ingkar kepada Tuhan yang menciptakan bumi dalam dua masa dan kamu adakan pula sekutu-sekutu bagi-Nya? Itulah Tuhan seluruh alam.\""},{"n":10,"w":[["وَجَعَلَ","dan Dia menjadikan","wajaʿala",33],["فِيهَا","didalamnya (bumi)","fīhā",3],["رَوَٰسِىَ","gunung-gunung","rawāsiya",854],["مِن","dari","min",0],["فَوْقِهَا","atasnya","fawqihā",287],["وَبَـٰرَكَ","dan Dia berkati","wabāraka",968],["فِيهَا","didalamnya","fīhā",3],["وَقَدَّرَ","dan Dia menentukan","waqaddara",599],["فِيهَآ","didalamnya","fīhā",3],["أَقْوَٰتَهَا","makanan-makanannya","aqwātahā",4137],["فِىٓ","dalam","fī",3],["أَرْبَعَةِ","empat","arbaʿati",876],["أَيَّامٍۢ","masa/hari","ayyāmin",25],["سَوَآءًۭ","sama","sawāan",405],["لِّلسَّآئِلِينَ","bagi orang-orang yang bertanya","lilssāilīna",1097]],"t":"Dan Dia ciptakan padanya gunung-gunung yang kokoh di atasnya. Dan kemudian Dia berkahi, dan Dia tentukan makanan-makanan (bagi penghuni)nya dalam empat masa, memadai untuk (memenuhi kebutuhan) mereka yang memerlukannya."},{"n":11,"w":[["ثُمَّ","kemudian","thumma",34],["ٱسْتَوَىٰٓ","Dia menuju","is'tawā",336],["إِلَى","kepada","ilā",13],["ٱلسَّمَآءِ","langit","l-samāi",38],["وَهِىَ","dan ia/langit","wahiya",191],["دُخَانٌۭ","asap","dukhānun",2348],["فَقَالَ","lalu Dia berkata","faqāla",6],["لَهَا","kepadanya","lahā",97],["وَلِلْأَرْضِ","dan kepada bumi","walil'arḍi",22],["ٱئْتِيَا","datanglah kamu berdua","i'tiyā",48],["طَوْعًا","suka hati","ṭawʿan",1534],["أَوْ","atau","aw",42],["كَرْهًۭا","terpaksa","karhan",1356],["قَالَتَآ","keduanya berkata","qālatā",6],["أَتَيْنَا","kami datang","ataynā",48],["طَآئِعِينَ","dengan suka hati","ṭāiʿīna",3277]],"t":"Kemudian Dia menuju ke langit dan (langit) itu masih berupa asap, lalu Dia berfirman kepadanya dan kepada bumi, \"Datanglah kamu berdua menurut perintah-Ku dengan patuh atau terpaksa.\" Keduanya menjawab, \"Kami datang dengan patuh.\""},{"n":12,"w":[["فَقَضَىٰهُنَّ","maka Dia menjadikannya","faqaḍāhunna",202],["سَبْعَ","tujuh","sabʿa",456],["سَمَـٰوَاتٍۢ","langit","samāwātin",38],["فِى","dalam","fī",3],["يَوْمَيْنِ","dua masa/hari","yawmayni",25],["وَأَوْحَىٰ","dan Dia mewahyukan","wa-awḥā",168],["فِى","pada","fī",3],["كُلِّ","tiap-tiap","kulli",31],["سَمَآءٍ","langit","samāin",38],["أَمْرَهَا ۚ","urusannya","amrahā",66],["وَزَيَّنَّا","dan Kami hiasi","wazayyannā",417],["ٱلسَّمَآءَ","langit","l-samāa",38],["ٱلدُّنْيَا","dunia","l-dun'yā",104],["بِمَصَـٰبِيحَ","dengan bintang-bintang","bimaṣābīḥa",1593],["وَحِفْظًۭا ۚ","dan memelihara","waḥif'ẓan",1799],["ذَٰلِكَ","demikian itu","dhālika",19],["تَقْدِيرُ","ketentuan","taqdīru",1415],["ٱلْعَزِيزِ","Maha Perkasa","l-ʿazīzi",113],["ٱلْعَلِيمِ","Maha Mengetahui","l-ʿalīmi",68]],"t":"Lalu diciptakan-Nya tujuh langit dalam dua masa dan pada setiap langit Dia mewahyukan urusan masing-masing. Kemudian langit yang dekat (dengan bumi), Kami hiasi dengan bintang-bintang, dan (Kami ciptakan itu) untuk memelihara. Demikianlah ketentuan (Allah) Yang Mahaperkasa, Maha Mengetahui."},{"n":13,"w":[["فَإِنْ","maka jika","fa-in",14],["أَعْرَضُوا۟","mereka berpaling","aʿraḍū",351],["فَقُلْ","maka katakanlah","faqul",6],["أَنذَرْتُكُمْ","aku telah peringatkan kamu","andhartukum",265],["صَـٰعِقَةًۭ","petir","ṣāʿiqatan",961],["مِّثْلَ","seperti","mith'la",157],["صَـٰعِقَةِ","petir","ṣāʿiqati",961],["عَادٍۢ","kaum'Ad","ʿādin",434],["وَثَمُودَ","dan kaum Tsamud","wathamūda",415]],"t":"Jika mereka berpaling maka katakanlah, \"Aku telah memperingatkan kamu akan (bencana) petir seperti petir yang menimpa kaum 'Ād dan kaum Samud.\""},{"n":14,"w":[["إِذْ","ketika","idh",53],["جَآءَتْهُمُ","datang kepada mereka","jāathumu",43],["ٱلرُّسُلُ","rasul-rasul","l-rusulu",35],["مِنۢ","dari","min",0],["بَيْنِ","antara","bayni",47],["أَيْدِيهِمْ","depan mereka","aydīhim",101],["وَمِنْ","dan dari","wamin",0],["خَلْفِهِمْ","belakang mereka","khalfihim",476],["أَلَّا","bahwa janganlah","allā",17],["تَعْبُدُوٓا۟","kamu menyembah","taʿbudū",99],["إِلَّا","kecuali","illā",15],["ٱللَّهَ ۖ","Allah","l-laha",1],["قَالُوا۟","mereka berkata","qālū",6],["لَوْ","kalau","law",57],["شَآءَ","menghendaki","shāa",54],["رَبُّنَا","Tuhan kami","rabbunā",10],["لَأَنزَلَ","tentu Dia menurunkan","la-anzala",62],["مَلَـٰٓئِكَةًۭ","malaikat-malaikat","malāikatan",127],["فَإِنَّا","maka sesungguhnya kami","fa-innā",5],["بِمَآ","kepada apa","bimā",2],["أُرْسِلْتُم","kamu di utus","ur'sil'tum",91],["بِهِۦ","dengannya","bihi",16],["كَـٰفِرُونَ","orang-orang kafir","kāfirūna",70]],"t":"Ketika para rasul datang kepada mereka dari depan dan dari belakang mereka (dengan menyerukan), \"Janganlah kamu menyembah selain Allah!\" Mereka menjawab, \"Kalau Tuhan kami menghendaki tentu Dia menurunkan malaikat-malaikat-Nya, maka sesungguhnya kami mengingkari wahyu yang engkau diutus menyampaikannya.\""},{"n":15,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["عَادٌۭ","kaum'Ad","ʿādun",434],["فَٱسْتَكْبَرُوا۟","maka mereka menyombngkan diri","fa-is'takbarū",300],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["بِغَيْرِ","dengan tanpa","bighayri",76],["ٱلْحَقِّ","yang benar","l-ḥaqi",50],["وَقَالُوا۟","dan mereka berkata","waqālū",6],["مَنْ","siapakah","man",12],["أَشَدُّ","lebih","ashaddu",361],["مِنَّا","dari kami","minnā",0],["قُوَّةً ۖ","kekuatan","quwwatan",371],["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["أَنَّ","sesungguhnya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَهُمْ","menciptakan mereka","khalaqahum",61],["هُوَ","dia","huwa",20],["أَشَدُّ","lebih","ashaddu",361],["مِنْهُمْ","dari mereka","min'hum",0],["قُوَّةًۭ ۖ","kekuatan","quwwatan",371],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["بِـَٔايَـٰتِنَا","terhadap tanda-tanda Kami","biāyātinā",28],["يَجْحَدُونَ","mereka mengingkari","yajḥadūna",732]],"t":"Maka adapun kaum 'Ād, mereka menyombongkan diri di bumi tanpa (mengindahkan) kebenaran dan mereka berkata, \"Siapakah yang lebih hebat kekuatannya dari kami?\" Tidakkah mereka memperhatikan bahwa sesungguhnya Allah yang menciptakan mereka. Dia lebih hebat kekuatan-Nya dari mereka? Dan mereka telah mengingkari tanda-tanda (kebesaran) Kami."},{"n":16,"w":[["فَأَرْسَلْنَا","maka Kami mengirimkan","fa-arsalnā",91],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["رِيحًۭا","angin","rīḥan",382],["صَرْصَرًۭا","gemuruh/sangat ribut","ṣarṣaran",1804],["فِىٓ","dalam","fī",3],["أَيَّامٍۢ","beberapa hari","ayyāmin",25],["نَّحِسَاتٍۢ","celaka","naḥisātin",4061],["لِّنُذِيقَهُمْ","karena Kami hendak merasakan pada mereka","linudhīqahum",458],["عَذَابَ","azab","ʿadhāba",36],["ٱلْخِزْىِ","yang hina","l-khiz'yi",804],["فِى","dalam","fī",3],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",153],["ٱلدُّنْيَا ۖ","dunia","l-dun'yā",104],["وَلَعَذَابُ","dan sungguh azab","walaʿadhābu",36],["ٱلْـَٔاخِرَةِ","akhirat","l-ākhirati",73],["أَخْزَىٰ ۖ","lebih hina","akhzā",3029],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يُنصَرُونَ","mereka diberi pertolongan","yunṣarūna",200]],"t":"Maka Kami tiupkan angin yang sangat bergemuruh kepada mereka dalam beberapa hari yang nahas, karena Kami ingin agar mereka itu merasakan siksaan yang menghinakan dalam kehidupan di dunia. Sedangkan azab akhirat pasti lebih menghinakan dan mereka tidak diberi pertolongan."},{"n":17,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["ثَمُودُ","Tsamud","thamūdu",415],["فَهَدَيْنَـٰهُمْ","maka Kami beri petunjuk mereka","fahadaynāhum",80],["فَٱسْتَحَبُّوا۟","maka (tetapi) mereka menyukai","fa-is'taḥabbū",1696],["ٱلْعَمَىٰ","buta","l-ʿamā",2219],["عَلَى","daripada","ʿalā",8],["ٱلْهُدَىٰ","petunjuk","l-hudā",133],["فَأَخَذَتْهُمْ","maka menyambar mereka","fa-akhadhathum",94],["صَـٰعِقَةُ","petir","ṣāʿiqatu",961],["ٱلْعَذَابِ","azab","l-ʿadhābi",36],["ٱلْهُونِ","yang menghinakan","l-hūni",1564],["بِمَا","dengan apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَكْسِبُونَ","mereka kerjakan","yaksibūna",194]],"t":"Dan adapun kaum Samud, mereka telah Kami beri petunjuk tetapi mereka lebih menyukai kebutaan (kesesatan) daripada petunjuk itu, maka mereka disambar petir sebagai azab yang menghinakan disebabkan apa yang telah mereka kerjakan."},{"n":18,"w":[["وَنَجَّيْنَا","dan Kami selamatkan","wanajjaynā",322],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["وَكَانُوا۟","dan adalah mereka","wakānū",9],["يَتَّقُونَ","mereka bertakwa","yattaqūna",67]],"t":"Dan Kami selamatkan orang-orang yang beriman karena mereka adalah orang-orang yang bertakwa."},{"n":19,"w":[["وَيَوْمَ","dan pada hari","wayawma",25],["يُحْشَرُ","dikumpulkan","yuḥ'sharu",315],["أَعْدَآءُ","musuh-musuh","aʿdāu",236],["ٱللَّهِ","Allah","l-lahi",1],["إِلَى","ke","ilā",13],["ٱلنَّارِ","neraka","l-nāri",78],["فَهُمْ","lalu mereka","fahum",11],["يُوزَعُونَ","mereka di bagi-bagi","yūzaʿūna",2043]],"t":"Dan (ingatlah) pada hari (ketika) musuh-musuh Allah digiring ke neraka lalu mereka dipisah-pisahkan."},{"n":20,"w":[["حَتَّىٰٓ","sehingga","ḥattā",82],["إِذَا","apabila","idhā",23],["مَا","apa-apa","mā",2],["جَآءُوهَا","mereka datang kepadanya","jāūhā",43],["شَهِدَ","menjadi saksi","shahida",264],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["سَمْعُهُمْ","pendengaran mereka","samʿuhum",473],["وَأَبْصَـٰرُهُمْ","dan penglihatan mereka","wa-abṣāruhum",248],["وَجُلُودُهُم","dan kulit-kulit mereka","wajulūduhum",907],["بِمَا","tentang apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Sehingga apabila mereka sampai ke neraka, pendengaran, penglihatan dan kulit mereka menjadi saksi terhadap apa yang telah mereka lakukan."},{"n":21,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["لِجُلُودِهِمْ","kepada kulit-kulit mereka","lijulūdihim",907],["لِمَ","mengapa","lima",2],["شَهِدتُّمْ","kamu menjadi saksi","shahidttum",264],["عَلَيْنَا ۖ","atas kami","ʿalaynā",8],["قَالُوٓا۟","(kulit-kulit) berkata","qālū",6],["أَنطَقَنَا","menjadikan kami berkata","anṭaqanā",2160],["ٱللَّهُ","Allah","l-lahu",1],["ٱلَّذِىٓ","yang","alladhī",7],["أَنطَقَ","menjadikan berkata","anṭaqa",2160],["كُلَّ","segala","kulla",31],["شَىْءٍۢ","sesuatu","shayin",41],["وَهُوَ","dan Dia","wahuwa",20],["خَلَقَكُمْ","menciptakan kalian","khalaqakum",61],["أَوَّلَ","pertama","awwala",141],["مَرَّةٍۢ","kali","marratin",512],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["تُرْجَعُونَ","kalian dikembalikan","tur'jaʿūna",146]],"t":"Dan mereka berkata kepada kulit mereka, \"Mengapa kamu menjadi saksi terhadap kami?\" Kulit mereka menjawab, \"Yang menjadikan kami dapat berbicara adalah Allah, yang (juga) menjadikan segala sesuatu dapat berbicara, dan Dialah yang menciptakan kamu yang pertama kali dan hanya kepada-Nya kamu dikembalikan.\""},{"n":22,"w":[["وَمَا","dan tidak ada","wamā",2],["كُنتُمْ","kalian adalah","kuntum",9],["تَسْتَتِرُونَ","kamu bersembunyi","tastatirūna",4662],["أَن","untuk","an",17],["يَشْهَدَ","menyaksikan","yashhada",264],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["سَمْعُكُمْ","pendengaranmu","samʿukum",473],["وَلَآ","dan tidak","walā",4],["أَبْصَـٰرُكُمْ","penglihatanmu","abṣārukum",248],["وَلَا","dan tidak","walā",4],["جُلُودُكُمْ","kulit-kulitmu","julūdukum",907],["وَلَـٰكِن","akan tetapi","walākin",165],["ظَنَنتُمْ","kamu mengira","ẓanantum",252],["أَنَّ","bahwasanya","anna",30],["ٱللَّهَ","Allah","l-laha",1],["لَا","tidak","lā",4],["يَعْلَمُ","mengetahui","yaʿlamu",29],["كَثِيرًۭا","kebanyakan","kathīran",161],["مِّمَّا","dari apa","mimmā",0],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44]],"t":"Dan kamu tidak dapat bersembunyi dari kesaksian pendengaran, penglihatan dan kulitmu terhadapmu bahkan kamu mengira Allah tidak mengetahui banyak tentang apa yang kamu lakukan."},{"n":23,"w":[["وَذَٰلِكُمْ","dan yang demikian itu","wadhālikum",19],["ظَنُّكُمُ","persangkaanmu","ẓannukumu",483],["ٱلَّذِى","yang","alladhī",7],["ظَنَنتُم","kamu telah menyangka","ẓanantum",252],["بِرَبِّكُمْ","terhadap Tuhanmu","birabbikum",10],["أَرْدَىٰكُمْ","Dia menjerumuskan kamu","ardākum",1746],["فَأَصْبَحْتُم","maka jadilah kamu","fa-aṣbaḥtum",383],["مِّنَ","termasuk","mina",0],["ٱلْخَـٰسِرِينَ","orang-orang yang rugi","l-khāsirīna",358]],"t":"Dan itulah dugaanmu yang telah kamu sangkakan terhadap Tuhanmu, (dugaan itu) telah membinasakan kamu, sehingga jadilah kamu termasuk orang yang rugi."},{"n":24,"w":[["فَإِن","maka jika","fa-in",14],["يَصْبِرُوا۟","mereka bersabar","yaṣbirū",203],["فَٱلنَّارُ","maka neraka","fal-nāru",78],["مَثْوًۭى","tempat tinggal","mathwan",690],["لَّهُمْ ۖ","bagi mereka","lahum",11],["وَإِن","dan jika","wa-in",14],["يَسْتَعْتِبُوا۟","mereka minta dikasihani","yastaʿtibū",1695],["فَمَا","maka tidaklah","famā",2],["هُم","mereka","hum",11],["مِّنَ","termasuk","mina",0],["ٱلْمُعْتَبِينَ","orang-orang yang dikasihani","l-muʿ'tabīna",3785]],"t":"Meskipun mereka bersabar (atas azab neraka) maka nerakalah tempat tinggal mereka dan jika mereka minta belas kasihan, maka mereka itu tidak termasuk orang yang pantas dikasihani."},{"n":25,"w":[["۞ وَقَيَّضْنَا","dan Kami tetapkan","waqayyaḍnā",2585],["لَهُمْ","bagi mereka","lahum",11],["قُرَنَآءَ","teman-teman","quranāa",996],["فَزَيَّنُوا۟","maka mereka menjadikan memandang baik","fazayyanū",417],["لَهُم","bagi mereka","lahum",11],["مَّا","apa yang","mā",2],["بَيْنَ","diantara","bayna",47],["أَيْدِيهِمْ","hadapan mereka","aydīhim",101],["وَمَا","dan apa","wamā",2],["خَلْفَهُمْ","belakang mereka","khalfahum",476],["وَحَقَّ","dan pasti","waḥaqqa",504],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلْقَوْلُ","perkataan","l-qawlu",119],["فِىٓ","pada","fī",3],["أُمَمٍۢ","umat-umat","umamin",190],["قَدْ","sungguh","qad",24],["خَلَتْ","telah lewat","khalat",430],["مِن","dari","min",0],["قَبْلِهِم","sebelum mereka","qablihim",51],["مِّنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",465],["وَٱلْإِنسِ ۖ","dan manusia","wal-insi",536],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["كَانُوا۟","adalah mereka","kānū",9],["خَـٰسِرِينَ","orang-orang yang rugi","khāsirīna",358]],"t":"Dan Kami tetapkan bagi mereka teman-teman (setan) yang memuji-muji apa saja yang ada di hadapan dan di belakang mereka dan tetaplah atas mereka putusan azab bersama umat-umat yang terdahulu sebelum mereka dari (golongan) jin dan manusia. Sungguh, mereka adalah orang-orang yang rugi."},{"n":26,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["لَا","janganlah","lā",4],["تَسْمَعُوا۟","kamu mendengar","tasmaʿū",148],["لِهَـٰذَا","kepada ini","lihādhā",37],["ٱلْقُرْءَانِ","Al Qur'an","l-qur'āni",178],["وَٱلْغَوْا۟","dan buatlah keributan","wal-ghaw",3626],["فِيهِ","padanya","fīhi",3],["لَعَلَّكُمْ","agar kalian","laʿallakum",92],["تَغْلِبُونَ","kamu dapat mengalahkan","taghlibūna",625]],"t":"Dan orang-orang yang kafir berkata, \"Janganlah kamu mendengarkan (bacaan) Alquran ini dan buatlah kegaduhan terhadapnya, agar kamu dapat mengalahkan (mereka).\""},{"n":27,"w":[["فَلَنُذِيقَنَّ","maka sungguh Kami akan merasakan","falanudhīqanna",458],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["عَذَابًۭا","azab","ʿadhāban",36],["شَدِيدًۭا","sangat keras","shadīdan",213],["وَلَنَجْزِيَنَّهُمْ","dan sungguh Kami akan memberi balasan mereka","walanajziyannahum",164],["أَسْوَأَ","sangat buruk","aswa-a",2172],["ٱلَّذِى","yang","alladhī",7],["كَانُوا۟","adalah mereka","kānū",9],["يَعْمَلُونَ","mereka kerjakan","yaʿmalūna",44]],"t":"Maka sungguh, akan Kami timpakan azab yang keras kepada orang-orang yang kafir itu dan sungguh, akan Kami beri balasan mereka dengan seburuk-buruk balasan terhadap apa yang telah mereka kerjakan."},{"n":28,"w":[["ذَٰلِكَ","demikianlah","dhālika",19],["جَزَآءُ","balasan","jazāu",276],["أَعْدَآءِ","musuh-musuh","aʿdāi",236],["ٱللَّهِ","Allah","l-lahi",1],["ٱلنَّارُ ۖ","neraka","l-nāru",78],["لَهُمْ","bagi mereka","lahum",11],["فِيهَا","di dalamnya","fīhā",3],["دَارُ","tempat tinggal","dāru",249],["ٱلْخُلْدِ ۖ","kekal","l-khul'di",1249],["جَزَآءًۢ","pembalasan","jazāan",276],["بِمَا","dengan apa","bimā",2],["كَانُوا۟","adalah mereka","kānū",9],["بِـَٔايَـٰتِنَا","terhadap ayat-ayat Kami","biāyātinā",28],["يَجْحَدُونَ","mereka ingkar","yajḥadūna",732]],"t":"Demikianlah balasan (terhadap) musuh-musuh Allah (yaitu) neraka; mereka mendapat tempat tinggal yang kekal di dalamnya sebagai balasan atas keingkaran mereka terhadap ayat-ayat Kami."},{"n":29,"w":[["وَقَالَ","dan berkata","waqāla",6],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["رَبَّنَآ","ya Tuhan kami","rabbanā",10],["أَرِنَا","perlihatkan kepada kami","arinā",291],["ٱلَّذَيْنِ","orang-orang yang","alladhayni",7],["أَضَلَّانَا","telah menyesatkan kami","aḍallānā",187],["مِنَ","dari","mina",0],["ٱلْجِنِّ","jin","l-jini",465],["وَٱلْإِنسِ","dan manusia","wal-insi",536],["نَجْعَلْهُمَا","kami jadikan keduanya","najʿalhumā",33],["تَحْتَ","di bawah","taḥta",234],["أَقْدَامِنَا","telapak kaki kami","aqdāminā",995],["لِيَكُونَا","supaya keduanya menjadi","liyakūnā",9],["مِنَ","dari","mina",0],["ٱلْأَسْفَلِينَ","orang-orang yang hina","l-asfalīna",1132]],"t":"Dan orang-orang yang kafir berkata, \"Ya Tuhan kami, perlihatkanlah kepada kami dua golongan yang telah menyesatkan kami yaitu (golongan) jin dan manusia, agar kami letakkan keduanya di bawah telapak kaki agar kedua golongan itu menjadi yang paling bawah (hina).\""},{"n":30,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["قَالُوا۟","mereka mengatakan","qālū",6],["رَبُّنَا","Tuhan kami","rabbunā",10],["ٱللَّهُ","Allah","l-lahu",1],["ثُمَّ","kemudian","thumma",34],["ٱسْتَقَـٰمُوا۟","mereka meneguhkan pendirian","is'taqāmū",868],["تَتَنَزَّلُ","akan turun","tatanazzalu",1105],["عَلَيْهِمُ","atas mereka","ʿalayhimu",8],["ٱلْمَلَـٰٓئِكَةُ","malaikat","l-malāikatu",127],["أَلَّا","janganlah","allā",17],["تَخَافُوا۟","kamu takut","takhāfū",140],["وَلَا","dan janganlah","walā",4],["تَحْزَنُوا۟","kamu merasa bersedih","taḥzanū",316],["وَأَبْشِرُوا۟","dan gembirakanlah mereka","wa-abshirū",2940],["بِٱلْجَنَّةِ","dengan surga","bil-janati",77],["ٱلَّتِى","yang","allatī",7],["كُنتُمْ","kalian adalah","kuntum",9],["تُوعَدُونَ","kamu dijanjikan","tūʿadūna",179]],"t":"Sesungguhnya orang-orang yang berkata, \"Tuhan kami adalah Allah\" kemudian mereka meneguhkan pendirian mereka, maka malaikat-malaikat akan turun kepada mereka (dengan berkata), \"Janganlah kamu merasa takut dan janganlah kamu bersedih hati; dan bergembiralah kamu dengan (memperoleh) surga yang telah dijanjikan kepadamu.\""},{"n":31,"w":[["نَحْنُ","kami","naḥnu",130],["أَوْلِيَآؤُكُمْ","pelindung-pelindungmu","awliyāukum",132],["فِى","dalam","fī",3],["ٱلْحَيَوٰةِ","kehidupan","l-ḥayati",153],["ٱلدُّنْيَا","dunia","l-dun'yā",104],["وَفِى","dan dalam","wafī",3],["ٱلْـَٔاخِرَةِ ۖ","kehidupan akhirat","l-ākhirati",73],["وَلَكُمْ","dan bagimu","walakum",26],["فِيهَا","didalamnya","fīhā",3],["مَا","apa yang","mā",2],["تَشْتَهِىٓ","kamu inginkan","tashtahī",1014],["أَنفُسُكُمْ","diri kalian sendiri","anfusukum",39],["وَلَكُمْ","dan bagimu","walakum",26],["فِيهَا","didalamnya","fīhā",3],["مَا","apa yang","mā",2],["تَدَّعُونَ","kamu minta","taddaʿūna",2076]],"t":"Kamilah pelindung-pelindungmu dalam kehidupan dunia dan akhirat; di dalamnya (surga) kamu memperoleh apa yang kamu inginkan dan memperoleh apa yang kamu minta."},{"n":32,"w":[["نُزُلًۭا","pemberian","nuzulan",994],["مِّنْ","dari","min",0],["غَفُورٍۢ","Maha Pengampun","ghafūrin",121],["رَّحِيمٍۢ","Maha Penyayang","raḥīmin",103]],"t":"Sebagai penghormatan (bagimu) dari (Allah) Yang Maha Pengampun, Maha Penyayang."},{"n":33,"w":[["وَمَنْ","dan siapa","waman",12],["أَحْسَنُ","lebih baik","aḥsanu",325],["قَوْلًۭا","perkataan","qawlan",119],["مِّمَّن","daripada orang","mimman",0],["دَعَآ","dia menyeru","daʿā",65],["إِلَى","kepada","ilā",13],["ٱللَّهِ","Allah","l-lahi",1],["وَعَمِلَ","dan berbuat","waʿamila",44],["صَـٰلِحًۭا","kebaikan","ṣāliḥan",95],["وَقَالَ","dan dia berkata","waqāla",6],["إِنَّنِى","sesungguhnya aku","innanī",5],["مِنَ","termasuk","mina",0],["ٱلْمُسْلِمِينَ","orang-orang yang berserah diri","l-mus'limīna",278]],"t":"Dan siapakah yang lebih baik perkataannya daripada orang yang menyeru kepada Allah dan mengerjakan kebajikan dan berkata, \"Sungguh, aku termasuk orang-orang muslim (yang berserah diri)?\""},{"n":34,"w":[["وَلَا","dan tidaklah","walā",4],["تَسْتَوِى","sama","tastawī",336],["ٱلْحَسَنَةُ","kebaikan","l-ḥasanatu",362],["وَلَا","dan tidaklah","walā",4],["ٱلسَّيِّئَةُ ۚ","kejahatan","l-sayi-atu",205],["ٱدْفَعْ","tolaklah","id'faʿ",1328],["بِٱلَّتِى","dengan yang","bi-allatī",7],["هِىَ","ia (cara)","hiya",191],["أَحْسَنُ","lebih baik","aḥsanu",325],["فَإِذَا","maka tiba-tiba","fa-idhā",23],["ٱلَّذِى","orang yang","alladhī",7],["بَيْنَكَ","diantaramu","baynaka",47],["وَبَيْنَهُۥ","dan antara dia","wabaynahu",47],["عَدَٰوَةٌۭ","permusuhan","ʿadāwatun",1144],["كَأَنَّهُۥ","seakan-akan","ka-annahu",380],["وَلِىٌّ","penolong","waliyyun",132],["حَمِيمٌۭ","teman","ḥamīmun",503]],"t":"Dan tidaklah sama kebaikan dan kejahatan. Tolaklah (kejahatan itu) dengan cara yang lebih baik, sehingga orang yang ada rasa permusuhan antara kamu dan dia akan seperti teman yang setia."},{"n":35,"w":[["وَمَا","dan tidak","wamā",2],["يُلَقَّىٰهَآ","dijumpainya","yulaqqāhā",1191],["إِلَّا","kecuali","illā",15],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["صَبَرُوا۟","sabar","ṣabarū",203],["وَمَا","dan tidak","wamā",2],["يُلَقَّىٰهَآ","dijumpainya","yulaqqāhā",1191],["إِلَّا","kecuali","illā",15],["ذُو","(orang yang) mempunyai","dhū",116],["حَظٍّ","keberuntungan","ḥaẓẓin",1048],["عَظِيمٍۢ","besar","ʿaẓīmin",100]],"t":"Dan (sifat-sifat yang baik itu) tidak akan dianugerahkan kecuali kepada orang-orang yang sabar dan tidak dianugerahkan kecuali kepada orang-orang yang mempunyai keberuntungan yang besar."},{"n":36,"w":[["وَإِمَّا","dan jika","wa-immā",445],["يَنزَغَنَّكَ","mengganggu kamu","yanzaghannaka",1625],["مِنَ","dari","mina",0],["ٱلشَّيْطَـٰنِ","syaitan","l-shayṭāni",124],["نَزْغٌۭ","gangguan","nazghun",2566],["فَٱسْتَعِذْ","maka berlindunglah","fa-is'taʿidh",1693],["بِٱللَّهِ ۖ","kepada Allah","bil-lahi",1],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["هُوَ","Dia","huwa",20],["ٱلسَّمِيعُ","Maha mendengar","l-samīʿu",253],["ٱلْعَلِيمُ","Maha Mengetahui","l-ʿalīmu",68]],"t":"Dan jika setan mengganggumu dengan suatu godaan, maka mohonlah perlindungan kepada Allah. Sungguh, Dialah Yang Maha Mendengar, Maha Mengetahui."},{"n":37,"w":[["وَمِنْ","dan dari","wamin",0],["ءَايَـٰتِهِ","tanda-tanda-Nya","āyātihi",28],["ٱلَّيْلُ","malam","al-laylu",136],["وَٱلنَّهَارُ","dan siang","wal-nahāru",209],["وَٱلشَّمْسُ","dan matahari","wal-shamsu",343],["وَٱلْقَمَرُ ۚ","dan bulan","wal-qamaru",404],["لَا","tidak","lā",4],["تَسْجُدُوا۟","kamu bersujud","tasjudū",335],["لِلشَّمْسِ","kepada matahari","lilshamsi",343],["وَلَا","dan jangan","walā",4],["لِلْقَمَرِ","pada bulan","lil'qamari",404],["وَٱسْجُدُوا۟","dan bersujudlah","wa-us'judū",335],["لِلَّهِ","kepada Allah","lillahi",1],["ٱلَّذِى","yang","alladhī",7],["خَلَقَهُنَّ","menciptakan semuanya","khalaqahunna",61],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["إِيَّاهُ","hanya kepada-Nya","iyyāhu",431],["تَعْبُدُونَ","kamu menyembah","taʿbudūna",99]],"t":"Dan sebagian dari tanda-tanda kebesaran-Nya ialah malam, siang, matahari dan bulan. Janganlah bersujud kepada matahari dan jangan (pula) kepada bulan, tetapi bersujudlah kepada Allah yang menciptakannya, jika kamu hanya menyembah kepada-Nya."},{"n":38,"w":[["فَإِنِ","maka jika","fa-ini",14],["ٱسْتَكْبَرُوا۟","mereka menyombongkan diri","is'takbarū",300],["فَٱلَّذِينَ","maka orang-orang (malaikat)","fa-alladhīna",7],["عِندَ","di sisi","ʿinda",59],["رَبِّكَ","Tuhanmu","rabbika",10],["يُسَبِّحُونَ","mereka bertasbih","yusabbiḥūna",279],["لَهُۥ","kepada-Nya","lahu",16],["بِٱلَّيْلِ","pada malam","bi-al-layli",136],["وَٱلنَّهَارِ","dan siang","wal-nahāri",209],["وَهُمْ","dan mereka","wahum",11],["لَا","tidak","lā",4],["يَسْـَٔمُونَ ۩","jemu-jemu","yasamūna",2007]],"t":"Jika mereka menyombongkan diri, maka mereka (malaikat) yang di sisi Tuhanmu bertasbih kepada-Nya pada malam dan siang hari, sedang mereka tidak pernah jemu."},{"n":39,"w":[["وَمِنْ","dan dari","wamin",0],["ءَايَـٰتِهِۦٓ","tanda-tanda-Nya","āyātihi",28],["أَنَّكَ","bahwasanya kamu","annaka",30],["تَرَى","melihat","tarā",46],["ٱلْأَرْضَ","bumi","l-arḍa",22],["خَـٰشِعَةًۭ","tandus","khāshiʿatan",670],["فَإِذَآ","maka apabila","fa-idhā",23],["أَنزَلْنَا","Kami turunkan","anzalnā",62],["عَلَيْهَا","atasnya","ʿalayhā",8],["ٱلْمَآءَ","air","l-māa",192],["ٱهْتَزَّتْ","ia bergerak","ih'tazzat",1687],["وَرَبَتْ ۚ","dan berkembang","warabat",1640],["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِىٓ","yang","alladhī",7],["أَحْيَاهَا","menghidupkannya","aḥyāhā",230],["لَمُحْىِ","tentu dapat menghidupkan","lamuḥ'yī",2488],["ٱلْمَوْتَىٰٓ ۚ","yang mati","l-mawtā",312],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌ","Maha Kuasa","qadīrun",261]],"t":"Dan sebagian dari tanda-tanda (kebesaran)-Nya, engkau melihat bumi itu kering dan tandus, tetapi apabila Kami turunkan hujan di atasnya, niscaya ia bergerak dan subur. Sesungguhnya (Allah) yang menghidupkannya pasti dapat menghidupkan yang mati; sesungguhnya Dia Mahakuasa atas segala sesuatu."},{"n":40,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يُلْحِدُونَ","mereka ingkar","yul'ḥidūna",1735],["فِىٓ","pada","fī",3],["ءَايَـٰتِنَا","ayat-ayat Kami","āyātinā",28],["لَا","tidak","lā",4],["يَخْفَوْنَ","mereka tersembunyi","yakhfawna",1244],["عَلَيْنَآ ۗ","dari/atas Kami","ʿalaynā",8],["أَفَمَن","apakah maka orang","afaman",12],["يُلْقَىٰ","ia dilemparkan","yul'qā",172],["فِى","dalam","fī",3],["ٱلنَّارِ","neraka","l-nāri",78],["خَيْرٌ","lebih baik","khayrun",60],["أَم","ataukah/apakah","am",84],["مَّن","orang","man",12],["يَأْتِىٓ","ia datang","yatī",48],["ءَامِنًۭا","aman","āminan",557],["يَوْمَ","pada hari","yawma",25],["ٱلْقِيَـٰمَةِ ۚ","kiamat","l-qiyāmati",177],["ٱعْمَلُوا۟","berbuatlah","iʿ'malū",44],["مَا","apa yang","mā",2],["شِئْتُمْ ۖ","kalian kehendaki","shi'tum",54],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["بِمَا","terhadap apa","bimā",2],["تَعْمَلُونَ","kamu kerjakan","taʿmalūna",44],["بَصِيرٌ","Maha Melihat","baṣīrun",232]],"t":"Sesungguhnya orang-orang yang mengingkari tanda-tanda (kebesaran) Kami, mereka tidak tersembunyi dari Kami. Apakah orang-orang yang dilemparkan ke dalam neraka yang lebih baik ataukah mereka yang datang dengan aman sentosa pada hari Kiamat? Lakukanlah apa yang kamu kehendaki! Sungguh, Dia Maha Melihat apa yang kamu kerjakan."},{"n":41,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِٱلذِّكْرِ","dengan peringatan/Al Qur'an","bil-dhik'ri",152],["لَمَّا","ketika","lammā",72],["جَآءَهُمْ ۖ","ia datang kepada mereka","jāahum",43],["وَإِنَّهُۥ","dan sesungguhnya ia (Al Qur'an)","wa-innahu",5],["لَكِتَـٰبٌ","sungguh kitab","lakitābun",49],["عَزِيزٌۭ","mulia","ʿazīzun",113]],"t":"Sesungguhnya orang-orang yang mengingkari Alquran ketika (Alquran) itu disampaikan kepada mereka (mereka itu pasti akan celaka), dan sesungguhnya (Alquran) itu adalah Kitab yang mulia,"},{"n":42,"w":[["لَّا","tidak","lā",4],["يَأْتِيهِ","datang kepadanya","yatīhi",48],["ٱلْبَـٰطِلُ","kebathilan","l-bāṭilu",410],["مِنۢ","dari","min",0],["بَيْنِ","antara","bayni",47],["يَدَيْهِ","depannya","yadayhi",101],["وَلَا","dan tidak","walā",4],["مِنْ","dari","min",0],["خَلْفِهِۦ ۖ","belakangnya","khalfihi",476],["تَنزِيلٌۭ","diturunkan","tanzīlun",636],["مِّنْ","dari","min",0],["حَكِيمٍ","Yang Maha Bijaksana","ḥakīmin",115],["حَمِيدٍۢ","Maha Terpuji","ḥamīdin",563]],"t":"(yang) tidak akan didatangi oleh kebatilan baik dari depan maupun dari belakang (pada masa lalu dan yang akan datang), yang diturunkan dari Tuhan Yang Mahabijaksana, Maha Terpuji."},{"n":43,"w":[["مَّا","tidak","mā",2],["يُقَالُ","dikatakan","yuqālu",6],["لَكَ","kepadamu","laka",143],["إِلَّا","kecuali","illā",15],["مَا","apa","mā",2],["قَدْ","sesungguhnya","qad",24],["قِيلَ","dikatakan","qīla",6],["لِلرُّسُلِ","kepada rasul-rasul","lilrrusuli",35],["مِن","dari","min",0],["قَبْلِكَ ۚ","sebelum kamu","qablika",51],["إِنَّ","sesungguhnya","inna",5],["رَبَّكَ","Tuhanmu","rabbaka",10],["لَذُو","benar-benar mempunyai","ladhū",116],["مَغْفِرَةٍۢ","ampunan","maghfiratin",391],["وَذُو","dan mempunyai","wadhū",116],["عِقَابٍ","siksaan/hukuman","ʿiqābin",502],["أَلِيمٍۢ","pedih","alīmin",167]],"t":"Apa yang dikatakan (oleh orang-orang kafir) kepadamu tidak lain adalah apa yang telah dikatakan kepada rasul-rasul sebelummu. Sungguh, Tuhanmu mempunyai ampunan dan azab yang pedih."},{"n":44,"w":[["وَلَوْ","dan jika","walaw",57],["جَعَلْنَـٰهُ","Kami jadikannya","jaʿalnāhu",33],["قُرْءَانًا","bacaan","qur'ānan",178],["أَعْجَمِيًّۭا","bahasa asing/selain bahasa Arab","aʿjamiyyan",1721],["لَّقَالُوا۟","tentu mereka mengatakan","laqālū",6],["لَوْلَا","mengapa tidak","lawlā",156],["فُصِّلَتْ","dijelaskan","fuṣṣilat",569],["ءَايَـٰتُهُۥٓ ۖ","ayat-ayatnya","āyātuhu",28],["ءَا۬عْجَمِىٌّۭ","apakah bahasa asing/selain bahasa Arab","āʿ'jamiyyun",1721],["وَعَرَبِىٌّۭ ۗ","dan orang Arab/bahasa Arab","waʿarabiyyun",769],["قُلْ","katakanlah","qul",6],["هُوَ","ia/Al Qur'an","huwa",20],["لِلَّذِينَ","bagi orang-orang yang","lilladhīna",7],["ءَامَنُوا۟","beriman","āmanū",18],["هُدًۭى","petunjuk","hudan",133],["وَشِفَآءٌۭ ۖ","dan penawar/obat","washifāon",1456],["وَٱلَّذِينَ","dan orang-orang yang","wa-alladhīna",7],["لَا","tidak","lā",4],["يُؤْمِنُونَ","mereka beriman","yu'minūna",18],["فِىٓ","pada","fī",3],["ءَاذَانِهِمْ","telinga mereka","ādhānihim",541],["وَقْرٌۭ","sumbat","waqrun",1241],["وَهُوَ","dan ia/Al Qur'an","wahuwa",20],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["عَمًى ۚ","buta/kegelapan","ʿaman",2219],["أُو۟لَـٰٓئِكَ","mereka itu","ulāika",56],["يُنَادَوْنَ","mereka dipanggil","yunādawna",269],["مِن","dari","min",0],["مَّكَانٍۭ","tempat","makānin",402],["بَعِيدٍۢ","yang jauh","baʿīdin",423]],"t":"Dan sekiranya Alquran Kami jadikan sebagai bacaan dalam bahasa selain bahasa Arab niscaya mereka mengatakan, \"Mengapa tidak dijelaskan ayat-ayatnya?\" Apakah patut (Alquran) dalam bahasa selain bahasa Arab sedang (rasul), orang Arab? Katakanlah, \"Alquran adalah petunjuk dan penyembuh bagi orang-orang yang beriman. Dan orang-orang yang tidak beriman pada telinga mereka ada sumbatan, dan (Alquran) itu merupakan kegelapan bagi mereka. Mereka itu (seperti) orang-orang yang dipanggil dari tempat yang jauh.\""},{"n":45,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["ءَاتَيْنَا","telah Kami berikan","ātaynā",45],["مُوسَى","Musa","mūsā",85],["ٱلْكِتَـٰبَ","kitab","l-kitāba",49],["فَٱخْتُلِفَ","maka ia diperselisihkan","fa-ukh'tulifa",337],["فِيهِ ۗ","didalamnya","fīhi",3],["وَلَوْلَا","dan jika tidak","walawlā",156],["كَلِمَةٌۭ","kalimat/ketetapan","kalimatun",277],["سَبَقَتْ","telah lewat/terdahulu","sabaqat",516],["مِن","dari","min",0],["رَّبِّكَ","Tuhanmu","rabbika",10],["لَقُضِىَ","tentu diputuskan","laquḍiya",202],["بَيْنَهُمْ ۚ","diantara mereka","baynahum",47],["وَإِنَّهُمْ","dan sesungguhnya mereka","wa-innahum",5],["لَفِى","benar-benar dalam","lafī",3],["شَكٍّۢ","keraguan","shakkin",610],["مِّنْهُ","dari padanya","min'hu",0],["مُرِيبٍۢ","kebingungan","murībin",1083]],"t":"Dan sungguh, telah Kami berikan kepada Musa Kitab (Taurat) lalu diperselisihkan. Sekiranya tidak ada keputusan yang terdahulu dari Tuhanmu, orang-orang kafir itu pasti sudah dibinasakan. Dan sesungguhnya mereka benar-benar dalam keraguan yang mendalam terhadapnya."},{"n":46,"w":[["مَّنْ","barang siapa","man",12],["عَمِلَ","berbuat","ʿamila",44],["صَـٰلِحًۭا","kebaikan","ṣāliḥan",95],["فَلِنَفْسِهِۦ ۖ","maka untuk dirinya sendiri","falinafsihi",39],["وَمَنْ","dan barang siapa","waman",12],["أَسَآءَ","berbuat jahat","asāa",1276],["فَعَلَيْهَا ۗ","maka atasnya","faʿalayhā",8],["وَمَا","dan tidaklah","wamā",2],["رَبُّكَ","Tuhanmu","rabbuka",10],["بِظَلَّـٰمٍۢ","berbuat aniaya","biẓallāmin",1317],["لِّلْعَبِيدِ","terhadap hamba-hambanya","lil'ʿabīdi",90]],"t":"Barangsiapa mengerjakan kebajikan maka (pahalanya) untuk dirinya sendiri dan barangsiapa berbuat jahat maka (dosanya) menjadi tanggungan dirinya sendiri. Dan Tuhanmu sama sekali tidak menzalimi hamba-hamba(Nya)."},{"n":47,"w":[["۞ إِلَيْهِ","kepada-Nya","ilayhi",13],["يُرَدُّ","dikembalikan","yuraddu",327],["عِلْمُ","pengetahuan","ʿil'mu",111],["ٱلسَّاعَةِ ۚ","hari kiamat","l-sāʿati",251],["وَمَا","dan tidak","wamā",2],["تَخْرُجُ","keluar","takhruju",225],["مِن","dari","min",0],["ثَمَرَٰتٍۢ","buah-buahan","thamarātin",580],["مِّنْ","dari","min",0],["أَكْمَامِهَا","kelopaknya","akmāmihā",2423],["وَمَا","dan tidak","wamā",2],["تَحْمِلُ","mengandung","taḥmilu",285],["مِنْ","dari seorang","min",0],["أُنثَىٰ","perempuan","unthā",433],["وَلَا","dan tidak","walā",4],["تَضَعُ","melahirkan","taḍaʿu",493],["إِلَّا","kecuali","illā",15],["بِعِلْمِهِۦ ۚ","dengan pengetahuan-Nya","biʿil'mihi",111],["وَيَوْمَ","dan pada hari","wayawma",25],["يُنَادِيهِمْ","Dia memanggil mereka","yunādīhim",269],["أَيْنَ","dimana","ayna",521],["شُرَكَآءِى","sekutu-sekutu-Ku","shurakāī",290],["قَالُوٓا۟","mereka menjawab","qālū",6],["ءَاذَنَّـٰكَ","kami nyatakan kepada Engaku","ādhannāka",2809],["مَا","tidak ada","mā",2],["مِنَّا","diantara kami","minnā",0],["مِن","dari","min",0],["شَهِيدٍۢ","seorang saksi","shahīdin",214]],"t":"Kepada-Nyalah ilmu tentang hari Kiamat itu dikembalikan. Tidak ada buah-buahan yang keluar dari kelopaknya dan tidak seorang perempuan pun yang mengandung dan yang melahirkan, melainkan semuanya dengan sepengetahuan-Nya. Pada hari ketika Dia (Allah) menyeru mereka, \"Di manakah sekutu-sekutu-Ku itu?\" Mereka menjawab, \"Kami nyatakan kepada Engkau bahwa tidak ada seorang pun di antara kami yang dapat memberi kesaksian (bahwa Engkau mempunyai sekutu).\""},{"n":48,"w":[["وَضَلَّ","dan sesat/lenyap","waḍalla",223],["عَنْهُم","dari mereka","ʿanhum",21],["مَّا","apa yang","mā",2],["كَانُوا۟","mereka adalah","kānū",9],["يَدْعُونَ","mereka sembah","yadʿūna",65],["مِن","dari","min",0],["قَبْلُ ۖ","sebelum","qablu",51],["وَظَنُّوا۟","dan mereka menyangka","waẓannū",252],["مَا","tidak ada","mā",2],["لَهُم","bagi mereka","lahum",11],["مِّن","dari","min",0],["مَّحِيصٍۢ","tempat lari","maḥīṣin",1380]],"t":"Dan lenyaplah dari mereka apa yang dahulu selalu mereka sembah, dan mereka pun tahu bahwa tidak ada jalan keluar (dari azab Allah) bagi mereka."},{"n":49,"w":[["لَّا","tidak","lā",4],["يَسْـَٔمُ","jemu-jemu","yasamu",2007],["ٱلْإِنسَـٰنُ","manusia","l-insānu",170],["مِن","dari","min",0],["دُعَآءِ","memohon","duʿāi",463],["ٱلْخَيْرِ","kebaikan","l-khayri",60],["وَإِن","dan jika","wa-in",14],["مَّسَّهُ","menimpa dia","massahu",215],["ٱلشَّرُّ","kejelekan","l-sharu",365],["فَيَـُٔوسٌۭ","maka dia jemu","fayaūsun",2063],["قَنُوطٌۭ","putus asa","qanūṭun",4110]],"t":"Manusia tidak jemu memohon kebaikan, dan jika ditimpa malapetaka, mereka berputus asa dan hilang harapannya."},{"n":50,"w":[["وَلَئِنْ","dan jika","wala-in",14],["أَذَقْنَـٰهُ","Kami rasakan kepadanya","adhaqnāhu",458],["رَحْمَةًۭ","rahmat","raḥmatan",105],["مِّنَّا","dari Kami","minnā",0],["مِنۢ","dari","min",0],["بَعْدِ","sesudah","baʿdi",58],["ضَرَّآءَ","kesusahan","ḍarrāa",882],["مَسَّتْهُ","menimpanya","massathu",215],["لَيَقُولَنَّ","tentu dia berkata","layaqūlanna",6],["هَـٰذَا","ini","hādhā",37],["لِى","bagiku","lī",147],["وَمَآ","dan tidak","wamā",2],["أَظُنُّ","aku mengira","aẓunnu",252],["ٱلسَّاعَةَ","hari kiamat","l-sāʿata",251],["قَآئِمَةًۭ","terjadi","qāimatan",469],["وَلَئِن","dan jika","wala-in",14],["رُّجِعْتُ","aku dikembalikan","rujiʿ'tu",146],["إِلَىٰ","kepada","ilā",13],["رَبِّىٓ","Tuhanku","rabbī",10],["إِنَّ","sesungguhnya","inna",5],["لِى","bagiku","lī",147],["عِندَهُۥ","di sisi-Nya","ʿindahu",59],["لَلْحُسْنَىٰ ۚ","kebaikan","lalḥus'nā",565],["فَلَنُنَبِّئَنَّ","maka sungguh akan Kami beritakan","falanunabbi-anna",256],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِمَا","dengan apa","bimā",2],["عَمِلُوا۟","mereka kerjakan","ʿamilū",44],["وَلَنُذِيقَنَّهُم","dan sungguh akan Kami rasakan kepada mereka","walanudhīqannahum",458],["مِّنْ","dari","min",0],["عَذَابٍ","azab","ʿadhābin",36],["غَلِيظٍۢ","keras","ghalīẓin",902]],"t":"Dan jika Kami berikan kepadanya suatu rahmat dari Kami setelah ditimpa kesusahan, pastilah dia berkata, \"Ini adalah hakku, dan aku tidak yakin bahwa hari Kiamat itu akan terjadi. Dan jika aku dikembalikan kepada Tuhanku, sesungguhnya aku akan memperoleh kebaikan di sisi-Nya.\" Maka sungguh, akan Kami beritahukan kepada orang-orang kafir tentang apa yang telah mereka kerjakan, dan sungguh, akan Kami timpakan kepada mereka azab yang berat."},{"n":51,"w":[["وَإِذَآ","dan apabila","wa-idhā",23],["أَنْعَمْنَا","Kami berikan nikmat","anʿamnā",562],["عَلَى","atas","ʿalā",8],["ٱلْإِنسَـٰنِ","manusia","l-insāni",170],["أَعْرَضَ","ia berpaling","aʿraḍa",351],["وَنَـَٔا","dan menjauhkan diri","wanaā",1950],["بِجَانِبِهِۦ","disampingnya","bijānibihi",906],["وَإِذَا","dan apabila","wa-idhā",23],["مَسَّهُ","menimpanya","massahu",215],["ٱلشَّرُّ","kejelekan","l-sharu",365],["فَذُو","maka ia mempunyai","fadhū",116],["دُعَآءٍ","permohonan","duʿāin",463],["عَرِيضٍۢ","luas/panjang","ʿarīḍin",3103]],"t":"Dan apabila Kami berikan nikmat kepada manusia, dia berpaling dan menjauhkan diri (dengan sombong); tetapi apabila ditimpa malapetaka maka dia banyak berdoa."},{"n":52,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","bagaimana pendapatmu","ara-aytum",46],["إِن","jika","in",14],["كَانَ","ia adalah","kāna",9],["مِنْ","dari","min",0],["عِندِ","sisi","ʿindi",59],["ٱللَّهِ","Allah","l-lahi",1],["ثُمَّ","kemudian","thumma",34],["كَفَرْتُم","kamu ingkar","kafartum",40],["بِهِۦ","padanya","bihi",16],["مَنْ","siapakah","man",12],["أَضَلُّ","lebih sesat","aḍallu",872],["مِمَّنْ","dari pada orang","mimman",0],["هُوَ","dia","huwa",20],["فِى","dalam","fī",3],["شِقَاقٍۭ","perselisihan","shiqāqin",1023],["بَعِيدٍۢ","jauh","baʿīdin",423]],"t":"Katakanlah, \"Bagaimana pendapatmu jika (Alquran) itu datang dari sisi Allah, kemudian kamu mengingkarinya. Siapakah yang lebih sesat daripada orang yang selalu berada dalam penyimpangan yang jauh (dari kebenaran)?\"."},{"n":53,"w":[["سَنُرِيهِمْ","akan Kami perlihatkan kepada mereka","sanurīhim",291],["ءَايَـٰتِنَا","tanda-tanda Kami","āyātinā",28],["فِى","pada","fī",3],["ٱلْـَٔافَاقِ","segenap penjuru","l-āfāqi",1756],["وَفِىٓ","dan pada","wafī",3],["أَنفُسِهِمْ","diri mereka","anfusihim",39],["حَتَّىٰ","sehingga","ḥattā",82],["يَتَبَيَّنَ","jelas","yatabayyana",554],["لَهُمْ","bagi mereka","lahum",11],["أَنَّهُ","bahwasanya ia","annahu",30],["ٱلْحَقُّ ۗ","hak/benar","l-ḥaqu",50],["أَوَلَمْ","ataukah tidak","awalam",32],["يَكْفِ","cukup","yakfi",355],["بِرَبِّكَ","dengan Tuhanmu","birabbika",10],["أَنَّهُۥ","bahwasanya Dia","annahu",30],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["شَهِيدٌ","menjadi saksi","shahīdun",214]],"t":"Kami akan memperlihatkan kepada mereka tanda-tanda (kebesaran) Kami di segenap penjuru dan pada diri mereka sendiri, sehingga jelaslah bagi mereka bahwa Alquran itu adalah benar. Tidak cukupkah (bagi kamu) bahwa Tuhanmu menjadi saksi atas segala sesuatu?"},{"n":54,"w":[["أَلَآ","ingatlah","alā",302],["إِنَّهُمْ","sesungguhnya mereka","innahum",5],["فِى","dalam","fī",3],["مِرْيَةٍۢ","keraguan","mir'yatin",1369],["مِّن","dari","min",0],["لِّقَآءِ","pertemuan","liqāi",439],["رَبِّهِمْ ۗ","Tuhan mereka","rabbihim",10],["أَلَآ","ingatlah","alā",302],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["مُّحِيطٌۢ","Maha Meliputi","muḥīṭun",788]],"t":"Ingatlah, sesungguhnya mereka dalam keraguan tentang pertemuan dengan Tuhan mereka. Ingatlah, sesungguhnya Dia Maha Meliputi segala sesuatu."}]