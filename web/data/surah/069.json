[{"n":1,"w":[["ٱلْحَآقَّةُ","keadaan yang sebenarnya","al-ḥāqatu",1782]],"t":"Hari kiamat,"},{"n":2,"w":[["مَا","apakah","mā",2],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1782]],"t":"apakah hari Kiamat itu?"},{"n":3,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu mengetahui","adrāka",560],["مَا","apa","mā",2],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1782]],"t":"Dan tahukah kamu apakah hari Kiamat itu?"},{"n":4,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",63],["ثَمُودُ","kaum Tsamud","thamūdu",415],["وَعَادٌۢ","dan kaum 'Ad","waʿādun",434],["بِٱلْقَارِعَةِ","dengan yang mengejutkan/hari kiamat","bil-qāriʿati",1394]],"t":"Kaum Samud, dan 'Ād telah mendustakan hari Kiamat."},{"n":5,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["ثَمُودُ","kaum Tsamud","thamūdu",415],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",231],["بِٱلطَّاغِيَةِ","dengan teriakan/kejadian luar biasa","bil-ṭāghiyati",3298]],"t":"Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,"},{"n":6,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["عَادٌۭ","kaum 'Ad","ʿādun",434],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",231],["بِرِيحٍۢ","dengan angin","birīḥin",382],["صَرْصَرٍ","sangat dingin","ṣarṣarin",1804],["عَاتِيَةٍۢ","amat kencang","ʿātiyatin",3072]],"t":"sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,"},{"n":7,"w":[["سَخَّرَهَا","dia menimpakannya(angin itu)","sakharahā",475],["عَلَيْهِمْ","atas mereka","ʿalayhim",8],["سَبْعَ","tujuh","sabʿa",456],["لَيَالٍۢ","malam","layālin",136],["وَثَمَـٰنِيَةَ","dan delapan","wathamāniyata",1669],["أَيَّامٍ","hari","ayyāmin",25],["حُسُومًۭا","terus menerus","ḥusūman",3205],["فَتَرَى","kamu melihat","fatarā",46],["ٱلْقَوْمَ","kaum","l-qawma",27],["فِيهَا","padanya/pada waktu itu","fīhā",3],["صَرْعَىٰ","mati bergelimpangan","ṣarʿā",3249],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",380],["أَعْجَازُ","batang","aʿjāzu",2217],["نَخْلٍ","korma","nakhlin",550],["خَاوِيَةٍۢ","lapuk/tumbang","khāwiyatin",1425]],"t":"Allah menimpakan angin itu kepada mereka selama tujuh malam delapan hari terus-menerus; maka kamu melihat kaum 'Ād pada waktu itu mati bergelimpangan seperti batang-batang pohon kurma yang telah kosong (lapuk)."},{"n":8,"w":[["فَهَلْ","maka adakah","fahal",118],["تَرَىٰ","kamu melihat","tarā",46],["لَهُم","diantara mereka","lahum",11],["مِّنۢ","dari","min",0],["بَاقِيَةٍۢ","yang tertinggal/tersisa","bāqiyatin",2311]],"t":"Maka adakah kamu melihat seorang pun yang masih tersisa di antara mereka?"},{"n":9,"w":[["وَجَآءَ","dan telah datang","wajāa",43],["فِرْعَوْنُ","Fir'aun","fir'ʿawnu",160],["وَمَن","dan orang-orang","waman",12],["قَبْلَهُۥ","sebelumnya","qablahu",51],["وَٱلْمُؤْتَفِكَـٰتُ","dan negeri-negeri yang runtuh/terbalik","wal-mu'tafikātu",1912],["بِٱلْخَاطِئَةِ","dengan kesalahan-kesalahan","bil-khāṭi-ati",2730]],"t":"Kemudian datang Fir'aun dan orang-orang yang sebelumnya dan (penduduk) negeri-negeri yang dijungkir balikkan karena kesalahan yang besar."},{"n":10,"w":[["فَعَصَوْا۟","maka mereka mendurhakai","faʿaṣaw",396],["رَسُولَ","rasul","rasūla",35],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["فَأَخَذَهُمْ","maka Dia menyiksa mereka","fa-akhadhahum",94],["أَخْذَةًۭ","siksaan","akhdhatan",1136],["رَّابِيَةً","sangat keras","rābiyatan",2619]],"t":"Maka mereka mendurhakai utusan Tuhannya, Allah menyiksa mereka dengan siksaan yang sangat keras."},{"n":11,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["لَمَّا","tatkala","lammā",72],["طَغَا","naik/pasang","ṭaghā",725],["ٱلْمَآءُ","air","l-māu",192],["حَمَلْنَـٰكُمْ","kami bawa kamu","ḥamalnākum",285],["فِى","dalam","fī",3],["ٱلْجَارِيَةِ","kapal","l-jāriyati",1345]],"t":"Sesungguhnya ketika air naik (sampai ke gunung), Kami membawa (nenek moyang) kamu ke dalam kapal,"},{"n":12,"w":[["لِنَجْعَلَهَا","karena Kami akan menjadikannya","linajʿalahā",33],["لَكُمْ","bagi kalian","lakum",26],["تَذْكِرَةًۭ","peringatan/pengajaran","tadhkiratan",930],["وَتَعِيَهَآ","dan menjaga/memperhatikannya","wataʿiyahā",4448],["أُذُنٌۭ","telinga","udhunun",541],["وَٰعِيَةٌۭ","menjaga/memperhatikan","wāʿiyatun",4457]],"t":"agar Kami jadikan (peristiwa itu) sebagai peringatan bagi kamu dan agar diperhatikan oleh telinga yang mau mendengar."},{"n":13,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["نُفِخَ","ditiup","nufikha",530],["فِى","pada","fī",3],["ٱلصُّورِ","sangkakala","l-ṣūri",824],["نَفْخَةٌۭ","tiupan","nafkhatun",4023],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",364]],"t":"Maka apabila sangkakala ditiup sekali tiup,"},{"n":14,"w":[["وَحُمِلَتِ","dan diangkat","waḥumilati",285],["ٱلْأَرْضُ","bumi","l-arḍu",22],["وَٱلْجِبَالُ","dan gunung-gunung","wal-jibālu",305],["فَدُكَّتَا","lalu dihancurkan keduanya","fadukkatā",2344],["دَكَّةًۭ","kehancuran","dakkatan",3376],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",364]],"t":"dan diangkatlah bumi dan gunung-gunung, lalu dibenturkan keduanya sekali benturan."},{"n":15,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",180],["وَقَعَتِ","terjadi","waqaʿati",747],["ٱلْوَاقِعَةُ","kejadian","l-wāqiʿatu",2712]],"t":"Maka pada hari itu terjadilah hari Kiamat,"},{"n":16,"w":[["وَٱنشَقَّتِ","dan terbelahlah","wa-inshaqqati",1446],["ٱلسَّمَآءُ","langit","l-samāu",38],["فَهِىَ","maka ia","fahiya",191],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["وَاهِيَةٌۭ","lemah","wāhiyatun",4444]],"t":"dan terbelahlah langit, karena pada hari itu langit menjadi rapuh."},{"n":17,"w":[["وَٱلْمَلَكُ","dan malaikat","wal-malaku",127],["عَلَىٰٓ","di atas","ʿalā",8],["أَرْجَآئِهَا ۚ","penjuru-penjuru langit","arjāihā",4163],["وَيَحْمِلُ","dan membawa","wayaḥmilu",285],["عَرْشَ","Arsy","ʿarsha",377],["رَبِّكَ","Tuhanmu","rabbika",10],["فَوْقَهُمْ","di atas mereka","fawqahum",287],["يَوْمَئِذٍۢ","pada hari ini","yawma-idhin",180],["ثَمَـٰنِيَةٌۭ","delapan","thamāniyatun",1669]],"t":"Dan para malaikat berada di berbagai penjuru langit. Pada hari itu delapan malaikat menjunjung Arasy (singgasana) Tuhanmu di atas (kepala) mereka."},{"n":18,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",180],["تُعْرَضُونَ","kamu dihadapkan","tuʿ'raḍūna",768],["لَا","tidak","lā",4],["تَخْفَىٰ","tersembunyi","takhfā",1244],["مِنكُمْ","dari kamu","minkum",0],["خَافِيَةٌۭ","tersembunyi","khāfiyatun",4505]],"t":"Pada hari itu kamu dihadapkan (kepada Tuhanmu), tidak ada sesuatu pun dari kamu yang tersembunyi (bagi Allah)."},{"n":19,"w":[["فَأَمَّا","maka adapun","fa-ammā",217],["مَنْ","orang","man",12],["أُوتِىَ","diberikan","ūtiya",45],["كِتَـٰبَهُۥ","kitabnya","kitābahu",49],["بِيَمِينِهِۦ","di tangan kanannya","biyamīnihi",186],["فَيَقُولُ","maka ia berkata","fayaqūlu",6],["هَآؤُمُ","marilah/ambillah","hāumu",3496],["ٱقْرَءُوا۟","bacalah","iq'raū",600],["كِتَـٰبِيَهْ","kitab","kitābiyah",49]],"t":"Adapun orang yang kitabnya diberikan di tangan kanannya, maka dia berkata, \"Ambillah, bacalah kitabku (ini).\""},{"n":20,"w":[["إِنِّى","sesungguhnya aku","innī",5],["ظَنَنتُ","aku sangka/yakin","ẓanantu",252],["أَنِّى","bahwasanya aku","annī",30],["مُلَـٰقٍ","menemui","mulāqin",1374],["حِسَابِيَهْ","perhitungan","ḥisābiyah",304]],"t":"Sesungguhnya aku yakin, bahwa (suatu saat) aku akan menerima perhitungan terhadap diriku."},{"n":21,"w":[["فَهُوَ","dan dia/orang itu","fahuwa",20],["فِى","dalam","fī",3],["عِيشَةٍۢ","kehidupan","ʿīshatin",2237],["رَّاضِيَةٍۢ","yang diridhoi","rāḍiyatin",1638]],"t":"Maka orang itu berada dalam kehidupan yang diridai,"},{"n":22,"w":[["فِى","di dalam","fī",3],["جَنَّةٍ","surga","jannatin",77],["عَالِيَةٍۢ","yang tinggi","ʿāliyatin",1142]],"t":"dalam surga yang tinggi,"},{"n":23,"w":[["قُطُوفُهَا","buah-buahannya","quṭūfuhā",2587],["دَانِيَةٌۭ","dekat","dāniyatun",1828]],"t":"buah-buahannya dekat,"},{"n":24,"w":[["كُلُوا۟","makanlah","kulū",117],["وَٱشْرَبُوا۟","dan minumlah","wa-ish'rabū",611],["هَنِيٓـًٔۢا","dengan senang/penuh kepuasan","hanīan",1562],["بِمَآ","dengan apa/disebabkan","bimā",2],["أَسْلَفْتُمْ","kamu lalui/sediakan","aslaftum",2170],["فِى","pada","fī",3],["ٱلْأَيَّامِ","hari-hari","l-ayāmi",25],["ٱلْخَالِيَةِ","telah lalu","l-khāliyati",4507]],"t":"(kepada mereka dikatakan), \"Makan dan minumlah dengan nikmat karena amal yang telah kamu kerjakan pada hari-hari yang telah lalu.\""},{"n":25,"w":[["وَأَمَّا","dan adapun","wa-ammā",217],["مَنْ","orang yang","man",12],["أُوتِىَ","diberikan","ūtiya",45],["كِتَـٰبَهُۥ","kitabnya","kitābahu",49],["بِشِمَالِهِۦ","di tangan kirinya","bishimālihi",809],["فَيَقُولُ","maka dia berkata","fayaqūlu",6],["يَـٰلَيْتَنِى","Alangkah baiknya","yālaytanī",664],["لَمْ","tidak","lam",32],["أُوتَ","diberikan aku","ūta",45],["كِتَـٰبِيَهْ","kitab","kitābiyah",49]],"t":"Dan adapun orang yang kitabnya diberikan di tangan kirinya, maka dia berkata, \"Alangkah baiknya jika kitabku (ini) tidak diberikan kepadaku."},{"n":26,"w":[["وَلَمْ","dan tidak","walam",32],["أَدْرِ","aku mengetahui","adri",729],["مَا","apa","mā",2],["حِسَابِيَهْ","perhitungan","ḥisābiyah",304]],"t":"Sehingga aku tidak mengetahui bagaimana perhitunganku,"},{"n":27,"w":[["يَـٰلَيْتَهَا","seandainya itu (kematian)","yālaytahā",664],["كَانَتِ","adalah ia","kānati",9],["ٱلْقَاضِيَةَ","putusan/penyelesaian","l-qāḍiyata",4078]],"t":"Wahai, kiranya (kematian) itulah yang menyudahi segala sesuatu."},{"n":28,"w":[["مَآ","tidak","mā",2],["أَغْنَىٰ","memberi manfaat","aghnā",271],["عَنِّى","dariku/kepadaku","ʿannī",21],["مَالِيَهْ ۜ","harta","māliyah",131]],"t":"Hartaku sama sekali tidak berguna bagiku."},{"n":29,"w":[["هَلَكَ","telah binasa/lenyap","halaka",1344],["عَنِّى","daripadaku","ʿannī",21],["سُلْطَـٰنِيَهْ","kekuasaanku","sul'ṭāniyah",323]],"t":"Kekuasaanku telah hilang dariku.\""},{"n":30,"w":[["خُذُوهُ","peganglah ia/tangkaplah ia","khudhūhu",94],["فَغُلُّوهُ","lalu belenggulah ia","faghullūhu",1340]],"t":"(Allah berfirman), \"Tangkaplah dia lalu belenggulah tangannya ke lehernya.\""},{"n":31,"w":[["ثُمَّ","kemudian","thumma",34],["ٱلْجَحِيمَ","neraka jahim","l-jaḥīma",411],["صَلُّوهُ","masukkanlah ia","ṣallūhu",3246]],"t":"Kemudian masukkanlah dia ke dalam api neraka yang menyala-nyala."},{"n":32,"w":[["ثُمَّ","kemudian","thumma",34],["فِى","pada","fī",3],["سِلْسِلَةٍۢ","rantai","sil'silatin",2009],["ذَرْعُهَا","hastanya/panjangnya","dharʿuhā",1708],["سَبْعُونَ","tujuh puluh","sabʿūna",456],["ذِرَاعًۭا","hasta","dhirāʿan",2109],["فَٱسْلُكُوهُ","maka masukkan/belitkan","fa-us'lukūhu",744]],"t":"Kemudian belitlah dia dengan rantai yang panjangnya tujuh puluh hasta."},{"n":33,"w":[["إِنَّهُۥ","sesungguhnya","innahu",5],["كَانَ","adalah ia","kāna",9],["لَا","tidak","lā",4],["يُؤْمِنُ","beriman","yu'minu",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["ٱلْعَظِيمِ","Maha Besar","l-ʿaẓīmi",100]],"t":"Sesungguhnya dialah orang yang tidak beriman kepada Allah Yang Mahabesar."},{"n":34,"w":[["وَلَا","dan tidak","walā",4],["يَحُضُّ","ia menganjurkan","yaḥuḍḍu",2252],["عَلَىٰ","untuk","ʿalā",8],["طَعَامِ","memberi makan","ṭaʿāmi",437],["ٱلْمِسْكِينِ","orang-orang miskin","l-mis'kīni",453]],"t":"Dan juga dia tidak mendorong (orang lain) untuk memberi makan orang miskin."},{"n":35,"w":[["فَلَيْسَ","maka tidak","falaysa",123],["لَهُ","baginya","lahu",16],["ٱلْيَوْمَ","hari ini","l-yawma",25],["هَـٰهُنَا","di sini","hāhunā",1563],["حَمِيمٌۭ","seorang teman","ḥamīmun",504]],"t":"Maka pada hari ini di sini tidak ada seorang teman pun baginya."},{"n":36,"w":[["وَلَا","dan tidak ada","walā",4],["طَعَامٌ","makanan","ṭaʿāmun",437],["إِلَّا","kecuali","illā",15],["مِنْ","dari","min",0],["غِسْلِينٍۢ","kotoran/nanah dan darah","ghis'līnin",3490]],"t":"Dan tidak ada makanan (baginya) kecuali dari darah dan nanah."},{"n":37,"w":[["لَّا","tidak ada","lā",4],["يَأْكُلُهُۥٓ","yang memakannya","yakuluhu",117],["إِلَّا","kecuali","illā",15],["ٱلْخَـٰطِـُٔونَ","orang-orang yang bersalah/berdosa","l-khāṭiūna",1429]],"t":"Tidak ada yang memakannya kecuali orang-orang yang berdosa."},{"n":38,"w":[["فَلَآ","maka","falā",4],["أُقْسِمُ","Aku bersumpah","uq'simu",501],["بِمَا","dengan apa","bimā",2],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",375]],"t":"Maka Aku bersumpah demi apa yang kamu lihat,"},{"n":39,"w":[["وَمَا","dan apa yang","wamā",2],["لَا","tidak","lā",4],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",375]],"t":"dan demi apa yang tidak kamu lihat."},{"n":40,"w":[["إِنَّهُۥ","sesungguhnya ia (Al Qur'an)","innahu",5],["لَقَوْلُ","benar-benar perkataan","laqawlu",119],["رَسُولٍۢ","rasul","rasūlin",35],["كَرِيمٍۢ","yang mulia","karīmin",368]],"t":"Sesungguhnya ia (Alquran) benar-benar wahyu (yang diturunkan kepada) Rasul yang mulia,"},{"n":41,"w":[["وَمَا","dan tidaklah","wamā",2],["هُوَ","ia (Al Qur'an)","huwa",20],["بِقَوْلِ","dengan perkataan","biqawli",119],["شَاعِرٍۢ ۚ","seorang penyair","shāʿirin",1256],["قَلِيلًۭا","sedikit","qalīlan",175],["مَّا","tidak","mā",2],["تُؤْمِنُونَ","kamu beriman","tu'minūna",18]],"t":"dan ia (Alquran) bukanlah perkataan seorang penyair. Sedikit sekali kamu yang beriman kepadanya."},{"n":42,"w":[["وَلَا","dan tidak","walā",4],["بِقَوْلِ","perkataan","biqawli",119],["كَاهِنٍۢ ۚ","dukun/tukang tenung","kāhinin",2408],["قَلِيلًۭا","sedikit","qalīlan",175],["مَّا","tidak","mā",2],["تَذَكَّرُونَ","kamu ingat mengambil pelajaran","tadhakkarūna",233]],"t":"Dan bukan pula perkataan tukang tenung. Sedikit sekali kamu yang mengambil pelajaran darinya."},{"n":43,"w":[["تَنزِيلٌۭ","diturunkan","tanzīlun",636],["مِّن","dari","min",0],["رَّبِّ","Tuhan","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",163]],"t":"Ia (Alquran) adalah wahyu yang diturunkan dari Tuhan seluruh alam."},{"n":44,"w":[["وَلَوْ","dan seandaiannya","walaw",57],["تَقَوَّلَ","dia mengadakan perkataan","taqawwala",2683],["عَلَيْنَا","atas Kami","ʿalaynā",8],["بَعْضَ","sebagian","baʿḍa",71],["ٱلْأَقَاوِيلِ","perkataan","l-aqāwīli",119]],"t":"Dan sekiranya dia (Muhammad) mengada-adakan sebagian perkataan atas (nama) Kami,"},{"n":45,"w":[["لَأَخَذْنَا","niscaya Kami ambil","la-akhadhnā",94],["مِنْهُ","darinya","min'hu",0],["بِٱلْيَمِينِ","dengan tangan kanan","bil-yamīni",186]],"t":"pasti Kami pegang dia pada tangan kanannya."},{"n":46,"w":[["ثُمَّ","kemudian","thumma",34],["لَقَطَعْنَا","pasti Kami potong","laqaṭaʿnā",741],["مِنْهُ","daripadanya","min'hu",0],["ٱلْوَتِينَ","urat jantung","l-watīna",4488]],"t":"Kemudian Kami potong pembuluh jantungnya."},{"n":47,"w":[["فَمَا","maka tidak","famā",2],["مِنكُم","dari kamu","minkum",0],["مِّنْ","dari","min",0],["أَحَدٍ","seorang","aḥadin",159],["عَنْهُ","daripadanya","ʿanhu",21],["حَـٰجِزِينَ","orang-orang yang menahan/menghalangi","ḥājizīna",2248]],"t":"Maka tidak seorang pun dari kamu yang dapat menghalangi (Kami untuk menghukumnya)."},{"n":48,"w":[["وَإِنَّهُۥ","dan sesungguhnya","wa-innahu",5],["لَتَذْكِرَةٌۭ","benar-benar peringatan","latadhkiratun",930],["لِّلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",245]],"t":"Dan sungguh, Alquran itu pelajaran bagi orang-orang yang bertakwa."},{"n":49,"w":[["وَإِنَّا","dan sesungguhnya Kami","wa-innā",5],["لَنَعْلَمُ","benar-benar Kami mengetahui","lanaʿlamu",29],["أَنَّ","bahwa","anna",30],["مِنكُم","diantara kamu","minkum",0],["مُّكَذِّبِينَ","orang-orang yang mendustakan","mukadhibīna",490]],"t":"Dan sungguh, Kami mengetahui bahwa di antara kamu ada orang yang mendustakan."},{"n":50,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia (Al Qur'an)","wa-innahu",5],["لَحَسْرَةٌ","benar-benar penyesalan","laḥasratun",959],["عَلَى","atas","ʿalā",8],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",70]],"t":"Dan sungguh, Alquran itu akan menimbulkan penyesalan bagi orang-orang kafir (di akhirat)."},{"n":51,"w":[["وَإِنَّهُۥ","dan sesungguhnya (Al Qur'an)","wa-innahu",5],["لَحَقُّ","nyata-nyata kebenaran","laḥaqqu",50],["ٱلْيَقِينِ","yang diyakini","l-yaqīni",1012]],"t":"Dan sungguh, Alquran itu kebenaran yang meyakinkan."},{"n":52,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",279],["بِٱسْمِ","dengan nama","bi-is'mi",309],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",100]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahaagung."}]