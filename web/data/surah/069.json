[{"n":1,"w":[["ٱلْحَآقَّةُ","keadaan yang sebenarnya","al-ḥāqatu",1800]],"t":"Hari kiamat,"},{"n":2,"w":[["مَا","apakah","mā",6],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1800]],"t":"apakah hari Kiamat itu?"},{"n":3,"w":[["وَمَآ","dan apakah","wamā",6],["أَدْرَىٰكَ","kamu mengetahui","adrāka",574],["مَا","apa","mā",6],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1800]],"t":"Dan tahukah kamu apakah hari Kiamat itu?"},{"n":4,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",72],["ثَمُودُ","kaum Tsamud","thamūdu",430],["وَعَادٌۢ","dan kaum 'Ad","waʿādun",449],["بِٱلْقَارِعَةِ","dengan yang mengejutkan/hari kiamat","bil-qāriʿati",1412]],"t":"Kaum Samud, dan 'Ād telah mendustakan hari Kiamat."},{"n":5,"w":[["فَأَمَّا","maka adapun","fa-ammā",229],["ثَمُودُ","kaum Tsamud","thamūdu",430],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",243],["بِٱلطَّاغِيَةِ","dengan teriakan/kejadian luar biasa","bil-ṭāghiyati",3316]],"t":"Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,"},{"n":6,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["عَادٌۭ","kaum 'Ad","ʿādun",449],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",243],["بِرِيحٍۢ","dengan angin","birīḥin",397],["صَرْصَرٍ","sangat dingin","ṣarṣarin",1822],["عَاتِيَةٍۢ","amat kencang","ʿātiyatin",3090]],"t":"sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,"},{"n":7,"w":[["سَخَّرَهَا","dia menimpakannya(angin itu)","sakharahā",488],["عَلَيْهِمْ","atas mereka","ʿalayhim",11],["سَبْعَ","tujuh","sabʿa",470],["لَيَالٍۢ","malam","layālin",146],["وَثَمَـٰنِيَةَ","dan delapan","wathamāniyata",1687],["أَيَّامٍ","hari","ayyāmin",31],["حُسُومًۭا","terus menerus","ḥusūman",3223],["فَتَرَى","kamu melihat","fatarā",54],["ٱلْقَوْمَ","kaum","l-qawma",33],["فِيهَا","padanya/pada waktu itu","fīhā",7],["صَرْعَىٰ","mati bergelimpangan","ṣarʿā",3267],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",395],["أَعْجَازُ","batang","aʿjāzu",2234],["نَخْلٍ","korma","nakhlin",564],["خَاوِيَةٍۢ","lapuk/tumbang","khāwiyatin",1443]],"t":"Allah menimpakan angin itu kepada mereka selama tujuh malam delapan hari terus-menerus; maka kamu melihat kaum 'Ād pada waktu itu mati bergelimpangan seperti batang-batang pohon kurma yang telah kosong (lapuk)."},{"n":8,"w":[["فَهَلْ","maka adakah","fahal",128],["تَرَىٰ","kamu melihat","tarā",54],["لَهُم","diantara mereka","lahum",16],["مِّنۢ","dari","min",1],["بَاقِيَةٍۢ","yang tertinggal/tersisa","bāqiyatin",2328]],"t":"Maka adakah kamu melihat seorang pun yang masih tersisa di antara mereka?"},{"n":9,"w":[["وَجَآءَ","dan telah datang","wajāa",51],["فِرْعَوْنُ","Fir'aun","fir'ʿawnu",171],["وَمَن","dan orang-orang","waman",17],["قَبْلَهُۥ","sebelumnya","qablahu",59],["وَٱلْمُؤْتَفِكَـٰتُ","dan negeri-negeri yang runtuh/terbalik","wal-mu'tafikātu",1930],["بِٱلْخَاطِئَةِ","dengan kesalahan-kesalahan","bil-khāṭi-ati",2748]],"t":"Kemudian datang Fir'aun dan orang-orang yang sebelumnya dan (penduduk) negeri-negeri yang dijungkir balikkan karena kesalahan yang besar."},{"n":10,"w":[["فَعَصَوْا۟","maka mereka mendurhakai","faʿaṣaw",411],["رَسُولَ","rasul","rasūla",42],["رَبِّهِمْ","Tuhan mereka","rabbihim",15],["فَأَخَذَهُمْ","maka Dia menyiksa mereka","fa-akhadhahum",103],["أَخْذَةًۭ","siksaan","akhdhatan",1154],["رَّابِيَةً","sangat keras","rābiyatan",2637]],"t":"Maka mereka mendurhakai utusan Tuhannya, Allah menyiksa mereka dengan siksaan yang sangat keras."},{"n":11,"w":[["إِنَّا","sesungguhnya Kami","innā",9],["لَمَّا","tatkala","lammā",81],["طَغَا","naik/pasang","ṭaghā",740],["ٱلْمَآءُ","air","l-māu",204],["حَمَلْنَـٰكُمْ","kami bawa kamu","ḥamalnākum",299],["فِى","dalam","fī",7],["ٱلْجَارِيَةِ","kapal","l-jāriyati",1363]],"t":"Sesungguhnya ketika air naik (sampai ke gunung), Kami membawa (nenek moyang) kamu ke dalam kapal,"},{"n":12,"w":[["لِنَجْعَلَهَا","karena Kami akan menjadikannya","linajʿalahā",40],["لَكُمْ","bagi kalian","lakum",32],["تَذْكِرَةًۭ","peringatan/pengajaran","tadhkiratan",948],["وَتَعِيَهَآ","dan menjaga/memperhatikannya","wataʿiyahā",4466],["أُذُنٌۭ","telinga","udhunun",555],["وَٰعِيَةٌۭ","menjaga/memperhatikan","wāʿiyatun",4475]],"t":"agar Kami jadikan (peristiwa itu) sebagai peringatan bagi kamu dan agar diperhatikan oleh telinga yang mau mendengar."},{"n":13,"w":[["فَإِذَا","maka apabila","fa-idhā",29],["نُفِخَ","ditiup","nufikha",544],["فِى","pada","fī",7],["ٱلصُّورِ","sangkakala","l-ṣūri",840],["نَفْخَةٌۭ","tiupan","nafkhatun",4041],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",379]],"t":"Maka apabila sangkakala ditiup sekali tiup,"},{"n":14,"w":[["وَحُمِلَتِ","dan diangkat","waḥumilati",299],["ٱلْأَرْضُ","bumi","l-arḍu",28],["وَٱلْجِبَالُ","dan gunung-gunung","wal-jibālu",320],["فَدُكَّتَا","lalu dihancurkan keduanya","fadukkatā",2362],["دَكَّةًۭ","kehancuran","dakkatan",3394],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",379]],"t":"dan diangkatlah bumi dan gunung-gunung, lalu dibenturkan keduanya sekali benturan."},{"n":15,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",191],["وَقَعَتِ","terjadi","waqaʿati",762],["ٱلْوَاقِعَةُ","kejadian","l-wāqiʿatu",2730]],"t":"Maka pada hari itu terjadilah hari Kiamat,"},{"n":16,"w":[["وَٱنشَقَّتِ","dan terbelahlah","wa-inshaqqati",1464],["ٱلسَّمَآءُ","langit","l-samāu",44],["فَهِىَ","maka ia","fahiya",203],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["وَاهِيَةٌۭ","lemah","wāhiyatun",4462]],"t":"dan terbelahlah langit, karena pada hari itu langit menjadi rapuh."},{"n":17,"w":[["وَٱلْمَلَكُ","dan malaikat","wal-malaku",137],["عَلَىٰٓ","di atas","ʿalā",11],["أَرْجَآئِهَا ۚ","penjuru-penjuru langit","arjāihā",4181],["وَيَحْمِلُ","dan membawa","wayaḥmilu",299],["عَرْشَ","Arsy","ʿarsha",392],["رَبِّكَ","Tuhanmu","rabbika",15],["فَوْقَهُمْ","di atas mereka","fawqahum",301],["يَوْمَئِذٍۢ","pada hari ini","yawma-idhin",191],["ثَمَـٰنِيَةٌۭ","delapan","thamāniyatun",1687]],"t":"Dan para malaikat berada di berbagai penjuru langit. Pada hari itu delapan malaikat menjunjung Arasy (singgasana) Tuhanmu di atas (kepala) mereka."},{"n":18,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",191],["تُعْرَضُونَ","kamu dihadapkan","tuʿ'raḍūna",783],["لَا","tidak","lā",8],["تَخْفَىٰ","tersembunyi","takhfā",1262],["مِنكُمْ","dari kamu","minkum",1],["خَافِيَةٌۭ","tersembunyi","khāfiyatun",4523]],"t":"Pada hari itu kamu dihadapkan (kepada Tuhanmu), tidak ada sesuatu pun dari kamu yang tersembunyi (bagi Allah)."},{"n":19,"w":[["فَأَمَّا","maka adapun","fa-ammā",229],["مَنْ","orang","man",17],["أُوتِىَ","diberikan","ūtiya",53],["كِتَـٰبَهُۥ","kitabnya","kitābahu",57],["بِيَمِينِهِۦ","di tangan kanannya","biyamīnihi",198],["فَيَقُولُ","maka ia berkata","fayaqūlu",10],["هَآؤُمُ","marilah/ambillah","hāumu",3514],["ٱقْرَءُوا۟","bacalah","iq'raū",614],["كِتَـٰبِيَهْ","kitab","kitābiyah",57]],"t":"Adapun orang yang kitabnya diberikan di tangan kanannya, maka dia berkata, \"Ambillah, bacalah kitabku (ini).\""},{"n":20,"w":[["إِنِّى","sesungguhnya aku","innī",9],["ظَنَنتُ","aku sangka/yakin","ẓanantu",264],["أَنِّى","bahwasanya aku","annī",36],["مُلَـٰقٍ","menemui","mulāqin",1392],["حِسَابِيَهْ","perhitungan","ḥisābiyah",319]],"t":"Sesungguhnya aku yakin, bahwa (suatu saat) aku akan menerima perhitungan terhadap diriku."},{"n":21,"w":[["فَهُوَ","dan dia/orang itu","fahuwa",25],["فِى","dalam","fī",7],["عِيشَةٍۢ","kehidupan","ʿīshatin",2254],["رَّاضِيَةٍۢ","yang diridhoi","rāḍiyatin",1656]],"t":"Maka orang itu berada dalam kehidupan yang diridai,"},{"n":22,"w":[["فِى","di dalam","fī",7],["جَنَّةٍ","surga","jannatin",86],["عَالِيَةٍۢ","yang tinggi","ʿāliyatin",1160]],"t":"dalam surga yang tinggi,"},{"n":23,"w":[["قُطُوفُهَا","buah-buahannya","quṭūfuhā",2605],["دَانِيَةٌۭ","dekat","dāniyatun",1846]],"t":"buah-buahannya dekat,"},{"n":24,"w":[["كُلُوا۟","makanlah","kulū",127],["وَٱشْرَبُوا۟","dan minumlah","wa-ish'rabū",625],["هَنِيٓـًٔۢا","dengan senang/penuh kepuasan","hanīan",1580],["بِمَآ","dengan apa/disebabkan","bimā",6],["أَسْلَفْتُمْ","kamu lalui/sediakan","aslaftum",2188],["فِى","pada","fī",7],["ٱلْأَيَّامِ","hari-hari","l-ayāmi",31],["ٱلْخَالِيَةِ","telah lalu","l-khāliyati",4525]],"t":"(kepada mereka dikatakan), \"Makan dan minumlah dengan nikmat karena amal yang telah kamu kerjakan pada hari-hari yang telah lalu.\""},{"n":25,"w":[["وَأَمَّا","dan adapun","wa-ammā",229],["مَنْ","orang yang","man",17],["أُوتِىَ","diberikan","ūtiya",53],["كِتَـٰبَهُۥ","kitabnya","kitābahu",57],["بِشِمَالِهِۦ","di tangan kirinya","bishimālihi",824],["فَيَقُولُ","maka dia berkata","fayaqūlu",10],["يَـٰلَيْتَنِى","Alangkah baiknya","yālaytanī",679],["لَمْ","tidak","lam",39],["أُوتَ","diberikan aku","ūta",53],["كِتَـٰبِيَهْ","kitab","kitābiyah",57]],"t":"Dan adapun orang yang kitabnya diberikan di tangan kirinya, maka dia berkata, \"Alangkah baiknya jika kitabku (ini) tidak diberikan kepadaku."},{"n":26,"w":[["وَلَمْ","dan tidak","walam",39],["أَدْرِ","aku mengetahui","adri",744],["مَا","apa","mā",6],["حِسَابِيَهْ","perhitungan","ḥisābiyah",319]],"t":"Sehingga aku tidak mengetahui bagaimana perhitunganku,"},{"n":27,"w":[["يَـٰلَيْتَهَا","seandainya itu (kematian)","yālaytahā",679],["كَانَتِ","adalah ia","kānati",12],["ٱلْقَاضِيَةَ","putusan/penyelesaian","l-qāḍiyata",4096]],"t":"Wahai, kiranya (kematian) itulah yang menyudahi segala sesuatu."},{"n":28,"w":[["مَآ","tidak","mā",6],["أَغْنَىٰ","memberi manfaat","aghnā",285],["عَنِّى","dariku/kepadaku","ʿannī",27],["مَالِيَهْ ۜ","harta","māliyah",141]],"t":"Hartaku sama sekali tidak berguna bagiku."},{"n":29,"w":[["هَلَكَ","telah binasa/lenyap","halaka",1362],["عَنِّى","daripadaku","ʿannī",27],["سُلْطَـٰنِيَهْ","kekuasaanku","sul'ṭāniyah",338]],"t":"Kekuasaanku telah hilang dariku.\""},{"n":30,"w":[["خُذُوهُ","peganglah ia/tangkaplah ia","khudhūhu",103],["فَغُلُّوهُ","lalu belenggulah ia","faghullūhu",1358]],"t":"(Allah berfirman), \"Tangkaplah dia lalu belenggulah tangannya ke lehernya.\""},{"n":31,"w":[["ثُمَّ","kemudian","thumma",41],["ٱلْجَحِيمَ","neraka jahim","l-jaḥīma",426],["صَلُّوهُ","masukkanlah ia","ṣallūhu",3264]],"t":"Kemudian masukkanlah dia ke dalam api neraka yang menyala-nyala."},{"n":32,"w":[["ثُمَّ","kemudian","thumma",41],["فِى","pada","fī",7],["سِلْسِلَةٍۢ","rantai","sil'silatin",2027],["ذَرْعُهَا","hastanya/panjangnya","dharʿuhā",1726],["سَبْعُونَ","tujuh puluh","sabʿūna",470],["ذِرَاعًۭا","hasta","dhirāʿan",2127],["فَٱسْلُكُوهُ","maka masukkan/belitkan","fa-us'lukūhu",759]],"t":"Kemudian belitlah dia dengan rantai yang panjangnya tujuh puluh hasta."},{"n":33,"w":[["إِنَّهُۥ","sesungguhnya","innahu",9],["كَانَ","adalah ia","kāna",12],["لَا","tidak","lā",8],["يُؤْمِنُ","beriman","yu'minu",23],["بِٱللَّهِ","kepada Allah","bil-lahi",4],["ٱلْعَظِيمِ","Maha Besar","l-ʿaẓīmi",118]],"t":"Sesungguhnya dialah orang yang tidak beriman kepada Allah Yang Mahabesar."},{"n":34,"w":[["وَلَا","dan tidak","walā",8],["يَحُضُّ","ia menganjurkan","yaḥuḍḍu",2269],["عَلَىٰ","untuk","ʿalā",11],["طَعَامِ","memberi makan","ṭaʿāmi",452],["ٱلْمِسْكِينِ","orang-orang miskin","l-mis'kīni",467]],"t":"Dan juga dia tidak mendorong (orang lain) untuk memberi makan orang miskin."},{"n":35,"w":[["فَلَيْسَ","maka tidak","falaysa",133],["لَهُ","baginya","lahu",21],["ٱلْيَوْمَ","hari ini","l-yawma",31],["هَـٰهُنَا","di sini","hāhunā",1581],["حَمِيمٌۭ","seorang teman","ḥamīmun",517]],"t":"Maka pada hari ini di sini tidak ada seorang teman pun baginya."},{"n":36,"w":[["وَلَا","dan tidak ada","walā",8],["طَعَامٌ","makanan","ṭaʿāmun",452],["إِلَّا","kecuali","illā",20],["مِنْ","dari","min",1],["غِسْلِينٍۢ","kotoran/nanah dan darah","ghis'līnin",3508]],"t":"Dan tidak ada makanan (baginya) kecuali dari darah dan nanah."},{"n":37,"w":[["لَّا","tidak ada","lā",8],["يَأْكُلُهُۥٓ","yang memakannya","yakuluhu",127],["إِلَّا","kecuali","illā",20],["ٱلْخَـٰطِـُٔونَ","orang-orang yang bersalah/berdosa","l-khāṭiūna",1447]],"t":"Tidak ada yang memakannya kecuali orang-orang yang berdosa."},{"n":38,"w":[["فَلَآ","maka","falā",8],["أُقْسِمُ","Aku bersumpah","uq'simu",514],["بِمَا","dengan apa","bimā",6],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",390]],"t":"Maka Aku bersumpah demi apa yang kamu lihat,"},{"n":39,"w":[["وَمَا","dan apa yang","wamā",6],["لَا","tidak","lā",8],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",390]],"t":"dan demi apa yang tidak kamu lihat."},{"n":40,"w":[["إِنَّهُۥ","sesungguhnya ia (Al Qur'an)","innahu",9],["لَقَوْلُ","benar-benar perkataan","laqawlu",129],["رَسُولٍۢ","rasul","rasūlin",42],["كَرِيمٍۢ","yang mulia","karīmin",383]],"t":"Sesungguhnya ia (Alquran) benar-benar wahyu (yang diturunkan kepada) Rasul yang mulia,"},{"n":41,"w":[["وَمَا","dan tidaklah","wamā",6],["هُوَ","ia (Al Qur'an)","huwa",25],["بِقَوْلِ","dengan perkataan","biqawli",129],["شَاعِرٍۢ ۚ","seorang penyair","shāʿirin",1274],["قَلِيلًۭا","sedikit","qalīlan",186],["مَّا","tidak","mā",6],["تُؤْمِنُونَ","kamu beriman","tu'minūna",23]],"t":"dan ia (Alquran) bukanlah perkataan seorang penyair. Sedikit sekali kamu yang beriman kepadanya."},{"n":42,"w":[["وَلَا","dan tidak","walā",8],["بِقَوْلِ","perkataan","biqawli",129],["كَاهِنٍۢ ۚ","dukun/tukang tenung","kāhinin",2426],["قَلِيلًۭا","sedikit","qalīlan",186],["مَّا","tidak","mā",6],["تَذَكَّرُونَ","kamu ingat mengambil pelajaran","tadhakkarūna",245]],"t":"Dan bukan pula perkataan tukang tenung. Sedikit sekali kamu yang mengambil pelajaran darinya."},{"n":43,"w":[["تَنزِيلٌۭ","diturunkan","tanzīlun",651],["مِّن","dari","min",1],["رَّبِّ","Tuhan","rabbi",15],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",174]],"t":"Ia (Alquran) adalah wahyu yang diturunkan dari Tuhan seluruh alam."},{"n":44,"w":[["وَلَوْ","dan seandaiannya","walaw",66],["تَقَوَّلَ","dia mengadakan perkataan","taqawwala",2701],["عَلَيْنَا","atas Kami","ʿalaynā",11],["بَعْضَ","sebagian","baʿḍa",80],["ٱلْأَقَاوِيلِ","perkataan","l-aqāwīli",129]],"t":"Dan sekiranya dia (Muhammad) mengada-adakan sebagian perkataan atas (nama) Kami,"},{"n":45,"w":[["لَأَخَذْنَا","niscaya Kami ambil","la-akhadhnā",103],["مِنْهُ","darinya","min'hu",1],["بِٱلْيَمِينِ","dengan tangan kanan","bil-yamīni",198]],"t":"pasti Kami pegang dia pada tangan kanannya."},{"n":46,"w":[["ثُمَّ","kemudian","thumma",41],["لَقَطَعْنَا","pasti Kami potong","laqaṭaʿnā",756],["مِنْهُ","daripadanya","min'hu",1],["ٱلْوَتِينَ","urat jantung","l-watīna",4506]],"t":"Kemudian Kami potong pembuluh jantungnya."},{"n":47,"w":[["فَمَا","maka tidak","famā",6],["مِنكُم","dari kamu","minkum",1],["مِّنْ","dari","min",1],["أَحَدٍ","seorang","aḥadin",170],["عَنْهُ","daripadanya","ʿanhu",27],["حَـٰجِزِينَ","orang-orang yang menahan/menghalangi","ḥājizīna",2265]],"t":"Maka tidak seorang pun dari kamu yang dapat menghalangi (Kami untuk menghukumnya)."},{"n":48,"w":[["وَإِنَّهُۥ","dan sesungguhnya","wa-innahu",9],["لَتَذْكِرَةٌۭ","benar-benar peringatan","latadhkiratun",948],["لِّلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",257]],"t":"Dan sungguh, Alquran itu pelajaran bagi orang-orang yang bertakwa."},{"n":49,"w":[["وَإِنَّا","dan sesungguhnya Kami","wa-innā",9],["لَنَعْلَمُ","benar-benar Kami mengetahui","lanaʿlamu",35],["أَنَّ","bahwa","anna",36],["مِنكُم","diantara kamu","minkum",1],["مُّكَذِّبِينَ","orang-orang yang mendustakan","mukadhibīna",503]],"t":"Dan sungguh, Kami mengetahui bahwa di antara kamu ada orang yang mendustakan."},{"n":50,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia (Al Qur'an)","wa-innahu",9],["لَحَسْرَةٌ","benar-benar penyesalan","laḥasratun",976],["عَلَى","atas","ʿalā",11],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",79]],"t":"Dan sungguh, Alquran itu akan menimbulkan penyesalan bagi orang-orang kafir (di akhirat)."},{"n":51,"w":[["وَإِنَّهُۥ","dan sesungguhnya (Al Qur'an)","wa-innahu",9],["لَحَقُّ","nyata-nyata kebenaran","laḥaqqu",58],["ٱلْيَقِينِ","yang diyakini","l-yaqīni",1030]],"t":"Dan sungguh, Alquran itu kebenaran yang meyakinkan."},{"n":52,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",293],["بِٱسْمِ","dengan nama","bi-is'mi",324],["رَبِّكَ","Tuhanmu","rabbika",15],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",118]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahaagung."}]