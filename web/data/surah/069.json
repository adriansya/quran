[{"n":1,"w":[["ٱلْحَآقَّةُ","keadaan yang sebenarnya","al-ḥāqatu",1788]],"t":"Hari kiamat,"},{"n":2,"w":[["مَا","apakah","mā",2],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1788]],"t":"apakah hari Kiamat itu?"},{"n":3,"w":[["وَمَآ","dan apakah","wamā",2],["أَدْرَىٰكَ","kamu mengetahui","adrāka",565],["مَا","apa","mā",2],["ٱلْحَآقَّةُ","keadaan yang sebenarnya","l-ḥāqatu",1788]],"t":"Dan tahukah kamu apakah hari Kiamat itu?"},{"n":4,"w":[["كَذَّبَتْ","telah mendustakan","kadhabat",64],["ثَمُودُ","kaum Tsamud","thamūdu",420],["وَعَادٌۢ","dan kaum 'Ad","waʿādun",439],["بِٱلْقَارِعَةِ","dengan yang mengejutkan/hari kiamat","bil-qāriʿati",1400]],"t":"Kaum Samud, dan 'Ād telah mendustakan hari Kiamat."},{"n":5,"w":[["فَأَمَّا","maka adapun","fa-ammā",219],["ثَمُودُ","kaum Tsamud","thamūdu",420],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",233],["بِٱلطَّاغِيَةِ","dengan teriakan/kejadian luar biasa","bil-ṭāghiyati",3305]],"t":"Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,"},{"n":6,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["عَادٌۭ","kaum 'Ad","ʿādun",439],["فَأُهْلِكُوا۟","maka mereka dibinasakan","fa-uh'likū",233],["بِرِيحٍۢ","dengan angin","birīḥin",387],["صَرْصَرٍ","sangat dingin","ṣarṣarin",1810],["عَاتِيَةٍۢ","amat kencang","ʿātiyatin",3079]],"t":"sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,"},{"n":7,"w":[["سَخَّرَهَا","dia menimpakannya(angin itu)","sakharahā",480],["عَلَيْهِمْ","atas mereka","ʿalayhim",7],["سَبْعَ","tujuh","sabʿa",461],["لَيَالٍۢ","malam","layālin",137],["وَثَمَـٰنِيَةَ","dan delapan","wathamāniyata",1675],["أَيَّامٍ","hari","ayyāmin",25],["حُسُومًۭا","terus menerus","ḥusūman",3212],["فَتَرَى","kamu melihat","fatarā",46],["ٱلْقَوْمَ","kaum","l-qawma",27],["فِيهَا","padanya/pada waktu itu","fīhā",3],["صَرْعَىٰ","mati bergelimpangan","ṣarʿā",3256],["كَأَنَّهُمْ","seakan-akan mereka","ka-annahum",385],["أَعْجَازُ","batang","aʿjāzu",2223],["نَخْلٍ","korma","nakhlin",555],["خَاوِيَةٍۢ","lapuk/tumbang","khāwiyatin",1431]],"t":"Allah menimpakan angin itu kepada mereka selama tujuh malam delapan hari terus-menerus; maka kamu melihat kaum 'Ād pada waktu itu mati bergelimpangan seperti batang-batang pohon kurma yang telah kosong (lapuk)."},{"n":8,"w":[["فَهَلْ","maka adakah","fahal",119],["تَرَىٰ","kamu melihat","tarā",46],["لَهُم","diantara mereka","lahum",11],["مِّنۢ","dari","min",0],["بَاقِيَةٍۢ","yang tertinggal/tersisa","bāqiyatin",2317]],"t":"Maka adakah kamu melihat seorang pun yang masih tersisa di antara mereka?"},{"n":9,"w":[["وَجَآءَ","dan telah datang","wajāa",43],["فِرْعَوْنُ","Fir'aun","fir'ʿawnu",161],["وَمَن","dan orang-orang","waman",12],["قَبْلَهُۥ","sebelumnya","qablahu",51],["وَٱلْمُؤْتَفِكَـٰتُ","dan negeri-negeri yang runtuh/terbalik","wal-mu'tafikātu",1918],["بِٱلْخَاطِئَةِ","dengan kesalahan-kesalahan","bil-khāṭi-ati",2736]],"t":"Kemudian datang Fir'aun dan orang-orang yang sebelumnya dan (penduduk) negeri-negeri yang dijungkir balikkan karena kesalahan yang besar."},{"n":10,"w":[["فَعَصَوْا۟","maka mereka mendurhakai","faʿaṣaw",401],["رَسُولَ","rasul","rasūla",35],["رَبِّهِمْ","Tuhan mereka","rabbihim",10],["فَأَخَذَهُمْ","maka Dia menyiksa mereka","fa-akhadhahum",95],["أَخْذَةًۭ","siksaan","akhdhatan",1142],["رَّابِيَةً","sangat keras","rābiyatan",2625]],"t":"Maka mereka mendurhakai utusan Tuhannya, Allah menyiksa mereka dengan siksaan yang sangat keras."},{"n":11,"w":[["إِنَّا","sesungguhnya Kami","innā",5],["لَمَّا","tatkala","lammā",73],["طَغَا","naik/pasang","ṭaghā",730],["ٱلْمَآءُ","air","l-māu",194],["حَمَلْنَـٰكُمْ","kami bawa kamu","ḥamalnākum",289],["فِى","dalam","fī",3],["ٱلْجَارِيَةِ","kapal","l-jāriyati",1351]],"t":"Sesungguhnya ketika air naik (sampai ke gunung), Kami membawa (nenek moyang) kamu ke dalam kapal,"},{"n":12,"w":[["لِنَجْعَلَهَا","karena Kami akan menjadikannya","linajʿalahā",33],["لَكُمْ","bagi kalian","lakum",26],["تَذْكِرَةًۭ","peringatan/pengajaran","tadhkiratan",936],["وَتَعِيَهَآ","dan menjaga/memperhatikannya","wataʿiyahā",4455],["أُذُنٌۭ","telinga","udhunun",546],["وَٰعِيَةٌۭ","menjaga/memperhatikan","wāʿiyatun",4464]],"t":"agar Kami jadikan (peristiwa itu) sebagai peringatan bagi kamu dan agar diperhatikan oleh telinga yang mau mendengar."},{"n":13,"w":[["فَإِذَا","maka apabila","fa-idhā",23],["نُفِخَ","ditiup","nufikha",535],["فِى","pada","fī",3],["ٱلصُّورِ","sangkakala","l-ṣūri",829],["نَفْخَةٌۭ","tiupan","nafkhatun",4030],["وَٰحِدَةٌۭ","satu/sekali","wāḥidatun",369]],"t":"Maka apabila sangkakala ditiup sekali tiup,"},{"n":14,"w":[["وَحُمِلَتِ","dan diangkat","waḥumilati",289],["ٱلْأَرْضُ","bumi","l-arḍu",22],["وَٱلْجِبَالُ","dan gunung-gunung","wal-jibālu",310],["فَدُكَّتَا","lalu dihancurkan keduanya","fadukkatā",2350],["دَكَّةًۭ","kehancuran","dakkatan",3383],["وَٰحِدَةًۭ","satu/sekali","wāḥidatan",369]],"t":"dan diangkatlah bumi dan gunung-gunung, lalu dibenturkan keduanya sekali benturan."},{"n":15,"w":[["فَيَوْمَئِذٍۢ","maka pada hari itu","fayawma-idhin",181],["وَقَعَتِ","terjadi","waqaʿati",752],["ٱلْوَاقِعَةُ","kejadian","l-wāqiʿatu",2718]],"t":"Maka pada hari itu terjadilah hari Kiamat,"},{"n":16,"w":[["وَٱنشَقَّتِ","dan terbelahlah","wa-inshaqqati",1452],["ٱلسَّمَآءُ","langit","l-samāu",37],["فَهِىَ","maka ia","fahiya",193],["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["وَاهِيَةٌۭ","lemah","wāhiyatun",4451]],"t":"dan terbelahlah langit, karena pada hari itu langit menjadi rapuh."},{"n":17,"w":[["وَٱلْمَلَكُ","dan malaikat","wal-malaku",128],["عَلَىٰٓ","di atas","ʿalā",7],["أَرْجَآئِهَا ۚ","penjuru-penjuru langit","arjāihā",4170],["وَيَحْمِلُ","dan membawa","wayaḥmilu",289],["عَرْشَ","Arsy","ʿarsha",382],["رَبِّكَ","Tuhanmu","rabbika",10],["فَوْقَهُمْ","di atas mereka","fawqahum",291],["يَوْمَئِذٍۢ","pada hari ini","yawma-idhin",181],["ثَمَـٰنِيَةٌۭ","delapan","thamāniyatun",1675]],"t":"Dan para malaikat berada di berbagai penjuru langit. Pada hari itu delapan malaikat menjunjung Arasy (singgasana) Tuhanmu di atas (kepala) mereka."},{"n":18,"w":[["يَوْمَئِذٍۢ","pada hari itu","yawma-idhin",181],["تُعْرَضُونَ","kamu dihadapkan","tuʿ'raḍūna",773],["لَا","tidak","lā",4],["تَخْفَىٰ","tersembunyi","takhfā",1250],["مِنكُمْ","dari kamu","minkum",0],["خَافِيَةٌۭ","tersembunyi","khāfiyatun",4512]],"t":"Pada hari itu kamu dihadapkan (kepada Tuhanmu), tidak ada sesuatu pun dari kamu yang tersembunyi (bagi Allah)."},{"n":19,"w":[["فَأَمَّا","maka adapun","fa-ammā",219],["مَنْ","orang","man",12],["أُوتِىَ","diberikan","ūtiya",45],["كِتَـٰبَهُۥ","kitabnya","kitābahu",49],["بِيَمِينِهِۦ","di tangan kanannya","biyamīnihi",188],["فَيَقُولُ","maka ia berkata","fayaqūlu",6],["هَآؤُمُ","marilah/ambillah","hāumu",3503],["ٱقْرَءُوا۟","bacalah","iq'raū",605],["كِتَـٰبِيَهْ","kitab","kitābiyah",49]],"t":"Adapun orang yang kitabnya diberikan di tangan kanannya, maka dia berkata, \"Ambillah, bacalah kitabku (ini).\""},{"n":20,"w":[["إِنِّى","sesungguhnya aku","innī",5],["ظَنَنتُ","aku sangka/yakin","ẓanantu",254],["أَنِّى","bahwasanya aku","annī",30],["مُلَـٰقٍ","menemui","mulāqin",1380],["حِسَابِيَهْ","perhitungan","ḥisābiyah",309]],"t":"Sesungguhnya aku yakin, bahwa (suatu saat) aku akan menerima perhitungan terhadap diriku."},{"n":21,"w":[["فَهُوَ","dan dia/orang itu","fahuwa",19],["فِى","dalam","fī",3],["عِيشَةٍۢ","kehidupan","ʿīshatin",2243],["رَّاضِيَةٍۢ","yang diridhoi","rāḍiyatin",1644]],"t":"Maka orang itu berada dalam kehidupan yang diridai,"},{"n":22,"w":[["فِى","di dalam","fī",3],["جَنَّةٍ","surga","jannatin",78],["عَالِيَةٍۢ","yang tinggi","ʿāliyatin",1148]],"t":"dalam surga yang tinggi,"},{"n":23,"w":[["قُطُوفُهَا","buah-buahannya","quṭūfuhā",2593],["دَانِيَةٌۭ","dekat","dāniyatun",1834]],"t":"buah-buahannya dekat,"},{"n":24,"w":[["كُلُوا۟","makanlah","kulū",118],["وَٱشْرَبُوا۟","dan minumlah","wa-ish'rabū",616],["هَنِيٓـًٔۢا","dengan senang/penuh kepuasan","hanīan",1568],["بِمَآ","dengan apa/disebabkan","bimā",2],["أَسْلَفْتُمْ","kamu lalui/sediakan","aslaftum",2176],["فِى","pada","fī",3],["ٱلْأَيَّامِ","hari-hari","l-ayāmi",25],["ٱلْخَالِيَةِ","telah lalu","l-khāliyati",4514]],"t":"(kepada mereka dikatakan), \"Makan dan minumlah dengan nikmat karena amal yang telah kamu kerjakan pada hari-hari yang telah lalu.\""},{"n":25,"w":[["وَأَمَّا","dan adapun","wa-ammā",219],["مَنْ","orang yang","man",12],["أُوتِىَ","diberikan","ūtiya",45],["كِتَـٰبَهُۥ","kitabnya","kitābahu",49],["بِشِمَالِهِۦ","di tangan kirinya","bishimālihi",814],["فَيَقُولُ","maka dia berkata","fayaqūlu",6],["يَـٰلَيْتَنِى","Alangkah baiknya","yālaytanī",669],["لَمْ","tidak","lam",32],["أُوتَ","diberikan aku","ūta",45],["كِتَـٰبِيَهْ","kitab","kitābiyah",49]],"t":"Dan adapun orang yang kitabnya diberikan di tangan kirinya, maka dia berkata, \"Alangkah baiknya jika kitabku (ini) tidak diberikan kepadaku."},{"n":26,"w":[["وَلَمْ","dan tidak","walam",32],["أَدْرِ","aku mengetahui","adri",734],["مَا","apa","mā",2],["حِسَابِيَهْ","perhitungan","ḥisābiyah",309]],"t":"Sehingga aku tidak mengetahui bagaimana perhitunganku,"},{"n":27,"w":[["يَـٰلَيْتَهَا","seandainya itu (kematian)","yālaytahā",669],["كَانَتِ","adalah ia","kānati",8],["ٱلْقَاضِيَةَ","putusan/penyelesaian","l-qāḍiyata",4085]],"t":"Wahai, kiranya (kematian) itulah yang menyudahi segala sesuatu."},{"n":28,"w":[["مَآ","tidak","mā",2],["أَغْنَىٰ","memberi manfaat","aghnā",275],["عَنِّى","dariku/kepadaku","ʿannī",21],["مَالِيَهْ ۜ","harta","māliyah",132]],"t":"Hartaku sama sekali tidak berguna bagiku."},{"n":29,"w":[["هَلَكَ","telah binasa/lenyap","halaka",1350],["عَنِّى","daripadaku","ʿannī",21],["سُلْطَـٰنِيَهْ","kekuasaanku","sul'ṭāniyah",328]],"t":"Kekuasaanku telah hilang dariku.\""},{"n":30,"w":[["خُذُوهُ","peganglah ia/tangkaplah ia","khudhūhu",95],["فَغُلُّوهُ","lalu belenggulah ia","faghullūhu",1346]],"t":"(Allah berfirman), \"Tangkaplah dia lalu belenggulah tangannya ke lehernya.\""},{"n":31,"w":[["ثُمَّ","kemudian","thumma",34],["ٱلْجَحِيمَ","neraka jahim","l-jaḥīma",416],["صَلُّوهُ","masukkanlah ia","ṣallūhu",3253]],"t":"Kemudian masukkanlah dia ke dalam api neraka yang menyala-nyala."},{"n":32,"w":[["ثُمَّ","kemudian","thumma",34],["فِى","pada","fī",3],["سِلْسِلَةٍۢ","rantai","sil'silatin",2015],["ذَرْعُهَا","hastanya/panjangnya","dharʿuhā",1714],["سَبْعُونَ","tujuh puluh","sabʿūna",461],["ذِرَاعًۭا","hasta","dhirāʿan",2115],["فَٱسْلُكُوهُ","maka masukkan/belitkan","fa-us'lukūhu",749]],"t":"Kemudian belitlah dia dengan rantai yang panjangnya tujuh puluh hasta."},{"n":33,"w":[["إِنَّهُۥ","sesungguhnya","innahu",5],["كَانَ","adalah ia","kāna",8],["لَا","tidak","lā",4],["يُؤْمِنُ","beriman","yu'minu",18],["بِٱللَّهِ","kepada Allah","bil-lahi",1],["ٱلْعَظِيمِ","Maha Besar","l-ʿaẓīmi",101]],"t":"Sesungguhnya dialah orang yang tidak beriman kepada Allah Yang Mahabesar."},{"n":34,"w":[["وَلَا","dan tidak","walā",4],["يَحُضُّ","ia menganjurkan","yaḥuḍḍu",2258],["عَلَىٰ","untuk","ʿalā",7],["طَعَامِ","memberi makan","ṭaʿāmi",442],["ٱلْمِسْكِينِ","orang-orang miskin","l-mis'kīni",458]],"t":"Dan juga dia tidak mendorong (orang lain) untuk memberi makan orang miskin."},{"n":35,"w":[["فَلَيْسَ","maka tidak","falaysa",124],["لَهُ","baginya","lahu",16],["ٱلْيَوْمَ","hari ini","l-yawma",25],["هَـٰهُنَا","di sini","hāhunā",1569],["حَمِيمٌۭ","seorang teman","ḥamīmun",509]],"t":"Maka pada hari ini di sini tidak ada seorang teman pun baginya."},{"n":36,"w":[["وَلَا","dan tidak ada","walā",4],["طَعَامٌ","makanan","ṭaʿāmun",442],["إِلَّا","kecuali","illā",15],["مِنْ","dari","min",0],["غِسْلِينٍۢ","kotoran/nanah dan darah","ghis'līnin",3497]],"t":"Dan tidak ada makanan (baginya) kecuali dari darah dan nanah."},{"n":37,"w":[["لَّا","tidak ada","lā",4],["يَأْكُلُهُۥٓ","yang memakannya","yakuluhu",118],["إِلَّا","kecuali","illā",15],["ٱلْخَـٰطِـُٔونَ","orang-orang yang bersalah/berdosa","l-khāṭiūna",1435]],"t":"Tidak ada yang memakannya kecuali orang-orang yang berdosa."},{"n":38,"w":[["فَلَآ","maka","falā",4],["أُقْسِمُ","Aku bersumpah","uq'simu",506],["بِمَا","dengan apa","bimā",2],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",380]],"t":"Maka Aku bersumpah demi apa yang kamu lihat,"},{"n":39,"w":[["وَمَا","dan apa yang","wamā",2],["لَا","tidak","lā",4],["تُبْصِرُونَ","kamu lihat","tub'ṣirūna",380]],"t":"dan demi apa yang tidak kamu lihat."},{"n":40,"w":[["إِنَّهُۥ","sesungguhnya ia (Al Qur'an)","innahu",5],["لَقَوْلُ","benar-benar perkataan","laqawlu",120],["رَسُولٍۢ","rasul","rasūlin",35],["كَرِيمٍۢ","yang mulia","karīmin",373]],"t":"Sesungguhnya ia (Alquran) benar-benar wahyu (yang diturunkan kepada) Rasul yang mulia,"},{"n":41,"w":[["وَمَا","dan tidaklah","wamā",2],["هُوَ","ia (Al Qur'an)","huwa",19],["بِقَوْلِ","dengan perkataan","biqawli",120],["شَاعِرٍۢ ۚ","seorang penyair","shāʿirin",1262],["قَلِيلًۭا","sedikit","qalīlan",176],["مَّا","tidak","mā",2],["تُؤْمِنُونَ","kamu beriman","tu'minūna",18]],"t":"dan ia (Alquran) bukanlah perkataan seorang penyair. Sedikit sekali kamu yang beriman kepadanya."},{"n":42,"w":[["وَلَا","dan tidak","walā",4],["بِقَوْلِ","perkataan","biqawli",120],["كَاهِنٍۢ ۚ","dukun/tukang tenung","kāhinin",2414],["قَلِيلًۭا","sedikit","qalīlan",176],["مَّا","tidak","mā",2],["تَذَكَّرُونَ","kamu ingat mengambil pelajaran","tadhakkarūna",235]],"t":"Dan bukan pula perkataan tukang tenung. Sedikit sekali kamu yang mengambil pelajaran darinya."},{"n":43,"w":[["تَنزِيلٌۭ","diturunkan","tanzīlun",641],["مِّن","dari","min",0],["رَّبِّ","Tuhan","rabbi",10],["ٱلْعَـٰلَمِينَ","semesta alam","l-ʿālamīna",164]],"t":"Ia (Alquran) adalah wahyu yang diturunkan dari Tuhan seluruh alam."},{"n":44,"w":[["وَلَوْ","dan seandaiannya","walaw",58],["تَقَوَّلَ","dia mengadakan perkataan","taqawwala",2689],["عَلَيْنَا","atas Kami","ʿalaynā",7],["بَعْضَ","sebagian","baʿḍa",72],["ٱلْأَقَاوِيلِ","perkataan","l-aqāwīli",120]],"t":"Dan sekiranya dia (Muhammad) mengada-adakan sebagian perkataan atas (nama) Kami,"},{"n":45,"w":[["لَأَخَذْنَا","niscaya Kami ambil","la-akhadhnā",95],["مِنْهُ","darinya","min'hu",0],["بِٱلْيَمِينِ","dengan tangan kanan","bil-yamīni",188]],"t":"pasti Kami pegang dia pada tangan kanannya."},{"n":46,"w":[["ثُمَّ","kemudian","thumma",34],["لَقَطَعْنَا","pasti Kami potong","laqaṭaʿnā",746],["مِنْهُ","daripadanya","min'hu",0],["ٱلْوَتِينَ","urat jantung","l-watīna",4495]],"t":"Kemudian Kami potong pembuluh jantungnya."},{"n":47,"w":[["فَمَا","maka tidak","famā",2],["مِنكُم","dari kamu","minkum",0],["مِّنْ","dari","min",0],["أَحَدٍ","seorang","aḥadin",160],["عَنْهُ","daripadanya","ʿanhu",21],["حَـٰجِزِينَ","orang-orang yang menahan/menghalangi","ḥājizīna",2254]],"t":"Maka tidak seorang pun dari kamu yang dapat menghalangi (Kami untuk menghukumnya)."},{"n":48,"w":[["وَإِنَّهُۥ","dan sesungguhnya","wa-innahu",5],["لَتَذْكِرَةٌۭ","benar-benar peringatan","latadhkiratun",936],["لِّلْمُتَّقِينَ","bagi orang-orang yang bertakwa","lil'muttaqīna",247]],"t":"Dan sungguh, Alquran itu pelajaran bagi orang-orang yang bertakwa."},{"n":49,"w":[["وَإِنَّا","dan sesungguhnya Kami","wa-innā",5],["لَنَعْلَمُ","benar-benar Kami mengetahui","lanaʿlamu",29],["أَنَّ","bahwa","anna",30],["مِنكُم","diantara kamu","minkum",0],["مُّكَذِّبِينَ","orang-orang yang mendustakan","mukadhibīna",495]],"t":"Dan sungguh, Kami mengetahui bahwa di antara kamu ada orang yang mendustakan."},{"n":50,"w":[["وَإِنَّهُۥ","dan sesungguhnya ia (Al Qur'an)","wa-innahu",5],["لَحَسْرَةٌ","benar-benar penyesalan","laḥasratun",965],["عَلَى","atas","ʿalā",7],["ٱلْكَـٰفِرِينَ","orang-orang kafir","l-kāfirīna",71]],"t":"Dan sungguh, Alquran itu akan menimbulkan penyesalan bagi orang-orang kafir (di akhirat)."},{"n":51,"w":[["وَإِنَّهُۥ","dan sesungguhnya (Al Qur'an)","wa-innahu",5],["لَحَقُّ","nyata-nyata kebenaran","laḥaqqu",50],["ٱلْيَقِينِ","yang diyakini","l-yaqīni",1018]],"t":"Dan sungguh, Alquran itu kebenaran yang meyakinkan."},{"n":52,"w":[["فَسَبِّحْ","maka bertasbihlah","fasabbiḥ",283],["بِٱسْمِ","dengan nama","bi-is'mi",314],["رَبِّكَ","Tuhanmu","rabbika",10],["ٱلْعَظِيمِ","Maha Besar/Agung","l-ʿaẓīmi",101]],"t":"Maka bertasbihlah dengan (menyebut) nama Tuhanmu Yang Mahaagung."}]