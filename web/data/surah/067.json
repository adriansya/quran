[{"n":1,"w":[["تَبَـٰرَكَ","Maha Suci","tabāraka",937],["ٱلَّذِى","yang","alladhī",38],["بِيَدِهِ","di tangan-Nya","biyadihi",102],["ٱلْمُلْكُ","kerajaan","l-mul'ku",252],["وَهُوَ","dan Dia","wahuwa",19],["عَلَىٰ","atas","ʿalā",7],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌ","Maha Kuasa","qadīrun",265]],"t":"Mahasuci Allah yang menguasai (segala) kerajaan, Dan Dia Mahakuasa atas segala sesuatu."},{"n":2,"w":[["ٱلَّذِى","yang","alladhī",38],["خَلَقَ","menciptakan","khalaqa",62],["ٱلْمَوْتَ","kematian","l-mawta",239],["وَٱلْحَيَوٰةَ","dan kehidupan","wal-ḥayata",154],["لِيَبْلُوَكُمْ","karena Dia akan mengujimu","liyabluwakum",514],["أَيُّكُمْ","siapa diantara kamu","ayyukum",200],["أَحْسَنُ","lebih baik","aḥsanu",330],["عَمَلًۭا ۚ","perbuatan","ʿamalan",174],["وَهُوَ","dan Dia","wahuwa",19],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",114],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",122]],"t":"Yang menciptakan mati dan hidup, untuk menguji kamu, siapa di antara kamu yang lebih baik amalnya. Dan Dia Mahaperkasa, Maha Pengampun."},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",38],["خَلَقَ","menciptakan","khalaqa",62],["سَبْعَ","tujuh","sabʿa",461],["سَمَـٰوَٰتٍۢ","langit","samāwātin",37],["طِبَاقًۭا ۖ","berlapis-lapis","ṭibāqan",1536],["مَّا","tidak","mā",2],["تَرَىٰ","kamu lihat","tarā",46],["فِى","dalam/pada","fī",3],["خَلْقِ","penciptaan","khalqi",231],["ٱلرَّحْمَـٰنِ","Yang Maha Pengasih","l-raḥmāni",214],["مِن","dari","min",0],["تَفَـٰوُتٍۢ ۖ","tidak seimbang","tafāwutin",4344],["فَٱرْجِعِ","maka kembalilah","fa-ir'jiʿi",147],["ٱلْبَصَرَ","pandangan","l-baṣara",250],["هَلْ","apakah","hal",119],["تَرَىٰ","kamu melihat","tarā",46],["مِن","dari","min",0],["فُطُورٍۢ","teratur/seimbang","fuṭūrin",3461]],"t":"Yang menciptakan tujuh langit berlapis-lapis. Tidak akan kamu lihat sesuatu yang tidak seimbang pada ciptaan Tuhan Yang Maha Pengasih. Maka lihatlah sekali lagi, adakah kamu lihat sesuatu yang cacat?"},{"n":4,"w":[["ثُمَّ","kemudian","thumma",34],["ٱرْجِعِ","kembalilah","ir'jiʿi",147],["ٱلْبَصَرَ","pandangan","l-baṣara",250],["كَرَّتَيْنِ","dua kali ulang","karratayni",1195],["يَنقَلِبْ","berbalik/kembali","yanqalib",588],["إِلَيْكَ","kepadamu","ilayka",13],["ٱلْبَصَرُ","pandangan","l-baṣaru",250],["خَاسِئًۭا","membingungkan","khāsi-an",2057],["وَهُوَ","dan ia","wahuwa",19],["حَسِيرٌۭ","lemah","ḥasīrun",3189]],"t":"Kemudian ulangi pandangan(mu) sekali lagi (dan) sekali lagi, niscaya pandanganmu akan kembali kepadamu tanpa menemukan cacat dan ia (pandanganmu) dalam keadaan letih."},{"n":5,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["زَيَّنَّا","Kami menghiasi","zayyannā",422],["ٱلسَّمَآءَ","langit","l-samāa",37],["ٱلدُّنْيَا","dunia/yang dekat","l-dun'yā",105],["بِمَصَـٰبِيحَ","dengan bintang-bintang","bimaṣābīḥa",1599],["وَجَعَلْنَـٰهَا","dan Kami menjadikannya","wajaʿalnāhā",33],["رُجُومًۭا","pelempar","rujūman",4198],["لِّلشَّيَـٰطِينِ ۖ","terhadap syaitan-syaitan","lilshayāṭīni",125],["وَأَعْتَدْنَا","dan Kami sediakan","wa-aʿtadnā",648],["لَهُمْ","bagi mereka","lahum",11],["عَذَابَ","azab/siksa","ʿadhāba",36],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",608]],"t":"Dan sungguh, telah Kami hiasi langit yang dekat, dengan bintang-bintang dan Kami jadikannya (bintang-bintang itu) sebagai alat-alat pelempar setan, dan Kami sediakan bagi mereka azab neraka yang menyala-nyala."},{"n":6,"w":[["وَلِلَّذِينَ","dan bagi orang-orang yang","walilladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِرَبِّهِمْ","kepada Tuhan mereka","birabbihim",10],["عَذَابُ","azab/siksa","ʿadhābu",36],["جَهَنَّمَ ۖ","neraka jahannam","jahannama",152],["وَبِئْسَ","dan amat buruk","wabi'sa",297],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",394]],"t":"Dan orang-orang yang ingkar kepada Tuhannya, akan mendapat azab Jahanam. Dan itulah seburuk-buruk tempat kembali."},{"n":7,"w":[["إِذَآ","apabila","idhā",23],["أُلْقُوا۟","mereka dilemparkan","ul'qū",173],["فِيهَا","di dalamnya","fīhā",3],["سَمِعُوا۟","mereka mendengar","samiʿū",149],["لَهَا","baginya","lahā",98],["شَهِيقًۭا","jeritan","shahīqan",2101],["وَهِىَ","dan ia","wahiya",193],["تَفُورُ","mendidih","tafūru",1838]],"t":"Apabila mereka dilemparkan ke dalamnya mereka mendengar suara neraka yang mengerikan, sedang neraka itu membara,"},{"n":8,"w":[["تَكَادُ","hampir-hampir","takādu",358],["تَمَيَّزُ","terpecah belah","tamayyazu",4375],["مِنَ","dari","mina",0],["ٱلْغَيْظِ ۖ","lantaran marah","l-ghayẓi",1188],["كُلَّمَآ","setiap kali","kullamā",632],["أُلْقِىَ","dilempar","ul'qiya",173],["فِيهَا","di dalamnya","fīhā",3],["فَوْجٌۭ","sekumpulan","fawjun",1342],["سَأَلَهُمْ","bertanya kepada mereka","sa-alahum",109],["خَزَنَتُهَآ","penjaga-penjaganya","khazanatuhā",1432],["أَلَمْ","apakah tidak","alam",32],["يَأْتِكُمْ","datang kepadamu","yatikum",48],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206]],"t":"hampir meledak karena marah. Setiap kali ada sekumpulan (orang-orang kafir) dilemparkan ke dalamnya, penjaga-penjaga (neraka itu) bertanya kepada mereka, \"Apakah belum pernah ada orang yang datang memberi peringatan kepadamu (di dunia)?\""},{"n":9,"w":[["قَالُوا۟","mereka berkata/menjawab","qālū",6],["بَلَىٰ","ya benar","balā",466],["قَدْ","sesungguhnya","qad",24],["جَآءَنَا","telah datang kepada kami","jāanā",43],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206],["فَكَذَّبْنَا","maka kami mendustakan","fakadhabnā",64],["وَقُلْنَا","dan kami katakan","waqul'nā",6],["مَا","tidak","mā",2],["نَزَّلَ","menurunkan","nazzala",197],["ٱللَّهُ","Allah","l-lahu",1],["مِن","dari","min",0],["شَىْءٍ","sesuatu","shayin",41],["إِنْ","tidaklah","in",14],["أَنتُمْ","kamu","antum",88],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",315],["كَبِيرٍۢ","besar","kabīrin",292]],"t":"Mereka menjawab, \"Benar, sungguh, seorang pemberi peringatan telah datang kepada kami, tetapi kami mendustakan(nya) dan kami katakan, \"Allah tidak menurunkan sesuatu apa pun, kamu sebenarnya di dalam kesesatan yang besar.\""},{"n":10,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["لَوْ","sekiranya","law",58],["كُنَّا","adalah kami","kunnā",8],["نَسْمَعُ","kami mendengarkan","nasmaʿu",149],["أَوْ","atau","aw",42],["نَعْقِلُ","kami berakal","naʿqilu",243],["مَا","tidaklah","mā",2],["كُنَّا","kami","kunnā",8],["فِىٓ","dalam","fī",3],["أَصْحَـٰبِ","penghuni","aṣḥābi",123],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",608]],"t":"Dan mereka berkata, \"Sekiranya (dahulu) kami mendengarkan atau memikirkan (peringatan itu) tentulah kami tidak termasuk penghuni neraka yang menyala-nyala.\""},{"n":11,"w":[["فَٱعْتَرَفُوا۟","maka mereka mengakui","fa-iʿ'tarafū",2077],["بِذَنۢبِهِمْ","dengan/akan dosa mereka","bidhanbihim",319],["فَسُحْقًۭا","maka kebinasaanlah","fasuḥ'qan",4283],["لِّأَصْحَـٰبِ","bagi penghuni","li-aṣḥābi",123],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",608]],"t":"Maka mereka mengakui dosanya. Tetapi jauhlah (dari rahmat Allah) bagi penghuni neraka yang menyala-nyala itu."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["يَخْشَوْنَ","mereka takut","yakhshawna",302],["رَبَّهُم","Tuhan mereka","rabbahum",10],["بِٱلْغَيْبِ","dengan gaib/tidak kelihatan","bil-ghaybi",244],["لَهُم","bagi mereka","lahum",11],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",396],["وَأَجْرٌۭ","dan pahala","wa-ajrun",111],["كَبِيرٌۭ","besar","kabīrun",292]],"t":"Sesungguhnya orang-orang yang takut kepada Tuhannya yang tidak terlihat oleh mereka, mereka memperoleh ampunan dan pahala yang besar."},{"n":13,"w":[["وَأَسِرُّوا۟","dan rahasiakanlah","wa-asirrū",544],["قَوْلَكُمْ","perkataanmu","qawlakum",120],["أَوِ","atau","awi",42],["ٱجْهَرُوا۟","keraskanlah","ij'harū",1353],["بِهِۦٓ ۖ","dengannya","bihi",16],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِيمٌۢ","Maha mengetahui","ʿalīmun",69],["بِذَاتِ","dengan yang ada","bidhāti",117],["ٱلصُّدُورِ","dada","l-ṣudūri",271]],"t":"Dan rahasiakanlah perkataanmu atau nyatakanlah. Sungguh, Dia Maha Mengetahui segala isi hati."},{"n":14,"w":[["أَلَا","apakah tidak/tidakkah","alā",4],["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["مَنْ","siapa/apa","man",12],["خَلَقَ","Dia ciptakan","khalaqa",62],["وَهُوَ","dan Dia","wahuwa",19],["ٱللَّطِيفُ","Maha Halus","l-laṭīfu",1085],["ٱلْخَبِيرُ","Maha mengetahui","l-khabīru",267]],"t":"Apakah (pantas) Allah yang menciptakan itu tidak mengetahui? Dan Dia Mahahalus, Maha Mengetahui."},{"n":15,"w":[["هُوَ","dan Dia","huwa",19],["ٱلَّذِى","yang","alladhī",38],["جَعَلَ","menjadikan","jaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلْأَرْضَ","bumi","l-arḍa",22],["ذَلُولًۭا","mudah dipergunakan","dhalūlan",2111],["فَٱمْشُوا۟","maka berjalanlah kamu","fa-im'shū",492],["فِى","di/pada","fī",3],["مَنَاكِبِهَا","segala penjuru","manākibihā",3722],["وَكُلُوا۟","dan makanlah","wakulū",118],["مِن","dari","min",0],["رِّزْقِهِۦ ۖ","sebagian rizki-Nya","riz'qihi",221],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["ٱلنُّشُورُ","dibangkitkan kembali","l-nushūru",1397]],"t":"Dialah yang menjadikan bumi untuk kamu yang mudah dijelajahi, maka jelajahilah di segala penjurunya dan makanlah sebagian dari rezeki-Nya. Dan hanya kepada-Nyalah kamu (kembali setelah) dibangkitkan."},{"n":16,"w":[["ءَأَمِنتُم","apakah kamu merasa aman","a-amintum",504],["مَّن","siapa (Allah)","man",12],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",37],["أَن","bahwa","an",17],["يَخْسِفَ","Dia akan membenamkan","yakhsifa",1014],["بِكُمُ","dengan/untuk kalian","bikumu",26],["ٱلْأَرْضَ","bumi","l-arḍa",22],["فَإِذَا","maka tiba-tiba","fa-idhā",647],["هِىَ","ia/bumi","hiya",193],["تَمُورُ","bergoncang","tamūru",1899]],"t":"Sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan membuat kamu ditelan bumi ketika tiba-tiba ia terguncang?"},{"n":17,"w":[["أَمْ","atau","am",85],["أَمِنتُم","kamu merasa aman","amintum",504],["مَّن","siapa (Allah)","man",12],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",37],["أَن","bahwa","an",17],["يُرْسِلَ","Dia akan mengirimkan","yur'sila",92],["عَلَيْكُمْ","atas kalian","ʿalaykum",7],["حَاصِبًۭا ۖ","angin yang mengandung batu","ḥāṣiban",1515],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahui","fasataʿlamūna",29],["كَيْفَ","bagaimana","kayfa",139],["نَذِيرِ","peringatan-Ku","nadhīri",206]],"t":"atau sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan mengirimkan badai yang berbatu kepadamu? Namun kelak kamu akan mengetahui bagaimana (akibat mendustakan) peringatan-Ku."},{"n":18,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["كَذَّبَ","telah mendustakan","kadhaba",64],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["فَكَيْفَ","maka bagaimana","fakayfa",139],["كَانَ","adalah ia","kāna",8],["نَكِيرِ","celaan-Ku/kemurkaan-Ku","nakīri",1395]],"t":"Dan sungguh, orang-orang yang sebelum mereka pun telah mendustakan (rasul-rasul-Nya). Maka betapa hebatnya kemurkaan-Ku!"},{"n":19,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["إِلَى","kepada","ilā",13],["ٱلطَّيْرِ","burung","l-ṭayri",529],["فَوْقَهُمْ","di atas mereka","fawqahum",291],["صَـٰٓفَّـٰتٍۢ","mengembangkan sayap","ṣāffātin",1311],["وَيَقْبِضْنَ ۚ","dan ia mengatupkannya","wayaqbiḍ'na",1401],["مَا","tidak ada","mā",2],["يُمْسِكُهُنَّ","yang menahan mereka","yum'sikuhunna",543],["إِلَّا","kecuali","illā",15],["ٱلرَّحْمَـٰنُ ۚ","Maha Pengasih","l-raḥmānu",214],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍۭ","sesuatu","shayin",41],["بَصِيرٌ","Maha melihat","baṣīrun",234]],"t":"Tidakkah mereka memperhatikan burung-burung yang mengembangkan dan mengatupkan sayapnya di atas mereka? Tidak ada yang menahannya (di udara) selain Yang Maha Pengasih. Sungguh, Dia Maha Melihat segala sesuatu."},{"n":20,"w":[["أَمَّنْ","atau siapakah","amman",85],["هَـٰذَا","ini","hādhā",56],["ٱلَّذِى","yang","alladhī",38],["هُوَ","dia","huwa",19],["جُندٌۭ","bala tentara","jundun",384],["لَّكُمْ","bagi kalian","lakum",26],["يَنصُرُكُم","dia menolongmu","yanṣurukum",202],["مِّن","dari","min",0],["دُونِ","selain","dūni",80],["ٱلرَّحْمَـٰنِ ۚ","Maha Pengasih","l-raḥmāni",214],["إِنِ","tidaklah","ini",14],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",71],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["غُرُورٍ","keadaan tertipu","ghurūrin",910]],"t":"Atau siapakah yang akan menjadi bala tentara bagimu yang dapat membelamu selain (Allah) Yang Maha Pengasih? Orang-orang kafir itu hanyalah dalam (keadaan) tertipu."},{"n":21,"w":[["أَمَّنْ","atau siapakah","amman",85],["هَـٰذَا","ini","hādhā",56],["ٱلَّذِى","yang","alladhī",38],["يَرْزُقُكُمْ","memberi rezeki kamu","yarzuqukum",198],["إِنْ","jika","in",14],["أَمْسَكَ","Dia menahan","amsaka",543],["رِزْقَهُۥ ۚ","rezekinya","riz'qahu",221],["بَل","bahkan/tetapi","bal",97],["لَّجُّوا۟","mereka terus-menerus","lajjū",2437],["فِى","dalam","fī",3],["عُتُوٍّۢ","kesombongan","ʿutuwwin",2250],["وَنُفُورٍ","dan lari/berpaling","wanufūrin",1398]],"t":"Atau siapakah yang dapat memberimu rezeki jika Dia menahan rezeki-Nya? Bahkan mereka terus-menerus dalam kesombongan dan menjauhkan diri (dari kebenaran)."},{"n":22,"w":[["أَفَمَن","maka apakah orang","afaman",12],["يَمْشِى","dia berjalan","yamshī",492],["مُكِبًّا","tiarap/telengkup","mukibban",3830],["عَلَىٰ","di atas","ʿalā",7],["وَجْهِهِۦٓ","mukanya","wajhihi",170],["أَهْدَىٰٓ","lebih mendapat petunjuk","ahdā",1037],["أَمَّن","ataukah orang","amman",85],["يَمْشِى","dia berjalan","yamshī",492],["سَوِيًّا","sama lurus","sawiyyan",1412],["عَلَىٰ","di atas","ʿalā",7],["صِرَٰطٍۢ","jalan","ṣirāṭin",264],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",326]],"t":"Apakah orang yang merangkak dengan wajah tertelungkup yang lebih terpimpin (dalam kebenaran) ataukah orang yang berjalan tegap di atas jalan yang lurus?"},{"n":23,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",19],["ٱلَّذِىٓ","yang","alladhī",38],["أَنشَأَكُمْ","menumbuhkan/menciptakan kamu","ansha-akum",505],["وَجَعَلَ","dan menjadikan","wajaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلسَّمْعَ","pendengaran","l-samʿa",479],["وَٱلْأَبْصَـٰرَ","dan penglihatan","wal-abṣāra",250],["وَٱلْأَفْـِٔدَةَ ۖ","dan hati","wal-afidata",598],["قَلِيلًۭا","sedikit","qalīlan",176],["مَّا","apa","mā",2],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",257]],"t":"Katakanlah, \"Dialah yang menciptakan kamu dan menjadikan pendengaran, penglihatan dan hati nurani bagi kamu. (Tetapi) sedikit sekali kamu bersyukur."},{"n":24,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",19],["ٱلَّذِى","yang","alladhī",38],["ذَرَأَكُمْ","menjadikan kamu berkembang biak","dhara-akum",1129],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["تُحْشَرُونَ","kamu akan dikumpulkan","tuḥ'sharūna",320]],"t":"Katakanlah, \"Dialah yang menjadikan kamu berkembang biak di muka bumi, dan hanya kepada-Nya kamu akan dikumpulkan.\""},{"n":25,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["مَتَىٰ","kapan","matā",918],["هَـٰذَا","ini","hādhā",56],["ٱلْوَعْدُ","janji/ancaman","l-waʿdu",248],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",8],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",201]],"t":"Dan mereka berkata, \"Kapan (datangnya) ancaman itu jika kamu orang yang benar?\""},{"n":26,"w":[["قُلْ","katakanlah","qul",6],["إِنَّمَا","sesungguhnya","innamā",5],["ٱلْعِلْمُ","pengetahuan","l-ʿil'mu",112],["عِندَ","di sisi","ʿinda",60],["ٱللَّهِ","Allah","l-lahi",1],["وَإِنَّمَآ","dan sesungguhnya","wa-innamā",5],["أَنَا۠","Aku","anā",184],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",206],["مُّبِينٌۭ","yang nyata","mubīnun",103]],"t":"Katakanlah (Muhammad), \"Sesungguhnya ilmu (tentang hari Kiamat itu) hanya ada pada Allah. Dan aku hanyalah seorang pemberi peringatan yang menjelaskan.\""},{"n":27,"w":[["فَلَمَّا","maka ketika","falammā",73],["رَأَوْهُ","mereka melihatnya (azab)","ra-awhu",46],["زُلْفَةًۭ","dekat","zul'fatan",2781],["سِيٓـَٔتْ","menjadi buruk/jelek","sīat",377],["وُجُوهُ","muka-muka","wujūhu",170],["ٱلَّذِينَ","orang-orang yang","alladhīna",9],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَقِيلَ","dan dikatakan","waqīla",6],["هَـٰذَا","ini","hādhā",56],["ٱلَّذِى","yang","alladhī",38],["كُنتُم","kalian adalah","kuntum",8],["بِهِۦ","dengannya","bihi",16],["تَدَّعُونَ","kamu meminta","taddaʿūna",2082]],"t":"Maka ketika mereka melihat azab (pada hari Kiamat) sudah dekat, wajah orang-orang kafir itu menjadi muram. Dan dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu memintanya.\""},{"n":28,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",46],["إِنْ","jika","in",14],["أَهْلَكَنِىَ","membinasakan aku","ahlakaniya",233],["ٱللَّهُ","Allah","l-lahu",1],["وَمَن","dan orang-orang yang","waman",12],["مَّعِىَ","bersamaku","maʿiya",70],["أَوْ","atau","aw",42],["رَحِمَنَا","Dia memberi rahmat kami","raḥimanā",397],["فَمَن","maka barang siapa","faman",12],["يُجِيرُ","menolong/melindungi","yujīru",1134],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",71],["مِنْ","dari","min",0],["عَذَابٍ","azab","ʿadhābin",36],["أَلِيمٍۢ","yang pedih","alīmin",168]],"t":"Katakanlah (Muhammad), \"Tahukah kamu jika Allah mematikan aku dan orang-orang yang bersamaku atau memberi rahmat kepada kami, (maka kami akan masuk surga), lalu siapa yang dapat melindungi orang-orang kafir dari azab yang pedih?\""},{"n":29,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",19],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",214],["ءَامَنَّا","kami beriman","āmannā",18],["بِهِۦ","kepada-Nya","bihi",16],["وَعَلَيْهِ","dan atas-Nya","waʿalayhi",7],["تَوَكَّلْنَا ۖ","kami bertawakal","tawakkalnā",299],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahuinya","fasataʿlamūna",29],["مَنْ","siapa","man",12],["هُوَ","dia","huwa",19],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",315],["مُّبِينٍۢ","nyata","mubīnin",103]],"t":"Katakanlah, \"Dialah Yang Maha Pengasih, kami beriman kepada-Nya dan kepada-Nya kami bertawakal. Maka kelak kamu akan tahu siapa yang berada dalam kesesatan yang nyata.\""},{"n":30,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",46],["إِنْ","jika","in",14],["أَصْبَحَ","menjadi","aṣbaḥa",388],["مَآؤُكُمْ","air kamu","māukum",194],["غَوْرًۭا","masuk dalam tanah kering","ghawran",2380],["فَمَن","maka siapa","faman",12],["يَأْتِيكُم","mendatangkan kepadamu","yatīkum",48],["بِمَآءٍۢ","dengan air","bimāin",194],["مَّعِينٍۭ","mata air/mengalir","maʿīnin",1611]],"t":"Katakanlah (Muhammad), \"Terangkanlah kepadaku jika sumber air kamu menjadi kering; maka siapa yang akan memberimu air yang mengalir?\""}]