[{"n":1,"w":[["تَبَـٰرَكَ","Maha Suci","tabāraka",949],["ٱلَّذِى","yang","alladhī",45],["بِيَدِهِ","di tangan-Nya","biyadihi",109],["ٱلْمُلْكُ","kerajaan","l-mul'ku",262],["وَهُوَ","dan Dia","wahuwa",25],["عَلَىٰ","atas","ʿalā",11],["كُلِّ","segala","kulli",38],["شَىْءٍۢ","sesuatu","shayin",49],["قَدِيرٌ","Maha Kuasa","qadīrun",275]],"t":"Mahasuci Allah yang menguasai (segala) kerajaan, Dan Dia Mahakuasa atas segala sesuatu."},{"n":2,"w":[["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","menciptakan","khalaqa",70],["ٱلْمَوْتَ","kematian","l-mawta",249],["وَٱلْحَيَوٰةَ","dan kehidupan","wal-ḥayata",164],["لِيَبْلُوَكُمْ","karena Dia akan mengujimu","liyabluwakum",522],["أَيُّكُمْ","siapa diantara kamu","ayyukum",210],["أَحْسَنُ","lebih baik","aḥsanu",340],["عَمَلًۭا ۚ","perbuatan","ʿamalan",184],["وَهُوَ","dan Dia","wahuwa",25],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",124],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",131]],"t":"Yang menciptakan mati dan hidup, untuk menguji kamu, siapa di antara kamu yang lebih baik amalnya. Dan Dia Mahaperkasa, Maha Pengampun."},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",45],["خَلَقَ","menciptakan","khalaqa",70],["سَبْعَ","tujuh","sabʿa",470],["سَمَـٰوَٰتٍۢ","langit","samāwātin",44],["طِبَاقًۭا ۖ","berlapis-lapis","ṭibāqan",1548],["مَّا","tidak","mā",6],["تَرَىٰ","kamu lihat","tarā",54],["فِى","dalam/pada","fī",7],["خَلْقِ","penciptaan","khalqi",241],["ٱلرَّحْمَـٰنِ","Yang Maha Pengasih","l-raḥmāni",224],["مِن","dari","min",1],["تَفَـٰوُتٍۢ ۖ","tidak seimbang","tafāwutin",4355],["فَٱرْجِعِ","maka kembalilah","fa-ir'jiʿi",156],["ٱلْبَصَرَ","pandangan","l-baṣara",260],["هَلْ","apakah","hal",128],["تَرَىٰ","kamu melihat","tarā",54],["مِن","dari","min",1],["فُطُورٍۢ","teratur/seimbang","fuṭūrin",3472]],"t":"Yang menciptakan tujuh langit berlapis-lapis. Tidak akan kamu lihat sesuatu yang tidak seimbang pada ciptaan Tuhan Yang Maha Pengasih. Maka lihatlah sekali lagi, adakah kamu lihat sesuatu yang cacat?"},{"n":4,"w":[["ثُمَّ","kemudian","thumma",41],["ٱرْجِعِ","kembalilah","ir'jiʿi",156],["ٱلْبَصَرَ","pandangan","l-baṣara",260],["كَرَّتَيْنِ","dua kali ulang","karratayni",1207],["يَنقَلِبْ","berbalik/kembali","yanqalib",597],["إِلَيْكَ","kepadamu","ilayka",18],["ٱلْبَصَرُ","pandangan","l-baṣaru",260],["خَاسِئًۭا","membingungkan","khāsi-an",2069],["وَهُوَ","dan ia","wahuwa",25],["حَسِيرٌۭ","lemah","ḥasīrun",3200]],"t":"Kemudian ulangi pandangan(mu) sekali lagi (dan) sekali lagi, niscaya pandanganmu akan kembali kepadamu tanpa menemukan cacat dan ia (pandanganmu) dalam keadaan letih."},{"n":5,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["زَيَّنَّا","Kami menghiasi","zayyannā",432],["ٱلسَّمَآءَ","langit","l-samāa",44],["ٱلدُّنْيَا","dunia/yang dekat","l-dun'yā",114],["بِمَصَـٰبِيحَ","dengan bintang-bintang","bimaṣābīḥa",1611],["وَجَعَلْنَـٰهَا","dan Kami menjadikannya","wajaʿalnāhā",40],["رُجُومًۭا","pelempar","rujūman",4209],["لِّلشَّيَـٰطِينِ ۖ","terhadap syaitan-syaitan","lilshayāṭīni",134],["وَأَعْتَدْنَا","dan Kami sediakan","wa-aʿtadnā",658],["لَهُمْ","bagi mereka","lahum",16],["عَذَابَ","azab/siksa","ʿadhāba",43],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",617]],"t":"Dan sungguh, telah Kami hiasi langit yang dekat, dengan bintang-bintang dan Kami jadikannya (bintang-bintang itu) sebagai alat-alat pelempar setan, dan Kami sediakan bagi mereka azab neraka yang menyala-nyala."},{"n":6,"w":[["وَلِلَّذِينَ","dan bagi orang-orang yang","walilladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["بِرَبِّهِمْ","kepada Tuhan mereka","birabbihim",15],["عَذَابُ","azab/siksa","ʿadhābu",43],["جَهَنَّمَ ۖ","neraka jahannam","jahannama",162],["وَبِئْسَ","dan amat buruk","wabi'sa",307],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",404]],"t":"Dan orang-orang yang ingkar kepada Tuhannya, akan mendapat azab Jahanam. Dan itulah seburuk-buruk tempat kembali."},{"n":7,"w":[["إِذَآ","apabila","idhā",29],["أُلْقُوا۟","mereka dilemparkan","ul'qū",183],["فِيهَا","di dalamnya","fīhā",7],["سَمِعُوا۟","mereka mendengar","samiʿū",159],["لَهَا","baginya","lahā",106],["شَهِيقًۭا","jeritan","shahīqan",2113],["وَهِىَ","dan ia","wahiya",203],["تَفُورُ","mendidih","tafūru",1850]],"t":"Apabila mereka dilemparkan ke dalamnya mereka mendengar suara neraka yang mengerikan, sedang neraka itu membara,"},{"n":8,"w":[["تَكَادُ","hampir-hampir","takādu",368],["تَمَيَّزُ","terpecah belah","tamayyazu",4386],["مِنَ","dari","mina",1],["ٱلْغَيْظِ ۖ","lantaran marah","l-ghayẓi",1200],["كُلَّمَآ","setiap kali","kullamā",642],["أُلْقِىَ","dilempar","ul'qiya",183],["فِيهَا","di dalamnya","fīhā",7],["فَوْجٌۭ","sekumpulan","fawjun",1354],["سَأَلَهُمْ","bertanya kepada mereka","sa-alahum",119],["خَزَنَتُهَآ","penjaga-penjaganya","khazanatuhā",1444],["أَلَمْ","apakah tidak","alam",39],["يَأْتِكُمْ","datang kepadamu","yatikum",56],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",216]],"t":"hampir meledak karena marah. Setiap kali ada sekumpulan (orang-orang kafir) dilemparkan ke dalamnya, penjaga-penjaga (neraka itu) bertanya kepada mereka, \"Apakah belum pernah ada orang yang datang memberi peringatan kepadamu (di dunia)?\""},{"n":9,"w":[["قَالُوا۟","mereka berkata/menjawab","qālū",10],["بَلَىٰ","ya benar","balā",475],["قَدْ","sesungguhnya","qad",30],["جَآءَنَا","telah datang kepada kami","jāanā",51],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",216],["فَكَذَّبْنَا","maka kami mendustakan","fakadhabnā",72],["وَقُلْنَا","dan kami katakan","waqul'nā",10],["مَا","tidak","mā",6],["نَزَّلَ","menurunkan","nazzala",207],["ٱللَّهُ","Allah","l-lahu",4],["مِن","dari","min",1],["شَىْءٍ","sesuatu","shayin",49],["إِنْ","tidaklah","in",19],["أَنتُمْ","kamu","antum",96],["إِلَّا","kecuali","illā",20],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["كَبِيرٍۢ","besar","kabīrin",302]],"t":"Mereka menjawab, \"Benar, sungguh, seorang pemberi peringatan telah datang kepada kami, tetapi kami mendustakan(nya) dan kami katakan, \"Allah tidak menurunkan sesuatu apa pun, kamu sebenarnya di dalam kesesatan yang besar.\""},{"n":10,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",10],["لَوْ","sekiranya","law",66],["كُنَّا","adalah kami","kunnā",12],["نَسْمَعُ","kami mendengarkan","nasmaʿu",159],["أَوْ","atau","aw",50],["نَعْقِلُ","kami berakal","naʿqilu",253],["مَا","tidaklah","mā",6],["كُنَّا","kami","kunnā",12],["فِىٓ","dalam","fī",7],["أَصْحَـٰبِ","penghuni","aṣḥābi",132],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",617]],"t":"Dan mereka berkata, \"Sekiranya (dahulu) kami mendengarkan atau memikirkan (peringatan itu) tentulah kami tidak termasuk penghuni neraka yang menyala-nyala.\""},{"n":11,"w":[["فَٱعْتَرَفُوا۟","maka mereka mengakui","fa-iʿ'tarafū",2089],["بِذَنۢبِهِمْ","dengan/akan dosa mereka","bidhanbihim",329],["فَسُحْقًۭا","maka kebinasaanlah","fasuḥ'qan",4294],["لِّأَصْحَـٰبِ","bagi penghuni","li-aṣḥābi",132],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",617]],"t":"Maka mereka mengakui dosanya. Tetapi jauhlah (dari rahmat Allah) bagi penghuni neraka yang menyala-nyala itu."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",9],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["يَخْشَوْنَ","mereka takut","yakhshawna",312],["رَبَّهُم","Tuhan mereka","rabbahum",15],["بِٱلْغَيْبِ","dengan gaib/tidak kelihatan","bil-ghaybi",254],["لَهُم","bagi mereka","lahum",16],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",406],["وَأَجْرٌۭ","dan pahala","wa-ajrun",121],["كَبِيرٌۭ","besar","kabīrun",302]],"t":"Sesungguhnya orang-orang yang takut kepada Tuhannya yang tidak terlihat oleh mereka, mereka memperoleh ampunan dan pahala yang besar."},{"n":13,"w":[["وَأَسِرُّوا۟","dan rahasiakanlah","wa-asirrū",553],["قَوْلَكُمْ","perkataanmu","qawlakum",129],["أَوِ","atau","awi",50],["ٱجْهَرُوا۟","keraskanlah","ij'harū",1365],["بِهِۦٓ ۖ","dengannya","bihi",21],["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["عَلِيمٌۢ","Maha mengetahui","ʿalīmun",77],["بِذَاتِ","dengan yang ada","bidhāti",112],["ٱلصُّدُورِ","dada","l-ṣudūri",281]],"t":"Dan rahasiakanlah perkataanmu atau nyatakanlah. Sungguh, Dia Maha Mengetahui segala isi hati."},{"n":14,"w":[["أَلَا","apakah tidak/tidakkah","alā",8],["يَعْلَمُ","Dia mengetahui","yaʿlamu",35],["مَنْ","siapa/apa","man",17],["خَلَقَ","Dia ciptakan","khalaqa",70],["وَهُوَ","dan Dia","wahuwa",25],["ٱللَّطِيفُ","Maha Halus","l-laṭīfu",1097],["ٱلْخَبِيرُ","Maha mengetahui","l-khabīru",277]],"t":"Apakah (pantas) Allah yang menciptakan itu tidak mengetahui? Dan Dia Mahahalus, Maha Mengetahui."},{"n":15,"w":[["هُوَ","dan Dia","huwa",25],["ٱلَّذِى","yang","alladhī",45],["جَعَلَ","menjadikan","jaʿala",40],["لَكُمُ","bagi kalian","lakumu",32],["ٱلْأَرْضَ","bumi","l-arḍa",28],["ذَلُولًۭا","mudah dipergunakan","dhalūlan",2123],["فَٱمْشُوا۟","maka berjalanlah kamu","fa-im'shū",500],["فِى","di/pada","fī",7],["مَنَاكِبِهَا","segala penjuru","manākibihā",3733],["وَكُلُوا۟","dan makanlah","wakulū",127],["مِن","dari","min",1],["رِّزْقِهِۦ ۖ","sebagian rizki-Nya","riz'qihi",231],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",18],["ٱلنُّشُورُ","dibangkitkan kembali","l-nushūru",1409]],"t":"Dialah yang menjadikan bumi untuk kamu yang mudah dijelajahi, maka jelajahilah di segala penjurunya dan makanlah sebagian dari rezeki-Nya. Dan hanya kepada-Nyalah kamu (kembali setelah) dibangkitkan."},{"n":16,"w":[["ءَأَمِنتُم","apakah kamu merasa aman","a-amintum",512],["مَّن","siapa (Allah)","man",17],["فِى","di","fī",7],["ٱلسَّمَآءِ","langit","l-samāi",44],["أَن","bahwa","an",22],["يَخْسِفَ","Dia akan membenamkan","yakhsifa",1026],["بِكُمُ","dengan/untuk kalian","bikumu",32],["ٱلْأَرْضَ","bumi","l-arḍa",28],["فَإِذَا","maka tiba-tiba","fa-idhā",657],["هِىَ","ia/bumi","hiya",203],["تَمُورُ","bergoncang","tamūru",1911]],"t":"Sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan membuat kamu ditelan bumi ketika tiba-tiba ia terguncang?"},{"n":17,"w":[["أَمْ","atau","am",93],["أَمِنتُم","kamu merasa aman","amintum",512],["مَّن","siapa (Allah)","man",17],["فِى","di","fī",7],["ٱلسَّمَآءِ","langit","l-samāi",44],["أَن","bahwa","an",22],["يُرْسِلَ","Dia akan mengirimkan","yur'sila",100],["عَلَيْكُمْ","atas kalian","ʿalaykum",11],["حَاصِبًۭا ۖ","angin yang mengandung batu","ḥāṣiban",1527],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahui","fasataʿlamūna",35],["كَيْفَ","bagaimana","kayfa",148],["نَذِيرِ","peringatan-Ku","nadhīri",216]],"t":"atau sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan mengirimkan badai yang berbatu kepadamu? Namun kelak kamu akan mengetahui bagaimana (akibat mendustakan) peringatan-Ku."},{"n":18,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",30],["كَذَّبَ","telah mendustakan","kadhaba",72],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["مِن","dari","min",1],["قَبْلِهِمْ","sebelum mereka","qablihim",59],["فَكَيْفَ","maka bagaimana","fakayfa",148],["كَانَ","adalah ia","kāna",12],["نَكِيرِ","celaan-Ku/kemurkaan-Ku","nakīri",1407]],"t":"Dan sungguh, orang-orang yang sebelum mereka pun telah mendustakan (rasul-rasul-Nya). Maka betapa hebatnya kemurkaan-Ku!"},{"n":19,"w":[["أَوَلَمْ","ataukah tidak","awalam",39],["يَرَوْا۟","mereka memperhatikan","yaraw",54],["إِلَى","kepada","ilā",18],["ٱلطَّيْرِ","burung","l-ṭayri",538],["فَوْقَهُمْ","di atas mereka","fawqahum",301],["صَـٰٓفَّـٰتٍۢ","mengembangkan sayap","ṣāffātin",1323],["وَيَقْبِضْنَ ۚ","dan ia mengatupkannya","wayaqbiḍ'na",1413],["مَا","tidak ada","mā",6],["يُمْسِكُهُنَّ","yang menahan mereka","yum'sikuhunna",552],["إِلَّا","kecuali","illā",20],["ٱلرَّحْمَـٰنُ ۚ","Maha Pengasih","l-raḥmānu",224],["إِنَّهُۥ","sesungguhnya Dia","innahu",9],["بِكُلِّ","dengan segala","bikulli",38],["شَىْءٍۭ","sesuatu","shayin",49],["بَصِيرٌ","Maha melihat","baṣīrun",244]],"t":"Tidakkah mereka memperhatikan burung-burung yang mengembangkan dan mengatupkan sayapnya di atas mereka? Tidak ada yang menahannya (di udara) selain Yang Maha Pengasih. Sungguh, Dia Maha Melihat segala sesuatu."},{"n":20,"w":[["أَمَّنْ","atau siapakah","amman",93],["هَـٰذَا","ini","hādhā",64],["ٱلَّذِى","yang","alladhī",45],["هُوَ","dia","huwa",25],["جُندٌۭ","bala tentara","jundun",394],["لَّكُمْ","bagi kalian","lakum",32],["يَنصُرُكُم","dia menolongmu","yanṣurukum",212],["مِّن","dari","min",1],["دُونِ","selain","dūni",88],["ٱلرَّحْمَـٰنِ ۚ","Maha Pengasih","l-raḥmāni",224],["إِنِ","tidaklah","ini",19],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",79],["إِلَّا","kecuali","illā",20],["فِى","dalam","fī",7],["غُرُورٍ","keadaan tertipu","ghurūrin",922]],"t":"Atau siapakah yang akan menjadi bala tentara bagimu yang dapat membelamu selain (Allah) Yang Maha Pengasih? Orang-orang kafir itu hanyalah dalam (keadaan) tertipu."},{"n":21,"w":[["أَمَّنْ","atau siapakah","amman",93],["هَـٰذَا","ini","hādhā",64],["ٱلَّذِى","yang","alladhī",45],["يَرْزُقُكُمْ","memberi rezeki kamu","yarzuqukum",208],["إِنْ","jika","in",19],["أَمْسَكَ","Dia menahan","amsaka",552],["رِزْقَهُۥ ۚ","rezekinya","riz'qahu",231],["بَل","bahkan/tetapi","bal",105],["لَّجُّوا۟","mereka terus-menerus","lajjū",2449],["فِى","dalam","fī",7],["عُتُوٍّۢ","kesombongan","ʿutuwwin",2261],["وَنُفُورٍ","dan lari/berpaling","wanufūrin",1410]],"t":"Atau siapakah yang dapat memberimu rezeki jika Dia menahan rezeki-Nya? Bahkan mereka terus-menerus dalam kesombongan dan menjauhkan diri (dari kebenaran)."},{"n":22,"w":[["أَفَمَن","maka apakah orang","afaman",17],["يَمْشِى","dia berjalan","yamshī",500],["مُكِبًّا","tiarap/telengkup","mukibban",3841],["عَلَىٰ","di atas","ʿalā",11],["وَجْهِهِۦٓ","mukanya","wajhihi",180],["أَهْدَىٰٓ","lebih mendapat petunjuk","ahdā",1049],["أَمَّن","ataukah orang","amman",93],["يَمْشِى","dia berjalan","yamshī",500],["سَوِيًّا","sama lurus","sawiyyan",1424],["عَلَىٰ","di atas","ʿalā",11],["صِرَٰطٍۢ","jalan","ṣirāṭin",274],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",336]],"t":"Apakah orang yang merangkak dengan wajah tertelungkup yang lebih terpimpin (dalam kebenaran) ataukah orang yang berjalan tegap di atas jalan yang lurus?"},{"n":23,"w":[["قُلْ","katakanlah","qul",10],["هُوَ","Dia","huwa",25],["ٱلَّذِىٓ","yang","alladhī",45],["أَنشَأَكُمْ","menumbuhkan/menciptakan kamu","ansha-akum",513],["وَجَعَلَ","dan menjadikan","wajaʿala",40],["لَكُمُ","bagi kalian","lakumu",32],["ٱلسَّمْعَ","pendengaran","l-samʿa",487],["وَٱلْأَبْصَـٰرَ","dan penglihatan","wal-abṣāra",260],["وَٱلْأَفْـِٔدَةَ ۖ","dan hati","wal-afidata",607],["قَلِيلًۭا","sedikit","qalīlan",186],["مَّا","apa","mā",6],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",267]],"t":"Katakanlah, \"Dialah yang menciptakan kamu dan menjadikan pendengaran, penglihatan dan hati nurani bagi kamu. (Tetapi) sedikit sekali kamu bersyukur."},{"n":24,"w":[["قُلْ","katakanlah","qul",10],["هُوَ","Dia","huwa",25],["ٱلَّذِى","yang","alladhī",45],["ذَرَأَكُمْ","menjadikan kamu berkembang biak","dhara-akum",1141],["فِى","di muka","fī",7],["ٱلْأَرْضِ","bumi","l-arḍi",28],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",18],["تُحْشَرُونَ","kamu akan dikumpulkan","tuḥ'sharūna",330]],"t":"Katakanlah, \"Dialah yang menjadikan kamu berkembang biak di muka bumi, dan hanya kepada-Nya kamu akan dikumpulkan.\""},{"n":25,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",10],["مَتَىٰ","kapan","matā",930],["هَـٰذَا","ini","hādhā",64],["ٱلْوَعْدُ","janji/ancaman","l-waʿdu",258],["إِن","jika","in",19],["كُنتُمْ","kalian adalah","kuntum",12],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",211]],"t":"Dan mereka berkata, \"Kapan (datangnya) ancaman itu jika kamu orang yang benar?\""},{"n":26,"w":[["قُلْ","katakanlah","qul",10],["إِنَّمَا","sesungguhnya","innamā",9],["ٱلْعِلْمُ","pengetahuan","l-ʿil'mu",122],["عِندَ","di sisi","ʿinda",68],["ٱللَّهِ","Allah","l-lahi",4],["وَإِنَّمَآ","dan sesungguhnya","wa-innamā",9],["أَنَا۠","Aku","anā",194],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",216],["مُّبِينٌۭ","yang nyata","mubīnun",111]],"t":"Katakanlah (Muhammad), \"Sesungguhnya ilmu (tentang hari Kiamat itu) hanya ada pada Allah. Dan aku hanyalah seorang pemberi peringatan yang menjelaskan.\""},{"n":27,"w":[["فَلَمَّا","maka ketika","falammā",81],["رَأَوْهُ","mereka melihatnya (azab)","ra-awhu",54],["زُلْفَةًۭ","dekat","zul'fatan",2793],["سِيٓـَٔتْ","menjadi buruk/jelek","sīat",387],["وُجُوهُ","muka-muka","wujūhu",180],["ٱلَّذِينَ","orang-orang yang","alladhīna",13],["كَفَرُوا۟","kafir/ingkar","kafarū",48],["وَقِيلَ","dan dikatakan","waqīla",10],["هَـٰذَا","ini","hādhā",64],["ٱلَّذِى","yang","alladhī",45],["كُنتُم","kalian adalah","kuntum",12],["بِهِۦ","dengannya","bihi",21],["تَدَّعُونَ","kamu meminta","taddaʿūna",2094]],"t":"Maka ketika mereka melihat azab (pada hari Kiamat) sudah dekat, wajah orang-orang kafir itu menjadi muram. Dan dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu memintanya.\""},{"n":28,"w":[["قُلْ","katakanlah","qul",10],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",54],["إِنْ","jika","in",19],["أَهْلَكَنِىَ","membinasakan aku","ahlakaniya",243],["ٱللَّهُ","Allah","l-lahu",4],["وَمَن","dan orang-orang yang","waman",17],["مَّعِىَ","bersamaku","maʿiya",78],["أَوْ","atau","aw",50],["رَحِمَنَا","Dia memberi rahmat kami","raḥimanā",407],["فَمَن","maka barang siapa","faman",17],["يُجِيرُ","menolong/melindungi","yujīru",1146],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",79],["مِنْ","dari","min",1],["عَذَابٍ","azab","ʿadhābin",43],["أَلِيمٍۢ","yang pedih","alīmin",178]],"t":"Katakanlah (Muhammad), \"Tahukah kamu jika Allah mematikan aku dan orang-orang yang bersamaku atau memberi rahmat kepada kami, (maka kami akan masuk surga), lalu siapa yang dapat melindungi orang-orang kafir dari azab yang pedih?\""},{"n":29,"w":[["قُلْ","katakanlah","qul",10],["هُوَ","Dia","huwa",25],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",224],["ءَامَنَّا","kami beriman","āmannā",23],["بِهِۦ","kepada-Nya","bihi",21],["وَعَلَيْهِ","dan atas-Nya","waʿalayhi",11],["تَوَكَّلْنَا ۖ","kami bertawakal","tawakkalnā",309],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahuinya","fasataʿlamūna",35],["مَنْ","siapa","man",17],["هُوَ","dia","huwa",25],["فِى","dalam","fī",7],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",325],["مُّبِينٍۢ","nyata","mubīnin",111]],"t":"Katakanlah, \"Dialah Yang Maha Pengasih, kami beriman kepada-Nya dan kepada-Nya kami bertawakal. Maka kelak kamu akan tahu siapa yang berada dalam kesesatan yang nyata.\""},{"n":30,"w":[["قُلْ","katakanlah","qul",10],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",54],["إِنْ","jika","in",19],["أَصْبَحَ","menjadi","aṣbaḥa",398],["مَآؤُكُمْ","air kamu","māukum",204],["غَوْرًۭا","masuk dalam tanah kering","ghawran",2392],["فَمَن","maka siapa","faman",17],["يَأْتِيكُم","mendatangkan kepadamu","yatīkum",56],["بِمَآءٍۢ","dengan air","bimāin",204],["مَّعِينٍۭ","mata air/mengalir","maʿīnin",1623]],"t":"Katakanlah (Muhammad), \"Terangkanlah kepadaku jika sumber air kamu menjadi kering; maka siapa yang akan memberimu air yang mengalir?\""}]