[{"n":1,"w":[["تَبَـٰرَكَ","Maha Suci","tabāraka",930],["ٱلَّذِى","yang","alladhī",7],["بِيَدِهِ","di tangan-Nya","biyadihi",98],["ٱلْمُلْكُ","kerajaan","l-mul'ku",250],["وَهُوَ","dan Dia","wahuwa",20],["عَلَىٰ","atas","ʿalā",8],["كُلِّ","segala","kulli",31],["شَىْءٍۢ","sesuatu","shayin",41],["قَدِيرٌ","Maha Kuasa","qadīrun",261]],"t":"Mahasuci Allah yang menguasai (segala) kerajaan, Dan Dia Mahakuasa atas segala sesuatu."},{"n":2,"w":[["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",60],["ٱلْمَوْتَ","kematian","l-mawta",237],["وَٱلْحَيَوٰةَ","dan kehidupan","wal-ḥayata",148],["لِيَبْلُوَكُمْ","karena Dia akan mengujimu","liyabluwakum",514],["أَيُّكُمْ","siapa diantara kamu","ayyukum",201],["أَحْسَنُ","lebih baik","aḥsanu",324],["عَمَلًۭا ۚ","perbuatan","ʿamalan",168],["وَهُوَ","dan Dia","wahuwa",20],["ٱلْعَزِيزُ","Maha Perkasa","l-ʿazīzu",110],["ٱلْغَفُورُ","Maha Pengampun","l-ghafūru",118]],"t":"Yang menciptakan mati dan hidup, untuk menguji kamu, siapa di antara kamu yang lebih baik amalnya. Dan Dia Mahaperkasa, Maha Pengampun."},{"n":3,"w":[["ٱلَّذِى","yang","alladhī",7],["خَلَقَ","menciptakan","khalaqa",60],["سَبْعَ","tujuh","sabʿa",461],["سَمَـٰوَٰتٍۢ","langit","samāwātin",38],["طِبَاقًۭا ۖ","berlapis-lapis","ṭibāqan",1531],["مَّا","tidak","mā",2],["تَرَىٰ","kamu lihat","tarā",46],["فِى","dalam/pada","fī",3],["خَلْقِ","penciptaan","khalqi",230],["ٱلرَّحْمَـٰنِ","Yang Maha Pengasih","l-raḥmāni",213],["مِن","dari","min",0],["تَفَـٰوُتٍۢ ۖ","tidak seimbang","tafāwutin",4384],["فَٱرْجِعِ","maka kembalilah","fa-ir'jiʿi",141],["ٱلْبَصَرَ","pandangan","l-baṣara",248],["هَلْ","apakah","hal",115],["تَرَىٰ","kamu melihat","tarā",46],["مِن","dari","min",0],["فُطُورٍۢ","teratur/seimbang","fuṭūrin",3459]],"t":"Yang menciptakan tujuh langit berlapis-lapis. Tidak akan kamu lihat sesuatu yang tidak seimbang pada ciptaan Tuhan Yang Maha Pengasih. Maka lihatlah sekali lagi, adakah kamu lihat sesuatu yang cacat?"},{"n":4,"w":[["ثُمَّ","kemudian","thumma",34],["ٱرْجِعِ","kembalilah","ir'jiʿi",141],["ٱلْبَصَرَ","pandangan","l-baṣara",248],["كَرَّتَيْنِ","dua kali ulang","karratayni",1196],["يَنقَلِبْ","berbalik/kembali","yanqalib",586],["إِلَيْكَ","kepadamu","ilayka",13],["ٱلْبَصَرُ","pandangan","l-baṣaru",248],["خَاسِئًۭا","membingungkan","khāsi-an",2041],["وَهُوَ","dan ia","wahuwa",20],["حَسِيرٌۭ","lemah","ḥasīrun",3204]],"t":"Kemudian ulangi pandangan(mu) sekali lagi (dan) sekali lagi, niscaya pandanganmu akan kembali kepadamu tanpa menemukan cacat dan ia (pandanganmu) dalam keadaan letih."},{"n":5,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["زَيَّنَّا","Kami menghiasi","zayyannā",420],["ٱلسَّمَآءَ","langit","l-samāa",38],["ٱلدُّنْيَا","dunia/yang dekat","l-dun'yā",101],["بِمَصَـٰبِيحَ","dengan bintang-bintang","bimaṣābīḥa",1589],["وَجَعَلْنَـٰهَا","dan Kami menjadikannya","wajaʿalnāhā",33],["رُجُومًۭا","pelempar","rujūman",4218],["لِّلشَّيَـٰطِينِ ۖ","terhadap syaitan-syaitan","lilshayāṭīni",120],["وَأَعْتَدْنَا","dan Kami sediakan","wa-aʿtadnā",649],["لَهُمْ","bagi mereka","lahum",11],["عَذَابَ","azab/siksa","ʿadhāba",36],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",606]],"t":"Dan sungguh, telah Kami hiasi langit yang dekat, dengan bintang-bintang dan Kami jadikannya (bintang-bintang itu) sebagai alat-alat pelempar setan, dan Kami sediakan bagi mereka azab neraka yang menyala-nyala."},{"n":6,"w":[["وَلِلَّذِينَ","dan bagi orang-orang yang","walilladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["بِرَبِّهِمْ","kepada Tuhan mereka","birabbihim",10],["عَذَابُ","azab/siksa","ʿadhābu",36],["جَهَنَّمَ ۖ","neraka jahannam","jahannama",146],["وَبِئْسَ","dan amat buruk","wabi'sa",290],["ٱلْمَصِيرُ","tempat kembali","l-maṣīru",389]],"t":"Dan orang-orang yang ingkar kepada Tuhannya, akan mendapat azab Jahanam. Dan itulah seburuk-buruk tempat kembali."},{"n":7,"w":[["إِذَآ","apabila","idhā",23],["أُلْقُوا۟","mereka dilemparkan","ul'qū",167],["فِيهَا","di dalamnya","fīhā",3],["سَمِعُوا۟","mereka mendengar","samiʿū",143],["لَهَا","baginya","lahā",103],["شَهِيقًۭا","jeritan","shahīqan",2121],["وَهِىَ","dan ia","wahiya",190],["تَفُورُ","mendidih","tafūru",1829]],"t":"Apabila mereka dilemparkan ke dalamnya mereka mendengar suara neraka yang mengerikan, sedang neraka itu membara,"},{"n":8,"w":[["تَكَادُ","hampir-hampir","takādu",442],["تَمَيَّزُ","terpecah belah","tamayyazu",4411],["مِنَ","dari","mina",0],["ٱلْغَيْظِ ۖ","lantaran marah","l-ghayẓi",1189],["كُلَّمَآ","setiap kali","kullamā",633],["أُلْقِىَ","dilempar","ul'qiya",167],["فِيهَا","di dalamnya","fīhā",3],["فَوْجٌۭ","sekumpulan","fawjun",1339],["سَأَلَهُمْ","bertanya kepada mereka","sa-alahum",105],["خَزَنَتُهَآ","penjaga-penjaganya","khazanatuhā",1671],["أَلَمْ","apakah tidak","alam",32],["يَأْتِكُمْ","datang kepadamu","yatikum",48],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",207]],"t":"hampir meledak karena marah. Setiap kali ada sekumpulan (orang-orang kafir) dilemparkan ke dalamnya, penjaga-penjaga (neraka itu) bertanya kepada mereka, \"Apakah belum pernah ada orang yang datang memberi peringatan kepadamu (di dunia)?\""},{"n":9,"w":[["قَالُوا۟","mereka berkata/menjawab","qālū",6],["بَلَىٰ","ya benar","balā",465],["قَدْ","sesungguhnya","qad",24],["جَآءَنَا","telah datang kepada kami","jāanā",43],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",207],["فَكَذَّبْنَا","maka kami mendustakan","fakadhabnā",63],["وَقُلْنَا","dan kami katakan","waqul'nā",6],["مَا","tidak","mā",2],["نَزَّلَ","menurunkan","nazzala",197],["ٱللَّهُ","Allah","l-lahu",1],["مِن","dari","min",0],["شَىْءٍ","sesuatu","shayin",41],["إِنْ","tidaklah","in",14],["أَنتُمْ","kamu","antum",85],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",307],["كَبِيرٍۢ","besar","kabīrin",291]],"t":"Mereka menjawab, \"Benar, sungguh, seorang pemberi peringatan telah datang kepada kami, tetapi kami mendustakan(nya) dan kami katakan, \"Allah tidak menurunkan sesuatu apa pun, kamu sebenarnya di dalam kesesatan yang besar.\""},{"n":10,"w":[["وَقَالُوا۟","dan mereka berkata","waqālū",6],["لَوْ","sekiranya","law",57],["كُنَّا","adalah kami","kunnā",9],["نَسْمَعُ","kami mendengarkan","nasmaʿu",143],["أَوْ","atau","aw",42],["نَعْقِلُ","kami berakal","naʿqilu",242],["مَا","tidaklah","mā",2],["كُنَّا","kami","kunnā",9],["فِىٓ","dalam","fī",3],["أَصْحَـٰبِ","penghuni","aṣḥābi",142],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",606]],"t":"Dan mereka berkata, \"Sekiranya (dahulu) kami mendengarkan atau memikirkan (peringatan itu) tentulah kami tidak termasuk penghuni neraka yang menyala-nyala.\""},{"n":11,"w":[["فَٱعْتَرَفُوا۟","maka mereka mengakui","fa-iʿ'tarafū",2102],["بِذَنۢبِهِمْ","dengan/akan dosa mereka","bidhanbihim",313],["فَسُحْقًۭا","maka kebinasaanlah","fasuḥ'qan",4293],["لِّأَصْحَـٰبِ","bagi penghuni","li-aṣḥābi",142],["ٱلسَّعِيرِ","neraka yang menyala-nyala","l-saʿīri",606]],"t":"Maka mereka mengakui dosanya. Tetapi jauhlah (dari rahmat Allah) bagi penghuni neraka yang menyala-nyala itu."},{"n":12,"w":[["إِنَّ","sesungguhnya","inna",5],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["يَخْشَوْنَ","mereka takut","yakhshawna",295],["رَبَّهُم","Tuhan mereka","rabbahum",10],["بِٱلْغَيْبِ","dengan gaib/tidak kelihatan","bil-ghaybi",243],["لَهُم","bagi mereka","lahum",11],["مَّغْفِرَةٌۭ","ampunan","maghfiratun",391],["وَأَجْرٌۭ","dan pahala","wa-ajrun",107],["كَبِيرٌۭ","besar","kabīrun",291]],"t":"Sesungguhnya orang-orang yang takut kepada Tuhannya yang tidak terlihat oleh mereka, mereka memperoleh ampunan dan pahala yang besar."},{"n":13,"w":[["وَأَسِرُّوا۟","dan rahasiakanlah","wa-asirrū",541],["قَوْلَكُمْ","perkataanmu","qawlakum",117],["أَوِ","atau","awi",42],["ٱجْهَرُوا۟","keraskanlah","ij'harū",1348],["بِهِۦٓ ۖ","dengannya","bihi",171],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["عَلِيمٌۢ","Maha mengetahui","ʿalīmun",68],["بِذَاتِ","dengan yang ada","bidhāti",113],["ٱلصُّدُورِ","dada","l-ṣudūri",267]],"t":"Dan rahasiakanlah perkataanmu atau nyatakanlah. Sungguh, Dia Maha Mengetahui segala isi hati."},{"n":14,"w":[["أَلَا","apakah tidak/tidakkah","alā",4],["يَعْلَمُ","Dia mengetahui","yaʿlamu",29],["مَنْ","siapa/apa","man",12],["خَلَقَ","Dia ciptakan","khalaqa",60],["وَهُوَ","dan Dia","wahuwa",20],["ٱللَّطِيفُ","Maha Halus","l-laṭīfu",1089],["ٱلْخَبِيرُ","Maha mengetahui","l-khabīru",262]],"t":"Apakah (pantas) Allah yang menciptakan itu tidak mengetahui? Dan Dia Mahahalus, Maha Mengetahui."},{"n":15,"w":[["هُوَ","dan Dia","huwa",20],["ٱلَّذِى","yang","alladhī",7],["جَعَلَ","menjadikan","jaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلْأَرْضَ","bumi","l-arḍa",22],["ذَلُولًۭا","mudah dipergunakan","dhalūlan",2133],["فَٱمْشُوا۟","maka berjalanlah kamu","fa-im'shū",493],["فِى","di/pada","fī",3],["مَنَاكِبِهَا","segala penjuru","manākibihā",3705],["وَكُلُوا۟","dan makanlah","wakulū",114],["مِن","dari","min",0],["رِّزْقِهِۦ ۖ","sebagian rizki-Nya","riz'qihi",220],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["ٱلنُّشُورُ","dibangkitkan kembali","l-nushūru",1385]],"t":"Dialah yang menjadikan bumi untuk kamu yang mudah dijelajahi, maka jelajahilah di segala penjurunya dan makanlah sebagian dari rezeki-Nya. Dan hanya kepada-Nyalah kamu (kembali setelah) dibangkitkan."},{"n":16,"w":[["ءَأَمِنتُم","apakah kamu merasa aman","a-amintum",503],["مَّن","siapa (Allah)","man",12],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["أَن","bahwa","an",16],["يَخْسِفَ","Dia akan membenamkan","yakhsifa",1014],["بِكُمُ","dengan/untuk kalian","bikumu",26],["ٱلْأَرْضَ","bumi","l-arḍa",22],["فَإِذَا","maka tiba-tiba","fa-idhā",648],["هِىَ","ia/bumi","hiya",190],["تَمُورُ","bergoncang","tamūru",2679]],"t":"Sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan membuat kamu ditelan bumi ketika tiba-tiba ia terguncang?"},{"n":17,"w":[["أَمْ","atau","am",82],["أَمِنتُم","kamu merasa aman","amintum",503],["مَّن","siapa (Allah)","man",12],["فِى","di","fī",3],["ٱلسَّمَآءِ","langit","l-samāi",38],["أَن","bahwa","an",16],["يُرْسِلَ","Dia akan mengirimkan","yur'sila",88],["عَلَيْكُمْ","atas kalian","ʿalaykum",8],["حَاصِبًۭا ۖ","angin yang mengandung batu","ḥāṣiban",1514],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahui","fasataʿlamūna",29],["كَيْفَ","bagaimana","kayfa",133],["نَذِيرِ","peringatan-Ku","nadhīri",207]],"t":"atau sudah merasa amankah kamu, bahwa Dia yang di langit tidak akan mengirimkan badai yang berbatu kepadamu? Namun kelak kamu akan mengetahui bagaimana (akibat mendustakan) peringatan-Ku."},{"n":18,"w":[["وَلَقَدْ","dan sesungguhnya","walaqad",24],["كَذَّبَ","telah mendustakan","kadhaba",63],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["مِن","dari","min",0],["قَبْلِهِمْ","sebelum mereka","qablihim",51],["فَكَيْفَ","maka bagaimana","fakayfa",133],["كَانَ","adalah ia","kāna",9],["نَكِيرِ","celaan-Ku/kemurkaan-Ku","nakīri",1618]],"t":"Dan sungguh, orang-orang yang sebelum mereka pun telah mendustakan (rasul-rasul-Nya). Maka betapa hebatnya kemurkaan-Ku!"},{"n":19,"w":[["أَوَلَمْ","ataukah tidak","awalam",32],["يَرَوْا۟","mereka memperhatikan","yaraw",46],["إِلَى","kepada","ilā",13],["ٱلطَّيْرِ","burung","l-ṭayri",526],["فَوْقَهُمْ","di atas mereka","fawqahum",285],["صَـٰٓفَّـٰتٍۢ","mengembangkan sayap","ṣāffātin",1797],["وَيَقْبِضْنَ ۚ","dan ia mengatupkannya","wayaqbiḍ'na",1391],["مَا","tidak ada","mā",2],["يُمْسِكُهُنَّ","yang menahan mereka","yum'sikuhunna",540],["إِلَّا","kecuali","illā",15],["ٱلرَّحْمَـٰنُ ۚ","Maha Pengasih","l-raḥmānu",213],["إِنَّهُۥ","sesungguhnya Dia","innahu",5],["بِكُلِّ","dengan segala","bikulli",31],["شَىْءٍۭ","sesuatu","shayin",41],["بَصِيرٌ","Maha melihat","baṣīrun",233]],"t":"Tidakkah mereka memperhatikan burung-burung yang mengembangkan dan mengatupkan sayapnya di atas mereka? Tidak ada yang menahannya (di udara) selain Yang Maha Pengasih. Sungguh, Dia Maha Melihat segala sesuatu."},{"n":20,"w":[["أَمَّنْ","atau siapakah","amman",82],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang","alladhī",7],["هُوَ","dia","huwa",20],["جُندٌۭ","bala tentara","jundun",375],["لَّكُمْ","bagi kalian","lakum",26],["يَنصُرُكُم","dia menolongmu","yanṣurukum",203],["مِّن","dari","min",0],["دُونِ","selain","dūni",78],["ٱلرَّحْمَـٰنِ ۚ","Maha Pengasih","l-raḥmāni",213],["إِنِ","tidaklah","ini",14],["ٱلْكَـٰفِرُونَ","orang-orang kafir","l-kāfirūna",90],["إِلَّا","kecuali","illā",15],["فِى","dalam","fī",3],["غُرُورٍ","keadaan tertipu","ghurūrin",906]],"t":"Atau siapakah yang akan menjadi bala tentara bagimu yang dapat membelamu selain (Allah) Yang Maha Pengasih? Orang-orang kafir itu hanyalah dalam (keadaan) tertipu."},{"n":21,"w":[["أَمَّنْ","atau siapakah","amman",82],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang","alladhī",7],["يَرْزُقُكُمْ","memberi rezeki kamu","yarzuqukum",199],["إِنْ","jika","in",14],["أَمْسَكَ","Dia menahan","amsaka",540],["رِزْقَهُۥ ۚ","rezekinya","riz'qahu",220],["بَل","bahkan/tetapi","bal",93],["لَّجُّوا۟","mereka terus-menerus","lajjū",2443],["فِى","dalam","fī",3],["عُتُوٍّۢ","kesombongan","ʿutuwwin",2267],["وَنُفُورٍ","dan lari/berpaling","wanufūrin",1386]],"t":"Atau siapakah yang dapat memberimu rezeki jika Dia menahan rezeki-Nya? Bahkan mereka terus-menerus dalam kesombongan dan menjauhkan diri (dari kebenaran)."},{"n":22,"w":[["أَفَمَن","maka apakah orang","afaman",12],["يَمْشِى","dia berjalan","yamshī",493],["مُكِبًّا","tiarap/telengkup","mukibban",3831],["عَلَىٰ","di atas","ʿalā",8],["وَجْهِهِۦٓ","mukanya","wajhihi",164],["أَهْدَىٰٓ","lebih mendapat petunjuk","ahdā",1041],["أَمَّن","ataukah orang","amman",82],["يَمْشِى","dia berjalan","yamshī",493],["سَوِيًّا","sama lurus","sawiyyan",1400],["عَلَىٰ","di atas","ʿalā",8],["صِرَٰطٍۢ","jalan","ṣirāṭin",260],["مُّسْتَقِيمٍۢ","yang lurus","mus'taqīmin",319]],"t":"Apakah orang yang merangkak dengan wajah tertelungkup yang lebih terpimpin (dalam kebenaran) ataukah orang yang berjalan tegap di atas jalan yang lurus?"},{"n":23,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",20],["ٱلَّذِىٓ","yang","alladhī",7],["أَنشَأَكُمْ","menumbuhkan/menciptakan kamu","ansha-akum",504],["وَجَعَلَ","dan menjadikan","wajaʿala",33],["لَكُمُ","bagi kalian","lakumu",26],["ٱلسَّمْعَ","pendengaran","l-samʿa",476],["وَٱلْأَبْصَـٰرَ","dan penglihatan","wal-abṣāra",248],["وَٱلْأَفْـِٔدَةَ ۖ","dan hati","wal-afidata",597],["قَلِيلًۭا","sedikit","qalīlan",173],["مَّا","apa","mā",2],["تَشْكُرُونَ","kalian bersyukur","tashkurūna",254]],"t":"Katakanlah, \"Dialah yang menciptakan kamu dan menjadikan pendengaran, penglihatan dan hati nurani bagi kamu. (Tetapi) sedikit sekali kamu bersyukur."},{"n":24,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",20],["ٱلَّذِى","yang","alladhī",7],["ذَرَأَكُمْ","menjadikan kamu berkembang biak","dhara-akum",1136],["فِى","di muka","fī",3],["ٱلْأَرْضِ","bumi","l-arḍi",22],["وَإِلَيْهِ","dan kepada-Nya","wa-ilayhi",13],["تُحْشَرُونَ","kamu akan dikumpulkan","tuḥ'sharūna",314]],"t":"Katakanlah, \"Dialah yang menjadikan kamu berkembang biak di muka bumi, dan hanya kepada-Nya kamu akan dikumpulkan.\""},{"n":25,"w":[["وَيَقُولُونَ","dan mereka berkata","wayaqūlūna",6],["مَتَىٰ","kapan","matā",913],["هَـٰذَا","ini","hādhā",37],["ٱلْوَعْدُ","janji/ancaman","l-waʿdu",246],["إِن","jika","in",14],["كُنتُمْ","kalian adalah","kuntum",9],["صَـٰدِقِينَ","orang-orang yang benar","ṣādiqīna",202]],"t":"Dan mereka berkata, \"Kapan (datangnya) ancaman itu jika kamu orang yang benar?\""},{"n":26,"w":[["قُلْ","katakanlah","qul",6],["إِنَّمَا","sesungguhnya","innamā",5],["ٱلْعِلْمُ","pengetahuan","l-ʿil'mu",108],["عِندَ","di sisi","ʿinda",59],["ٱللَّهِ","Allah","l-lahi",1],["وَإِنَّمَآ","dan sesungguhnya","wa-innamā",5],["أَنَا۠","Aku","anā",198],["نَذِيرٌۭ","seorang pemberi peringatan","nadhīrun",207],["مُّبِينٌۭ","yang nyata","mubīnun",99]],"t":"Katakanlah (Muhammad), \"Sesungguhnya ilmu (tentang hari Kiamat itu) hanya ada pada Allah. Dan aku hanyalah seorang pemberi peringatan yang menjelaskan.\""},{"n":27,"w":[["فَلَمَّا","maka ketika","falammā",71],["رَأَوْهُ","mereka melihatnya (azab)","ra-awhu",46],["زُلْفَةًۭ","dekat","zul'fatan",2834],["سِيٓـَٔتْ","menjadi buruk/jelek","sīat",368],["وُجُوهُ","muka-muka","wujūhu",164],["ٱلَّذِينَ","orang-orang yang","alladhīna",7],["كَفَرُوا۟","kafir/ingkar","kafarū",40],["وَقِيلَ","dan dikatakan","waqīla",6],["هَـٰذَا","ini","hādhā",37],["ٱلَّذِى","yang","alladhī",7],["كُنتُم","kalian adalah","kuntum",9],["بِهِۦ","dengannya","bihi",17],["تَدَّعُونَ","kamu meminta","taddaʿūna",2058]],"t":"Maka ketika mereka melihat azab (pada hari Kiamat) sudah dekat, wajah orang-orang kafir itu menjadi muram. Dan dikatakan (kepada mereka), \"Inilah (azab) yang dahulu kamu memintanya.\""},{"n":28,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",46],["إِنْ","jika","in",14],["أَهْلَكَنِىَ","membinasakan aku","ahlakaniya",232],["ٱللَّهُ","Allah","l-lahu",1],["وَمَن","dan orang-orang yang","waman",12],["مَّعِىَ","bersamaku","maʿiya",69],["أَوْ","atau","aw",42],["رَحِمَنَا","Dia memberi rahmat kami","raḥimanā",393],["فَمَن","maka barang siapa","faman",12],["يُجِيرُ","menolong/melindungi","yujīru",1262],["ٱلْكَـٰفِرِينَ","orang-orang yang kafir","l-kāfirīna",90],["مِنْ","dari","min",0],["عَذَابٍ","azab","ʿadhābin",36],["أَلِيمٍۢ","yang pedih","alīmin",162]],"t":"Katakanlah (Muhammad), \"Tahukah kamu jika Allah mematikan aku dan orang-orang yang bersamaku atau memberi rahmat kepada kami, (maka kami akan masuk surga), lalu siapa yang dapat melindungi orang-orang kafir dari azab yang pedih?\""},{"n":29,"w":[["قُلْ","katakanlah","qul",6],["هُوَ","Dia","huwa",20],["ٱلرَّحْمَـٰنُ","Maha Pengasih","l-raḥmānu",213],["ءَامَنَّا","kami beriman","āmannā",18],["بِهِۦ","kepada-Nya","bihi",17],["وَعَلَيْهِ","dan atas-Nya","waʿalayhi",8],["تَوَكَّلْنَا ۖ","kami bertawakal","tawakkalnā",293],["فَسَتَعْلَمُونَ","maka kelak kamu akan mengetahuinya","fasataʿlamūna",29],["مَنْ","siapa","man",12],["هُوَ","dia","huwa",20],["فِى","dalam","fī",3],["ضَلَـٰلٍۢ","kesesatan","ḍalālin",307],["مُّبِينٍۢ","nyata","mubīnin",99]],"t":"Katakanlah, \"Dialah Yang Maha Pengasih, kami beriman kepada-Nya dan kepada-Nya kami bertawakal. Maka kelak kamu akan tahu siapa yang berada dalam kesesatan yang nyata.\""},{"n":30,"w":[["قُلْ","katakanlah","qul",6],["أَرَءَيْتُمْ","adakah kamu perhatikan","ara-aytum",46],["إِنْ","jika","in",14],["أَصْبَحَ","menjadi","aṣbaḥa",381],["مَآؤُكُمْ","air kamu","māukum",192],["غَوْرًۭا","masuk dalam tanah kering","ghawran",2383],["فَمَن","maka siapa","faman",12],["يَأْتِيكُم","mendatangkan kepadamu","yatīkum",48],["بِمَآءٍۢ","dengan air","bimāin",192],["مَّعِينٍۭ","mata air/mengalir","maʿīnin",1601]],"t":"Katakanlah (Muhammad), \"Terangkanlah kepadaku jika sumber air kamu menjadi kering; maka siapa yang akan memberimu air yang mengalir?\""}]